          %h2#idea Idea
          %p
            This page is about unbounded
            %a.existingWikiWord{:href => "/nlab/show/linear+operators"} linear operators
            on
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Hilbert+spaces"} Hilbert spaces
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/continuous+linear+map"} continuous
            %a.existingWikiWord{:href => "/nlab/show/subcategory"} subcategory
            of
            = succeed "?" do
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quantum+mechanics"} quantum mechanics
          %p
            One way of dealing with unbounded operators is via
            = succeed "," do
              %em
                %a{:href => "https://en.wikipedia.org/wiki/Affiliated_operator"} affiliated operators
          %p
          #DifferentiationIsUnbounded.num_remark
            %h6 Example
            %p
              %strong> (differentiation is unbounded
              )
              %br/
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℋ
                  %annotation{:encoding => "application/x-tex"} \mathcal{H}
              denote the Hilbert space
              %a.existingWikiWord{:href => "/nlab/show/Lebesgue+space"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi L
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %mi ℝ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} L^2(\mathbb{R})
              (of
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/square+integrable+functions"} square integrable functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              be the
              %a.existingWikiWord{:href => "/nlab/show/differentiation"} differentiation
              operator defined on the dense subspace of
              %a.existingWikiWord{:href => "/nlab/show/Schwartz+functions"} Schwartz functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %mi f
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} T f(x) \coloneqq f'(x)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              has a continuous extension to all of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi L
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} L^2
              %a.existingWikiWord{:href => "/nlab/show/sequence"} sequence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi k
                    %mo{:stretchy => "false"} |
                    %mi x
                    %mo{:stretchy => "false"} |
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f_k(x) \coloneqq \exp(-k|x|)
              for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mfrac
                        %mrow
                          %mo{:stretchy => "false"} ‖
                          %mi T
                          %msub
                            %mi f
                            %mi k
                          %mo{:stretchy => "false"} ‖
                        %mrow
                          %mo{:stretchy => "false"} ‖
                          %msub
                            %mi f
                            %mi k
                          %mo{:stretchy => "false"} ‖
                      %mo =
                      %mi k
                    %annotation{:encoding => "application/x-tex"} \frac{\|T f_k\|}{\|f_k\|} = k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              is unbounded.
          %p
            Note that the domain of definition of an unbounded operator will generally be given only on a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dense+subspace"} dense subspace
            = succeed "." do
              %a.maruku-ref{:href => "#DifferentiationIsUnbounded"}
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive
            %a.existingWikiWord{:href => "/nlab/show/Hahn%E2%80%93Banach+theorem"} Hahn–Banach theorem
            and refutable in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/dream+mathematics"} dream mathematics
          %h2#summary Summary
          %p
            After the definition we will look at some concepts that can be transferred from the bounded context
            = succeed "." do
              %a{:href => "/nlab/show/unbounded+operator#closedness"} here
          %p
            We will talk about the
            %a.existingWikiWord{:href => "/nlab/show/von+Neumann+algebra"} von Neumann algebra
            that contains all
            %span.newWikiWord
              spectral projections
              %a{:href => "/nlab/new/spectral+projections"} ?
            = succeed "." do
              %a{:href => "/nlab/show/unbounded+operator#affiliation"} here
          %p
            Finally we give some counterexamples, i.e., phenomena that contradict the intuition built from bounded operators
            = succeed "." do
              %a{:href => "/nlab/show/unbounded+operator#counterexamples"} here
          %h2#definition Definition
          %p
            An
            %strong unbounded operator
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            on a Hilbert space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℋ
                %annotation{:encoding => "application/x-tex"} \mathcal{H}
            is a linear operator defined on a subspace
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℋ
                  %annotation{:encoding => "application/x-tex"} \mathcal{H}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            is necessarily a linear submanifold. Usually one assumes that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            is dense in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℋ
                  %annotation{:encoding => "application/x-tex"} \mathcal{H}
          %p
            In particular every bounded operator
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo :
                  %mi ℋ
                  %mo →
                  %mi ℋ
                %annotation{:encoding => "application/x-tex"} A: \mathcal{H} \to \mathcal{H}
            is an unbounded operator (
            %a.existingWikiWord{:href => "/nlab/show/red+herring+principle"}> red herring principle
            ).
          %h2#domains_a_first_look Domains: a first look
          %p
            Unbounded operators are not defined on the whole Hilbert space, so it is essential that, when talking about a specific unbounded operator, we are actually talking about the pair
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mo ,
                  %msub
                    %mi D
                    %mi T
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (T, D_T)
            of an operator
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            together with its domain
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mi T
                  %annotation{:encoding => "application/x-tex"} D_T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo ,
                  %mi S
                %annotation{:encoding => "application/x-tex"} T, S
            are equal iff their domains are equal,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mi T
                    %mo =
                    %msub
                      %mi D
                      %mi S
                  %annotation{:encoding => "application/x-tex"} D_T = D_S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %msub
                    %mi D
                    %mi S
                  %mo =
                  %msub
                    %mi D
                    %mi T
                %annotation{:encoding => "application/x-tex"} x \in D_S=D_T
            we have
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Tx
                    %mo =
                    %mi Sx
                  %annotation{:encoding => "application/x-tex"} Tx = Sx
          %p
            If the domain is not specified, the default definition of the domain of a given operator
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            is simply
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mi T
                    %mo ≔
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo ∈
                    %mi ℋ
                    %mo{:stretchy => "false"} |
                    %mi Tx
                    %mo ∈
                    %mi ℋ
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} D_T \coloneqq \{x \in \mathcal{H} \vert Tx \in \mathcal{H} \}
          %p
            %strong Warning:
            if one composes two unbounded operators
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mi T
                    %mo ∩
                    %msub
                      %mi D
                      %mi S
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} D_T \cap D_S = \{0\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi D
                    %mi T
                  %mo ∩
                  %msub
                    %mi D
                    %mi S
                %annotation{:encoding => "application/x-tex"} D_T \cap D_S
            is dense to make sense of the composite
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mi S
                  %annotation{:encoding => "application/x-tex"} T S
          %h2#the_hellingertoeplitz_theorem The Hellinger-Toeplitz theorem
          %ul
            %li
              Theorem: Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              be an everywhere defined linear operator on a Hilbert space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℋ
                  %annotation{:encoding => "application/x-tex"} \mathcal{H}
              that is symmetric. Then A is bounded.
          %p For the definition of symmetric see below.
          %p
            The Hellinger-Toeplitz theorem is a no-go theorem for
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/quantum+mechanics"} quantum mechanics
            %a.existingWikiWord{:href => "/nlab/show/quantum+mechanics"} quantum mechanics
            are both symmetric and unbounded, we are led to conclude that they cannot be everywhere defined. This means that the problems that accompany only densely defined operators cannot be avoided.
          %h3#reference Reference
          %p This is a corollary to the closed graph theorem III.2 in the book
          %ul
            %li
              Reed, M.; Simon, B.:
              = succeed "." do
                %em Methods of modern mathematical physics
          %h2#closedness_selfadjointness_resolvent Closedness, selfadjointness, resolvent
          %h3#closedness Closedness
          %p
            Recall that the graph of an operator
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            (or any function, in general) is the subset
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒢
                      %mi T
                    %mo ≔
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi ℋ
                    %mo ×
                    %mi ℋ
                    %mo{:stretchy => "false"} |
                    %mi Tx
                    %mo =
                    %mi y
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}_T \coloneqq \{(x, y) \in \mathcal{H} \times \mathcal{H} \vert Tx = y \}
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℋ
                    %mo ×
                    %mi ℋ
                  %annotation{:encoding => "application/x-tex"} \mathcal{H} \times \mathcal{H}
          %ul
            %li
              %p
                Definition: Given an operator T with domain
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi D
                          %mi T
                      %annotation{:encoding => "application/x-tex"} D_T
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} T'
                with larger domain that is equal to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi D
                        %mi T
                    %annotation{:encoding => "application/x-tex"} D_T
                is called an
                %strong extension
                of T, we write
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                        %mo ⊂
                        %mi T
                        %mo ′
                      %annotation{:encoding => "application/x-tex"} T \subset T'
            %li
              %p
                Definition: An operator is
                %strong closed
                if its graph is closed.
            %li
              %p
                Definition: An operator is
                %strong closable
                if it has a closed extension. The smallest such extension is called the
                %strong closure
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
                and is denoted by
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi T
                          %mo ¯
                      %annotation{:encoding => "application/x-tex"} \overline{T}
            %li
              %p
                Proposition (closure of graph is graph of closure): If an operator
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
                is closable, then the closure of its graph
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi 𝒢
                        %mo ¯
                    %annotation{:encoding => "application/x-tex"} \overline{\mathcal{G}}
                is the graph of an operator, and this operator is its closure.
          %p
            The last part deserves some elaboration: Given an operator
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi x
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (x_n)
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ≔
                  %msub
                    %mi lim
                    %mrow
                      %mi n
                      %mo →
                      %mn ∞
                  %msub
                    %mi x
                    %mi n
                %annotation{:encoding => "application/x-tex"} x \coloneqq \lim_{n \to \infinity} x_n
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                  %mo ≔
                  %msub
                    %mi lim
                    %mrow
                      %mi n
                      %mo →
                      %mn ∞
                  %mi T
                  %msub
                    %mi x
                    %mi n
                %annotation{:encoding => "application/x-tex"} y \coloneqq \lim_{n \to \infinity} T x_n
            exist, we have that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (x, y)
            is in the closure of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo ′
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (x, y')
            in the closure with
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ≠
                    %mi y
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} y \neq y'
          %p
            We may assume without loss of generality that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi lim
                      %mrow
                        %mi n
                        %mo →
                        %mn ∞
                    %msub
                      %mi x
                      %mi n
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \lim_{n \to \infinity} x_n = 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                  %mo ≔
                  %msub
                    %mi lim
                    %mrow
                      %mi n
                      %mo →
                      %mn ∞
                  %mi T
                  %msub
                    %mi x
                    %mi n
                %annotation{:encoding => "application/x-tex"} y \coloneqq \lim_{n \to \infinity} T x_n
            exists, then
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} y=0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            were continuous, we would not have to assume that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Tx
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (Tx_n)
            is convergent, so this additional assumption tells us in what respect closability is weaker than continuity.
          %ul
            %li
              Definition: For a closed operator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              a subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mi T
                  %annotation{:encoding => "application/x-tex"} D_T
              is called a
              %strong core
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              if
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mrow
                          %mi T
                          %msub
                            %mo{:stretchy => "false"} |
                            %mi D
                        %mo ¯
                      %mo =
                      %mi T
                    %annotation{:encoding => "application/x-tex"} \overline{T \vert_{D}} = T
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              and take the closure, we obtain again
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
          %h3#example_of_an_operator_that_is_not_closable Example of an operator that is not closable
          %p …
          %h3#selfadjointness Selfadjointness
          %p
            We let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi T
                    %mo *
                %annotation{:encoding => "application/x-tex"} T^*
            be the adjoint of an operator
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
          %ul
            %li
              Definition (selfadjoint et al.): An operator is
              %strong symmetric
              (or
              = succeed ")" do
                %strong Hermitian
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo =
                    %msup
                      %mi T
                      %mo *
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msub
                          %mi D
                          %mi T
                  %annotation{:encoding => "application/x-tex"} T = T^* \vert_{D_T}
              (the adjoint is restricted to the domain of
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              %strong selfadjoint
              if it is symmetric and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi D
                        %mi T
                      %mo =
                      %msub
                        %mi D
                        %mrow
                          %msup
                            %mi T
                            %mo *
                    %annotation{:encoding => "application/x-tex"} D_T = D_{T^*}
              %strong essentially selfadjoint
              if its closure is selfadjoint.
          %p The difference of being symmetric and being selfadjoint is crucial, although there is a famous anecdote that seems to indicate otherwise:
          %ul
            %li
              Anecdote of selfadjointness: Once upon a time John von Neumann thanked Werner Heisenberg for the invention of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/quantum+mechanics"} quantum mechanics
          %p
            Nevertheless theorems that assume an operator to be selfadjoint will be not applicable to an operator that is only symmetric. One example is the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/spectral+theorem"} spectral theorem
          %h4#example_of_a_symmetric_but_not_selfadjoint_operator Example of a symmetric, but not selfadjoint, operator
          %p …
          %h2#resolvent Resolvent
          %p The definition of the resolvent does not pose any problems compared to the bounded case:
          %ul
            %li
              %p
                Definition: let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
                be a closed operator on a
                %a.existingWikiWord{:href => "/nlab/show/Hilbert+space"} Hilbert space
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℋ
                      %annotation{:encoding => "application/x-tex"} \mathcal{H}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                    %annotation{:encoding => "application/x-tex"} \lambda
                is in the
                %strong resolvent set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \rho(T)
                if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                      %mi 𝟙
                      %mo −
                      %mi T
                    %annotation{:encoding => "application/x-tex"} \lambda \mathbb{1} - T
                is a bijection of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi D
                        %mi T
                    %annotation{:encoding => "application/x-tex"} D_T
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℋ
                    %annotation{:encoding => "application/x-tex"} \mathcal{H}
                with bounded inverse. The inverse operator is called the
                %strong resolvent
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi R
                        %mi λ
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} R_{\lambda}(T)
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
                at
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi λ
                      %annotation{:encoding => "application/x-tex"} \lambda
            %li
              %p
                Theorem: The resolvent set is an open subset of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}
                on which the resolvent is an analytic operator valued function. Resolvents at different points commute and we have
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi R
                        %mi λ
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mo{:stretchy => "false"} )
                      %mo −
                      %msub
                        %mi R
                        %mi μ
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi μ
                      %mo −
                      %mi λ
                      %mo{:stretchy => "false"} )
                      %msub
                        %mi R
                        %mi μ
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mo{:stretchy => "false"} )
                      %msub
                        %mi R
                        %mi λ
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      R_{\lambda}(T) - R_{\mu}(T) = (\mu - \lambda) R_{\mu}(T) R_{\lambda}(T)
          %p The proof can be done as in the bounded case.
          %h3#commuting_operators Commuting operators
          %p
            The concept of commuting operators, which is of no problem in the bounded case, presents a conceptual difficulty in the unbounded one: for given operators
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            we would like to be able to say whether they commute, although their composite may not have dense domain. For selfadjoint operators there is a solution to this problem: We know that in the bounded case, two selfadjoint operators commute iff their spectral projections commute. This suggests the
          %ul
            %li Definition: two (possibly unbounded) selfadjoint operators commute iff all their spectral projections commute.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/spectral+theorem"} spectral theorem
            shows that all bounded Borel functions of two commuting operators will also commute.
          %p The following theorem states the reverse for two of the most important functions and shows that the definition of commutation above is reasonable:
          %ul
            %li
              Theorem: let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              be selfadjoint operators on a Hilbert space
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℋ
                    %annotation{:encoding => "application/x-tex"} \mathcal{H}
          %p
            (a)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            commute
          %p
            (b) if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} Im
                  %mi λ
                %annotation{:encoding => "application/x-tex"} \operatorname{Im} \lambda
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} Im
                  %mi μ
                %annotation{:encoding => "application/x-tex"} \operatorname{Im} \mu
            are
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≠
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \neq 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi R
                    %mi λ
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} R_{\lambda}(A)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi R
                    %mi μ
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} R_{\mu}(B)
            commute, as it is defined for bounded operators:
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi R
                    %mi λ
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %msub
                    %mi R
                    %mi μ
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi R
                    %mi μ
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                  %msub
                    %mi R
                    %mi λ
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} R_{\lambda}(A) R_{\mu}(B) = R_{\mu}(B) R_{\lambda}(A)
          %p
            (c) for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo ,
                  %mi s
                  %mo ∈
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} t, s \in \mathbb{R}
            we have
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi itA
                  %mo{:stretchy => "false"} )
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi isB
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi isB
                  %mo{:stretchy => "false"} )
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi itA
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \exp(itA) \exp(isB) = \exp(isB) \exp(itA)
          %h2#strongly_continuous_oneparameter_semigroups Strongly continuous one-parameter semigroups
          %p
            A
            %em strongly continuous one-parameter semigroup
            is an unitary representation of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℋ
                %annotation{:encoding => "application/x-tex"} \mathcal{H}
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            is seen as a topological group with respect to multiplication, see
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological group
          %ul
            %li
              Definition: a function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo :
                    %mi ℝ
                    %mo →
                    %mi ℬ
                    %mo{:stretchy => "false"} (
                    %mi ℋ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U : \mathbb{R} \to \mathcal{B}(\mathcal{H})
              is a one-parameter
              %a.existingWikiWord{:href => "/nlab/show/semigroup"} semigroup
              if the semigroup condition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo +
                    %mi s
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(t+s) = U(t)U(s)
              holds. If for every
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi ℋ
                  %annotation{:encoding => "application/x-tex"} x \in \mathcal{H}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo →
                    %msub
                      %mi t
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} t \to t_0
              we have
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mi x
                    %mo →
                    %mi U
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi t
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mi x
                  %annotation{:encoding => "application/x-tex"} U(t)x \to U(t_0)x
              then it is
              = succeed "." do
                %strong strongly continuous
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              is an unitary operator, it is an unitary semigroup.
          %p In the following a semigroup will be understood to be a one-parameter unitary strongly continuous semigroup.
          %p
            In physics, one-parameter semigroups of this kind often represent the time evolution of a physical system described by an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/evolution+equation"} evolution equation
          %ul
            %li
              %p
                Theorem: a selfadjoint operator
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                generates a semigroup via
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi t
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mo =
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mi itA
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U(t) := \exp(itA)
            %li
              %p
                Theorem (Stone’s theorem): let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
                be a semigroup, then there is a selfadjoint operator
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                such that
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mi t
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi exp
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mi t
                        %mi A
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} U(t) = \exp(i t A)
                %strong infinitesimal generator
                of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                      %annotation{:encoding => "application/x-tex"} U
          %p
            These two theorems are essential for the Schrödinger picture of quantum mechanics, which describes a system by the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Schr%C3%B6dinger+equation"} Schrödinger equation
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Hamilton+operator"} Hamilton operator
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Hamilton+operator"} Hamilton operator
          %p
            As a trivial observation we add that Stone’s theorem is a (huge) generalization of the Taylor series, let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi ℝ
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} f \colon \mathbb{R} \to \mathbb{R}
            that is (real) analytic in a neighborhood of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            small enough:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi h
                  %mo{:stretchy => "false"} )
                  %mo =
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi k
                      %mo =
                      %mn 0
                    %mn ∞
                  %mfrac
                    %mrow
                      %msup
                        %mi f
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mi n
                      %mo !
                  %msup
                    %mi h
                    %mi n
                  %mo =
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mi h
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi i
                  %mfrac
                    %mi d
                    %mi dx
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  f(h) = \sum_{k=0}^{\infty} \frac{f^{n}(0)}{n!} h^n = \exp(i h(-i \frac{d}{dx} ))
          %p
            This shows that the operator
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi i
                  %mfrac
                    %mi d
                    %mi dx
                %annotation{:encoding => "application/x-tex"} -i \frac{d}{dx}
            generates the semigroup of translations on the real line. Now we could, for example, use Stone’s theorem to prove that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi i
                  %mfrac
                    %mi d
                    %mi dx
                %annotation{:encoding => "application/x-tex"} -i \frac{d}{dx}
            is selfadjoint by proving that the translation group is strongly continuous.
          %h2#subtleties_resulting_from_domain_issues Subtleties resulting from domain issues
          %p (This rather generic title will have to be revised.)
          %h3#nelsons_example_of_noncommuting_exponentials Nelson’s example of noncommuting exponentials
          %h4#idea_2 Idea
          %p Nelson’s example shows that the rather involved definition of commutativity of two unbounded operators is well motivated, because a more naive one will have unwanted consequences. It is a counterexample to the following conjecture:
          %ul
            %li
              Conjecture (
              %strong> false!
              ): Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              be selfadjoint operators on a Hilbert space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℋ
                  %annotation{:encoding => "application/x-tex"} \mathcal{H}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              a dense subset such that both
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              restricted to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              are essentially selfadjoint. Suppose that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi D
                  %annotation{:encoding => "application/x-tex"} x \in D
              we have
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mi B
                      %mi x
                      %mo −
                      %mi B
                      %mi A
                      %mi x
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} A B x - B A x = 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              commute.
          %p
            We have already seen that on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^2
            we can define two essentially selfadjoint operators
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi i
                  %msub
                    %mo ∂
                    %mi x
                %annotation{:encoding => "application/x-tex"} -i \partial_x
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi i
                  %msub
                    %mo ∂
                    %mi y
                %annotation{:encoding => "application/x-tex"} -i \partial_y
            that generate translations along the x-axis and the y-axis respectively. Both the generated translations and the operators commute (the latter if applied to differentiable functions, of course).
          %p
            The central idea of Nelson’s counterexample is to replace
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^2
            by a
            %a.existingWikiWord{:href => "/nlab/show/Riemann+surface"} Riemann surface
            with two sheets, such that walking east, then walking north takes you to one sheet, while walking north then walking east takes you to the other sheet.
          %h4#definition_2 Definition
          %p
            We use the Riemann surface
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msqrt
                      %mo{:stretchy => "false"} (
                    %mi z
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(z) = \sqrt(z)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn ∞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (0, \infty)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                %annotation{:encoding => "application/x-tex"} +
            and the edge of the fourth quadrant as
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %annotation{:encoding => "application/x-tex"} -
            %em attach
            the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                %annotation{:encoding => "application/x-tex"} +
            edge of I with the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                %annotation{:encoding => "application/x-tex"} -
            edge of II and the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                %annotation{:encoding => "application/x-tex"} -
            of I with the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                %annotation{:encoding => "application/x-tex"} +
            edge of II.
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℋ
                  %mo =
                  %msup
                    %mi L
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{H} = L^2(M)
            with respect to Lebesgue measure. As indicated above we define A =
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi i
                  %msub
                    %mo ∂
                    %mi x
                %annotation{:encoding => "application/x-tex"} -i \partial_x
            and B =
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi i
                    %msub
                      %mo ∂
                      %mi y
                  %annotation{:encoding => "application/x-tex"} -i \partial_y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} \mathbb{C}
            and then identifies
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} \mathbb{C}
            with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^2
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            be the set of all smooth functions with compact support not containing
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
          %p
            (a)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            are essentially selfadjoint on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
          %p
            (b)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            onto
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
          %p
            (c) for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi D
                %annotation{:encoding => "application/x-tex"} x \in D
            we have
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mi B
                  %mi x
                  %mo =
                  %mi B
                  %mi A
                  %mi x
                %annotation{:encoding => "application/x-tex"} A B x = B A x
          %p
            (d)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mi t
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \exp(i t A)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mi s
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \exp(i s B)
            do not commute.
