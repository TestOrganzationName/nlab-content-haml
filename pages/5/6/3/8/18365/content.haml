                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi po
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi Cone
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} /
                            %mi Cone
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;\overset{f}{\longrightarrow}&amp; Y
                    \\\
                    \\downarrow &amp;(po)&amp; \downarrow
                    \\\
                    Cone(X) &amp;\longrightarrow&amp; Cone(f)
                    \\\
                    \\downarrow &amp;(po)&amp; \downarrow
                    \\\
                    \\ast &amp;\longrightarrow&amp; Cone(f)/Cone(X)
                    }
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/closed+Hurewicz+cofibration"} closed Hurewicz cofibration
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Cone
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi Cone
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Cone(X) \to Cone(f)
              = succeed "." do
                %a.maruku-ref{:href => "#CofibrantHomotopyEquivalencePushout"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo *
                  %annotation{:encoding => "application/x-tex"} Cone(X) \to \ast
              is a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
              (lemma
              = succeed ")," do
                %a.maruku-ref{:href => "#InclusionIntoCylinderIsHomotopyEquivalence"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Cone
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi Cone
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mi Cone
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Cone(f) \to Cone(f)/Cone(X)
              = succeed "." do
                %a.maruku-ref{:href => "#ContractibleSubcomplexQuotient"}
              %a.maruku-ref{:href => "#ForClosedImageQuotientOfMappingConeByCone"}
              there is also a homeomorphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Cone
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mi Cone
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mi Y
                      %mo{:stretchy => "false"} /
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Cone(f)/Cone(X) \simeq Y/f(X)
          #ForClosedImageQuotientOfMappingConeByCone.num_lemma
            %h6#lemma_3 Lemma
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \to Y
              be a
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              such that the
              %a.existingWikiWord{:href => "/nlab/show/image"} image
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f(X) \subset Y
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/closed+subset"} closed subset
            %p
              Then there is a
              %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Y
                    %mo{:stretchy => "false"} /
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Cone(f)/Cone(X) \simeq Y / f(X)
            %p
              between the
              %a.existingWikiWord{:href => "/nlab/show/quotient+space"} quotient space
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#QuotientBySubspace"}
              %a.existingWikiWord{:href => "/nlab/show/mapping+cone"} mapping cone
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#MappingConeCylinder"}
              %a.existingWikiWord{:href => "/nlab/show/cone"} cone
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ConeCyclinder"}
              %a.existingWikiWord{:href => "/nlab/show/quotient+space"} quotient space
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              be the
              %a.existingWikiWord{:href => "/nlab/show/image"} image
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          .proof
            %h6#proof_3 Proof
            %p
              Consider the following
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              in
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi f
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi Y
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi po
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi f
                            %mo{:stretchy => "false"} (
                            %mi Cone
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi Cone
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi po
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi Cone
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} /
                            %mi Cone
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    f(X) &amp;\longrightarrow&amp; Y
                    \\\
                    \\downarrow &amp;(po)&amp; \downarrow
                    \\\
                    f(Cone(X)) &amp;\longrightarrow&amp; Cone(f)
                    \\\
                    \\downarrow &amp;(po)&amp; \downarrow
                    \\\
                    \\ast &amp;\longrightarrow&amp; Cone(f)/Cone(X)
                    }
            %p
              Here the top square is a
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
              by example
              = succeed "," do
                %a.maruku-ref{:href => "#ClosedSubspacesGluing"}
              = succeed "." do
                %a.maruku-ref{:href => "#MappingConeCylinder"}
              %a.existingWikiWord{:href => "/nlab/show/pasting+law"} pasting law
              (prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#PastingLaw"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo{:stretchy => "false"} /
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Y/f(X)
              (by example
              = succeed ")." do
                %a.maruku-ref{:href => "#QuotientBySubspace"}
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              of the pushout.
          %h2#CofiberSequences Cofiber sequences
          #HomotopyEquivalenceSuspensionWithMappingConeOfMappingCone.num_prop
            %h6#proposition_4 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \to Y
              be a
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              with
              %a.existingWikiWord{:href => "/nlab/show/closed+subset"} closed
              %a.existingWikiWord{:href => "/nlab/show/image"} image
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo ⊂
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} f(X) \subset Y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cone(g)
              in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo ⟶
                              %mi f
                          %mtd
                            %mi Y
                          %mtd
                            %mover
                              %mo ⟶
                              %mi g
                          %mtd
                            %mi Cone
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                            %mi Cone
                            %mo{:stretchy => "false"} (
                            %mi g
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X
                    \&amp;\overset{f}{\longrightarrow}&amp;
                    Y
                    \&amp;\overset{g}{\longrightarrow}&amp;
                    Cone(f)
                    \&amp;\overset{}{\longrightarrow}&amp;
                    Cone(g)
                    }
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/mapping+cone"} mapping cone
              (spring) of the inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              into the mapping cone of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
            %p Then the canonical quotient coprojection
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Σ
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    Cone(g) \to \Sigma X
            %p
              to the
              %a.existingWikiWord{:href => "/nlab/show/suspension"} suspension
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#Suspension"}
              %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#HomotopyEquivalence"}
          .proof
            %h6#proof_4 Proof
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Y
                    %mo →
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} g \colon Y \to Cone(f)
              is a
              %a.existingWikiWord{:href => "/nlab/show/closed+Hurewicz+cofibration"} closed Hurewicz cofibration
              (by remark
              = succeed ")," do
                %a.maruku-ref{:href => "#MappingConePasting"}
              %a.maruku-ref{:href => "#RelativeCellComplexInclusionMappingCone"}
              gives that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Cone(g) \to Cone(f)/g(Y)
            %p
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
              %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %msub
                      %mo ∪
                      %mi f
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi Y
                    %mo ≃
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mo ≃
                    %mi S
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Cone(f)/g(Y)
                    \=
                    (Y \cup_f Cone(X))/Y
                    \\simeq
                    Cone(X)/X
                    \\simeq
                    S X
                    \\,.
          %p
            %img{:src => "http://ncatlab.org/nlab/files/mappingcone.jpg", :width => "660"}/
          %p
            (graphics taken from
            = succeed ")" do
              %a{:href => "http://personal.us.es/fmuro/praha.pdf"} Muro 10
          %p
            Hence from every
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f \colon X \to Y
            with closed image, we get long sequences
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
