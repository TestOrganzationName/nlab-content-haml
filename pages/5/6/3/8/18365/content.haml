              is a closed Hurwicz cofibration.
          #Suspension.num_example
            %h6#example_5 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/suspension"}> suspension
                )
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %a.existingWikiWord{:href => "/nlab/show/mapping+cone"} mapping cone
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#MappingConeCylinder"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mo *
                  %annotation{:encoding => "application/x-tex"} X \to \ast
              to the
              %a.existingWikiWord{:href => "/nlab/show/point+space"} point space
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mi X
                    %mo ≔
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo →
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %munder
                      %mo ⊔
                      %mi X
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
