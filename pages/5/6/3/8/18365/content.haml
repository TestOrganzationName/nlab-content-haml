                by a
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/subspace"} subspace
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} A \subset X
              a
              %a.existingWikiWord{:href => "/nlab/show/inhabited+set"} non-empty
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/subset"} subset
              %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              which identifies all points in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              with each other. The resulting
              %a.existingWikiWord{:href => "/nlab/show/quotient+space"} quotient space
              is denoted
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo{:stretchy => "false"} /
                      %mi A
                    %annotation{:encoding => "application/x-tex"} X/A
            %p
              Notice that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi A
                  %annotation{:encoding => "application/x-tex"} X/A
              is canonically a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/pointed+topological+space"} pointed topological space
              %a.existingWikiWord{:href => "/nlab/show/equivalence+class"} equivalence class
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} /
                    %mi A
                    %mo ⊂
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A/A \subset X/A
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo =
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} A = \emptyset
              is the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/empty+space"} empty space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi ∅
                    %mo ≔
                    %msub
                      %mi X
                      %mo +
                    %mo ≔
                    %mi X
                    %mo ⊔
                    %mo *
                  %annotation{:encoding => "application/x-tex"}
                    X/\emptyset \coloneqq X_+ \coloneqq X \sqcup \ast
            %p
              to be the
              %a.existingWikiWord{:href => "/nlab/show/disjoint+union+space"} disjoint union space
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/point+space"} point space
              %em
                %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} i \colon A \to X
              along the map
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo →
                      %mo *
                    %annotation{:encoding => "application/x-tex"} A \to \ast
              %a.existingWikiWord{:href => "/nlab/show/cokernel"} cokernel
              of the inclusion:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo ↪
                              %mi i
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi po
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi X
                            %mo{:stretchy => "false"} /
                            %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A &amp;\overset{i}{\hookrightarrow}&amp; X
                    \\\
                    \\downarrow &amp;(po)&amp; \downarrow
                    \\\
                    \\ast &amp;\longrightarrow&amp; X/A
                    }
                    \\,.
          #ClosedSubspacesGluing.num_example
            %h6#example_4 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/union"} union
                of two
                %a.existingWikiWord{:href => "/nlab/show/open+subset"} open
                or two
                %a.existingWikiWord{:href => "/nlab/show/closed+subset"} closed
                %a.existingWikiWord{:href => "/nlab/show/subspaces"} subspaces
                is
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ,
                    %mi B
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} A,B \subset X
              be
              %a.existingWikiWord{:href => "/nlab/show/subspaces"} subspaces
              such that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ,
                        %mi B
                        %mo ⊂
                        %mi X
                      %annotation{:encoding => "application/x-tex"} A,B \subset X
                  are both
                  %a.existingWikiWord{:href => "/nlab/show/open+subsets"} open subsets
                  or are both
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/closed+subsets"} closed subsets
              %li
                %p
                  they constitute a
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/cover"} cover
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo =
                        %mi A
                        %mo ∪
                        %mi B
                      %annotation{:encoding => "application/x-tex"} X = A \cup B
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mi A
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} i_A \colon A \to X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mi B
                    %mo{:lspace => "verythinmathspace"} :
                    %mi B
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} i_B \colon B \to X
              for the corresponding inclusion
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
            %p
              Then the
              %a.existingWikiWord{:href => "/nlab/show/commuting+square"} commuting square
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                            %mo ∩
                            %mi B
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi A
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi po
                            %mo{:stretchy => "false"} )
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi i
                                    %mi A
                        %mtr
                          %mtd
                            %mi B
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi i
                                  %mi B
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A \cap B &amp;\longrightarrow&amp; A
                    \\\
                    \\downarrow &amp;(po)&amp; \downarrow^{\mathrlap{i_A}}
                    \\\
                    B &amp;\underset{i_B}{\longrightarrow}&amp; X
                    }
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
              square in
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              (see
              = succeed ")." do
                %a{:href => "Top#UniversalConstructions"} there
            %p
              By the
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              of the
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
              this means in particular that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              any
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              then a function of underlying sets
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    f \;\colon\; X \longrightarrow Y
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              as soon as its two restrictions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %msub
                      %mo{:stretchy => "false"} |
                      %mi A
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi A
                    %mo ⟶
                    %mi Y
                    %mphantom
                      %mi AAAA
                    %mi f
                    %msub
                      %mo{:stretchy => "false"} |
                      %mi A
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi B
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    f\vert_A \;\colon\; A \longrightarrow Y
                    \\phantom{AAAA}
                    f\vert_A \;\colon\; B \longrightarrow Y
            %p are continuous.
          .proof
            %h6#proof Proof
            %p
              Clearly the underlying diagram of underlying
              %a.existingWikiWord{:href => "/nlab/show/sets"} sets
              is a pushout in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              = succeed ")" do
                %a{:href => "Top#DescriptionOfLimitsAndColimitsInTop"} this prop.
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topology
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is the
              %a.existingWikiWord{:href => "/nlab/show/final+topology"} final topology
              induced by the set of functions
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi i
                        %mi A
                      %mo ,
                      %msub
                        %mi i
                        %mi B
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{i_A, i_B\}
              %a.existingWikiWord{:href => "/nlab/show/subset"} subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} S \subset X
              is an
              %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
              precisely if the
              %a.existingWikiWord{:href => "/nlab/show/pre-images"} pre-images
              (restrictions)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi i
                      %mi A
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi S
                    %mo ∩
                    %mi A
                    %mphantom
                      %mi AAA
                    %mtext and
                    %mphantom
                      %mi AAA
                    %msubsup
                      %mi i
                      %mi B
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi S
                    %mo ∩
                    %mi B
                  %annotation{:encoding => "application/x-tex"}
                    i_A^{-1}(S) = S \cap A
                    \\phantom{AAA}
                    \\text{and}
                    \\phantom{AAA}
                    i_B^{-1}(S) = S \cap B
            %p
              are open subsets of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
            %p
              Now by definition of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/subspace+topology"} subspace topology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} S \subset X
              is open, then the intersections
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∩
                    %mi S
                    %mo ⊂
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A \cap S \subset A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ∩
                    %mi S
                    %mo ⊂
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B \cap S \subset B
              are open in these subspaces.
            %p
              Conversely, assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∩
                    %mi S
                    %mo ⊂
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A \cap S \subset A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ∩
                    %mi S
                    %mo ⊂
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B \cap S \subset B
              are open. We need to show that then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} S \subset X
              is open.
            %p
              Consider now first the case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ;
                    %mi B
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} A;B \subset X
              are both open open. Then by the nature of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/subspace+topology"} subspace topology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∩
                    %mi S
                  %annotation{:encoding => "application/x-tex"} A \cap S
              is open in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              means that there is an open subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mi A
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} S_A \subset X
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ∩
                      %mi S
                      %mo =
                      %mi A
                      %mo ∩
                      %msub
                        %mi S
                        %mi A
                    %annotation{:encoding => "application/x-tex"} A \cap S = A \cap S_A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∩
                    %msub
                      %mi S
                      %mi A
                  %annotation{:encoding => "application/x-tex"} A \cap S_A
              and hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∩
                    %mi S
                  %annotation{:encoding => "application/x-tex"} A \cap S
              is open. Similarly
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mo ∩
                      %mi S
                    %annotation{:encoding => "application/x-tex"} B \cap S
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi S
                          %mtd
                            %mo =
                            %mi S
                            %mo ∩
                            %mi X
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi S
                            %mo ∩
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo ∪
                            %mi B
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mi S
                            %mo ∩
                            %mi A
                            %mo{:stretchy => "false"} )
                            %mo ∪
                            %mo{:stretchy => "false"} (
                            %mi S
                            %mo ∩
                            %mi B
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    S
                    \&amp; =
                    S \cap X
                    \\\
                    \&amp; = S \cap (A \cup B)
                    \\\
                    \&amp; =  (S \cap A) \cup (S \cap B)
                    \\end{aligned}
            %p is the union of two open subsets and therefore open.
            %p
              Now consider the case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ,
                    %mi B
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} A,B \subset X
              are both closed subsets.
            %p
              Again by the nature of the subspace topology, that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∩
                    %mi S
                    %mo ⊂
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A \cap S \subset A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ∩
                    %mi S
                    %mo ⊂
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B \cap S \subset B
              are open means that there exist open subsets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mi A
                    %mo ,
                    %msub
                      %mi S
                      %mi B
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} S_A, S_B \subset X
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∩
                    %mi S
                    %mo =
                    %mi A
                    %mo ∩
                    %msub
                      %mi S
                      %mi A
                  %annotation{:encoding => "application/x-tex"} A \cap S = A \cap S_A
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mo ∩
                      %mi S
                      %mo =
                      %mi B
                      %mo ∩
                      %msub
                        %mi S
                        %mi B
                    %annotation{:encoding => "application/x-tex"} B \cap S = B \cap S_B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ,
                    %mi B
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} A,B \subset X
              are closed by assumption, this means that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∖
                    %mi S
                    %mo ,
                    %mi B
                    %mo ∖
                    %mi S
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} A \setminus S, B \setminus S \subset X
              are still closed, hence that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∖
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ∖
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi X
                    %mo ∖
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ∖
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X \setminus (A \setminus S), X \setminus (B \setminus S) \subset X
              are open.
            %p
              Now observe that (by
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/de+Morgan+duality"} de Morgan duality
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi S
                          %mtd
                            %mo =
                            %mi X
                            %mo ∖
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ∖
                            %mi S
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi X
                            %mo ∖
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo ∪
                            %mi B
                            %mo{:stretchy => "false"} )
                            %mo ∖
                            %mi S
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi X
                            %mo ∖
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo ∖
                            %mi S
                            %mo{:stretchy => "false"} )
                            %mo ∪
                            %mo{:stretchy => "false"} (
                            %mi B
                            %mo ∖
                            %mi S
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ∖
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo ∖
                            %mi S
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo ∩
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ∖
                            %mo{:stretchy => "false"} (
                            %mi B
                            %mo ∖
                            %mi S
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    S
                    \&amp; = X \setminus (X \setminus S)
                    \\\
                    \&amp; =
                    X \setminus ( (A \cup B) \setminus S )
                    \\\
                    \&amp; =
                    X \setminus ( (A \setminus S) \cup (B \setminus S) )
                    \\\
                    \&amp; =
                    (X \setminus (A \setminus S)) \cap (X \setminus (B \setminus S))
                    \\,.
                    \\end{aligned}
            %p
              This exhibits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              as the intersection of two open subsets, hence as open.
          %p A general abstract fact about pushouts which we will use repeatedly in the proofs below is the following:
          #PastingLaw.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/pasting+law"}> pasting law
                )
            %p
              Consider a
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              in
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              (or in any other
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/category"} category
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                            %mo ⟶
                          %mtd
                          %mtd
                            %mo ⟶
                          %mtd
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi po
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                          %mtd
                            %mo ⟶
                          %mtd
                          %mtd
                            %mo ⟶
                          %mtd
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;\longrightarrow&amp; &amp;\longrightarrow&amp;
                    \\\
                    \\downarrow &amp;(po)&amp; \downarrow &amp;&amp; \downarrow
                    \\\
                    \&amp;\longrightarrow&amp; &amp;\longrightarrow&amp;
                    }
                    \\,,
            %p
              where the left square is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
            %p
              Then: The total rectangle is a
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
              precisely if the right square is.
          %p
            We need the following two facts (prop.
            %a.maruku-ref{:href => "#CofibrantHomotopyEquivalencePushout"}
            prop.
            = succeed ")" do
              %a.maruku-ref{:href => "#ContractibleSubcomplexQuotient"}
          #CofibrantHomotopyEquivalencePushout.num_prop
            %h6#proposition_2 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
                of cofibrations)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              be a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ↪
                    %mi X
                  %annotation{:encoding => "application/x-tex"} A \hookrightarrow X
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/closed+Hurewicz+cofibration"} closed Hurewicz cofibration
            %p
              Then for every
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi A
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} f \colon A \to Y
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo *
                    %mi i
                  %annotation{:encoding => "application/x-tex"} f_\ast i
              in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo ⟶
                              %mi f
                          %mtd
                            %mi Y
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi i
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi po
                            %mo{:stretchy => "false"} )
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi f
                                    %mo *
                                  %mi i
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi X
                            %munder
                              %mo ⊔
                              %mi A
                            %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A &amp;\overset{f}{\longrightarrow}&amp; Y
                    \\\
                    {}^{\mathllap{i}}\downarrow &amp;(po)&amp; \downarrow^{\mathrlap{f_\ast i}}
                    \\\
                    X &amp;\longrightarrow&amp; X \underset{A}{\sqcup} Y
                    }
            %p
              is also a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/closed+Hurewicz+cofibration"} closed Hurewicz cofibration
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                      %annotation{:encoding => "application/x-tex"} i
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/retract"} retract
                  of a
                  %a.existingWikiWord{:href => "/nlab/show/relative+cell+complex"} relative cell complex
                  inclusion, then so is
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi f
                            %mo *
                          %mi i
                        %annotation{:encoding => "application/x-tex"} f_\ast i
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                      %annotation{:encoding => "application/x-tex"} i
                  is a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi f
                            %mo *
                          %mi i
                        %annotation{:encoding => "application/x-tex"} f_\ast i
          %p
            Prop.
            %a.maruku-ref{:href => "#CofibrantHomotopyEquivalencePushout"}
            is a consequence of the existence of the
            %a.existingWikiWord{:href => "/nlab/show/Str%C3%B8m+model+structure"} Strøm model structure
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Top
                    %mi Strom
                %annotation{:encoding => "application/x-tex"} Top_{Strom}
            and the
            %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+topological+spaces"} classical model structure on topological spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Top
                    %mi Quillen
                %annotation{:encoding => "application/x-tex"} Top_{Quillen}
            and of the fact that the identity
            %a.existingWikiWord{:href => "/nlab/show/functors"} functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Top
                    %mi Strom
                  %munderover
                    %mo ⊥
                    %munder
                      %mo ⟶
                      %mi id
                    %mover
                      %mo ⟵
                      %mi id
                  %msub
                    %mi Top
                    %mi Quillen
                %annotation{:encoding => "application/x-tex"} Top_{Strom} \underoverset{\underset{id}{\longrightarrow}}{\overset{id}{\longleftarrow}}{\bot} Top_{Quillen}
            constitute a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
          #ContractibleSubcomplexQuotient.num_prop
            %h6#proposition_3 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/quotient+space"} quotient
                by
                %a.existingWikiWord{:href => "/nlab/show/contractible+topological+space"} contractible
                closed subspace)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo ⟶
                    %mi X
                  %annotation{:encoding => "application/x-tex"} i \colon A \longrightarrow X
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/closed+Hurewicz+cofibration"} closed Hurewicz cofibration
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon A \to Y
              is a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#HomotopyEquivalence"}
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mo *
                    %mi f
                  %annotation{:encoding => "application/x-tex"} i_\ast f
              in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo ⟶
                              %mi i
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi f
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi po
                            %mo{:stretchy => "false"} )
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi i
                                    %mo *
                                  %mo{:stretchy => "false"} (
                                  %mi f
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mi Y
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi Y
                            %munder
                              %mo ⊔
                              %mi A
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A &amp;\overset{i}{\longrightarrow}&amp; X
                    \\\
                    {}^{\mathllap{f}}\downarrow &amp;(po)&amp; \downarrow^{\mathrlap{i_\ast(f)}}
                    \\\
                    Y &amp;\longrightarrow&amp; Y \underset{A}{\sqcup} X
                    }
            %p is also a homotopy equivalence.
            %p
              In particular if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is a
              %a.existingWikiWord{:href => "/nlab/show/contractible+topological+space"} contractible topological space
              (example
              = succeed ")," do
                %a.maruku-ref{:href => "#ContractibleTopologicalSpace"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⟶
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    X \longrightarrow X/A
            %p
              to the
              %a.existingWikiWord{:href => "/nlab/show/quotient+space"} quotient space
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#QuotientBySubspace"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
          %p
            Prop.
            %a.maruku-ref{:href => "#ContractibleSubcomplexQuotient"}
            is again a consequence of the existence of the
            %a.existingWikiWord{:href => "/nlab/show/Str%C3%B8m+model+structure"} Strøm model structure
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Top
                      %mi Strom
                  %annotation{:encoding => "application/x-tex"} Top_{Strom}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Top
                    %mi Strom
                %annotation{:encoding => "application/x-tex"} Top_{Strom}
            is a
            %a.existingWikiWord{:href => "/nlab/show/left+proper+model+category"} left proper model category
            which follows (
            %a{:href => "proper%20model%20category#AllObjectsFibrantImpliesRightProper"}> this cor.
            ) since all its objects are evidently cofibrant. An elementary proof in
            %a.existingWikiWord{:href => "/nlab/show/point-set+topology"} point-set topology
            is offered in (
            %a{:href => "algebraic+topology#Hatcher"}> Hatcher, prop. 0.17
            )
          %h2#mapping_cones Mapping cones
          #ConeCyclinder.num_defn
            %h6#definition_4 Definition
            %p
              %strong
                (topological
                %a.existingWikiWord{:href => "/nlab/show/cylinder"} cylinder
                and cone)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %ol
              %li
                %p
                  the
                  %em
                    standard
                    %a.existingWikiWord{:href => "/nlab/show/cylinder"} cylinder
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} product topological space
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Cyl
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo ≔
                        %mi X
                        %mo ×
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"}
                        Cyl(X) \coloneqq X \times [0,1]
              %li
                %p
                  the
                  %em
                    standard
                    %a.existingWikiWord{:href => "/nlab/show/cone"} cone
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/quotient+space"} quotient space
                  (example
                  = succeed ")" do
                    %a.maruku-ref{:href => "#QuotientBySubspace"}
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Cone
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo ≔
                        %mi Cyl
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} /
