                    \\simeq
                    Cone(X) \underset{X}{\sqcup} Cone(X)
                    \\,.
            %p
              This is called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/suspension"} suspension
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          %p
            The mapping cone of a map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X \to Y
            is to be thought of as the homotopy-quotient of the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            by
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.maruku-ref{:href => "#RelativeCellComplexInclusionMappingCone"}
            and lemma
            = succeed ":" do
              %a.maruku-ref{:href => "#ForClosedImageQuotientOfMappingConeByCone"}
          #RelativeCellComplexInclusionMappingCone.num_lemma
            %h6#lemma_2 Lemma
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \to Y
              is a
              %a.existingWikiWord{:href => "/nlab/show/closed+Hurewicz+cofibration"} closed Hurewicz cofibration
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#HurewiczCofibration"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cone
