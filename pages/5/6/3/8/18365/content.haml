                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Cone(f) \longrightarrow Y/f(X)
            %p
              from its
              %a.existingWikiWord{:href => "/nlab/show/mapping+cone"} mapping cone
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#MappingConeCylinder"}
              %a.existingWikiWord{:href => "/nlab/show/quotient+space"} quotient space
              (example
