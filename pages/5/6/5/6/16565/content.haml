                                  %mi μ
                                  %mn 7
                                %mo ≔
                                %mover
                                  %mi ψ
                                  %mo ¯
                                %msup
                                  %mi Γ
                                  %mrow
                                    %msub
                                      %mi a
                                      %mn 1
                                    %mi ⋯
                                    %msub
                                      %mi a
                                      %mn 5
                                %mo ∧
                                %mi ψ
                                %mo ∧
