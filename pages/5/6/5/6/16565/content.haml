                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi 𝔪
                            %mn 5
                            %mi 𝔟𝔯𝔞𝔫𝔢
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi 𝔪
                            %mn 2
                            %mi 𝔟𝔯𝔞𝔫𝔢
                          %mtd
