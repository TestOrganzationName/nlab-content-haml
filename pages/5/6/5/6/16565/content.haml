            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/differential+cohomology"} differential cohomology
          #StandardChoiceOfBGconn.num_example
            %h6#example Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
