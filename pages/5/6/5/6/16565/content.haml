                            %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathfrak{m}5\mathfrak{brane}
                    \\\
                    \\downarrow
                    \\\
                    \\mathfrak{m}2\mathfrak{brane}
                    \&amp;\stackrel{\mu_7\coloneqq\overline{\psi}\Gamma^{a_1 \cdots a_5}\wedge \psi \wedge e_{a_1}\wedge \cdots \wedge e_{a_5} + c_3\wedge \mu_4}{\longrightarrow}&amp;
                    b^6 \mathbb{R}
                    \\\
                    \\downarrow
                    \\\
                    \\mathbb{R}^{10,1\vert \mathbf{32}}
                    \&amp;\stackrel{\mu_4 \coloneqq \overline{\psi}\Gamma^{a_1 a_2}\wedge \psi \wedge e_{a_1}\wedge e_{a_2}}{\longrightarrow}&amp;
                    b^2 \mathbb{R}
                    }
            %p
              Here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔪
                    %mn 2
                    %mi 𝔟𝔯𝔞𝔫𝔢
                  %annotation{:encoding => "application/x-tex"} \mathfrak{m}2\mathfrak{brane}
              denotes the “
              %a.existingWikiWord{:href => "/nlab/show/supergravity+Lie+3-algebra"}> supergravity Lie 3-algebra
              ” regarded as an
              %a.existingWikiWord{:href => "/nlab/show/extended+super+Minkowski+spacetime"} extended super Minkowski spacetime
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
