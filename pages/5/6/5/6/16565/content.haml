                            %msub
                              %mo{:stretchy => "false"} )
                              %mi conn
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\widetilde{\hat X} &amp;\stackrel{\mathbf{L}_2^X}{\longrightarrow}&amp;
                    \\mathbf{B}(\mathbb{G}_2)_{conn}
                    \\\
                    \\downarrow
                    \\\
                    X &amp;\stackrel{\mathbf{L}_1^X}{\longrightarrow}&amp;
                    \\mathbf{B}(\mathbb{G}_1)_{conn}
                    }
                    \\,.
            %p
              The
              %em
                BPS charge
                = succeed "-group" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
              of this setup is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi BPS
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi g
                    %mo ,
                    %msubsup
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mn 1
                      %mi X
                    %mo ,
                    %msubsup
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mn 2
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msub
                      %mstyle{:mathvariant => "bold"}
