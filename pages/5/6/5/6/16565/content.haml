                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                  %annotation{:encoding => "application/x-tex"} \mathbf{L}
              itself is a consistent choice of
              %a.existingWikiWord{:href => "/nlab/show/prequantization"} prequantization
