                  %annotation{:encoding => "application/x-tex"} \mathbf{H}=
              %a.existingWikiWord{:href => "/nlab/show/SuperFormalSmooth%E2%88%9EGrpd"} SuperFormalSmooth∞Grpd
              as in example
              = succeed "." do
                %a.maruku-ref{:href => "#11dSugreEquationsOfMotionFromDefiniteGlobalization"}
            %p
              From the
              %a.existingWikiWord{:href => "/nlab/show/odd+line"} super point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 0
                        %mo{:stretchy => "false"} |
                        %mn 1
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{0|1} \in \mathbf{H}
              there emanates a
              %a.existingWikiWord{:href => "/schreiber/show/The+brane+bouquet"} bouquet
              of consecutive
              %a.existingWikiWord{:href => "/nlab/show/super+L-%E2%88%9E+algebra"} super L-∞ algebra
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra+extensions"} extensions
              = succeed "):" do
                %a{:href => "#FSS13"} FSS 13
            %div{:style => "float:left;margin:0 10px 10px 0;"}
              %img{:alt => "the brane bouquet", :src => "https://dl.dropboxusercontent.com/u/12630719/BraneBouquet.JPG"}/
            %p
              We now concentrate on the branch of this classified by the cocycles
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mn 4
                  %annotation{:encoding => "application/x-tex"} \mu_4
              for the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/M2-brane"} M2-brane
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mn 7
                  %annotation{:encoding => "application/x-tex"} \mu_7
              for the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/M5-brane"} M5-brane
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
