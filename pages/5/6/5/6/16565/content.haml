          %h4#homotopy_stabilizer_groups Homotopy stabilizer groups
          %blockquote
            %p
              recalled from
              %em
                %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+representations+and+associated+bundles"} geometry of physics – representations and associated bundles
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            an
