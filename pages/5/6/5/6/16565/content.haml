            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Iso
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{Iso}(X,\mathbf{g})
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/higher+gauge+symmetries"} higher gauge symmetries
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi g
                  %mo ,
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,\mathbf{g},\mathbf{L}^{X})
            is a
            %a.existingWikiWord{:href => "/nlab/show/Heisenberg+%E2%88%9E-group"} Heisenberg
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group+extension"} ∞-group extension
            of that. Since for the case of applications to
            %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
            (examples
            = succeed "," do
              %a.maruku-ref{:href => "#11dSugreEquationsOfMotionFromDefiniteGlobalization"}
            %a.maruku-ref{:href => "#M5ChargeExtensions"}
            below) the
            %a.existingWikiWord{:href => "/nlab/show/0-truncated"} 0-truncation
            of this
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group+extension"} ∞-group extension
            turns out to be the extension by
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/BPS+charges"} BPS charges
            %em BPS charge groups
            for homotopy stabilizers of definitely globalized higher WZW terms.
          %h4#for_a_single_brane_species
            For a single
            = succeed "-brane" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
          #BPSChargeGroup.num_defn
            %h6#definition_10 Definition
            %p
              Given a definite globalization
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mi X
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ⟶
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi 𝔾
                      %mi conn
                  %annotation{:encoding => "application/x-tex"} \mathbf{L}^X \colon X \longrightarrow \mathbf{B}\mathbb{G}_{conn}
              of a WZW term, def.
              = succeed "," do
                %a.maruku-ref{:href => "#DefiniteGlobalization"}
              %a.existingWikiWord{:href => "/nlab/show/G-structure"} G-structure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi g
                  %annotation{:encoding => "application/x-tex"} \mathbf{g}
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo =
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi Heis
                        %mrow
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi Aut
                            %mi grp
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi 𝔻
                            %mi V
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %msub
                        %mo{:stretchy => "false"} |
                        %mrow
                          %msup
                            %mi 𝔻
                            %mi V
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      G =
                      \\mathbf{Heis}_{\mathbf{Aut}_{grp}(\mathbb{D}^V)}(\mathbf{L}|_{\mathbb{D}^V})
              %em BPS charge group
              is the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Heisenberg+n-group"} Heisenberg n-group
              = succeed "," do
                %a.maruku-ref{:href => "#QuantomorphismGroup"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \mathbf{L}^X
              over the
              %a.existingWikiWord{:href => "/nlab/show/isometry+group"} isometry group
              of this
              = succeed "-structure:" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi BPS
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi g
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Heis
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi Iso
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mstyle{:mathvariant => "bold"}
                          %mi g
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    BPS(X,\mathbf{g}, \mathbf{L})
                    \\coloneqq
                    \\mathbf{Heis}_{\mathbf{Iso}(X,\mathbf{g})}(X,\mathbf{L}^X)
                    \\,.
          .num_remark
            %h6#remark_3 Remark
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/super+Minkowski+spacetime"} super Minkowski spacetime
              %a.existingWikiWord{:href => "/nlab/show/super+L-%E2%88%9E+algebra"} super L-∞ algebra
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi BPS
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi g
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} BPS(X,\mathbf{g}, \mathbf{L})
              %a.maruku-ref{:href => "#BPSChargeGroup"}
              is the
              %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket+L-%E2%88%9E+algebra"} Poisson bracket L-∞ algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔓𝔬𝔦𝔰
