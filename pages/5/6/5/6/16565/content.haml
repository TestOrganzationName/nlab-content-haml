                        %mi L
                  %annotation{:encoding => "application/x-tex"} \omega = F_{\mathbf{L}}
              regarded as a
              %a.existingWikiWord{:href => "/nlab/show/pre-n-plectic+form"} pre-(p+1)-plectic form
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed ")." do
                %a{:href => "#FRS13b"} FRS 13b, section 4
          %p
            Accordingly we find
            = succeed "-algebraic" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
            = succeed "-extensions" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed ":" do
              %a.maruku-ref{:href => "#LieKSExtension"}
          #LieKSExtension.num_prop
            %h6#proposition_7 Proposition
            %p
              There is a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequence"} homotopy fiber sequence
              in the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory+of+L-%E2%88%9E+algebras"} homotopy theory of L-∞ algebras
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mo ♭
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mi p
                            %mi ℝ
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %msub
                              %mi 𝔓𝔬𝔦𝔰
                              %mrow
                                %mi Iso
                                %mo{:stretchy => "false"} (
                                %mi X
                                %mo ,
                                %mi g
                                %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mi ω
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi HamIso
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mi g
                            %mo ,
                            %mi ω
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mi ks
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mo ♭
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mi p
                            %mi ℝ
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbf{H}(X,\flat \mathbf{B}^p \mathbb{R})
                    \&amp;\longrightarrow&amp;
                    \\mathfrak{Pois}_{Iso(X,g)}(X,\omega)
                    \\\
                    \&amp;&amp; \downarrow
                    \\\
                    \&amp;&amp; HamIso(X,g,\omega)
                    \&amp;\stackrel{ks}{\longrightarrow}&amp;
                    \\mathbf{B}\mathbf{H}(X,\flat \mathbf{B}^p \mathbb{R})
                    }
            %p
              which exhibits the
              %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket+L-%E2%88%9E+algebra"} Poisson bracket L-∞ algebra
              as an
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra+extension"} L-∞ algebra extension
              of the Lie algebra of
              = succeed "-Hamiltonian" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ω
                    %annotation{:encoding => "application/x-tex"} \omega
              %a.existingWikiWord{:href => "/nlab/show/Killing+vectors"} Killing vectors
              and
              %a.existingWikiWord{:href => "/nlab/show/Killing+spinors"} Killing spinors
              by the truncated
              %a.existingWikiWord{:href => "/nlab/show/de+Rham+complex"} de Rham complex
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo ♭
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi p
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Ω
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mi d
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mi d
                    %mi ⋯
                    %mover
                      %mo →
                      %mi d
                    %msubsup
                      %mi Ω
                      %mi cl
                      %mi p
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{H}(X,\flat \mathbf{B}^p \mathbb{R})
                    \\simeq
                    (\Omega^0(X)\stackrel{d}{\to} \Omega^1(X)\stackrel{d}{\to} \cdots \stackrel{d}{\to} \Omega^p_{cl}(X))
            %p
              in degree
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              = succeed "-algebra." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
          %p
            (
            %a{:href => "#FRS13b"}> FRS 13b, theorem 3.3.1
            )
          .num_remark
            %h6#remark_4 Remark
            %p
              By (
              %a{:href => "#FRS13b"}> FRS 13b, theorem 4.2.2
              )
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔓𝔬𝔦𝔰
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{Pois}(X,\omega)
              has a model by the
              %a.existingWikiWord{:href => "/nlab/show/dg-Lie+algebra"} dg-Lie algebra
              (
              %a{:href => "#FRS13b"}> FRS 13b, def./prop. 4.2.1
              ). Its bracket in degree-0 (
              %a{:href => "#FRS13b"}> FRS 13b, equation (4.2.1)
              ) is the bracket of
              %a.existingWikiWord{:href => "/nlab/show/Noether+currents"} Noether currents
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              regarded as a WZW curvature as considered in (
              %a{:href => "#AGIT89"}> AGIT 89
              ).
          %p
            But
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔓𝔬𝔦𝔰
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ω
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathfrak{Pois}(X,\omega)
            encodes also the higher order currents between these currents, which get quotiented out when passing to its degree-0
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Postnikov+stage"} Postnikov stage
          #0TruncationOfHigherPoissonBracket.num_prop
            %h6#proposition_8 Proposition
            %p
              For connective
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebras"} L-∞ algebras
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mn 0
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi L
                      %mn ∞
                    %msub
                      %mi Alg
                      %mrow
                        %mo ≥
                        %mn 0
                    %mo ⟶
                    %mi LieAlg
                  %annotation{:encoding => "application/x-tex"}
                    \\tau_0
                    \\colon
                    L_\infty Alg_{\geq 0}
                    \\longrightarrow
                    LieAlg
            %p
              to
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebras"} Lie algebras
              %a.maruku-ref{:href => "#LieKSExtension"}
              becomes a
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+extension"} Lie algebra extension
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msubsup
                      %mi H
                      %mi dR
                      %mi p
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mi τ
                      %mn 0
                    %mi 𝔓𝔬𝔦𝔰
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi Ham
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    0 \to H^p_{dR}(X) \longrightarrow \tau_0 \mathfrak{Pois}(X,\omega)
                    \\longrightarrow
                    Ham(X,\omega)
                    \\to
                    0
            %p
              of the
              %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+vector+fields"} Hamiltonian vector fields
              by the degree-
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              %a.existingWikiWord{:href => "/nlab/show/de+Rham+cohomology"} de Rham cohomology
              group of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          %h4#for_branes_ending_on_branes
            For
            = succeed "-branes" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} p_1
            = succeed "-branes" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} p_2
          %p
            Consider now two
            %a{:href => "http://ncatlab.org/nlab/show/geometry+of+physics+--+WZW+terms#ConsecutiveWZWTermsAndTwists"} consecutive WZW terms
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mover
                            %mover
                              %mi V
                              %mo{:stretchy => "false"} ^
                            %mo ˜
                        %mtd
                          %mover
                            %mo ⟶
                            %mrow
                              %msub
                                %mstyle{:mathvariant => "bold"}
                                  %mi L
                                %mn 2
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi 𝔾
                            %mn 2
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi conn
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi V
                        %mtd
                          %mover
                            %mo ⟶
                            %mrow
                              %msub
                                %mstyle{:mathvariant => "bold"}
                                  %mi L
                                %mn 1
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi 𝔾
                            %mn 1
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi conn
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\widetilde{\hat V} &amp;\stackrel{\mathbf{L}_2}{\longrightarrow}&amp;
                  \\mathbf{B}(\mathbb{G}_2)_{conn}
                  \\\
                  \\downarrow
                  \\\
