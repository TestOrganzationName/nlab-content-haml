                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+action"} Hamiltonian action
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequence"} homotopy fiber sequence
            %ol
              %li
                %p
                  if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔾
                      %annotation{:encoding => "application/x-tex"} \mathbb{G}
                  is
                  %a.existingWikiWord{:href => "/nlab/show/0-truncated"} 0-truncated
                  then
