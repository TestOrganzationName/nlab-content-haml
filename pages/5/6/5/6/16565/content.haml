              %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} Smooth∞Grpd
              we have
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔾
                    %mo =
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi p
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %mo{:stretchy => "false"} /
                    %mi Γ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{G} = \mathbf{B}^p (\mathbb{R}/\Gamma)
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo =
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \Gamma = \mathbb{Z}
              is the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/circle+n-group"} circle (p+1)-group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi 𝔾
                      %mi conn
                    %mo =
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi p
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi conn
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}\mathbb{G}_{conn} = \mathbf{B}^p U(1)_{conn}
              presented via the
              %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan correspondence
              by the
              %a.existingWikiWord{:href => "/nlab/show/Deligne+complex"} Deligne complex
              in degree
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo +
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (p+2)
          #DifferentialConcretification.num_defn
            %h6#definition_5 Definition
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi conc
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi 𝔾
                      %mi conn
                    %mo{:stretchy => "false"} ]
                    %mo ⟶
                    %mi 𝔾
                    %mstyle{:mathvariant => "bold"}
                      %mi Conn
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    conc \colon [X,\mathbf{B}\mathbb{G}_{conn}] \longrightarrow \mathbb{G}\mathbf{Conn}(X)
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/differential+concretification"} differential concretification
              of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
          %p
            This is the proper
            %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
            of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔾
                  %annotation{:encoding => "application/x-tex"} \mathbb{G}
            %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-connections"} principal ∞-connections
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            in that a family
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ⟶
                  %mi 𝔾
                  %mstyle{:mathvariant => "bold"}
                    %mi Conn
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} U \longrightarrow \mathbb{G}\mathbf{Conn}(X)
            is a
            %em vertical
            = succeed "-principal" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔾
                  %annotation{:encoding => "application/x-tex"} \mathbb{G}
            = succeed "-connection" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ×
                    %mi X
                    %mo →
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U \times X\to U
          .num_example
            %h6#example_2 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo =
                  %annotation{:encoding => "application/x-tex"} \mathbf{H} =
              %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} Smooth∞Grpd
              or =
              %a.existingWikiWord{:href => "/nlab/show/FormalSmooth%E2%88%9EGrpd"}> FormalSmooth∞Grpd
              , for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔾
                    %mo =
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi p
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{G} = \mathbf{B}^p U(1)
              the
              %a.existingWikiWord{:href => "/nlab/show/circle+n-group"} circle (p+1)-group
              with its standard Hodge filtration as in example
              = succeed "," do
                %a.maruku-ref{:href => "#StandardChoiceOfBGconn"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              any
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              or
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/formal+smooth+manifold"} formal smooth manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi p
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mstyle{:mathvariant => "bold"}
                      %mi Conn
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathbf{B}^p U(1))\mathbf{Conn}(X)
              is presented via the
              %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan correspondence
              by the sheaf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ↦
                    %msub
                      %mi Ch
                      %mo •
                  %annotation{:encoding => "application/x-tex"} U \mapsto Ch_\bullet
              of
              %a.existingWikiWord{:href => "/nlab/show/vertical+differential+form"} vertical
              %a.existingWikiWord{:href => "/nlab/show/Deligne+complexes"} Deligne complexes
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ×
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U \times X
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
          .num_defn
            %h6#proposition_2 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔾
                    %mo ≃
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi 𝔾
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \mathbb{G} \simeq \mathbf{B}\mathbb{G}'
              then the
              %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop space object
              of the moduli stack of
              = succeed "-principal" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔾
                    %annotation{:encoding => "application/x-tex"} \mathbb{G}
              = succeed "-connections" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is the moduli stack of
              %a.existingWikiWord{:href => "/nlab/show/flat+%E2%88%9E-connections"} flat ∞-connections
              with gauge group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                    %mi 𝔾
                  %annotation{:encoding => "application/x-tex"} \Omega \mathbb{G}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ω
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi 𝔾
                    %mstyle{:mathvariant => "bold"}
                      %mi Conn
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %mi Ω
                    %mi 𝔾
                    %mo{:stretchy => "false"} )
                    %mstyle{:mathvariant => "bold"}
                      %mi FlatConn
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega_0 (\mathbb{G}\mathbf{Conn}(X))
                    \\simeq
                    (\Omega\mathbb{G})\mathbf{FlatConn}(X)
                    \\,.
          #PrecompositionActionOnGConn.num_prop
            %h6#proposition_3 Proposition
            %p
              The canonical
              %a.existingWikiWord{:href => "/nlab/show/precomposition+action"} precomposition
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-action"} ∞-action
              of the
              %a.existingWikiWord{:href => "/nlab/show/automorphism+%E2%88%9E-group"} automorphism ∞-group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Aut
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{Aut}(X)
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi 𝔾
                      %mi conn
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [X,\mathbf{B}\mathbb{G}_{conn}]
              passes along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi conc
                  %annotation{:encoding => "application/x-tex"} conc
              to an
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-action"} ∞-action
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔾
                      %mstyle{:mathvariant => "bold"}
                        %mi Conn
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbb{G}\mathbf{Conn}(X)
          #QuantomorphismGroup.num_defn
            %h6#definition_6 Definition
            %p
              Given a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔾
                    %annotation{:encoding => "application/x-tex"} \mathbb{G}
              %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-connection"} principal ∞-connection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ⟶
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi 𝔾
                      %mi conn
                  %annotation{:encoding => "application/x-tex"} \nabla \colon X \longrightarrow \mathbf{B}\mathbb{G}_{conn}
              there are the following concepts in
              = succeed "." do
                %a.existingWikiWord{:href => "/schreiber/show/Higher+geometric+prequantum+theory"} higher geometric prequantum theory
            %ol
              %li
                %p
                  The
                  %strong
                    %a.existingWikiWord{:href => "/nlab/show/quantomorphism+%E2%88%9E-group"} quantomorphism ∞-group
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/stabilizer+%E2%88%9E-group"} stabilizer ∞-group
                  of
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo ∇
                          %mo ∈
                          %mi 𝔾
                          %mstyle{:mathvariant => "bold"}
                            %mi Conn
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \nabla \in \mathbb{G}\mathbf{Conn}(X)
                  = succeed "," do
                    %a.maruku-ref{:href => "#DifferentialConcretification"}
                  = succeed "-action" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi Aut
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \mathbf{Aut}(X)
                  = succeed ";" do
                    %a.maruku-ref{:href => "#PrecompositionActionOnGConn"}
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi QuantMorph
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mo ∇
                        %mo{:stretchy => "false"} )
                        %mo ≔
                        %msub
                          %mstyle{:mathvariant => "bold"}
                            %mi Stab
                          %mrow
                            %mstyle{:mathvariant => "bold"}
                              %mi Aut
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mi conc
                        %mo{:stretchy => "false"} (
                        %mo ∇
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\mathbf{QuantMorph}(X,\nabla)
                        \\coloneqq
                        \\mathbf{Stab}_{\mathbf{Aut}(X)}(conc(\nabla))
                        \\,.
              %li
                %p
                  The
                  %strong
                    %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+symplectomorphism+%E2%88%9E-group"} Hamiltonian symplectomorphism ∞-group
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi HamSymp
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mo ∇
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %mstyle{:mathvariant => "bold"}
                          %mi Aut
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\mathbf{HamSymp}(X,\nabla) \longrightarrow \mathbf{Aut}(X)
                %p
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/1-image"} 1-image
                  of the canonical morphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi QuantMorph
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mo ∇
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %mstyle{:mathvariant => "bold"}
                          %mi Aut
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathbf{QuantMorph}(X,\nabla) \longrightarrow \mathbf{Aut}(X)
                  from remark
                  = succeed "." do
                    %a.maruku-ref{:href => "#StabilizerGroupAsFactorization"}
              %li
                %p
                  A
                  %strong
                    %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+action"} Hamiltonian action
                  of an
                  %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mo ∇
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (X,\nabla)
                  is an
                  %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
                  homomorphism
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ρ
                        %mo{:lspace => "verythinmathspace"} :
                        %mi G
                        %mo ⟶
                        %mstyle{:mathvariant => "bold"}
                          %mi HamSymp
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mo ∇
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                      %annotation{:encoding => "application/x-tex"}
                        \\rho \colon G \longrightarrow \mathbf{HamSymp}(X,\nabla)
                        \\;
              %li
                %p
                  An
                  %strong
                    %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-moment+map"} ∞-moment map
                  is an
                  = succeed "-group" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn ∞
                        %annotation{:encoding => "application/x-tex"} \infty
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                        %mo ⟶
                        %mstyle{:mathvariant => "bold"}
                          %mi QuantMorph
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mo ∇
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        G \longrightarrow \mathbf{QuantMorph}(X,\nabla)
              %li
                %p
                  The
                  %strong
                    %a.existingWikiWord{:href => "/nlab/show/Heisenberg+%E2%88%9E-group"} Heisenberg ∞-group
                  for a given Hamiltonian
                  = succeed "-action" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ρ
                      %annotation{:encoding => "application/x-tex"} \rho
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mstyle{:mathvariant => "bold"}
                            %mi Heis
                          %mi G
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mo ∇
                        %mo{:stretchy => "false"} )
                        %mo ≔
                        %msup
                          %mi ρ
                          %mo *
                        %mstyle{:mathvariant => "bold"}
                          %mi QuantMorph
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mo ∇
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\mathbf{Heis}_G(X,\nabla) \coloneqq \rho^\ast \mathbf{QuantMorph}(X,\nabla)
                        \\,.
          .num_example
            %h6#example_3 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo =
                  %annotation{:encoding => "application/x-tex"} \mathbf{H} =
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} Smooth∞Grpd
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi SmoothMfd
                    %mo ↪
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} X \in SmoothMfd \hookrightarrow \mathbf{H}
              a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              and for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                  %annotation{:encoding => "application/x-tex"} \nabla
              a
              %a.existingWikiWord{:href => "/nlab/show/prequantum+line+bundle"} prequantum line bundle
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi QuantMorph
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo ∇
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{QuantMorph}(X,\nabla)
              is Soriau’s
              %a.existingWikiWord{:href => "/nlab/show/quantomorphism+group"} quantomorphism group
              covering the
              %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+diffeomorphism"} Hamiltonian diffeomorphism
              group. In the case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi F
                      %mo ∇
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X, F_\nabla)
              is a
              %a.existingWikiWord{:href => "/nlab/show/symplectic+vector+space"} symplectic vector space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %mi V
                  %annotation{:encoding => "application/x-tex"} X = V
              regarded as a linear symplectic manifold with Hamiltonian action on itself by translation, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Heis
                      %mi V
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo ∇
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{Heis}_{V}(X,\nabla)
              is the traditional
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Heisenberg+group"} Heisenberg group
          .num_remark
            %h6#remark_2 Remark
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi HamSymp
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo ∇
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mstyle{:mathvariant => "bold"}
                      %mi Aut
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{HamSymp}(X,\nabla)\hookrightarrow \mathbf{Aut}(X)
              is by construction a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/1-monomorphism"} 1-monomorphism
              = succeed "-action" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi G
                    %mo ⟶
                    %mstyle{:mathvariant => "bold"}
                      %mi Aut
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \rho \colon G \longrightarrow \mathbf{Aut}(X)
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ρ
