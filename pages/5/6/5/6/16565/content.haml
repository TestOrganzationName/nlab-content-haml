                        %mi L
                      %mn 1
                    %mo ,
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathbf{L}_1,\mathbf{L}_2)
              and given a define globalization, def.
              = succeed "," do
                %a.maruku-ref{:href => "#DefiniteGlobalization"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
