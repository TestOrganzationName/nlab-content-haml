            equipped with a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Hodge+filtration"} Hodge filtration
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
