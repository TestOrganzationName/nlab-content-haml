                  %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (p+2)
            %a.existingWikiWord{:href => "/nlab/show/differential+form"} differential form
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            which is a
            %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+WZW+terms"} WZW
            %a.existingWikiWord{:href => "/nlab/show/curvature+form"} curvature form
            %a.existingWikiWord{:href => "/nlab/show/definite+form"} definite
            on the
            %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+cohomology"} cocycle
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi ψ
                    %mo ¯
                  %mo ∧
                  %msup
                    %mi Γ
                    %mrow
                      %msub
                        %mi a
                        %mn 1
                      %mi ⋯
                      %msub
                        %mi a
                        %mi p
                  %mi ψ
                  %mo ∧
                  %msub
                    %mi e
                    %mrow
                      %msub
                        %mi a
                        %mn 1
                  %mo ∧
                  %mi ⋯
                  %mo ∧
                  %msub
                    %mi e
                    %mrow
                      %msub
                        %mi a
                        %mi p
                  %mo ∈
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mrow
                      %mi d
                      %mo −
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} |
                      %mi N
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\overline \psi \wedge \Gamma^{a_1 \cdots a_p} \psi \wedge e_{a_1} \wedge \cdots \wedge e_{a_p}
                  \\in
                  CE(\mathbb{R}^{d-1,1\vert N})
          %p
            for
            %a.existingWikiWord{:href => "/nlab/show/Green-Schwarz+super+p-brane+sigma+model"} Green-Schwarz super p-brane sigma model
            with
            %a.existingWikiWord{:href => "/nlab/show/target+space"} target space
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a{:href => "super+Poincare+Lie+algebra#PolyvectorExtensions"} Polyvector extensions
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi Q
                    %mi α
                  %mo ,
                  %msub
                    %mi Q
                    %mi β
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Γ
                    %mi a
                  %mi C
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi α
                      %mi β
                  %msub
                    %mi P
                    %mi a
                  %mo +
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Γ
                    %mrow
                      %msub
                        %mi a
                        %mn 1
                      %mi ⋯
                      %msub
                        %mi a
                        %mi p
                  %mi C
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi α
                      %mi β
                  %msub
                    %mi Z
                    %mrow
                      %msub
                        %mi a
                        %mn 1
                      %mi ⋯
                      %msub
                        %mi a
                        %mi p
                %annotation{:encoding => "application/x-tex"}
                  [Q_\alpha, Q_\beta] = (\Gamma^a C)_{\alpha\beta} P_a + (\Gamma^{a_1\cdots a_p}C)_{\alpha \beta} Z_{a_1\cdots a_p}
          %p
            of the
            %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
            of
            %a.existingWikiWord{:href => "/nlab/show/super-isometries"} super-isometries
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,g)
            by
            %a.existingWikiWord{:href => "/nlab/show/charges"} charges
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Z
                %annotation{:encoding => "application/x-tex"} Z
            of
            %a.existingWikiWord{:href => "/nlab/show/Noether+currents"} Noether currents
            of the
            %a.existingWikiWord{:href => "/nlab/show/super+p-brane+sigma+model"} super p-brane sigma model
            are known as algebras of
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/BPS+charges"} BPS charges
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi g
                  %mo ,
                  %mi ω
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,g,\omega)
            is called a
            %em
              %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mfrac
                        %mn 1
                        %mi k
                    %annotation{:encoding => "application/x-tex"} \frac{1}{k}
              %a.existingWikiWord{:href => "/nlab/show/BPS+state"} BPS state
            if the dimension of the space of
            %a.existingWikiWord{:href => "/nlab/show/supercharges"} supercharges
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                %annotation{:encoding => "application/x-tex"} Q
            in the
            %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
            of the above bracket is
            = succeed "th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mn 1
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \frac{1}{k}
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/super+Minkowski+spacetime"} super Minkowski spacetime
          %p
            This is well understood in the literature (
            %a{:href => "#AGIT89"}> Azcárraga-Gauntlett-Izquierdo-Townsend 89
            ) for the case that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is locally modeled on an ordinary
            %a.existingWikiWord{:href => "/nlab/show/super+Minkowski+spacetime"} super Minkowski spacetime
            and that the
            = succeed "-brane" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %em old
            %a.existingWikiWord{:href => "/nlab/show/brane+scan"} brane scan
            (e.g the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/type+II+superstrings"} type II superstrings
            %a.existingWikiWord{:href => "/nlab/show/heterotic+superstring"} heterotic superstring
            and the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/M2-brane"} M2-brane
            %a.existingWikiWord{:href => "/nlab/show/super+1-brane+in+3d"} super 1-brane in 3d
            and the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/3-brane+in+6d"} 3-brane in 6d
            %a.existingWikiWord{:href => "/nlab/show/D-branes"} D-branes
            and not the
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/M5-brane"} M5-brane
          %p
            For the full story of
            %a.existingWikiWord{:href => "/nlab/show/string+theory"} string theory
            this needs to be refined in three ways (see
            = succeed ")," do
              %a.existingWikiWord{:href => "/schreiber/show/The+brane+bouquet"} Fiorenza-Sati-Schreiber 13
            %a.existingWikiWord{:href => "/nlab/show/higher+differential+geometry"} higher differential geometry
            that could handle this:
          %ol
            %li
              %p
                For a genuine global definition of the
                %a.existingWikiWord{:href => "/nlab/show/Green-Schwarz+super+p-brane+sigma+model"} Green-Schwarz super p-brane sigma model
                with target
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi ω
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (X,\omega)
                %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
                form
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ω
                    %annotation{:encoding => "application/x-tex"} \omega
                needs to be
                %a.existingWikiWord{:href => "/nlab/show/prequantization"} prequantized
                to a globally well-defined
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+WZW+terms"} WZW term
                %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
                in
                %a.existingWikiWord{:href => "/nlab/show/Deligne+cohomology"} Deligne cohomology
                (a
                = succeed ")." do
                  %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle (p1+1)-bundle with connection
              %p
                (The need for this has broadly been ignored, one place where it is mentioned is (
                %a{:href => "#Witten86"}> Witten 86, p. 17
                ).)
            %li
              %p
                For the inclusion of charges of
                = succeed "-branes" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi p
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} p_2
                = succeed "-branes" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi p
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} p_1
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi p
                          %mn 1
                        %mo =
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} p_1 = 1
                %a.existingWikiWord{:href => "/nlab/show/type+II+strings"} type II strings
                ending on
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/D-branes"} D-branes
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mn 1
                      %mo =
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} p_1= 2
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mn 2
                      %mo =
                      %mn 5
                    %annotation{:encoding => "application/x-tex"} p_2 = 5
                %a.existingWikiWord{:href => "/nlab/show/M2-branes"} M2-branes
                ending on
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/M5-branes"} M5-branes
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                is to be locally modeled on an
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/extended+super+Minkowski+spacetime"} extended super Minkowski spacetime
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/super+formal+smooth+infinity-groupoid"} super orbispace
                %a.existingWikiWord{:href => "/nlab/show/higher+Cartan+geometry"} higher Cartan geometry
                and one needs to make sense of
                %a.existingWikiWord{:href => "/nlab/show/Noether+currents"} Noether currents
                there.
              %p
                (Arguments in this direction for the
                %a.existingWikiWord{:href => "/nlab/show/D-branes"} D-branes
                have been given in (
                %a{:href => "BPS+state#Hammer97"}> Hammer 97
                ) and for the
                %a.existingWikiWord{:href => "/nlab/show/M5-brane"} M5-brane
                in (
                %a{:href => "BPS+state#SorokinTownsend97"}> Sorokin-Townsend 97
                ).)
            %li
              %p
                For inclusion of non-infinitesimal isometries one needs the global structure of the full
                %a.existingWikiWord{:href => "/nlab/show/supergroup"} supergroup
                of BPS charges, not just its
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
          %p
            Here we discuss how to solve these problems in full generality (
            %a{:href => "#SatiSchreiber15"}> Sati-Schreiber 15
            ). Specified to the situation in
            %a.existingWikiWord{:href => "/nlab/show/11-dimensional+supergravity"} 11-dimensional supergravity
            with
            %a.existingWikiWord{:href => "/nlab/show/M2-branes"} M2-branes
            and
            %a.existingWikiWord{:href => "/nlab/show/M5-branes"} M5-branes
            we find that the BPS charges traditionally seen in the
            %a.existingWikiWord{:href => "/nlab/show/M-theory+super+Lie+algebra"} M-theory super Lie algebra
            as living in
            %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ⊕
                  %msup
                    %mi H
                    %mn 5
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H^2(X) \oplus H^5(X)
            of spacetime
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            receive corrections by
            = succeed "-differentials" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mn 4
                  %annotation{:encoding => "application/x-tex"} d_4
            %a.existingWikiWord{:href => "/nlab/show/Serre+spectral+sequence"} Serre spectral sequence
            given by
            %a.existingWikiWord{:href => "/nlab/show/cup+product"} cup product
            with the class of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/supergravity+C-field"} supergravity C-field
            %a.existingWikiWord{:href => "/nlab/show/D-brane+charges"} D-brane charges
            are well known (
            %a{:href => "D-brane#MaldacenaMooreSeiberg01"}> Maldacena-Moore-Seiberg 01
            ) to be in
            %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
            only up to corrections of the
            = succeed "-differential" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} d_3
            %a.existingWikiWord{:href => "/nlab/show/Atiyah-Hirzebruch+spectral+sequence"} Atiyah-Hirzebruch spectral sequence
            for
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/twisted+K-theory"} twisted K-theory
            %a.existingWikiWord{:href => "/nlab/show/cup+product"} cup product
            with the class of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/B-field"} B-field
            = succeed ")" do
              %a{:href => "M5-brane+charge#Sati10"} Sati 10
            %a.existingWikiWord{:href => "/nlab/show/M5-brane+charge"} M5-brane charge
            should really be in
            %a.existingWikiWord{:href => "/nlab/show/twisted+generalized+cohomology"} twisted
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/elliptic+cohomology"} elliptic cohomology
            = succeed ")." do
              %a{:href => "tmf#ABG10"} Ando-Blumberg-Gepner 10
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mrow
                      %mi M
                      %mn 5
                    %mi X
                %annotation{:encoding => "application/x-tex"} \mathbf{L}_{M5}^X
            that we construct in
            %a.existingWikiWord{:href => "/nlab/show/ordinary+differential+cohomology"} ordinary differential cohomology
            %a{:href => "#M5BraneChargesInAnM2BraneCondensate"} below
            to ellitptic differential cohomology. Discussion of that refinement is beyond the scope of this page here.)
          %p
            We also close a gap in (
            %a{:href => "#AGIT89"}> AGIT89
            ): what is strictly derived there from the
            %a.existingWikiWord{:href => "/nlab/show/Noether+theorem"} Noether theorem
            is extension of the
            %a.existingWikiWord{:href => "/nlab/show/supersymmetry"} supersymmetry
            algebra by
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/differential+forms"} differential forms
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+cohomology"} de Rham cohomology
            class of these forms that matters relies on physics intuition. We find here that the
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            of
            %a.existingWikiWord{:href => "/nlab/show/conserved+currents"} conserved currents
            extending the (super-)isometry algebra is naturally not just a (
            %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"}> super-
            )
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            but a (
            %a.existingWikiWord{:href => "/nlab/show/super+L-infinity+algebra"}> super-
            )
            %a.existingWikiWord{:href => "/nlab/show/Lie+n-algebra"} Lie (p+1)-algebra
            including higher order symmetries of Noether symmetries. It is by quotienting these out when restricting the current Lie
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/Postnikov+tower"} Postnikov stage
            that current forms pass to their de Rham equivalence classes. Accordingly, the fully globalized current groups that we find are really (
            %a.existingWikiWord{:href => "/nlab/show/super+smooth+infinity-groupoid"}> super-
            )
            %a.existingWikiWord{:href => "/nlab/show/smooth+infinity-group"}> smooth n-groups
            \. For instance the
            %a.existingWikiWord{:href => "/nlab/show/M-theory+super+Lie+algebra"} M-theory super Lie algebra
            is refines to a super Lie 6-group, where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 6
                  %mo =
                  %mn 5
                  %mo +
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 6 = 5+1
            is the dimension of the
            %a.existingWikiWord{:href => "/nlab/show/M5-brane"} M5-brane
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/worldvolume"} worldvolume
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            We formulate the theory general abstractly in the context of
            %a.existingWikiWord{:href => "/nlab/show/higher+differential+geometry"} higher differential geometry
            given by an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            equipped with
            %a.existingWikiWord{:href => "/nlab/show/cohesion"} cohesion
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/differential+cohesion"} differential cohesion
            %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
            takes place in the model
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo =
                %annotation{:encoding => "application/x-tex"} \mathbf{H} =
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/SuperFormalSmooth%E2%88%9EGrpd"} SuperFormalSmooth∞Grpd
          %h3#prerequisites Prerequisites
          %p
            For ease of reference, we recall here some definitions and propositions form previous chapters of
            %em
              %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics"} geometry of physics
            which we need for the discussion of BPS charge groups below.
          %h4#representations_and_associated_bundles
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} \infty
            \-Representations and associated
            = succeed "-bundles" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %blockquote
            %p
              recalled from
              %em
                %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+representations+and+associated+bundles"} geometry of physics – representations and associated bundles
          #FiberBundle.num_defn
            %h6#definition Definition
            %p
              Given
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo ,
                      %mi E
                      %mo ∈
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} V,E\in \mathbf{H}
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
                \-
                %a.existingWikiWord{:href => "/nlab/show/fiber+%E2%88%9E-bundle"} fiber ∞-bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a
              %a.existingWikiWord{:href => "/nlab/show/bundle"} bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ∈
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi X
                  %annotation{:encoding => "application/x-tex"} E \in \mathbf{H}_{/X}
              such that there exists a
              %a.existingWikiWord{:href => "/nlab/show/cover"} cover
              (i.e. a
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/1-epimorphism"} 1-epimorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ⟶
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U \longrightarrow X
              and a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi U
                            %mo ×
                            %mi V
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi E
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi U
                          %mtd
