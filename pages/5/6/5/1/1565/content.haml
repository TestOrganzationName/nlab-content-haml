                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/group"}> group
                        ,
                        %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/idempotent+monoid"} idempotent monoid
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/semilattice"} semilattice
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/absorption+monoid"} absorption monoid
                      %ul
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/zero+divisor"} zero divisor
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/integral+monoid"} integral monoid
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/01-bounded+semilattice"} 01-bounded semilattice
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/free+monoid"}> free monoid
                        ,
                        %a.existingWikiWord{:href => "/nlab/show/free+commutative+monoid"} free commutative monoid
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/graphic+monoid"} graphic monoid
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/monoid+action"} monoid action
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/module+over+a+monoid"} module over a monoid
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/localization+of+a+monoid"} localization of a monoid
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/group+completion"} group completion
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/endomorphism+monoid"} endomorphism monoid
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/monoid+object"}> monoid object
                        ,
                        %a.existingWikiWord{:href => "/nlab/show/monoid+object+in+an+%28infinity%2C1%29-category"} monoid object in an (infinity,1)-category
                      %ul
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/commutative+monoid+object"} commutative monoid object
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/idempotent+monoid+object"} idempotent monoid object
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/semilattice+object"} semilattice object
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/semiring"}> semiring
                            ,
                            = succeed "," do
                              %a.existingWikiWord{:href => "/nlab/show/rig"} rig
                            = succeed "," do
                              %a.existingWikiWord{:href => "/nlab/show/ring"} ring
                            %a.existingWikiWord{:href => "/nlab/show/associative+unital+algebra"} associative unital algebra
