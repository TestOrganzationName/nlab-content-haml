                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Juan+Maldacena"} Juan Maldacena
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Edgar+Shaghoulian"} Edgar Shaghoulian
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Amirhossein+Tajdini"} Amirhossein Tajdini
                = succeed "," do
