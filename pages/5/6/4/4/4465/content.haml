                    correspondence
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/0609074"} arXiv:hep-th/0609074
            %li#Sen07
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ashoke+Sen"}> Ashoke Sen
                ,
                = succeed "," do
                  %em Black Hole Entropy Function, Attractors and Precision Counting of Microstates
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/0708.1270"} arXiv:0708.1270
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dieter+L%C3%BCst"}> Dieter Lüst
                , Ward Vleeshouwers, sections 21-22 of
                %em Black Hole Information and Thermodynamics
                (
                %a{:href => "https://arxiv.org/abs/1809.01403"}> arXiv:1809.01403
                )
            %li
              %p
                Sebastian De Haro, Jeroen van Dongen, Manus Visser,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jeremy+Butterfield"} Jeremy Butterfield
                %em Conceptual Analysis of Black Hole Entropy in String Theory
                (
                %a{:href => "https://arxiv.org/abs/1904.03232"}> arXiv:1904.03232
                )
            %li
              %p
                Jeroen van Dongen, Sebastian De Haro, Manus Visser,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jeremy+Butterfield"} Jeremy Butterfield
                %em Emergence and Correspondence for String Theory Black Holes
                (
                %a{:href => "https://arxiv.org/abs/1904.03234"}> arXiv:1904.03234
                )
          %p
            Discussion in view of
            %a.existingWikiWord{:href => "/nlab/show/higher+curvature+corrections"} higher curvature corrections
            includes
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Thomas+Mohaupt"}> Thomas Mohaupt
              ,
              %em Strings, higher curvature corrections, and black holes
