                %use{:x => "37.02445", "xlink:href" => "#k_741b9mVYqrbk7wA7EFqgICNYY=-glyph3-1", :y => "38.496264"}
              %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                %use{:x => "42.436061", "xlink:href" => "#k_741b9mVYqrbk7wA7EFqgICNYY=-glyph1-2", :y => "37.252803"}
              %path{:d => "M -28.296845 -33.015083 L 27.081002 -33.015083 ", :style => "fill:none;stroke-width:0.47818;stroke-linecap:butt;stroke-linejoin:miter;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(0.997762,0,0,-0.997762,52.264764,42.140839)"}
              %path{:d => "M -2.486345 2.87062 C -2.032204 1.148015 -1.018215 0.333693 -0.000312241 0.000916563 C -1.018215 -0.335774 -2.032204 -1.146182 -2.486345 -2.868787 ", :style => "fill:none;stroke-width:0.47818;stroke-linecap:round;stroke-linejoin:round;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(0.997762,0,0,-0.997762,79.523749,75.082946)"}
              %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                %use{:x => "48.81151", "xlink:href" => "#k_741b9mVYqrbk7wA7EFqgICNYY=-glyph1-2", :y => "85.493593"}
          %p
            Of course, lifts typically don’t literally exist in the sense of an equation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo ∘
                  %mover
                    %mi f
                    %mo ˜
                  %mo =
                  %mi f
                %annotation{:encoding => "application/x-tex"} p \circ \widetilde{f} = f
            or an
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∘
                    %mover
                      %mi f
                      %mo ˜
                    %mo ≅
                    %mi f
                  %annotation{:encoding => "application/x-tex"} p \circ \widetilde{f} \cong f
            %a.existingWikiWord{:href => "/nlab/show/2-morphism"} 2-cell
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo ∘
                  %mover
                    %mi f
                    %mo ˜
                  %mo ⇒
                  %mi f
                %annotation{:encoding => "application/x-tex"} p \circ \widetilde{f} \Rightarrow f
            which is universal among 2-cells of this form. This gives the notion of
            %em right
            Kan lift. The notion of
            %em left
            Kan lift is similar, but with 2-cells in the opposite direction.
          %h3#terminology Terminology
          %p
            Usually, when working within a 2-categorical context, Kan lifts are simply refered to as
            = succeed "," do
              %em lifts/liftings
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Kan+extension"} Kan extensions
          %h2#definition Definition
          %p
            As in the discussion at
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Kan+extension"} Kan extension
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjoint functor
          %h3#local_description Local description
          %p
            Given 1-cells
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi B
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} p: B \to C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi A
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} f: A \to C
            in a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/bicategory"} bicategory
            %strong right Kan lift
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            through
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Rift
                      %mi p
                    %mi f
                  %annotation{:encoding => "application/x-tex"} Rift_p f
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi f
                    %mo ˜
                  %mo :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} \widetilde{f}: A \to B
            equipped with a 2-cell
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ε
                  %mo :
                  %mi p
                  %mo ∘
                  %mover
                    %mi f
                    %mo ˜
                  %mo ⇒
                  %mi f
                %annotation{:encoding => "application/x-tex"} \varepsilon: p \circ \widetilde{f} \Rightarrow f
          %p
            satisfying the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                    %mo ,
                    %mi η
                    %mo :
                    %mi p
                    %mo ∘
                    %mi g
                    %mo ⇒
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (g: A \to B, \eta: p \circ g \Rightarrow f)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ζ
                  %mo :
                  %mi g
                  %mo ⇒
                  %mover
                    %mi f
                    %mo ˜
                %annotation{:encoding => "application/x-tex"} \zeta: g \Rightarrow \widetilde{f}
          %p
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ε
                    %mo •
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ∘
                    %mi ζ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \varepsilon \bullet (p \circ \zeta) = \eta
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∘
                %annotation{:encoding => "application/x-tex"} \circ
            refers to composition across a 0-cell, and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo •
                %annotation{:encoding => "application/x-tex"} \bullet
            to composition across a 1-cell.) As with any universal description, the pair
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Rift
                    %mi p
                  %mi f
                  %mo ,
                  %mi ε
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (Rift_p f, \varepsilon)
            is unique up to unique 2-cell isomorphism.
          %p
            A
            %strong left Kan lift
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            through
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Lift
                      %mi p
                    %mi f
                  %annotation{:encoding => "application/x-tex"} Lift_p f
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi f
                    %mo ˜
                  %mo :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} \widetilde{f}: A \to B
            equipped with a 2-cell
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                  %mo :
                  %mi f
                  %mo ⇒
                  %mi p
                  %mo ∘
                  %mover
                    %mi f
                    %mo ˜
                %annotation{:encoding => "application/x-tex"} \eta: f \Rightarrow p \circ \widetilde{f}
          %p
            such that given any pair
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                    %mo ,
                    %mi θ
                    %mo :
                    %mi f
                    %mo ⇒
                    %mi p
                    %mo ∘
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (g: A \to B, \theta: f \Rightarrow p \circ g)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ζ
                  %mo :
                  %mover
                    %mi f
                    %mo ˜
                  %mo ⇒
                  %mi g
                %annotation{:encoding => "application/x-tex"} \zeta: \widetilde{f} \Rightarrow g
          %p
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ∘
                    %mi ζ
                    %mo{:stretchy => "false"} )
                    %mo •
                    %mi η
                    %mo =
                    %mi θ
                  %annotation{:encoding => "application/x-tex"} (p \circ \zeta) \bullet \eta = \theta
          %h3#global_description Global description
          %p
            Given
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo :
                  %mi B
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} p: B \to C
            and a 0-cell
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            in a bicategory, if the right Kan lift
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Rift
                    %mi p
                  %mi f
                %annotation{:encoding => "application/x-tex"} Rift_p f
            exists for any
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi A
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} f: A \to C
            %strong global
            Kan lift. When this is the case, we may define a functor between hom-categories
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Rift
                    %mi p
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo ,
                  %mi C
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo ,
                  %mi B
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} Rift_p: [A, C] \to [A, B]
          %p
            which at the object level is of course
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ↦
                    %msub
                      %mi Rift
                      %mi p
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f \mapsto Rift_p f
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                  %mo :
                  %mi f
                  %mo ⇒
                  %mi g
                  %mo :
                  %mi A
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} \eta: f \Rightarrow g: A \to C
          %p
            there is an induced 2-cell
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Rift
                      %mi p
                    %mi f
                    %mo ⇒
                    %msub
                      %mi Rift
                      %mi p
                    %mi g
                  %annotation{:encoding => "application/x-tex"} Rift_p f \Rightarrow Rift_p g
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Rift
                      %mi p
                    %mi g
                  %annotation{:encoding => "application/x-tex"} Rift_p g
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo ∘
                  %msub
                    %mi Rift
                    %mi p
                  %mi f
                  %mover
                    %mo ⇒
                    %mi ε
                  %mi f
                  %mover
                    %mo ⇒
                    %mi η
                  %mi g
                  %mo .
                %annotation{:encoding => "application/x-tex"} p \circ Rift_p f \overset{\varepsilon}{\Rightarrow} f \overset{\eta}{\Rightarrow} g.
          %p
            A standard universality argument shows that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Rift
                    %mi p
                %annotation{:encoding => "application/x-tex"} Rift_p
            thus defined is functorial.
          %p
            %strong Proposition:
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Rift
                    %mi p
                %annotation{:encoding => "application/x-tex"} Rift_p
            is right adjoint to the functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo ,
                  %mi p
                  %mo{:stretchy => "false"} ]
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo ,
                  %mi B
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo ,
                  %mi C
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [A, p]: [A, B] \to [A, C]
            obtained by postcomposing with
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ↦
                    %mi p
                    %mo ∘
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f \mapsto p \circ f
          %p This is the easier, more conceptual way to remember right Kan lifts: in a global sense, they are right adjoint to postcomposition. Similarly, global left Kan lifts are left adjoint to postcomposition.
          %ul
            %li
              In a
              %a{:href => "http://golem.ph.utexas.edu/category/2009/06/kan_lifts.html"} post
              at the nCafé,
              %a.existingWikiWord{:href => "/nlab/show/David+Corfield"} David Corfield
              put the question: why are Kan extensions more frequently mentioned than Kan lifts? One proposed
              %a{:href => "http://golem.ph.utexas.edu/category/2009/06/kan_lifts.html#c024705"} answer
              is that in many cases a left or right Kan lift will exist for a trivial reason: namely that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              itself has a left or right adjoint. Other examples will be given below.
          %h2#properties Properties
          %p
            Dual to the situation in Kan extensions, one is interested in whether a Kan lift is
            %em respected
            by a 1-cell with codomain the domain of the lift. This is defined as follows:
          %ul
            %li
              given
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mover
                        %mi f
                        %mo ˜
                      %mo ,
                      %mi ε
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} Rift
                        %mi p
                      %mi f
                    %annotation{:encoding => "application/x-tex"} (\widetilde{f}, \varepsilon) = \mathop{Rift}_p f
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              is said to
              %em respect
              this right lift if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi f
                      %mo ˜
                    %mi g
                    %mo ,
                    %mi ε
                    %mo •
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} Rift
                      %mi p
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\widetilde{f}g, \varepsilon \bullet g) = \mathop{Rift}_p(f g)
          %p
            and analogously for left Kan lifts. A Kan lift
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi f
                    %mo ^
                %annotation{:encoding => "application/x-tex"} \widehat{f}
            is
            %em absolute
            if it is respected by any 1-cell into
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} dom
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi f
                      %mo ^
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathop{dom}(\widehat{f})
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+structure"} Yoneda structure
          %h2#examples Examples
          %ul
            %li
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} Mod
              denote the
              %a.existingWikiWord{:href => "/nlab/show/framed+bicategory"} framed bicategory
              of small categories
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo :
                    %mi C
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} r: C \to D
              (i.e., functors
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                      %mo :
                      %msup
                        %mi D
                        %mi op
                      %mo ×
                      %mi C
                      %mo →
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} r: D^{op} \times C \to Set
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/weighted+limit"} weighted limit
              %a.existingWikiWord{:href => "/nlab/show/end"} end
              formulas, e.g.,
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Rift
                        %mi r
                      %mi s
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mo ,
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mo ∫
                        %mrow
                          %mi d
                          %mo :
                          %mi D
                      %mi hom
                      %mo{:stretchy => "false"} (
                      %mi r
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo ,
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi s
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (Rift_r s)(b, c) = \int_{d: D} hom(r(d, c), s(d, b))
          %p
            Examples of this construction abound in mathematics, especially when generalized to the
            %a.existingWikiWord{:href => "/nlab/show/enriched+category+theory"} enriched category theory
            context. For example, in the bicategory
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Rel
                  %annotation{:encoding => "application/x-tex"} Rel
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbf{2}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∀
                    %mrow
                      %mi d
                      %mo :
                      %mi D
                  %mi r
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo ⇒
                  %mi s
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \forall_{d: D} r(d, c) \Rightarrow s(d, b)
          %p
            (“for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                %annotation{:encoding => "application/x-tex"} d
            satisfying condition
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
            = succeed "\u201D)." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                  %annotation{:encoding => "application/x-tex"} s
          %ul
            %li
              %p
                More generally, a
                %a.existingWikiWord{:href => "/nlab/show/biclosed+bicategory"} biclosed bicategory
                is precisely a bicategory where global right Kan extensions and right Kan lifts exist for every 1-cell
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
            %li
              %p
                adjunctions in a 2-category can be defined in terms of Kan lifts: a 1-cell
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                      %mo{:lspace => "verythinmathspace"} :
                      %mi A
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} u\colon A \to B
                has a left adjoint iff
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} Lift
                        %mi u
                      %msub
                        %mn 1
                        %mi B
                    %annotation{:encoding => "application/x-tex"} \mathop{Lift}_u 1_B
                exists and is absolute; in this case putting
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo ,
                      %mi ι
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} Lift
                        %mi u
                      %msub
                        %mn 1
                        %mi B
                    %annotation{:encoding => "application/x-tex"} (f,\iota) = \mathop{Lift}_u 1_B
                we have
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ⊣
                      %mi u
                    %annotation{:encoding => "application/x-tex"} f \dashv u
                with unit
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ι
                        %mo{:lspace => "verythinmathspace"} :
                        %msub
                          %mn 1
                          %mi B
                        %mo ⇒
                        %mi u
                        %mi f
                      %annotation{:encoding => "application/x-tex"} \iota \colon 1_B \Rightarrow u f
            %li
              %p
                relative adjoints in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Cat
                    %annotation{:encoding => "application/x-tex"} \mathbf{Cat}
                can also be expressed as absolute kan lifts; see
                %a.existingWikiWord{:href => "/nlab/show/relative+adjoint"} relative adjoint
                for a precise statement.
            %li
              %p
                representably fully faithful 1-cells, meaning those for which
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi f
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} B(X,f)
                is fully faithful in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Cat
                    %annotation{:encoding => "application/x-tex"} \mathbf{Cat}
                for every object
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo{:lspace => "verythinmathspace"} :
                        %mi B
                      %annotation{:encoding => "application/x-tex"} X\colon B
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mn 1
                          %mi A
                        %mo ,
                        %msub
                          %mn 1
                          %mi f
                        %mo{:stretchy => "false"} )
                        %mo =
                        %msub
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} Lift
                          %mi f
                        %mi f
                      %annotation{:encoding => "application/x-tex"} (1_A, 1_f) = \mathop{Lift}_f f
            %li
              %p
                In
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Cat
                      %annotation{:encoding => "application/x-tex"} Cat
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                is small and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
                is locally small, and if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo :
                      %mi A
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} F: A \to B
                is a functor, then we have a Yoneda embedding
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo :
                      %mi A
                      %mo →
                      %mi P
                      %mi A
                      %mo =
                      %msup
                        %mi Set
                        %mrow
                          %msup
                            %mi A
                            %mi op
                    %annotation{:encoding => "application/x-tex"} y: A \to P A = Set^{A^{op}}
                and a functor
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                        %mo{:stretchy => "false"} (
                        %mi F
                        %mo −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo :
                        %mi B
                        %mo →
                        %mi P
                        %mi A
                      %annotation{:encoding => "application/x-tex"} B(F-, -): B \to P A
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi y
                        %mi A
                      %mo →
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi F
                      %mo −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo ∘
                      %mi f
                    %annotation{:encoding => "application/x-tex"} y_A \to B(F-, -) \circ f
              %p
                (essentially,
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi hom
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi hom
                      %mo{:stretchy => "false"} (
                      %mi F
                      %mi a
                      %mo ,
                      %mi F
                      %mi b
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} hom(a, b) \to hom(F a, F b)
                taking
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi a
                      %mo →
                      %mi b
                    %annotation{:encoding => "application/x-tex"} f: a \to b
                to
                = succeed ")." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mi f
                        %mo :
                        %mi F
                        %mi a
                        %mo →
                        %mi F
                        %mi b
                      %annotation{:encoding => "application/x-tex"} F f: F a \to F b
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
                as a left Kan lift of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                    %annotation{:encoding => "application/x-tex"} y
                through
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                        %mo{:stretchy => "false"} (
                        %mi F
                        %mo −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} B(F-, -)
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Yoneda+structure"} Yoneda structures
                %a{:href => "http://www.pps.jussieu.fr/~weber/Two-toposes4.pdf"} development
                in the context of 2-topos theory.
          %h2#references References
          %p Kan lifts were mentioned in passing in Definition I.12.6 of:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/John+Gray"}> John Gray
              ,
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Adjointness+for+2-Categories"}
                    Formal category theory: adjointness for
                    = succeed "-categories" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mn 2
                          %annotation{:encoding => "application/x-tex"} 2
              = succeed "," do
                %strong 391
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1007/BFb0061280"} doi:10.1007/BFb0061280
          %p
            where it is mentioned the concept does not have a name since they had never been considered before in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
          %p Kan lifts were called “liftings” in:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Ross+Street"}> Ross Street
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Bob+Walters"} Bob Walters
              = succeed "," do
                %em Yoneda structures on 2-categories
              %strong 50
              (1978) 350-379 &amp;lbrack;
              %a{:href => "https://doi.org/10.1016/0021-8693(78)90160-6"}> doi:10.1016/0021-8693(78)90160-6
              \&amp;rbrack;
          %p The terminology “Kan lifting” is used in:
          %ul
            %li
              Charles Grellois,
              %em Algebraic theories, monads, and arities
              (2011) &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/1110.3294"}> arXiv:1110.3294
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://inria.hal.science/hal-00670841"} hal:00670841
          %p The terminology “Kan lift” seems to first appear in:
          %ul
            %li
              Weng Kin Ho,
              = succeed "," do
                %em Characterising E-projectives via Co-monads
              %strong 301
              (2014) 61-77 &amp;lbrack;
              %a{:href => "https://doi.org/10.1016/j.entcs.2014.01.006"}> doi:10.1016/j.entcs.2014.01.006
              \&amp;rbrack;
        .revisedby
