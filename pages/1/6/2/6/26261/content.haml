          %h2#idea Idea
          %p
            %strong Fibred natural transformations
            are natural transformations between
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/fibred+functors"} fibred functors
            %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Fib
                  %annotation{:encoding => "application/x-tex"} \mathbf{Fib}
          %h2#definition Definition
          %p
            Given
            %a.existingWikiWord{:href => "/nlab/show/fibred+category"} fibrations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo ′
                %annotation{:encoding => "application/x-tex"} p'
            and
            %a.existingWikiWord{:href => "/nlab/show/fibred+functors"} fibred functors
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ,
                    %mi G
                    %mo :
                    %mi p
                    %mo →
                    %mi p
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} F,G:p \to p'
            %strong fibred natural transformation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi α
                    %mn 1
                  %mo ,
                  %msub
                    %mi α
                    %mn 0
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi F
                  %mo ⇒
                  %mi G
                %annotation{:encoding => "application/x-tex"} \alpha=(\alpha_1,\alpha_0):F \Rightarrow G
            is a pair of 2-cells as follows:
            %svg{:height => "125.275pt", :version => "1.2", :viewbox => "0 0 164.741 125.275", :width => "164.741pt", :xmlns => "http://www.w3.org/2000/svg", "xmlns:xlink" => "http://www.w3.org/1999/xlink"}
              %defs
                %g
                  %symbol{:id => "wnQyXOA-HbO71AjEOuOfynOxvgc=-glyph0-0", :overflow => "visible"}
