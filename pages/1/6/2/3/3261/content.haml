                = succeed "," do
                  %strong 3
            %li
              %p
                I. M. Gelfand,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Mikhail+Kapranov"} M. Kapranov
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Andrei+Zelevinsky"} A. Zelevinsky
                = succeed "," do
                  %em Discriminants, resultants, and multidimensional determinants
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/I.+M.+Gelfand"}> I. M. Gelfand
                , R. M. Goresky, R. D. MacPherson, V.
                = succeed "," do
                  %span.newWikiWord
                    V. Serganova
                    %a{:href => "/nlab/new/V.+Serganova"} ?
                = succeed "," do
                  %em Combinatorial geometries, convex polyhedra, and Schubert cells
                %a{:href => "https://doi.org/10.1016/0001-8708(87)90059-4"} doi
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Sergei+Gelfand"}> Sergei Gelfand
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Yuri+Manin"} Yuri Manin
                = succeed "," do
                  %em Methods of homological algebra
            %li
              %p
                Fred J. Rispoli,
                = succeed "," do
                  %em The graph of the hypersimplex
                %a{:href => "https://arxiv.org/abs/0811.2981"} arXiv:0811.2981
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Thomas+Lam"}> Thomas Lam
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Alexander+Postnikov"} Alexander Postnikov
                = succeed "," do
                  %em Alcoved polytopes I
                %a{:href => "https://arxiv.org/abs/math/0501246"} math.CO/0501246
            %li
              %p
