          %h2#idea Idea
          %p
            The
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (k,n)
            %strong hypersimplex
            is a convex
            %a.existingWikiWord{:href => "/nlab/show/polytope"} polytope
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo ,
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Delta(k, n)
            (or
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mrow
                        %mi k
                        %mo ,
                        %mi n
                  %annotation{:encoding => "application/x-tex"} \Delta_{k,n}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            which is the
            %a.existingWikiWord{:href => "/nlab/show/convex+hull"} convex hull
            of the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi n
                        %mtr
                          %mtd
                            %mi k
                    %mo )
                %annotation{:encoding => "application/x-tex"} \left(\array{n \\ k}\right)
            points
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi e
                      %mrow
                        %msub
                          %mi i
                          %mn 1
                    %mo +
                    %msub
                      %mi e
                      %mrow
                        %msub
                          %mi i
                          %mn 2
                    %mo +
                    %mi ⋯
                    %mo +
                    %msub
                      %mi e
                      %mrow
                        %msub
                          %mi i
                          %mi k
                  %annotation{:encoding => "application/x-tex"} e_{i_1}+ e_{i_2}+ \cdots + e_{i_k}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ≤
                    %msub
                      %mi i
                      %mn 1
                    %mo &lt;
                    %msub
                      %mi i
                      %mn 2
                    %mo &lt;
                    %mi …
                    %mo &lt;
                    %msub
                      %mi i
                      %mi k
                    %mo ≤
                    %mi n
                  %annotation{:encoding => "application/x-tex"} 1\leq i_1\lt i_2\lt \ldots \lt i_k\leq n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi e
                    %mi j
                %annotation{:encoding => "application/x-tex"} e_{j}
            are the standard basis vectors.
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo ,
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Delta(k,n)
            may be seen as a convex hull of the
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/barycenter"} barycenter
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (k-1)
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} a (n-1)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/simplex"} simplex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Delta(1,n)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo −
                  %mn 1
                  %mo ,
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Delta(n-1,n)
            are themselves simplices of dimension
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n-1)
          %p
            The combinatorics of hypersimplices extends the combinatorics of distinguished triangles and octahedra in the standard
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/triangulated+categories"} triangulated categories
            = succeed "\u2018s" do
              %a.existingWikiWord{:href => "/nlab/show/Georges+Maltsiniotis"} Maltsiniotis
            %a.existingWikiWord{:href => "/nlab/show/octahedron"} octahedron
            is a
            = succeed "-hypersimplex." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo ,
                    %mn 4
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (2,4)
            = succeed "-enrichments" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} A_\infty
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Volodymyr+Lyubashenko"} Volodymyr Lyubashenko
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/stable+%28%E2%88%9E%2C1%29-category"} stable (∞,1)-category
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Postnikov+system+in+a+triangulated+category"} Postnikov towers in triangulated categories
          %h2#references References
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Israel+Gelfand"}> I.M.Gelfand
                , R.D.MacPherson,
