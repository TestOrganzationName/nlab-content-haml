                %a.existingWikiWord{:href => "/nlab/show/quotient+group"} quotient group
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi π
                        %mn 3
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi^3(X)
                (which is a group via the
                = succeed "-" do
                  %a.existingWikiWord{:href => "/nlab/show/group"} group
                %a.existingWikiWord{:href => "/nlab/show/structure"} structure
                of the
