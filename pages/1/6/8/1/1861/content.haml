          %p
            %br/
          %h2#properties Properties
          %h3#hopf_degree_theorem Hopf degree theorem
          .num_prop
            %h6#proposition Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Hopf+degree+theorem"}> Hopf degree theorem
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
