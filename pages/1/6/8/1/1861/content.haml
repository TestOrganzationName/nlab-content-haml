                    %mspace{:width => "thinmathspace"}
                    %mi mod
                    %mspace{:width => "thinmathspace"}
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} c'(x) = c(x) + n \,mod\, \mathbb{Z}
              and hence
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
