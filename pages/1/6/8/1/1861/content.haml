                    %mi SU
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B SU(N)
            of the
            %a.existingWikiWord{:href => "/nlab/show/special+unitary+group"} special unitary group
            (for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo ≥
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} N \geq 2
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/SU%282%29"} SU(2)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
