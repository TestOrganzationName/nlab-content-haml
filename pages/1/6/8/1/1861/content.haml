                          %mi S
                          %mn 3
                        %mo ,
                        %msup
                          %mi S
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mtr
                      %mtd
                      %mtd
                        %mo ≃
                      %mtd
                        %msub
                          %mi π
                          %mn 3
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi S
                          %mn 2
                        %mo{:stretchy => "false"} )
                    %mtr
                      %mtd
                      %mtd
                        %mo ≃
                      %mtd
                        %mi ℤ
                        %mpadded{:width => "0"}
                          %mrow
                            %mspace{:width => "thinmathspace"}
                            %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\begin{array}{rcl}
                  \\pi_1 \, Map^\ast_k(S^2, S^2)
                  \&amp;\simeq&amp;
                  \\pi_1 \, Map^\ast_0(S^2, S^2)
                  \\\
                  \&amp;\simeq&amp;
                  \\pi_0 \, Map\big(S^1, Map^\ast_0(S^2, S^2) \big)
                  \\\
                  \&amp;\simeq&amp;
                  \\pi_0 \, Map^\ast_0(S^1 \wedge S^2, S^2) \big)
                  \\\
                  \&amp;\simeq&amp;
                  \\pi_0 \, Map^\ast_0(S^3, S^2) \big)
                  \\\
                  \&amp;\simeq&amp;
                  \\pi_3(S^2)
                  \\\
                  \&amp;\simeq&amp;
                  \\mathbb{Z}
                  \\mathrlap{\,.}
                  \\end{array}
          %p
            In contrast, the fundamental group of the free mapping space deviates from this in the connected components of non-trivial
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Hopf+degree"} Hopf degree
          %p
          #FundamentalGroupsOfEndomappingSpaceOf2Sphere.num_prop
            %h6 Proposition
            %p
              (
              %a{:href => "#STHu46"}> Hu 1946, Thm 5.3(1)
              ,
              = succeed ")" do
                %a{:href => "#Koh60"} Koh 1960 Lem 3.9
              %br/
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi Map
                      %mi k
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi S
                      %mn 2
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi S
                      %mn 2
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi ℤ
                      %mrow
                        %mn 2
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi k
                          %mo{:stretchy => "false"} |
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_1 \, Map_k\big(
                    S^2 ,\, S^2
                    \\big)
                    \\;\simeq\;
                    \\mathbb{Z}_{2{\vert k \vert}}
                    \\,.
            %p
          (Here
          %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
            %semantics
              %mrow
                %msub
                  %mi ℤ
                  %mi n
                %mo ≔
                %mi ℤ
                %mo{:stretchy => "false"} /
                %mi n
              %annotation{:encoding => "application/x-tex"} \mathbb{Z}_n \coloneqq \mathbb{Z}/n
          denotes the
          %a.existingWikiWord{:href => "/nlab/show/cyclic+group"} cyclic group
          of
          %a.existingWikiWord{:href => "/nlab/show/order+of+a+group"} order
          %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
            %semantics
              %mrow
                %mi n
              %annotation{:encoding => "application/x-tex"} n
          if
          %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
            %semantics
              %mrow
                %mi n
                %mo ≠
                %mn 0
              %annotation{:encoding => "application/x-tex"} n \neq 0
          and denotes the
          %a.existingWikiWord{:href => "/nlab/show/integers"} integers
          when
          = succeed "," do
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} n = 0
          = succeed ".)" do
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℤ
                    %mn 0
                  %mo ≃
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}_0 \simeq \mathbb{Z}
          %p
          .num_remark
            %h6 Remark
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence+of+homotopy+groups"} long exact sequence of homotopy groups
              induced by the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequence"} homotopy fiber sequence
              of the basepoint
              %a.existingWikiWord{:href => "/nlab/show/evaluation"} evaluation
              map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Map
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 2
                    %mo ,
                    %msup
                      %mi S
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi Map
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 2
                    %mo ,
                    %msup
                      %mi S
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mi ev
                    %msup
                      %mi S
                      %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    Map^\ast(S^2, S^2)
                    \\longrightarrow
                    Map(S^2, S^2)
                    \\xrightarrow{ev}
                    S^2
            %p
              only gives a
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence"} long exact sequence
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo ⟶
                    %munder
                      %munder
                        %mrow
                          %msub
                            %mi π
                            %mn 2
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi S
                            %mn 2
                          %mo{:stretchy => "false"} )
                        %mo ⏟
                      %mi ℤ
                    %mo ⟶
                    %msub
                      %mi π
                      %mn 1
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi Map
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 2
                    %mo ,
                    %msup
                      %mi S
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mi π
                      %mn 1
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Map
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 2
                    %mo ,
                    %msup
                      %mi S
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %munder
                      %munder
                        %mrow
                          %msub
                            %mi π
                            %mn 2
                          %msup
                            %mi S
                            %mn 2
                        %mo ⏟
                      %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots
                    \\longrightarrow
                    \\underset{
                    \\mathbb{Z}
                    }{
                    \\underbrace{
                    \\pi_2(S^2)
                    }
                    }
                    \\longrightarrow
                    \\pi_1 \, Map^\ast(S^2, S^2)
                    \\longrightarrow
                    \\pi_1 \  Map_0(S^2, S^2)
                    \\longrightarrow
                    \\underset{ 1 }{
                    \\underbrace{
                    \\pi_2 S^2
                    }
                    }
            %p
              from which alone the statement of Prop.
              %a.maruku-ref{:href => "#FundamentalGroupsOfEndomappingSpaceOf2Sphere"}
              does not follow, even for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} k = 0
          %h3#CohomotopyModuliOfSurfaces 2-Cohomotopy moduli of surfaces
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Σ
                    %mi g
                %annotation{:encoding => "application/x-tex"} \Sigma_g
            be a
            %a.existingWikiWord{:href => "/nlab/show/closed+manifold"} closed
            %a.existingWikiWord{:href => "/nlab/show/orientation"} orientable
            %a.existingWikiWord{:href => "/nlab/show/surface"} surface
            of
            %a.existingWikiWord{:href => "/nlab/show/genus+of+a+surface"} genus
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo ∈
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} g \in \mathbb{N}
            (so that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Σ
                    %mn 0
                  %mo =
                  %msup
                    %mi S
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \Sigma_0 = S^2
            is
            %a.existingWikiWord{:href => "/nlab/show/generalized+the"} the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/2-sphere"} 2-sphere
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Σ
                    %mn 1
                  %mo =
                  %msup
                    %mi T
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \Sigma_1 = T^2
            is
            %a.existingWikiWord{:href => "/nlab/show/generalized+the"} the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/2-torus"} 2-torus
          %p
            and consider the
            %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} fundamental group
          #eq:FundamentalGroupOf2CohomotopyModuliOfSurface.maruku-equation
            %span.maruku-eq-number (4)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 1
                  %mi Maps
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msub
                    %mi Σ
                    %mi g
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %msup
                    %mi S
                    %mn 2
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ∈
                  %mspace{:width => "thickmathspace"}
                  %mi Grp
                %annotation{:encoding => "application/x-tex"}
                  \\pi_1 Maps\big(
                  \\Sigma_g
                  ,\,
                  S^2
                  \\big)
                  \\;\;
                  \\in
                  \\;
                  Grp
          %p
            of its 2-cohomotopy
            %a.existingWikiWord{:href => "/nlab/show/cocycle+space"} cocycle space
            (hence of the
            %a.existingWikiWord{:href => "/nlab/show/mapping+space"} space of maps
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Σ
                      %mi g
                    %mo →
                    %msup
                      %mi S
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \Sigma_g \to S^2
          %p This group
          %ol
            %li
              %p
                is generally
                %a.existingWikiWord{:href => "/nlab/show/non-abelian+group"} non-abelian
                for
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mo ≥
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} g \geq 1
              %p
                concretely, for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} g = 1
                its
                %a.existingWikiWord{:href => "/nlab/show/group+commutators"} group commutators
                are given by the
                %a.existingWikiWord{:href => "/nlab/show/Whitehead+product"} Whitehead product
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [-,-]
              %p
                (
                %a{:href => "#Federer56"}> Federer 1956, top of p 358
                , see also
                = succeed ")" do
                  %a{:href => "compact-open+topology#Barratt55"} Barratt 1955, top of p 95
            %li
              %p
                its
                %a.existingWikiWord{:href => "/nlab/show/connected+component"} connected component
                of
                %a.existingWikiWord{:href => "/nlab/show/degree+of+a+continuous+function"} degree
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} =0
                forms a
                %a.existingWikiWord{:href => "/nlab/show/central+extension"} central extension
                of the form
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mo →
                      %mi ℤ
                      %mo ⟶
                      %msub
                        %mi π
                        %mn 1
                      %mi Maps
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %msub
                        %mi Σ
                        %mn 2
                      %mo ,
                      %msup
                        %mi S
                        %mn 2
                      %msub
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi deg
                          %mo =
                          %mn 0
                      %mo ⟶
                      %msup
                        %mi ℤ
                        %mrow
                          %mn 2
                          %mi g
                      %mo →
                      %mn 1
                    %annotation{:encoding => "application/x-tex"}
                      1
                      \\to
                      \\mathbb{Z}
                      \\longrightarrow
                      \\pi_1 Maps\big(\Sigma_2, S^2\big)_{\vert deg = 0}
                      \\longrightarrow
                      \\mathbb{Z}^{2 g}
                      \\to
                      1
              %p
                (
                %a{:href => "#Dyer67"}> Dyer 1967 p 1288
                )
            %li
              %p
                generally its
                %a.existingWikiWord{:href => "/nlab/show/connected+component"} connected component
                of
                %a.existingWikiWord{:href => "/nlab/show/degree+of+a+continuous+function"} degree
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo =
                      %mi k
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} = k \in \mathbb{N}
                forms a
                %a.existingWikiWord{:href => "/nlab/show/central+extension"} central extension
                of the form
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mo →
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mrow
                        %mo |
                        %mi k
                        %mo |
                      %mo{:stretchy => "false"} )
                      %mo ⟶
                      %msub
                        %mi π
                        %mn 1
                      %mi Maps
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %msub
                        %mi Σ
                        %mi g
                      %mo ,
                      %msup
                        %mi S
                        %mn 2
                      %msub
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi deg
                          %mo =
                          %mi k
                      %mo ⟶
                      %msup
                        %mi ℤ
                        %mrow
                          %mn 2
                          %mi g
                      %mo →
                      %mn 1
                    %annotation{:encoding => "application/x-tex"}
                      1
                      \\to
                      \\mathbb{Z}/(2\left\vert k\right\vert)
                      \\longrightarrow
                      \\pi_1 Maps\big(\Sigma_g, S^2\big)_{\vert deg = k}
                      \\longrightarrow
                      \\mathbb{Z}^{2g}
                      \\to
                      1
              %p
                (
                %a{:href => "#Hansen74"}> Hansen 1974 Thm 1 &amp; p 150
                )
          %h4#FundamentalGroupOf2CohomotopyOfTorusTraditional The torus — traditional
          %p
            We conclude from this for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} g = 1
            (the
            %a.existingWikiWord{:href => "/nlab/show/2-torus"} 2-torus
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Σ
                      %mi g
                    %mo =
                    %msup
                      %mi T
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \Sigma_g = T^2
          %p
          #FundamentalGroupOf2CohomotopyModuliOfTorusIsHeisExt.num_prop
            %h6 Proposition
            %p
              The group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mi Maps
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi T
                      %mn 2
                    %mo ,
                    %msup
                      %mi S
                      %mn 2
                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi deg
                        %mo =
                        %mi k
                  %annotation{:encoding => "application/x-tex"} \pi_1 Maps\big(T^2, S^2\big)_{\vert deg = k}
              %a.maruku-eqref{:href => "#eq:FundamentalGroupOf2CohomotopyModuliOfSurface"} (4)
              is a non-vanishing multiple of the
              = succeed "-extension" do
                %a.existingWikiWord{:href => "/nlab/show/integer+Heisenberg+group"} integer Heisenberg group
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:IntegerHeisenbergExtension"} (6)
          %p
          .proof
            %h6 Proof
            %p
              Let’s denote
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cyclic+groups"} cyclic groups
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℤ
                      %mi n
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mtable{:columnalign => "left center left", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mi ℤ
                          %mtd
                            %mo{:stretchy => "false"} |
                          %mtd
                            %mi n
                            %mo =
                            %mn 0
                        %mtr
                          %mtd
                            %mi ℤ
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo{:stretchy => "false"} |
                          %mtd
                            %mtext otherwise
                            %mpadded{:width => "0"}
                              %mrow
                                %mspace{:width => "thinmathspace"}
                                %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{Z}_{n}
                    \\;\coloneqq\;
                    \\left\{
                    \\begin{array}{lcl}
                    \\mathbb{Z} &amp;\vert&amp; n = 0
                    \\\
                    \\mathbb{Z}/(n) &amp;\vert&amp; \text{otherwise}
                    \\mathrlap{\,.}
                    \\end{array}
                    \\right.
            %p
              Observe that the second
              %a.existingWikiWord{:href => "/nlab/show/group+cohomology"} group cohomology
              of the
              %a.existingWikiWord{:href => "/nlab/show/free+abelian+group"} free abelian group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℤ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}^2
              is
            #eq:SecondGroupCohomologyOfZPlusZ.maruku-equation
              %span.maruku-eq-number (5)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "center center left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %msubsup
                            %mi H
                            %mi Grp
                            %mn 2
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi ℤ
                            %mn 2
                          %mo ;
                          %mspace{:width => "thinmathspace"}
                          %msub
                            %mi ℤ
                            %mi n
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ≃
                        %mtd
                          %msup
                            %mi H
                            %mn 2
                          %mo{:stretchy => "false"} (
                          %mi B
                          %msup
                            %mi ℤ
                            %mn 2
                          %mo ;
                          %mspace{:width => "thinmathspace"}
                          %msub
                            %mi ℤ
                            %mi n
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo ≃
                        %mtd
                          %msup
                            %mi H
                            %mn 2
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi T
                            %mn 2
                          %mo ;
                          %mspace{:width => "thinmathspace"}
                          %msub
                            %mi ℤ
                            %mi n
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo ≃
                        %mtd
                          %msup
                            %mi H
                            %mn 2
                          %mo{:stretchy => "false"} (
                          %msubsup
                            %mi S
                            %mi a
                            %mn 1
                          %mo ∨
                          %msubsup
                            %mi S
                            %mi b
                            %mn 1
                          %mo ∨
                          %msup
                            %mi S
                            %mn 2
                          %mo ;
                          %mspace{:width => "thinmathspace"}
                          %msub
                            %mi ℤ
                            %mi n
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo ≃
                        %mtd
                          %msup
                            %mi H
                            %mn 2
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi S
                            %mn 2
                          %mo ;
                          %mspace{:width => "thinmathspace"}
                          %msub
                            %mi ℤ
                            %mi n
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo ≃
                        %mtd
                          %msub
                            %mi ℤ
                            %mi n
                          %mpadded{:width => "0"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                              %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{ccl}
                    H^2_{Grp}(\mathbb{Z}^2;\, \mathbb{Z}_n)
                    \&amp;\simeq&amp;
                    H^2(B \mathbb{Z}^2;\, \mathbb{Z}_n)
                    \\\
                    \&amp;\simeq&amp;
                    H^2(T^2;\, \mathbb{Z}_n)
                    \\\
                    \&amp;\simeq&amp;
                    H^2(S^1_a \vee S^1_b \vee S^2;\, \mathbb{Z}_n)
                    \\\
                    \&amp;\simeq&amp;
                    H^2(S^2;\, \mathbb{Z}_n)
                    \\\
                    \&amp;\simeq&amp;
                    \\mathbb{Z}_n
                    \\mathrlap{\,,}
                    \\end{array}
            %p where we used, in order of the appearance:
            %ol
              %li
                %p
                  that
                  %a.existingWikiWord{:href => "/nlab/show/group+cohomology"} group cohomology
                  is
                  %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
                  of the domain group’s
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
              %li
                %p
                  that the
                  %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/integers"} integers
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/circle"} circle
                  and that this respects
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/Cartesian+products"} Cartesian products
              %li
                %p
                  that the
                  %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+type"} stable homotopy type
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/2-torus"} 2-torus
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/wedge+sum"} wedge sum
                  of two
                  %a.existingWikiWord{:href => "/nlab/show/circles"} circles
                  with a
                  %a.existingWikiWord{:href => "/nlab/show/2-sphere"} 2-sphere
                  (see
                  = succeed ")." do
                    %a{:href => "torus#AsAHomotopyType"} there
            %p
              The generator of this
              %a.existingWikiWord{:href => "/nlab/show/cohomology+group"} cohomology group
              must be the
              %a.existingWikiWord{:href => "/nlab/show/group+cohomology"} group 2-cocycle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %msubsup
                      %mi H
                      %mi Grp
                      %mn 2
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi ℤ
                      %mn 2
                    %mo ;
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi ℤ
                      %mi n
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\alpha \,\in\, H^2_{Grp}\big(
                    \\mathbb{Z}^2
                    ;\,
                    \\mathbb{Z}_n
                    \\big)
            %p given by
            #eq:IntegerHeisenbergExtension.maruku-equation
              %span.maruku-eq-number (6)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %msup
                            %mi ℤ
                            %mn 2
                          %mo ×
                          %msup
                            %mi ℤ
                            %mn 2
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mspace{:width => "thickmathspace"}
                              %mi α
                              %mspace{:width => "thickmathspace"}
                        %mtd
                          %msub
                            %mi ℤ
                            %mi n
                      %mtr
                        %mtd
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo ,
                          %mi b
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo ′
                          %mo ,
                          %mi b
                          %mo ′
                          %mo{:stretchy => "false"} )
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mtd
                          %mo ↦
                        %mtd
                          %mo{:stretchy => "false"} [
                          %mi a
                          %mi b
                          %mo ′
                          %mo{:stretchy => "false"} ]
                          %mpadded{:width => "0"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                              %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{ccc}
                    \\mathbb{Z}^2
                    \\times
                    \\mathbb{Z}^2
                    \&amp;\xrightarrow{\; \alpha \;}&amp;
                    \\mathbb{Z}_{n}
                    \\\
                    \\big(
                    (a,b), (a',b')
                    \\big)
                    \&amp;\mapsto&amp;
                    [a b']
                    \\mathrlap{\,,}
                    \\end{array}
            %p
              (whose cocycle condition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi a
                    %mi b
                    %mo ′
                    %mo{:stretchy => "false"} ]
                    %mo +
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo +
                    %mi a
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mi b
                    %mo ″
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mi a
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo ′
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mi b
                    %mo ″
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                    %mo +
                    %mo{:stretchy => "false"} [
                    %mi a
                    %mo ′
                    %mi b
                    %mo ″
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    [a b'] + [(a+a')b'']
                    \=
                    [a(b'+b'')] + [a' b'']
              is evidently satisfied due to the
              %a.existingWikiWord{:href => "/nlab/show/distributive+law"} distributive law
              in the
              %a.existingWikiWord{:href => "/nlab/show/ring"} ring
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            %p
              The
              %a{:href => "group+extension#CentralExtensionClassificationByGroupCohomology"} corresponding
              %a.existingWikiWord{:href => "/nlab/show/central+extension"} central extension
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo →
                    %msub
                      %mi ℤ
                      %mi n
                    %mo ⟶
                    %mi H
                    %mo ⟶
                    %msup
                      %mi ℤ
                      %mn 2
                    %mo →
                    %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    1
                    \\to
                    \\mathbb{Z}_n
                    \\longrightarrow
                    H
                    \\longrightarrow
                    \\mathbb{Z}^2
                    \\to
                    1
            %p
              is (the
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/modulo"}
                  mod
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/quotient+group"} quotient
              of) the
              %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
              of the
              %a.existingWikiWord{:href => "/nlab/show/simply-connected+topological+space"} simply-connected
              version of the
              %a.existingWikiWord{:href => "/nlab/show/Heisenberg+group"} Heisenberg group
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^2
              obtained by restriction along the canonical inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℤ
                      %mn 2
                    %mo ↪
                    %msup
                      %mi ℝ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}^2 \hookrightarrow \mathbb{R}^2
              (an “integer Heisenberg group”, cf.
              = succeed ")." do
                %a{:href => "Heisenberg+group#LeePacker96"} Lee &amp; Packer 1996 (1.2)
            %p
              By
              %a.maruku-eqref{:href => "#eq:SecondGroupCohomologyOfZPlusZ"} (5)
              all
              %a.existingWikiWord{:href => "/nlab/show/central+extensions"} central extensions
              of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℤ
                      %mi n
                    %mo ⟶
                    %msub
                      %mi π
                      %mn 1
                    %mi Maps
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi T
                      %mn 2
                    %mo ,
                    %msup
                      %mi S
                      %mn 2
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi deg
                        %mo =
                        %mi k
                    %mo ⟶
                    %msup
                      %mi ℤ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}_n \longrightarrow \pi_1 Maps(T^2, S^2)_{\vert deg = k} \longrightarrow \mathbb{Z}^2
              must be multiplies of this
              %a.existingWikiWord{:href => "/nlab/show/integer+Heisenberg+group"} integer Heisenberg group
              extension, and must be non-vanishing such multiples since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mi Maps
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi T
                      %mn 2
                    %mo ,
                    %msup
                      %mi S
                      %mn 2
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi deg
                        %mo =
                        %mi k
                  %annotation{:encoding => "application/x-tex"} \pi_1 Maps(T^2, S^2)_{\vert deg = k}
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/non-abelian+group"} non-abelian
          %p
          .num_remark
            %h6 Example
            %p
              In this
              %a.existingWikiWord{:href => "/nlab/show/integer+Heisenberg+group"} integer Heisenberg group
            %ul
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/inverse+elements"} inverse elements
                  are given by
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mi a
                        %mo ,
                        %mspace{:width => "thinmathspace"}
                        %mi b
                        %mo ,
                        %mspace{:width => "thinmathspace"}
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} ]
                        %msup
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi a
                        %mo ,
                        %mspace{:width => "thinmathspace"}
                        %mo −
                        %mi b
                        %mo ,
                        %mspace{:width => "thinmathspace"}
                        %mo{:stretchy => "false"} [
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi n
                        %mo +
                        %mi a
                        %mi b
                        %mo{:stretchy => "false"} ]
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\big(a ,\, b ,\, [n]\big)^{-1}
                        \\;=\;
                        \\big(
                        \-a ,\, -b ,\, [-n + a b]
                        \\big)
              %li
                %p
                  the basic
                  %a.existingWikiWord{:href => "/nlab/show/group+commutators"} group commutators
