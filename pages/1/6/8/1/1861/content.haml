                    %mi S
                    %mn 1
                  %mo ,
                  %msup
                    %mi S
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≡
                  %mspace{:width => "thickmathspace"}
                  %mi Ω
                  %mi Ω
                  %msup
                    %mi S
                    %mn 2
                  %mpadded{:width => "0"}
                    %mrow
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                %annotation{:encoding => "application/x-tex"}
                  Map^\ast(S^2, S^2)
                  \\;\simeq\;
                  Map^\ast(S^1 \wedge S^1, S^2)
                  \\;\simeq\;
                  Map^\ast\big(
                  S^1
                  ,\,
                  Map^\ast(S^1, S^2)
                  \\big)
                  \\;\equiv\;
                  \\Omega \Omega S^2
                  \\mathrlap{\,,}
          %p
            and hence an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/infinity-group"} infinity-group
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
            and hence in particular the same
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} fundamental group
            %a.existingWikiWord{:href => "/nlab/show/free+group"} generated
            by the
            %a.existingWikiWord{:href => "/nlab/show/Hopf+fibration"} Hopf fibration
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi S
