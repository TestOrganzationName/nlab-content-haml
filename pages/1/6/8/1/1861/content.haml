              %a.existingWikiWord{:href => "/nlab/show/2-sphere"} 2-sphere
              is the
              %a.existingWikiWord{:href => "/nlab/show/integer+Heisenberg+group"} integer Heisenberg group
              at level=2:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mi Map
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi T
                      %mn 2
                    %mo ,
                    %msup
                      %mi S
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mrow
                        %msup
                          %mi ℤ
                          %mn 2
                      %mo ^
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_1 Map(T^2, S^2)
                    \\;\simeq\;
                    \\widehat{\mathbb{Z}^2}
                    \\,,
            %p
          Here the
          %a.existingWikiWord{:href => "/nlab/show/underlying+set"} underlying set
          is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mrow
                      %msup
                        %mi ℤ
                        %mn 2
                    %mo ^
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mo ≔
                    %mi Set
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi ℤ
                    %mn 2
                  %mo ×
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"}
                  \\widehat{\mathbb{Z}^2}
                  \\;\coloneqq_{Set}\;
                  \\mathbb{Z}^2 \times \mathbb{Z}
          %p with generators
          #eq:GeneratorsOfIntegerHeisenbergGroup.maruku-equation
            %span.maruku-eq-number (7)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %msub
                            %mi W
                            %mi a
                        %mtd
                          %mo ≔
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo ,
                          %mn 0
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mn 0
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mo ∈
                          %msup
                            %mi ℤ
                            %mn 2
                          %mo ×
                          %mi ℤ
                      %mtr
                        %mtd
                          %msub
                            %mi W
                            %mi b
                        %mtd
                          %mo ≔
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mn 0
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mo ∈
                          %msup
                            %mi ℤ
                            %mn 2
                          %mo ×
                          %mi ℤ
                      %mtr
                        %mtd
                          %mi ζ
                        %mtd
                          %mo ≔
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo ,
                          %mn 0
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mn 1
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mo ∈
                          %msup
                            %mi ℤ
                            %mn 2
                          %mo ×
                          %mi ℤ
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  W_a
                  \&amp;\coloneqq
                  \\big((1,0),0\big) \in \mathbb{Z}^2 \times \mathbb{Z}
                  \\\
                  W_b
                  \&amp;\coloneqq
                  \\big((0,1),0\big) \in \mathbb{Z}^2 \times \mathbb{Z}
                  \\\
                  \\zeta
                  \&amp;\coloneqq
                  \\big((0,0),1\big) \in \mathbb{Z}^2 \times \mathbb{Z}
                  \\end{aligned}
          %p
            whose single nontrivial
            %a.existingWikiWord{:href => "/nlab/show/group+commutator"} group commutator
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi W
                    %mi a
                  %mo ,
                  %msub
                    %mi W
                    %mi b
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo =
                  %mspace{:width => "thinmathspace"}
                  %msup
                    %mi ζ
                    %mn 2
                  %mpadded{:width => "0"}
                    %mrow
                      %mspace{:width => "thinmathspace"}
                      %mo .
                %annotation{:encoding => "application/x-tex"}
                  [W_a, W_b] \,=\, \zeta^2
                  \\mathrlap{\,.}
          %p
            We prove this proposition after establishing a couple of simple lemmas and recalling a basic fact about the
            %a.existingWikiWord{:href => "/nlab/show/Whitehead+bracket"} Whitehead bracket
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} S^2
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi T
                        %mo +
                        %mn 2
                      %mo ≔
                      %msup
                        %mi T
                        %mn 2
                      %mo ⊔
                      %mo *
                    %annotation{:encoding => "application/x-tex"} T^2_+ \coloneqq T^2 \sqcup \ast
                for the result of freely adjoining a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/base+point"} base point
              %p
                so that
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Map
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi T
                          %mn 2
                        %mo ,
                        %msup
                          %mi S
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %msup
                          %mi Map
                          %mo *
                        %mo{:stretchy => "false"} (
                        %msubsup
                          %mi T
                          %mo +
                          %mn 2
                        %mo ,
                        %msup
                          %mi S
                          %mn 2
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Map(T^2, S^2) \simeq Map^\ast(T^2_+, S^2)
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                      %mo ⊣
                      %mi Ω
                    %annotation{:encoding => "application/x-tex"} \Sigma \dashv \Omega
                for the
                %a.existingWikiWord{:href => "/nlab/show/reduced+suspension"} reduced suspension
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⊣
                    %annotation{:encoding => "application/x-tex"} \dashv
                = succeed "-" do
                  %a.existingWikiWord{:href => "/nlab/show/loop+space"} loop space
                %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjunction
                on
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/pointed+topological+spaces"} pointed topological spaces
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi f
                        %mo ˜
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo ⟶
                      %mi Ω
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} \widetilde{f} \colon X \longrightarrow \Omega Y
                for the
                %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
                of a pointed map
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                      %mi X
                      %mo ⟶
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} \Sigma X \longrightarrow Y
                under this
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
          %p
          .num_lemma
            %h6 Lemma
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/suspension"} suspension
              of the torus is
              %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalent
              to the
              %a.existingWikiWord{:href => "/nlab/show/wedge+sum"} wedge sum
            #eq:StableSplittingOfTorus.maruku-equation
              %span.maruku-eq-number (8)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %msubsup
                      %mi T
                      %mo +
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo ≃
                      %mi hmtp
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi S
                      %mn 1
                    %mo ∨
                    %msubsup
                      %mi S
                      %mi a
                      %mn 2
                    %mo ∨
                    %msubsup
                      %mi S
                      %mi b
                      %mn 2
                    %mo ∨
                    %msup
                      %mi S
                      %mn 3
                    %mpadded{:width => "0"}
                      %mrow
                        %mspace{:width => "thinmathspace"}
                        %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Sigma T^2_+
                    \\;\underset{hmtp}{\simeq}\;
                    S^1
                    \\vee
                    S^2_a
                    \\vee
                    S^2_b
                    \\vee
                    S^3
                    \\mathrlap{\,.}
            %p
          Here the subscripts are just to
          %a.existingWikiWord{:href => "/nlab/show/indexed+set"} index
          %a.existingWikiWord{:href => "/nlab/show/wedge+sum"} wedge summands
          with corresponding projection maps
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mtable{:columnalign => "center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                    %mtr
                      %mtd
                        %mi Σ
                        %msubsup
                          %mi T
                          %mo +
                          %mn 2
                      %mtd
                        %mover
                          %mo →
                          %mrow
                            %msub
                              %mi pr
                              %mi a
                      %mtd
                        %msubsup
                          %mi S
                          %mi a
                          %mn 2
                        %mo ,
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                        %mi Σ
                        %msubsup
                          %mi T
                          %mo +
                          %mn 2
                      %mtd
                        %mover
                          %mo →
                          %mrow
                            %msub
                              %mi pr
                              %mi b
                      %mtd
                        %msubsup
                          %mi S
                          %mi b
                          %mn 2
                        %mo ,
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                        %mi Σ
                        %msubsup
                          %mi T
                          %mo +
                          %mn 2
                      %mtd
                        %mover
                          %mo →
                          %mrow
                            %msub
                              %mi pr
                              %mi c
                      %mtd
                        %msup
                          %mi S
                          %mn 3
                        %mpadded{:width => "0"}
                          %mrow
                            %mspace{:width => "thinmathspace"}
                            %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\begin{array}{ccc}
                  \\Sigma T^2_+ &amp;\xrightarrow{ pr_a }&amp; S^2_a,
                  \\,,
                  \\Sigma T^2_+ &amp;\xrightarrow{ pr_b }&amp; S^2_b,
                  \\,,
                  \\Sigma T^2_+ &amp;\xrightarrow{ pr_c }&amp; S^3
                  \\mathrlap{\,.}
                  \\end{array}
          %p
          .proof
            %h6 Proof
            %p
              The main point is, by
              %em stable splitting of product spaces
              (cf.
              = succeed ")," do
                %a{:href => "reduced+suspension#StableSplittingOfProductSpaces"} this Prop.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %msup
                      %mi T
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi Σ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo ×
                    %msup
                      %mi S
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %munder
                      %mo ≃
                      %mi hmtp
                    %mi Σ
                    %msup
                      %mi S
                      %mn 1
                    %mo ∨
                    %mi Σ
                    %msup
                      %mi S
                      %mn 1
                    %mo ∨
                    %mi Σ
                    %msup
                      %mi S
                      %mn 2
                    %mo ≃
                    %msubsup
                      %mi S
                      %mi a
                      %mn 2
                    %mo ∨
                    %msubsup
                      %mi S
                      %mi b
                      %mn 2
                    %mo ∨
                    %msubsup
                      %mi S
                      %mi c
                      %mn 3
                    %mpadded{:width => "0"}
                      %mrow
                        %mspace{:width => "thinmathspace"}
                        %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Sigma T^2
                    \\;\simeq\;
                    \\Sigma(S^1 \times S^1)
                    \\underset{hmtp}{\simeq}
                    \\Sigma S^1 \vee \Sigma S^1 \vee \Sigma S^2
                    \\simeq
                    S^2_a \vee S^2_b \vee S^3_c
                    \\mathrlap{\,.}
            %p From this the claim follows by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi T
                      %mo +
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Σ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi T
                      %mn 2
                    %mo ∨
                    %msup
                      %mi S
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Σ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi T
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ∨
                    %mi Σ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi S
                      %mi a
                      %mn 2
                    %mo ∨
                    %msubsup
                      %mi S
                      %mi b
                      %mn 2
                    %mo ∨
                    %msubsup
                      %mi S
                      %mi c
                      %mn 3
                    %mo{:stretchy => "false"} )
                    %mo ∨
                    %msup
                      %mi S
                      %mn 1
                    %mpadded{:width => "0"}
                      %mrow
                        %mspace{:width => "thinmathspace"}
                        %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Sigma(T^2_+)
                    \\simeq
                    \\Sigma(T^2 \vee S^0)
                    \\simeq
                    \\Sigma(T^2) \vee \Sigma(S^0)
                    \\simeq
                    (S^2_a \vee S^2_b \vee S^3_c) \vee S^1
                    \\mathrlap{\,.}
            %p
          %p
            As a corollary we obtain:
          .num_lemma
            %h6 Lemma
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/underlying+set"} underlying set
              of the
              %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} fundamental group
              of the
              %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
              from the
              %a.existingWikiWord{:href => "/nlab/show/2-torus"} 2-torus
              to the
              %a.existingWikiWord{:href => "/nlab/show/2-sphere"} 2-sphere
              is:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mi{:mathvariant => "normal"} Map
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi T
                      %mn 2
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi S
                      %mn 2
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mo ≃
                      %mi Set
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi ℤ
                      %mn 2
                    %mo ×
                    %mi ℤ
                    %mpadded{:width => "0"}
                      %mrow
                        %mspace{:width => "thinmathspace"}
                        %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_1
                    \\mathrm{Map}\big(
                    T^2
                    ,\,
                    S^2
                    \\big)
                    \\;\simeq_{Set}\;
                    \\mathbb{Z}^2 \times \mathbb{Z}
                    \\mathrlap{\,.}
            %p
          .proof
            %h6 Proof
            %p
              Using
              = succeed ":" do
                %a.maruku-eqref{:href => "#eq:StableSplittingOfTorus"} (8)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi π
                              %mn 1
                            %msup
                              %mi{:mathvariant => "normal"} Map
                              %mo *
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %msubsup
                              %mi T
                              %mo +
                              %mn 2
                            %mo ,
                            %mspace{:width => "thinmathspace"}
                            %msup
                              %mi S
                              %mn 2
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mtd
                            %mo ≃
                            %msub
                              %mi π
                              %mn 0
                            %msup
                              %mi{:mathvariant => "normal"} Map
                              %mo *
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %msubsup
                              %mi T
                              %mo +
                              %mn 2
                            %mo ,
                            %mspace{:width => "thinmathspace"}
                            %mi Ω
                            %msup
                              %mi S
                              %mn 2
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mi π
                              %mn 0
                            %msup
                              %mi{:mathvariant => "normal"} Map
                              %mo *
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mi Σ
                            %msubsup
                              %mi T
                              %mo +
                              %mn 2
                            %mo ,
                            %mspace{:width => "thinmathspace"}
                            %msup
                              %mi S
                              %mn 2
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mi π
                              %mn 0
                            %msup
                              %mi{:mathvariant => "normal"} Map
                              %mo *
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %msup
                              %mi S
                              %mn 2
                            %mo ∨
                            %msup
                              %mi S
                              %mn 2
                            %mo ∨
                            %msup
                              %mi S
                              %mn 3
                            %mo ∨
                            %msup
                              %mi S
                              %mn 1
                            %mo ,
                            %mspace{:width => "thinmathspace"}
                            %mi Ω
                            %msup
                              %mi S
                              %mn 2
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mi π
                              %mn 2
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi S
                              %mn 2
                            %msup
                              %mo{:stretchy => "false"} )
                              %mn 2
                            %mo ×
                            %msub
                              %mi π
                              %mn 3
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi S
                              %mn 2
                            %mo{:stretchy => "false"} )
                            %mo ×
                            %msub
                              %mi π
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi S
                              %mn 2
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msup
                              %mi ℤ
                              %mn 2
                            %mo ×
                            %mi ℤ
                            %mpadded{:width => "0"}
                              %mrow
                                %mspace{:width => "thinmathspace"}
                                %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\pi_1
                    \\mathrm{Map}^\ast\big(
                    T^2_+
                    ,\,
                    S^2
                    \\big)
                    \&amp;
                    \\simeq
                    \\pi_0
                    \\mathrm{Map}^\ast\big(
                    T^2_+
                    ,\,
                    \\Omega
                    S^2
                    \\big)
                    \\\
                    \&amp;
                    \\simeq
                    \\pi_0
                    \\mathrm{Map}^\ast\big(
                    \\Sigma T^2_+
                    ,\,
                    S^2
                    \\big)
                    \\\
                    \&amp; \simeq
                    \\pi_0
                    \\mathrm{Map}^\ast\big(
                    S^2 \vee S^2 \vee S^3 \vee S^1
                    ,\,
                    \\Omega
                    S^2
                    \\big)
                    \\\
                    \&amp; \simeq
                    \\pi_2(S^2)^2
                    \\times
                    \\pi_3(S^2)
                    \\times
                    \\pi_1(S^2)
                    \\\
                    \&amp; \simeq
                    \\mathbb{Z}^2 \times \mathbb{Z}
                    \\mathrlap{\,.}
                    \\end{aligned}
            %p
              In the last step we inserted the well-known
              %a.existingWikiWord{:href => "/nlab/show/homotopy+groups+of+spheres"} homotopy groups of
              the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/2-sphere"} 2-sphere
          %p For the generators of these homotopy groups, write:
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ι
                        %mi n
                      %mspace{:width => "thinmathspace"}
                      %mo ≔
                      %mspace{:width => "thinmathspace"}
                      %mn 1
                      %mo ∈
                      %mi ℤ
                      %mo ≃
                      %msub
                        %mi π
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi S
                        %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \iota_n \,\coloneqq\, 1 \in \mathbb{Z} \simeq \pi_2(S^2)
              %p
                (represented by the
                = succeed ")," do
                  %a.existingWikiWord{:href => "/nlab/show/identity+map"} identity map
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                      %mspace{:width => "thinmathspace"}
                      %mo ≔
                      %mspace{:width => "thinmathspace"}
                      %mn 1
                      %mo ∈
                      %mi ℤ
                      %mo ≃
                      %msub
                        %mi π
                        %mn 3
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi S
                        %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \eta \,\coloneqq\, 1 \in \mathbb{Z} \simeq \pi_3(S^2)
              %p
                (represented by the
                = succeed ")." do
                  %a.existingWikiWord{:href => "/nlab/show/complex+Hopf+fibration"} complex Hopf fibration
          %p
          #SamelsonProductInOmegaOfSphere.num_lemma
            %h6 Lemma
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Whitehead+bracket"} Whitehead bracket
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_\bullet(S^2)
              satisfies
            #eq:WhiteheadBracketInS2.maruku-equation
              %span.maruku-eq-number (9)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                    %msub
                      %mi ι
                      %mn 2
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi ι
                      %mn 2
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                    %mo =
                    %mn 2
                    %mi η
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\big[
                    \\iota_2
                    ,\,
                    \\iota_2
                    \\big]
                    \=
                    2 \eta
                    \\,.
            %p
              Under the
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi τ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi π
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ∼
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi Ω
                    %msup
                      %mi S
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\tau
                    \\;\colon\;
                    \\pi_{\bullet+ 1}(S^2)
                    \\xrightarrow{ \sim }
                    \\pi_\bullet(\Omega S^2)
            %p
              this is the
              %a.existingWikiWord{:href => "/nlab/show/Samelson+product"} Samelson product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle -,-\rangle
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi Ω
                      %msup
                        %mi S
                        %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi_\bullet(\Omega S^2)
              %a.existingWikiWord{:href => "/nlab/show/group+commutator"} group commutator
              of the
              %a.existingWikiWord{:href => "/nlab/show/grouplike+space"} grouplike space
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ω
                      %msup
                        %mi S
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \Omega S^2
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟨
                    %mi τ
                    %msub
                      %mi ι
                      %mn 2
                    %mo ,
                    %mi τ
                    %msub
                      %mi ι
                      %mn 2
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                    %mspace{:width => "thinmathspace"}
                    %mo =
                    %mspace{:width => "thinmathspace"}
                    %mn 2
                    %mi τ
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi ι
                      %mn 2
                    %mo ,
                    %msub
                      %mi ι
                      %mn 2
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo =
                    %mspace{:width => "thinmathspace"}
                    %mn 2
                    %mi τ
                    %mi η
                    %mpadded{:width => "0"}
                      %mrow
                        %mspace{:width => "thinmathspace"}
                        %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\big\langle
                    \\tau \iota_2,
                    \\tau \iota_2
                    \\big\rangle
                    \\,=\,
                    2 \tau[\iota_2, \iota_2]
                    \\,=\,
                    2 \tau \eta
                    \\mathrlap{\,.}
            %p
          For the first statement see at
          %em
            %a.existingWikiWord{:href => "/nlab/show/Whitehead+bracket"} Whitehead bracket
          (
          %a{:href => "Whitehead+product#WhiteheadProductCorrespondingToComplexHopfFibration"}> this example
          ), for the second see at
          = succeed "." do
            %em
              %a.existingWikiWord{:href => "/nlab/show/Samelson+product"} Samelson product
          %p Now we are ready for the proof:
          %p
          .proof
            %h6 Proof
            %p
              of Prop.
              = succeed "." do
                %a.maruku-ref{:href => "#FundamentalGroupOfMapsFromTorusToSphere"}
            %p
              The group generators
              %a.maruku-eqref{:href => "#eq:GeneratorsOfIntegerHeisenbergGroup"} (7)
              are evidently represented by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %msup
                            %mi ℤ
                            %mn 2
                          %mo ×
                          %mi ℤ
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mphantom
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo ∼
                              %mphantom
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mtd
                          %msub
                            %mi π
                            %mn 1
                          %msup
                            %mi Map
                            %mo *
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %msubsup
                            %mi T
                            %mo +
                            %mn 2
                          %mo ,
                          %msup
                            %mi S
                            %mn 2
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mtr
                        %mtd
                          %msub
                            %mi W
                            %mi a
                        %mtd
                          %mo ↦
                        %mtd
                          %msubsup
                            %mi pr
                            %mi a
                            %mo *
                          %msub
                            %mi ι
                            %mn 2
                          %mspace{:width => "thinmathspace"}
                          %mo ,
                      %mtr
                        %mtd
                          %msub
                            %mi W
                            %mi b
                        %mtd
                          %mo ↦
                        %mtd
                          %msubsup
                            %mi pr
                            %mi b
                            %mo *
                          %msub
                            %mi ι
                            %mn 2
                          %mspace{:width => "thinmathspace"}
                          %mo ,
                      %mtr
                        %mtd
                          %mi ζ
                        %mtd
                          %mo ↦
                        %mtd
                          %msubsup
                            %mi pr
                            %mi c
                            %mo *
                          %mi η
                          %mspace{:width => "thinmathspace"}
                          %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{ccc}
                    \\mathbb{Z}^2 \times \mathbb{Z}
                    \&amp;\xrightarrow{ \phantom{-} \sim \phantom{-} }&amp;
                    \\pi_1 Map^\ast\big(T^2_+, S^2\big)
                    \\\
                    W_a &amp;\mapsto&amp; pr_a^\ast \iota_2\,,
                    \\\
                    W_b &amp;\mapsto&amp; pr_b^\ast \iota_2\,,
                    \\\
                    \\zeta &amp;\mapsto&amp; pr_c^\ast \eta\,.
                    \\end{array}
            %p
              and the group commutator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi W
                      %mi a
                    %mo ,
                    %msub
                      %mi W
                      %mi b
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [W_a, W_b]
              is represented by the
              %a.existingWikiWord{:href => "/nlab/show/Samelson+product"} Samelson product
              map:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi T
                      %mo +
                      %mn 2
                    %mover
                      %mo →
                      %mi diag
                    %msubsup
                      %mi T
                      %mo +
                      %mn 2
                    %mo ∧
                    %msubsup
                      %mi T
                      %mo +
                      %mn 2
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi pr
                          %mi a
                        %mo ∧
                        %msub
                          %mi pr
                          %mi b
                    %msup
                      %mi S
                      %mn 1
                    %mo ∧
                    %msup
                      %mi S
                      %mn 1
                    %mover
                      %mo →
                      %mrow
                        %mover
                          %mi id
                          %mo ˜
                        %mo ∧
                        %mover
                          %mi id
                          %mo ˜
                    %mo{:stretchy => "false"} (
                    %mi Ω
                    %msup
                      %mi S
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %mi Ω
                    %msup
                      %mi S
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %mo{:stretchy => "false"} ⟨
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} ⟩
                    %mi Ω
                    %msup
                      %mi S
                      %mn 2
                    %mpadded{:width => "0"}
                      %mrow
                        %mspace{:width => "thinmathspace"}
                        %mo .
                  %annotation{:encoding => "application/x-tex"}
                    T^2_+
                    \\xrightarrow{ diag }
                    T^2_+
                    \\wedge
                    T^2_+
                    \\xrightarrow{
                    pr_a
                    \\wedge
                    pr_b
                    }
                    S^1 \wedge S^1
                    \\xrightarrow{  \widetilde{id} \wedge \widetilde{id}  }
                    (\Omega S^2)
                    \\wedge
                    (\Omega S^2)
                    \\xrightarrow{ \langle-,-\rangle }
                    \\Omega S^2
                    \\mathrlap{\,.}
            %p
              By Lem.
              = succeed "," do
                %a.maruku-ref{:href => "#SamelsonProductInOmegaOfSphere"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟨
                    %mi τ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ι
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ι
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                    %mspace{:width => "thinmathspace"}
                    %mo =
                    %mspace{:width => "thinmathspace"}
                    %mi τ
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi ι
                      %mn 2
                    %mo ,
                    %msub
                      %mi ι
                      %mn 2
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo =
                    %mspace{:width => "thinmathspace"}
                    %mn 2
                    %mi τ
                    %mo{:stretchy => "false"} (
                    %mi η
                    %mo{:stretchy => "false"} )
                    %mpadded{:width => "0"}
                      %mrow
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\big\langle \tau(\iota_2), \tau(\iota_2) \big\rangle
                    \\,=\,
                    \\tau [\iota_2, \iota_2]
                    \\,=\,
                    2 \tau(\eta)
                    \\mathrlap{\,,}
            %p
              while the first half is clearly
              %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopic
              to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi pr
                        %mi c
                    %annotation{:encoding => "application/x-tex"} pr_c
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi W
                      %mi a
                    %mo ,
                    %msub
                      %mi W
                      %mi b
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [W_a, W_b]
              is represented by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi T
                      %mo +
                      %mn 2
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi pr
                          %mi c
                    %msup
                      %mi S
                      %mn 2
                    %mover
                      %mo →
                      %mrow
                        %mn 2
                        %mover
                          %mi η
                          %mo ˜
                    %mi Ω
                    %msup
                      %mi S
                      %mn 2
                    %mpadded{:width => "0"}
                      %mrow
                        %mspace{:width => "thinmathspace"}
                        %mo .
                  %annotation{:encoding => "application/x-tex"}
                    T^2_+
                    \\xrightarrow{ pr_c }
                    S^2
                    \\xrightarrow{ 2\widetilde{\eta} }
                    \\Omega S^2
                    \\mathrlap{\,.}
            %p This shows that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi W
                      %mi a
                    %mo ,
                    %msub
                      %mi W
                      %mi b
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %msup
                      %mi ζ
                      %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [W_a, W_b] = \zeta^2
                    \\,.
            %p
              To conclude it is now sufficient to see that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ζ
                  %annotation{:encoding => "application/x-tex"} \zeta
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/center"} central
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi W
                      %mi a
                    %mo ,
                    %mi ζ
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [W_a, \zeta]
              is represented by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi T
                      %mo +
                      %mn 2
                    %mover
                      %mo →
                      %mi diag
                    %msubsup
                      %mi T
                      %mo +
                      %mn 2
                    %mo ∧
                    %msubsup
                      %mi T
                      %mo +
                      %mn 2
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi pr
                          %mi a
                        %mo ∧
                        %msub
                          %mi pr
                          %mi c
                    %msup
                      %mi S
                      %mn 1
                    %mo ∧
                    %msup
                      %mi S
                      %mn 2
                    %mover
                      %mo →
                      %mrow
                        %mover
                          %mi id
                          %mo ˜
                        %mo ∧
                        %mover
                          %mi η
                          %mo ˜
                    %mo{:stretchy => "false"} (
                    %mi Ω
                    %msup
                      %mi S
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %mi Ω
                    %msup
                      %mi S
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %mo{:stretchy => "false"} ⟨
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} ⟩
                    %mi Ω
                    %msup
                      %mi S
                      %mn 2
                    %mpadded{:width => "0"}
                      %mrow
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    T^2_+
                    \\xrightarrow{ diag }
                    T^2_+
                    \\wedge
                    T^2_+
                    \\xrightarrow{
                    pr_a
                    \\wedge
                    pr_c
                    }
                    S^1 \wedge S^2
                    \\xrightarrow{  \widetilde{id} \wedge \widetilde{\eta}  }
                    (\Omega S^2)
                    \\wedge
                    (\Omega S^2)
                    \\xrightarrow{ \langle-,-\rangle }
                    \\Omega S^2
                    \\mathrlap{\,,}
            %p
              where the first part of this map is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/null+homotopy"} null-homotopic
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %msup
                      %mi Map
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi T
                      %mo +
                      %mn 2
                    %mo ,
                    %msup
                      %mi S
                      %mn 3
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \pi_0 Map^\ast(T^2_+, S^3) = \ast
              (e.g. by the
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/cellular+approximation+theorem"} cellular approximation theorem
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi W
                        %mi b
                      %mo ,
                      %mi ζ
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %mi{:mathvariant => "normal"} e
                    %annotation{:encoding => "application/x-tex"} [W_b, \zeta] = \mathrm{e}
          %p
          .num_remark
            %h6 Remark
            %p This proof strategy immediately generalizes to a computation of
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mi Map
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mrow
                        %mn 2
                        %mi k
                        %mo +
                        %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 2
                    %mo ,
                    %msup
                      %mi S
                      %mrow
                        %mn 2
                        %mi k
                        %mo +
                        %mn 2
