            %p
              By
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exactness
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ≥
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} n \geq 2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n = 1
              it gives the desired isomorphism only up to a possibly non-trivial
              %a.existingWikiWord{:href => "/nlab/show/quotient+set"} quotient
              by an
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
