                          %mi X
                          %mo ,
                          %mi ℤ
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thinmathspace"}
                          %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\pi^n(X)
                  \&amp;\overset{\simeq}{\longrightarrow}&amp;
                  \\mathbb{F}_{4-n}(X)
                  \\\
                  {}^{ \mathllap{h^n} }
                  \\downarrow
