                    %annotation{:encoding => "application/x-tex"} c' = c
          %h3#RelationToCobordismGroup Pontryagin isomorphism between Cohomotopy and framed Cobordism
          %p
            %em
              %a.existingWikiWord{:href => "/nlab/show/Pontryagin%27s+theorem"} Pontryagin's theorem
            (
            %a{:href => "#Pontryagin38"}> Pontryagin 38
            ,
            = succeed ")" do
              %a{:href => "#Pontryagin55"} Pontryagin 55
            %a.existingWikiWord{:href => "/nlab/show/cobordism+classes"} cobordism classes
            of
            %a.existingWikiWord{:href => "/nlab/show/normally+framed+submanifolds"} normally framed submanifolds
            of
            %a.existingWikiWord{:href => "/nlab/show/codimension"} codimension
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            in a
            %a.existingWikiWord{:href => "/nlab/show/closed+manifold"} closed manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mi d
                %annotation{:encoding => "application/x-tex"} X^d
            with the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/Cohomotopy"} Cohomotopy
            of that manifold – the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+classes"} homotopy classes
            of
            %a.existingWikiWord{:href => "/nlab/show/maps"} maps
            into the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/n-sphere"} n-sphere
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Cohomotopy+charge+map"} Cohomotopy charge map
            %a.existingWikiWord{:href => "/nlab/show/Pontryagin-Thom+collapse+construction"} Pontryagin-Thom collapse construction
            %em :
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Cob
                    %mi Fr
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo ⟶
                    %mo ≃
                  %msup
                    %mi π
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Cob^n_Fr(X)
                  \\overset{\simeq}{\longrightarrow}
                  \\pi^n(X)
                  \\,.
          %p
            The analogous statement identifying
            %a.existingWikiWord{:href => "/nlab/show/cobordism+classes"} cobordism classes
            of
            %a.existingWikiWord{:href => "/nlab/show/normally+oriented+submanifolds"} normally oriented submanifolds
            with
            %a.existingWikiWord{:href => "/nlab/show/homotopy+classes"} homotopy classes
            of maps into the
            %a.existingWikiWord{:href => "/nlab/show/universal+vector+bundle"} universal
            %a.existingWikiWord{:href => "/nlab/show/special+orthogonal+group"} special orthogonal
            %a.existingWikiWord{:href => "/nlab/show/Thom+space"} Thom space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                  %mi SO
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} M SO(n)
            is
            %em
              %a.existingWikiWord{:href => "/nlab/show/Thom%27s+theorem"} Thom's theorem
            (
            %a{:href => "#Thom54"}> Thom 54
            ). Both statements, as well as their joint generalization to other
            %a.existingWikiWord{:href => "/nlab/show/tangential+structures"} tangential structures
            and notably their
            %a.existingWikiWord{:href => "/nlab/show/stabilization"} stabilization
            to
            %a.existingWikiWord{:href => "/nlab/show/Whitehead-generalized+cohomology+theory"} Whitehead-generalized
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Cobordism+cohomology+theory"} Cobordism cohomology theory
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Pontryagin-Thom+collapse+construction"} Pontryagin-Thom collapse construction
            %a.existingWikiWord{:href => "/nlab/show/cobordism+theory"} cobordism theory
            and its application in
