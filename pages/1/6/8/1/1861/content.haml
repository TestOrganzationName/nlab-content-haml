                    \\big)
                    }
            %p between
            %ol
              %li
                %p
                  the
                  = succeed "-" do
                    %a.existingWikiWord{:href => "/nlab/show/J-homomorphism"} J
                  %a.existingWikiWord{:href => "/nlab/show/twisted+Cohomotopy"} twisted (n+k)-Cohomotopy
                  space of
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi X
                            %mi n
                        %annotation{:encoding => "application/x-tex"} X^n
                  %a.existingWikiWord{:href => "/nlab/show/space+of+sections"} space of sections
                  of the
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
