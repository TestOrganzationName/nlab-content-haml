                    %mi S
                    %mn 1
                  %mo ∧
                  %msup
                    %mi S
                    %mn 1
                  %mo ,
                  %msup
                    %mi S
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi Map
                    %mo *
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msup
                    %mi S
                    %mn 1
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %msup
                    %mi Map
                    %mo *
                  %mo{:stretchy => "false"} (
