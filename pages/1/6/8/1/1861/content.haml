                          %mi S
                          %mn 2
                        %mo ,
                        %msup
                          %mi S
                          %mn 2
                        %mo{:stretchy => "false"} )
                      %mtd
                        %mo ≃
                      %mtd
                        %msub
                          %mi π
                          %mn 1
                        %mspace{:width => "thinmathspace"}
                        %msubsup
                          %mi Map
                          %mn 0
                          %mo *
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi S
                          %mn 2
                        %mo ,
                        %msup
                          %mi S
                          %mn 2
                        %mo{:stretchy => "false"} )
                    %mtr
                      %mtd
                      %mtd
                        %mo ≃
                      %mtd
                        %msub
                          %mi π
                          %mn 0
                        %mspace{:width => "thinmathspace"}
                        %mi Map
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %msup
                          %mi S
                          %mn 1
                        %mo ,
                        %msubsup
                          %mi Map
                          %mn 0
                          %mo *
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi S
                          %mn 2
                        %mo ,
                        %msup
                          %mi S
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mtr
                      %mtd
                      %mtd
                        %mo ≃
                      %mtd
                        %msub
                          %mi π
                          %mn 0
                        %mspace{:width => "thinmathspace"}
                        %msubsup
                          %mi Map
                          %mn 0
                          %mo *
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi S
                          %mn 1
                        %mo ∧
                        %msup
                          %mi S
                          %mn 2
                        %mo ,
                        %msup
                          %mi S
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mtr
                      %mtd
                      %mtd
                        %mo ≃
                      %mtd
                        %msub
                          %mi π
                          %mn 0
                        %mspace{:width => "thinmathspace"}
                        %msubsup
                          %mi Map
                          %mn 0
                          %mo *
