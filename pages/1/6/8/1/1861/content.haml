                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi k
                  %mo ⋅
                  %mi id
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\pi_1 \, Map_k(S^2, S^2)
                  \\;\;
                  \\coloneqq
                  \\;\;
                  \\pi_1 \big( Map_k(S^2, S^2), k \cdot id \big)
                  \\,.
          %p
            To beware that this is the free mapping space in contrast to the
            %a.existingWikiWord{:href => "/nlab/show/pointed+mapping+space"} pointed mapping space
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Map
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Map^\ast(-,-)
            %a.existingWikiWord{:href => "/nlab/show/based+loop+space"} based loop space
            (by the
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
            %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjunction
            with the
            %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
            of
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/pointed+topological+spaces"} pointed topological spaces
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Map
                    %mo *
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mn 2
                  %mo ,
                  %msup
                    %mi S
