                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
