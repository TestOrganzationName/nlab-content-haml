                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %mi K
                  %msubsup
                    %mi 𝔽
                    %mn 1
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbb{S}^\bullet(X)
                  \\;\simeq\;
                  K\mathbb{F}_1 ^ \bullet(X)
                  \\,.
          %p
            For example, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo =
                %annotation{:encoding => "application/x-tex"} E =
            %a.existingWikiWord{:href => "/nlab/show/KU"} KU
            and in the case of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/equivariant+cohomology+theory"} equivariant cohomology theory
            (
            %a.existingWikiWord{:href => "/nlab/show/equivariant+Cohomotopy+theory"} equivariant Cohomotopy theory
            and
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/equivariant+K-theory"} equivariant K-theory
            %a.existingWikiWord{:href => "/nlab/show/Boardman+homomorphism"} Boardman homomorphism
            %a.maruku-eqref{:href => "#eq:BoardmanHomomorphism"} (1)
            gives the comparison map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi 𝕊
                    %mi G
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi R
                    %mrow
                      %msub
                        %mi 𝔽
                        %mn 1
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo ⟶
                    %mrow
                      %mi ℂ
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ]
                  %msub
                    %mi R
                    %mi ℂ
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msubsup
                    %mi KU
                    %mi G
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathbb{S}^0_G(\ast)
                  \\simeq
                  R_{\mathbb{F}_1}(G)
                  \\simeq
                  A(G)
                  \\overset{\mathbb{C}[-]}{\longrightarrow}
                  R_{\mathbb{C}}(G)
                  \\simeq
                  KU^0_G(\ast)
          %p
            from the
            %a.existingWikiWord{:href => "/nlab/show/Burnside+ring"} Burnside ring
            to the
            %a.existingWikiWord{:href => "/nlab/show/representation+ring"} representation ring
            of the
            %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite group
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/permutation+representations"} permutation representations
            %a.existingWikiWord{:href => "/nlab/show/Burnside+ring"} Burnside ring
            as being the
            %a.existingWikiWord{:href => "/nlab/show/representation+ring"} representation ring
            over the “
            %a.existingWikiWord{:href => "/nlab/show/field+with+one+element"}> field with one element
            ” (see e.g.
            = succeed ")," do
              %a{:href => "field+with+one+element#ChuLorscheidSanthanam10"} Chu, Lorscheid &amp; Santhanam 2010
          %p
            So far, this applies to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/stable+Cohomotopy+theory"} stable Cohomotopy theory
            %a.existingWikiWord{:href => "/nlab/show/stabilization"} stabilization
            makes the immensely rich nature of
            %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            a tad more tractable, it is only an approximation (just the first
            = succeed "!)" do
              %a.existingWikiWord{:href => "/nlab/show/Goodwillie+calculus"} Goodwillie derivative
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/non-abelian+cohomology"} non-abelian cohomology
          %p
            For example, the classification of
            %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+instantons"} Yang-Mills instantons
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mn 4
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^4
            is typically regarded in the
            %a.existingWikiWord{:href => "/nlab/show/non-abelian+cohomology"} non-abelian cohomology
            theory represented by the
            %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
            %a.existingWikiWord{:href => "/nlab/show/BSU%28n%29"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
