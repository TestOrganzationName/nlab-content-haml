                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    {\widetilde \pi}{}^1(X,x)/\pi_1(S^1)
                    \\simeq
                    \\pi^1(X)
                    \\,.
            %p
              Hence it is now sufficient to see that the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
