                      %semantics
                        %mrow
                          %msup
                            %mi S
                            %mi k
                        %annotation{:encoding => "application/x-tex"} S^k
          %p
            (
            %a{:href => "Cohomotopy+charge#Boedigheimer87"}> Bödigheimer 87, Prop. 2
            , following
            = succeed ")" do
              %a{:href => "Cohomotopy+charge#McDuff75"} McDuff 75
          #ScanningMapEquivalenceOverClosedFramedManifold.num_prop
            %h6#remark_2 Remark
            %p
              In the special case that the
              %a.existingWikiWord{:href => "/nlab/show/closed+manifold"} closed manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mi n
                  %annotation{:encoding => "application/x-tex"} X^n
              in Prop.
              %a.maruku-ref{:href => "#ScanningMapEquivalenceOverClosedManifold"}
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/parallelizable+manifold"} parallelizable
              %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/trivial+bundle"} trivializable
              %a.maruku-ref{:href => "#ScanningMapEquivalenceOverClosedManifold"}
              reduces to this:
            %p Let
