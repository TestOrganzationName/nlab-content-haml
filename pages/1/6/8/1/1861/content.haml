                      %mn 1
                    %mo ,
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                  %annotation{:encoding => "application/x-tex"} \big[ (X,x) \overset{ \;c\; }{\longrightarrow} (S^1,\ast) \big]
              to any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mi c
                        %mo ′
                        %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo ,
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                  %annotation{:encoding => "application/x-tex"} \big[ (X,x) \overset{ \;c'\; }{\longrightarrow} (S^1,\ast) \big]
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mover
                      %mo ⟶
                      %mi c
                    %msup
                      %mi S
                      %mn 1
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo ⇒
                      %mi η
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mover
                      %mo ⟶
                      %mrow
                        %mi c
                        %mo ′
                    %msup
                      %mi S
                      %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [X \overset{c}{\longrightarrow} S^1] \overset{\eta}{\Rightarrow} [X \overset{c'}{\longrightarrow} S^1]
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi^1(X)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi η
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %mi n
                      %mo ∈
                      %msub
                        %mi π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi S
                        %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} [\eta(x,-)] = n \in \pi_1(S^1)
              = succeed "-structure" do
                %a.existingWikiWord{:href => "/nlab/show/group"} group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                    %mo =
                    %mi ℝ
                    %mo{:stretchy => "false"} /
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} S^1 = \mathbb{R}/\mathbb{Z}
              we have that one such
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
              is given by
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi t
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %mi c
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mi n
                      %mi t
                      %mspace{:width => "thinmathspace"}
                      %mi mod
                      %mspace{:width => "thinmathspace"}
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \eta(x,t) \coloneqq c(x) + n t \,mod\, \mathbb{Z}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ′
