                %strong XLI
                (1989) 261-299 &amp;lbrack;
                %a.existingWikiWord{:href => "/nlab/files/Kelly-Lawvere_EssentialLocalizations.pdf", :title => "pdf"}> pdf
                \&amp;rbrack;
            %li#KRRZ10
              %p
                C. Kennett,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Emily+Riehl"} E. Riehl
                %em Levels in the toposes of simplicial sets and cubical sets
                , JPAA
                %strong 215
