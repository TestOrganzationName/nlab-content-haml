              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              with
              = succeed "." do
                %strong differential cohesion
          .num_remark
            %h6#remark Remark
            %p
              This definition is an abstraction of similar situations considered in (
              %a{:href => "#SimpsonTeleman"}> SimpsonTeleman
              ) and in
              = succeed "." do
                %a{:href => "#KontsevichRosenbergSpaces"} Kontsevich-Rosenberg
              %a{:href => "Q-category#InfinitesimalThickening"} Infinitesimal thickening
              at
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Q-category"} Q-category
          #InfinitesimalInclusionIfFullAndFaithful.num_remark
            %h6#remark_2 Remark
            %p
              This implies that also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mo *
                  %annotation{:encoding => "application/x-tex"} i_*
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+%28%E2%88%9E%2C1%29-functor"} full and faithful (∞,1)-functor
          .proof
            %h6#proof Proof
            %p
              By the characterizaton of full and faithful
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functor"} adjoint (∞,1)-functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mo !
                  %annotation{:encoding => "application/x-tex"} i_!
              is equivalent to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi i
                        %mo *
                      %msub
                        %mi i
                        %mo !
                      %mo ≃
                      %mi Id
                    %annotation{:encoding => "application/x-tex"} i^* i_! \simeq Id
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi i
                      %mo *
                    %msub
                      %mi i
                      %mo !
                    %mo ⊣
                    %msup
                      %mi i
                      %mo *
                    %msub
                      %mi i
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (i^* i_! \dashv i^* i_*)
              it follows by essential uniqueness of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functor"} adjoint (∞,1)-functor
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi i
                        %mo *
                      %msub
                        %mi i
                        %mo *
                      %mo ≃
