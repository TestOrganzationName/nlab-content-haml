                    }
            %p
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi U
                      %mo ^
                    %mo →
                    %mi U
                  %annotation{:encoding => "application/x-tex"} \widehat{U} \to U
              a formally étale 1-epimorphism. But since both
              %a.existingWikiWord{:href => "/nlab/show/1-epimorphisms"} 1-epimorphisms
              as well as
              %a.existingWikiWord{:href => "/nlab/show/formally+%C3%A9tale+morphisms"} formally étale morphisms
              are stable under
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
              we can take
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi U
                        %mo ^
                      %mo ≔
