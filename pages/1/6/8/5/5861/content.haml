                            %mi ʃ
                            %mi rel
                          %mo ⊣
                          %msup
                            %mo ♭
                            %mi rel
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (&amp;#643;^{rel} \dashv \flat^{rel})
              %li
                %p
                  whose (co-)
                  %a.existingWikiWord{:href => "/nlab/show/modal+types"} modal types
                  are precisely the properly infinitesimal types, hence those for which
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ♭
                        %mo →
