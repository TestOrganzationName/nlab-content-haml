            %p
              is a weak equivalence, hence that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi i
                      %mo *
                    %mi F
                  %annotation{:encoding => "application/x-tex"} i^* F
              is locally fibrant.
            %p
              To see that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %mi p
                  %annotation{:encoding => "application/x-tex"} (-) \circ p
              preserves locally fibrant objects, we apply the analogous reasoning after observing that its
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %mi i
                  %annotation{:encoding => "application/x-tex"} (-)\circ i
              preserves all
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/limit"} limit
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaves"} simplicial presheaves
              (as these are computed objectwise) and by observing that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi U
                      %mi i
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi p
                          %mi i
                    %mstyle{:mathvariant => "bold"}
                      %mi U
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{\mathbf{U}_i \stackrel{p_i}{\to} \mathbf{U}\}
              a covering family in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mi th
                  %annotation{:encoding => "application/x-tex"} C_{th}
              we have that its image under
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %mi i
                  %annotation{:encoding => "application/x-tex"} (-) \circ i
              is its image under
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %msup
                              %mi C
                              %mi op
                            %mo ,
                            %mi sSet
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} (
                            %mi K
                            %mo ,
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                            %mo ∘
                            %mi i
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mstyle{:mathvariant => "bold"}
                              %mi U
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                            %msub
                              %mi C
                              %mi th
                            %mo{:stretchy => "false"} (
                            %mi i
                            %mo{:stretchy => "false"} (
                            %mi K
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mi U
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mi K
                            %mo ,
                            %mi p
                            %mo{:stretchy => "false"} (
                            %mstyle{:mathvariant => "bold"}
                              %mi U
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    [C^{op}, sSet](K, ((-)\circ i) (\mathbf{U}))
                    \&amp; \simeq
                    C_{th}(i(K), \mathbf{U})
                    \\\
                    \&amp; \simeq
                    C(K, p(\mathbf{U}))
                    \\end{aligned}
            %p
              and using that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              preserves covers by assumption.
            %p
              Therefore
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %mi i
                  %annotation{:encoding => "application/x-tex"} (-) \circ i
              is a left and right local
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen functor
              with left local Quillen adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Lan
                      %mi i
                  %annotation{:encoding => "application/x-tex"} Lan_i
              and right local Quillen adjoint
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo ∘
                      %mi p
                    %annotation{:encoding => "application/x-tex"} (-)\circ p
            %p
              It follows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi i
                      %mo *
                    %mo :
                    %msub
                      %mi Sh
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mi th
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi Sh
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} i^* : Sh_{(\infty,1)}(C_{th}) \to Sh_{(\infty,1)}(C)
              is given by the left
              %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived functor
              of restriction along
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mo *
                    %mo :
                    %msub
                      %mi Sh
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi Sh
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mi th
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} i_* : Sh_{(\infty,1)}(C) \to Sh_{(\infty,1)}(C_{th})
              is given by the right
              %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived functor
              of restriction along
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
            %p
              Finally to see that also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ran
                      %mi p
                  %annotation{:encoding => "application/x-tex"} Ran_p
              preserves locally fibrant objects by the same reasoning as above, notice that for every
              %a.existingWikiWord{:href => "/nlab/show/covering"} covering
              family
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi U
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U_i \to U\}
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and every morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi K
                    %mo →
                    %msup
                      %mi p
                      %mo *
                    %mi U
                  %annotation{:encoding => "application/x-tex"} \mathbf{K} \to p^* U
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mi th
                  %annotation{:encoding => "application/x-tex"} C_{th}
              we may find a covering
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi K
                      %mi j
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi K
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{\mathbf{K}_j  \to \mathbf{K}\}
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi K
                  %annotation{:encoding => "application/x-tex"} \mathbf{K}
              such that we find commuting diagrams on the left of
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi K
                              %mi j
                          %mtd
                            %mo →
                          %mtd
                            %msup
                              %mi p
                              %mo *
                            %msub
                              %mi U
                              %mrow
                                %mi i
                                %mo{:stretchy => "false"} (
                                %mi j
                                %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi K
                          %mtd
                            %mo →
                          %mtd
                            %msup
                              %mi p
                              %mo *
                            %mi U
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ↔
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi p
                            %mo{:stretchy => "false"} (
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi K
                              %mi j
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                          %mtd
                            %msup
                              %mi i
                              %mo *
                            %mo{:stretchy => "false"} (
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi K
                              %mi j
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi U
                              %mrow
                                %mi i
                                %mo{:stretchy => "false"} (
                                %mi j
                                %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi p
                            %mo{:stretchy => "false"} (
                            %mstyle{:mathvariant => "bold"}
                              %mi K
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                          %mtd
                            %msup
                              %mi i
                              %mo *
                            %mo{:stretchy => "false"} (
                            %mstyle{:mathvariant => "bold"}
                              %mi K
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mi U
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbf{K}_j &amp;\to&amp; p^* U_{i(j)}
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    \\mathbf{K} &amp;\to&amp; p^* U
                    }
                    \\;\;\;
                    \\leftrightarrow
                    \\;\;\;
                    \\array{
                    p(\mathbf{K}_j) &amp; =&amp;  i^*(\mathbf{K}_j) &amp;\to&amp;  U_{i(j)}
                    \\\
                    \\downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow
                    \\\
                    p(\mathbf{K}) &amp;= &amp; i^*(\mathbf{K})  &amp;\to&amp;  U
                    }
                    \\,,
            %p
              because by adjunction these correspond to commuting diagrams as indicated on the right, which exist by definition of
              %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and lift through
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              by assumption on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi C
                        %mi th
                    %annotation{:encoding => "application/x-tex"} C_{th}
            %p
              This implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi p
                      %mo *
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %msup
                      %mi p
                      %mo *
                    %mi U
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{p^* U_i \to p^* U\}
              is a
              %em generalized cover
              in the terminology at
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
              %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
              equivalent to the
              %a.existingWikiWord{:href => "/nlab/show/sieve"} sieve
              inclusion is a weak equivalence.
            %p
              This establishes the quadruple of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functor"} adjoint (∞,1)-functor
            %p
              It remains to see that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mo !
                  %annotation{:encoding => "application/x-tex"} i_!
              is full and faithful. For that notice the general fact that left
              %a.existingWikiWord{:href => "/nlab/show/Kan+extension"} Kan extension
              (see the properties discussed there) along a
              %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+functor"} full and faithful functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              satisfies
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Lan
                        %mi i
                      %mo ∘
                      %mi i
                      %mo ≃
                      %mi id
                    %annotation{:encoding => "application/x-tex"} Lan_i \circ i \simeq id
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %mi i
                  %annotation{:encoding => "application/x-tex"} (-)\circ i
              is not only right but also left Quillen by the above, we have that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi i
                      %mo *
                    %msub
                      %mi Lan
                      %mi i
                  %annotation{:encoding => "application/x-tex"} i^* Lan_i
              applied to a cofibrant object is already the
              %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived functor
              of the composite.
          .num_remark
            %h6#remark_5 Remark
            %p
              Conversely this implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Sh
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mi th
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh_{(\infty,1)}(C_{th})
              is an
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} ∞-connected (∞,1)-topos
              over
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} Smooth∞Grpd
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi i
                      %mo *
                    %mo ⊣
                    %msub
                      %mi i
                      %mo *
                    %mo ⊣
                    %msup
                      %mi i
                      %mo !
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi SynthDiff
                    %mn ∞
                    %mi Grpd
                    %mo →
                    %mi Smooth
                    %mn ∞
                    %mi Grpd
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (i^* \dashv i_* \dashv i^!) :
                    SynthDiff \infty Grpd \to Smooth \infty Grpd
                    \\,.
          %h4#RelationToInfinitesimalCohesion Relation to infinitesimal cohesion
          %p
            We discuss how differential cohesion in the sense of def.
            %a.maruku-ref{:href => "#InfinitesimalCohesiveInfTopos"}
            relates to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+cohesion"} infinitesimal cohesion
          %blockquote
            %p under construction
          #InducedRelativeShapeAndFlat.num_defn
            %h6#definition_4 Definition
            %p
              Given differential cohesion, def.
              = succeed "," do
                %a.maruku-ref{:href => "#InfinitesimalCohesiveInfTopos"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ℜ
                          %mtd
                            %mo ⊣
                          %mtd
                            %mi ℑ
                          %mtd
                            %mo ⊣
                          %mtd
                            %mi &amp;
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo ∨
                          %mtd
                          %mtd
                            %mo ∨
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi ʃ
                          %mtd
                            %mo ⊣
                          %mtd
                            %mo ♭
                          %mtd
                            %mo ⊣
                          %mtd
                            %mo ♯
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\Re &amp;\dashv&amp; \Im &amp;\dashv&amp; {\&amp;}
                    \\\
