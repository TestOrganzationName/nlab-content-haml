            %p
              where the right square is the defining pullback for the
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+disk"} infinitesimal disk
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝔻
                        %mi G
                    %annotation{:encoding => "application/x-tex"} \mathbb{D}^G
              %a{:href => "Mayer-Vietoris%20sequence#HTTArgumentForPullback"} this proposition
              that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi inf
                    %mi G
                    %mo ≃
                    %mi G
                    %mo ×
                    %msup
                      %mi 𝔻
                      %mi G
                  %annotation{:encoding => "application/x-tex"} T_{inf} G \simeq G\times \mathbb{D}^G
              and that the top horizontal morphism is as claimed.
          %p
            By lemma
            %a.maruku-ref{:href => "#EtalePullbackOfFormalDiskBundleIsFormalDiskBundle"}
            it follows that:
          #FormalDiskBundleOfRegularManifoldsTrivializesOverCover.num_prop
            %h6#proposition_13 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              a framed object, def.
              = succeed "," do
                %a.maruku-ref{:href => "#Framing"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              = succeed "-manifold," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              = succeed "." do
                %a.maruku-ref{:href => "#Manifold"}
              = succeed "," do
                %a.maruku-ref{:href => "#FormalDiskBundle"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              canonically trivializes over any
              = succeed "-cover" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ←
                    %mi U
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} V \leftarrow U \rightarrow X
              , i.e. there is a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi U
                            %mo ×
                            %msup
                              %mi 𝔻
                              %mi V
                          %mtd
                            %mo ⟶
                          %mtd
                            %msub
                              %mi T
                              %mi inf
                            %mi X
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi U
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    U \times \mathbb{D}^V &amp;\longrightarrow&amp; T_{inf} X
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    U &amp;\longrightarrow&amp; X
                    }
                    \\,.
            %p
              This exhibits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi inf
                    %mi X
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} T_{inf} X\to X
              as a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝔻
                        %mi V
                    %annotation{:encoding => "application/x-tex"} \mathbb{D}^V
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/fiber+%E2%88%9E-bundle"} fiber ∞-bundle
          #ModulatingMapOfFormalDiskBundle.num_prop
            %h6#remark_19 Remark
            %p
              By
              %a{:href => "fiber+infinity-bundle#Properties"} this discussion
              this fiber
              %a.existingWikiWord{:href => "/nlab/show/fiber+%E2%88%9E-bundle"} fiber ∞-bundle
              is the
              %a.existingWikiWord{:href => "/nlab/show/associated+%E2%88%9E-bundle"} associated ∞-bundle
              of an essentially uniquely determined
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Aut
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi 𝔻
                        %mi V
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{Aut}(\mathbb{D}^V)
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
          #FrameBundleMap.num_defn
            %h6#definition_20 Definition
            %p
              Given a
              = succeed "-manifold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "," do
                %a.maruku-ref{:href => "#Manifold"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              = succeed "," do
                %a.maruku-ref{:href => "#Framing"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/frame+bundle"} frame bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Fr
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Fr(X)
              is the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi GL
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} GL(V)
              %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
              given by prop.
              %a.maruku-ref{:href => "#FormalDiskBundleOfRegularManifoldsTrivializesOverCover"}
              via remark
              = succeed "." do
                %a.maruku-ref{:href => "#ModulatingMapOfFormalDiskBundle"}
          .num_remark
            %h6#remark_20 Remark
            %p
              As in remark
              = succeed "," do
                %a.maruku-ref{:href => "#OrderOfInfinitesimalDisks"}
              %a.existingWikiWord{:href => "/nlab/show/higher+order+frame+bundles"} higher order frame bundles
              with the order implicit in the nature of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+shape+modality"} infinitesimal shape modality
          #FrameBundlesFunctorial.num_remark
            %h6#remark_21 Remark
            %p
              By prop.
              %a.maruku-ref{:href => "#EtalePullbackOfFormalDiskBundleIsFormalDiskBundle"}
              the construction of frame bundles in def.
              %a.maruku-ref{:href => "#FrameBundleMap"}
              is functorial in
              %a.existingWikiWord{:href => "/nlab/show/formally+%C3%A9tale+maps"} formally étale maps
              between
              = succeed "-manifolds." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
          %h4#structures
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            \-Structures
          %p
            We discuss the formalization of
            %a.existingWikiWord{:href => "/nlab/show/G-structures"} G-structures
            and
            %a.existingWikiWord{:href => "/nlab/show/integrability+of+G-structures"} integrability of G-structures
            in differential cohesion
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            be framed, def.
            = succeed "," do
              %a.maruku-ref{:href => "#Framing"}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            be an
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo →
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G \to GL(V)
            a homomorphism to the general linear group of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            = succeed "," do
              %a.maruku-ref{:href => "#GeneralLinearGroup"}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mstyle{:mathvariant => "bold"}
                    %mi Struc
                  %mo{:lspace => "verythinmathspace"} :
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo ⟶
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  G\mathbf{Struc}\colon \mathbf{B}G \longrightarrow \mathbf{B}GL(V)
          %p
            a morphism between the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/deloopings"} deloopings
          #GStructure.num_defn
            %h6#definition_21 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              = succeed "-manifold," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              = succeed "," do
                %a.maruku-ref{:href => "#Manifold"}
              %strong
                %a.existingWikiWord{:href => "/nlab/show/G-structure"} G-structure
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a lift of the structure group of its
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/frame+bundle"} frame bundle
              = succeed "," do
                %a.maruku-ref{:href => "#FrameBundleMap"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                          %mtd
                            %mo ⟶
                          %mtd
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi τ
                                    %mi X
                            %mo ↘
                          %mtd
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi G
                                  %mstyle{:mathvariant => "bold"}
                                    %mi Struc
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi GL
                            %mo{:stretchy => "false"} (
                            %mi V
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;&amp; \longrightarrow&amp;&amp;  \mathbf{B}G
                    \\\
                    \&amp; {}_{\mathllap{\tau_X}}\searrow &amp;&amp; \swarrow_{\mathrlap{G\mathbf{Struc}}}
                    \\\
                    \&amp;&amp; \mathbf{B}GL(V)
                    }
            %p hence a morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi τ
                      %mi X
                    %mo ⟶
                    %mi G
                    %mstyle{:mathvariant => "bold"}
                      %mi Struc
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{c} \colon \tau_X \longrightarrow G\mathbf{Struc}
            %p
              in the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/slice+%28%E2%88%9E%2C1%29-topos"} slice (∞,1)-topos
          %p
            In fact
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mstyle{:mathvariant => "bold"}
                    %mi Struc
                  %mo ∈
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi GL
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G\mathbf{Struc}\in \mathbf{H}_{/\mathbf{B}GL(n)}
            is the
            %a.existingWikiWord{:href => "/nlab/show/moduli+%E2%88%9E-stack"} moduli ∞-stack
            of such
            = succeed "-structures." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %p
            The double
            %a.existingWikiWord{:href => "/nlab/show/slice+%28%E2%88%9E%2C1%29-topos"} slice
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi GL
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mi G
                      %mstyle{:mathvariant => "bold"}
                        %mi Struc
                %annotation{:encoding => "application/x-tex"} (\mathbf{H}_{/\mathbf{B}GL(n)})_{/G\mathbf{Struc}}
            is the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            of such
            = succeed "-structures." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          #TrivialGStructure.num_example
            %h6#example_5 Example
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              is framed, def.
              = succeed "," do
                %a.maruku-ref{:href => "#Framing"}
              = succeed "-structure," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi c
                      %mn 0
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi τ
                      %mi V
                    %mo ⟶
                    %mi G
                    %mstyle{:mathvariant => "bold"}
                      %mi Struc
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{c}_0 \colon \tau_{V} \longrightarrow G\mathbf{Struc}
                    \\,.
          #IntegrableGStructure.num_defn
            %h6#definition_22 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              framed, def.
              = succeed "," do
                %a.maruku-ref{:href => "#Framing"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              = succeed "-manifold," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              = succeed "," do
                %a.maruku-ref{:href => "#Manifold"}
              = succeed "-structure" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                  %annotation{:encoding => "application/x-tex"} \mathbf{c}
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "," do
                %a.maruku-ref{:href => "#GStructure"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/integrability+of+G-structures"} integrable
              (or
              = succeed ")" do
                %em locally flat
              = succeed "-cover" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi U
                        %mtr
                          %mtd
                          %mtd
                            %mo ↙
                          %mtd
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                            %mi V
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; U
                    \\\
                    \&amp; \swarrow &amp;&amp; \searrow
                    \\\
                    V &amp;&amp; &amp;&amp; X
                    }
            %p
              such that the
              %a.existingWikiWord{:href => "/nlab/show/correspondence"} correspondence
              of
              %a.existingWikiWord{:href => "/nlab/show/frame+bundles"} frame bundles
              induced via remark
              %a.maruku-ref{:href => "#FrameBundlesFunctorial"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi τ
                              %mi U
                        %mtr
                          %mtd
                          %mtd
                            %mo ↙
                          %mtd
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                            %msub
                              %mi τ
                              %mi V
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi τ
                              %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; \tau_U
                    \\\
                    \&amp; \swarrow &amp;&amp; \searrow
                    \\\
                    \\tau_V &amp;&amp; &amp;&amp; \tau_X
                    }
            %p
              (a diagram in
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mrow
                          %mo{:stretchy => "false"} /
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi GL
                          %mo{:stretchy => "false"} (
                          %mi V
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}_{/\mathbf{B}GL(V)}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                  %annotation{:encoding => "application/x-tex"} \mathbf{c}
              and the trivial
              = succeed "-structure" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi c
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \mathbf{c}_0
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              = succeed "," do
                %a.maruku-ref{:href => "#TrivialGStructure"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi GL
                        %mo{:stretchy => "false"} (
                        %mi V
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}_{/\mathbf{B}GL(V)}
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi τ
                              %mi U
                        %mtr
                          %mtd
                          %mtd
                            %mo ↙
                          %mtd
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                            %msub
                              %mi τ
                              %mi V
                          %mtd
                          %mtd
                            %msub
                              %mo ⇙
                              %mpadded{:width => "0"}
                                %mo ≃
                          %mtd
                          %mtd
                            %msub
                              %mi τ
                              %mi X
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mstyle{:mathvariant => "bold"}
                                      %mi c
                                    %mn 0
                            %mo ↘
                          %mtd
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mstyle{:mathvariant => "bold"}
                                  %mi c
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi G
                            %mstyle{:mathvariant => "bold"}
                              %mi Struct
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; \tau_U
                    \\\
                    \&amp; \swarrow &amp;&amp; \searrow
                    \\\
                    \\tau_V &amp;&amp; \swArrow_{\mathrlap{\simeq}}  &amp;&amp; \tau_X
                    \\\
                    \&amp; {}_{\mathllap{\mathbf{c}_0}}\searrow &amp;&amp; \swarrow_{\mathrlap{\mathbf{c}}}
                    \\\
                    \&amp;&amp; G\mathbf{Struct}
                    }
            %p
              On the other hand,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                  %annotation{:encoding => "application/x-tex"} \mathbf{c}
              is called
              %em infinitesimally integrable
              (or
              = succeed ")" do
                %em torsion-free
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+disks"} infinitesimal disks
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              %a.existingWikiWord{:href => "/nlab/show/counit+of+a+comonad"} counit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ♭
                      %mi rel
                    %mi U
                    %mo ⟶
                    %mi U
                  %annotation{:encoding => "application/x-tex"}
                    \\flat^{rel} U \longrightarrow U
            %p
              of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/relative+flat+modality"} relative flat modality
              %a.maruku-ref{:href => "#InducedRelativeShapeAndFlat"}
              (using that by prop.
              %a.maruku-ref{:href => "#CounitOfFlatRelIsFormallyEtale"}
              this is also formally étale and hence induces map of frame bundles):
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi τ
                              %mrow
                                %msup
                                  %mo ♭
                                  %mi rel
                                %mi U
                        %mtr
                          %mtd
                          %mtd
                            %mo ↙
                          %mtd
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                            %msub
                              %mi τ
                              %mi V
                          %mtd
                          %mtd
                            %msub
                              %mo ⇙
                              %mpadded{:width => "0"}
                                %mo ≃
                          %mtd
                          %mtd
                            %msub
                              %mi τ
                              %mi X
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mstyle{:mathvariant => "bold"}
                                      %mi c
                                    %mn 0
                            %mo ↘
                          %mtd
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mstyle{:mathvariant => "bold"}
                                  %mi c
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi G
                            %mstyle{:mathvariant => "bold"}
                              %mi Struct
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; \tau_{\flat^{rel} U}
                    \\\
                    \&amp; \swarrow &amp;&amp; \searrow
                    \\\
                    \\tau_V &amp;&amp; \swArrow_{\mathrlap{\simeq}}  &amp;&amp; \tau_X
                    \\\
                    \&amp; {}_{\mathllap{\mathbf{c}_0}}\searrow &amp;&amp; \swarrow_{\mathrlap{\mathbf{c}}}
                    \\\
                    \&amp;&amp; G\mathbf{Struct}
                    }
                    \\,.
          .num_remark
            %h6#remark_22 Remark
            %p
              As before, if the given
              %a.existingWikiWord{:href => "/nlab/show/reduction+modality"} reduction modality
              encodes order-
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              infinitesimals, then the infinitesimal integrability in def.
              %a.maruku-ref{:href => "#IntegrableGStructure"}
              is order-
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              integrability. For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} k = 1
              this is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/torsion+of+a+G-structure"} torsion-freeness
          %h4#StrucInfinitesimalLocalSystem
            Flat
            = succeed "-connections" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            We discuss the
            %a{:href => "http://nlab.mathforge.org/nlab/show/cohesive%20(infinity,1)-topos#FlatDifferentialCohomology"} intrinsic flat cohomology
            in an infinitesimal neighbourhood.
          #InfinitesimalFlatCohomology.num_defn
            %h6#definition_23 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi A
                    %mo ∈
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi th
                  %annotation{:encoding => "application/x-tex"} X, A \in \mathbf{H}_{th}
              we say that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi infflat
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %msub
                      %mi π
                      %mn 0
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mi ℑ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi π
                      %mn 0
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mo ♭
                      %mi inf
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    H_{infflat}(X,A) := \pi_0 \mathbf{H}(\Im(X), A)
                    \\simeq
                    \\pi_0 \mathbf{H}(X, \mathbf{\flat}_{inf}A)
            %p
              (where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ℑ
                    %mo ⊣
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mo ♭
                      %mi inf
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\Im \dashv \mathbf{\flat}_{inf})
              is given by def.
              = succeed ")" do
                %a.maruku-ref{:href => "#InfinitesimalPathsAndReduction"}
              %strong infinitesimal flat cohomology
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with coefficient in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
          #CrystallineCohomology.num_note
            %h6#note Note
            %p
              In traditional contexts this is also called
              %em
                %a.existingWikiWord{:href => "/nlab/show/crystalline+cohomology"} crystalline cohomology
              or just
              %em
                %a.existingWikiWord{:href => "/nlab/show/de+Rham+cohomology"} de Rham cohomology
              \. Since we already have an
              %a{:href => "http://nlab.mathforge.org/nlab/show/cohesive+%28infinity%2C1%29-topos#deRhamCohomology"} intrinsic notion of de Rham cohomology
              in any
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
              %strong
                %a.existingWikiWord{:href => "/nlab/show/synthetic+differential+geometry"} synthetic
                de Rham cohomology
              for the notion of def.
              %a.maruku-ref{:href => "#InfinitesimalFlatCohomology"}
              if we wish to honor traditional terminology. In this case we shall write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mrow
                        %mi dR
                        %mo ,
                        %mi synth
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %msub
                      %mi π
                      %mn 0
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi th
                    %mo{:stretchy => "false"} (
                    %mi ℑ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H_{dR,synth}(X,A)
                    \:=
                    \\pi_0 \mathbf{H}_{th}(\Im(X), A)
                    \\,.
          #FiniteAndInfinitesimalFlatConnections.num_note
            %h6#note_2 Note
            %p
              By the
              %a{:href => "#InclusionOfConstantIntoInfinitesimalIntoAllPaths"} above observation
              we have canonical morphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi flat
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi infflat
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{H}_{flat}(X,A)
                    \\to
                    \\mathbf{H}_{infflat}(X,A)
                    \\to
                    \\mathbf{H}(X,A)
            %p
              The objects on the left are
              %strong
                %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"}> principal ∞-bundle
                s equipped with flat
                %a.existingWikiWord{:href => "/nlab/show/connection+on+an+%E2%88%9E-bundle"} ∞-connection
              \. The first morphism forgets their
              %a.existingWikiWord{:href => "/nlab/show/higher+parallel+transport"} higher parallel transport
              along finite volumes and just remembers the parallel transport along infinitesimal volumes. The last morphism finally forgets also this connection information.
          #deRhamTheorem.num_defn
            %h6#definition_24 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi th
                  %annotation{:encoding => "application/x-tex"} A \in \mathbf{H}_{th}
              an abelian
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
              object we say that the
              %strong
                %a.existingWikiWord{:href => "/nlab/show/de+Rham+theorem"} de Rham theorem
              for
              = succeed "-coefficients" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi th
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}_{th}
              if for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi th
                  %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}_{th}
              the
              %a{:href => "#InclusionOfConstantIntoInfinitesimalIntoAllPaths"} infinitesimal path inclusion
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℑ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Im(X) \to \mathbf{\Pi}(X)
            %p
              is an equivalence in
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              we have that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi th
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi π
                      %mn 0
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi th
                    %mo{:stretchy => "false"} (
                    %mi ℑ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_0 \mathbf{H}_{th}(\mathbf{\Pi}(X), \mathbf{B}^n A)
                    \\to
                    
                    \\pi_0 \mathbf{H}_{th}(\Im(X), \mathbf{B}^n A)
            %p
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
          %p
            If we follow the notation of note
            %a.maruku-ref{:href => "#CrystallineCohomology"}
            and moreover write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mi X
                  %mo{:stretchy => "false"} |
                  %mo =
                  %mo{:stretchy => "false"} |
                  %mi Π
                  %mi X
                  %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} \vert X \vert = \vert \Pi X \vert
            for the
            = succeed "," do
              %a{:href => "http://nlab.mathforge.org/nlab/show/cohesive+%28infinity%2C1%29-topos#GeometricRealization"} intrinsic geometric realization
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi H
                    %mrow
                      %mi dR
                      %mo ,
                      %mi synth
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msup
                    %mi H
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} |
                  %mi X
                  %mo{:stretchy => "false"} |
                  %mo ,
                  %msub
                    %mi A
                    %mi disc
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  H^{\bullet}_{dR, synth}(X,A) \simeq H^\bullet(|X|, A_{disc})
                  \\,,
          %p
            where on the right we have ordinary cohomology in
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            (for instance realized as
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/singular+cohomology"} singular cohomology
            %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mi disc
                  %mo :
                  %mo =
                  %mi Γ
                  %mi A
                %annotation{:encoding => "application/x-tex"} A_{disc} := \Gamma A
            underlying the cohesive group
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %p
            In certain contexts of infinitesimal neighbourhoods of cohesive
            = succeed "-toposes" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed ")." do
              %a{:href => "#SimpsonTeleman"} SimpsonTeleman
          %h4#FormalInfinityGroupoids
            Formal cohesive
            = succeed "-groupoids" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            Recall that a
            %a.existingWikiWord{:href => "/nlab/show/groupoid+object+in+an+%28infinity%2C1%29-category"} groupoid object in an (infinity,1)-category
            is equivalently an
            %a.existingWikiWord{:href => "/nlab/show/1-epimorphism"} 1-epimorphism
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⟶
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} X \longrightarrow \mathcal{G}
            %a.existingWikiWord{:href => "/nlab/show/atlas"} atlas
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            for the groupoid
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
          %p
            Now an
            = succeed "-Lie" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-groupoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            A groupoid object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo ⟶
                  %mi 𝒢
                %annotation{:encoding => "application/x-tex"} p \colon X \longrightarrow \mathcal{G}
            is
            %em infinitesimal
            if under the
            %a.existingWikiWord{:href => "/nlab/show/reduction+modality"} reduction modality
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℜ
                %annotation{:encoding => "application/x-tex"} \Re
            (equivalently under the
            %a.existingWikiWord{:href => "/nlab/show/infinitesimal+shape+modality"} infinitesimal shape modality
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℑ
                  %annotation{:encoding => "application/x-tex"} \Im
            %a.existingWikiWord{:href => "/nlab/show/atlas"} atlas
            becomes an
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/equivalence+in+an+%28infinity%2C1%29-category"} equivalence
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℜ
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi ℑ
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi Equiv
                  %annotation{:encoding => "application/x-tex"} \Re(p), \Im(p) \in Equiv
          %p
            For example the tangent
            = succeed "-Lie" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mi X
                %annotation{:encoding => "application/x-tex"} T X
            of any
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is the
            %a.existingWikiWord{:href => "/nlab/show/unit+of+a+monad"} unit
            of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+shape+modality"} infinitesimal shape modality
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi η
                    %mi X
                    %mi ℑ
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi X
                  %mover
                    %mo ⟶
                    %mrow
                  %mi ℑ
                  %mi X
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\eta^{\Im}_X \;\colon\; X \stackrel{}{\longrightarrow} \Im X
                  \\,.
          %p
            It follows that every such
            = succeed "-Lie" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mi 𝒢
                %annotation{:encoding => "application/x-tex"} X \to \mathcal{G}
            canonically maps to the tangent
            = succeed "-Lie" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            – the
            = succeed "." do
              %em anchor map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi η
                    %mi p
                    %mi ℑ
                %annotation{:encoding => "application/x-tex"} \eta^{\Im}_{p}
            exhibits the morphism:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %mover
                            %mo ⟶
                            %mi id
                        %mtd
                          %mi X
                      %mtr
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi p
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %msubsup
                                  %mi η
                                  %mi X
                                  %mi ℑ
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi ℑ
                          %mi X
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %msubsup
                            %mo{:stretchy => "false"} ↓
                            %mo ≃
                            %mpadded{:width => "0"}
                              %mrow
                                %mi ℑ
                                %mi p
                      %mtr
                        %mtd
                          %mi 𝒢
                        %mtd
                          %mover
                            %mo ⟶
                            %mrow
                              %msubsup
                                %mi η
                                %mi 𝒢
                                %mi ℑ
                        %mtd
                          %mi ℑ
                          %mi 𝒢
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X &amp; \stackrel{id}{\longrightarrow} &amp; X
                  \\\
                  \\downarrow^{\mathrlap{p}} &amp;&amp; \downarrow^{\mathrlap{\eta^\Im_X}}
                  \\\
                  \&amp;&amp;  \Im X
                  \\\
                  \\downarrow &amp;&amp; \downarrow^{\mathrlap{\Im p}}_\simeq
                  \\\
                  \\mathcal{G}
                  \&amp;\stackrel{\eta^{\Im}_{\mathcal{G}}}{\longrightarrow}&amp; \Im \mathcal{G}
                  }
          %h4#LieTheory Lie theory
          %p (…)
          %p
            The discussion at
            %em
              %a{:href => "synthetic+differential+infinity-groupoid#LieDifferentiation"} synthetic differential ∞-groupoid – Lie differentiation
            immediately generalizes to produce a concept of Lie differentiation in any differentially cohesive context. This Lie differentiation is just the flat modality of the differential cohesion but regarded as cohesive over its induced
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+cohesion"} infinitesimal cohesion
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/geometric+%E2%88%9E-stacks"} geometric ∞-stacks
            = succeed "-stacks" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-algebras," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
            %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
            of these lang indeed in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/geometric+%E2%88%9E-stacks"} geometric ∞-stacks
          %p (…)
          %h4#StrucDeformationTheory Deformation theory
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mi op
                %annotation{:encoding => "application/x-tex"} C^{op}
            any
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-site"} (∞,1)-site
            the construction of the
            %a.existingWikiWord{:href => "/nlab/show/tangent+%28%E2%88%9E%2C1%29-category"} tangent (∞,1)-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mi C
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} T_{C} \to C
            provides a canonical infinitesimal thickening of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mover
                    %mover
                      %munder
                        %mo ←
                        %mi dom
                      %mover
                        %mo →
                        %mi Δ
                    %mover
                      %mo ←
                      %mi cod
                  %msup
                    %mi C
                    %mrow
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                  %mover
                    %munder
                      %mo ←
                      %mrow
                        %msup
                          %mi Ω
                          %mn ∞
                    %mover
                      %mo →
                      %mi L
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  C
                  \\stackrel{\overset{cod}{\leftarrow}}{\stackrel{\overset{\Delta}{\to}}{\underset{dom}{\leftarrow}}}
                  C^{\Delta[1]}
                  \\stackrel{\overset{L}{\to}}{\underset{\Omega^\infty}{\leftarrow}}
                  \\,,
          %p
            where the
            = succeed "-functor" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi cod
                  %annotation{:encoding => "application/x-tex"} cod
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/relative+%28%E2%88%9E%2C1%29-adjunction"} relative (∞,1)-adjunction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo ∘
                  %mi i
