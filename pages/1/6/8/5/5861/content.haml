                                %mo !
                          %mover
                            %mo ↪
                            %mrow
                              %msub
                                %mi i
                                %mo *
                        %mover
                          %mo ←
                          %mrow
                            %msup
                              %mi i
                              %mo *
                      %mover
                        %mo ↪
                        %mrow
                          %msub
                            %mi i
                            %mo !
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi th
                  %annotation{:encoding => "application/x-tex"}
                    (i_! \dashv i^* \dashv i_* \dashv i^!) :
                    \\mathbf{H}
                    \\stackrel{\overset{i_!}{\hookrightarrow}}{\stackrel{\overset{i^*}{\leftarrow}}{\stackrel{\overset{i_*}{\hookrightarrow}}{\underset{i^!}{\leftarrow}}}}
                    \\mathbf{H}_{th}
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mo !
                  %annotation{:encoding => "application/x-tex"} i_!
              is a
              %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+%28%E2%88%9E%2C1%29-functor"} full and faithful
              and preserves
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/finite+products"} finite products
            %p
              Conversely we will say that data as in def.
              %a.maruku-ref{:href => "#InfinitesimalCohesiveInfTopos"}
              equips the cohesive
              = succeed "-topos" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
