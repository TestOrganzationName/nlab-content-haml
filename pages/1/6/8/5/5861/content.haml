            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} \Omega^\infty
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-sites"} (∞,1)-sites
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mi op
                  %mover
                    %munder
                      %mo ←
                      %mi cod
                    %mover
                      %mo ↪
                      %mi i
                  %mo{:stretchy => "false"} (
                  %msub
                    %mover
                      %mi T
                      %mo{:stretchy => "false"} ˜
                    %mi C
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  C^{op}
                  \\stackrel{\overset{i}{\hookrightarrow}}{\underset{cod}{\leftarrow}}
                  (\tilde T_C)^{op}
                  \\,.
          %p (…)
          %h4#idelic_structure Idelic structure
          %p
            See at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/differential+cohesion+and+idelic+structure"} differential cohesion and idelic structure
          %h2#examples Examples
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/formal+smooth+%E2%88%9E-groupoid"} formal smooth ∞-groupoid
            %li
              %a.existingWikiWord{:href => "/nlab/show/infinitesimally+thickened+Sierpinski+topos"} infinitesimally thickened Sierpinski topos
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+cohesive+%28infinity%2C1%29-topos"} infinitesimal cohesive (infinity,1)-topos
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/differential+homotopy+type+theory"} differential homotopy type theory
          %div
            %p
              %strong
                %a.existingWikiWord{:href => "/nlab/show/cohesion"} cohesion
            %ul
              %li
                %p
                  (
                  %a.existingWikiWord{:href => "/nlab/show/shape+modality"} shape modality
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
