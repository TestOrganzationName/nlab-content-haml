          .proof
            %h6#proof_4 Proof
            %p
              From the fact that the
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+shape+modality"} infinitesimal shape modality
              is
              %a.existingWikiWord{:href => "/nlab/show/idempotent+monad"} idempotent
              and preserves
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+pullbacks"} homotopy pullbacks
          %h3#StructuresInDifferentialCohesion
            Structures in a differential cohesive
            = succeed "-topos" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
