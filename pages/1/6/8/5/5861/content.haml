            %p
              (as discussed at
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/models+for+%E2%88%9E-stack+%28%E2%88%9E%2C1%29-toposes"} models for (∞,1)-sheaf (∞,1)-toposes
            %p
