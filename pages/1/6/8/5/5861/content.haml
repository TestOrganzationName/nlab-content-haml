            %p
              Moreover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mo *
                  %annotation{:encoding => "application/x-tex"} i_*
              is necessarily a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+%28%E2%88%9E%2C1%29-functor"} full and faithful (∞,1)-functor
          .proof
            %h6#proof_2 Proof
            %p
              By essential uniqueness of th
              %a.existingWikiWord{:href => "/nlab/show/global+section"} global section
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
              %a.existingWikiWord{:href => "/nlab/show/direct+image"} direct image
              functor has as
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              that preserves the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi Γ
                              %mrow
                                %msub
                                  %mstyle{:mathvariant => "bold"}
                                    %mi H
                                  %mi th
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi i
                              %mo *
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                              %mi th
                            %mo{:stretchy => "false"} (
                            %mo *
                            %mo ,
                            %msub
                              %mi i
                              %mo *
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi i
                              %mo *
                            %mo *
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
                            %mo *
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mtr
