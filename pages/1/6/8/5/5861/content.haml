                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              exhibits it as an
              %a{:href => "#InfinitesimalNeighbourhoodIsOverInfGroupoid"} infinitesimal neighbourhood
              of the cohesive
              = succeed "-topos" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
