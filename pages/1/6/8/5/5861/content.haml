                  %annotation{:encoding => "application/x-tex"} \mathcal{O}_{X}(A)
              behaves as the
              = succeed "." do
                %em
                  sheaf of
                  = succeed "-valued" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
