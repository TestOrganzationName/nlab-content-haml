                              %mstyle{:mathvariant => "bold"}
                                %mi H
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\Gamma_{\mathbf{H}_{th}}( i_* X )
                    \&amp;
                    \\simeq
                    \\mathbf{H}_{th}(*, i_* X)
                    \\\
                    \&amp; \simeq \mathbf{H}(i^* *, X)
                    \\\
                    \&amp;
                    \\simeq \mathbf{H}(*, X)
                    \\\
                    \&amp; \simeq \Gamma_{\mathbf{H}}(X)
                    \\end{aligned}
                    \\,.
            %p Analogously in the second case.
          %p We shall write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Π
                    %mi inf
                  %mo ⊣
                  %msub
                    %mi Disc
                    %mi inf
                  %mo ⊣
                  %msub
                    %mi Γ
                    %mi inf
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi i
                    %mo *
                  %mo ⊣
                  %msub
                    %mi i
                    %mo *
                  %mo ⊣
                  %msup
                    %mi i
                    %mo !
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  (\Pi_{inf} \dashv Disc_{inf} \dashv \Gamma_{inf})
                  \:=
                  (i^* \dashv i_* \dashv i^!)
          %p
            so that the
            %a.existingWikiWord{:href => "/nlab/show/global+section"} global section
            geometric moprhism of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mi th
                %annotation{:encoding => "application/x-tex"} \mathbf{H}_{th}
            factors as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Π
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mi th
                  %mo ⊣
                  %msub
                    %mi Disc
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mi th
                  %mo ⊣
                  %msub
                    %mi Γ
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mi th
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mi th
                  %mover
                    %mover
                      %munder
                        %mo ⟶
                        %mrow
                          %msub
                            %mi Γ
                            %mi inf
                      %mover
                        %mo ←
                        %mrow
                          %msub
                            %mi Disc
                            %mi inf
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi Π
                          %mi inf
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mover
                    %mover
                      %munder
                        %mo ⟶
                        %mrow
                          %msub
                            %mi Γ
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                      %mover
                        %mo ⟵
                        %mrow
                          %msub
                            %mi Disc
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi Π
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                  %mn ∞
                  %mi Grpd
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (\Pi_{\mathbf{H}_{th}} \dashv Disc_{\mathbf{H}_{th}} \dashv \Gamma_{\mathbf{H}_{th}})
                  \:
                  \\mathbf{H}_{th}
                  \\stackrel{\overset{\Pi_{inf}}{\longrightarrow}}{\stackrel{\overset{Disc_{inf}}{\leftarrow}}{\underset{\Gamma_{inf}}{\longrightarrow}}}
                  \\mathbf{H}
                  \\stackrel{\overset{\Pi_{\mathbf{H}}}{\longrightarrow}}{\stackrel{\overset{Disc_{\mathbf{H}}}{\longleftarrow}}{\underset{\Gamma_{\mathbf{H}}}{\longrightarrow}}}
                  \\infty Grpd
                  \\,.
          %p
            We also consider the
            = succeed "/comonads" do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-monads"} (∞,1)-monads
          %ol
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/reduction+modality"} reduction modality
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℜ
                      %mo ≔
                      %msub
                        %mi i
                        %mo !
                      %msup
                        %mi i
                        %mo *
                    %annotation{:encoding => "application/x-tex"} \Re \coloneqq i_! i^\ast
                ;
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+shape+modality"} infinitesimal shape modality
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℑ
                        %mo ≔
                        %msub
                          %mi i
                          %mo *
                        %msup
                          %mi i
                          %mo *
                      %annotation{:encoding => "application/x-tex"} \Im \coloneqq i_\ast i^\ast
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+flat+modality"} infinitesimal flat modality
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi &amp;
                        %mo ≔
                        %msub
                          %mi i
                          %mo *
                        %msup
                          %mi i
                          %mo !
                      %annotation{:encoding => "application/x-tex"} {\&amp;}  \coloneqq i_* i^!
          %p The above says that these interact with the modalities of the ambient cohesion, i.e.
          %ol
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/shape+modality"} shape modality
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ʃ
                      %annotation{:encoding => "application/x-tex"} &amp;#643;
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/flat+modality"} flat modality
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ♭
                      %annotation{:encoding => "application/x-tex"} \flat
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/sharp+modality"} sharp modality
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ♯
                    %annotation{:encoding => "application/x-tex"} \sharp
          %p as follows:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mi ℜ
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mo ⊥
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi ʃ
                        %mtd
                          %mo ⊂
                        %mtd
                          %mi ℑ
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mo ⊥
                        %mtd
                        %mtd
                          %mo ⊥
                      %mtr
                        %mtd
                          %mi ∅
                        %mtd
                          %mo ⊂
                        %mtd
                          %mo ♭
                        %mtd
                          %mo ⊂
                        %mtd
                          %mi &amp;
                      %mtr
                        %mtd
                          %mo ⊥
                        %mtd
                        %mtd
                          %mo ⊥
                        %mtd
                        %mtd
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                          %mo ⊂
                        %mtd
                          %mo ♯
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; &amp;&amp; \Re
                  \\\
                  \&amp;&amp; &amp;&amp; \bot
                  \\\
                  \&amp;&amp; &amp;#643; &amp; \subset &amp; \Im
                  \\\
                  \&amp;&amp; \bot &amp;&amp; \bot
                  \\\
                  \\emptyset &amp;\subset&amp; \flat &amp; \subset &amp; {\&amp;}
                  \\\
                  \\bot &amp; &amp; \bot &amp;&amp;
                  \\\
                  \\ast &amp; \subset&amp; \sharp
                  }
          %p
            Here the inclusion sign
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊂
                %annotation{:encoding => "application/x-tex"} \subset
            is to mean that the
            %a.existingWikiWord{:href => "/nlab/show/modal+types"} modal types
            of the modality on the left are included in the modal types of the modality on the right.
          %p
            For more details on this, see at
            %em
              %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+categories+and+toposes"} geometry of physics – categories and toposes
            the section
            = succeed "." do
              %em
                %a{:href => "geometry+of+physics+--+categories+and+toposes#ElasticToposes"} Elastic toposes
          %p
            Let for the remainder of this section an infinitesimal neighbourhood
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo ↪
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mi th
                %annotation{:encoding => "application/x-tex"} \mathbf{H} \hookrightarrow \mathbf{H}_{th}
            be fixed.
          #SequenceOfOrdersOfInfinitesimals.num_remark
            %h6#remark_4 Remark
            %p
              More generally we may ask for a sequence of differential inclusions of
              = succeed "-toposes" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ʃ
                    %mo &lt;
                    %mi ℑ
                    %mo =
                    %msub
                      %mi ℑ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo{:stretchy => "false"} )
                    %mo &lt;
                    %mi ⋯
                    %mo &lt;
                    %msub
                      %mi ℑ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 3
                        %mo{:stretchy => "false"} )
                    %mo &lt;
                    %msub
                      %mi ℑ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo{:stretchy => "false"} )
                    %mo &lt;
                    %msub
                      %mi ℑ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo &lt;
                    %mi id
                  %annotation{:encoding => "application/x-tex"}
                    \&amp;#643;
                    \\lt
                    \\Im
                    \=
                    \\Im_{(\infty)}
                    \\lt
                    \\cdots
                    \\lt
                    \\Im_{(3)}
                    \\lt
                    \\Im_{(2)}
                    \\lt
                    \\Im_{(1)}
                    \\lt
                    id
            %p
              of
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+shape+modalities"} infinitesimal shape modalities
              of various order, yielding a further factorization of the shape unit as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %msub
                      %mi ℑ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mi X
                    %mo →
                    %msub
                      %mi ℑ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo{:stretchy => "false"} )
                    %mi X
                    %mo →
                    %msub
                      %mi ℑ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 3
                        %mo{:stretchy => "false"} )
                    %mi X
                    %mo →
                    %mi ⋯
                    %mo →
                    %mi ℑ
                    %mi X
                    %mo →
                    %mi ʃ
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    X \to \Im_{(1)}X \to \Im_{(2)}X
                    \\to \Im_{(3)} X  \to \cdots \to \Im X \to &amp;#643; X
                    \\,.
          %h3#Properties Properties
          %h4#PresentationOnInfinitesimalNeighbourhoodSites
            From
            = succeed "-sheaves" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            We give a presentation of classes of infinitesimal neighbourhoods by
            %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaves"} simplicial presheaves
            on suitable
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/sites"} sites
          #InfinitesimalNeighBourhoodSite.num_defn
            %h6#definition_3 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              be an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-cohesive+site"} ∞-cohesive site
              %a.existingWikiWord{:href => "/nlab/show/site"} site
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mi th
                  %annotation{:encoding => "application/x-tex"} C_{th}
            %ul
              %li
                %p
                  equipped with a
                  %a.existingWikiWord{:href => "/nlab/show/coreflective+subcategory"} coreflective embedding
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo ⊣
                        %mi p
                        %mo{:stretchy => "false"} )
                        %mo :
                        %mi C
                        %mover
                          %munder
                            %mo ←
                            %mi p
                          %mover
                            %mo ↪
                            %mi i
                        %msub
                          %mi C
                          %mi th
                      %annotation{:encoding => "application/x-tex"}
                        (i \dashv p) :
                        C \stackrel{\overset{i}{\hookrightarrow}}{\underset{p}{\leftarrow}}
                        C_{th}
              %li
                %p such that
                %ul
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi i
                          %annotation{:encoding => "application/x-tex"} i
                      preserves finite products
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi i
                          %annotation{:encoding => "application/x-tex"} i
                      preserves
                      %a.existingWikiWord{:href => "/nlab/show/pullbacks"} pullbacks
                      along morphisms in
                      %a.existingWikiWord{:href => "/nlab/show/covering"} covering
                      families;
                  %li
                    %p
                      both
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi i
                          %annotation{:encoding => "application/x-tex"} i
                      and
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi p
                          %annotation{:encoding => "application/x-tex"} p
                      send
                      %a.existingWikiWord{:href => "/nlab/show/covering"} covering
                      families to covering families;
                  %li
                    %p
                      for all
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mstyle{:mathvariant => "bold"}
                              %mi U
                          %annotation{:encoding => "application/x-tex"} \mathbf{U}
                      in
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi C
                              %mi th
                          %annotation{:encoding => "application/x-tex"} C_{th}
                      and covering families
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} {
                            %msub
                              %mi U
                              %mi i
                            %mo →
                            %mi p
                            %mo{:stretchy => "false"} (
                            %mstyle{:mathvariant => "bold"}
                              %mi U
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} }
                          %annotation{:encoding => "application/x-tex"} \{U_i \to p(\mathbf{U})\}
                      there is a lift through
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi p
                          %annotation{:encoding => "application/x-tex"} p
                      to a covering family
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} {
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi U
                              %mi i
                            %mo →
                            %mstyle{:mathvariant => "bold"}
                              %mi U
                            %mo{:stretchy => "false"} }
                          %annotation{:encoding => "application/x-tex"} \{\mathbf{U}_i \to \mathbf{U}\}
            %p
              is an
              %strong infinitesimal neighbourhood site
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
