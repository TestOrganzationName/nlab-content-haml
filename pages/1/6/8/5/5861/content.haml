                          %mi A
                        %annotation{:encoding => "application/x-tex"} A
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
          #StructureSheafIsIndeedStructureSheaf.num_prop
            %h6#proposition_9 Proposition
            %p
              The functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒪
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}_X
              of def.
              %a.maruku-ref{:href => "#StructureSheafRestrictedToH"}
              is indeed an
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mi th
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}_{th}
              %a.existingWikiWord{:href => "/nlab/show/structure+sheaf"} structure sheaf
              in the sense of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/structured+%28%E2%88%9E%2C1%29-toposes"} structured (∞,1)-toposes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi th
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}_{th}
              regarded as a (large)
              %a.existingWikiWord{:href => "/nlab/show/geometry+%28for+structured+%28%E2%88%9E%2C1%29-toposes%29"} geometry (for structured (∞,1)-toposes)
              with the
              %a.existingWikiWord{:href => "/nlab/show/formally+%C3%A9tale+morphisms"} formally étale morphisms
              being the “admissible morphisms”.
          %p
            This is the analog of (
            %a.existingWikiWord{:href => "/nlab/show/Structured+Spaces"}> Lurie, Structured Spaces, prop. 2.2.11
            ).
          .proof
            %h6#proof_13 Proof
            %p
              We need to check that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒪
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}_{X}
              preserves
              %a.existingWikiWord{:href => "/nlab/show/finite+%28%E2%88%9E%2C1%29-limits"} finite (∞,1)-limits
              and
              %a.existingWikiWord{:href => "/nlab/show/formally+%C3%A9tale+morphism"} formally étale
              %a.existingWikiWord{:href => "/nlab/show/covers"} covers
              (where covers here in the
              %a.existingWikiWord{:href => "/nlab/show/canonical+topology"} canonical topology
              on the given toposes are
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/1-epimorphisms"} 1-epimorphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒪
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}_{X}
              is
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              to the forgetful functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Sh
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi th
                    %msubsup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi X
                      %mi fet
                    %mo ↪
                    %mo{:stretchy => "false"} (
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi th
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi X
                    %mover
                      %mo →
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mi X
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi th
                  %annotation{:encoding => "application/x-tex"}
                    Sh_{\mathbf{H}}(X)
                    \\simeq
                    (\mathbf{H}_{th})_{/X}^{fet}
                    \\hookrightarrow
                    (\mathbf{H}_{th})_{/X}
                    \\stackrel{\underset{X}{\sum}}{\to}
                    \\mathbf{H}_{th}
            %p
              For the second statement, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %mover
                      %mi Y
                      %mo ^
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} p \colon \widehat Y \longrightarrow Y
              be any
              %a.existingWikiWord{:href => "/nlab/show/1-epimorphism"} 1-epimorphism
              which is also a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/formally+%C3%A9tale+morphism"} formally étale
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Et
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Et(X \times p)
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/1-epimorphism"} 1-epimorphism
              %a.existingWikiWord{:href => "/nlab/show/effective+epimorphism+in+an+%28%E2%88%9E%2C1%29-category"} effective epimorphism in an (∞,1)-category
              for this it is sufficient that the
              %a.existingWikiWord{:href => "/nlab/show/0-truncated"} 0-truncation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mn 0
                    %mi Et
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tau_0 Et(X \times p)
              is an
              %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
              in the underlying
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
              %a.existingWikiWord{:href => "/nlab/show/generalized+element"} generalized element
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Et
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Et(X \times Y)
              has a lift to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Et
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mover
                      %mi Y
                      %mo ^
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Et(X \times \widehat{Y})
              after refinement along a cover.
            %p
              By the fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Et
                  %annotation{:encoding => "application/x-tex"} Et
              is
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              to the inclusion, by construction, this means that it is sufficient to show that given a
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi th
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}_{th}
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi X
                            %mo ×
                            %mover
                              %mi Y
                              %mo ^
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi U
                          %mtd
                          %mtd
                            %mo ⟶
                          %mtd
                          %mtd
                            %mi X
                            %mo ×
                            %mi Y
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                          %mtd
                            %mo ↙
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; &amp;&amp; X \times \widehat{Y}
                    \\\
                    \&amp;&amp; &amp;&amp; \downarrow
                    \\\
                    U &amp;&amp; \longrightarrow &amp;&amp; X \times Y
                    \\\
                    \&amp; \searrow &amp;&amp; \swarrow
                    \\\
                    \&amp;&amp; X
                    }
            %p
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U \to X
              formally étale, this can be completed to a diagram of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mover
                              %mi U
                              %mo ^
                          %mtd
                          %mtd
                            %mo ⟶
                          %mtd
                          %mtd
                            %mi X
                            %mo ×
                            %mover
                              %mi Y
                              %mo ^
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                          %mtd
