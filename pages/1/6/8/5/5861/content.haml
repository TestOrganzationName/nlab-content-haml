                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "." do
              %a{:href => "#Structures"} structures in a general cohesive (∞,1)-topos
          %h4#InfinitesimalPaths Infinitesimal paths and de Rham spaces
          %p
            In the presence of
            %a{:href => "#InfinitesimalCohesiveInfTopos"} differential cohesion
            there is an infinitesimal analog of the
            = succeed "." do
              %a{:href => "#Paths"} geometric paths ∞-groupoids
          %h5#infinitesimal_path_groupoid
            Infinitesimal path
            = succeed "-groupoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          #InfinitesimalPathsAndReduction.num_defn
            %h6#definition_5 Definition
            %p
              Define the
              %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"} adjoint triple
              of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functor"} adjoint (∞,1)-functor
              %a.existingWikiWord{:href => "/nlab/show/adjoint+quadruple"} adjoint quadruple
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi i
                        %mo !
                      %mo ⊣
                      %msup
                        %mi i
                        %mo *
                      %mo ⊣
                      %msub
                        %mi i
                        %mo *
                      %mo ⊣
                      %msup
                        %mi i
                        %mo !
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (i_! \dashv i^* \dashv i_* \dashv i^!)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ℜ
                    %mo ⊣
                    %mi ℑ
                    %mo ⊣
                    %mi &amp;
                    %mo{:stretchy => "false"} )
                    %mo :
