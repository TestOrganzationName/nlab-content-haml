              happens to have an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-site"} (∞,1)-site
              of definition whose
              %a.existingWikiWord{:href => "/nlab/show/covers"} covers
              are (
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+pretopology"}> generated
              ) from
              %a.existingWikiWord{:href => "/nlab/show/formally+%C3%A9tale+morphisms"} formally étale morphisms
              (a small
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/geometry+%28for+structured+%28%E2%88%9E%2C1%29-toposes%29"} geometry (for structured (∞,1)-toposes)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
