                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                              %mi th
                          %mtd
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi i
