          #EtalePullbackOfFormalDiskBundleIsFormalDiskBundle.num_lemma
            %h6#lemma Lemma
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
