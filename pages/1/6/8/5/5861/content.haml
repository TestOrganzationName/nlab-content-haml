                    \\,.
          #CotangentBundle.num_example
            %h6#example_2 Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ∈
                    %mi Grp
                    %mo{:stretchy => "false"} (
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi th
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G \in Grp(\mathbf{H}_{th})
              be an
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
              and write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
