                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi th
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}_{th}
              (hence like an
              %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
              of
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi 𝒪
                              %mi X
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≔
                            %msub
                              %mi Sh
                              %mrow
                                %msub
                                  %mstyle{:mathvariant => "bold"}
                                    %mi H
                                  %mi th
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo ,
                            %msub
                              %mi 𝒪
                              %mi X
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≔
                            %msub
                              %mi Sh
                              %mrow
                                %msub
                                  %mstyle{:mathvariant => "bold"}
                                    %mi H
                                  %mi th
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo ,
                            %mi Et
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ×
                            %mi A
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mo{:stretchy => "false"} (
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                              %mi th
                            %msub
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mo{:stretchy => "false"} /
                                %mi X
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo ,
                            %mi X
                            %mo ×
                            %mi A
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                              %mi th
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mi A
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\mathcal{O}_{X}(A)(U)
                    \&amp; \coloneqq
                    Sh_{\mathbf{H}_{th}}(X)( U , \mathcal{O}_{X}(A) )
                    \\\
