                      %annotation{:encoding => "application/x-tex"} \flat \to \Im
                  is an
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ʃ
                          %mi rel
                      %annotation{:encoding => "application/x-tex"} &amp;#643;^{rel}
                  preserves the
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
          %p
            It follows that when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mo ♭
                    %mi rel
                %annotation{:encoding => "application/x-tex"} \flat^{rel}
            has a further
            %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mo ♯
                    %mi rel
                %annotation{:encoding => "application/x-tex"} \sharp^{rel}
            with equivalent
            %a.existingWikiWord{:href => "/nlab/show/modal+types"} modal types
            containing the
            = succeed "," do
