          .num_prop
            %h6#proposition_3 Proposition
            %p
              The relative shape and flat modalities of def.
              %a.maruku-ref{:href => "#InducedRelativeShapeAndFlat"}
            %ol
              %li
                %p
                  form an
                  %a.existingWikiWord{:href => "/nlab/show/adjoint+pair"} adjoint pair
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
