                      %mo{:stretchy => "false"} /
                      %mi f
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %msub
                      %mo{:stretchy => "false"} /
                      %mi X
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} /
                      %mi f
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{H}/_{Y} \simeq \mathbf{H}/_{f} \simeq (\mathbf{H}/_{X})/_f
                    \\,.
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is formally étale by assumption and since
              %a.existingWikiWord{:href => "/nlab/show/formally+%C3%A9tale+morphisms"} formally étale morphisms
              are closed under
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/composition"} composition
              %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Sh
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Sh
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo{:stretchy => "false"} /
                        %mi f
                    %annotation{:encoding => "application/x-tex"} Sh_{\mathbf{H}}(Y) \simeq (Sh_{\mathbf{H}}(X))/_f
            %p
              For the equivalence of structure sheaves it is sufficient to show for each
              %a.existingWikiWord{:href => "/nlab/show/coefficient"} coefficient
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi th
                  %annotation{:encoding => "application/x-tex"} A \in \mathbf{H}_{th}
              an equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒪
                      %mi Y
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi f
                      %mo *
                    %msub
                      %mi 𝒪
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{O}_Y(A) \simeq (f^\ast \mathcal{O}_X(A))
            %p
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Sh
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Sh_{\mathbf{H}}(Y)
              = succeed ")" do
                %a.maruku-ref{:href => "#TheStructureSheafOfX"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒪
                      %mi Y
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi Et
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ×
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}_Y(A) \coloneqq Et(A \times Y)
              and similarly for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒪
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}_X
              and since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Et
                  %annotation{:encoding => "application/x-tex"} Et
              is
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              to the inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Sh
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} Sh_{\mathbf{H}}(Y) \hookrightarrow \mathbf{H}_{Y}
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %msub
                      %mi 𝒪
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi f
                      %mo *
                    %mi Et
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ×
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Et
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ×
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Et
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ×
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi 𝒪
                      %mi Y
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f^\ast \mathcal{O}_X(A)
                    \=
                    f^\ast Et(A \times X)
                    \\simeq
                    Et(f^\ast(A \times X))
                    \\simeq
                    Et(A \times Y)
                    \=
                    \\mathcal{O}_Y(A)
                    \\,.
          %h4#SheavesOfModules Sheaves of (quasi-coherent) modules
          %p
            We discuss the abstract formulation of sheaves of
            %a.existingWikiWord{:href => "/nlab/show/modules"} modules
            and of
            %a.existingWikiWord{:href => "/nlab/show/quasicoherent+sheaves"} quasicoherent sheaves
            on petit
            = succeed "-toposes" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %blockquote
            %p under construction – check
          .num_defn
            %h6#definition_13 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi th
                  %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}_{th}
              an object and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Sh
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi 𝒪
                      %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Sh_{\mathbf{H}}(X), \mathcal{O}_X)
              its
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mi th
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}_{th}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/structured+%28infinity%2C1%29-topos"} structured (infinity,1)-topos
              = succeed "," do
                %a.maruku-ref{:href => "#TheStructureSheafOfX"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi 𝒪
                      %mi X
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mover
                      %mo ↪
                      %mrow
                        %msub
                          %mi i
                          %mo !
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi th
                    %mover
                      %mo ⟶
                      %mrow
                        %mi Et
                        %msup
                          %mi X
                          %mo *
                    %msub
                      %mi Sh
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{O}_X^{\mathbf{H}} \;\colon\; \mathbf{H} \stackrel{i_!}{\hookrightarrow} \mathbf{H}_{th} \stackrel{Et X^\ast}{\longrightarrow} Sh_{\mathbf{H}}(X)
                    \\,,
            %p
              then an
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒪
                        %mi X
                    %annotation{:encoding => "application/x-tex"} \mathcal{O}_X
                \-module
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℱ
                  %annotation{:encoding => "application/x-tex"} \mathcal{F}
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is an extension of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi 𝒪
                      %mi X
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}_X^{\mathbf{H}}
              by a limit-preserving functor through
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mo !
                  %annotation{:encoding => "application/x-tex"} i_!
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msubsup
                                  %mi 𝒪
                                  %mi X
                                  %mstyle{:mathvariant => "bold"}
                                    %mi H
                          %mtd
                            %msub
                              %mi Sh
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi i
                                    %mo !
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msub
                              %mo ↗
                              %mpadded{:width => "0"}
                                %mi ℱ
                        %mtr
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                              %mi th
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbf{H} &amp;\stackrel{\mathcal{O}_X^{\mathbf{H}}}{\longrightarrow}&amp; Sh_{\mathbf{H}}(X)
                    \\\
                    {}^{\mathllap{i_!}}\downarrow &amp; \nearrow_{\mathrlap{\mathcal{F}}}
                    \\\
                    \\mathbf{H}_{th}
                    }
                    \\,.
          .num_example
            %h6#example_3 Example
            %p
              In particular
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒪
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}_X
              is canonically a module over itself by setting
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℱ
                      %mo =
                      %msub
                        %mi 𝒪
                        %mi X
                    %annotation{:encoding => "application/x-tex"} \mathcal{F} = \mathcal{O}_X
          %p
            This is a slight abstraction of the definition in (
            %a{:href => "quasicoherent+sheaf#LurieQC"}> Lurie QC, section 2.3
            ). See at
            = succeed "." do
              %em
                %a{:href => "quasicoherent+sheaf#HigherGeometryAsExtensionsOfStructureSheaf"} quasicoherent sheaf – In higher geometry – As extension of the structure sheaf
          %h4#PoincareCocycle Liouville-Poincaré cocycle
          #TheLiouvillePoincareCocycle.num_defn
            %h6#definition_14 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi A
                    %mo ∈
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi th
                  %annotation{:encoding => "application/x-tex"} X,A \in \mathbf{H}_{th}
              and with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒪
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msub
                      %mi Sh
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}_X(A) \in Sh_{\mathbf{H}}(X)
              as in def.
              = succeed "," do
                %a.maruku-ref{:href => "#TheStructureSheafOfX"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi θ
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi X
                    %mi ι
                    %msub
                      %mi 𝒪
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    \\theta_X(A)
                    \\;\colon\;
                    \\underset{X}{\sum}
                    \\iota \mathcal{O}_X(A)
                    \\to
                    A
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              which is the
              = succeed "-adjunct" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mi X
                      %mo ⊣
                      %msup
                        %mi X
                        %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\underset{X}{\sum} \dashv X^*)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi X
                    %mi ι
                    %mi Et
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi X
                      %mo *
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \underset{X}{\sum}\iota Et(X^* A) \to A
              of the
              %a.existingWikiWord{:href => "/nlab/show/counit+of+a+comonad"} counit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ι
                    %mi Et
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi X
                      %mo *
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi X
                      %mo *
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \iota Et(X^* A) \to X^* A
              of the
              = succeed "-coreflection" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi ι
                      %mo ⊣
                      %mi Et
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\iota \dashv Et)
              = succeed "." do
                %a.maruku-ref{:href => "#TheStructureSheafOfX"}
            %p
              This
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi θ
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \theta_X(A)
              we call the
              %strong
                Liouville-Poincaré
                = succeed "-cocycle" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mi X
                      %mi ι
                      %msub
                        %mi 𝒪
                        %mi X
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \underset{X}{\sum} \iota \mathcal{O}_X(A)
          .num_example
            %h6#example_4 Example
            %p
              Consider the model of differential cohesion given by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi th
                    %mo =
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}_{th} =
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/SynthDiff%E2%88%9EGrpd"} SynthDiff∞Grpd
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mn 1
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mover
                      %mo ↪
                      %mrow
                        %msub
                          %mi i
                          %mo !
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi th
                  %annotation{:encoding => "application/x-tex"} \Omega^1 \in \mathbf{H }\stackrel{i_!}{\hookrightarrow} \mathbf{H}_{th}
              for the abstract
              %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/differential+1-forms"} differential 1-forms
            %p
              Then for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi SmthMfd
                    %mo ↪
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} X \in SmthMfd \hookrightarrow \mathbf{H}
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi X
                    %mi ι
                    %msub
                      %mi 𝒪
                      %mi X
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{X}{\sum} \iota \mathcal{O}_X(\Omega^1) \to X
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/cotangent+bundle"} cotangent bundle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi T
                      %mo *
                    %mi X
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    T^* X \to X
            %p
              of the manifold: because for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mi U
                    %mo{:lspace => "verythinmathspace"} :
                    %mi U
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} i_U \colon U \to X
              an open subset of the manifold regarded as an object of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Sh
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Sh_{\mathbf{H}}(X)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ι
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi σ
                      %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \iota(\sigma_U)
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi T
                      %mo *
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} |
                      %mi U
                    %mo →
                    %mi U
                  %annotation{:encoding => "application/x-tex"} T^* X|_U \to U
              is equivalently a map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi i
                      %mi U
                    %mo →
                    %msub
                      %mi 𝒪
                      %mi X
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sigma \colon i_U \to \mathcal{O}_X(\Omega^1)
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Sh
                        %mrow
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mi th
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Sh_{\mathbf{H}_{th}}(X)
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi ι
                      %mo ⊣
                      %mi Et
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\iota \dashv Et)
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
              is a map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ι
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi i
                      %mi U
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi X
                    %mo ×
                    %msup
                      %mi Ω
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \iota(i_U) \to X \times \Omega^1
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi th
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi X
                  %annotation{:encoding => "application/x-tex"} (\mathbf{H}_{th})_{/X}
              which finally is equivalently a map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo →
                    %msup
                      %mi Ω
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} U \to \Omega^1
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi th
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}_{th}
              hence an element in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Ω
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Omega^1(U)
            %p
              So the Liouville-Poincaré
              = succeed "-cocycle" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Ω
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \Omega^1
              %a.maruku-ref{:href => "#TheLiouvillePoincareCocycle"}
              is a
              %a.existingWikiWord{:href => "/nlab/show/differential+1-form"} differential 1-form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi X
                    %mi ι
                    %msub
                      %mi 𝒪
                      %mi X
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi Ω
                      %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\theta
                    \\;\colon\;
                    \\underset{X}{\sum}\iota \mathcal{O}_X(\Omega^1)
                    \\to
                    \\Omega^1
            %p on the total space of the cotangent bundle. For
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo →
                    %msub
                      %mi 𝒪
                      %mi X
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %msub
                      %mi Sh
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\sigma \;\colon\; X \to \mathcal{O}_X(\Omega^1)
                    \\;\;\;
                    \\in Sh_{\mathbf{H}}(X)
            %p
              a
              %a.existingWikiWord{:href => "/nlab/show/section"} section
              of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cotangent+bundle"} cotangent bundle
              %a.existingWikiWord{:href => "/nlab/show/pullback+of+a+differential+form"} pullback form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi σ
                      %mo *
                    %mi θ
                  %annotation{:encoding => "application/x-tex"} \sigma^* \theta
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is the composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi X
                    %mi ι
                    %mi X
                    %mover
                      %mo →
                      %mrow
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mi X
                        %mi ι
                        %mo{:stretchy => "false"} (
                        %mi σ
                        %mo{:stretchy => "false"} )
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi X
                    %mi ι
                    %msub
                      %mi 𝒪
                      %mi X
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mi θ
                    %msup
                      %mi Ω
                      %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{X}{\sum}\iota X \stackrel{\underset{X}{\sum}\iota(\sigma)}{\to} \underset{X}{\sum}\iota \mathcal{O}_X(\Omega^1) \stackrel{\theta}{\to} \Omega^1
                    \\,,
            %p
              hence the
              %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ι
                    %mi X
                    %mover
                      %mo →
                      %mrow
                        %mi ι
                        %mo{:stretchy => "false"} (
                        %mi σ
                        %mo{:stretchy => "false"} )
                    %mi ι
                    %msub
                      %mi 𝒪
                      %mi X
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                    %msup
                      %mi X
                      %mo *
                    %msup
                      %mi Ω
                      %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\iota X \stackrel{\iota(\sigma)}{\to} \iota \mathcal{O}_X(\Omega^1) \stackrel{}{\to} X^* \Omega^1
                    \\,,
            %p hence by definition
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ι
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %mi ι
                        %mo{:stretchy => "false"} (
                        %mi σ
                        %mo{:stretchy => "false"} )
                    %mi ι
                    %mo{:stretchy => "false"} (
                    %mi Et
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                    %msup
                      %mi X
                      %mo *
                    %msup
                      %mi Ω
                      %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\iota(X) \stackrel{\iota(\sigma)}{\to} \iota(Et(X \times \Omega^1)) \stackrel{}{\to} X^*\Omega^1
                    \\,,
            %p hence the adjunct
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mover
                      %mo →
                      %mi σ
                    %mi Et
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mi id
                    %mi Et
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    X \stackrel{\sigma}{\to} Et(X \times \Omega^1) \stackrel{id}{\to} Et(X \times \Omega^1)
            %p
              hence the original
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                    %annotation{:encoding => "application/x-tex"} \sigma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} that
                  %annotation{:encoding => "application/x-tex"} \that
              as the traditional
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Liouville-Poincar%C3%A9+1-form"} Liouville-Poincaré 1-form
          %h4#EtaleObjects Manifolds and étale groupoids
          %p
            An ordinary
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/topological+groupoid"} topological
            %a.existingWikiWord{:href => "/nlab/show/Lie+groupoid"} Lie
            %a.existingWikiWord{:href => "/nlab/show/%C3%A9tale+groupoid"} étale groupoid
            is one whose source/target map is an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%C3%A9tale+map"} étale map
          #FormalEtaleGroupoid.num_defn
            %h6#definition_15 Definition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/groupoid+object+in+an+%28%E2%88%9E%2C1%29-category"} groupoid object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒢
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}_\bullet
              is an
              %strong
                %a.existingWikiWord{:href => "/nlab/show/%C3%A9tale+%E2%88%9E-groupoid"} étale ∞-groupoid
              if the equivalent (via the higher
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Giraud+theorem"} Giraud theorem
              %a.existingWikiWord{:href => "/nlab/show/effective+epimorphism"} effective epimorphism
              (the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/atlas"} atlas
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒢
                      %mn 0
                    %mo ⟶
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}_0 \longrightarrow \mathcal{G}
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/formally+%C3%A9tale+morphism"} formally étale morphism
          %p
            Let now
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            be any object
          %p
            (For instance let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝔸
                    %mn 1
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbb{A}^1 \in \mathbf{H}
            be a canonical line object that exhibits the cohesion of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            in the sense of
            %em
              %a{:href => "cohesive+%28infinity%2C1%29-topos+--+structures#A1HomotopyContinuum"} structures in a differential infinity-topos – A1 homotopy / The continuum
            and take
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo =
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mi n
                    %msup
                      %mi 𝔸
                      %mi n
                  %annotation{:encoding => "application/x-tex"} V = \coprod_n \mathbb{A}^n
          #Manifold.num_defn
            %h6#definition_16 Definition
            %p
              A
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
                \-manifold
              is an object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              such that there exists a
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
                \-cover
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              %a.existingWikiWord{:href => "/nlab/show/correspondence"} correspondence
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi U
                        %mtr
                          %mtd
                          %mtd
                            %mo ↙
                          %mtd
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                            %mi V
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; U
                    \\\
                    \&amp; \swarrow &amp;&amp; \searrow
                    \\\
                    V &amp;&amp; &amp;&amp; X
                    }
            %p
              such that both morphisms are
              %a.existingWikiWord{:href => "/nlab/show/formally+%C3%A9tale+morphisms"} formally étale morphisms
              and such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U \to X
              is in addition an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/effective+epimorphism"} effective epimorphism
          %p
            See also at
            %em
              %a{:href => "smooth%20manifold#GeneralAbstractCharacterization"} smooth manifold – general abstract geometric formulation
          %h4#GLnTangentBundles Frame bundles
          %p
            We discuss how each manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            in differential cohesion as in def.
            %a.maruku-ref{:href => "#Manifold"}
            is associated a canonical
            %a.existingWikiWord{:href => "/nlab/show/frame+bundle"} frame bundle
            classified by a morphism
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \to \mathbf{B}GL(V)
          #FormalDiskBundle.num_defn
            %h6#definition_17 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              any object in differential cohesion, its
              %em
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+disk+bundle"} infinitesimal disk bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi inf
                    %mi X
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} T_{inf} X \to X
              is the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi T
                              %mi inf
                            %mi X
                          %mtd
                            %mover
                              %mo ⟶
                              %mi ev
                          %mtd
                            %mi X
                        %mtr
