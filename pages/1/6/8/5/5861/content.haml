              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/formally+%C3%A9tale+morphism"} formally étale morphism
              = succeed "," do
                %a.maruku-ref{:href => "#FormallyEtaleInHTh"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
