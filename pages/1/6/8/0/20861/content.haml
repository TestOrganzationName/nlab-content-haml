                    \&amp;
                    %a{:href => "4T+relation#ForCircularChordDiagrams"} 4T relation
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/2T+relation"}> 2T
                    \&amp;
                    %a{:href => "4T+relation#ForHorizontalChordDiagrams"}> 4T relation
                    \/
                    %br/
                    %a.existingWikiWord{:href => "/nlab/show/infinitesimal+braid+relations"} infinitesimal braid relations
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/weight+system"} weight system
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/horizontal+weight+system"} horizontal weight system
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/Vassiliev+knot+invariant"} Vassiliev knot invariant
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/Vassiliev+braid+invariant"} Vassiliev braid invariant
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/weight+systems+are+associated+graded+of+Vassiliev+invariants"} weight systems are associated graded of Vassiliev invariants
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/horizontal+weight+systems+are+cohomology+of+loop+space+of+configuration+space"} horizontal weight systems are cohomology of loop space of configuration space
          %h2#references References
          %h3#general General
          %p Original articles
          %ul
            %li#BarNatan95
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dror+Bar-Natan"}> Dror Bar-Natan
                ,
                = succeed "," do
                  %em On the Vassiliev knot invariants
                = succeed "," do
                  %a{:href => "https://doi.org/10.1016/0040-9383(95)93237-2"} doi:10.1016/0040-9383(95)93237-2
                = succeed ")" do
                  %a{:href => "https://www.math.toronto.edu/drorbn/papers/OnVassiliev/OnVassiliev.pdf"} pdf
            %li#KrickerSpenceAitchison97
              %p
                A. Kricker, B. Spence and I. Aitchison,
                = succeed "," do
                  %em Cabling the Vassiliev invariants
            %li#Kneissler97
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jan+Kneissler"}> Jan Kneissler
                ,
                %em The number of primitive Vassiliev invariants up to degree 12
                (
                %a{:href => "https://arxiv.org/abs/q-alg/9706022"}> arXiv:q-alg/9706022
                )
            %li#Willerton99
              %p
                %a.existingWikiWord{:href => "/nlab/show/Simon+Willerton"}> Simon Willerton
                ,
                %em The Kontsevich integral and algebraic structures on the space of diagrams
                in: Knots in Hellas ’98. Series on Knots and Everything, vol. 24, World Scientific, 2000, 530–546 (
                %a{:href => "https://arxiv.org/abs/math/9909151"}> arXiv:math/9909151
                )
          %p Lecture notes:
