                                %mi CFT
                                %mn 1
                            %annotation{:encoding => "application/x-tex"} AdS_2/CFT_1
                  %li
                    %a{:href => "#ReferencesWeightSystemsInDpDp2BraneIntersections"}
                      In D
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %mi p
                          %annotation{:encoding => "application/x-tex"} p
                      \/D
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi p
                            %mo +
                            %mn 2
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} (p+2)
                      \-brane intersections
                  %li
                    %a{:href => "#ForHolographicEntanglementEntropy"} As codes for holographic entanglement entropy
                  %li
                    %a{:href => "#ForDysonSchwingerEquations"} For Dyson-Schwinger equations
                  %li
                    %a{:href => "#other"} Other
          %h2#Idea Idea
          %p
            A closed
            %em Jacobi diagram
            is a connected undirected
            %a.existingWikiWord{:href => "/nlab/show/graph"} graph
            with oriented trivalent vertices and with an embedded oriented
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/circle"} circle
          %p Here is a picture of a typical Jacobi diagram:
          %center
            %img{:src => "https://ncatlab.org/nlab/files/JacobiDiagram.jpg", :width => "300"}/
          %p
            Here the internal lines need not form a
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/tree"} tree
          %center
            %img{:src => "https://ncatlab.org/nlab/files/OneLoopJacobiDiagram.jpg", :width => "200"}/
          %blockquote
            %p
              graphics from
              %a.existingWikiWord{:href => "/schreiber/show/Differential+Cohomotopy+implies+intersecting+brane+observables"} Sati-Schreiber 19c
          %p
            If all the
            %a.existingWikiWord{:href => "/nlab/show/vertices"} vertices
            sit on the circle, Jacobi diagrams specialize to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/chord+diagrams"} chord diagrams
          %p
            Half the number of vertices of a Jacobi diagram is called its
            %em order
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi order
                  %mo{:stretchy => "false"} (
                  %mi Γ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mo #
                  %mi Vertices
                  %mo{:stretchy => "false"} (
                  %mi Γ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mn 2
                %annotation{:encoding => "application/x-tex"}
                  order(\Gamma) \;\coloneqq\; \#Vertices(\Gamma)/2
          %p For example, these are the two closed Jacobi diagrams with 2 vertices (order 1):
          %center
            %img{:src => "https://ncatlab.org/nlab/files/JacobiDiagramsOfOrder1.jpg", :width => "200"}/
          %p and these are are the 10 closed Jacobi diagrams with 4 vertices (order 2):
          %center
            %img{:src => "https://ncatlab.org/nlab/files/JacobiDiagramsOfOrder2.jpg", :width => "700"}/
          %blockquote
            %p
              graphics grabbed from
              %a{:href => "#ChmutovDuzhinMostovoy11"} Chmutov-Duzhin-Mostovoy 11
          %p
            In applications to
            %a.existingWikiWord{:href => "/nlab/show/Vassiliev+invariants"} Vassiliev invariants
            in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/knot+theory"} knot theory
            %a.existingWikiWord{:href => "/nlab/show/Feynman+diagrams"} Feynman diagrams
            for
            %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
            in the presence of one
            %a.existingWikiWord{:href => "/nlab/show/Wilson+line"} Wilson line
            (the circle is then the knot/Wilson line).
          %p
            %strong Terminology.
            Jacobi diagrams have originally been called “chinese character diagrams” (
            %a{:href => "#BarNatan95"}> Bar-Natan 95, Def. 1.8
            ) or “
            %a.existingWikiWord{:href => "/nlab/show/Feynman+diagrams"} Feynman diagrams
            for
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
            = succeed ")" do
              %a{:href => "#KrickerSpenceAitchison97"} Kricker-Spence-Aitchison 97
            = succeed ")" do
              %a{:href => "#Kneissler97"} Kneissler 97
            = succeed ")." do
              %a{:href => "#Willerton99"} Willerton 99
            = succeed "," do
              %a{:href => "#ChmutovDuzhinMostovoy11"} Chmutov-Duzhin-Mostovoy 11, Chapter 5
            = succeed ")" do
              %a{:href => "#JacksonMoffat19"} Jackson-Moffat 19, Section 13
            %a.existingWikiWord{:href => "/nlab/show/Jacobi+identity"} Jacobi identity
            – here also called the
            %a.existingWikiWord{:href => "/nlab/show/STU+relation"} STU relation
            – via the fact that these diagrams are naturally labelled by a
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            equipped with a
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+representation"} Lie algebra representation
            (which is really just the
            = succeed "-aspect" do
              %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
            %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
            = succeed "\u2026)." do
              %a.existingWikiWord{:href => "/nlab/show/Feynman+diagrams"} Feynman diagrams
          %h2#definition Definition
          %h3#jacobi_diagrams Jacobi diagrams
          %p (…)
          %h3#STURelationsAndWeightSystems STU-relations and weight systems
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo ∈
                %annotation{:encoding => "application/x-tex"} R \in
            %a.existingWikiWord{:href => "/nlab/show/CRing"} CRing
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo{:stretchy => "false"} ⟨
                  %msup
                    %mi 𝒟
                    %mi t
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} R\langle \mathcal{D}^t \rangle
            denote the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %a.existingWikiWord{:href => "/nlab/show/linear+span"} linear span
            of the
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝒟
                    %mi t
                %annotation{:encoding => "application/x-tex"} \mathcal{D}^t
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Jacobi+diagrams"} Jacobi diagrams
          %p Then one traditionally writes
          #eq:QuotientSpaceBySTU.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝒜
                    %mi t
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mi R
                  %mo{:stretchy => "false"} ⟨
                  %msup
                    %mi 𝒟
                    %mi c
                  %mo{:stretchy => "false"} ⟩
                  %mo{:stretchy => "false"} /
                  %mi STU
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{A}^t
                  \\;\coloneqq\;
                  R\langle \mathcal{D}^c \rangle/STU
          %p
            for the
            %a.existingWikiWord{:href => "/nlab/show/quotient+spaces"} quotient spaces
            of the
            %a.existingWikiWord{:href => "/nlab/show/linear+span"} linear span
            of
            %a.existingWikiWord{:href => "/nlab/show/Jacobi+diagrams"} Jacobi diagrams
            by the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/STU+relations"} STU relations
          %center
            %img{:src => "https://ncatlab.org/nlab/files/STU-relation.jpg", :width => "400"}/
          %p Hence:
          %center
            %img{:src => "https://ncatlab.org/nlab/files/JacobiDiagramsModuloSTURelationsII.jpg", :width => "700"}/
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/linear+function"} linear function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi w
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi 𝒜
                    %mi t
                  %mo ⟶
                  %mi R
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  w \;\colon\; \mathcal{A}^t \longrightarrow R
                  \\,,
          %p
            – hence a plain
            = succeed "-valued" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %a.existingWikiWord{:href => "/nlab/show/function"} function
            on the
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝒟
                    %mi t
                %annotation{:encoding => "application/x-tex"} \mathcal{D}^t
            of
            %a.existingWikiWord{:href => "/nlab/show/Jacobi+diagrams"} Jacobi diagrams
            which is
            %a.existingWikiWord{:href => "/nlab/show/invariant"} invariant
            under the
            %a.existingWikiWord{:href => "/nlab/show/STU+relations"} STU relations
            –
          %p
            is called a
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/framed+weight+system"} framed weight system
          %blockquote
            %p
              graphics from
              %a.existingWikiWord{:href => "/schreiber/show/Differential+Cohomotopy+implies+intersecting+brane+observables"} Sati-Schreiber 19c
          %h2#properties Properties
          %h3#relation_to_chord_diagrams Relation to chord diagrams
          %p
            %a.existingWikiWord{:href => "/nlab/show/chord+diagrams+modulo+4T+are+Jacobi+diagrams+modulo+STU"}> chord diagrams modulo 4T are Jacobi diagrams modulo STU
            \:
          %center
            %img{:src => "https://ncatlab.org/nlab/files/ChordDiagModulo4TAreJAcobiDiagModuloSTU.jpg", :width => "840"}/
          %blockquote
            %p
              graphics from
              %a.existingWikiWord{:href => "/schreiber/show/Differential+Cohomotopy+implies+intersecting+brane+observables"} Sati-Schreiber 19c
          %h3#relation_to_adams_operations Relation to Adams operations
          %p
            On the
            %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathcal{A}
            of
            %a.existingWikiWord{:href => "/nlab/show/Jacobi+diagrams"} Jacobi diagrams
            %a.existingWikiWord{:href => "/nlab/show/quotient+vector+space"} modulo
            %a.existingWikiWord{:href => "/nlab/show/STU-relations"} STU-relations
            (
            %a.existingWikiWord{:href => "/nlab/show/chord+diagrams+modulo+4T+are+Jacobi+diagrams+modulo+STU"} equivalently
            %a.existingWikiWord{:href => "/nlab/show/chord+diagrams"} chord diagrams
            %a.existingWikiWord{:href => "/nlab/show/quotient+vector+space"} modulo
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/4T+relations"} 4T relations
            %a.existingWikiWord{:href => "/nlab/show/linear+maps"} linear maps
            (for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo ∈
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} q \in \mathbb{Z}
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo ≠
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} q \neq 0
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ψ
                    %mi q
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi 𝒜
                  %mo ⟶
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"}
                  \\psi^q
                  \\;\colon\;
                  \\mathcal{A}
                  \\longrightarrow
                  \\mathcal{A}
          %p
            which respect the
            %a.existingWikiWord{:href => "/nlab/show/coalgebra"} coalgebra
            %a.existingWikiWord{:href => "/nlab/show/mathematical+structure"} structure
            and satisfy
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ψ
                    %mrow
                      %msub
                        %mi q
                        %mn 2
                  %mo ∘
                  %msubsup
                    %mi ψ
                    %mn 1
                    %mi q
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi ψ
                    %mrow
                      %msub
                        %mi q
                        %mn 1
                      %mo ⋅
                      %msub
                        %mi q
                        %mn 2
                %annotation{:encoding => "application/x-tex"}
                  \\psi^{q_2} \circ \psi^q_1
                  \\;=\;
                  \\psi^{q_1 \cdot q_2}
          %p
            and as such are (dually) analogous to the
            %a.existingWikiWord{:href => "/nlab/show/Adams+operations"} Adams operations
            on
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"} topological K-theory
          %p
            (
            %a{:href => "#BarNatan95"}> Bar-Natan 95, Def. 3.11 &amp; Theorem 7
            )
          %p
            In fact, when evaluated in
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+weight+systems"} Lie algebra weight systems
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi w
                    %mstyle{:mathvariant => "bold"}
                      %mi N
                %annotation{:encoding => "application/x-tex"} w_{\mathbf{N}}
            and under the identification (see
            = succeed ")" do
              %a{:href => "equivariant+K-theory#RelationToRepresentationTheory"} here
            %a.existingWikiWord{:href => "/nlab/show/representation+ring"} representation ring
            of a
            %a.existingWikiWord{:href => "/nlab/show/compact+Lie+group"} compact Lie group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            with the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/equivariant+K-theory"} equivariant K-theory
            of the point, these Adams operations on
            %a.existingWikiWord{:href => "/nlab/show/Jacobi+diagrams"} Jacobi diagrams
            correspond to the
            %a.existingWikiWord{:href => "/nlab/show/Adams+operations"} Adams operations
            on
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/equivariant+K-theory"} equivariant K-theory
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi w
                    %mstyle{:mathvariant => "bold"}
                      %mi N
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ψ
                    %mi q
                  %mi D
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi w
                    %mrow
                      %msup
                        %mi ψ
                        %mi q
                      %mstyle{:mathvariant => "bold"}
                        %mi N
                  %mo{:stretchy => "false"} (
                  %mi D
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  w_{\mathbf{N}}(\psi^q D)
                  \\;=\;
                  w_{\psi^q \mathbf{N}}(D)
                  \\,.
          %p
            (
            %a{:href => "#BarNatan95"} Bar-Natan 95, Exc. 6.24
            )
          %p
            For more see at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Adams+operation+on+Jacobi+diagrams"} Adams operation on Jacobi diagrams
          %h2#related_concepts Related concepts
          %div
            %table
              %thead
                %tr
                  %th
