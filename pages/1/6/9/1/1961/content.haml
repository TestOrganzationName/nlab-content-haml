                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mrow
                              %mo (
                              %msup
                                %mi ℝ
                                %mn 1
                              %mover
                                %mo →
                                %mi γ
                              %mi X
                              %mo )
                          %mtd
                            %mover
                              %mo ↦
                              %mphantom
                                %mi AAA
                          %mtd
                            %mrow
                              %mo (
                              %msup
                                %mi ℝ
                                %mn 1
                              %mover
                                %mo →
                                %mrow
                                  %mi f
                                  %mo ∘
                                  %mi γ
                              %mi Y
                              %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Hom_{Diff}(\mathbb{R}^1, X)
                    \&amp;\overset{f \circ (-)}{\longrightarrow}&amp;
                    Hom_{Diff}(\mathbb{R}^1, Y)
                    \\\
                    \\left(
                    \\mathbb{R}^1 \overset{\gamma}{\to} X
                    \\right)
                    \&amp;\overset{\phantom{AAA}}{\mapsto}&amp;
                    \\left(
                    \\mathbb{R}^1 \overset{f \circ \gamma}{\to} Y
                    \\right)
                    }
            %p
              descends at each point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              to the tangency
              %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
              (def.
              = succeed "," do
                %a.maruku-ref{:href => "#TangencyRelationOnSmoothCurves"}
              = succeed ")" do
                %a.maruku-ref{:href => "#TangencyIsEquivalenceRelation"}
              %a.existingWikiWord{:href => "/nlab/show/tangent+vectors"} tangent vectors
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#TangentVector"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/differential"} differential
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %msub
                      %mi f
                      %mi x
                  %annotation{:encoding => "application/x-tex"} d f_x
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              at
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mi f
                    %msub
                      %mo{:stretchy => "false"} |
                      %mi x
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi T
                      %mi x
                    %mi X
                    %mo ⟶
                    %msub
                      %mi T
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                    %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    d f|_{x}
                    \\;\colon\;
