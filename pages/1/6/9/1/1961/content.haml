                  %annotation{:encoding => "application/x-tex"} T X
              is paracompact.
            %p
              Finally the statement about the differentiability of the
              %a.existingWikiWord{:href => "/nlab/show/gluing+functions"} gluing functions
              and of the projections is immediate from the definitions
          #FunctionsBetweenDifferentiableManifoldsDifferentials.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/differentials"} differentials
                of
                %a.existingWikiWord{:href => "/nlab/show/differentiable+functions"} differentiable functions
                between
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/differentiable+manifolds"} differentiable manifolds
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              be
              %a.existingWikiWord{:href => "/nlab/show/differentiable+manifolds"} differentiable manifolds
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \;\colon\; X \longrightarrow Y
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/differentiable+function"} differentiable function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              to differentiable curves in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi Hom
                              %mi Diff
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi ℝ
                              %mn 1
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mi f
                                %mo ∘
                                %mo{:stretchy => "false"} (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo{:stretchy => "false"} )
                          %mtd
                            %msub
                              %mi Hom
