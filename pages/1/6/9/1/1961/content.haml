          #DifferentiableTangentBundle.num_lemma
            %h6#lemma_3 Lemma
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
                is
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/differentiable+vector+bundle"} differentiable vector bundle
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
