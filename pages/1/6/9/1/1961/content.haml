                    \\\
                    v &amp;\mapsto&amp; \partial_v
                    }
                    \\,.
            %p
              It turns out that this function is in fact a
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
            %p
              For more on this see at
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/derivations+of+smooth+functions+are+vector+fields"} derivations of smooth functions are vector fields
          %p
          .num_remark
            %h6 Remark
            %p
            %p
              For manifolds of the class
              = succeed "," do
