          %h3#ViaDerivationsOfSmoothFunctions Via derivations of smooth functions
          #AlgebraicDefinition.num_remark
            %h6#remark_4 Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/derivations+of+smooth+functions+are+vector+fields"}> derivations of smooth functions are vector fields
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
