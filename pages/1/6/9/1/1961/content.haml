              %a.existingWikiWord{:href => "/nlab/show/topological+vector+bundle"} topological vector bundle
              which is glued (via
              = succeed ")" do
                %a{:href => "topological+vector+bundle#TopologicalVectorBundleFromCechCocycle"} this example
              %a.existingWikiWord{:href => "/nlab/show/transition+functions"} transition functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
