                        %msup
                          %mi X
                          %mi D
                        %mo{:stretchy => "false"} )
                        %mo ↦
                        %mo{:stretchy => "false"} (
                        %mi U
                        %mo ×
                        %mo *
                        %mover
                          %mo →
                          %mrow
                            %mi Id
                            %mo ×
                            %mn 0
                        %mi U
                        %mo ×
                        %mi D
                        %mover
                          %mo →
                          %mover
                            %mi v
                            %mo{:stretchy => "false"} ¯
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        ev_0 : (U \stackrel{v}{\to} X^D) \mapsto
