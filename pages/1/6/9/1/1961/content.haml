                    %annotation{:encoding => "application/x-tex"} C^k
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo &lt;
                      %mi k
                      %mo &lt;
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} 0\lt k\lt \infty
              %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
              of the algebra of functions (
              %a.existingWikiWord{:href => "/nlab/show/derivations+of+smooth+functions+are+vector+fields"}> derivations of smooth functions are vector fields
              ) remains valid if one strengthens the definition of a
              %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
