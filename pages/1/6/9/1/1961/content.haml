                  %annotation{:encoding => "application/x-tex"}
                    D(f(g_1,\ldots,g_m))
                    \\;=\;
                    \\sum_i (\partial_i f)(g_1,\ldots,g_m)D(g_i).
            %p
              See
              = succeed "." do
                %a{:href => "#NewnsWalker56"} Newns-Walker 56
            %p
          %h3#InSDG In synthetic differential geometry
          %p
            The above definitions in ordinary
            %a.existingWikiWord{:href => "/nlab/show/differential+geometry"} differential geometry
            suggest the slogan
          .standout
            %p Tangent vectors are infinitesimal curves in a space.
          %p
            One of the central motivations for
            %a.existingWikiWord{:href => "/nlab/show/synthetic+differential+geometry"} synthetic differential geometry
            is the desire to provide a context in which this slogan becomes literally formally true.
          .un_defn
            %h6#definition_6 Definition
            %p
              %strong (tangent bundle in smooth toposes)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒯
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mo ,
                    %mo ⋅
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{T},(R,+,\cdot))
              be a
              %a.existingWikiWord{:href => "/nlab/show/smooth+topos"} smooth topos
              and write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi ϵ
                    %mo ∈
                    %mi R
                    %mo{:stretchy => "false"} |
                    %msup
                      %mi ϵ
                      %mn 2
                    %mo =
                    %mn 0
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} D = \{\epsilon \in R| \epsilon^2 = 0\}
              for the standard
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+space"} infinitesimal interval
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi 𝒯
                  %annotation{:encoding => "application/x-tex"} X \in \mathcal{T}
              any object (any
              %a.existingWikiWord{:href => "/nlab/show/space"} space
              in
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒯
                    %annotation{:encoding => "application/x-tex"} \mathcal{T}
              %strong tangent bundle
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is the morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi T
                    %mi X
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    p : T X \to X
            %p with
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                        %mi X
                        %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∶−
                        %msup
                          %mi X
                          %mi D
                      %annotation{:encoding => "application/x-tex"} T X \coloneq X^D
                  the
                  %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                      %annotation{:encoding => "application/x-tex"} D
                  into
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %mo =
                        %msub
                          %mi ev
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} p = ev_0
                  the evaluation map at the origin of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                      %annotation{:encoding => "application/x-tex"} D
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msub
                          %mi ev
                          %mn 0
                        %mo :
                        %mo{:stretchy => "false"} (
                        %mi U
                        %mover
                          %mo →
