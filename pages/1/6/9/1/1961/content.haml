            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi g
                      %mi m
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
