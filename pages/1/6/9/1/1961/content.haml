                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n \underoverset{\simeq}{\phi_i}{\to} U_i \subset X
              we have that its
              %a.existingWikiWord{:href => "/nlab/show/preimage"} preimage
              under
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
