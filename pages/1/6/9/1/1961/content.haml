                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a
              = succeed "-times" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (p+1)
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/differentiable+manifold"} differentiable manifold
              %a.maruku-ref{:href => "#TangentBundle"}
              is a
              = succeed "-times" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %a.existingWikiWord{:href => "/nlab/show/differentiable+manifold"} differentiable manifold
              in that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi T
                        %mi X
                        %mo ,
                        %msub
                          %mi τ
                          %mrow
                            %mi T
                            %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (T X, \tau_{T X})
                  is a
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/paracompact+Hausdorff+space"} paracompact Hausdorff space
              %li
                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/gluing+functions"} gluing functions
                  of the atlas
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mrow
                            %mo {
                            %msup
                              %mi ℝ
                              %mrow
                                %mn 2
                                %mi n
                            %munderover
                              %mo →
                              %mo ≃
                              %mrow
                                %mi d
                                %msub
                                  %mi ϕ
                                  %mi i
                            %mi T
                            %msub
                              %mi U
                              %mi i
                            %mo ⊂
                            %mi T
                            %mi X
                            %mo }
                          %mrow
                            %mi i
                            %mo ∈
                            %mi I
                      %annotation{:encoding => "application/x-tex"} \left\{ \mathbb{R}^{2n} \underoverset{\simeq}{d \phi_i}{\to} T U_i \subset  T X \right\}_{i \in I}
                  are
                  = succeed "-times" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi p
                        %annotation{:encoding => "application/x-tex"} p
            %p
              Moreover, the projection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mo{:lspace => "verythinmathspace"} :
                    %mi T
                    %mi X
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \pi \colon T X \to X
              is a
              = succeed "-times" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/differentiable+function"} differentiable function
            %p
              In summary this makes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mi X
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} T X \to X
              a
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/differentiable+vector+bundle"} differentiable vector bundle
          .proof
            %h6#proof_3 Proof
            %p
              First to see that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mi X
                  %annotation{:encoding => "application/x-tex"} T X
              is Hausdorff:
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mover
                      %mi v
                      %mo{:stretchy => "false"} →
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ′
                    %mo ,
                    %mover
                      %mi v
                      %mo{:stretchy => "false"} →
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi T
                    %mi X
                  %annotation{:encoding => "application/x-tex"} (x,\vec v), (x', \vec v') \in T X
              be two distinct points. We need to produce disjoint openneighbourhoods of these points in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mi X
                    %annotation{:encoding => "application/x-tex"} T X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ,
                    %mi x
                    %mo ′
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x,x' \in X
              are distinct, and since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is Hausdorff, there exist disjoint open neighbourhoods
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                    %mo ⊃
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} U_x \supset \{x\}
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mrow
                          %mi x
                          %mo ′
                      %mo ⊃
                      %mo{:stretchy => "false"} {
                      %mi x
                      %mo ′
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} U_{x'} \supset \{x'\}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi π
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi^{-1}(U_x)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi π
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mrow
                        %mi x
                        %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi^{-1}(U_{x'})
              are disjoint open neighbourhoods of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mover
                      %mi v
                      %mo{:stretchy => "false"} →
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x,\vec v)
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ′
                      %mo ,
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} vect
                      %mi v
                      %mo ′
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (x',\vect v')
            %p
              Now to see that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mi X
                  %annotation{:encoding => "application/x-tex"} T X
              is paracompact.
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi T
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{U_i \subset T X\}_{i \in I}
              be an open cover. We need to find a
              %a.existingWikiWord{:href => "/nlab/show/locally+finite+cover"} locally finite
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/refinement"} refinement
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mo{:lspace => "verythinmathspace"} :
                    %mi T
                    %mi X
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \pi \colon T X \to X
              is an
              %a.existingWikiWord{:href => "/nlab/show/open+map"} open map
              (by
              = succeed ")" do
                %a{:href => "open+map#ProjectionsAreOpenContinuousFunctions"} this example
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi π
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{\pi(U_i) \subset X\}_{i \in I}
              is an open cover of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p
              Let now
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi ℝ
                      %mi n
                    %munderover
                      %mo →
                      %mo ≃
                      %mrow
                        %msub
                          %mi ϕ
                          %mi j
                    %msub
                      %mi V
                      %mi j
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi j
                        %mo ∈
                        %mi J
                  %annotation{:encoding => "application/x-tex"} \{\mathbb{R}^n \underoverset{\simeq}{\phi_j}{\to} V_j \subset X\}_{j \in J}
              be an
              %a.existingWikiWord{:href => "/nlab/show/atlas"} atlas
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and consider the open common refinement
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo {
                        %mi π
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi U
                          %mi i
                        %mo{:stretchy => "false"} )
                        %mo ∩
                        %msub
                          %mi V
                          %mi j
                        %mo ⊂
                        %mi X
                        %mo }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                        %mo ,
                        %mi j
                        %mo ∈
                        %mi J
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{ \pi(U_i) \cap V_j \subset X  \right\}_{i \in I, j \in J}
                    \\,.
            %p
              Since this is still an open cover of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is paracompact, this has a locally finite refinement
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo {
                        %mi V
                        %msub
                          %mo ′
                          %mrow
                            %mi j
                            %mo ′
                        %mo ⊂
                        %mi X
                        %mo }
                      %mrow
                        %mi j
                        %mo ′
                        %mo ∈
                        %mi J
                        %mo ′
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{ V'_{j'} \subset X\right\}_{j' \in J'}
            %p
              Notice that for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo ′
                    %mo ∈
                    %mi J
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} j' \in J'
              the product topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %msub
                      %mo ′
                      %mrow
                        %mi j
                        %mo ′
                    %mo ×
                    %msup
                      %mi ℝ
                      %mi n
                    %mo ⊂
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 2
                        %mi n
                  %annotation{:encoding => "application/x-tex"} V'_{j'} \times \mathbb{R}^n \subset \mathbb{R}^{2n}
              is paracompact (as a
              %a.existingWikiWord{:href => "/nlab/show/topological+subspace"} topological subspace
              of
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
              it is itself
              %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+space"} locally compact
              and
              %a.existingWikiWord{:href => "/nlab/show/second+countable+topological+space"} second countable
              and since
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/locally+compact+and+second-countable+spaces+are+paracompact"} locally compact and second-countable spaces are paracompact
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi π
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi V
                    %msub
                      %mo ′
                      %mrow
                        %mi j
                        %mo ′
                    %mo{:stretchy => "false"} )
                    %mo ∩
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi V
                    %msub
                      %mo ′
                      %mrow
                        %mi j
                        %mo ′
                    %mo ×
                    %msup
                      %mi ℝ
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo ,
                        %mi j
                        %mo ′
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %mi I
                        %mo ×
                        %mi J
                        %mo ′
                  %annotation{:encoding => "application/x-tex"}
                    \\{ \pi^{-1}(V'_{j'}) \cap U_i \subset V'_{j'} \times \mathbb{R}^n \}_{(i,j') \in I \times J'}
            %p has a locally finite refinement
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi W
                      %mrow
                        %msub
                          %mi k
                          %mrow
                            %mi j
                            %mo ′
                    %mo ⊂
                    %mi V
                    %msub
                      %mo ′
                      %mrow
                        %mi j
                        %mo ′
                    %mo ×
                    %msup
                      %mi ℝ
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %msub
                          %mi k
                          %mrow
                            %mi j
                            %mo ′
                        %mo ∈
                        %msub
                          %mi K
                          %mrow
                            %mi j
                            %mo ′
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\{W_{k_{j'}} \subset V'_{j'} \times \mathbb{R}^n \}_{k_{j'} \in K_{j'}}
                    \\,.
            %p We claim now that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi W
                      %mrow
                        %msub
                          %mi k
                          %mrow
                            %mi j
                            %mo ′
                    %mo ⊂
                    %mi T
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi j
                        %mo ′
                        %mo ∈
                        %mi J
                        %mo ′
                        %mo ,
                        %msub
                          %mi k
                          %mrow
                            %mi j
                            %mo ′
                        %mo ∈
                        %msub
                          %mi K
                          %mrow
                            %mi j
                            %mo ′
                  %annotation{:encoding => "application/x-tex"}
                    \\{ W_{k_{j'}}  \subset T X \}_{j' \in J',  k_{j'} \in K_{j'}}
            %p is a locally finite refinement of the original cover. That this is an open cover refining the original one is clear. We need to see that it is locally finite.
            %p
              So let
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} →
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi T
                      %mi X
                    %annotation{:encoding => "application/x-tex"} (x,\vec v) \in T X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi V
                    %msub
                      %mo ′
                      %mrow
                        %mi j
                        %mo ′
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi j
                        %mo ′
                        %mo ∈
                        %mi J
                        %mo ′
                  %annotation{:encoding => "application/x-tex"} \{ V'_{j'}  \subset X\}_{j' \in J'}
              there is an open neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi x
                    %mo ⊃
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} V_x \supset \{x\}
              which intersects only finitely many of the
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %msub
                        %mo ′
                        %mrow
                          %mi j
                          %mo ′
                      %mo ⊂
                      %mi X
                    %annotation{:encoding => "application/x-tex"} V'_{j'} \subset X
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi W
                        %mrow
                          %msub
                            %mi k
                            %mrow
                              %mi j
                              %mo ′
                      %mo ⊂
                      %mi V
                      %msub
                        %mo ′
                        %mrow
                          %msub
                            %mi j
                            %mo ′
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{ W_{k_{j'}}  \subset V'_{j_'}\}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} j'
              the point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mover
                      %mi v
                      %mo{:stretchy => "false"} →
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x,\vec v)
              regarded in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %msub
                      %mo ′
                      %mrow
                        %mi j
                        %mo ′
                    %mo ×
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} V'_{j'} \times \mathbb{R}^n
              has an open neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mrow
                        %mi j
                        %mo ′
                  %annotation{:encoding => "application/x-tex"} U_{j'}
              that intersects only finitely many of the
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi W
                        %mrow
                          %msub
                            %mi k
                            %mrow
                              %mi j
                              %mo ′
                    %annotation{:encoding => "application/x-tex"} W_{k_{j'}}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi π
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mi x
                    %mo{:stretchy => "false"} )
                    %mo ∩
                    %mrow
                      %mo (
                      %munder
                        %mo ∩
                        %mrow
                          %mi j
                          %mo ′
                      %msub
                        %mi U
                        %mrow
                          %mi j
                          %mo ′
                      %mo )
                  %annotation{:encoding => "application/x-tex"} \pi^{-1}(V_x) \cap \left( \underset{j'}{\cap}  U_{j'} \right)
              is a finite intersection of open subsets, hence still open, and by construction it intersects still only a finite number of the
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi W
                        %mrow
                          %msub
                            %mi k
                            %mrow
                              %mi j
