                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is
            %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite
            (particularly when it has two elements, such as for coin flips), one calls the resulting
            %a.existingWikiWord{:href => "/nlab/show/stochastic+process"} stochastic process
            a
            = succeed "." do
              %strong Bernoulli process
          %h3#iid_samples iid samples
          %p
            Given a probability distribution
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "." do
              %strong iid samples
            %a.existingWikiWord{:href => "/nlab/show/Markov+kernel"} Markov kernel
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi samp
                    %mi ℕ
                  %mo :
                  %mi P
                  %mi X
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mi X
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi ℕ
                  %mo →
                  %msup
                    %mi X
                    %mi ℕ
                %annotation{:encoding => "application/x-tex"} samp_\mathbb{N}:P X\to (P X)^\mathbb{N}\to X^\mathbb{N}
            where:
          %ul
            %li
              The kernel
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mi X
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mi X
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi ℕ
                  %annotation{:encoding => "application/x-tex"} P X\to (P X)^\mathbb{N}
              is the
              %a.existingWikiWord{:href => "/nlab/show/Markov+kernel#kernels_from_deterministic_functions"} kernel induced by
              the function
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ↦
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo ,
                      %mi p
                      %mo ,
                      %mi …
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} p\mapsto (p,p,\dots)
            %li
              The kernel
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mi X
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi ℕ
                    %mo →
                    %msup
                      %mi X
                      %mi ℕ
                  %annotation{:encoding => "application/x-tex"} (P X)^\mathbb{N}\to X^\mathbb{N}
              is induced by taking many tensor copies of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/sampling+map"} sampling map
              = succeed ".)" do
                %a.existingWikiWord{:href => "/nlab/show/Kolmogorov+extension+theorem"} Kolmogorov extension theorem
          %p
            Explicitly, the kernel
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi samp
                    %mi ℕ
                  %mo :
                  %mi P
                  %mi X
                  %mo →
                  %msup
                    %mi X
                    %mi ℕ
                %annotation{:encoding => "application/x-tex"} samp_\mathbb{N}:P X\to X^\mathbb{N}
            is given as follows:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi samp
                    %mi ℕ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi A
                    %mn 1
                  %mo ×
                  %mi …
                  %mo ×
                  %msub
                    %mi A
                    %mi n
                  %mo{:stretchy => "false"} |
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mi p
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi A
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mi ⋯
                  %mi p
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi A
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  samp_\mathbb{N}(A_1\times\dots\times A_n|p) \;=\; p(A_1)\cdots p(A_n) ,
          %p
            where again we make use of the
            %a.existingWikiWord{:href => "/nlab/show/Kolmogorov+extension+theorem"} Kolmogorov extension theorem
            to define the kernel in terms of its finite
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/marginal+distribution"} marginals
          %p
            One way of stating
            %a.existingWikiWord{:href => "/nlab/show/de+Finetti%27s+theorem"} de Finetti's theorem
            is by saying that the map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi samp
                    %mi ℕ
                  %mo :
                  %mi P
                  %mi X
                  %mo →
                  %msup
                    %mi X
                    %mi ℕ
                %annotation{:encoding => "application/x-tex"} samp_\mathbb{N}:P X\to X^\mathbb{N}
            is a
            %a.existingWikiWord{:href => "/nlab/show/limit"} limit
            cone over an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/exchangeable+process"} exchangeable process
          %h3#in_categorical_probability In categorical probability
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/categorical+probability"} categorical probability
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Markov+categories"} Markov categories
            %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
            of
            %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            (for example, from the
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/monoidal+unit"} monoidal unit
          %p
            In Markov categories, one can model iid samples using the
            %em copy map
            (see at
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/Markov+category"} Markov category
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Markov+category#kolmogorov_products"} Kolmogorov products
          %h2#properties Properties
          %ul
            %li
              %p
                An iid process is always
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/exchangeable"} exchangeable
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/De+Finetti%27s+theorem"} De Finetti's theorem
                says that every
                %a.existingWikiWord{:href => "/nlab/show/exchangeable+probability+measure"} exchangeable probability measure
                is a unique
                %a.existingWikiWord{:href => "/nlab/show/convex+mixture"} convex mixture
                of iid ones.
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/Hewitt-Savage+zero-one+law"} Hewitt-Savage zero-one law
                says that given iid random variables, the probability of each
                %a.existingWikiWord{:href => "/nlab/show/exchangeable+event"} exchangeable event
                is either zero or one, i.e. it is a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/zero-one+measure"} zero-one measure
            %li
              %p
                The
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Kolmogorov+zero-one+law"} Kolmogorov zero-one law
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/random+variables"} random variables
                %a.existingWikiWord{:href => "/nlab/show/tail+event"} tail event
                is a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/zero-one+measure"} zero-one measure
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/law+of+large+numbers"} law of large numbers
                says that given integrable iid random variables, the
                %a.existingWikiWord{:href => "/nlab/show/empirical+mean"} empirical mean
                tends to the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/expectation+value"} expectation value
          %h2#see_also See also
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/probability+theory"}> probability theory
                ,
                %a.existingWikiWord{:href => "/nlab/show/categorical+probability"} categorical probability
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/observational+monad"}> observational monad
                ,
                %a.existingWikiWord{:href => "/nlab/show/sampling+map"} sampling map
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/de+Finetti%27s+theorem"}> de Finetti's theorem
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Hewitt-Savage+zero-one+law"} Hewitt-Savage zero-one law
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Kolmogorov+zero-one+law"} Kolmogorov zero-one law
                %a.existingWikiWord{:href => "/nlab/show/law+of+large+numbers"} law of large numbers
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/infinitary+tensor+product"}> infinitary tensor product
                ,
                %a.existingWikiWord{:href => "/nlab/show/Kolmogorov+extension+theorem"} Kolmogorov extension theorem
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Markov+category"}> Markov category
                ,
                %a.existingWikiWord{:href => "/nlab/show/sampling+map"} sampling map
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/ergodic+system"}> ergodic system
                ,
                %span.newWikiWord
                  Bernoulli shifts
                  %a{:href => "/nlab/new/Bernoulli+shifts"} ?
          %h2#references References
          %p See also:
          %ul
            %li
              %p
                Wikipedia,
                %em
                  %a{:href => "https://en.wikipedia.org/wiki/Independence_(probability_theory)"} Independence (probability theory)
            %li
              %p
                ProofWiki:
                %em
                  %a{:href => "https://proofwiki.org/wiki/Definition:Independent_Random_Variables"} Definition:Independent Random Variables
            %li
              %p
                ProofWiki:
                %em
                  %a{:href => "https://proofwiki.org/wiki/Condition_for_Independence_from_Product_of_Expectations"} Condition for Independence from Product of Expectations
