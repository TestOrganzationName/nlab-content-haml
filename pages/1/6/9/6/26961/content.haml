            %a.existingWikiWord{:href => "/nlab/show/probability+space"} probability space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Ω
                  %mo ,
                  %mi μ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\Omega,\mu)
            are said to be
            = succeed "," do
              %strong iid
            = succeed "," do
              %strong independent and identically distributed
            %a.existingWikiWord{:href => "/nlab/show/joint+distribution"} joint distribution
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
