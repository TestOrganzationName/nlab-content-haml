            %a.existingWikiWord{:href => "/nlab/show/random+variable"} Random variables
            or
            %a.existingWikiWord{:href => "/nlab/show/random+elements"} random elements
            in a
            %a.existingWikiWord{:href => "/nlab/show/sequence"} sequence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
