          %h1#section_table_of_contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#Idea"} Idea
              %li
                %a{:href => "#examples"} Examples
              %ul
                %li
                  %a{:href => "#L1Brane"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %msub
                            %mi L
                            %mn 1
                        %annotation{:encoding => "application/x-tex"} L_1
                    \-brane
              %li
                %a{:href => "#references"} References
          %h2#Idea Idea
          %p
            By reference to the
            %a.existingWikiWord{:href => "/nlab/show/superembedding+formalism"} superembedding formalism
            for
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/super+p-branes"} super p-branes
            = succeed "-branes\u201D" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mi p
                  %annotation{:encoding => "application/x-tex"} L_p
            = succeed "&rbrack;," do
              %a{:href => "#HoweSezgin97a"} Howe &amp; Sezgin 1997, p. 8
            %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} natural numbers
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
          %p
            The
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo +
                    %mn 4
                  %annotation{:encoding => "application/x-tex"} p+4
            %a.existingWikiWord{:href => "/nlab/show/target+spacetime"} target spacetime
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mrow
                      %mi p
                      %mo +
                      %mn 4
                %annotation{:encoding => "application/x-tex"} X^{p+4}
            carries
            %a.existingWikiWord{:href => "/nlab/show/flux+densities"} flux densities
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %msub
                            %mi G
                            %mn 2
                        %mtd
                          %mo ∈
                          %msubsup
                            %mi Ω
                            %mi dR
                            %mn 2
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %msup
                            %mi X
                            %mrow
                              %mi p
                              %mo +
                              %mn 4
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mtr
                        %mtd
                          %msub
                            %mi G
                            %mrow
                              %mi p
                              %mo +
                              %mn 1
                        %mtd
                          %mo ∈
                          %msubsup
                            %mi Ω
                            %mi dR
                            %mrow
                              %mi p
                              %mo +
                              %mn 1
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %msup
                            %mi X
                            %mrow
                              %mi p
                              %mo +
                              %mn 4
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mtr
                        %mtd
                          %msub
                            %mi G
                            %mrow
                              %mi p
                              %mo +
                              %mn 2
                        %mtd
                          %mo ∈
                          %msubsup
                            %mi Ω
                            %mi dR
                            %mrow
                              %mi p
                              %mo +
                              %mn 2
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %msup
                            %mi X
                            %mrow
                              %mi p
                              %mo +
                              %mn 4
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mpadded{:width => "0"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                              %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  G_2 &amp; \in \Omega^2_{dR}\big(X^{p+4}\big)
                  \\\
                  G_{p+1} &amp; \in \Omega^{p+1}_{dR}\big(X^{p+4}\big)
                  \\\
                  G_{p+2} &amp; \in \Omega^{p+2}_{dR}\big(X^{p+4}\big)
                  \\mathrlap{\,,}
                  \\end{aligned}
          %p
            subject to the
            %a.existingWikiWord{:href => "/nlab/show/Bianchi+identities"} Bianchi identities
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mi{:mathvariant => "normal"} d
                          %msub
                            %mi G
                            %mn 2
                        %mtd
                          %mo =
                          %mn 0
                      %mtr
                        %mtd
                          %mi{:mathvariant => "normal"} d
                          %msub
                            %mi G
                            %mrow
                              %mi p
                              %mo +
                              %mn 1
                        %mtd
                          %mo =
                          %mn 0
                      %mtr
                        %mtd
                          %mi{:mathvariant => "normal"} d
                          %msub
                            %mi G
                            %mrow
                              %mi p
                              %mo +
                              %mn 2
                        %mtd
                          %mo =
                          %msub
                            %mi G
                            %mn 2
                          %mo ∧
                          %msub
                            %mi G
                            %mrow
                              %mi p
                              %mo +
                              %mn 1
                          %mpadded{:width => "0"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                              %mo ;
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  \\mathrm{d} G_2 &amp; = 0
                  \\\
                  \\mathrm{d} G_{p+1} &amp; = 0
                  \\\
                  \\mathrm{d} G_{p+2} &amp; = G_2 \wedge G_{p+1}
                  \\mathrlap{\,;}
                  \\end{aligned}
          %p
            and on the brane’s
            %a.existingWikiWord{:href => "/nlab/show/worldvolume"} worldvolume
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Σ
                    %mrow
                      %mi p
                      %mo +
                      %mn 1
                  %mover
                    %mo →
                    %mrow
                      %mphantom
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi ϕ
                      %mphantom
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msup
                    %mi X
                    %mrow
                      %mi p
                      %mo +
                      %mn 4
                %annotation{:encoding => "application/x-tex"}
                  \\Sigma^{p+1}
                  \\xrightarrow{\phantom{-}\phi\phantom{-}}
                  X^{p+4}
          %p there is a flux density
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %msub
                            %mi F
                            %mi p
                        %mtd
                          %mo ∈
                          %msubsup
                            %mi Ω
                            %mi dR
                            %mi p
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi X
                            %mrow
                              %mi p
                              %mo +
                              %mn 1
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  F_p &amp; \in \Omega^p_{dR}(X^{p+1})
                  \\end{aligned}
          %p
            satisfying the
            %a.existingWikiWord{:href => "/nlab/show/Bianchi+identity"} Bianchi identity
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mi{:mathvariant => "normal"} d
                          %mspace{:width => "thinmathspace"}
                          %msub
                            %mi F
                            %mi p
                        %mtd
                          %mo =
                          %msup
                            %mi ϕ
                            %mo *
                          %msub
                            %mi G
                            %mrow
                              %mi p
                              %mo +
                              %mn 1
                          %mspace{:width => "thinmathspace"}
                          %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  \\mathrm{d} \, F_p
                  \&amp; = \phi^\ast G_{p+1}
                  \\,.
                  \\end{aligned}
          %p
            In
            %a{:href => "#HoweRaetzelSezgin98"} Howe, Raetzel &amp; Sezgin 1998, p 3
            this is claimed for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∈
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo ,
                    %mn 2
                    %mo ,
                    %mn 3
                    %mo ,
                    %mn 4
                    %mo ,
                    %mn 5
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} p \in \{1,2,3,4,5\}
            %a{:href => "#HoweRaetzelRudychev99"} Howe, Raetzel &amp; Rudychev 1999
            considers it for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∈
                    %mo{:stretchy => "false"} {
                    %mn 3
                    %mo ,
                    %mn 4
                    %mo ,
                    %mn 5
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} p \in \{3,4,5\}
          %h2#examples Examples
          %h3#L1Brane
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mn 1
                %annotation{:encoding => "application/x-tex"} L_1
            \-brane
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} p = 1
            the
            %a{:href => "#Idea"} above
            %a.existingWikiWord{:href => "/nlab/show/Bianchi+identities"} Bianchi identities
            read:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mi{:mathvariant => "normal"} d
                          %msub
                            %mi G
                            %mn 2
                        %mtd
                          %mo =
                          %mn 0
                      %mtr
                        %mtd
                          %mi{:mathvariant => "normal"} d
                          %msub
                            %mi G
                            %mn 3
                        %mtd
                          %mo =
                          %msub
                            %mi G
                            %mn 2
                          %mo ∧
                          %msub
                            %mi G
                            %mn 2
                      %mtr
                        %mtd
                          %mi{:mathvariant => "normal"} d
                          %msub
                            %mi H
                            %mn 1
                        %mtd
                          %mo =
                          %msup
                            %mi ϕ
                            %mo *
                          %msub
                            %mi G
                            %mn 2
                          %mpadded{:width => "0"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                              %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  \\mathrm{d} G_2 &amp; = 0
                  \\\
                  \\mathrm{d} G_3 &amp; = G_2 \wedge G_2
                  \\\
                  \\mathrm{d} H_1 &amp; = \phi^\ast G_2
                  \\mathrlap{\,.}
                  \\end{aligned}
          %p
            The first two are the Bianchi identities of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/5D+Maxwell-Chern-Simons+theory"} 5D Maxwell-Chern-Simons theory
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/D%3D5+supergravity"} D=5 supergravity
          %p
            There is a close
            %a{:href => "D=5+supergravity#ViaCYCompactificationOf11dSupergravity"} structural analogy
            between this
            %a.existingWikiWord{:href => "/nlab/show/D%3D5+supergravity"} D=5 supergravity
            on one hand and
            %a.existingWikiWord{:href => "/nlab/show/D%3D11+supergravity"} D=11 supergravity
            on the other. The latter has
            %a.existingWikiWord{:href => "/nlab/show/Bianchi+identities"} Bianchi identities
            (for the
            %a.existingWikiWord{:href => "/nlab/show/supergravity+C-field"} supergravity C-field
            %a.existingWikiWord{:href => "/nlab/show/flux+densities"} flux densities
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi G
                    %mn 4
                %annotation{:encoding => "application/x-tex"} G_4
            and
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mn 7
                  %annotation{:encoding => "application/x-tex"} G_7
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mi{:mathvariant => "normal"} d
                          %msub
                            %mi G
                            %mn 4
                        %mtd
                          %mo =
                          %mn 0
                      %mtr
                        %mtd
                          %mi{:mathvariant => "normal"} d
                          %msub
                            %mi G
                            %mn 7
                        %mtd
                          %mo =
                          %msub
                            %mi G
                            %mn 4
                          %mo ∧
                          %msub
                            %mi G
                            %mn 4
                      %mtr
                        %mtd
                          %mi{:mathvariant => "normal"} d
                          %msub
                            %mi H
                            %mn 3
                        %mtd
                          %mo =
                          %msup
                            %mi ϕ
                            %mo *
                          %msub
                            %mi G
                            %mn 4
                          %mpadded{:width => "0"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                              %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  \\mathrm{d} G_4 &amp; = 0
                  \\\
                  \\mathrm{d} G_7 &amp; = G_4 \wedge G_4
                  \\\
                  \\mathrm{d} H_3 &amp; = \phi^\ast G_4
                  \\mathrlap{\,,}
                  \\end{aligned}
          %p
            where in the last line
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mn 3
                %annotation{:encoding => "application/x-tex"} H_3
            is the
            %a.existingWikiWord{:href => "/nlab/show/self-dual+higher+gauge+field"} chiral flux
            on the
            %a.existingWikiWord{:href => "/nlab/show/M5-brane"} M5-brane
            worldvolume.
          %p
            This makes the
            = succeed "-brane" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} L_1
            %a.existingWikiWord{:href => "/nlab/show/probe+brane"} probe brane
            version of the known
            %a.existingWikiWord{:href => "/nlab/show/black+string"} black string
            %a{:href => "black+string#ReferencesIn5DSuGra"} of
            %a.existingWikiWord{:href => "/nlab/show/D%3D5+supergravity"} D=5 supergravity
            (for which cf.
            = succeed "," do
              %a{:href => "D%3D5+supergravity#MizoguchiOhta98"} Mizoguchi &amp; Ohta 1998
            = succeed ")." do
              %a{:href => "D%3D5+supergravity#FujiiKemmokuMizoguchi00"} Fujii, Kemmoku &amp; Mizoguchi 2000
          %h2#references References
          %p Original articles:
          %ul
            %li#HoweSezgin97a
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paul+S.+Howe"}> Paul S. Howe
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ergin+Sezgin"} Ergin Sezgin
                = succeed "," do
                  %em Superbranes
                %strong 390
                (1997) 133-142 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/hep-th/9607227"}> arXiv:hep-th/9607227
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1016/S0370-2693(96)01416-5"} doi:10.1016/S0370-2693(96)01416-5
            %li#HoweRaetzelSezgin98
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paul+S.+Howe"}> Paul S. Howe
                , O. Raetzel,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ergin+Sezgin"} Ergin Sezgin
                = succeed "," do
                  %em On Brane Actions and Superembeddings
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/hep-th/9804051"} arXiv:hep-th/9804051
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1088/1126-6708/1998/08/011"} doi:10.1088/1126-6708/1998/08/011
            %li#HoweRaetzelRudychev99
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paul+S.+Howe"}> Paul S. Howe
                , O. Raetzel, I. Rudychev,
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Ergin+Sezgin"} Ergin Sezgin
                = succeed "," do
                  %em L-branes
                %strong 16
                (1999) 705-722 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/hep-th/9810081"}> arXiv:hep-th/9810081
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1088/0264-9381/16/3/006"} doi:10.1088/0264-9381/16/3/006
          %p Review:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Steven+Duplij"}> Steven Duplij
              \:
              = succeed "," do
                %em L-Brane
