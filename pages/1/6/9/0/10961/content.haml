              %a{:href => "https://doi.org/10.1063/1.2810963"}> doi:10.1063/1.2810963
              \&amp;rbrack;
          %p
            even though often mis-attributed to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Richard+Feynman"} Richard Feynman
          %ul
