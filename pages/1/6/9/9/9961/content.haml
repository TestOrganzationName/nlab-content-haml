            of the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo =
                  %mn 10
                %annotation{:encoding => "application/x-tex"} D = 10
            %a.existingWikiWord{:href => "/nlab/show/M-theory"} non-perturbative
            = succeed "/" do
