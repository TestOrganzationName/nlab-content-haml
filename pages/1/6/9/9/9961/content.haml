            %li
              %p
                Yuta Ito, Jun Nishimura, Asato Tsuchiya,
                %em Large-scale computation of the exponentially expanding universe in a simplified Lorentzian type IIB matrix model
                (
                %a{:href => "https://arxiv.org/abs/1512.01923"}> arXiv:1512.01923
                )
            %li#AHINT19
