                = succeed ")" do
                  %a{:href => "http://theory.tifr.res.in/~sgupta/talks/11aslft.pdf"} pdf
            %li
              %p
                G. Münster, M. Walzl,
                %em Lattice Gauge Theory - A short Primer
                (
                %a{:href => "http://arxiv.org/abs/hep-lat/0012005"}> arXiv:hep-lat/0012005
                )
            %li
              %p
