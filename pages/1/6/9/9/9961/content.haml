                  %strong 10
                  2445 (1974) &amp;lbrack;
                  %a{:href => "https://doi.org/10.1103/PhysRevD.10.2445"}> doi:10.1103/PhysRevD.10.2445
                  \&amp;rbrack;
          %p
            (
            %a{:href => "#Wilson74"} Wilson 1974
            envisioned to take the continuum limit by way of
            = succeed "," do
              %span.newWikiWord
