                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ev : P \to \mathbf{Ult}^L (\operatorname{Mod}(P) , Set )
              induces an equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                    %mo ≃
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Ult
                      %mi L
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Mod
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{E} \simeq \mathbf{Ult}^L ( \operatorname{Mod}(P) , Set )
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Ult
                      %mi L
                  %annotation{:encoding => "application/x-tex"} \mathbf{Ult}^L
              is the
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} 2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ev
                  %annotation{:encoding => "application/x-tex"} ev
              is an equivalence
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mo ≃
                      %mstyle{:mathvariant => "bold"}
                        %mi Ult
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} Mod
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi Set
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} P \simeq \mathbf{Ult} (\operatorname{Mod}(P) , Set )
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Ult
                  %annotation{:encoding => "application/x-tex"} \mathbf{Ult}
              is the
              %a.existingWikiWord{:href => "/nlab/show/locally+full+sub-2-category"} locally full sub-2-category
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Ult
                      %mi L
                  %annotation{:encoding => "application/x-tex"} \mathbf{Ult}^L
              determined by ultrafunctors.
          %p
            Lurie’s axiomatization was proved by
            %a{:href => "#Hamad"} Hamad
            to coincide with that of
            %a.existingWikiWord{:href => "/nlab/show/colax+algebra"} normal colax algebras
            for a
            %a.existingWikiWord{:href => "/nlab/show/pseudomonad"} pseudomonad
            on the 2-category of locally small categories.
            %a{:href => "#TarWrig"} Tarantino and Wrigley
            weakened Lurie’s definition to obtain an axiomatization of ultracategories sharing the same properties, but emerging universally from the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/ultrafilter+monad"} ultrafilter monad
            %a{:href => "#Saadia"} Saadia
            and
            %a{:href => "#HamadGen"} Hamad
            independently introduced
            %em virtual ultracategories
            as a
            %a.existingWikiWord{:href => "/nlab/show/generalized+multicategory"} multicategorical
            generalization of ultracategories which allows to extend Lurie’s result to
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/point+of+a+topos"} toposes with enough points
            %em virtual
            ultracategories categorify all topological spaces, allowing for maps into an abstract ultraproduct which may not exist in the underlying category.
          %h3#related_concepts Related concepts
          %ul
            %li
              %p
                %a{:href => "#ClemTholen"} Clementino and Tholen
                introduced a different concept of ultracategory as an instance of a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/generalized+multicategory"} generalized multicategory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/conceptual+completeness"} conceptual completeness
          %h2#references References
          %ul
            %li#Makkai87
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mihaly+Makkai"}> Mihaly Makkai
                ,
                = succeed "," do
                  %em Stone duality for first-order logic
                %strong 65
                2 (1987) 97–170 &amp;lbrack;
                %a{:href => "https://doi.org/10.1016/0001-8708(87)90020-X"}> doi:10.1016/0001-8708(87)90020-X
                ,
                = succeed "&rbrack;" do
                  %a{:href => "http://www.ams.org/mathscinet-getitem?mr=900266"} MR89h:03067
            %li
              %p
                Marek W. Zawadowski,
                = succeed "," do
                  %em Descent and duality
                = succeed "," do
                  %strong 71
            %li#Lurie
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
                ,
                %em Ultracategories
                \&amp;lbrack;
                %a{:href => "http://www.math.harvard.edu/~lurie/papers/Conceptual.pdf"}> pdf
                \&amp;rbrack;
          %p
            On a
            %a.existingWikiWord{:href => "/nlab/show/2-monad"} 2-monadic
            treatment of ultracategories:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Francisco+Marmolejo"}> Francisco Marmolejo
              ,
              = succeed "," do
                %em Ultraproducts and continuous families of models
              = succeed ";" do
                %a{:href => "https://dalspace.library.dal.ca/handle/10222/55092"} hdl:10222/55092
              = succeed "&rbrack;" do
                %a{:href => "http://peterlefanulumsdaine.com/files/marmolejo-1995-phd-thesis.pdf"} pdf
          %p
            As
            %a.existingWikiWord{:href => "/nlab/show/colax+algebra+for+a+2-monad"} colax algebras
            for a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/pseudomonad"} pseudomonad
          %ul
            %li#Hamad
              Ali Hamad,
              %em Ultracategories as colax algebras for a pseudo-monad on CAT
              \&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/2502.20597"}> arXiv:2502.20597
              \&amp;rbrack;
          %p
            In terms of
            %a.existingWikiWord{:href => "/nlab/show/Kan+extensions"} Kan extensions
            of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/relative+monads"} relative monads
          %ul
            %li#TarWrig
              %a.existingWikiWord{:href => "/nlab/show/Umberto+Tarantino"}> Umberto Tarantino
              , Joshua Wrigley,
              %em Ultracategories via Kan extensions of relative monads
              \&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/2506.09788"}> arXiv:2506.09788
              \&amp;rbrack;
          %p
            For a generalization to
            %em virtual
            ultracategories, a categorification of
            %a.existingWikiWord{:href => "/nlab/show/relational+beta-module"}
              relational
              = succeed "-modules" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi β
                    %annotation{:encoding => "application/x-tex"} \beta
            designed to allow reconstruction of any topos with enough points:
          %ul
            %li#Saadia
              %p
                Gabriel Saadia,
                %em Extending conceptual completeness via virtual ultracategories
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2506.23935"}> arXiv:2506.23935
                \&amp;rbrack;
            %li#HamadGen
              %p
                Ali Hamad,
                %em Generalised ultracategories and conceptual completeness of geometric logic
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2507.07922"}> arXiv:2507.07922
                \&amp;rbrack;
          %p For a different notion of ultracategory:
          %ul
            %li#ClemTholen
              %a.existingWikiWord{:href => "/nlab/show/Maria+Manuel+Clementino"}> Maria Manuel Clementino
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Walter+Tholen"} Walter Tholen
              = succeed "," do
                %em Metric, topology and multicategory–a common approach
              = succeed ")." do
                %a{:href => "https://doi.org/10.1016/S0022-4049%2802%2900246-3"} doi:10.1016/S0022-4049(02)00246-3
        .revisedby
