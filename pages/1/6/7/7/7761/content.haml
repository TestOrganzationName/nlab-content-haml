                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} T_2
            %a.existingWikiWord{:href => "/nlab/show/pretopos+completion"} pretopos completion
            of their coherent
