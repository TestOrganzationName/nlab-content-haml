            %a.existingWikiWord{:href => "/nlab/show/fully+faithful+2-functor"} 2-fully-faithful
            embedding
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
