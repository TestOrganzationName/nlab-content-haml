          %title Powering of -toposes over -groupoids
          %h3#PoweringOfInfinityToposesOverInfinityGroupoids
            Powering of
            = succeed "-toposes" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-groupoids" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            We discuss how the
            %a.existingWikiWord{:href => "/nlab/show/powering"} powering
            of
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-toposes"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
              \-toposes
            over
            %a.existingWikiWord{:href => "/nlab/show/Infinity-Grpd"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Grpd
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} Grpd_\infty
            is given by forming
            %a.existingWikiWord{:href => "/nlab/show/mapping+stacks"} mapping stacks
            out of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/locally+constant+infinity-stacks"}
                locally constant
                = succeed "-stacks" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+toposes"} Grothendieck toposes
          %p
            %br/
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            be an
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-topos"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
              \-topos
          %ul
            %li
              %p
                with terminal
                %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-geometric+morphism"} geometric morphism
                denoted
              #eq:TerminalGeometricMorphismAdjunction.maruku-equation
                %span.maruku-eq-number (1)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %munderover
                        %mrow
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mo ⊥
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                        %munder
                          %mo ⟶
                          %mi Γ
                        %mover
                          %mo ⟵
                          %mi LConst
                      %msub
                        %mi Grp
                        %mn ∞
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbf{H}
                      \\underoverset
                      {\underset{\Gamma}{\longrightarrow}}
                      {\overset{LConst}{\longleftarrow}}
                      {\;\;\;\;\bot\;\;\;\;}
                      Grp_\infty
                      \\,,
              %p
                where the
                %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
                constructs
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/locally+constant+infinity-stacks"}
                    locally constant
                    = succeed "-stacks" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mn ∞
                          %annotation{:encoding => "application/x-tex"} \infty
            %li
              %p
                and with its
                %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
                (
                %a.existingWikiWord{:href => "/nlab/show/mapping+stack"}> mapping stack
                )
                %a.existingWikiWord{:href => "/nlab/show/adjoint+%28infinity%2C1%29-functor"} adjunction
                denoted
              #eq:MappingStackAdjunction.maruku-equation
                %span.maruku-eq-number (2)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %munderover
                        %mrow
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mo ⊥
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                        %munder
                          %mo ⟶
                          %mrow
                            %mi Maps
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                        %mover
                          %mo ⟵
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                            %mo ×
                            %mi X
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbf{H}
                      \\underoverset
                      {\underset{Maps(X,-)}{\longrightarrow}}
                      { \overset{ (-) \times X }{\longleftarrow} }
                      {\;\;\;\; \bot \;\;\;\;}
                      \\mathbf{H}
              %p
                for
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mspace{:width => "thinmathspace"}
                        %mo ∈
                        %mspace{:width => "thinmathspace"}
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                      %annotation{:encoding => "application/x-tex"} X \,\in\, \mathbf{H}
              %p
                Notice that this construction is also
                %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-functor"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
                  \-functorial
                in the first argument:
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Maps
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mi X
                      %mover
                        %mo →
                        %mi f
                      %mi Y
                      %mo ,
                      %mspace{:width => "thinmathspace"}
                      %mi A
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %annotation{:encoding => "application/x-tex"} Maps\big( X \xrightarrow{f} Y ,\, A \big)
                is the morphism which under the
                %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-Yoneda+lemma"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
                  \-Yoneda lemma
                over
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}
                (which is large but locally small, so that the lemma does apply) corresponds to
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mi Maps
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi X
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mi A
