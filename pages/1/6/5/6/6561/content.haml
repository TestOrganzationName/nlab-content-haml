                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Pavel+Putrov"} Pavel Putrov
                = succeed "," do
                  %em Fivebranes and 4-manifolds
                = succeed "," do
                  %em Arbeitstagung Bonn 2013
                = succeed "," do
                  %strong 319
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/1306.4320"} arXiv:1306.4320
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/978-3-319-43648-7_7"} doi:10.1007/978-3-319-43648-7_7
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mykola+Dedushenko"}> Mykola Dedushenko
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Sergei+Gukov"} Sergei Gukov
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Pavel+Putrov"} Pavel Putrov
                = succeed "," do
                  %em Vertex algebras and 4-manifold invariants
                %em Geometry and Physics: Volume I
                (2018) 249–318 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1705.01645"}> arXiv:1705.01645
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1093/oso/9780198802013.003.0011"} doi:10.1093/oso/9780198802013.003.0011
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Boris+Feigin"}> Boris Feigin
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Sergei+Gukov"} Sergei Gukov
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi VOA
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi M
                          %mn 4
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} VOA[M_4]
                %strong 61
                012302 (2020) &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1806.02470"}> arXiv:1806.02470
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1063/1.5100059"} doi:10.1063/1.5100059
          %p
            In relation to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/M5-brane+elliptic+genus"} M5-brane elliptic genus
          %ul
            %li#GukovPeiPutrovVafa18
              %a.existingWikiWord{:href => "/nlab/show/Sergei+Gukov"}> Sergei Gukov
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Du+Pei"} Du Pei
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Pavel+Putrov"} Pavel Putrov
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Cumrun+Vafa"} Cumrun Vafa
              = succeed "," do
                %em 4-manifolds and topological modular forms
              %strong 2021
              84 (2021) &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/1811.07884"}> arXiv:1811.07884
              ,
              = succeed "," do
                %a{:href => "https://doi.org/10.1007/JHEP05(2021)084"} doi:10.1007/JHEP05(2021)084
              = succeed "&rbrack;" do
                %a{:href => "https://inspirehep.net/literature/1704312"} spire:1704312
          %p
            and in relation to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/QFT+with+defects"} defects
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jin+Chen"}> Jin Chen
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Wei+Cui"} Wei Cui
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Babak+Haghighat"} Babak Haghighat
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Yi-Nan+Wang"} Yi-Nan Wang
              = succeed "," do
                %em SymTFTs and Duality Defects from 6d SCFTs on 4-manifolds
              %strong 2023
              208 (2023) &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/2305.09734"}> arXiv:2305.09734
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1007/JHEP11(2023)208"} doi:10.1007/JHEP11(2023)208
          %h3#ade_classification ADE classification
          %p
            Discussion of the
            %a.existingWikiWord{:href => "/nlab/show/ADE+classification"} ADE classification
            of the 6d theories includes, after (
            %a{:href => "#Witten95"}> Witten95
            )
          %ul
            %li
              %p
                Julie D. Blum,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Kenneth+Intriligator"} Kenneth Intriligator
                = succeed "," do
                  %em New Phases of String Theory and 6d RG Fixed Points via Branes at Orbifold Singularities
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/hep-th/9705044"} arXiv:hep-th/9705044
            %li#HeckmannMorrisonVafa13
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jonathan+Heckman"}> Jonathan Heckman
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/David+Morrison"} David Morrison
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Cumrun+Vafa"} Cumrun Vafa
                %em On the Classification of 6D SCFTs and Generalized ADE Orbifolds
                (
                %a{:href => "http://arxiv.org/abs/1312.5746"}> arXiv:1312.5746
                )
          %h3#ModelsAndSpecialProperties Models and special properties
          %p
            Realization of the 6d theory in
            %a.existingWikiWord{:href => "/nlab/show/F-theory"} F-theory
            is discussed in (
            %a{:href => "#HeckmannMorrisonVafa13"}> Heckmann-Morrison-Vafa 13
            ).
          %p A proposal for related higher nonabelian differential form data is made in
          %ul
            %li#SSW11
              %a.existingWikiWord{:href => "/nlab/show/Henning+Samtleben"}> Henning Samtleben
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ergin+Sezgin"} Ergin Sezgin
              = succeed "," do
                %em (1,0) superconformal models in six dimensions
              %strong 2011
              62 (2011) &amp;lbrack;
              %a{:href => "http://arxiv.org/abs/1108.4060"}> arXiv:1108.4060
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1007/JHEP12(2011)062"} doi:10.1007/JHEP12(2011)062
          %p
            Since by
            %a.existingWikiWord{:href => "/nlab/show/transgression"} transgression
            every nonabelian
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/principal+2-bundle"} principal 2-bundle
            %a.existingWikiWord{:href => "/nlab/show/gerbe"} gerbe
            gives rise to some kind of nonabelian 1-bundle on
            %a.existingWikiWord{:href => "/nlab/show/loop+space"} loop space
            it is clear that some parts (but not all) of the nonabelian gerbe theory on the 5-brane has an equivalent reformulation in terms of ordinary gauge theory on the
            %a.existingWikiWord{:href => "/nlab/show/loop+space"} loop space
            of the 5-brane and possibly for gauge group the
            %a.existingWikiWord{:href => "/nlab/show/loop+group"} loop group
            of the original gauge group.
          %p Comments along these lines have been made in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Andreas+Gustavsson"}> Andreas Gustavsson
              ,
              %em Selfdual strings and loop space Nahm equations
              (
              %a{:href => "http://arxiv.org/abs/0802.3456"}> arXiv:0802.3456
              ).
          %p
            In fact, via the
            %a.existingWikiWord{:href => "/nlab/show/strict+2-group"} strict 2-group
            version of the
            %a.existingWikiWord{:href => "/nlab/show/string+2-group"} string 2-group
            there is a local gauge in which the loop group variables appear already before transgression of the 5-brane gerbe to loop space. This is discussed from a
            %a.existingWikiWord{:href => "/nlab/show/holographic+principle"} holographic
            point of view in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Domenico+Fiorenza"}> Domenico Fiorenza
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Hisham+Sati"} Hisham Sati
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
              %em
                %a.existingWikiWord{:href => "/schreiber/show/7d+Chern-Simons+theory+and+the+5-brane"} 7d Chern-Simons theory and the 5-brane
          %h3#ReferencesOnTheHolographicDual On the holographic dual
          %p
            The basics of the relation of the 6d theory to a 7d theory under
            %a.existingWikiWord{:href => "/nlab/show/AdS-CFT"} AdS-CFT
            is reviewed
            %a.existingWikiWord{:href => "/nlab/show/holographic+principle"} holographic duality
          %ul
            %li#Maldacena
              %a.existingWikiWord{:href => "/nlab/show/Juan+Maldacena"}> Juan Maldacena
              ,
              = succeed "," do
                %em The Large N limit of superconformal field theories and supergravity
              = succeed ";" do
                %a{:href => "http://arxiv.org/abs/hep-th/9711200"} hep-th/9711200
              = succeed "," do
                %em Wilson loops in Large N field theories
              %strong 80
              (1998) 4859,
              %a{:href => "http://arxiv.org/abs/hep-th/9803002"} hep-th/9803002
          %p
            The argument that the abelian
            %a.existingWikiWord{:href => "/nlab/show/7d+Chern-Simons+theory"} 7d Chern-Simons theory
            of a
            %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} 3-connection
            yields this way the
            %a.existingWikiWord{:href => "/nlab/show/conformal+blocks"} conformal blocks
            of the abelian
            %a.existingWikiWord{:href => "/nlab/show/self-dual+higher+gauge+theory"} self-dual higher gauge theory
            of the 6d theory on a
            %em single
            brane is due to
          %ul
            %li#WittenI
              %p
                %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"}> Edward Witten
                ,
                %em Five-Brane Effective Action In M-Theory
                J. Geom. Phys.22:103-133,1997 (
                %a{:href => "http://arxiv.org/abs/hep-th/9610234"}> arXiv:hep-th/9610234
                )
            %li#Witten98
              %p
                %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"}> Edward Witten
                ,
                %em AdS/CFT Correspondence And Topological Field Theory
                JHEP 9812:012,1998 (
                %a{:href => "http://arxiv.org/abs/hep-th/9812012"}> arXiv:hep-th/9812012
                )
          %p
            The nonabelian generalization of this 7d action functional that follows from taking the quantum corrections (
            %a.existingWikiWord{:href => "/nlab/show/Green-Schwarz+mechanism"} Green-Schwarz mechanism
            and flux quantization) of the
            %a.existingWikiWord{:href => "/nlab/show/supergravity+C-field"} supergravity C-field
            into account is discussed in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Domenico+Fiorenza"}> Domenico Fiorenza
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Hisham+Sati"} Hisham Sati
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
              %em
                %a.existingWikiWord{:href => "/schreiber/show/7d+Chern-Simons+theory+and+the+5-brane"} 7d Chern-Simons theory and the 5-brane
          %p See also
          %ul
            %li#HEGK
              %p
                %a.existingWikiWord{:href => "/nlab/show/Eric+D%27Hoker"}> Eric D'Hoker
                , John Estes, Michael Gutperle, Darya Krym,
              %p
                %em Exact Half-BPS Flux Solutions in M-theory I Local Solutions
                (
                %a{:href => "http://arxiv.org/abs/0806.0605"}> arXiv:0806.0605
                )
              %p
                %em
                  Exact Half-BPS Flux Solutions in M-theory II: Global solutions asymptotic to
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi AdS
                          %mn 7
                        %mo ×
                        %msup
                          %mi S
                          %mn 4
                      %annotation{:encoding => "application/x-tex"} AdS_7 \times S^4
                  (
                  %a{:href => "http://arxiv.org/abs/0810.4647"}> arXiv:0810.4647
                  )
          %h3#solitonic_1brane_excitations Solitonic 1-brane excitations
          %ul
            %li#GGT
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jerome+Gauntlett"}> Jerome Gauntlett
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Joaquim+Gomis"} Joaquim Gomis
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Paul+Townsend"} Paul Townsend
                %em BPS Bounds for Worldvolume Branes
                (
                %a{:href => "http://arxiv.org/abs/hep-th/9711205"}> arXiv:hep-th/9711205
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paul+Howe"}> Paul Howe
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Neil+Lambert"} Neil Lambert
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Peter+West"} Peter West
                %em The Threebrane Soliton of the M-Fivebrane
                (
                %a{:href => "http://arxiv.org/abs/hep-th/9710033"}> arXiv:hep-th/9710033
                )
          %div
            %h3#TheoryXAsAnFQFTReferences
              The
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %mo =
                      %mn 6
                    %annotation{:encoding => "application/x-tex"} D=6
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒩
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{N}=(2,0)
              SCFT as an extended functorial field theory
            %p
              On the (conjectural) suggestion to view at least some aspects of the
              %a.existingWikiWord{:href => "/nlab/show/D%3D6+N%3D%282%2C0%29+SCFT"} D=6 N=(2,0) SCFT
              (such as its
              %a.existingWikiWord{:href => "/nlab/show/quantum+anomaly"} quantum anomaly
              or its image as a
              %a.existingWikiWord{:href => "/nlab/show/2d+TQFT"} 2d TQFT
              under the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/AGT+correspondence"} AGT correspondence
              %a.existingWikiWord{:href => "/nlab/show/functorial+field+theory"} functorial field theory
              given by a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              on a suitable
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cobordism+category"} cobordism category
              %a.existingWikiWord{:href => "/nlab/show/extended+TQFT"} extended
              such
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/FQFT"} FQFT
              %a.existingWikiWord{:href => "/nlab/show/n-functor"} n-functor
              (at least a
              %a.existingWikiWord{:href => "/nlab/show/2-functor"} 2-functor
              on a
              = succeed "):" do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C2%29-category+of+cobordisms"} 2-category of cobordisms
            %ul
              %li#Witten09
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"}> Edward Witten
                  , Section 1 of:
                  = succeed "," do
                    %em Geometric Langlands From Six Dimensions
                  = succeed "," do
                    %em A Celebration of the Mathematical Legacy of Raoul Bott
                  = succeed "," do
                    %a{:href => "http://arxiv.org/abs/0905.2720"} arXiv:0905.2720
                  = succeed ")" do
                    %a{:href => "https://bookstore.ams.org/crmp-50"} ISBN:978-0-8218-4777-0
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Daniel+Freed"}> Daniel Freed
                  ,
                  = succeed "," do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/4-3-2+8-7-6"} 4-3-2 8-7-6
                  %em
                    %a{:href => "https://people.maths.ox.ac.uk/tillmann/ASPECTS.html"} ASPECTS of Topology
                  Dec 2012 (
                  %a{:href => "https://people.maths.ox.ac.uk/tillmann/ASPECTSfreed.pdf"}> pdf
                  ,
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/files/Freed432876.pdf", :title => "pdf"} pdf
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Daniel+Freed"}> Daniel Freed
                  , p. 32 of:
                  = succeed "," do
                    %em The cobordism hypothesis
                  = succeed "," do
                    %a{:href => "http://arxiv.org/abs/1210.5100"} arXiv:1210.5100
                  = succeed ")" do
                    %a{:href => "https://doi.org/10.1090/S0273-0979-2012-01393-9"} doi:10.1090/S0273-0979-2012-01393-9
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Daniel+Freed"}> Daniel Freed
                  ,
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/Constantin+Teleman"} Constantin Teleman
                  = succeed "," do
                    %em Relative quantum field theory
                  %strong 326
                  (2014) 459–476 [
                  %a{:href => "https://doi.org/10.1007/s00220-013-1880-1"}> doi:10.1007/s00220-013-1880-1
                  ,
                  = succeed "]" do
                    %a{:href => "https://arxiv.org/abs/1212.1692"} arXiv:1212.1692
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/David+Ben-Zvi"}> David Ben-Zvi
                  \:
                  = succeed "," do
                    %em
                      Theory
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝒳
                          %annotation{:encoding => "application/x-tex"} \mathcal{X}
                      and Geometric Representation Theory
                  %em
                    %a{:href => "http://www.ihes.fr/~celliott/workshop/"} Mathematical Aspects of Six-Dimensional Quantum Field Theories
                  IHES 2014, notes by
                  %a.existingWikiWord{:href => "/nlab/show/Qiaochu+Yuan"} Qiaochu Yuan
                  (
                  %a.existingWikiWord{:href => "/nlab/files/BenZvi-TheoryX-I.pdf", :title => "pdf"}> pdf
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/files/BenZvi-TheoryX-II.pdf", :title => "pdf"} pdf
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/files/BenZvi-TheoryX-III.pdf", :title => "pdf"} pdf
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/David+Ben-Zvi"}> David Ben-Zvi
                  ,
                  = succeed "," do
                    %em Algebraic geometry of topological field theories
                  %em
                    %a{:href => "https://www.msri.org/workshops/689"} Reimagining the Foundations of Algebraic Topology April 07, 2014 - April 11, 2014
                  (
                  %a{:href => "https://www.msri.org/workshops/689/schedules/18216"}> web video
                  )
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Lukas+M%C3%BCller"}> Lukas Müller
                  ,
                  %em Extended Functorial Field Theories and Anomalies in Quantum Field Theories
                  (
