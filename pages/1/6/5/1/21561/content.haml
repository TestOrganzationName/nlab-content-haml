          %h2#section_Idea Idea
          %p
            The notion referred to as
            %em equiv-fibrations
            \&amp;lbrack;
            %a{:href => "#Lack02"}> Lack 2002
            \&amp;rbrack; or
            %em equifibrations
            \&amp;lbrack;
            %a{:href => "#Campbell20"}> Campbell 2020, Def. 4.1
            \&amp;rbrack; (both meant to be short fort
            = succeed ")" do
              %em equivalence-fibrations
            %em Lack fibrations
            \&amp;lbrack;
            %a{:href => "#MoserSarazolaVerdugo22"}> Moser, Sarazola &amp; Verdugo 2022
            \&amp;rbrack; is a
            %a.existingWikiWord{:href => "/nlab/show/categorification"} categorification
            of that of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/isofibrations"} isofibrations
            %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
            to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/2-category+theory"} 2-category theory
            %a.existingWikiWord{:href => "/nlab/show/2-functor"} 2-functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo{:lspace => "verythinmathspace"} :
                  %mi E
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} p \colon E \rightarrow B
            between
            %a.existingWikiWord{:href => "/nlab/show/2-categories"} 2-categories
            is an equifibration if
            %a.existingWikiWord{:href => "/nlab/show/equivalence+in+a+2-category"} equivalences
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            can be ‘lifted’ to equivalences in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
          %p
            Beware that there is unrelated terminology of
            %em
              %a.existingWikiWord{:href => "/nlab/show/equifibered+natural+transformation"} equifibered
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/natural+transformations"} natural transformations
          %p
          %h2#section_Explicit_definition Explicit definition
          %p
            The following works for both
            %a.existingWikiWord{:href => "/nlab/show/weak+2-category"} weak
            and
            %a.existingWikiWord{:href => "/nlab/show/strict+2-categories"} strict 2-categories
            and
            %a.existingWikiWord{:href => "/nlab/show/weak+2-functor"} weak
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/strict+2-functors"} strict 2-functors
          %p
          #DefinitionEquifibration.num_defn
            %h6 Definition
            %p
              A
              %em equifibration
              is a
              %a.existingWikiWord{:href => "/nlab/show/2-functor"} 2-functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %mi E
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} p \colon E \rightarrow B
              between
              %a.existingWikiWord{:href => "/nlab/show/2-categories"} 2-categories
              such that, for every
              %a.existingWikiWord{:href => "/nlab/show/object"} object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %a.existingWikiWord{:href => "/nlab/show/1-morphism"} 1-morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi b
