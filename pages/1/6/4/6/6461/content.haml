                          %mn 0
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %mi g
                          %mo ∘
                          %mi α
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo{:stretchy => "false"} )
                          %mo +
                          %mn 2
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo ∘
                          %mi α
                          %mo{:stretchy => "false"} )
                          %mo ′
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %mi g
                          %mo ∘
                          %mi α
                          %mo{:stretchy => "false"} )
                          %mo ′
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo{:stretchy => "false"} )
                          %mo +
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo ∘
                          %mi α
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %mi g
                          %mo ∘
                          %mi α
                          %mo{:stretchy => "false"} )
                          %mo ″
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo ∘
                          %mi α
                          %mo{:stretchy => "false"} )
                          %mo ″
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %mi g
                          %mo ∘
                          %mi α
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo{:stretchy => "false"} )
                          %mo +
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo ∘
                          %mi α
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %mi g
                          %mo ∘
                          %mi α
                          %mo{:stretchy => "false"} )
                          %mo ″
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo{:stretchy => "false"} )
                          %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  ((f g) \circ \alpha )''(0) &amp;= (f \circ \alpha )''(0) (g \circ \alpha )(0) + 2 (f \circ \alpha )'(0) (g \circ \alpha )'(0) + (f \circ \alpha )(0) (g \circ \alpha )''(0) \\    &amp;= (f \circ \alpha )''(0) (g \circ \alpha )(0) + (f \circ \alpha )(0) (g \circ \alpha )''(0).
                  \\end{aligned}
          %p With this in mind, we can define higher level kinematic tangent spaces.
          #defnc.num_defn
            %h6#definition_4 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a smooth space. Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              be a point. Let
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
                th kinematic tangent space
              at
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mrow
                          %mi x
                          %mo ,
                          %mi k
                      %mi X
                    %annotation{:encoding => "application/x-tex"} T_{x,k} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo{:lspace => "verythinmathspace"} :
                    %mi ℝ
                    %mi to
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \alpha \colon \mathbb{R} to X
              with the property that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi x
                  %annotation{:encoding => "application/x-tex"} \alpha (0) = x
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ∘
                    %mi α
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi j
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} (f \circ \alpha )^{(j)}(0) = 0
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ≤
                    %mi j
                    %mo ≤
                    %mi k
                    %mo −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1 \le j \le k - 1
              and smooth
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo →
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} f \colon X \to \mathbb{R}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo ≃
                    %mi β
                  %annotation{:encoding => "application/x-tex"} \alpha \simeq \beta
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ∘
                    %mi α
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi k
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ∘
                    %mi β
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi k
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (f \circ \alpha )^{(k)}(0) = (f \circ \beta )^{(k)}(0)
              for all smooth functions
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo →
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} f \colon X \to \mathbb{R}
            %p
              The
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
                th kinematic tangent bundle
              is defined similarly.
          %p
            There is an obvious map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mrow
                      %mi x
                      %mo ,
                      %mi k
                  %mi X
                  %mo →
                  %msub
                    %mi T
                    %mrow
                      %mi x
                      %mo ,
                      %mi m
                      %mi k
                  %mi X
                %annotation{:encoding => "application/x-tex"} T_{x,k} X \to T_{x,m k} X
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                  %mo ∈
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} m \in \mathbb{N}
            given by precomposition with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi t
                      %mi m
                  %annotation{:encoding => "application/x-tex"} t^{m}
            %a.existingWikiWord{:href => "/nlab/show/poset"} poset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} \mathbb{N}
            with divisibility as the order. We can define the
            %em full
            kinematic tangent space at
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            as the colimit of this diagram.
          %p
            The structure of the higher kinematic tangent spaces is somewhat complicated. For example, in the second kinematic tangent space then
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mi v
                    %mo =
                    %mi v
                  %annotation{:encoding => "application/x-tex"} (-1) \cdot v = v
          %p In the following we shall concentrate on the first kinematic tangent space.
          #sectionc.num_section
          %h2#properties.num_section Properties
          %p In this section, we shall gather various results on kinematic tangent spaces that will be of use elsewhere.
          %p Because the kinematic tangent space is defined using curves, it has nice properties with respect to limits and mapping spaces. However, as it also uses quotients, these properties are not necessarily as nice as they could be.
          #propositiona.num_prop
            %h6#proposition Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X,Y
              be smooth spaces. There is a natural isomorphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ×
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi T
                      %mi X
                      %mo ×
                      %mi T
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} T(X \times Y) \to T X \times T Y
          .proof
            %p
              The map in the given direction is obvious: the projection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi Y
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X \times Y \to X
              is smooth and so induces a map
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ×
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi T
                      %mi X
                    %annotation{:encoding => "application/x-tex"} T(X \times Y) \to T X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi T
                    %mi X
                    %mo ×
                    %mi T
                    %mi Y
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    T(X   \times Y) \to T X \times T Y.
            %p
              For the other direction, we need to consider curves. The result will hinge on the fact that when testing the equivalence relation for curves in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ×
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X \times Y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi Y
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} X \times Y \to \mathbb{R}
              that factor through one of the projections.
            %p
              To see this, consider curves
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo{:lspace => "verythinmathspace"} :
                    %mi ℝ
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \alpha \colon \mathbb{R} \to X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                    %mo{:lspace => "verythinmathspace"} :
                    %mi ℝ
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} \beta \colon \mathbb{R} \to Y
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi ℝ
                    %mo →
                    %mi X
                    %mo ×
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} \gamma \colon \mathbb{R} \to X \times Y
              be their product. Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ×
                    %mi Y
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} f \colon X \times Y \to \mathbb{R}
              be a smooth function. The composition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∘
                    %mi γ
                  %annotation{:encoding => "application/x-tex"} f \circ \gamma
              factors as:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                    %mover
                      %mo →
                      %mi Δ
                    %mi ℝ
                    %mo ×
                    %mi ℝ
                    %mover
                      %mo →
                      %mrow
                        %mi α
                        %mo ×
                        %mi β
                    %mi X
                    %mo ×
                    %mi Y
                    %mover
                      %mo →
                      %mi f
                    %mi ℝ
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R} \xrightarrow{\Delta } \mathbb{R} \times \mathbb{R} \xrightarrow{\alpha \times \beta } X \times Y \xrightarrow{f} \mathbb{R}.
            %p
              Thus the derivative of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ∘
                      %mi γ
                    %annotation{:encoding => "application/x-tex"} f \circ \gamma
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo ,
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi α
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi β
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (s,t) \mapsto f(\alpha (s),\beta (t))
              at
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo ,
                      %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (0,0)
              = succeed "-derivative" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                    %annotation{:encoding => "application/x-tex"} s
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
              fixed and vary
              = succeed "\u201D." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                    %annotation{:encoding => "application/x-tex"} s
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo ↦
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi α
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi β
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    s \mapsto f(\alpha (s),\beta (0)).
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi y
                      %mn 0
                    %mo =
                    %mi β
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} y_{0} = \beta (0)
              and define
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} g \colon X \to \mathbb{R}
              as
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %msub
                        %mi y
                        %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} g(x) = f(x,y_{0})
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo ∘
                      %mi α
                    %annotation{:encoding => "application/x-tex"} g \circ \alpha
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 0
                    %mo =
                    %mi α
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x_{0} = \alpha (0)
              and define
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Y
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} h \colon Y \to \mathbb{R}
              as
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi f
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi x
                        %mn 0
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} h(y) = f(x_{0},y)
            %p Hence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ∘
                    %mi γ
                    %mo{:stretchy => "false"} )
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mrow
                      %mo [
                      %mrow
                        %mtable{:displaystyle => "false", :rowspacing => "0.5ex"}
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mi g
                              %mo ∘
                              %mi α
                              %mo{:stretchy => "false"} )
                              %mo ′
                              %mo{:stretchy => "false"} (
                              %mn 0
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mi h
                              %mo ∘
                              %mi β
                              %mo{:stretchy => "false"} )
                              %mo ′
                              %mo{:stretchy => "false"} (
                              %mn 0
                              %mo{:stretchy => "false"} )
                      %mo ]
                    %mi D
                    %msub
                      %mi Δ
                      %mn 0
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (f \circ \gamma )'(0) = \begin{bmatrix} (g \circ \alpha )'(0) &amp; (h \circ \beta )'(0) \end{bmatrix} D \Delta _{0}.
            %p
              From this we see that the map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi T
                    %mi X
                    %mo ×
                    %mi T
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} T (X \times Y) \to T X \times T Y
              is injective. It is clearly surjective, and thus it remains to show that it is a diffeomorphism.
            %p
              This follows from the fact that they can both be written as quotients of the same space. For this, we use the natural isomorphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi ℝ
                      %mo ,
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi ℝ
                      %mo ,
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %mo ≅
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi ℝ
                      %mo ,
                      %mi X
                      %mo ×
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} C^{\infty } (\mathbb{R}, X) \times C^{\infty } (\mathbb{R},Y) \cong C^{\infty } (\mathbb{R}, X \times Y
          %p For mapping spaces, we have an obvious map in one direction. A tangent vector at a map is an infinitesimal deformation of that map. Evaluation yields deformations at each point which fit together to give a family of deformations. A simple diagram chase shows that everything involved is smooth.
          #propositionb.num_prop
            %h6#proposition_2 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ,
                    %mi X
                  %annotation{:encoding => "application/x-tex"} S, X
              be smooth spaces. There is a natural transformation
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi TC
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo ,
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo →
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo ,
                      %mi T
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} TC^{\infty } (S, X) \to C^{\infty } (S,T X)
          .proof
            %p
              The natural transformation is build up as follows. We start with the evaluation map,
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo ×
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo ,
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} S \times C^{\infty } (S,X) \to X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ×
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi T
                    %mi X
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    T (S \times C^{\infty } (S,X)) \to T X.
            %p
              We can compose that with the natural isomorphism from Proposition 
              %a{:href => "#propositiona"} 1
              to obtain:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mi S
                    %mo ×
                    %mi T
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi T
                    %mi X
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    T S \times T C^{\infty } (S,X) \to T X.
            %p
              Composing this with the zero section on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mi S
                  %annotation{:encoding => "application/x-tex"} T S
              yields:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ×
                    %mi T
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi T
                    %mi X
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S \times T C^{\infty } (S,X) \to T X.
            %p Whereupon the adjunction comes in to play to produce:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ,
                    %mi T
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    T C^{\infty } (S,X) \to C^{\infty } (S, T X)
            %p as required.
