                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
          #sectionb.num_section
          %h2#definition.num_section Definition
          %p
            Unless otherwise specified, we shall assume that we have fixed an arbitrary category of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/generalised+smooth+space"} generalised smooth space
          #defna.num_defn
            %h6#definition_2 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a smooth space. Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              be a point. The
              %em kinematic tangent space
              at
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
