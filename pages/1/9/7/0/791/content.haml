                  %a{:href => "#homotopy_types_as_simplicial_groupoids"}
                    Homotopy
                    = succeed "-types" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mn 2
                          %annotation{:encoding => "application/x-tex"} 2
                %li
                  %a{:href => "#homotopy_types_as_groupoids"}
                    Homotopy
                    = succeed "-types" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mn 2
                          %annotation{:encoding => "application/x-tex"} 2
                    = succeed "-groupoids" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mn 2
                          %annotation{:encoding => "application/x-tex"} 2
                %li
                  %a{:href => "#homotopy_2types_as_double_groupoids"} Homotopy 2-types as double groupoids
              %li
                %a{:href => "#related_concepts"} Related concepts
          %h2#idea Idea
          %p
            A homotopy
            = succeed "-type" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
            = succeed "nd" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
            %a.existingWikiWord{:href => "/nlab/show/homotopy+group"} homotopy group
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \pi_2
          %h2#definition Definition
          %p
            A continuous map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X \to Y
            is a
            %strong
              homotopy
              = succeed "-equivalence" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} 2
            if it induces isomorphisms on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mi i
                %annotation{:encoding => "application/x-tex"} \pi_i
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo =
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo ,
                  %mn 2
                %annotation{:encoding => "application/x-tex"} i = 0, 1, 2
            at each basepoint. Two spaces share the same
            %strong
              homotopy
              = succeed "-type" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} 2
            if they are linked by a zig-zag chain of homotopy
            = succeed "-equivalences." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
          %p
            For any ‘nice’ space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            so that the inclusion of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            into
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            is a homotopy
            = succeed "-equivalence;" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
            = succeed "-type." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
            %strong
              homotopy
              = succeed "-type" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} 2
            may alternatively be defined as a space with trivial
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mi i
                %annotation{:encoding => "application/x-tex"} \pi_i
            for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo &gt;
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} i \gt 2
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
            of such a space, or as its fundamental
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/fundamental+infinity-groupoid"} groupoid
            (which will be a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/2-groupoid"} groupoid
          %p
            See the general discussion in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+n-type"} homotopy n-type
          %h2#classification Classification
          %p
            Homotopy
            = succeed "-types" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
          %h3#homotopy_types_as_crossed_modules
            Homotopy
            = succeed "-types" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
          %p
            Homotopy
            = succeed "-types" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/crossed+module"} crossed module
            = succeed "-truncated" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
            = succeed "es." do
              %a.existingWikiWord{:href => "/nlab/show/crossed+complex"} crossed complex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            consists of a morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi δ
                  %mo :
                  %msub
                    %mi C
                    %mn 2
                  %mo →
                  %msub
                    %mi C
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \delta: C_2 \to C_1
          %p
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mn 0
                %annotation{:encoding => "application/x-tex"} C_0
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mn 2
                %annotation{:encoding => "application/x-tex"} C_2
            is totally disconnected, i.e. is a family of groups
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi x
                    %mo ∈
                    %msub
                      %mi C
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} C_2(x), x \in C_0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mn 1
                %annotation{:encoding => "application/x-tex"} C_1
            operates on this family of groups so that (using right operations) if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo :
                  %mi x
                  %mo →
                  %mi y
                %annotation{:encoding => "application/x-tex"} a: x \to y
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mn 1
                %annotation{:encoding => "application/x-tex"} C_1
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                  %mo ∈
                  %msub
                    %mi C
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} u \in C_2(x)
            then
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi u
                      %mi a
                    %mo ∈
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} u^a \in C(y)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi uv
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi a
                    %mo =
                    %msup
                      %mi u
                      %mi a
                    %msup
                      %mi v
                      %mi a
                  %annotation{:encoding => "application/x-tex"} (uv)^a=u^a v^a
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi u
                      %mn 1
                    %mo =
                    %mi u
                  %annotation{:encoding => "application/x-tex"} u^1=u
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi u
                    %mi a
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi b
                  %mo =
                  %msup
                    %mi u
                    %mrow
                      %mi a
                      %mi b
                %annotation{:encoding => "application/x-tex"} (u^a)^b=u^{a b}
            when these are defined. Further the two basic crossed module rules hold:
          %p
            CM1)
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi u
                      %mi a
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi a
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi δ
                    %mi u
                    %mo{:stretchy => "false"} )
                    %mi a
                  %annotation{:encoding => "application/x-tex"} \delta(u^a)= a^{-1} (\delta u) a
          %p
            CM2)
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi v
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mi u
                    %mi v
                    %mo =
                    %msup
                      %mi u
                      %mrow
                        %mi δ
                        %mi v
                  %annotation{:encoding => "application/x-tex"} v^{-1} u v = u ^{\delta v}
          %p
            for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ∈
                  %msub
                    %mi C
                    %mn 1
                  %mo ,
                  %mi u
                  %mo ,
                  %mi v
                  %mo ∈
                  %msub
                    %mi C
                    %mn 2
                %annotation{:encoding => "application/x-tex"} a \in C_1, u,v \in C_2
            when the rules make sense.
          %p
            Such a crossed module may be extended to a crossed complex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi sk
                    %mn 2
                  %mi C
                %annotation{:encoding => "application/x-tex"} sk^2 C
            by adding trivial elements in dimensions higher than 2. Hence there is a simplicial
            %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi N
                    %mi Δ
                  %mi C
                %annotation{:encoding => "application/x-tex"} N^\Delta C
            which in dimension
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Crs
                  %mo{:stretchy => "false"} (
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi Δ
                    %mo *
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msup
                    %mi sk
                    %mn 2
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} Crs(\Pi (\Delta^n_*), sk^2 C).
          %p
            The geometric realisation of this is the
            %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi BC
                  %annotation{:encoding => "application/x-tex"} BC
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %msub
                    %mi C
                    %mn 0
                %annotation{:encoding => "application/x-tex"} x \in C_0
            are the cokernel and kernel of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %mo :
                    %msub
                      %mi C
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi C
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \delta: C_2(x) \to C_1(x,x)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} C_1
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a CW-complex then there is a bijection of homotopy classes
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mi BC
                  %mo{:stretchy => "false"} ]
                  %mo ≅
                  %mo{:stretchy => "false"} [
                  %mi Π
                  %msub
                    %mi X
                    %mo *
                  %mo ,
                  %msup
                    %mi sk
                    %mn 2
                  %mi C
                  %mo{:stretchy => "false"} ]
                  %mo ,
                %annotation{:encoding => "application/x-tex"} [X,BC] \cong [\Pi X_*, sk^2 C],
          %p
            and hence there is a map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mi B
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi cotr
                    %mn 2
                  %mi Π
                  %msub
                    %mi X
                    %mo *
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X \to B(cotr^2 \Pi X_*)
            inducing isomorphisms of homotopy groups in dimensions 1 and 2.
          %p
            Here the cotruncation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi cotr
                    %mi n
                  %mi D
                %annotation{:encoding => "application/x-tex"} cotr^n D
            of a general crossed complex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            agree with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            up to dimension
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n-1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cok
                  %msub
                    %mi δ
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                %annotation{:encoding => "application/x-tex"} Cok \delta_{n+1}
            in dimension
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p
            It is in this sense that crossed modules of groupoids classify weak homotopy
            = succeed "-types." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
          %p
            The category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Crs
                    %mn 2
                %annotation{:encoding => "application/x-tex"} Crs^2
            of such crossed modules of groupoids is equivalent to that of strict
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/2-groupoid"} 2-groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Crs
                    %mn 2
                %annotation{:encoding => "application/x-tex"} Crs^2
            is
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} monoidal closed
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Crs
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ⊗
                  %mi D
                  %mo ,
                  %mi E
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %msup
                    %mi Crs
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %msup
                    %mi CRS
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi D
                  %mo ,
                  %mi E
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Crs^2(C \otimes D, E) \cong Crs^2(C, CRS^2(D,E))
          %p
            and with a unit interval object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            so that (left) homotopies are determined as morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Crs
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi I
                  %mo ⊗
                  %mi D
                  %mo ,
                  %mi E
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Crs^2(I \otimes D,E)
            or as elements of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi CRS
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi D
                    %mo ,
                    %mi E
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} CRS^2(D,E)_1
          %h3#homotopy_types_as_simplicial_groupoids
            Homotopy
            = succeed "-types" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
          %p
            As a crossed module give rise to an internal groupoid in the category of groups (or groupoids), we can take the nerve of that structure and get a simplicial group (or
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+groupoid"} simplicially enriched groupoid
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi W
                    %mo ¯
                  %mi G
                %annotation{:encoding => "application/x-tex"} \overline{W}G
            of the simplicial group,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+group"} simplicial group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            form a simplicial group and then take
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi W
                    %mo ¯
                %annotation{:encoding => "application/x-tex"} \overline{W}
            of that to get another model of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℬ
                    %mi C
                  %annotation{:encoding => "application/x-tex"} \mathcal{B}C
          %h3#homotopy_types_as_groupoids
            Homotopy
            = succeed "-types" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
            = succeed "-groupoids" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
          %p
            With respect to the standard
            = succeed "-structure" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            %a.existingWikiWord{:href => "/nlab/show/2-groupoids"} 2-groupoids
            (
            %a.existingWikiWord{:href => "/nlab/show/2-truncated"} 2-truncated
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/infinity-groupoids"} infinity-groupoids
            %em
              %a.existingWikiWord{:href => "/nlab/show/homotopy+hypothesis"} homotopy hypothesis
            for more on this.
