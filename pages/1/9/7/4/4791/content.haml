          %h2#related_entries Related entries
          %p
            The group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mn 8
                %annotation{:encoding => "application/x-tex"} E_8
            plays a role in some exceptional
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/differential+geometry"} differential geometry
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/differential+cohomology"} differential cohomology
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/exceptional+generalized+geometry"}> exceptional generalized geometry
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/supergravity+C-field"} supergravity C-field
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ho%C5%99ava-Witten+theory"} Hořava-Witten theory
                %a.existingWikiWord{:href => "/nlab/show/heterotic+string+theory"} heterotic string theory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/G%E2%82%82"}> G₂
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/F%E2%82%84"} F₄
              %p
                %a.existingWikiWord{:href => "/nlab/show/E%E2%82%86"}> E₆
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/E%E2%82%87"} E₇
                = succeed "," do
                  %strong E₈
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/E%E2%82%89"} E₉
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/E%E2%82%81%E2%82%80"} E₁₀
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/E%E2%82%81%E2%82%81"} E₁₁
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
