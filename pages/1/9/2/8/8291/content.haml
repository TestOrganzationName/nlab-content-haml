          #RightAdjointsOfExactFunctorsPreserveInjectives.num_lemma
            %h6#lemma Lemma
            %p
              Given a pair of
              %a.existingWikiWord{:href => "/nlab/show/additive+functor"} additive
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
