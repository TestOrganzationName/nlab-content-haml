                    %mrow
                      %mi k
                      %mo{:lspace => "verythinmathspace"} :
                      %mi R
                      %mo →
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} k \colon R \to Q
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo ″
                  %annotation{:encoding => "application/x-tex"} M''
              as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
