          .proof
            %h6#sketch_of_proof Sketch of proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %mi M
                    %mo ↪
                    %mi N
                  %annotation{:encoding => "application/x-tex"} i \colon M \hookrightarrow N
              be a
              %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mi Mod
                    %annotation{:encoding => "application/x-tex"} R Mod
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi M
                    %mo →
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} f \colon M \to Q
              be a map. We must extend
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              to a map
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                      %mo{:lspace => "verythinmathspace"} :
                      %mi N
                      %mo →
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} h \colon N \to Q
              %a.existingWikiWord{:href => "/nlab/show/poset"} poset
              whose elements are pairs
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ′
                    %mo ,
                    %mi f
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (M', f')
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} M'
              is an intermediate
              %a.existingWikiWord{:href => "/nlab/show/submodule"} submodule
              between
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ′
                    %mo{:lspace => "verythinmathspace"} :
                    %mi M
                    %mo ′
                    %mo →
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} f' \colon M' \to Q
              is an extension of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ′
                    %mo ,
                    %mi f
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo ≤
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ″
                    %mo ,
                    %mi f
                    %mo ″
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (M', f') \leq (M'', f'')
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo ″
                  %annotation{:encoding => "application/x-tex"} M''
              contains
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} M'
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ″
                  %annotation{:encoding => "application/x-tex"} f''
              extends
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} f'
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Zorn%27s+lemma"} Zorn's lemma
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/maximal+element"} maximal element
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi M
                      %mo ′
                      %mo ,
                      %mi f
                      %mo ′
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (M', f')
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} M'
              is not all of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                    %annotation{:encoding => "application/x-tex"} N
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi N
                  %annotation{:encoding => "application/x-tex"} x \in N
              be an element not in
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} M'
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} f'
              extends to a map
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                      %mo ″
                      %mo =
                      %mo{:stretchy => "false"} ⟨
                      %mi x
                      %mo{:stretchy => "false"} ⟩
                      %mo +
                      %mi M
                      %mo ′
                      %mo →
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} M'' = \langle x \rangle + M' \to Q
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/contradiction"} contradiction
            %p
              The set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi r
                    %mo ∈
                    %mi R
                    %mo :
                    %mi r
                    %mi x
                    %mo ∈
                    %mi M
                    %mo ′
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{r \in R: r x \in M'\}
              is an ideal
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:lspace => "verythinmathspace"} :
                    %mi I
                    %mo →
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} g \colon I \to Q
              defined by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo{:stretchy => "false"} (
                      %mi r
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi f
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %mi r
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} g(r) = f'(r x)
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/hypothesis"} hypothesis
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              to a module map
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
