                    %a{:href => "#CommVsNoncomm"} Commutative vs. non-commutative dg-algebras
              %li
                %a{:href => "#Unbounded"} Unbounded dg-algebras
              %ul
                %li
                  %a{:href => "#GradingsAndConventions"} Gradings and conventions
