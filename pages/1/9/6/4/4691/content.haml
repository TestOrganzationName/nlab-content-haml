            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/maximum+entropy"} maximum entropy
            = succeed "," do
              %span.newWikiWord
                thermal state
                %a{:href => "/nlab/new/thermal+state"} ?
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/temperature"} temperature
          %h3#gravitational_entropy Gravitational entropy
