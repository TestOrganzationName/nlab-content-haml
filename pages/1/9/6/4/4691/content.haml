          %h2#idea Idea
          %p
            Entropy is a measure of disorder, given by the amount of
            %a.existingWikiWord{:href => "/nlab/show/information"} information
            necessary to precisely specify the
            %a.existingWikiWord{:href => "/nlab/show/state"} state
            of a system.
          %p
            Entropy is important in
            %a.existingWikiWord{:href => "/nlab/show/information+theory"} information theory
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/statistical+physics"} statistical physics
          %h2#mathematical_definitions Mathematical definitions
          %p
            We can give a precise
            %a.existingWikiWord{:href => "/nlab/show/mathematics"} mathematical
            definition of the entropy in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/probability+theory"} probability theory
          %h3#preliminary_definitions Preliminary definitions
          %p
            We will want a couple of preliminary definitions. Fix a
            %a.existingWikiWord{:href => "/nlab/show/probability+space"} probability space
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi μ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\mu)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/set"} set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                %annotation{:encoding => "application/x-tex"} \mu
            is a
            %a.existingWikiWord{:href => "/nlab/show/probability+measure"} probability measure
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %h4#surprisal Surprisal
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is a
            %a.existingWikiWord{:href => "/nlab/show/measurable+subset"} measurable subset
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %strong surprisal
            or
            %strong
              self-
              %a.existingWikiWord{:href => "/nlab/show/information"} information
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            (with respect to
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi σ
                    %mi μ
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi log
                  %mi μ
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\sigma_\mu(A) \coloneqq -\log \mu(A)
                  \\,.
          %p
