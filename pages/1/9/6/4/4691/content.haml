                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
            %em measurable
            if each of its part is measurable (in which case we can use
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                %annotation{:encoding => "application/x-tex"} \mu
            instead of
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
