                  %mrow
                    %msup
                      %mi μ
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \mu^*
          %h3#entropy_of_a_algebra_on_a_probability_space
            Entropy of a
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
          %p This is a general mathematical definition of entropy.
          %p
            Given a probability
            %a.existingWikiWord{:href => "/nlab/show/measure+space"} measure space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi μ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,\mu)
            and a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            %a.existingWikiWord{:href => "/nlab/show/sigma-algebra"} algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℳ
                %annotation{:encoding => "application/x-tex"} \mathcal{M}
            of
            %a.existingWikiWord{:href => "/nlab/show/measurable+sets"} measurable sets
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %strong entropy
            of
