          .proof
            %h6#proof Proof
            %p
              By the definition of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/quotient+space"} quotient space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
