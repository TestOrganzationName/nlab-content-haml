                    %mi E
                  %annotation{:encoding => "application/x-tex"} x \in E
              we have
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo{:stretchy => "false"} (
