                      %a{:href => "/nlab/edit/infinity-limits+-+contents"} Edit this sidebar
          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#definition"} Definition
              %li
                %a{:href => "#galois_connection_between_quotients_and_relations"} Galois connection between quotients and relations
              %li
