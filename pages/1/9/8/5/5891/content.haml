                  %mi B
                  %mo{:stretchy => "false"} [
                  %mi a
                  %mo{:stretchy => "false"} /
                  %mi x
                  %mo{:stretchy => "false"} ]
                  %mo :
                  %mi Type
                %annotation{:encoding => "application/x-tex"}
                  \\Gamma  \vdash B[a/x] : Type
          %p
