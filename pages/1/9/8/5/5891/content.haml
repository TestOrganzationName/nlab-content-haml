                %annotation{:encoding => "application/x-tex"} \Gamma
            is the collection of
            %a.existingWikiWord{:href => "/nlab/show/free+variables"} free variables
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
          %p (…)
          %h4#substitution Substitution
          %p Assume that interpretations for judgements
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                  %mo ,
                  %mi x
                  %mo :
                  %mi A
                  %mo ⊢
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi Type
                %annotation{:encoding => "application/x-tex"}
                  \\Gamma , x : A \vdash B(x) : Type
          %p and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                  %mo ⊢
                  %mi a
                  %mo :
                  %mi A
                %annotation{:encoding => "application/x-tex"}
                  \\Gamma \vdash  a : A
          %p have been given as above. Then the substitution judgement
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
