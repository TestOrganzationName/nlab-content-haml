                  \\longrightarrow
                  \\mathcal{N}
          %p
            subject to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/associators"} associators
            %a.existingWikiWord{:href => "/nlab/show/unitors"} unitors
            and
            %a.existingWikiWord{:href => "/nlab/show/coherence+conditions"} coherence conditions
            for
            %a.existingWikiWord{:href => "/nlab/show/action+objects"} action objects
            %a.existingWikiWord{:href => "/nlab/show/coherence"} coherently
            %a.existingWikiWord{:href => "/nlab/show/internalization"} internalized
            into the
            %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
          %p
            At least if some linear structure is present and respected (such as when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathcal{A}
            qualifies as a
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/2-ring"} 2-ring
            %em
              %a.existingWikiWord{:href => "/nlab/show/module+categories"} module categories
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathcal{A}
            (see also at
            = succeed ")." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/n-module"}
