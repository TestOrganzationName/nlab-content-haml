          %h2#idea Idea
          %h3#ExtensionOfMorphisms Extension of morphisms
          %p
            An
            %strong extension
          %ul
            %li
              %p
                of a
                %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi A
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} f: A\to Y
            %li
              %p
                along a morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo{:lspace => "verythinmathspace"} :
                      %mi A
                      %mo ↪
                      %mi X
                    %annotation{:encoding => "application/x-tex"} i \colon A\hookrightarrow X
              %p
                (often assumed to be a
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
          %p is
          %ul
            %li
              %p
                a morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ˜
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} \tilde{f} \colon X\to Y
            %li
              %p
                such that
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi f
                          %mo{:stretchy => "false"} ˜
                        %mo ∘
                        %mi i
                        %mo =
                        %mi f
                      %annotation{:encoding => "application/x-tex"} \tilde{f}\circ i = f
          %p
            hence a completion of the
            %a.existingWikiWord{:href => "/nlab/show/span"} span
            to a
            %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
            like this:
          %svg{:height => "88.085pt", :version => "1.2", :viewbox => "0 0 105.537 88.085", :width => "105.537pt", :xmlns => "http://www.w3.org/2000/svg", "xmlns:xlink" => "http://www.w3.org/1999/xlink"}
            %defs
              %g
                %symbol{:id => "A8pkXcSJz0krRf60MQ4C19Lspm4=-glyph0-0", :overflow => "visible"}
