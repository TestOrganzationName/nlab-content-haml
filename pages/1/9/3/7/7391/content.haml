                                  %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                              %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\mathbb{R}Hom_{[\Delta^{op}, dSet_{CM}]_{proj}}(\Delta[n]\times \Omega[T], X)
