                        \\,.
          %p
            (
            %a{:href => "#CisinskiMoerdijk"}> Cis-Moer, 4.7 i)+iii)
            ).
          .proof
            %h6#proof_20 Proof
            %p
              Since the simplicial horn inclusions generate all acyclic cofibrations in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi sSet
                        %mi Qillen
                    %annotation{:encoding => "application/x-tex"} sSet_{Qillen}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              which has right lifting against
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Λ
                      %mi k
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
