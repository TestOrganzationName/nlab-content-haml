                        %mi CM
                    %annotation{:encoding => "application/x-tex"} dSet_{CM}
            %p Now for the equivalence to the second item.
            %p
              By
              %a.existingWikiWord{:href => "/nlab/show/Joyal-Tierney+calculus"} Joyal-Tierney calculus
              the morphisms in question are of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
