            %p So finally we find that we may compute the derived hom as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi ℝ
                            %msub
                              %mi Hom
                              %mrow
                                %mo{:stretchy => "false"} [
                                %msup
                                  %mi Δ
                                  %mi op
                                %mo ,
                                %msub
                                  %mi dSet
                                  %mi CM
                                %msub
                                  %mo{:stretchy => "false"} ]
                                  %mi proj
                            %mo{:stretchy => "false"} (
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mi n
                            %mo{:stretchy => "false"} ]
                            %mo ×
                            %mi Ω
                            %mo{:stretchy => "false"} [
                            %mi T
                            %mo{:stretchy => "false"} ]
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mrow
                              %mo (
                              %mo{:stretchy => "false"} [
                              %mi k
                              %mo{:stretchy => "false"} ]
                              %mo ↦
                              %msub
                                %mi Hom
                                %mrow
                                  %mo{:stretchy => "false"} [
                                  %msup
                                    %mi Δ
                                    %mi op
                                  %mo ,
                                  %mi dSet
                                  %mo{:stretchy => "false"} ]
                              %mo{:stretchy => "false"} (
                              %mi Δ
                              %mo{:stretchy => "false"} [
                              %mi n
                              %mo{:stretchy => "false"} ]
                              %mo ×
                              %mi Ω
                              %mo{:stretchy => "false"} [
                              %mi T
                              %mo{:stretchy => "false"} ]
                              %mo ,
                              %msup
                                %mi X
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mi Δ
                                  %mo{:stretchy => "false"} [
                                  %mi k
                                  %mo{:stretchy => "false"} ]
                                  %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mrow
                              %mo (
                              %mo{:stretchy => "false"} [
                              %mi k
                              %mo{:stretchy => "false"} ]
                              %mo ↦
                              %msub
                                %mi Hom
                                %mrow
                                  %msub
                                    %mi dSet
                                    %mi CM
                              %mo{:stretchy => "false"} (
