          #HomotopyPropertyOfHomSpaces.num_remark
            %h6#remark Remark
            %p
              These simplicial sets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi x
                      %mi n
                    %mo ;
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X(x_1, \cdots, x_n; x)
              are
              %a.existingWikiWord{:href => "/nlab/show/Kan+complexes"} Kan complexes
              and in fact are
              %a.existingWikiWord{:href => "/nlab/show/generalized+the"} the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fibers"} homotopy fibers
              of the right vertical morphism.
          .proof
            %h6#proof_2 Proof
            %p
              The inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi η
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo →
                    %mi Ω
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \eta^{n+1} \to \Omega(C_n)
              is a cofibration in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi Ω
                        %mi op
                      %mo ,
                      %mi sSet
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi Segal
                    %annotation{:encoding => "application/x-tex"} [\Omega^{op}, sSet]_{Segal}
              %a.existingWikiWord{:href => "/nlab/show/simplicial+model+category"} simplicial model category
              the right vertical morphism in def.
              %a.maruku-ref{:href => "#HomSpaces"}
              are
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Kan+fibrations"} Kan fibrations
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
              (as discussed there).
          #FullyFaithfulMorphism.num_defn
            %h6#definition_5 Definition
            %p
              A morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f : X \to Y
              between dendroidal Segal spaces is
              %strong
                %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+functor"} fully faithful
              if for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi x
                        %mn 1
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %msub
                        %mi x
                        %mi n
                      %mo ;
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi X
                      %mo{:stretchy => "false"} (
                      %mi η
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} (x_1, \cdots, x_n; x) \in X(\eta)^{n+1}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              the corresponding morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi x
                      %mi n
                    %mo ;
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Y
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ;
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    X(x_1, \cdots, x_n; x) \to Y(f(x_1), \cdots, f(x_n); f(x))
            %p
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
          %h2#properties Properties
          %h3#basic_technical_properties Basic technical properties
          %p
            As for any category of
            %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaves"} simplicial presheaves
            we have
          #TensoringAndEnrichment.num_remark
            %h6#remark_2 Remark
            %p
              The category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Ω
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\Omega^{op}, sSet]
              is canonically
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/tensoring"} tensored
              %a.existingWikiWord{:href => "/nlab/show/cotensoring"} cotensored
              and
              %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched
              over
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/tensoring"} tensoring
              is given by the degreewise
              %a.existingWikiWord{:href => "/nlab/show/cartesian+product"} cartesian product
              in
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⋅
                    %mo :
                    %mi sSet
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Ω
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Ω
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\cdot : sSet \times [\Omega^{op}, sSet] \to [\Omega^{op}, sSet]
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ⋅
                    %mi X
                    %mo :
                    %mi T
                    %mo ↦
                    %mi S
                    %mo ×
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (S, X) \mapsto (S \cdot X : T \mapsto S \times X(T))
                    \\,.
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi dSet
                  %annotation{:encoding => "application/x-tex"} X \in dSet
              a dendroidal set, the
              %a.existingWikiWord{:href => "/nlab/show/hom+object"} hom object
              functor restricted along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi dSet
                    %mo ↪
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Ω
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} dSet \hookrightarrow [\Omega^{op}, sSet]
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mo :
                    %msup
                      %mi dSet
                      %mi op
                    %mo →
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"}
                    X^{(-)} : dSet^{op} \to sSet
            %p
              is the essentially unique
              = succeed "-preserving" do
                %a.existingWikiWord{:href => "/nlab/show/limit"} limit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo ∈
                    %mi Ω
                  %annotation{:encoding => "application/x-tex"} T \in \Omega
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mrow
                        %mi Ω
                        %mo{:stretchy => "false"} [
                        %mi T
                        %mo{:stretchy => "false"} ]
                    %mo =
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    X^{\Omega[T]} = X(T)
                    \\,.
          %p
            We will often write “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mo ×
                %annotation{:encoding => "application/x-tex"} \times
            ” also for the tensoring “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mo ⋅
                %annotation{:encoding => "application/x-tex"} \cdot
            ”.
          .proof
            %h6#proof_3 Proof
            %p
              The essential uniqueness in the last clause follows, because by the
              %a.existingWikiWord{:href => "/nlab/show/co-Yoneda+lemma"} co-Yoneda lemma
              every
              %a.existingWikiWord{:href => "/nlab/show/dendroidal+set"} dendroidal set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              may be written as a
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              over its cells
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %msub
                      %mo =
                      %mi iso
                    %mrow
                      %munder
                        %mi lim
                        %munder
                          %mo →
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi Ω
                            %mo{:stretchy => "false"} [
                            %mi T
                            %mo{:stretchy => "false"} ]
                            %mo →
                            %mi S
                            %mo{:stretchy => "false"} )
                    %mi Ω
                    %mo{:stretchy => "false"} [
                    %mi T
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S =_{iso} {\lim_{\underset{(\Omega[T] \to S)}{\to}}} \Omega[T]
                    \\,.
            %p Therefore
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mi S
                    %mo =
                    %mrow
                      %munder
                        %mi lim
                        %munder
                          %mo ←
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi Ω
                            %mo{:stretchy => "false"} [
                            %mi T
                            %mo{:stretchy => "false"} ]
                            %mo →
                            %mi S
                            %mo{:stretchy => "false"} )
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    X^S
                    \=
                    {\lim_{\underset{(\Omega[T] \to S)}{\leftarrow}}} X(T)
                    \\,.
          #latching.num_prop
            %h6#proposition_2 Proposition
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi Ω
                        %mi op
                      %mo ,
                      %mi sSet
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} X \in [\Omega^{op}, sSet]
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo ∈
                      %mi Ω
                    %annotation{:encoding => "application/x-tex"} T \in \Omega
              %em matching object
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              at
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              (in the sense of
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/generalized+Reedy+model+structure"} generalized Reedy model structure
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Match
                      %mi T
                    %mi X
                    %mo =
                    %msup
                      %mi X
                      %mrow
                        %mo ∂
                        %mi Ω
                        %mo{:stretchy => "false"} [
                        %mi T
                        %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Match_T X = X^{\partial \Omega[T]}
                    \\,.
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f : X \to Y
              a morphism, the
              %em relative matching morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi Match
                      %mi T
                    %mi X
                    %msub
                      %mo ×
                      %mrow
                        %msub
                          %mi Match
                          %mi T
                        %mi Y
                    %mi Y
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    X(T) \to Match_T X \times_{Match_T Y} Y(T)
            %p is the universal morphism induced from the commutativity of the diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi X
                              %mrow
                                %mi Ω
                                %mo{:stretchy => "false"} [
                                %mi T
                                %mo{:stretchy => "false"} ]
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msup
                                  %mi f
                                  %mrow
                                    %mi Ω
                                    %mo{:stretchy => "false"} [
                                    %mi T
                                    %mo{:stretchy => "false"} ]
                          %mtd
                            %msup
                              %mi Y
                              %mrow
                                %mi Ω
                                %mo{:stretchy => "false"} [
                                %mi T
                                %mo{:stretchy => "false"} ]
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msup
                              %mi X
                              %mrow
                                %mo ∂
                                %mi Ω
                                %mo{:stretchy => "false"} [
                                %mi T
                                %mo{:stretchy => "false"} ]
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msup
                                  %mi f
                                  %mrow
                                    %mo ∂
                                    %mi Ω
                                    %mo{:stretchy => "false"} [
                                    %mi T
                                    %mo{:stretchy => "false"} ]
                          %mtd
                            %msup
                              %mi Y
                              %mrow
                                %mo ∂
                                %mi Ω
                                %mo{:stretchy => "false"} [
                                %mi T
                                %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X^{\Omega[T]} &amp;\stackrel{f^{\Omega[T]}}{\to}&amp; Y^{\Omega[T]}
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    X^{\partial \Omega[T]} &amp;\stackrel{f^{\partial \Omega[T]}}{\to}&amp; Y^{\partial \Omega[T]}
                    }
                    \\,.
          .proof
            %h6#proof_4 Proof
            %p By definition
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Match
                      %mi T
                    %mi X
                    %mo =
                    %msub
                      %mrow
                        %munder
                          %mi lim
                          %mo ←
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi T
                        %mo ′
                        %mo ↪
                        %mi T
                        %mo{:stretchy => "false"} )
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    Match_T X = {\lim_{\leftarrow}}_{(T' \hookrightarrow T)} X(T')
                    \\,,
            %p
              where the limit is over faces of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              %a.maruku-ref{:href => "#TensoringAndEnrichment"}
              this is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo ≃
                    %msup
                      %mi X
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mrow
                            %munder
                              %mi lim
                              %mo →
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi T
                            %mo ′
                            %mo ↪
                            %mi T
                            %mo{:stretchy => "false"} )
                        %mi Ω
                        %mo{:stretchy => "false"} [
                        %mi T
                        %mo ′
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots \simeq X^{({\lim_\to}_{(T' \hookrightarrow T)} \Omega[T'])}
                    \\,.
            %p
              By the discussion at
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/dendroidal+set"} dendroidal set
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
            %p
              Similarly one finds that the morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi Match
                      %mi T
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X(T) \to Match_T X
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mrow
                        %mo ∂
                        %mi Ω
                        %mo{:stretchy => "false"} [
                        %mi T
                        %mo{:stretchy => "false"} ]
                        %mo ↪
                        %mi Ω
                        %mo{:stretchy => "false"} [
                        %mi T
                        %mo{:stretchy => "false"} ]
                    %mo :
                    %msup
                      %mi X
                      %mrow
                        %mi Ω
                        %mo{:stretchy => "false"} [
                        %mi T
                        %mo{:stretchy => "false"} ]
                    %mo →
                    %msup
                      %mi X
                      %mrow
                        %mo ∂
                        %mi Ω
                        %mo{:stretchy => "false"} [
                        %mi T
                        %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    X^{\partial \Omega[T] \hookrightarrow \Omega[T]}
                    \:
                    X^{\Omega[T]} \to X^{\partial \Omega[T]}
                    \\,.
          %h3#EquivalenceLocalization Equivalent localization
          %p
            We discuss a different set of morphisms, such that the model structure
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi Ω
                    %mi op
                  %mo ,
                  %mi sSet
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mi gReedy
                %annotation{:encoding => "application/x-tex"} [\Omega^{op}, sSet]_{gReedy}
            localized at it still coincides with the localization
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi Ω
                    %mi op
                  %mo ,
                  %mi sSet
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mi cSegal
                %annotation{:encoding => "application/x-tex"} [\Omega^{op}, sSet]_{cSegal}
            from def.
            = succeed "." do
              %a.maruku-ref{:href => "#ModelStructures"}
            %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
            to the
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+dendroidal+sets"} model structure on dendroidal sets
            that we discuss below in in
            = succeed "." do
              %em
                %a{:href => "http://ncatlab.org/nlab/show/model+structure+for+dendroidal+complete+Segal+spaces#RelationToDendroidalSets"} Relation to dendroidal sets
          %p
            Notice that, by the discussion there, the
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+dendroidal+sets"} model structure on dendroidal sets
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi dSet
                      %mi CM
                  %annotation{:encoding => "application/x-tex"} dSet_{CM}
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cofibrantly+generated+model+category"} cofibrantly generated model category
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi A
                  %mo →
                  %mi B
                  %mo{:stretchy => "false"} }
                  %mo ⊂
                  %mi Mor
                  %mo{:stretchy => "false"} (
                  %mi dSet
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  S = \{A \to B\} \subset Mor(dSet)
                  \\,.
          %p While its existence is known, no explicit description is presently available, but we do know that we may assume that
          %ol
            %li
              %p
                domain and codomain of all elements of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
                are normal dendroidal sets, hence cofibrant;
            %li
              %p
                it contains a morphism
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi η
                        %mo →
                        %mi J
                      %annotation{:encoding => "application/x-tex"} \eta \to J
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                    %annotation{:encoding => "application/x-tex"} J
                is the
                %a.existingWikiWord{:href => "/nlab/show/codiscrete+groupoid"} codiscrete groupoid
                on two objects, regarded as a unary operad, regarded as a dendroidal set.
          #LocalizationAtWeakOperadicEquivalences.num_prop
            %h6#proposition_3 Proposition
            %p
              The model structure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Ω
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi cSegal
                  %annotation{:encoding => "application/x-tex"} [\Omega^{op}, sSet]_{cSegal}
              coincides with the
              %a.existingWikiWord{:href => "/nlab/show/Bousfield+localization+of+model+categories"} left Bousfield localization
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Ω
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi gReedy
                  %annotation{:encoding => "application/x-tex"} [\Omega^{op}, sSet]_{gReedy}
              at the set of
              %a.existingWikiWord{:href => "/nlab/show/pushout-product"} pushout-product
              morphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo {
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo →
                        %mi B
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo ⋅
                          %mo{:stretchy => "false"} ¯
                        %mo{:stretchy => "false"} (
                        %mo ∂
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} ]
                        %mo →
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} )
                        %mo }
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo →
                        %mi B
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %mi S
                        %mo ,
                        %mi n
                        %mo ∈
                        %mi ℕ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{
                    (A \to B) \bar \cdot ( \partial \Delta[n] \to \Delta[n] )
                    \\right\}_{(A \to B) \in S, n \in \mathbb{N}}
                    \\,.
          %p
            (
            %a{:href => "#CisinskiMoerdijk"}> Cis-Moer, cor. 6.5
            ).
          #JAnodyneExtensionsAreCompleteSegalEquivalences.num_lemma
            %h6#lemma Lemma
            %p
              For every normal
              %a.existingWikiWord{:href => "/nlab/show/dendroidal+set"} dendroidal set
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %msub
                      %mo ⊗
                      %mi BV
                    %mo{:stretchy => "false"} (
                    %mi J
                    %mo →
                    %mi η
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \otimes_{BV}(J \to \eta)
              is a weak equivalence in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi Ω
                        %mi op
                      %mo ,
                      %mi sSet
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi cSegal
                    %annotation{:encoding => "application/x-tex"} [\Omega^{op}, sSet]_{cSegal}
            %p
              Moreover, every “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
              \-anodyne extension” is a weak cSegal-equivalence, meaning every morphism generated by
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
              %a.existingWikiWord{:href => "/nlab/show/transfinite+composition"} transfinite composition
              and
              %a.existingWikiWord{:href => "/nlab/show/retracts"} retracts
              from the
              %a.existingWikiWord{:href => "/nlab/show/pushout-products"} pushout-products
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi e
                    %mo{:stretchy => "false"} }
                    %mo →
                    %mi J
                  %annotation{:encoding => "application/x-tex"} \{e\} \to J
              with tree boundary inclusions.
          %p
            (
            %a{:href => "#CisinskiMoerdijk"}> Cis-Moer, prop. 6.3
            )
          .proof
            %h6#proof_5 Proof
            %p
              For the first statement, it is sufficient to show that the morphism is a weak equivalence regarded in the
              %a.existingWikiWord{:href => "/nlab/show/slice+model+structure"} slice model structure
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Ω
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi cSegal
                    %mo{:stretchy => "false"} /
                    %mi A
                    %mo ≃
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} (
                    %mi Δ
                    %mo ×
                    %mi Ω
                    %mo{:stretchy => "false"} /
                    %mi A
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [\Omega^{op}, sSet]_{cSegal} / A \simeq [(\Delta \times \Omega / A)^{op}, Set]
                    \\,.
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/category+of+elements"} category of elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo ×
                    %mi Ω
                    %mo{:stretchy => "false"} /
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \Delta \times \Omega/A
              is a “regular skeletal category” in the sense of
              %em
                %a.existingWikiWord{:href => "/nlab/show/Cisinski+model+structure"} Cisinski model structure
              theory. By a lemma there,
              %a.existingWikiWord{:href => "/nlab/show/natural+transformations"} natural transformations
              between functors preserving
              %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
              and
              %a.existingWikiWord{:href => "/nlab/show/monomorphisms"} monomorphisms
              are componentwise weak equivalences is they are so on representables.
            %p
              Now
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} J \otimes (-)
              does preserve colimits and monomorphisms, and on representables the transformation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi η
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} J \otimes (-) \to \eta \otimes (-)
              is a cSegal-equivalence by definition.
            %p
              The second statement now follows using that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Ω
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi cSegal
                  %annotation{:encoding => "application/x-tex"} [\Omega^{op}, sSet]_{cSegal}
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/left+proper+model+category"} left proper model category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi η
                    %mo →
                    %msub
                      %mi J
                      %mi d
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mo ∂
                    %mi Ω
                    %mo{:stretchy => "false"} [
                    %mi T
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} (\eta \to J_d) \otimes \partial \Omega[T]
              also its pushout
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                    %mo{:stretchy => "false"} [
                    %mi T
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi Ω
                    %mo{:stretchy => "false"} [
                    %mi T
                    %mo{:stretchy => "false"} ]
                    %mo ∪
                    %msub
                      %mi J
                      %mi d
                    %mo ⊗
                    %mo ∂
                    %mi Ω
                    %mo{:stretchy => "false"} [
                    %mi T
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \Omega[T] \to \Omega[T] \cup J_d \otimes \partial \Omega[T]
              is a weak equivalence, and so by
              %a.existingWikiWord{:href => "/nlab/show/two-out-of-three"} two-out-of-three
              with the composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi η
                    %mo →
                    %msub
                      %mi J
                      %mi d
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mi Ω
                    %mo{:stretchy => "false"} [
                    %mi T
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mi Ω
                    %mo{:stretchy => "false"} [
                    %mi T
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi Ω
                    %mo{:stretchy => "false"} [
                    %mi T
                    %mo{:stretchy => "false"} ]
                    %mo ∪
                    %msub
                      %mi J
                      %mi d
                    %mo ⊗
                    %mo ∂
                    %mi Ω
                    %mo{:stretchy => "false"} [
                    %mi T
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo →
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi η
                        %mo →
                        %msub
                          %mi J
                          %mi d
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo ⊗
                          %mo{:stretchy => "false"} ¯
                        %mo{:stretchy => "false"} (
                        %mo ∂
                        %mi Ω
                        %mo{:stretchy => "false"} [
                        %mi T
                        %mo{:stretchy => "false"} ]
                        %mo →
                        %mi Ω
                        %mo{:stretchy => "false"} [
                        %mi T
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi J
                      %mi d
                    %mo ⊗
                    %mi Ω
                    %mo{:stretchy => "false"} [
                    %mi T
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    (\eta \to J_d)\otimes \Omega[T]
                    \=
                    \\Omega[T] \to \Omega[T] \cup J_d \otimes \partial \Omega[T]
                    \\stackrel{(\eta \to J_d)\bar \otimes (\partial \Omega[T] \to \Omega[T])}{\to}
                    J_d \otimes \Omega[T]
            %p also the pushout-product itself.
          .proof
            %h6#proof_6 Proof
            %p
              of prop.
              %a.maruku-ref{:href => "#LocalizationAtWeakOperadicEquivalences"}
            %p
              By
              %a{:href => "http://ncatlab.org/nlab/show/model+structure+on%20dendroidal%20sets#RelationToModelStructureForDendroidalCompleteSegal"} this proposition
              the acyclic cofibrations between normal dendroidal sets are generated from the
              = succeed "-anodyne" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                    %annotation{:encoding => "application/x-tex"} J
              %a.maruku-ref{:href => "#JAnodyneExtensionsAreCompleteSegalEquivalences"}
              and
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/two-out-of-three"} two-out-of-three
            %p
              Therefore by the
              %a.existingWikiWord{:href => "/nlab/show/pushout-product+axiom"} pushout-product axiom
              in the
              %a.existingWikiWord{:href => "/nlab/show/simplicial+model+category"} simplicial model category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi Ω
                        %mi op
                      %mo ,
                      %mi sSet
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi cSegal
                    %annotation{:encoding => "application/x-tex"} [\Omega^{op}, sSet]_{cSegal}
              %a.existingWikiWord{:href => "/nlab/show/powering"} powering
              into a fibration is an acyclic Kan fibration. By
              %a.existingWikiWord{:href => "/nlab/show/Joyal-Tierney+calculus"} Joyal-Tierney calculus
              this means that all the pushout-products
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo →
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⋅
                      %mo{:stretchy => "false"} ¯
                    %mo{:stretchy => "false"} (
                    %mo ∂
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (A \to B) \bar \cdot (\partial \Delta[n] \to \Delta[n])
              have the left lifting property against fibrations, hence that they are weak equivalences in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi Ω
                        %mi op
                      %mo ,
                      %mi sSet
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi cSegal
                    %annotation{:encoding => "application/x-tex"} [\Omega^{op}, sSet]_{cSegal}
            %p
              Since therefore all the morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo →
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⋅
                      %mo{:stretchy => "false"} ¯
                    %mo{:stretchy => "false"} (
                    %mo ∂
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (A \to B) \bar \cdot ( \partial \Delta[n] \to \Delta[n] )
              are weak equivalences in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi Ω
                        %mi op
                      %mo ,
                      %mi sSet
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi cSegal
                    %annotation{:encoding => "application/x-tex"} [\Omega^{op}, sSet]_{cSegal}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} n = 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi J
                      %mi d
                    %mo →
                    %mi η
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mi Ω
                    %mo{:stretchy => "false"} [
                    %mi T
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} (J_d \to \eta) \otimes \Omega[T]
              observe that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi η
                    %mo →
                    %msub
                      %mi J
                      %mi d
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⊗
                      %mo{:stretchy => "false"} ¯
                    %mo{:stretchy => "false"} (
                    %mi ∅
                    %mo →
                    %mi Ω
                    %mo{:stretchy => "false"} [
                    %mi T
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi η
                    %mo →
                    %msub
                      %mi J
                      %mi d
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mi Ω
                    %mo{:stretchy => "false"} [
                    %mi T
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    (\eta \to J_d) \bar \otimes (\emptyset \to \Omega[T])
                    \=
                    (\eta \to J_d) \otimes \Omega[T]
            %p
              is
              = succeed "-anodyne" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                    %annotation{:encoding => "application/x-tex"} J
              = succeed ")," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Cisinski+model+structure"} Cisinski model structure
              %a.existingWikiWord{:href => "/nlab/show/retraction"} retraction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi J
                      %mi d
                    %mo →
                    %mi η
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mi Ω
                    %mo{:stretchy => "false"} [
                    %mi T
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} (J_d \to \eta  ) \otimes \Omega[T]
              is a weak equivalence.
          %h3#fibrations_and_cofibrations Fibrations and Cofibrations
          #FibrationsInGenReedy.num_prop
            %h6#proposition_4 Proposition
            %p
              A morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
