              is fibrant (is a quasi-operad) for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %a{:href => "model+structure+on+dendroidal+sets#Enrichment"} here
              at
              = succeed "." do
