            %p
              Therefore we have found that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is fibrant in the locally constant model structure, def.
              = succeed "," do
                %a.maruku-ref{:href => "#LocallyConstantModelStructure"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              the morphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                    %msub
                      %mi Hom
                      %mrow
                        %msub
                          %mi dSet
                          %mi CM
                    %mo{:stretchy => "false"} (
                    %mi Ω
                    %mo{:stretchy => "false"} [
                    %mi T
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %msub
