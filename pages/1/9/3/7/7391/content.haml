                      %mi Δ
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi gReedy
                  %annotation{:encoding => "application/x-tex"} [\Delta^{op}, sSet]_{gReedy}
              is a fibration or acyclic fibration, precisely if for all
              %a.existingWikiWord{:href => "/nlab/show/trees"} trees
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo ∈
                      %mi Ω
                    %annotation{:encoding => "application/x-tex"} T \in \Omega
              %a.existingWikiWord{:href => "/nlab/show/hom+objects"} hom objects
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mrow
                        %mi Ω
                        %mo{:stretchy => "false"} [
                        %mi T
                        %mo{:stretchy => "false"} ]
                    %mo →
                    %msup
                      %mi X
                      %mrow
                        %mo ∂
                        %mi Ω
                        %mo{:stretchy => "false"} [
                        %mi T
                        %mo{:stretchy => "false"} ]
                    %msub
