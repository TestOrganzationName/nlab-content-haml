                  against the set of
                  %a.existingWikiWord{:href => "/nlab/show/pushout+product"} pushout product
                  morphisms
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi Λ
                          %mi k
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} ]
                        %mo →
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mi T
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo ⋅
                          %mo{:stretchy => "false"} ¯
                        %mo{:stretchy => "false"} (
                        %mo ∂
                        %mi Ω
