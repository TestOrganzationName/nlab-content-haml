              is monotone,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo &lt;
                    %mi j
                  %annotation{:encoding => "application/x-tex"} i \lt j
              implies
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo{:stretchy => "false"} )
                      %mo ≤
                      %mi f
