                  %mrow
                    %mi n
                    %mo &lt;
                    %mi j
                  %annotation{:encoding => "application/x-tex"} n\lt j
              it follows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ≤
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(n) \le f(j)
              so that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
