                  %annotation{:encoding => "application/x-tex"} \mathbb{N}
              it follows, for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
