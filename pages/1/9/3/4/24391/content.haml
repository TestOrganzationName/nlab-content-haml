                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is any
              %a.existingWikiWord{:href => "/nlab/show/measurable+space"} measurable space
              the maximal proper ideals of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}{X}
              are of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi ev
                      %mi U
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ev_{U}^{-1}( (0,1])
              or
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi ev
                      %mi U
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ev_U^{-1}([0,1))
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ≠
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U\ne X
              a nonempty measurable set in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p
              To prove this, note that both
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} (0,1]
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} [0,1)
              are ideals in the superconvex space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [0,1]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi ev
                      %mi U
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ev_{U}^{-1}( [0,1))
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi ev
                      %mi U
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ev_U^{-1}((0,1])
              are ideals in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒢
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}{X}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi ev
                        %mi U
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} ev_U^{-1}( [0,1))
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℐ
                  %annotation{:encoding => "application/x-tex"} \mathcal{I}
              is another ideal of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}{X}
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi ev
                        %mi U
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ⫋︀
                      %mi ℐ
                    %annotation{:encoding => "application/x-tex"} ev_U^{-1}( [0,1)) \varsubsetneqq  \mathcal{I}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ∈
                    %mi ℐ
                  %annotation{:encoding => "application/x-tex"} P \in \mathcal{I}
              which is not in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi ev
                      %mi U
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ev_U^{-1}([0,1))
              has the defining property that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi U
                        %mi c
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} P(U^c)=1
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                      %mo ∈
                      %mi 𝒢
                      %mi X
                    %annotation{:encoding => "application/x-tex"} Q \in \mathcal{G}{X}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo ∉
                    %mi 𝒥
                  %annotation{:encoding => "application/x-tex"} Q \notin \mathcal{J}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo ∉
                    %msubsup
                      %mi ev
                      %mi U
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Q \notin ev_U^{-1}([0,1))
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi U
                      %mi c
                    %mo{:stretchy => "false"} )
                    %mo ≠
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} Q(U^c) \ne 1
              which implies
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo ∈
                    %msubsup
                      %mi ev
                      %mi U
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⫋︀
                    %mi J
                  %annotation{:encoding => "application/x-tex"} Q \in ev_U^{-1}( [0,1)) \varsubsetneqq J
              which is self-contradictory. Thus
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒥
                  %annotation{:encoding => "application/x-tex"} \mathcal{J}
              must be all of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}{X}
              which shows
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi ev
                      %mi U
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ev_U^{-1}([0,1))
              is a maximal (proper) ideal. The argument that the ideal
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi ev
                      %mi U
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ev_U^{-1}( (0,1])
              is a maximal ideal is similiar except we replace the condition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi U
                      %mi c
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} P(U^c)=1
              in the above proof with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} P(U)=0
            %p
              If we restrict to the category of standard measurable spaces then every object has a countable generating basis and it is then clear that every ideal in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}(X)
              is a countable intersection of maximal ideals, and hence measurable. This implies, for example, that every countably affine map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo :
                    %mi 𝒢
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} k: \mathcal{G}(X) \rightarrow \mathbb{N}
              is also a measurable function with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \mathbb{N}
              having the powerset
              = succeed "-algebra." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                    %annotation{:encoding => "application/x-tex"} \sigma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \mathbb{N}
              are the principal ideals
              = succeed ".)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ↓
                      %mspace{:width => "negativethinmathspace"}
                      %mn 0
                      %mo ⊂
                      %mo{:stretchy => "false"} ↓
                      %mspace{:width => "negativethinmathspace"}
                      %mn 1
                      %mo ⊂
                      %mi …
                    %annotation{:encoding => "application/x-tex"} \downarrow \! 0 \subset \downarrow \! 1 \subset \ldots
          %p
          .num_remark
            %h6 Example
            %p
              The one point Alexandroff compactification of the interval
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn ∞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} [0,\infty)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn ∞
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [0,\infty]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn ∞
                    %mo ,
                    %mn ∞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}=(-\infty,\infty)
              is not a superconvex space since we could take
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi i
                    %mo =
                    %mfrac
                      %mn 1
                      %mrow
                        %msup
                          %mn 2
                          %mi i
                  %annotation{:encoding => "application/x-tex"} p_i = \frac{1}{2^i}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi r
                      %mi i
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi i
                    %msup
                      %mn 2
                      %mi i
                  %annotation{:encoding => "application/x-tex"} r_i=(-1)^i 2^i
              for which the sequence of partial sums alternates between
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} -1
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              itself is not a superconvex space even though it is a convex space.
            %p
          %p
          .num_remark
            %h6 Example
            %p
              A pathological space, useful for counterexamples, is given by the closed unit interval with the superconvex space structure defined by the infimum function,
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi i
                          %mo ∈
                          %mi ℕ
                      %msub
                        %mi p
                        %mi i
                      %msub
                        %mi u
                        %mi i
                      %mo :
                      %mo =
                      %msub
                        %mi inf
                        %mi i
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi u
                        %mi i
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi p
                        %mi i
                      %mo &gt;
                      %mn 0
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \sum_{i \in \mathbb{N}} p_i u_i := inf_i \{ u_i | p_i \gt 0\}
          %p
          .num_remark
            %h6 Example
            %p
              Consider the probability monad on compact Hausdorff spaces, where the algebras are precisely the compact convex sets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              in locally convex topological vector spaces together with the barycenter maps
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi β
                        %mi K
                      %mo :
                      %mi 𝒫
                      %mi K
                      %mo →
                      %mi K
                    %annotation{:encoding => "application/x-tex"} \beta_K:\mathcal{P}K\rightarrow K
            %p
              Given such a space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              we can endow it with a superconvex space structure by defining, for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi p
                      %mo ∈
                      %mi 𝒢
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} \mathbf{p} \in \mathcal{G}\mathbb{N}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo ∈
                        %mi ℕ
                    %msub
                      %mi p
                      %mi i
                    %msub
                      %mi k
                      %mi i
                    %mo :
                    %mo =
                    %msub
                      %mi β
                      %mi K
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo ∈
                        %mi ℕ
                    %msub
                      %mi p
                      %mi i
                    %msub
                      %mi δ
                      %mrow
                        %msub
                          %mi k
                          %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sum_{i \in \mathbb{N}} p_i k_i := \beta_K( \sum_{i \in \mathbb{N}} p_i \delta_{k_i})
              which, along with the pointwise superconvex space structure on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒫
                    %mi K
                  %annotation{:encoding => "application/x-tex"} \mathcal{P}K
              makes the barycenter map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi β
                      %mi K
                  %annotation{:encoding => "application/x-tex"} \beta_K
              a countably affine map.
            %p
              To prove that this endows
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              with a superconvex space structure note that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi β
                      %mi K
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi δ
                      %mrow
                        %msub
                          %mi k
                          %mi i
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi k
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \beta_K(\delta_{k_i})= k_i
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi k
                      %mi i
                    %mo ∈
                    %mi K
                  %annotation{:encoding => "application/x-tex"} k_i \in K
              to obtain
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:displaystyle => "false"}
                      %mrow
                        %msub
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mrow
                            %mi i
                            %mo ∈
                            %mi ℕ
                      %msub
                        %mi p
                        %mi i
                      %msub
                        %mi β
                        %mi K
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi δ
                        %mrow
                          %msub
                            %mi k
                            %mi i
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mstyle{:displaystyle => "false"}
                        %mrow
                          %msub
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                            %mrow
                              %mi i
                              %mo ∈
                              %mi ℕ
                        %msub
                          %mi p
                          %mi i
                        %msub
                          %mi k
                          %mi i
                        %mspace{:width => "thinmathspace"}
                        %mo ≔
                        %mspace{:width => "thinmathspace"}
                        %msub
                          %mi β
                          %mi K
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mstyle{:displaystyle => "false"}
                          %mrow
                            %msub
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi i
                                %mo ∈
                                %mi ℕ
                          %msub
