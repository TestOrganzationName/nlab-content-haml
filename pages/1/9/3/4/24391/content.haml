                          %mspace{:width => "thinmathspace"}
                          %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\textstyle{\sum_{i \in \mathbb{N}}}
                    p_i \beta_K(\delta_{k_i})
                    \\;=\;
                    \\textstyle{\sum_{i \in \mathbb{N}}}
                    p_i k_i
                    \\,\coloneqq\,
                    \\beta_K\big(
                    \\textstyle{\sum_{i \in \mathbb{N}}}
                    p_i \delta_{k_i}
                    \\big)
                    \\,.
            %p
              To prove that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi β
                      %mi K
                  %annotation{:encoding => "application/x-tex"} \beta_K
              is countably affine on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒫
                    %mi K
                  %annotation{:encoding => "application/x-tex"} \mathcal{P}K
              use the property that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi β
                        %mi K
                      %mo ∘
                      %msub
                        %mi μ
                        %mi K
                      %mo =
                      %msub
