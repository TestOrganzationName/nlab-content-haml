            %p
          %p
          .num_defn
            %h6 Definition
            %p
              %strong (category of superconvex spaces)
              %br/
              A
              %em
                %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              of superconvex spaces, called a
              = succeed "," do
                %em countably affine map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} m: A \rightarrow B
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mstyle{:displaystyle => "false"}
                      %mrow
                        %msub
                          %mo ∫
                          %mi ℕ
                      %mstyle{:mathvariant => "bold"}
                        %mi a
                      %mspace{:width => "thinmathspace"}
                      %mi d
                      %mstyle{:mathvariant => "bold"}
                        %mi p
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mstyle{:displaystyle => "false"}
                        %mrow
                          %msub
                            %mo ∫
                            %mi ℕ
                        %mo{:stretchy => "false"} (
                        %mi m
                        %mo ∘
                        %mstyle{:mathvariant => "bold"}
                          %mi a
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mi d
                        %mstyle{:mathvariant => "bold"}
                          %mi p
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    m
                    \\big(
                    \\textstyle{\int_{\mathbb{N}}} \mathbf{a}
                    \\, d\mathbf{p}
                    \\big)
                    \\;=\;
                    \\textstyle{\int_{\mathbb{N}}}
                    (m \circ \mathbf{a}) \, d\mathbf{p}
                    \\,,
            %p
              where the composite
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo ∘
                    %mstyle{:mathvariant => "bold"}
                      %mi a
                  %annotation{:encoding => "application/x-tex"} m \circ \mathbf{a}
              gives the sequence in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              with component
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi a
                        %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} m(a_i)
            %p
              Superconvex spaces with morphisms the countably affine maps thus form a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              denoted
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi SCvx
                    %annotation{:encoding => "application/x-tex"} \mathbf{SCvx}
          %h2#probability_amplitudes Probability Amplitudes
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/physics"} physics
            = succeed "," do
              %em strong convex spaces
            %a.existingWikiWord{:href => "/nlab/show/probability+amplitudes"} probability amplitudes
            are employed there one makes use of the
            = succeed "-norm" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℓ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \ell_2
            = succeed "-norm\u2019\u2018" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℓ
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \ell_1
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒢
                  %mo{:stretchy => "false"} (
                  %mi ℕ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} {
                  %mstyle{:mathvariant => "bold"}
                    %mi p
                  %mo{:lspace => "verythinmathspace"} :
                  %mi ℕ
                  %mo →
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi D
                    %mn 2
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} |
                  %munder
                    %mi lim
                    %mrow
                      %mi N
                      %mo →
                      %mn ∞
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mstyle{:displaystyle => "false"}
                    %mrow
                      %msubsup
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi i
                          %mo =
                          %mn 1
                        %mi N
                    %msub
                      %mi p
                      %mi i
                    %msubsup
                      %mi p
                      %mi i
                      %mo ⋆
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo =
                    %mspace{:width => "thinmathspace"}
                    %mn 1
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} }
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{G}(\mathbb{N})
                  \\;=\;
                  \\Big\{
                  \\mathbf{p} \colon \mathbb{N} \rightarrow  \mathbf{D}_2
                  \\Big\vert
                  \\lim_{N \rightarrow \infty}
                  \\big(
                  \\textstyle{\sum_{i=1}^N} p_i p_i^{\star}
                  \\big)
                  \\,=\,
                  1
                  \\Big\}
                  \\,,
          %p where
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi D
                    %mn 2
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
