                  %mi ℕ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{G}(\mathbb{N})
            denote the set of all
            %a.existingWikiWord{:href => "/nlab/show/probability+measures"} probability measures
            on the set of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} natural numbers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi p
                %annotation{:encoding => "application/x-tex"} \mathbf{p}
            can be represented as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi p
                  %mo =
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi i
                      %mo ∈
                      %mi ℕ
                  %msub
                    %mi p
                    %mi i
                  %msub
                    %mi δ
                    %mi i
                %annotation{:encoding => "application/x-tex"} \mathbf{p} = \sum_{i \in \mathbb{N}} p_i \delta_i
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi i
                      %mo ∈
                      %mi ℕ
                  %msub
                    %mi p
                    %mi i
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} \sum_{i \in \mathbb{N}} p_i=1
            with each
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi i
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} p_i \in [0,1]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒢
                %annotation{:encoding => "application/x-tex"} \mathcal{G}
            is the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Giry+monad"} Giry monad
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            %a.existingWikiWord{:href => "/nlab/show/measurable+space"} measurable space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒢
                  %mo{:stretchy => "false"} (
                  %mi 𝕄
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{G}(\mathbb{M})
            we often write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mi ℕ
                %annotation{:encoding => "application/x-tex"} \Delta_{\mathbb{N}}
            for its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/underlying+set"} underlying set
            %a.existingWikiWord{:href => "/nlab/show/countable+set"} countably
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/infinite"} infinite
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimensional
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/simplex"} simplex
          %p
            Given any set
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %a.existingWikiWord{:href => "/nlab/show/sequence"} sequence
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi a
                    %mo{:lspace => "verythinmathspace"} :
                    %mi ℕ
                    %mo →
                    %mi A
