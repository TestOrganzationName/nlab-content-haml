                      %mi ℕ
                  %msub
                    %mi p
                    %mi i
                  %msub
                    %mi a
                    %mi i
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\int_{\mathbb{N}} \mathbf{a} \, d\mathbf{p}
                  \\;\coloneqq\;
                  \\sum_{i \in \mathbb{N}} p_i a_i.
          %p
          .num_defn
            %h6 Definition
            %p
              %strong (superconvex spaces)
              %br/
              We say a set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              has the structure of a
              %em superconvex space
              if it comes equipped with a function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "center center center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %msub
                            %mi st
                            %mi A
                        %mtd
