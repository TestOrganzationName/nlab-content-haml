          %h2#idea Idea
          %p
            In great generality, for an
            %a.existingWikiWord{:href => "/nlab/show/integer"} integer
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            a
            %em
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              \-divisible group
            is a
            %a.existingWikiWord{:href => "/nlab/show/inductive+system"} codirected diagram
            of
            %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian
            %a.existingWikiWord{:href => "/nlab/show/group+objects"} group objects
            in a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            where the abelian-group objects are (equivalently) the
            %a.existingWikiWord{:href => "/nlab/show/kernel"} kernels
            of the map given by multiplication with a power of
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed "-torsions." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi p
                      %mi n
                  %annotation{:encoding => "application/x-tex"} p^n
          %p
            In the classically studied case
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            is a prime number,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is the category of
            %a.existingWikiWord{:href => "/nlab/show/scheme"} schemes
            over a commutative ring (mostly a field with prime characteristic) and the abelian
            %a.existingWikiWord{:href => "/nlab/show/group+scheme"} group schemes
            occurring in the diagram are assumed to be finite. In this case the diagram defining the
            = succeed "-divisible" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %a.existingWikiWord{:href => "/nlab/show/order+of+a+group"} order
            of the group schemes in the diagram.
          %p
            Note that there is also a notion of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/divisible+group"} divisible group
          %h2#definition Definition
          .num_defn
            %h6#definition_2 Definition
            %p
              Fix a
              %a.existingWikiWord{:href => "/nlab/show/prime+number"} prime number
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %a.existingWikiWord{:href => "/nlab/show/natural+number"} positive integer
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                    %annotation{:encoding => "application/x-tex"} h
              %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              over
            %p
              A
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
                \-divisible group of height
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                    %annotation{:encoding => "application/x-tex"} h
                over
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              is a
              %a.existingWikiWord{:href => "/nlab/show/codirected+limit"} codirected diagram
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi G
                      %mi ν
                    %mo ,
                    %msub
                      %mi i
                      %mi ν
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi ν
                        %mo ∈
                        %mi ℕ
                  %annotation{:encoding => "application/x-tex"} (G_\nu, i_\nu)_{\nu \in \mathbb{N}}
              where each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mi ν
                  %annotation{:encoding => "application/x-tex"} G_\nu
              is a finite commutative
              %a.existingWikiWord{:href => "/nlab/show/group+scheme"} group scheme
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              of
              %a.existingWikiWord{:href => "/nlab/show/order+of+a+group"} order
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi p
                      %mrow
                        %mi ν
                        %mi h
                  %annotation{:encoding => "application/x-tex"} p^{\nu h}
              that also satisfies the property that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msub
                      %mi G
                      %mi ν
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi i
                          %mi ν
                    %msub
                      %mi G
                      %mrow
                        %mi ν
                        %mo +
                        %mn 1
                    %mover
                      %mo →
                      %mrow
                        %msup
                          %mi p
                          %mi ν
                    %msub
                      %mi G
                      %mrow
                        %mi ν
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} 0\to G_\nu \stackrel{i_\nu}{\to} G_{\nu +1}\stackrel{p^\nu}{\to} G_{\nu +1}
            %p
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exact
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mi ν
                  %annotation{:encoding => "application/x-tex"} G_\nu
              with the
              %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
              of multiplication by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi p
                      %mi ν
                  %annotation{:encoding => "application/x-tex"} p^\nu
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi G
                        %mrow
                          %mi ν
                          %mo +
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} G_{\nu +1}
            %p
              Some authors refer to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi colim
                      %mi ν
                    %msub
                      %mi G
                      %mi ν
                  %annotation{:encoding => "application/x-tex"} colim_\nu G_\nu
              (instead of the diagram itself) as the
              = succeed "-divisible" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
          %p
            It can be checked that a
            = succeed "-divisible" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is a
            = succeed "-torsion" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %a.existingWikiWord{:href => "/nlab/show/formal+group"} formal group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            for which
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo{:lspace => "verythinmathspace"} :
                  %mi G
                  %mo →
                  %mi G
                %annotation{:encoding => "application/x-tex"} p\colon G \to G
            is an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/isogeny"} isogeny
          %h2#examples Examples
          .num_example
            %h6#example Example
            %p
              The kernel of raising to the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi p
                      %mi ν
                  %annotation{:encoding => "application/x-tex"} p^\nu
              power on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔾
                      %mi m
                  %annotation{:encoding => "application/x-tex"} \mathbb{G}_m
              (sometimes called
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/p-torsion"} p-torsion
              %a.existingWikiWord{:href => "/nlab/show/group+scheme"} group scheme
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi μ
                        %mrow
                          %msup
                            %mi p
                            %mi ν
                    %annotation{:encoding => "application/x-tex"} \mu_{p^\nu}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi lim
                      %mo →
                    %msub
                      %mi μ
                      %mrow
                        %msup
                          %mi p
                          %mi ν
                    %mo =
                    %msub
                      %mi μ
                      %mrow
                        %msup
                          %mi p
                          %mn ∞
                  %annotation{:encoding => "application/x-tex"} \lim_{\to} \mu_{p^\nu}=\mu_{p^\infty}
              is a
              = succeed "-divisible" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 1
            %p
              see Lipnowski
              %a{:href => "http://math.stanford.edu/~malipnow/expository/pdiv.pdf"} pg.2, example (b)
          .num_example
            %h6#example_2 Example
            %p
              The eponymous (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              \-divisible groups are sometimes called Barsotti-Tate groups) example is a special case of the previous one - namely
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/the+Barsotti-Tate+group+of+an+abelian+variety"} the Barsotti-Tate group of an abelian variety
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be an
              %a.existingWikiWord{:href => "/nlab/show/abelian+variety"} abelian variety
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              of dimension
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi p
                      %mi ν
                  %annotation{:encoding => "application/x-tex"} p^\nu
              has kernel
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo
                      %mrow
                        %msup
                          %mi p
                          %mi ν
                    %mi X
                  %annotation{:encoding => "application/x-tex"} _{p^\nu}X
              which is a finite
              %a.existingWikiWord{:href => "/nlab/show/group+scheme"} group scheme
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              of order
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi p
                        %mrow
                          %mn 2
                          %mi g
                          %mi ν
                    %annotation{:encoding => "application/x-tex"} p^{2g \nu}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X(p)
              to be a
              = succeed "-divisible" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mi g
                    %annotation{:encoding => "application/x-tex"} 2g
          .num_example
            %h6#example_3 Example
            %p
              A theorem of
              %a{:href => "#Tate"} Serre and Tate
              says that there is an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
              between divisible, commutative, formal
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              and the category of connected
              = succeed "-divisible" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              given by
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                      %mo ↦
                      %mi Γ
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Gamma \mapsto \Gamma (p)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi lim
                        %mo →
                      %mi{:mathvariant => "normal"} ker
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi p
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Gamma(p)=\lim_{\to} \mathrm{ker}(p^n)
              = succeed "-divisible" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
          %h2#the_cartier_dual The Cartier dual
          %ul
            %li
              %p
                Given a
                = succeed "-divisible" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi G
                        %mi ν
                    %annotation{:encoding => "application/x-tex"} G_\nu
                has a
                %a.existingWikiWord{:href => "/nlab/show/Cartier+dual"} Cartier dual
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi G
                        %mi ν
                        %mi D
                    %annotation{:encoding => "application/x-tex"} G_\nu^D
                since they are all group schemes. There are also maps
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi j
                        %mi ν
                    %annotation{:encoding => "application/x-tex"} j_\nu
                that make the composite
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi G
                        %mrow
                          %mi ν
                          %mo +
                          %mn 1
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi j
                            %mi ν
                      %msub
                        %mi G
                        %mi ν
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi i
                            %mi ν
                      %msub
                        %mi G
                        %mrow
                          %mi ν
                          %mo +
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} G_{\nu+1}\stackrel{j_\nu}{\to} G_\nu \stackrel{i_\nu}{\to} G_{\nu +1}
                the multiplication by
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
                on
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi G
                          %mrow
                            %mi ν
                            %mo +
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} G_{\nu +1}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
                map on
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi G
                          %mrow
                            %mi ν
                            %mo +
                            %mn 1
                          %mi D
                      %annotation{:encoding => "application/x-tex"} G_{\nu +1}^D
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi G
                        %mi ν
                        %mi D
                      %mo ,
                      %msubsup
                        %mi j
                        %mi ν
                        %mi D
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (G_{\nu}^D, j_{\nu}^D)
                forms a
                = succeed "-divisible" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
            %li
              %p
                One of the important properties of the Cartier dual is that one can determine the height of a
                = succeed "-divisible" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
                = succeed "-divisible" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ht
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi ht
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi G
                          %mi D
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi dim
                        %mi G
                        %mo +
                        %mi dim
                        %msup
                          %mi G
                          %mi D
                      %annotation{:encoding => "application/x-tex"} ht(G)=ht(G^D)=\dim G + \dim G^D
          %h2#dieudonn_modules Dieudonné modules
          %p
            For the moment see
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/display+of+a+p-divisible+group"} display of a p-divisible group
          %h3#examples_2 Examples
          %ul
            %li
              %p
                The dual
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi μ
                          %mrow
                            %msup
                              %mi p
                              %mn ∞
                          %mi D
                        %mo ≃
                        %msub
                          %mi ℚ
                          %mi p
                        %mo{:stretchy => "false"} /
                        %msub
                          %mi ℤ
                          %mi p
                      %annotation{:encoding => "application/x-tex"} \mu_{p^\infty}^D\simeq \mathbb{Q}_p/\mathbb{Z}_p
            %li
              %p
                For an abelian variety
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo{:stretchy => "false"} (
                      %mi p
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi D
                      %mo =
                      %msup
                        %mi X
                        %mi t
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} X(p)^D=X^t(p)
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi X
                        %mi t
                    %annotation{:encoding => "application/x-tex"} X^t
                denotes the dual abelian variety. Another proof that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} X(p)
                has height
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mi g
                    %annotation{:encoding => "application/x-tex"} 2g
                is to note that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi X
                        %mi t
                    %annotation{:encoding => "application/x-tex"} X^t
                have the same dimension
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                      %annotation{:encoding => "application/x-tex"} g
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ht
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 2
                        %mi g
                      %annotation{:encoding => "application/x-tex"} ht(X(p))=2g
