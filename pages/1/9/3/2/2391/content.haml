                    %mo{:stretchy => "false"} (
                    %mi Ψ
                    %mo ,
                    %mover
                      %mi Ψ
                      %mo{:stretchy => "false"} ¯
                    %mo ,
                    %mi ψ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\alpha,\bar{\alpha}):(\Phi,\bar{\Phi},\phi)\to (\Psi,\bar{\Psi},\psi)
              of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo :
                    %mi Φ
                    %mo →
                    %mi Ψ
                  %annotation{:encoding => "application/x-tex"} \alpha:\Phi\to\Psi
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi α
                      %mo{:stretchy => "false"} ¯
                    %mo :
                    %mover
                      %mi Φ
                      %mo{:stretchy => "false"} ¯
                    %mo →
                    %mover
                      %mi Ψ
                      %mo{:stretchy => "false"} ¯
                  %annotation{:encoding => "application/x-tex"} \bar{\alpha}:\bar{\Phi}\to\bar{\Psi}
              such that the diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Φ
                            %msub
                              %mi u
                              %mo *
                          %mtd
                            %mover
                              %mo ⟶
                              %mi ϕ
                          %mtd
                            %msub
                              %mi v
                              %mo *
                            %mover
                              %mi Ψ
                              %mo{:stretchy => "false"} ¯
                        %mtr
                          %mtd
                            %mi α
                            %msub
                              %mi u
                              %mo *
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                            %msub
                              %mi v
                              %mo *
                            %mover
                              %mi α
                              %mo{:stretchy => "false"} ¯
                        %mtr
                          %mtd
                            %mi Ψ
                            %msub
                              %mi u
                              %mo *
                          %mtd
                            %mover
                              %mo ⟶
                              %mi ψ
                          %mtd
                            %msub
                              %mi v
                              %mo *
                            %mover
                              %mi Ψ
                              %mo{:stretchy => "false"} ¯
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\Phi u_* &amp; \stackrel{\phi}\longrightarrow &amp; v_* \bar{\Psi}\\
                    \\alpha u_*\downarrow &amp;&amp; \downarrow v_*\bar{\alpha}\\
                    \\Psi u_* &amp;\stackrel{\psi}\longrightarrow&amp; v_* \bar{\Psi}
                    
                    }
            %p
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"}> commutes
              \.
          %p
            Small Q-categories, morphisms of Q-categories and natural transformations of morphisms form a
            %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
            of small Q-categories.
          #QopCategory.num_defn
            %h6#definition_4 Definition
            %p
              A
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Q
                        %mo ∘
                    %annotation{:encoding => "application/x-tex"} Q^\circ
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                      %mo :
                      %mi A
                      %mo ↔
                      %mover
                        %mi A
                        %mo{:stretchy => "false"} ¯
                      %mo :
                      %mi I
                    %annotation{:encoding => "application/x-tex"} Q: A\leftrightarrow\bar{A}: I
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
              is fully faithful and right adjoint to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is equipped with an equivalence with a
              %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective subcategory
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi A
                        %mo{:stretchy => "false"} ¯
                    %annotation{:encoding => "application/x-tex"} \bar{A}
          %h2#examples Examples
          %h3#PresheafQCategory
            (Co)Presheaves on a
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/category+of+presheaves"} category of presheaves
            over any
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
          #PresheafQCategories.num_prop
            %h6#proposition Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔸
                    %mo =
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ¯
                    %mover
                      %munder
                        %mo →
                        %mi R
                      %mover
                        %mo ←
                        %mi L
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \mathbb{A} = \bar A \stackrel{\overset{L}{\leftarrow}}{\underset{R}{\to}} A
              be a
              = succeed "-category." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} Q
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              be any category.
            %p
              Then forming
              %a.existingWikiWord{:href => "/nlab/show/copresheaves"} copresheaves
              with values in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              yields a Q-category of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi 𝔸
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} ]
                    %mo :
                    %mo{:stretchy => "false"} [
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ¯
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} ]
                    %mover
                      %munder
                        %mo →
                        %mrow
                          %msup
                            %mi C
                            %mi L
                          %mo =
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                          %mo ∘
                          %mi L
                      %mover
                        %mo ←
                        %mrow
                          %msup
                            %mi C
                            %mi R
                          %mo =
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                          %mo ∘
                          %mi R
                    %mo{:stretchy => "false"} [
                    %mi A
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [\mathbb{A},C] :
                    [\bar A, C]
                    \\stackrel{\overset{C^R = (-)\circ R}{\leftarrow}}{\underset{C^L = (-)\circ L}{\to}}
                    [A,C]
                    \\,.
          .proof
            %h6#proof Proof
            %p
              The
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi C
                        %mi R
                      %mo ⊣
                      %msup
                        %mi C
                        %mi L
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (C^R \dashv C^L)
              %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} unit
              is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi η
                  %annotation{:encoding => "application/x-tex"} C^\eta
              induced by the original unit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo :
                    %msub
                      %mn 1
                      %mi A
                    %mo →
                    %mi R
                    %mi L
                  %annotation{:encoding => "application/x-tex"} \eta: 1_A\to R L
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi η
                    %mo :
                    %msub
                      %mi Id
                      %mrow
                        %msup
                          %mi C
                          %mi A
                    %mo →
                    %msup
                      %mi C
                      %mi L
                    %mo ∘
                    %msup
                      %mi C
                      %mi R
                    %mo =
                    %msup
                      %mi C
                      %mrow
                        %mi R
                        %mi L
                  %annotation{:encoding => "application/x-tex"}
                    C^{\eta} : Id_{C^A} \to C^L \circ C^R = C^{R L}
            %p
              and the counit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi ϵ
                  %annotation{:encoding => "application/x-tex"} C^\epsilon
              is induced by the original counit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo :
                    %mi L
                    %mi R
                    %mo →
                    %msub
                      %mn 1
                      %mover
                        %mi A
                        %mo{:stretchy => "false"} ¯
                  %annotation{:encoding => "application/x-tex"} \epsilon: L R\to 1_{\bar{A}}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi ϵ
                    %mo :
                    %msup
                      %mi C
                      %mi R
                    %mo ∘
                    %msup
                      %mi C
                      %mi L
                    %mo =
                    %msup
                      %mi C
                      %mrow
                        %mi L
                        %mi R
                    %mo →
                    %msub
                      %mi Id
                      %mrow
                        %msup
                          %mi C
                          %mover
                            %mi A
                            %mo{:stretchy => "false"} ¯
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    C^\epsilon : C^R\circ C^L = C^{L R}\to Id_{C^{\bar{A}}}
                    \\,.
            %p
              The only thing is who is adjoint – now
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi R
                  %annotation{:encoding => "application/x-tex"} C^R
              is the left adjoint.
            %p
              The triangle identities for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi R
                    %mo ⊣
                    %msup
                      %mi C
                      %mi L
                  %annotation{:encoding => "application/x-tex"} C^R\dashv C^L
              can be obtained by expanding. For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo :
                      %mover
                        %mi A
                        %mo{:stretchy => "false"} ¯
                      %mo →
                      %mi A
                    %annotation{:encoding => "application/x-tex"} R: \bar{A}\to A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi R
                    %mo :
                    %msup
                      %mi C
                      %mi A
                    %mo →
                    %msup
                      %mi C
                      %mover
                        %mi A
                        %mo{:stretchy => "false"} ¯
                  %annotation{:encoding => "application/x-tex"} C^R : C^A\to C^{\bar{A}}
              is given by
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mi R
                      %mo :
                      %mi G
                      %mo ↦
                      %mi GR
                    %annotation{:encoding => "application/x-tex"} C^R : G\mapsto GR
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo :
                    %mi A
                    %mo →
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ¯
                  %annotation{:encoding => "application/x-tex"} L:A\to\bar{A}
              one has
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mi L
                      %mo :
                      %mi F
                      %mo ↦
                      %mi F
                      %mi L
                    %annotation{:encoding => "application/x-tex"} C^L:F\mapsto F L
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi η
                    %mo :
                    %msub
                      %mi Id
                      %mrow
                        %msup
                          %mi C
                          %mi A
                    %mo →
                    %msup
                      %mi C
                      %mi R
                    %msup
                      %mi C
                      %mi L
                    %mo =
                    %msup
                      %mi C
                      %mi LR
                  %annotation{:encoding => "application/x-tex"} C^\eta : Id_{C^A}\to C^R C^L = C^{LR}
              has the components
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi C
                      %mi η
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi G
                    %mo :
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Id
                      %mrow
                        %msup
                          %mi C
                          %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo ⇒
                    %msup
                      %mi C
                      %mi R
                    %msup
                      %mi C
                      %mi L
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (C^\eta)_G : (Id_{C^A})(G) \Rightarrow C^R C^L (G)
              given by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mi η
                      %mo :
                      %mi G
                      %mo →
                      %mi G
                      %mi L
                      %mi R
                    %annotation{:encoding => "application/x-tex"} G \eta : G\to G L R
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo ∈
                      %msup
                        %mi C
                        %mover
                          %mi A
                          %mo{:stretchy => "false"} ¯
                    %annotation{:encoding => "application/x-tex"} G\in C^{\bar{A}}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mi R
                    %mover
                      %mo ⟶
                      %mrow
                        %mi G
                        %mi η
                        %mi R
                    %mi G
                    %mi R
                    %mi L
                    %mi R
                    %mover
                      %mo ⟶
                      %mrow
                        %mi G
                        %mi R
                        %mi η
                    %mi G
                    %mi R
                  %annotation{:encoding => "application/x-tex"} G R\stackrel{G\eta R}\longrightarrow G R L R \stackrel{G R \eta}\longrightarrow G R
            %p
              is the identity by the triangle identity for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mo ⊣
                      %mi R
                    %annotation{:encoding => "application/x-tex"} L\dashv R
              = succeed "-component" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi R
                    %mover
                      %mo ⟶
                      %mrow
                        %msup
                          %mi C
                          %mi R
                        %msup
                          %mi C
                          %mi η
                    %msup
                      %mi C
                      %mi R
                    %msup
                      %mi C
                      %mi L
                    %msup
                      %mi C
                      %mi R
                    %mover
                      %mo ⟶
                      %mrow
                        %msup
                          %mi C
                          %mi ϵ
                        %msup
                          %mi C
                          %mi R
                    %msup
                      %mi C
                      %mi R
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    C^R \stackrel{C^R C^\eta}\longrightarrow C^R C^L C^R \stackrel{C^\epsilon C^R}\longrightarrow C^R.
            %p
              Similarly the
              = succeed "-component" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi L
                    %mover
                      %mo ⟶
                      %mrow
                        %msup
                          %mi C
                          %mi η
                        %msup
                          %mi C
                          %mi L
                    %msup
                      %mi C
                      %mi L
                    %msup
                      %mi C
                      %mi R
                    %msup
                      %mi C
                      %mi L
                    %mover
                      %mo ⟶
                      %mrow
                        %msup
                          %mi C
                          %mi L
                        %msup
                          %mi C
                          %mi ϵ
                    %msup
                      %mi C
                      %mi L
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    C^{L} \stackrel{C^\eta C^L}\longrightarrow C^L C^R C^L \stackrel{C^L C^\epsilon}\longrightarrow C^L,
            %p
              for a functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ∈
                    %msup
                      %mi C
                      %mi A
                  %annotation{:encoding => "application/x-tex"} F\in C^A
              reads
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mi L
                    %mover
                      %mo ⟶
                      %mrow
                        %mi F
                        %mi L
                        %mi η
                    %mi F
                    %mi L
                    %mi R
                    %mi L
                    %mover
                      %mo ⟶
                      %mrow
                        %mi F
                        %mi ϵ
                        %mi L
                    %mi F
                    %mi L
                  %annotation{:encoding => "application/x-tex"} F L \stackrel{F L \eta}\longrightarrow F L R L  \stackrel{F \epsilon L}\longrightarrow F L
            %p
              and this composition equals
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Id
                      %mrow
                        %mi F
                        %mi L
                  %annotation{:encoding => "application/x-tex"} Id_{F L}
              by another triangle identity for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mo ⊣
                      %mi R
                    %annotation{:encoding => "application/x-tex"} L\dashv R
            %p
              It is clear that if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
              is iso then the composition with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
              is also iso. Thus we obtain a
              = succeed "-categories." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} Q
            %p
              In other words, since the
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              being a
              %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+functor"} full and faithful functor
              is equivalent to the unit of the
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
              being an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              being full and faithful that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi R
                  %annotation{:encoding => "application/x-tex"} C^R
              is full and faithful.
          %p
            This appears as (
            %a{:href => "#KontsevichRosenbergSpaces"}> Kontsevich-Rosenberg, 2.7
            ).
          #ExtraAdjointsForPresheafQCategories.num_note
            %h6#note_2 Note
            %p
              Assume in the context of prop.
              %a.maruku-ref{:href => "#PresheafQCategories"}
              that
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi A
                          %mo{:stretchy => "false"} ¯
                      %annotation{:encoding => "application/x-tex"} \bar A
                  are
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/small+categories"} small categories
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  has all small
                  = succeed "s" do
                    %a.existingWikiWord{:href => "/nlab/show/limit"} limit
                  = succeed "s" do
                    %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  \=
                  = succeed ")." do
                    %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            %p
              Then there is an
              %a.existingWikiWord{:href => "/nlab/show/adjoint+quadruple"} adjoint quadruple
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi u
                      %mo !
                    %mo ⊣
                    %msup
                      %mi u
                      %mo *
                    %mo ⊣
                    %msub
                      %mi u
                      %mo *
                    %mo ⊣
                    %msup
                      %mi u
                      %mo !
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo{:stretchy => "false"} [
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ¯
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mover
                        %mover
                          %munder
                            %mo ←
                            %mrow
                              %msup
                                %mi u
                                %mo !
                              %mo =
                              %mi Ran
                              %mi L
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mi u
                                %mo *
                              %mo =
                              %msup
                                %mi C
                                %mi L
                        %mover
                          %mo ←
                          %mrow
                            %msup
                              %mi u
                              %mo *
                            %mo =
                            %msup
                              %mi C
                              %mi R
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi u
                            %mo !
                          %mo =
                          %mi Lan
                          %mi R
                    %mo{:stretchy => "false"} [
                    %mi A
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    (u_! \dashv u^* \dashv u_* \dashv u^!) :
                    [\bar A, C]
                    \\stackrel{\overset{u_! = Lan R}{\to}}{\stackrel{\overset{u^* = C^R}{\leftarrow}}{\stackrel{\overset{u_* = C^L}{\to}}{\underset{u^! = Ran L}{\leftarrow}}}}
                    [A,C]
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Lan
                    %mi R
                  %annotation{:encoding => "application/x-tex"} Lan R
              denotes the left
              %a.existingWikiWord{:href => "/nlab/show/Kan+extension"} Kan extension
              along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ran
                    %mi L
                  %annotation{:encoding => "application/x-tex"} Ran L
              the right Kan extension along
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                    %annotation{:encoding => "application/x-tex"} L
          .proof
            %h6#proof_2 Proof
            %p
              By general properties of
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/Kan+extension"} Kan extension
          #SubcategoryOfPresheafQCategories.num_defn
            %h6#proposition_2 Proposition
            %p
              Any subcategory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ⊂
                    %msup
                      %mi C
                      %mover
                        %mi A
                        %mo{:stretchy => "false"} ¯
                  %annotation{:encoding => "application/x-tex"} B\subset C^{\bar{A}}
              containing
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Im
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi C
                      %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Im(C^R)
              determines a Q-subcategory
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mi A
                      %mo ↔
                      %mi B
                    %annotation{:encoding => "application/x-tex"} C^A\leftrightarrow B
          %h3#DomainAndCodomainFibration Domain and codomain fibration
          #DomainAndCodomainFibration.num_defn
            %h6#proposition_3 Proposition
            %p
              For any
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ¯
                    %mo :
                    %mo =
                    %msup
                      %mi A
                      %mi I
                  %annotation{:encoding => "application/x-tex"} \bar A := A^I
              for its
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/arrow+category"} arrow category
              %a.existingWikiWord{:href => "/nlab/show/codomain+fibration"} codomain fibration
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi cod
                    %mo :
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ¯
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} cod : \bar A \to A
              and the
              %a.existingWikiWord{:href => "/nlab/show/domain+cofibration"} domain cofibration
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi dom
                      %mo :
                      %mover
                        %mi A
                        %mo{:stretchy => "false"} ¯
                      %mo →
                      %mi A
                    %annotation{:encoding => "application/x-tex"} dom : \bar A \to A
              %a.existingWikiWord{:href => "/nlab/show/section"} section
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo :
                    %mi A
                    %mo →
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ¯
                  %annotation{:encoding => "application/x-tex"} \epsilon : A \to \bar A
              by a
              %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+functor"} full and faithful functor
              that assigns identity morphisms. These form a triple of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjoint functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi codom
                    %mo ⊣
                    %mi ϵ
                    %mo ⊣
                    %mi dom
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msup
                      %mi A
                      %mi I
                    %mover
                      %mover
                        %munder
                          %mo →
                          %mi dom
                        %mover
                          %mo ←
                          %mi ϵ
                      %mover
                        %mo →
                        %mi codom
                    %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (codom \dashv \epsilon \dashv dom) :
                    A^I
                    \\stackrel{\overset{codom}{\to}}{\stackrel{\overset{\epsilon}{\leftarrow}}{\underset{dom}{\to}}}
                    A
                    \\,.
            %p Taking this apart, we have that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mi dom
                    %mo :
                    %msup
                      %mi A
                      %mi I
                    %mover
                      %munder
                        %mo →
                        %mi dom
                      %mover
                        %mo ←
                        %mi ϵ
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    A^{dom} : A^I \stackrel{\overset{\epsilon}{\leftarrow}}{\underset{dom}{\to}}
                    A
            %p
              is a
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} Q
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mi dom
                    %mo :
                    %msup
                      %mi A
                      %mi I
                    %mover
                      %munder
                        %mo ←
                        %mi ϵ
                      %mover
                        %mo →
                        %mi cod
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    A^{dom} : A^I
                    \\stackrel{\overset{cod}{\to}}{\underset{\epsilon}{\leftarrow}}
                    A
            %p
              is a
              = succeed "-category." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Q
                        %mi o
                    %annotation{:encoding => "application/x-tex"} Q^o
          %p
            This appears as (
            %a{:href => "#KontsevichRosenbergSpaces"}> Kontsevich-Rosenberg, 2.5
            ).
          %p
            Several classes of examples of Q-categories of interest arise as sub-Q-categories of those of this form. For instance the Q-categories of infinitesimal thickenings
            = succeed "." do
              %a{:href => "#InfinitesimalThickening"} below
          #PresheavesOnCodomainFibration.num_note
            %h6#note_3 Note
            %p
              Passing to copresheaf Q-categories as in prop.
              %a.maruku-ref{:href => "#PresheafQCategories"}
              we have the Q-category
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi A
                      %mi I
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mover
                        %mover
                          %mo ←
                          %mrow
                            %msup
                              %mi u
                              %mo !
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                            %mo ∘
                            %mi codom
                        %mover
                          %mo →
                          %mrow
                            %msub
                              %mi u
                              %mo *
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                            %mo ∘
                            %mi ϵ
                      %mover
                        %mo ←
                        %mrow
                          %msup
                            %mi u
                            %mo *
                          %mo =
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                          %mo ∘
                          %mi dom
                    %mo{:stretchy => "false"} [
                    %mi A
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    [A^I,Set]
                    \\stackrel{\overset{u^* = (-)\circ dom}{\leftarrow}}{\stackrel{\overset{u_* = (-)\circ \epsilon}{\to}}{\overset{u^! = (-)\circ codom}{\leftarrow}}}
                    [A,Set]
            %p
              where the extra
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              is given by precomposition with the domain evaluation.
          %h3#qcategory_of_cones Q-category of cones
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be a category and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi LC
                %annotation{:encoding => "application/x-tex"} LC
            be the category whose objects are
            %a.existingWikiWord{:href => "/nlab/show/cones"} cones
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo :
                  %mi x
                  %mo →
                  %mi d
                %annotation{:encoding => "application/x-tex"} \alpha: x\to d
            over (small) diagrams
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mo :
                  %mi D
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} d: D\to C
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            are variable small categories; and the morphisms from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mover
                    %mo →
                    %mi α
                  %mi d
                %annotation{:encoding => "application/x-tex"} x\stackrel{\alpha}\to d
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ′
                  %mover
                    %mo →
                    %mrow
                      %mi α
                      %mo ′
                  %mi d
                  %mo ′
                %annotation{:encoding => "application/x-tex"} x'\stackrel{\alpha'}\to d'
            are triples of the form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mi ρ
                  %mo ,
                  %mover
                    %mi f
                    %mo{:stretchy => "false"} ¯
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (f,\rho,\bar{f})
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi x
                  %mo →
                  %mi x
                  %mo ′
                %annotation{:encoding => "application/x-tex"} f:x\to x'
            is a morphism in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                  %mo :
                  %mi D
                  %mo ′
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} \rho : D' \to D
            is a diagram (= functor), and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi f
                    %mo{:stretchy => "false"} ¯
                  %mo :
                  %mi d
                  %mo ∘
                  %mi ρ
                  %mo →
                  %mi d
                  %mo ′
                %annotation{:encoding => "application/x-tex"} \bar{f}:d \circ\rho \to d'
            is a morphism of diagrams (= natural transformation) such that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi x
                        %mtd
                          %mover
                            %mo →
                            %mi f
                        %mtd
                          %mi x
                          %mo ′
                      %mtr
                        %mtd
                          %mi α
                          %mo ⋆
                          %mi ρ
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                          %mi α
                          %mo ′
                      %mtr
                        %mtd
                          %mi d
                          %mo ∘
                          %mi ρ
                        %mtd
                          %mover
                            %mo →
                            %mover
                              %mi f
                              %mo{:stretchy => "false"} ¯
                        %mtd
                          %mi d
                          %mo ′
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  x &amp; \stackrel{f}\to &amp; x'\\
                  \\alpha \star\rho \downarrow &amp;&amp; \downarrow\alpha'\\
                  d \circ \rho&amp;\stackrel{\bar{f}}\to &amp; d'
                  }
          %p
            commutes and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo ⋆
                  %mi ρ
                %annotation{:encoding => "application/x-tex"} \alpha \star \rho
            denotes the horizontal composition (=
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Godement+product"} Godement product
          %p Then one defines composition of morphisms by the formula
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi f
                    %mn 1
                  %mo ,
                  %msub
                    %mi ρ
                    %mn 1
                  %mo ,
                  %mover
                    %mrow
                      %msub
                        %mi f
                        %mn 1
                    %mo{:stretchy => "false"} ¯
                  %mo{:stretchy => "false"} )
                  %mo ∘
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi f
                    %mn 2
                  %mo ,
                  %msub
                    %mi ρ
                    %mn 2
                  %mo ,
                  %mover
                    %mrow
                      %msub
                        %mi f
                        %mn 2
                    %mo{:stretchy => "false"} ¯
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo =
                    %mi def
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi f
                    %mn 1
                  %mo ∘
                  %msub
                    %mi f
                    %mn 2
                  %mo ,
                  %msub
                    %mi ρ
                    %mn 2
                  %mo ∘
                  %msub
                    %mi ρ
                    %mn 1
                  %mo ,
                  %mover
                    %mrow
                      %msub
                        %mi f
                        %mn 1
                    %mo{:stretchy => "false"} ¯
                  %mo ∘
                  %mo{:stretchy => "false"} (
                  %mover
                    %mrow
                      %msub
                        %mi f
                        %mn 2
                    %mo{:stretchy => "false"} ¯
                  %mo ⋆
                  %msub
                    %mi ρ
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (f_1, \rho_1,\bar{f_1})\circ(f_2, \rho_2,\bar{f_2})
                  \\stackrel{def}{=}(f_1\circ f_2, \rho_2\circ\rho_1, \bar{f_1} \circ (\bar{f_2} \star \rho_1)).
          %p
            There is a fully faithful functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Q
                    %mi C
                  %mo :
                  %mi C
                  %mo →
                  %mi LC
                %annotation{:encoding => "application/x-tex"} Q_C:C\to LC
            that to any
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi C
                %annotation{:encoding => "application/x-tex"} x\in C
            assigns the trivial cone
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi id
                    %mi x
                  %mo :
                  %mi x
                  %mo →
                  %mi x
                %annotation{:encoding => "application/x-tex"} id_x :x\to x
            and to any morphism the corresponding morphism of trivial cones. Its right adjoint is the morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi I
                    %mi C
                  %mo :
                  %mi LC
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} I_C:LC\to C
            defined by sending the cone
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo :
                  %mi x
                  %mo →
                  %mi d
                %annotation{:encoding => "application/x-tex"} \alpha: x\to d
            over a diagram
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mo :
                  %mi D
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} d:D\to C
            its vertex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            and to a cone morphism
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi ρ
                    %mo ,
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ¯
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (f,\rho,\bar{f})
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi I
                      %mi C
                    %mo ∘
                    %msub
                      %mi Q
                      %mi C
                    %mo =
                    %msub
                      %mi Id
                      %mi C
                  %annotation{:encoding => "application/x-tex"} I_C\circ Q_C = Id_C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϵ
                  %mo :
                  %msub
                    %mi Q
                    %mi C
                  %mo ∘
                  %msub
                    %mi I
                    %mi C
                  %mo →
                  %msub
                    %mi Id
                    %mi LC
                %annotation{:encoding => "application/x-tex"} \epsilon: Q_C\circ I_C \to Id_{LC}
            is constructed as follows: to a cone
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo :
                  %mi x
                  %mo →
                  %mi d
                %annotation{:encoding => "application/x-tex"} \alpha:x\to d
            assign the morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mn 1
                    %mi x
                  %mo ,
                  %mi const
                  %mo ,
                  %mi α
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (1_x, const, \alpha)
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi const
                  %mo :
                  %mi D
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} const: D\to C
            is the constant diagram which is the unique diagram from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo =
                  %mi dom
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} D = dom(d)
            to the final category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mo ⋆
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} 1=\{\star\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Q
                    %mi C
                  %mo ⊣
                  %msub
                    %mi I
                    %mi C
                %annotation{:encoding => "application/x-tex"} Q_C\dashv I_C
            of functors.
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Q
                    %mi C
                  %mo :
                  %mi C
                  %mo ↔
                  %msub
                    %mi I
                    %mi C
                  %mo :
                  %mi LC
                %annotation{:encoding => "application/x-tex"} Q_C: C\leftrightarrow I_C: LC
            is therefore a Q-category, and it is called the
            = succeed "." do
              %strong Q-category of cones
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℒ
                  %mo ⊂
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} \mathcal{L}\subset Cat
            is a family of small categories, then one considers the full subcategory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mi ℒ
                  %mi C
                %annotation{:encoding => "application/x-tex"} L_{\mathcal{L}}C
            of cones whose domains are in
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℒ
                  %annotation{:encoding => "application/x-tex"} \mathcal{L}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Q
                      %mi C
                      %mi ℒ
                    %mo :
                    %mi C
                    %mo ↔
                    %msub
                      %mi L
                      %mi ℒ
                    %mi C
                    %mo :
                    %msubsup
                      %mi I
                      %mi C
                      %mi ℒ
                  %annotation{:encoding => "application/x-tex"} Q^{\mathcal{L}}_C : C\leftrightarrow L_{\mathcal{L}}C : I_C^{\mathcal{L}}
          %p
            The most classical case is when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℒ
                %annotation{:encoding => "application/x-tex"} \mathcal{L}
            is the (say skeletal) category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Dis
                %annotation{:encoding => "application/x-tex"} Dis
            of small discrete categories (=just identity morphisms), one obtains then the Q-category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Q
                      %mi C
                      %mi Dis
                    %mo :
                    %mi C
                    %mo ↔
                    %msub
                      %mi L
                      %mi Dis
                    %mi C
                  %annotation{:encoding => "application/x-tex"} Q^{Dis}_C: C\leftrightarrow L_{Dis}C
            %strong semicosite
            (or semicositus pl. semicositi) is a Q-category of the form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo ↔
                  %mover
                    %mi C
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} C\leftrightarrow \bar{C}
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi C
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} \bar{C}
            is a full subcategory of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mi Dis
                  %mi C
                %annotation{:encoding => "application/x-tex"} L_{Dis}C
            and the adjoint pair is obtained by the restriction. A semicosite is a
            %strong precosite
            (=Grothendieck precotopology) if
          %p
            (i)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi id
                    %mi x
                  %mo ∈
                  %mi Ob
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi C
                    %mo{:stretchy => "false"} ¯
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} id_x\in Ob(\bar{C})
            whenever
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi Ob
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x\in Ob(C)
          %p
            (ii)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi x
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi ϕ
                        %mi i
                  %msub
                    %mi x
                    %mi i
                  %msub
                    %mo{:stretchy => "false"} }
                    %mrow
                      %mi i
                      %mo ∈
                      %mi I
                  %mo ∈
                  %mi Ob
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi C
                    %mo{:stretchy => "false"} ¯
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \{x\stackrel{\phi_i}\to x_i\}_{i\in I}\in Ob(\bar{C})
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi x
                    %mi i
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi ϕ
                        %mi ij
                  %msub
                    %mi x
                    %mi ij
                  %msub
                    %mo{:stretchy => "false"} }
                    %mrow
                      %mi j
                      %mo ∈
                      %msub
                        %mi J
                        %mi i
                  %mo ∈
                  %mi Ob
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi C
                    %mo{:stretchy => "false"} ¯
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \{x_i\stackrel{\phi_{ij}}\to x_{ij}\}_{j\in J_i}\in Ob(\bar{C})
            then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi x
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi ϕ
                        %mi ij
                      %mo ∘
                      %msub
                        %mi ϕ
                        %mi i
                  %msub
                    %mi x
                    %mi ij
                  %mo{:stretchy => "false"} }
                  %mo ∈
                  %mi Ob
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi C
                    %mo{:stretchy => "false"} ¯
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \{x\stackrel{\phi_{ij}\circ\phi_i}\to x_{ij}\}\in Ob(\bar{C})
          %p
            (iii)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi x
                  %mo →
                  %msub
                    %mi x
                    %mi i
                  %msub
                    %mo{:stretchy => "false"} }
                    %mrow
                      %mi i
                      %mo ∈
                      %mi I
                  %mo ∈
                  %mi Ob
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi C
                    %mo{:stretchy => "false"} ¯
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \{x\to x_i\}_{i\in I}\in Ob(\bar{C})
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ∈
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} g\in C(x,y)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi y
                  %mo ↦
                  %msub
                    %mi x
                    %mi i
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mi x
                  %mi y
                  %msub
                    %mo{:stretchy => "false"} }
                    %mrow
                      %mi i
                      %mo ∈
                      %mi I
                %annotation{:encoding => "application/x-tex"} \{y\mapsto x_i\coprod_x y\}_{i\in I}
            exists and belongs to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ob
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi C
                      %mo{:stretchy => "false"} ¯
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ob(\bar{C})
          %p An example of a cosite is a cosite of closed sets of a topological space.
          %h3#sieves Sieves
          %p
            The
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/sieves"} sieves
          %p
            The
            = succeed "-subcategory" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
          %p (needs explanation)
          %h3#the_qcategory_factoring_a_fully_faithful_factor The Q-category factoring a fully faithful factor
          %p
            Any fully faithful functor among small categories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} F: A\to B
            factors canonically into the composition
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mover
                    %mo →
                    %mrow
                      %msup
                        %mi u
                        %mo *
                  %mover
                    %mi A
                    %mo{:stretchy => "false"} ¯
                  %mo ↪
                  %mi B
                %annotation{:encoding => "application/x-tex"} A\stackrel{u^*}\to \bar{A}\hookrightarrow B
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi A
                    %mo{:stretchy => "false"} ¯
                  %mo ⊂
                  %mi B
                %annotation{:encoding => "application/x-tex"} \bar{A}\subset B
            is the full subcategory of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            whose objects are all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                %annotation{:encoding => "application/x-tex"} b
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ob
                  %mi B
                %annotation{:encoding => "application/x-tex"} Ob B
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ↦
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} a\mapsto B(F(a),b)
            is a representable functor
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mi op
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} A^{op}\to Set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi u
                    %mo *
                %annotation{:encoding => "application/x-tex"} u^*
            is the
            %a.existingWikiWord{:href => "/nlab/show/corestriction"} corestriction
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ¯
                  %annotation{:encoding => "application/x-tex"} \bar{A}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            is fully faithful, hence
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B(F(a),F(a)) = B(a,a)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mover
                    %mi A
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} F(a)\in \bar{A}
            for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ob
                    %mi A
                  %annotation{:encoding => "application/x-tex"} Ob A
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ¯
                  %annotation{:encoding => "application/x-tex"} b\in \bar{A}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi u
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} u_*(b)
            as the functor representing
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B(F(-),b)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi A
                    %mo{:stretchy => "false"} ¯
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi u
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %msub
                    %mi u
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \bar{A}(u^*(a),b) = B(F(a),b) \cong B(a,u_*(b))
            (KR NcSpaces A1.1.1). This relation on objects extends to an adjunction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi u
                    %mo *
                  %mo ⊣
                  %msub
                    %mi u
                    %mo *
                %annotation{:encoding => "application/x-tex"} u^*\dashv u_*
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi u
                    %mo *
                %annotation{:encoding => "application/x-tex"} u^*
            fully faithful.
          %h3#quasicosites Quasi-(co)-sites
          %p (…)
          #QuasiCoSite.num_defn
            %h6#definition_5 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              be a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒯
                  %annotation{:encoding => "application/x-tex"} \mathcal{T}
              a map that assigns to every
              %a.existingWikiWord{:href => "/nlab/show/object"} object
              a collection of co
              %a.existingWikiWord{:href => "/nlab/show/sieve"}> sieve
              s on that object (
              %a.existingWikiWord{:href => "/nlab/show/subfunctor"}> subfunctor
              s of
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} A(x,-)
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} A(x,-)
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi A
                        %mo{:stretchy => "false"} ¯
                      %mi 𝒯
                  %annotation{:encoding => "application/x-tex"} \bar A_{\mathcal{T}}
              for the category whose objects are co
              %a.existingWikiWord{:href => "/nlab/show/sieve"}> sieve
              s on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              that respect the corresponding cosieves. This yields a Q-category
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi A
                        %mo{:stretchy => "false"} ¯
                      %mi 𝒯
                    %mover
                      %mo →
                      %mo ←
                    %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\bar A_{\mathcal{T}}
                    \\stackrel{\leftarrow}{\to}
                    A
                    \\,.
            %p
              Call this a
              %strong quasi-cosite
              if
            %ol
              %li
                %p
                  for any two cosieves in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒯
                      %annotation{:encoding => "application/x-tex"} \mathcal{T}
                  their intersection is also in
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒯
                        %annotation{:encoding => "application/x-tex"} \mathcal{T}
              %li
                %p
                  for any cosive in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒯
                      %annotation{:encoding => "application/x-tex"} \mathcal{T}
                  any cosieve containing it is also in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒯
                        %annotation{:encoding => "application/x-tex"} \mathcal{T}
          %p
            This is (
            %a{:href => "#KontsevichRosenberg"}> KontsevichRosenberg, 2.2
            ).
          #QuasiCoSiteAssociatedToQCategory.num_defn
            %h6#definition_6 Definition
            %p
              For any Q-category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔸
                    %annotation{:encoding => "application/x-tex"} \mathbb{A}
              %strong quasi-cosite associated
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔸
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}
              is the Q-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒯
                    %mi 𝔸
                  %annotation{:encoding => "application/x-tex"} \mathcal{T}\mathbb{A}
              defined by…
          %p The following is supposed to be the standard quasi-cosite for non-commutative geometry.
          #NCQuasiCosite.num_defn
            %h6#definition_7 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              be a
              %a.existingWikiWord{:href => "/nlab/show/ring"} ring
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo :
                    %mo =
                    %msub
                      %mi Alg
                      %mi k
                  %annotation{:encoding => "application/x-tex"} A := Alg_k
              the category of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ¯
                    %mo ⊂
                    %msup
                      %mi A
                      %mi I
                  %annotation{:encoding => "application/x-tex"} \bar A \subset A^I
              be the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              of the
              %a{:href => "DomainAndCodomainFibration"} domain fibration
              whose objects are the
              %strong faithfully flat
              morphisms, i.e. those morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo :
                    %mi R
                    %mo →
                    %mi T
                  %annotation{:encoding => "application/x-tex"} \phi : R \to T
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Alg
                      %mi k
                  %annotation{:encoding => "application/x-tex"} Alg_k
              such that the induced
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ϕ
                      %mo *
                    %mo :
                    %mi R
                    %mi Mod
                    %mo →
                    %mi T
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"}
                    \\phi^* : R Mod \to T Mod
            %p
              is an
              %a.existingWikiWord{:href => "/nlab/show/exact+functor"} exact
              and
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+functor"} full and faithful functor
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒯
                    %msub
                      %mi Alg
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \mathcal{T}Alg_k
              for the quasi-cosite associated with this Q-category by def.
              = succeed "." do
                %a.maruku-ref{:href => "#QuasiCoSiteAssociatedToQCategory"}
              = succeed "." do
                %strong
                  standard quasi-cosite for
                  %a.existingWikiWord{:href => "/nlab/show/noncommutative+geometry"} noncommutative geometry
          %p
            This is (
            %a{:href => "#KontsevichRosenberg"}> KontsevichRosenberg, A.1.9.2
            ).
          %h3#InfinitesimalThickening Infinitesimal thickenings
          %p
            Generally,
            %a.existingWikiWord{:href => "/nlab/show/infinitesimal+object"} infinitesimal thickenings
            are characterized by
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/coreflective+subcategory"} coreflective embeddings
          %p
            A characteristic property of an
            %a.existingWikiWord{:href => "/nlab/show/infinitesimally+thickened+point"} infinitesimally thickened point
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            is that for any object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            without infinitesimal thickening, there are in general nontrivial morphisms
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} D \to X
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} X \to D
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            has only a single global point. Thus if by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo :
                  %mi C
                  %mo →
                  %mover
                    %mi C
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} i : C \to \bar C
            we denote the inclusion of objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            without infinitesimal thickening into the collection of possibly infinitesimally thickened objects, and by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo :
                  %mover
                    %mi C
                    %mo{:stretchy => "false"} ¯
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} p : \bar C \to C
            the projection that contracts away the infinitesimal extension, we have indeed an
            %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi C
                    %mo{:stretchy => "false"} ¯
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi D
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi p
                  %mo{:stretchy => "false"} (
                  %mi D
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mo *
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mo *
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\bar C(i(X), D) \simeq C(X, p(D)) \simeq C(X,*) \simeq *
                  \\,.
          %p
            This general concept is described at
            = succeed "." do
              %a{:href => "http://nlab.mathforge.org/nlab/show/cohesive+%28infinity%2C1%29-topos#InfinitesimalNeighBourhoodSite"} infinitesimal neighbourhood site
            = succeed "." do
              %a{:href => "#RelationToCohesiveToposes"} Relation to cohesive toposes
          %p The following is one realization of this general concept.
          #InfinitesimalThickening.num_prop
            %h6#proposition_4 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              be a
              %a.existingWikiWord{:href => "/nlab/show/field"} field
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo :
                    %mo =
                    %msub
                      %mi CAlg
                      %mi k
                  %annotation{:encoding => "application/x-tex"} A := CAlg_k
              be the category of commutative
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ¯
                    %mo ⊂
                    %msup
                      %mi A
                      %mi I
                  %annotation{:encoding => "application/x-tex"} \bar A \subset A^I
              be the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              of the
              %a.existingWikiWord{:href => "/nlab/show/codomain+fibration"} codomain fibration
              Q-category from prop.
              %a.maruku-ref{:href => "#DomainAndCodomainFibration"}
              on those morphisms of commutative algebras which are
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
              %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
              is nilpotent. Then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi CAlg
                      %mi k
                      %mi inf
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi ϵ
                    %mo ⊣
                    %mi dom
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ¯
                    %mover
                      %munder
                        %mo →
                        %mi dom
                      %mover
                        %mo ←
                        %mi ϵ
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    CAlg_k^{inf} = (\epsilon \dashv dom) : \bar A \stackrel{\overset{\epsilon}{\leftarrow}}{\underset{dom}{\to}} A
            %p is a Q-category.
            %p
              The analogous statement is true with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo =
                    %msub
                      %mi Alg
                      %mi k
                  %annotation{:encoding => "application/x-tex"} A = Alg_k
              the category of all
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
          %p
            This appears as (
            %a{:href => "#KontsevichRosenbergSpaces"}> Kontsevich-Rosenberg, 2.6
            ).
          #DiscussionOfTheInfinitesimalThickeningFormalization.num_remark
            %h6#remark Remark
            %p
              Here we think of an algebra epimorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo :
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} \phi : \mathbf{B} \to B
              with nilpotent kernel – an
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+ring+extension"} infinitesimal ring extension
              – as the infinitesimal thickening of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spec
                    %mi B
                  %annotation{:encoding => "application/x-tex"} Spec B
              by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spec
                    %mi ker
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} Spec ker \phi
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Spec
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                    %annotation{:encoding => "application/x-tex"} Spec \mathbf{B}
            %p
              The functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                  %annotation{:encoding => "application/x-tex"} \epsilon
              builds the trivial (empty) infinitesimal thickenings
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mi B
                    %mo :
                    %mi B
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi id
                          %mi B
                    %mi B
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\epsilon B : B \stackrel{id_B}{\to} B
                    \\,.
            %p
              The functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi dom
                  %annotation{:encoding => "application/x-tex"} dom
              remembers the
              %em thickened
              algebra
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi dom
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mo →
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    dom (\mathbf{B} \to B) = \mathbf{B}
                    \\,.
            %p But notice that we also have the codomain-functor, which is the functor that forgets the thickening
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi cod
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mo →
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi B
                  %annotation{:encoding => "application/x-tex"}
                    cod (\mathbf{B} \to B) = B
            %p
              and that the
              %a.existingWikiWord{:href => "/nlab/show/adjoint+pair"} adjoint pair
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ϵ
                    %mo ⊣
                    %mi dom
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\epsilon \dashv dom)
              does extend to an
              %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"} adjoint triple
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi CAlg
                      %mi k
                      %mi inf
                    %mo :
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ¯
                    %mover
                      %mover
                        %munder
                          %mo →
                          %mi dom
                        %mover
                          %mo ←
                          %mi ϵ
                      %mover
                        %mo →
                        %mi cod
                    %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    CAlg_k^{inf} : \bar A \stackrel{\overset{cod}{\to}}{\stackrel{\overset{\epsilon}{\leftarrow}}{\underset{dom}{\to}}} A
                    \\,.
            %p
              In the discussion at
              %a{:href => "http://nlab.mathforge.org/nlab/show/cohesive+%28infinity%2C1%29-topos#InfinitesimalCohesion"} Infinitesimal cohesion
              it is the pair
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi cod
                    %mo ⊣
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (cod \dashv \epsilon)
              that appears in the axiomatization, or rather its version on the opposite categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ϵ
                      %mi op
                    %mo ⊣
                    %msup
                      %mi cod
                      %mi op
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msup
                      %mover
                        %mi A
                        %mo{:stretchy => "false"} ¯
                      %mi op
                    %mover
                      %munder
                        %mo →
                        %mrow
                          %msup
                            %mi cod
                            %mi op
                      %mover
                        %mo ←
                        %mrow
                          %msup
                            %mi ϵ
                            %mi op
                    %msup
                      %mi A
                      %mi op
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    (\epsilon^{op} \dashv cod^{op}) : \bar A^{op} \stackrel{\overset{\epsilon^{op}}{\leftarrow}}{\underset{cod^{op}}{\to}} A^{op}
                    \\,,
            %p
              not the other adjoint pair
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ϵ
                    %mo ⊣
                    %mi dom
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\epsilon \dashv dom)
              used here.
            %p
              This is the reason for the shift in adjoint triples that is mentioned in
              %a{:href => "http://nlab.mathforge.org/nlab/show/cohesive+(infinity%2C1)-topos+--+infinitesimal+cohesion#RelationToRK"} this remark
              over at
              %em
                %a.existingWikiWord{:href => "/nlab/show/cohesive+%28infinity%2C1%29-topos+--+infinitesimal+cohesion"} infinitesimal cohesion
              \.
          %h2#ASheaves
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi 𝔸
                %annotation{:encoding => "application/x-tex"} \mathbb{A}
            \-Sheaves
          %p
            We discuss the notion of a
            %em
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi 𝔸
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}
              \-sheaves
            on a Q-category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔸
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}
          #BareSheafCondition.num_defn
            %h6#definition_8 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔸
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ¯
                    %mover
                      %munder
                        %mo →
                        %mrow
                          %msub
                            %mi u
                            %mo *
                      %mover
                        %mo ←
                        %mrow
                          %msup
                            %mi u
                            %mo *
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{A} = (\bar A \stackrel{\overset{u^*}{\leftarrow}}{\underset{u_*}{\to}}A)
              be a
              = succeed "." do
                %a{:href => "#QCategory"} Q-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} x \in A
              is called an
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi 𝔸
                    %annotation{:encoding => "application/x-tex"} \mathbb{A}
                \-sheaf
              if for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ∈
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ¯
                  %annotation{:encoding => "application/x-tex"} y \in \bar A
              the canonical morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ¯
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ,
                    %msup
                      %mi u
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi A
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi u
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\bar A(y, u^*(x)) \to A(u_*(y), x)
            %p
              is an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              (in
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
            %p This morphism is given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ↦
                    %msubsup
                      %mi η
                      %mi x
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ∘
                    %msub
                      %mi u
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    g \mapsto \eta_x^{-1} \circ u_*(g)
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi x
                    %mo :
                    %mi x
                    %mo →
                    %msub
                      %mi u
                      %mo *
                    %msup
                      %mi u
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \eta_x : x \to u_* u^*(x)
              is the
              = succeed "-component" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi u
                        %mo *
                      %mo ⊣
                      %msub
                        %mi u
                        %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (u^* \dashv u_*)
              %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} counit
              (which is an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              because
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi u
                      %mo *
                  %annotation{:encoding => "application/x-tex"} u^*
              is a
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+functor"} full and faithful functor
          %p
            This appears as (
            %a{:href => "#KontsevichRosenbergSpaces"}> Kontsevich-Rosenberg, 3.1.1
            ).
          #SheafConditionByExtraRightAdjoint.num_prop
            %h6#proposition_5 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔸
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}
              be a Q-category with an extra
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi u
                      %mo !
                    %mo :
                    %mi A
                    %mo →
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ¯
                  %annotation{:encoding => "application/x-tex"} u^! : A \to \bar A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔸
                    %mo :
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ¯
                    %mover
                      %mover
                        %munder
                          %mo ←
                          %mrow
                            %msup
                              %mi u
                              %mo !
                        %mover
                          %mo →
                          %mrow
                            %msub
                              %mi u
                              %mo *
                      %mover
                        %mo ←
                        %mrow
                          %msup
                            %mi u
                            %mo *
                    %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{A}
                    \:
                    \\bar A
                    \\stackrel{\overset{u^*}{\leftarrow}}{\stackrel{\overset{u_*}{\to}}{\underset{u^!}{\leftarrow}}}
                    A
                    \\,.
            %p
              Then an object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} x \in A
              is an
              = succeed "-sheaf" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔸
                    %annotation{:encoding => "application/x-tex"} \mathbb{A}
              %a.maruku-ref{:href => "#BareSheafCondition"}
              precisely if the canonical morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi u
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi u
                      %mo !
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %msup
                      %mi u
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                    %msup
                      %mi u
                      %mo !
                    %msub
                      %mi u
                      %mo *
                    %msup
                      %mi u
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≃
                    %msup
                      %mi u
                      %mo !
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (u^*(x) \to u^!(x))
                    \:=
                    u^*(X)
                    \\stackrel{}{\to}
                    u^! u_* u^* (x)
                    \\stackrel{\simeq}{\to}
                    u^! (x)
            %p
              is an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi A
                        %mo{:stretchy => "false"} ¯
                    %annotation{:encoding => "application/x-tex"} \bar A
          %p
            This appears as (
            %a{:href => "#KontsevichRosenbergSpaces"}> Kontsevich-Rosenberg, 3.1.3
            ).
          %p
            For more details on the canonical morphism appearing here see the section
            %a{:href => "http://nlab.mathforge.org/nlab/show/cohesive+topos#AdjointQuadruples"} Adjoint quadruples
            at
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cohesive+topos"} cohesive topos
          .proof
            %h6#proof_3 Proof
            %p
              Using the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi u
                        %mo *
                      %mo ⊣
                      %msup
                        %mi u
                        %mo !
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (u_* \dashv u^!)
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              we have that the canonical morphism from def.
              %a.maruku-ref{:href => "#BareSheafCondition"}
              is isomorphic to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo :
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ¯
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ,
                    %msup
                      %mi u
                      %mo *
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi A
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi u
                      %mo *
                    %mi y
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≃
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ¯
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ,
                    %msup
                      %mi u
                      %mo !
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\phi : \bar A(y, u^* x) \to A(u_* y, x) \stackrel{\simeq}{\to}
                    \\bar A(y, u^! x)
                    \\,,
            %p
              for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo ∈
                      %mover
                        %mi A
                        %mo{:stretchy => "false"} ¯
                    %annotation{:encoding => "application/x-tex"} y \in \bar A
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
              %a.maruku-ref{:href => "#BareSheafCondition"}
              and the expression of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %mi y
                    %mo →
                    %msup
                      %mi u
                      %mo *
                    %mi x
                  %annotation{:encoding => "application/x-tex"}
                    g : y \to u^* x
            %p to the composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi y
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msup
                              %mi u
                              %mo !
                            %msub
                              %mi u
                              %mo *
                            %mi y
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msup
                                  %mi u
                                  %mo !
                                %msub
                                  %mi u
                                  %mo *
                                %mi g
                          %mtd
                            %msup
                              %mi u
                              %mo !
                            %msub
                              %mi u
                              %mo *
                            %msup
                              %mi u
                              %mo *
                            %mi x
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mi u
                              %mo !
                            %mi x
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    y
                    \\\
                    \\downarrow
                    \\\
                    u^! u_* y &amp;\stackrel{u^! u_* g}{\to}&amp; u^! u_* u^* x
                    \\\
                    \&amp;&amp; \downarrow
                    \\\
                    \&amp;&amp; u^! x
                    }
                    \\,.
            %p
              Using that
              %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} adjunction units
              are
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi y
                          %mtd
                            %mover
                              %mo →
                              %mi g
                          %mtd
                            %msup
                              %mi u
                              %mo *
                            %mi x
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msup
                              %mi u
                              %mo !
                            %msub
                              %mi u
                              %mo *
                            %mi y
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msup
                                  %mi u
                                  %mo !
                                %msub
                                  %mi u
                                  %mo *
                                %mi g
                          %mtd
                            %msup
                              %mi u
                              %mo !
                            %msub
                              %mi u
                              %mo *
                            %msup
                              %mi u
                              %mo *
                            %mi x
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mi u
                              %mo !
                            %mi x
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    y &amp;\stackrel{g}{\to}&amp; u^* x
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    u^! u_* y &amp;\stackrel{u^! u_* g}{\to}&amp; u^! u_* u^* x
                    \\\
                    \&amp;&amp; \downarrow
                    \\\
                    \&amp;&amp; u^! x
                    }
                    \\,.
            %p
              This shows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              acts on any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              by postcomposition with the canonical morphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi u
                        %mo *
                      %mi x
                      %mo →
                      %msup
                        %mi u
                        %mo !
                      %mi x
