                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\Phi,\bar{\Phi},\phi)
              where
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Φ
                      %mo :
                      %mi A
                      %mo →
                      %mi B
