                          %mo !
                        %mi F
                      %annotation{:encoding => "application/x-tex"} u^* F \to u^! F
                  is a
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/formally+smooth"} formally smooth
                  precisely if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi u
                          %mo *
                        %mi F
                        %mo →
                        %msup
                          %mi u
                          %mo !
                        %mi F
                      %annotation{:encoding => "application/x-tex"} u^* F \to u^! F
                  is a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/strict+epimorphism"} strict epimorphism
          %p
            This appears as (
            %a{:href => "#KontsevichRosenbergSpaces"}> Kontsevich-Rosenberg, section 4.2
            ).
          #CharacterizationOfFormalNCSmoothness.num_prop
            %h6#proposition_7 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo ∈
                    %msub
                      %mi Alg
                      %mi k
                  %annotation{:encoding => "application/x-tex"} R \in Alg_k
              and write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spec
                    %mi R
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi Alg
                      %mi k
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} Spec R \in [Alg_k, Set]
              for the corresponding
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representable functor
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Spec
                        %mi R
                      %annotation{:encoding => "application/x-tex"} Spec R
                  is an
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi Alg
                          %mi k
                          %mi inf
                      %annotation{:encoding => "application/x-tex"} Alg_k^{inf}
                  epipresheaf (formally smooth) precisely if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                  is Quillen-Cuntz quasi-free: the
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi R
                          %msub
                            %mo ⊗
                            %mi k
                          %msup
                            %mi R
                            %mi op
                        %annotation{:encoding => "application/x-tex"} R \otimes_k R^{op}
                  %a.existingWikiWord{:href => "/nlab/show/module"} module
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msubsup
                            %mi Ω
                            %mrow
                              %mi R
                              %mo{:stretchy => "false"} |
                              %mi k
                            %mn 1
                        %annotation{:encoding => "application/x-tex"} \Omega^1_{R|k}
                  %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
                  of the multiplication morphism
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi Ω
                          %mrow
                            %mi R
                            %mo{:stretchy => "false"} |
                            %mi k
                          %mn 1
                        %mo :
                        %mo =
                        %mi ker
                        %mo{:stretchy => "false"} (
                        %mi R
                        %msub
                          %mo ⊗
                          %mi k
                        %mi R
                        %mover
                          %mo →
                          %mi mult
                        %mi R
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        \\Omega^1_{R|k} := ker(R \otimes_k R \stackrel{mult}{\to} R)
                        \\,,
                %p
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/projective+object"} projective
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                        %mo ⊗
                        %msup
                          %mi R
                          %mi op
                      %annotation{:encoding => "application/x-tex"} R \otimes R^{op}
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/Mod"} Mod
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Spec
                        %mi R
                      %annotation{:encoding => "application/x-tex"} Spec R
                  is an
                  = succeed "-monopresheaf" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msubsup
                            %mi Alg
                            %mi k
                            %mi inf
                        %annotation{:encoding => "application/x-tex"} Alg_k^{inf}
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msubsup
                            %mi Ω
                            %mrow
                              %mi R
                              %mo{:stretchy => "false"} |
                              %mi k
                            %mn 1
                          %mo =
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} \Omega^1_{R|k} = 0
          %p
            This appears as (
            %a{:href => "#KontsevichRosenbergSpaces"}> Kontsevich-Rosenberg, prop. 4.3
            ).
          %h2#relation_to_other_concepts Relation to other concepts
          %h3#RelationToCohesiveToposes Relation to cohesive toposes
          %p
            If a Q-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔸
                %annotation{:encoding => "application/x-tex"} \mathbb{A}
            has the extra
            %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            of prop.
            %a.maruku-ref{:href => "#SheafConditionByExtraRightAdjoint"}
            and in addition an extra left adjoint to a total of a quadruple of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjoint functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔸
                  %mo :
                  %mover
                    %mi A
                    %mo{:stretchy => "false"} ¯
                  %mover
                    %mover
                      %mover
                        %munder
                          %mo ←
                          %mrow
                            %msup
                              %mi u
                              %mo !
                        %mover
                          %mo →
                          %mrow
                            %msub
                              %mi u
                              %mo *
                      %mover
                        %mo ←
                        %mrow
                          %msup
                            %mi u
                            %mo *
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi u
                          %mo !
                  %mi A
                %annotation{:encoding => "application/x-tex"}
                  \\mathbb{A} :
                  \\bar A
                  \\stackrel{\overset{u_!}{\to}}{\stackrel{\overset{u^*}{\leftarrow}}{\stackrel{\overset{u_*}{\rightarrow}}{\underset{u^!}{\leftarrow}}}}
                  A
          %p
            then essential axioms characterizing a
            %a.existingWikiWord{:href => "/nlab/show/cohesive+topos"} cohesive topos
            are satisfied, in particular if for instance
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi A
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} \bar A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            are
            = succeed "es" do
              %a.existingWikiWord{:href => "/nlab/show/presheaf+topos"} presheaf topos
            %a.maruku-ref{:href => "#PresheafQCategories"}
            (this is considered around
            = succeed ")." do
              %a{:href => "#KontsevichRosenbergSpaces"} Kontsevich-Rosenberg, 3.5.1
          %p
            Notably in this case the canonical
            %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi u
                    %mo *
                  %mo →
                  %msup
                    %mi u
                    %mo !
                %annotation{:encoding => "application/x-tex"}
                  u^* \to u^!
          %p
            from prop.
            %a.maruku-ref{:href => "#SheafConditionByExtraRightAdjoint"}
            is the one appears in the axioms of a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/cohesive+topos"} cohesive topos
            %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
            in a cohesive topos – hence if in the language of Q-categories all objects are monopresheaves – one says that
            %em discrete objects are concrete
            in the cohesive topos.
          %p
            Moreover, due to the extra left adjoint
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi u
                    %mo !
                %annotation{:encoding => "application/x-tex"} u_!
            there is a canonical dual morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi u
                    %mo *
                  %mo →
                  %msub
                    %mi u
                    %mo !
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  u_* \to u_!
                  \\,.
          %p
            In (
            %a{:href => "#Lawvere"}> Lawvere
            ) is the suggestion that it is interesting to consider the full subcategory of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi A
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} \bar A
            on which
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi u
                    %mo *
                  %mo →
                  %msub
                    %mi u
                    %mo !
                %annotation{:encoding => "application/x-tex"} u_* \to u_!
            is an isomorphism. This is dual to the statement of the above section on
            %a{:href => "#ASheaves"} A-Sheaves
            which asserts that it is interesting to consider the full subcategory of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            on which
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi u
                    %mo *
                  %mo →
                  %msup
                    %mi u
                    %mo !
                %annotation{:encoding => "application/x-tex"} u^* \to u^!
            is an isomorphism.
          %p
            More concretely, the axioms of
            %a{:href => "http://nlab.mathforge.org/nlab/show/cohesive+%28infinity%2C1%29-topos#InfinitesimalCohesion"} Infinitesimal cohesion
            are an abstraction of the situation of prop.
            = succeed "." do
              %a.maruku-ref{:href => "#InfinitesimalThickening"}
            = succeed "-topos" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %em infinitesimal neighbourhood
            there is an analog of the characterization of formal smoothness from prop.
            = succeed "." do
              %a.maruku-ref{:href => "#FormalSmoothnessByASheaves"}
            = succeed "." do
              %a{:href => "http://nlab.mathforge.org/nlab/show/cohesive+%28infinity%2C1%29-topos#InfinitesimalPaths"} Infinitesimal paths and de Rham spaces
          %h3#sheafification_versus_the_gabriel_localization_
            Sheafification versus the Gabriel localization
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi G
                    %mi ℱ
                  %mo =
                  %msubsup
                    %mi H
                    %mi ℱ
                    %mn 2
                %annotation{:encoding => "application/x-tex"} G_{\mathcal{F}} = H^2_{\mathcal{F}}
          %p (…)
          %h2#references References
          %p
            The term
            %em
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
              \-category
            originally was short for
            %em almost quotient category
            , presumably because of its role in the theory of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Gabriel+localization"} Gabriel localization
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
          %ul#Rosenberg
            %li
              %a.existingWikiWord{:href => "/nlab/show/Alexander+Rosenberg"}> Alexander Rosenberg
              ,
              = succeed "," do
                %em Q-categories, sheaves and localization
              = succeed "," do
                %strong 25
          %p The formalism is used (and briefly surveyed) in
          %ul#KontsevichRosenbergSpaces
            %li
              %a.existingWikiWord{:href => "/nlab/show/Maxim+Kontsevich"}> Maxim Kontsevich
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Alexander+Rosenberg"} Alexander Rosenberg
              = succeed "," do
                %em Noncommutative spaces
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/files/KontsevichRosenbergNCSpaces.pdf", :title => "pdf"} pdf
              = succeed "," do
                %a{:href => "http://www.mpim-bonn.mpg.de/preprints/send?bid=2331"} ps
              = succeed ")" do
                %a{:href => "http://www.mpim-bonn.mpg.de/preprints/send?bid=2303"} dvi
          %p and also used in the general definition of “noncommutative” stacks in
          %ul#KontsevichRosenbergStacks
            %li
              %a.existingWikiWord{:href => "/nlab/show/Maxim+Kontsevich"}> Maxim Kontsevich
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Alexander+Rosenberg"} Alexander Rosenberg
              = succeed "," do
                %em Noncommutative stacks
              = succeed "," do
                %a{:href => "http://www.mpim-bonn.mpg.de/preprints/send?bid=2333"} ps
              = succeed ")" do
                %a{:href => "http://www.mpim-bonn.mpg.de/preprints/send?bid=2305"} dvi
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/epipresheaf"} epipresheaf
            condition for the Q-category of nilpotent (infinitesimal) thickenings is in the Kontsevich-Rosenberg paper interpreted as
            %a.existingWikiWord{:href => "/nlab/show/formally+smooth+morphism"} formal smoothness
            what is further studied in
          %ul#Brzezinski
            %li
              %a.existingWikiWord{:href => "/nlab/show/T.+Brzezinski"}> T. Brzezinski
              ,
              = succeed "," do
                %em Notes on formal smoothness
              = succeed ":" do
                %em in
              = succeed ")." do
                %em Trends in Mathematics
              = succeed "," do
                %a{:href => "http://dx.doi.org/10.1007/978-3-7643-8742-6"} doi
              = succeed ")" do
                %a{:href => "http://arxiv.org/abs/0710.5527"} arXiv:0710.5527
          %p
            The condition that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi u
                    %mo *
                  %mi x
                  %mo →
                  %msub
                    %mi u
                    %mo !
                  %mi x
                %annotation{:encoding => "application/x-tex"} u_* x \to u_! x
            is an isomorphism, dual to the condition for
            = succeed "-sheaves" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔸
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}
          %ul#Lawvere
            %li
              %a.existingWikiWord{:href => "/nlab/show/Bill+Lawvere"}> Bill Lawvere
              ,
              %em Axiomatic cohesion
              Theory and Applications of Categories
              = succeed ":3," do
                %strong 19
              = succeed ")" do
                %a{:href => "http://www.tac.mta.ca/tac/volumes/19/3/19-03.pdf"} pdf
        .revisedby
