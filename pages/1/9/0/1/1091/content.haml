                        %mover
                          %mo ←
                          %mrow
                            %msup
                              %mi f
                              %mo *
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi f
                            %mo !
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} /
                    %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    (\sum_f \dashv f^* \dashv \prod_f) : \mathbf{H}/X
                    \\stackrel{\overset{f_!}{\to}}{\stackrel{\overset{f^*}{\leftarrow}}{\underset{f_*}{\to}}}
                    \\mathbf{H}/Y
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo !
                  %annotation{:encoding => "application/x-tex"} f_!
              is given by postcomposition with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^*
              by
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              along
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
          .proof
            %h6#proof Proof
            %p
              That we have
              = succeed "s/" do
                %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjoint functor
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functor"} adjoint (∞,1)-functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mo !
                    %mo ⊣
                    %msup
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (f_! \dashv f^*)
              follows directly from the universal property of the pullback. The fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^*
              has a further
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              is due to the fact that it preserves all small
              = succeed "s/" do
                %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimit"} (∞,1)-colimit
              %a.existingWikiWord{:href => "/nlab/show/universal+colimits"} universal colimits
              and then by the
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/adjoint+functor+theorem"} adjoint functor theorem
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functor+theorem"} adjoint (∞,1)-functor theorem
          .num_remark
            %h6#remark Remark
            %p
              The (
              %a.existingWikiWord{:href => "/nlab/show/comonad"}> co-
              )
              %a.existingWikiWord{:href => "/nlab/show/monads"} monads
              induced by the
              %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"} adjoint triple
              in prop.
              %a.maruku-ref{:href => "#BaseChangeIsEssentialGeometricMorphism"}
              have special names in some contexts:
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi f
                          %mo *
                        %msup
                          %mi f
                          %mo *
                      %annotation{:encoding => "application/x-tex"} f_\ast f^\ast
                  is also called the
                  %a.existingWikiWord{:href => "/nlab/show/function+monad"} function monad
                  (or “
                  %a.existingWikiWord{:href => "/nlab/show/reader+monad"}> reader monad
                  ”, see at
                  = succeed ")." do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/monad+%28in+computer+science%29"} monad (in computer science)
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi f
                          %mo !
                        %msup
                          %mi f
                          %mo *
                      %annotation{:encoding => "application/x-tex"} f_! f^\ast
                  is also called the “
                  %a.existingWikiWord{:href => "/nlab/show/writer+comonad"}> writer comonad
                  ” (in computer science)
              %li
                %p
                  in
                  %a.existingWikiWord{:href => "/nlab/show/modal+type+theory"} modal type theory
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi f
                          %mo *
                        %msub
                          %mi f
                          %mo *
                      %annotation{:encoding => "application/x-tex"} f^\ast f_\ast
                  is
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/necessity"} necessity
                  while
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi f
                          %mo *
                        %msub
                          %mi f
                          %mo !
                      %annotation{:encoding => "application/x-tex"} f^\ast f_!
                  is
                  = succeed "." do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/possibility"} possibility
          .num_prop
            %h6#proposition_2 Proposition
            %p
              Here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^\ast
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+functor"} cartesian closed functor
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Wirthm%C3%BCller+context"} Wirthmüller context
          %p
            See at
            %em
              %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+functor"} cartesian closed functor
            for the proof.
          .num_prop
            %h6#proposition_3 Proposition
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^*
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/logical+functor"} logical functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi f
                      %mo *
                    %mo ⊣
                    %msub
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (f^* \dashv f_*)
              is also an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/atomic+geometric+morphism"} atomic geometric morphism
          %p
            This appears for instance as (
            %a{:href => "#MacLaneMoerdijk"}> MacLaneMoerdijk, theorem IV.7.2
            ).
          .proof
            %h6#proof_2 Proof
            %p
              By prop.
              %a.maruku-ref{:href => "#BaseChangeIsEssentialGeometricMorphism"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^*
              is a
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              and hence preserves all
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/limit"} limit
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/finite+limit"} finite limit
            %p
              Notice that the
              %a.existingWikiWord{:href => "/nlab/show/subobject+classifier"} subobject classifier
              of an
              %a.existingWikiWord{:href => "/nlab/show/over+topos"} over topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} /
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}/X
              is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi p
                        %mn 2
                      %mo :
                      %msub
                        %mi Ω
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                      %mo ×
                      %mi X
                      %mo →
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (p_2 : \Omega_{\mathbf{H}} \times X \to X)
              %a.existingWikiWord{:href => "/nlab/show/product"} product
              is preserved by the
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              by which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^*
              acts, hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^*
              preserves the subobject classifier.
            %p
              To show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^*
              is logical it therefore remains to show that it also preserves
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/exponential+object"} exponential object
          .num_defn
            %h6#definition_2 Definition
            %p
              A (necessarily essential and atomic) geometric morphism of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi f
                      %mo *
                    %mo ⊣
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (f^* \dashv \prod_f)
              is called the
              %strong base change geometric morphism
              along
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo *
                    %mo =
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mi f
                  %annotation{:encoding => "application/x-tex"} f_* = \prod_f
              is also called the
              %a.existingWikiWord{:href => "/nlab/show/dependent+product"} dependent product
              relative to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo !
                    %mo =
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi f
                  %annotation{:encoding => "application/x-tex"} f_! = \sum_f
              is also called the
              %a.existingWikiWord{:href => "/nlab/show/dependent+sum"} dependent sum
              relative to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
            %p
              In the case
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo =
                    %mo *
                  %annotation{:encoding => "application/x-tex"} Y = *
              is the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              = succeed "." do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/etale+geometric+morphism"} etale geometric morphism
          %h2#properties Properties
          .num_prop
            %h6#proposition_4 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is a
              %a.existingWikiWord{:href => "/nlab/show/locally+cartesian+closed+category"} locally cartesian closed category
              then for every morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \to Y
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              the
              %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi 𝒞
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi Y
                    %mo →
                    %msub
                      %mi 𝒞
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi X
                  %annotation{:encoding => "application/x-tex"} f^* \colon \mathcal{C}_{/Y} \to \mathcal{C}_{/X}
              of the base change is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+functor"} cartesian closed functor
          %p
            See at
            %em
              %a{:href => "cartesian%20closed%20functor#Examples"} cartesian closed functor – Examples
            for a proof.
          %h2#examples Examples
          %h3#AlongDeloopingsOfGroupHomomorphisms
            Along
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi H
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{B}H \to \mathbf{B}G
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            an group object in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            (an
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
            %a.existingWikiWord{:href => "/nlab/show/slice+%28%E2%88%9E%2C1%29-topos"} slice (∞,1)-topos
            over its
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            may be identified with the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-actions"} ∞-actions
            (see there for more):
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Act
                    %mi G
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Act_G(\mathbf{H}) \simeq \mathbf{H}_{/\mathbf{B}G}
                  \\,.
          %p
            Under this identification, then left and right base change long a morphism of the form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi H
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{B}H \to \mathbf{B}G
            (corresponding to an
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
            homomorphism
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo →
                    %mi G
                  %annotation{:encoding => "application/x-tex"} H \to G
            %a.existingWikiWord{:href => "/nlab/show/induced+representations"} induced representations
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/coinduced+representations"} coinduced representations
          %h3#AlongPointInclusionIntoBG
            Along
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} \ast \to \mathbf{B}G
          %p
            As the special case of the
            %a{:href => "#AlongDeloopingsOfGroupHomomorphisms"} above
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} H = 1
            the trivial group we obtain the following:
          #CyclicLoopSpace.num_prop
            %h6#proposition_5 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              be any
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              be a group object in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              (an
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo *
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"}
                    i \;\colon\; \ast \to \mathbf{B}G
            %p
              into the
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              takes the following form:
            %p
              There is a pair of
              %a.existingWikiWord{:href => "/nlab/show/adjoint+%E2%88%9E-functors"} adjoint ∞-functors
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ⟶
                        %mrow
                          %msub
                            %mi i
                            %mo *
                          %mo ≃
                          %mo{:stretchy => "false"} [
                          %mi G
                          %mo ,
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} /
                          %mi G
                      %mover
                        %mo ⟵
                        %mrow
                          %msup
                            %mi i
                            %mo *
                          %mo ≃
                          %mi hofib
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{H}
                    \\underoverset
                    { \underset{i_\ast \simeq [G,-]/G}{\longrightarrow}}
                    { \overset{i^\ast \simeq hofib}{\longleftarrow}}
                    {\bot}
                    \\mathbf{H}_{/\mathbf{B}G}
                    \\,,
            %p where
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi hofib
                      %annotation{:encoding => "application/x-tex"} hofib
                  denotes the operation of taking the
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
                  of a map to
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                      %annotation{:encoding => "application/x-tex"} \mathbf{B}G
                  over the canonical basepoint;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi G
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [G,-]
                  denotes the
                  %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
                  in
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                        %annotation{:encoding => "application/x-tex"} \mathbf{H}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi G
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} /
                        %mi G
                      %annotation{:encoding => "application/x-tex"} [G,-]/G
                  denotes the
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+quotient"} homotopy quotient
                  by the
                  %a.existingWikiWord{:href => "/nlab/show/conjugation+action"} conjugation
                  %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-action"} ∞-action
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                  equipped with its canonical
                  %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-action"} ∞-action
                  by left multiplication and the argument regarded as equipped with its trivial
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
                  = succeed "-action" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn ∞
                        %annotation{:encoding => "application/x-tex"} \infty
                %p
                  (for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                        %mo =
                        %msup
                          %mi S
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} G = S^1
                  then this is the
                  %a.existingWikiWord{:href => "/nlab/show/cyclic+loop+space"} cyclic loop space
                  construction).
            %p Hence for
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi X
                          %mo{:stretchy => "false"} ^
                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} \hat X \to X
                  a
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
                  %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                  a
                  %a.existingWikiWord{:href => "/nlab/show/coefficient"} coefficient
                  object, such as for some
                  %a.existingWikiWord{:href => "/nlab/show/differential+cohomology"} differential
                  %a.existingWikiWord{:href => "/nlab/show/generalized+cohomology+theory"} generalized cohomology theory
            %p
              then there is a
              %a.existingWikiWord{:href => "/nlab/show/natural+equivalence"} natural equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %munder
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                          %mo{:stretchy => "false"} (
                          %mover
                            %mi X
                            %mo{:stretchy => "false"} ^
                          %mspace{:width => "thickmathspace"}
                          %mo ,
                          %mspace{:width => "thickmathspace"}
                          %mi A
                          %mo{:stretchy => "false"} )
                        %mo ⏟
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mtext original
                        %mrow
                          %mtext fluxes
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %munderover
                      %mo ≃
                      %munder
                        %mo ⟵
                        %mi oxidation
                      %mover
                        %mo ⟶
                        %mi reduction
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %munder
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mspace{:width => "thickmathspace"}
                          %mo ,
                          %mspace{:width => "thickmathspace"}
                          %mo{:stretchy => "false"} [
                          %mi G
                          %mo ,
                          %mi A
                          %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} /
                          %mi G
                          %mo{:stretchy => "false"} )
                        %mo ⏟
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mtext doubly
                        %mrow
                          %mfrac{:linethickness => "0"}
                            %mrow
                              %mtext dimensionally reduced
                            %mrow
                              %mtext fluxes
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{
                    \\text{original} \atop \text{fluxes}
                    }{
                    \\underbrace{
                    \\mathbf{H}(\hat X\;,\; A)
                    }
                    }
                    \\;\;
                    \\underoverset
                    {\underset{oxidation}{\longleftarrow}}
                    {\overset{reduction}{\longrightarrow}}
                    {\simeq}
                    \\;\;
                    \\underset{
                    \\text{doubly} \atop { \text{dimensionally reduced} \atop \text{fluxes} }
                    }{
                    \\underbrace{
                    \\mathbf{H}(X \;,\; [G,A]/G)
                    }
                    }
            %p given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mover
                        %mi X
                        %mo{:stretchy => "false"} ^
                      %mo ⟶
                      %mi A
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ↔
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi X
                            %mtd
                            %mtd
                              %mo ⟶
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} [
                              %mi G
                              %mo ,
                              %mi A
                              %mo{:stretchy => "false"} ]
                              %mo{:stretchy => "false"} /
                              %mi G
                          %mtr
                            %mtd
                            %mtd
                              %mo ↘
                            %mtd
                            %mtd
                              %mo ↙
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mi G
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    \\hat X \longrightarrow A
                    \\right)
                    \\;\;\;
                    \\leftrightarrow
                    \\;\;\;
                    \\left(
                    \\array{
                    X &amp;&amp; \longrightarrow &amp;&amp; [G,A]/G
                    \\\
                    \&amp; \searrow &amp;&amp; \swarrow
                    \\\
                    \&amp;&amp; \mathbf{B}G
                    }
                    \\right)
          #DimensionalReductionAbstractly.proof
            %h6#proof_3 Proof
            %p
              The statement that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi i
                      %mo *
                    %mo ≃
                    %mi hofib
                  %annotation{:encoding => "application/x-tex"} i^\ast \simeq hofib
              follows immediately by the definitions. What we need to see is that the
              %a.existingWikiWord{:href => "/nlab/show/dependent+product"} dependent product
              along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              is given as claimed.
            %p
              To that end, first observe that the
              %a.existingWikiWord{:href => "/nlab/show/conjugation+action"} conjugation action
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi G
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [G,X]
              is the
              %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
              in the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
              of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-actions"} ∞-actions
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Act
                        %mi G
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Act_G(\mathbf{H})
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalence of (∞,1)-categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Act
                      %mi G
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                  %annotation{:encoding => "application/x-tex"}
                    Act_G(\mathbf{H}) \simeq \mathbf{H}_{/\mathbf{B}G}
            %p
              (from
              = succeed ")" do
                %a{:href => "https://ncatlab.org/schreiber/show/Principal+%E2%88%9E-bundles+--+theory%2C+presentations+and+applications"} NSS 12
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              with its canonical
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-action"} ∞-action
              is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\ast \to \mathbf{B}G)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with the trivial action is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ×
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X \times \mathbf{B}G \to \mathbf{B}G)
            %p Hence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi G
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} /
                    %mi G
                    %mo ≃
                    %mo{:stretchy => "false"} [
                    %mo *
                    %mo ,
                    %mi X
                    %mo ×
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [G,X]/G
                    \\simeq
                    [\ast, X \times \mathbf{B}G]_{\mathbf{B}G}
                    \\;\;\;\;\;
                    \\in
                    \\mathbf{H}_{/\mathbf{B}G}
                    \\,.
            %p
              So far this is the very definition of what
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi G
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} /
                    %mi G
                    %mo ∈
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                  %annotation{:encoding => "application/x-tex"} [G,X]/G \in \mathbf{H}_{/\mathbf{B}G}
              is to mean in the first place.
            %p
              But now since the
              %a.existingWikiWord{:href => "/nlab/show/slice+%28%E2%88%9E%2C1%29-topos"} slice (∞,1)-topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}_{/\mathbf{B}G}
              is itself
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+%28infinity%2C1%29-category"} cartesian closed
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %msub
                      %mo ×
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ⊣
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %mi E
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                  %annotation{:encoding => "application/x-tex"}
                    E \times_{\mathbf{B}G}(-)
                    \\;\;\;
                    \\dashv
                    \\;\;\;
                    [E,-]_{\mathbf{B}G}
            %p
              it is immediate that there is the following sequence of
              %a.existingWikiWord{:href => "/nlab/show/natural+equivalences"} natural equivalences
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                              %mrow
                                %mo{:stretchy => "false"} /
                                %mstyle{:mathvariant => "bold"}
                                  %mi B
                                %mi G
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo ,
                            %mo{:stretchy => "false"} [
                            %mi G
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} /
                            %mi G
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                              %mrow
                                %mo{:stretchy => "false"} /
                                %mstyle{:mathvariant => "bold"}
                                  %mi B
                                %mi G
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo ,
                            %mo{:stretchy => "false"} [
                            %mo *
                            %mo ,
                            %mi X
                            %mo ×
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mrow
                                %mstyle{:mathvariant => "bold"}
                                  %mi B
                                %mi G
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                              %mrow
                                %mo{:stretchy => "false"} /
                                %mstyle{:mathvariant => "bold"}
                                  %mi B
                                %mi G
                            %mo{:stretchy => "false"} (
                            %mi Y
