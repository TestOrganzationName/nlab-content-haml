          %h2#idea Idea
          %p
            For a given
            %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            of finite
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            there exists an
            %a.existingWikiWord{:href => "/nlab/show/embedding"} embedding
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo :
                  %mi X
                  %mo →
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"} i : X \to \mathbb{R}^n
            into some
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
            %a.existingWikiWord{:href => "/nlab/show/Pontrjagin-Thom+collapse+map"} Pontrjagin-Thom collapse map
            this induces a morphism in
            %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"} topological K-theory
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi i
                    %mo !
                  %mo :
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi T
                  %msup
                    %mi ℝ
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  i_! : K(T X) \to K(T \mathbb{R}^n)
                  \\,.
          %p
            Similarly for any point inclusion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                  %mo :
                  %mo *
                  %mo →
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"} j : * \to \mathbb{R}^n
            there is such a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi j
                    %mo !
                  %mo :
                  %mi ℤ
                  %mo =
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi T
                  %msup
                    %mi ℝ
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} j_! : \mathbb{Z} = K(*) \to K(T \mathbb{R}^n)
            which is an
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            – the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Thom+isomorphism"} Thom isomorphism
          %p
            The
            %strong topological index
            of
            %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"} topological K-theory
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is the composite
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ind
                    %mi top
                  %mo :
                  %mi ℤ
                  %mo =
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi i
                        %mo !
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi T
                  %msup
                    %mi ℝ
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %msubsup
                        %mi j
                        %mo !
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi ℤ
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  ind_{top} : \mathbb{Z} = K(T X) \stackrel{i_!}{\to}
                  K(T \mathbb{R}^n) \stackrel{j_!^{-1}}{\to} K(*) = \mathbb{Z}
                  \\,.
          %p
            One can prove that this is independent of all the occurring choices. In particular it does not depend on the specific choice of embedding of the manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            into the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
            %em topological index function
            is uniquely fixed by two properties (this is the content of the
            = succeed "):" do
              %a.existingWikiWord{:href => "/nlab/show/Atiyah-Singer+index+theorem"} Atiyah-Singer index theorem
          %ol
            %li
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                a point we have
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ind
                          %mi t
                        %mo =
                        %mi id
                      %annotation{:encoding => "application/x-tex"} ind_t=id
            %li
              %p
                Index functions commute with the maps
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi i
                          %mo !
                      %annotation{:encoding => "application/x-tex"} i_!
          %p
            From this one defines the
            %em
              topological index of an
              %a.existingWikiWord{:href => "/nlab/show/elliptic+operator"} elliptic operator
            \. The
            %a.existingWikiWord{:href => "/nlab/show/principal+symbol"} principal symbol
            of the operator defines a homogenous length-one
            %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
            of
            %a.existingWikiWord{:href => "/nlab/show/bundles"} bundles
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mi X
                %annotation{:encoding => "application/x-tex"} T X
            %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exact
            outside the null section. Elements of this kind are precisely cycles for the compactly supported
            %a.existingWikiWord{:href => "/nlab/show/K-theory"} K-theory
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mi X
                %annotation{:encoding => "application/x-tex"} T X
            hence an elliptic operator
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            has a topological index only depending on its principal symbol.
          %p
            On the other hand, analysis associates to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            its
            %a.existingWikiWord{:href => "/nlab/show/analytical+index"} analytical index
            that is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} dim
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} Ker
                  %mo{:stretchy => "false"} (
                  %mi D
                  %mo{:stretchy => "false"} )
                  %mo −
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} dim
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} coKer
                  %mo{:stretchy => "false"} (
                  %mi D
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\operatorname{dim}\operatorname{Ker}(D)-\operatorname{dim}\operatorname{coKer}(D)
          %p
            on one (hence all)
            %a.existingWikiWord{:href => "/nlab/show/Sobolev+space"} Sobolev space
            that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            is defined on.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/Atiyah-Singer+index+theorem"} Atiyah-Singer index theorem
            states that the
            %a.existingWikiWord{:href => "/nlab/show/analytical+index"} analytical index
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            is equal to its topological index.
          %h3#more_on_the_thom_map More on the Thom map
          %p
            The story starts with an embedding
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} i:X\to Y
            of
            %a.existingWikiWord{:href => "/nlab/show/compact+space"} compact
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/manifolds"} manifolds
            %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi i
                    %mo !
                  %mo :
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  i_{!} : K(T X)\longrightarrow K(T Y)
          %p
            between the
            %a.existingWikiWord{:href => "/nlab/show/compact+support"} compactly supported
            %a.existingWikiWord{:href => "/nlab/show/K-theory"} K-theories
            of their
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/tangent+bundles"} tangent bundles
          %p
            Notice here the reverse
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/functor"} functoriality
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            is contravariant while for the total spaces of the tangent bundles it is covariant. This uses the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Pontrjagin-Thom+collaps+map"} Thom mapping
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a compact manifold and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            a real
            %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            there is a natural map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi φ
                  %mo :
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\varphi:K(X)\longrightarrow K(V)
                  \\,.
          %p
            One of the most important results of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/K-theory"} K-theory
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Bott+periodicity"} Bott periodicity
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            %a.existingWikiWord{:href => "/nlab/show/normal+bundle"} normal bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            to get
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi φ
                  %mo :
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mi N
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\varphi
                  \:
                  K(T X)\longrightarrow K(T N)
          %p
            and (looking at
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            as a
            %a.existingWikiWord{:href => "/nlab/show/tubular+neighbourhood"} tubular neighbourhood
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            in
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi K
                    %mo *
                  %mo :
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mi N
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  K_*
                  \:
                  K(T N)\longrightarrow K(T Y)
          %p
            to get
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mo !
                  %annotation{:encoding => "application/x-tex"} i_!
          %p
            Now given a manifold
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            for some suitable
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            and consider the inclusion
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                    %mo →
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \{0\}\to \mathbb{R}^n
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Thom+isomorphism"} Thom isomorphism
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi j
                      %mo !
                    %mo :
                    %mi ℤ
                    %mo =
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi T
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} j_!:\mathbb{Z}=K(\{0\}) \longrightarrow K(T\mathbb{R}^n)
          %p
            The
            %em topological index
            is defined to be
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ind
                    %mi t
                  %mo :
                  %mo =
                  %msubsup
                    %mi j
                    %mo !
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo ∘
                  %msub
                    %mi i
                    %mo !
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  ind_t
                  \:=
                  j_!^{-1}\circ i_!
                  \\,.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/index+theory"} index theory
              %ul
                %li
                  %p
                    %strong topological index
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/analytical+index"} analytical index
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/Atiyah-Singer+index+theorem"} Atiyah-Singer index theorem
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/eta+invariant"}> eta invariant
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/zeta+function+of+an+elliptic+differential+operator"} zeta function of an elliptic differential operator
                %a.existingWikiWord{:href => "/nlab/show/functional+determinant"} functional determinant
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/fiber+integration+in+differential+K-theory"} fiber integration in differential K-theory
        .revisedby
