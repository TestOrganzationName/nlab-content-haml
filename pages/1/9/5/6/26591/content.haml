                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X_F,\mathcal{A}_F)
              the product of the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi j
                    %mo ,
                    %msub
                      %mi 𝒜
                      %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X_j,\mathcal{A}_j)
              for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                      %mo ∈
                      %mi F
                    %annotation{:encoding => "application/x-tex"} j\in F
          %p
            Note that, since infinite products are
            %a.existingWikiWord{:href => "/nlab/show/cofiltered+limits"} cofiltered limits
            of finite products,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mi J
                  %mo ,
                  %msub
                    %mi 𝒜
                    %mi J
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X_J,\mathcal{A}_J)
            is the limit in
            %a.existingWikiWord{:href => "/nlab/show/Meas"} Meas
            of the diagram formed by the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mi F
                  %mo ,
                  %msub
                    %mi 𝒜
                    %mi F
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X_F,\mathcal{A}_F)
            and their projections.
          %p Now:
          %p
          #kolmogorov_kernels.num_cor
            %h6 Corollary
            %p
              The object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi J
                    %mo ,
                    %msub
                      %mi 𝒜
                      %mi J
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X_J,\mathcal{A}_J)
              is the limit of the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi F
                    %mo ,
                    %msub
                      %mi 𝒜
                      %mi F
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X_F,\mathcal{A}_F)
              also in the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Stoch"} category Stoch of measurable spaces and Markov kernels
          %p
            Note that this does not say that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mi J
                  %mo ,
                  %msub
                    %mi 𝒜
                    %mi J
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X_J,\mathcal{A}_J)
            is the product of the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mi j
                  %mo ,
                  %msub
                    %mi 𝒜
                    %mi j
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X_j,\mathcal{A}_j)
            (
            %a.existingWikiWord{:href => "/nlab/show/joint+and+marginal+distributions"}> that would be false even in the finite case
            ). It is just the “
            %a.existingWikiWord{:href => "/nlab/show/cofiltered+limit"}> finite to infinite
            ” part which is retained in the category of kernels.
          %p
          .proof
            %h6 Proof
            %p
              For finite sets
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo ⊆
                      %mi G
                      %mo ⊆
                      %mi J
                    %annotation{:encoding => "application/x-tex"} F\subseteq G\subseteq J
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mrow
                        %mi J
                        %mo ,
                        %mi F
                    %mo :
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi J
                    %mo ,
                    %msub
                      %mi 𝒜
                      %mi J
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi F
                    %mo ,
                    %msub
                      %mi 𝒜
                      %mi F
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_{J,F}:(X_J,\mathcal{A}_J)\to(X_F,\mathcal{A}_F)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mrow
                        %mi G
                        %mo ,
                        %mi F
                    %mo :
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi G
                    %mo ,
                    %msub
                      %mi 𝒜
                      %mi H
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi F
                    %mo ,
                    %msub
                      %mi 𝒜
                      %mi F
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_{G,F}:(X_G,\mathcal{A}_H)\to(X_F,\mathcal{A}_F)
              the product projections. With a slight abuse, denote the
              %a.existingWikiWord{:href => "/nlab/show/Markov+kernel#kernels_from_deterministic_functions"} Markov kernel induced by the functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mrow
                        %mi J
                        %mo ,
                        %mi F
                  %annotation{:encoding => "application/x-tex"} \pi_{J,F}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mrow
                        %mi G
                        %mo ,
                        %mi F
                  %annotation{:encoding => "application/x-tex"} \pi_{G,F}
              again by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mrow
                        %mi J
                        %mo ,
                        %mi F
                  %annotation{:encoding => "application/x-tex"} \pi_{J,F}
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mrow
                          %mi G
                          %mo ,
                          %mi F
                    %annotation{:encoding => "application/x-tex"} \pi_{G,F}
            %p
              Given a measurable space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo ,
                      %mi ℬ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (Y,\mathcal{B})
              %a.existingWikiWord{:href => "/nlab/show/Markov+kernels"} Markov kernels
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi k
                      %mi J
                    %mo :
                    %mi Y
                    %mo →
                    %msub
                      %mi X
                      %mi J
                  %annotation{:encoding => "application/x-tex"} k_J:Y\to X_J
              and families of Markov kernels
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi k
                      %mi F
                    %mo :
                    %mi Y
                    %mo →
                    %msub
                      %mi X
                      %mi F
                  %annotation{:encoding => "application/x-tex"} k_F:Y\to X_F
              such that for each inclusion
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo ⊆
                      %mi G
                    %annotation{:encoding => "application/x-tex"} F\subseteq G
              %a.existingWikiWord{:href => "/nlab/show/Stoch"} Stoch
              commutes.
