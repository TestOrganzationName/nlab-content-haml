          %h1#equilogical_spaces Equilogical spaces
          .maruku_toc
            %ul
              %li
                %a{:href => "#definition"} Definition
              %li
                %a{:href => "#properties"} Properties
              %li
                %a{:href => "#related_concepts"} Related concepts
              %li
                %a{:href => "#references"} References
          %h2#definition Definition
          %p
            An
            %strong equilogical space
            is a
            %a.existingWikiWord{:href => "/nlab/show/separation+axioms"} Kolmogorov
            (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mn 0
                %annotation{:encoding => "application/x-tex"} T_0
            )
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            along with an arbitrary
            %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≡
                %annotation{:encoding => "application/x-tex"} \equiv
            on its points (of note, the equivalence relation need not match the topological structure in any way). A morphism between equilogical spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mo ,
                  %mo ≡
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (T, {\equiv})
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ,
                  %mo ≅
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (U, {\cong})
            is a
            %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi T
                  %mo →
                  %mi U
                %annotation{:encoding => "application/x-tex"} f\colon T \to U
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ≡
                  %mi y
                %annotation{:encoding => "application/x-tex"} x \equiv y
            implies
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(x) \cong f(y)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                %annotation{:encoding => "application/x-tex"} y
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            are considered equal if for all points
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(x) \cong g(x)
          %h2#properties Properties
          %p
            The category
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Equ
                  %annotation{:encoding => "application/x-tex"} Equ
            of equilogical spaces obviously contains the category of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mn 0
                %annotation{:encoding => "application/x-tex"} T_0
            topological spaces as a
            %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
            (by using the trivial equivalence relation of
            %a.existingWikiWord{:href => "/nlab/show/equality"} equality
            on points). Moreover, as opposed to the latter,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Equ
                %annotation{:encoding => "application/x-tex"} Equ
            is in fact
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/cartesian+closed"} cartesian closed
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Equ
                %annotation{:encoding => "application/x-tex"} Equ
            and the category of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/partial+equivalence+relation"} partial equivalence relation
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+lattice"} algebraic lattice
          %p
            On the other hand,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Equ
                %annotation{:encoding => "application/x-tex"} Equ
            can be identified with a
            %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective
            %a.existingWikiWord{:href => "/nlab/show/exponential+ideal"} exponential ideal
            in the
            %a.existingWikiWord{:href => "/nlab/show/ex%2Flex+completion"} ex/lex completion
            of the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Top
                    %mn 0
                %annotation{:encoding => "application/x-tex"} Top_0
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mn 0
                %annotation{:encoding => "application/x-tex"} T_0
            topological spaces. This provides an alternative proof of the cartesian closure of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Equ
                  %annotation{:encoding => "application/x-tex"} Equ
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Top
                    %mn 0
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi ex
                      %mo{:stretchy => "false"} /
                      %mi lex
                %annotation{:encoding => "application/x-tex"} (Top_0)_{ex/lex}
            is cartesian closed (in fact,
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/locally+cartesian+closed+category"} locally cartesian closed
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Top
                    %mn 0
                %annotation{:encoding => "application/x-tex"} Top_0
            is weakly locally cartesian closed.
          %p
            Moreover, in this way we can see that the embedding
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Top
                    %mn 0
                  %mo →
                  %mi Equ
                %annotation{:encoding => "application/x-tex"} Top_0 \to Equ
            preserves all existing
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/exponential+law+for+spaces"} exponentials
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo →
                  %msub
                    %mi C
                    %mrow
                      %mi ex
                      %mo{:stretchy => "false"} /
                      %mi lex
                %annotation{:encoding => "application/x-tex"} C \to C_{ex/lex}
            does so, and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Equ
                %annotation{:encoding => "application/x-tex"} Equ
            is closed under exponentials in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Top
                    %mn 0
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi ex
                      %mo{:stretchy => "false"} /
                      %mi lex
                %annotation{:encoding => "application/x-tex"} (Top_0)_{ex/lex}
            and contains the image of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Top
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} Top_0
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/limits"} limits
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
