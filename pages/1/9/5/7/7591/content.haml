          %h4#unaugmented_case Unaugmented case
          #GroupOfUnitsFunctor.num_defn
            %h6#definition_5 Definition
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi gl
                      %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi CRing
                      %mn ∞
                    %mo →
                    %msub
                      %mi AbGrp
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"}
                    gl_1 \; \colon \;  CRing_\infty \to AbGrp_\infty
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
              which sends a
              %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+ring"} commutative ∞-ring
              to its
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group+of+units"} ∞-group of units
          .num_theorem
            %h6#theorem Theorem
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group+of+units"} ∞-group of units
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
              of def.
              %a.maruku-ref{:href => "#GroupOfUnitsFunctor"}
              is a right-
              %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functor"} adjoint (∞,1)-functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi CRing
                      %mn ∞
                    %mover
                      %munder
                        %mo →
                        %mrow
                          %msub
                            %mi gl
                            %mn 1
                      %mover
                        %mo ←
                        %mrow
                          %mi 𝕊
                          %mo{:stretchy => "false"} [
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} ]
                    %msub
                      %mi AbGrp
                      %mn ∞
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    CRing_\infty
                    \\stackrel{\overset{\mathbb{S}[-]}{\leftarrow}}{\underset{gl_1}{\to}}
                    AbGrp_\infty
                    \\,.
          %p
            This is (
            %a{:href => "#ABGHR08"}> ABGHR 08, theorem 2.1/3.2, remark 3.4
            ).
          .num_remark
            %h6#remark_3 Remark
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕊
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi AbGrp
                      %mn ∞
                    %mo →
                    %msub
                      %mi CRing
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{S}[-] \colon AbGrp_\infty \to CRing_\infty
            %p
              is a higher analog of forming the
              %a.existingWikiWord{:href => "/nlab/show/group+ring"} group ring
              of an ordinary
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
              over the
              %a.existingWikiWord{:href => "/nlab/show/integers"} integers
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Ab
                    %mo →
                    %mi CRing
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{Z}[-] \colon Ab \to CRing
                    \\,,
            %p
              which is indeed
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              to forming the ordinary
              %a.existingWikiWord{:href => "/nlab/show/group+of+units"} group of units
              of a ring.
            %p
              We might call
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕊
                    %mo{:stretchy => "false"} [
                    %mi A
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}[A]
