                      %mi KU
                      %mo ≃
                      %mo{:stretchy => "false"} (
                      %mi 𝕊
                      %mo{:stretchy => "false"} [
                      %mi B
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi β
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "thinmathspace"}
                      %mo ;
                    %annotation{:encoding => "application/x-tex"}
                      KU \simeq (\mathbb{S}[B U(1)])[\beta^{-1}]
                      \\,;
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/periodic+complex+cobordism+spectrum"} periodic complex cobordism spectrum
                is the
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group+%E2%88%9E-ring"} ∞-group ∞-ring
                of the
                %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
                for stable
                %a.existingWikiWord{:href => "/nlab/show/complex+vector+bundles"} complex vector bundles
                (the classifying space for
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"} topological K-theory
                %a.existingWikiWord{:href => "/nlab/show/Bott+element"} Bott element
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi β
                      %annotation{:encoding => "application/x-tex"} \beta
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi MU
                      %mo ≃
                      %mo{:stretchy => "false"} (
                      %mi 𝕊
                      %mo{:stretchy => "false"} [
                      %mi B
                      %mi U
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi β
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      MU \simeq (\mathbb{S}[B U])[\beta^{-1}]
                      \\,.
          %h3#units_of_topological_modular_forms Units of topological modular forms
          %p
            Analysis of the
            = succeed "-group" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/tmf"} tmf
            is in (
            %a{:href => "#AndoHopkinsRezk10"}> Ando-Hopkins-Rezk 10, from section 12 on
            ).
          %h3#inclusion_of_circle_bundles_into_higher_chromatic_cohomology
            Inclusion of circle
            = succeed "-bundles" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p
            By
            %a{:href => "#SnatihTheorem"} Snaith’s theorem
            above there is a canonical map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi 𝕊
                  %mo{:stretchy => "false"} [
                  %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi KU
                %annotation{:encoding => "application/x-tex"}
                  B U(1) \to \mathbb{S}[B U(1)] \to  KU
          %p
            that sends
            %a.existingWikiWord{:href => "/nlab/show/circle+bundles"} circle bundles
            to cocycles in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"} topological K-theory
          %p At the next level there is a canonical map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi B
                    %mn 2
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi 𝕊
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi B
                    %mn 2
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi tmf
                %annotation{:encoding => "application/x-tex"}
                  B^2 U(1) \to \mathbb{S}[B^2 U(1)] \to tmf
          %p
            that sends
            %a.existingWikiWord{:href => "/nlab/show/circle+2-bundles"} circle 2-bundles
            to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/tmf"} tmf
            = succeed "." do
              %em
                %a{:href => "tmf#InclusionOfCircle2Bundles"} tmf – Inclusion of circle 2-bundles
          %p
            Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi gl
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} gl_1(K(n))
            for the
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group+of+units"} ∞-group of units
            of the (a)
            %a.existingWikiWord{:href => "/nlab/show/Morava+K-theory"} Morava K-theory
            spectrum.
          .num_prop
            %h6#proposition_2 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo =
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} p = 2
              and all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %a.existingWikiWord{:href => "/nlab/show/equivalence+in+an+%28infinity%2C1%29-category"} equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Maps
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi B
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi B
                    %msub
                      %mi gl
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Maps(B^{n+1}U(1), B gl_1(K(n)))
                    \\simeq
                    \\mathbb{Z}/(2)
            %p
              between the
              %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
              from the
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
              for
              %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle"} circle (n+1)-bundles
              to the
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              of the
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group+of+units"} ∞-group of units
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} K(n)
          %p
            (
            %a{:href => "#SatiWesterland11"}> Sati-Westerland 11, theorem 1
            )
          .num_remark
            %h6#remark_4 Remark
            %p
              By the discussion at
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-vector+bundle"} (∞,1)-vector bundle
              this means that for each such map there is a type of
              %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twist
              of Morava K-theory (at
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo =
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} p = 2
          %h2#related_concepts Related concepts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-vector+bundle"} (∞,1)-vector bundle
          %h2#references References
          %p
            A notion of spectrum of units of an
            = succeed "-ring" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} E_\infty
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Peter+May"}> Peter May
              , p. 54 of:
              = succeed "," do
                %em
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi E
                          %mn ∞
                      %annotation{:encoding => "application/x-tex"} E_\infty
                  ring spaces and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi E
                          %mn ∞
                      %annotation{:encoding => "application/x-tex"} E_\infty
                  ring spectra
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Frank+Quinn"} Frank Quinn
              = succeed ")" do
                %a{:href => "https://www.math.uchicago.edu/~may/BOOKS/e_infty.pdf"} pdf
          %p One explicit model was given in
          %ul
            %li#Schlichtkrull04
              %a.existingWikiWord{:href => "/nlab/show/Christian+Schlichtkrull"}> Christian Schlichtkrull
              ,
              = succeed "," do
                %em Units of ring spectra and their traces in algebraic K-theory
              %strong 8
              (2004) 645-673 (
              %a{:href => "http://arxiv.org/abs/math/0405079"}> arXiv:math/0405079
              ,
              = succeed ")" do
                %a{:href => "https://projecteuclid.org/euclid.gt/1513883412"} euclid:gt/1513883412
          %p Further discussion in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Peter+May"}> Peter May
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Johann+Sigurdsson"} Johann Sigurdsson
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Parametrized+Homotopy+Theory"} Parametrized Homotopy Theory
              = succeed "," do
                %a{:href => "https://bookstore.ams.org/surv-132"} ISBN:978-0-8218-3922-5
              = succeed "," do
                %a{:href => "https://arxiv.org/abs/math/0411656"} arXiv:math/0411656
              = succeed ")" do
                %a{:href => "http://www.math.uchicago.edu/~may/EXTHEORY/MaySig.pdf"} pdf
          %p
            A general abstract discussion in
            %a.existingWikiWord{:href => "/nlab/show/stable+%28%E2%88%9E%2C1%29-category"} stable (∞,1)-category
            theory is in
          %ul
            %li#Rezk06
              %p
                %a.existingWikiWord{:href => "/nlab/show/Charles+Rezk"}> Charles Rezk
                , section II of
                = succeed "," do
                  %em The units of a ring spectrum and a logarithmic cohomology operation
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/math/0407022"} arXiv:math/0407022
            %li#ABGHR08
              %p
                %a.existingWikiWord{:href => "/nlab/show/Matthew+Ando"}> Matthew Ando
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Andrew+Blumberg"} Andrew Blumberg
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/David+Gepner"} David Gepner
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Michael+Hopkins"} Michael Hopkins
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Charles+Rezk"} Charles Rezk
                %em Units of ring spectra and Thom spectra
                \&amp;lbrack;
                %a{:href => "http://arxiv.org/abs/0810.4535"}> arXiv:0810.4535
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Matthew+Ando"}> Matthew Ando
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Andrew+Blumberg"} Andrew Blumberg
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/David+Gepner"} David Gepner
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Michael+Hopkins"} Michael Hopkins
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Charles+Rezk"} Charles Rezk
                = succeed "," do
                  %em Units of ring spectra, orientations, and Thom spectra via rigid infinite loop space theory
                %strong 7
                4 (2014) &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1403.4320"}> arXiv:1403.4320
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1112/jtopol/jtu009"} doi:10.1112/jtopol/jtu009
            %li#LurieI
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
                , construction 3.9.4 of
                %em Elliptic Cohomology I: Spectral Abelian Varieties
                (
                %a{:href => "http://www.math.harvard.edu/~lurie/papers/Elliptic-I.pdf"}> pdf
                )
          %p Remarks alluding to this are also on p. 20 of
          %ul
            %li#Lurie
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              ,
              %em
                %a.existingWikiWord{:href => "/nlab/show/A+Survey+of+Elliptic+Cohomology"} A Survey of Elliptic Cohomology
          %p Theorem 3.2 there is proven using classical results which are collected in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Peter+May"}> Peter May
              ,
              = succeed "," do
                %em
                  What precisely are
                  = succeed "-ring" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi E
                            %mn ∞
                        %annotation{:encoding => "application/x-tex"} E_\infty
                  = succeed "-ring" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi E
                            %mn ∞
                        %annotation{:encoding => "application/x-tex"} E_\infty
              = succeed ")" do
                %a{:href => "http://www.math.uchicago.edu/~may/PAPERS/Final1.pdf"} pdf
          %p
            A survey of the situation in
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+theory"} (∞,1)-category theory
            is also in section 3.1 of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              ,
              %em
                %a.existingWikiWord{:href => "/nlab/show/A+Survey+of+Elliptic+Cohomology"} A Survey of Elliptic Cohomology
          %p
            A construction in terms of a
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+spectra"} model structure on spectra
            is in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/John+Lind"}> John Lind
              ,
              %em Diagram spaces, diagram spectra, and spectra of units
              (
              %a{:href => "http://arxiv.org/abs/0908.1092"}> arXiv:0908.1092
              )
          %p
            A refinement (using
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/I-space"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi ℐ
                    %annotation{:encoding => "application/x-tex"} \mathcal{I}
                \-spaces
            = succeed "-groups" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/augmented+%E2%88%9E-groups"} augmented ∞-groups
            over the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi gl
                    %mn 1
                %annotation{:encoding => "application/x-tex"} gl_1
            of a
            %a.existingWikiWord{:href => "/nlab/show/periodic+E-%E2%88%9E+ring"} periodic E-∞ ring
            from its
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/connective+cover"} connective cover
          %ul
            %li#Sagave11
              %a.existingWikiWord{:href => "/nlab/show/Steffen+Sagave"}> Steffen Sagave
              ,
              = succeed "," do
                %em Spectra of units for periodic ring spectra
              = succeed ")" do
                %a{:href => "http://arxiv.org/abs/1111.6731"} arXiv:1111.6731
          %p
            based on (
            %a{:href => "#Schlichtkrull04"}> Schlichtkrull 04
            ). See also
          %ul
            %li#SagaveSchlichtkrull11
              %p
                %a.existingWikiWord{:href => "/nlab/show/Steffen+Sagave"}> Steffen Sagave
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Christian+Schlichtkrull"} Christian Schlichtkrull
                = succeed "," do
                  %em Diagram spaces and symmetric spectra
                %strong 231
                3-4 (2012) 2116-2193 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1103.2764"}> arXiv:1103.2764
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1016/j.aim.2012.07.013"} doi:10.1016/j.aim.2012.07.013
            %li#Szymik11
              %p
                %a.existingWikiWord{:href => "/nlab/show/Markus+Szymik"}> Markus Szymik
                ,
                %em Brauer spaces for commutative rings and structured ring spectra
                (
                %a{:href => "http://arxiv.org/abs/1110.2956"}> arXiv:1110.2956
                )
            %li#BakerRichterSzymik12
              %p
                %a.existingWikiWord{:href => "/nlab/show/Andrew+Baker"}> Andrew Baker
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Birgit+Richter"} Birgit Richter
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Markus+Szymik"} Markus Szymik
                = succeed "," do
                  %em
                    Brauer groups for commutative
                    = succeed "-algebras" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝕊
                          %annotation{:encoding => "application/x-tex"} \mathbb{S}
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/1005.5370"} arXiv:1005.5370
          %p
            The
            = succeed "-group" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/Morava+K-theory"} Morava K-theory
            is discussed in
          %ul#SatiWesterland11
            %li
              %a.existingWikiWord{:href => "/nlab/show/Hisham+Sati"}> Hisham Sati
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Craig+Westerland"} Craig Westerland
              %em Twisted Morava K-theory and E-theory
              (
              %a{:href => "http://arxiv.org/abs/1109.3867"}> arXiv:1109.3867
              )
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            with coefficients in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi gl
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} gl_1(E)
            and the corresponding
            %a.existingWikiWord{:href => "/nlab/show/logarithmic+cohomology+operations"} logarithmic cohomology operations
            are discussed in
          %ul
            %li#Rezk06
              %a.existingWikiWord{:href => "/nlab/show/Charles+Rezk"}> Charles Rezk
              ,
              = succeed "," do
                %em The units of a ring spectrum and a logarithmic cohomology operation
              = succeed ")" do
                %a{:href => "http://arxiv.org/abs/math/0407022"} arXiv:math/0407022
          %p
            The group of units of
            %a.existingWikiWord{:href => "/nlab/show/tmf"} tmf
            is analyzed from section 12 on in
          %ul
            %li#AndoHopkinsRezk10
              %a.existingWikiWord{:href => "/nlab/show/Matthew+Ando"}> Matthew Ando
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Mike+Hopkins"} Mike Hopkins
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Charles+Rezk"} Charles Rezk
              = succeed "," do
                %em Multiplicative orientations of KO-theory and the spectrum of topological modular forms
              = succeed ")" do
                %a{:href => "http://www.math.uiuc.edu/~mando/papers/koandtmf.pdf"} pdf
