          %h2#idea Idea
          %p
            The generalization in
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+theory"} (∞,1)-category theory
            of the notion of
            %em
              %a.existingWikiWord{:href => "/nlab/show/group+of+units"} group of units
            in ordinary category theory.
          %h2#definition Definition
          %h3#unaugmented_definition Unaugmented definition
          #PlainInfinityGroupOfUnits.num_defn
            %h6#definition_2 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              be an
              %a.existingWikiWord{:href => "/nlab/show/A-%E2%88%9E+algebra"} A-∞
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/ring+spectrum"} ring spectrum
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mn ∞
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \Omega^\infty A
              the underlying
              %a.existingWikiWord{:href => "/nlab/show/A-%E2%88%9E+space"} A-∞ space
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %msup
                      %mi Ω
                      %mn ∞
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \pi_0 \Omega^\infty A
              the ordinary
              %a.existingWikiWord{:href => "/nlab/show/ring"} ring
              of connected components, write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi π
                      %mn 0
                    %msup
                      %mi Ω
                      %mn ∞
                    %mi A
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ×
                  %annotation{:encoding => "application/x-tex"} (\pi_0 \Omega^\infty A)^\times
              for its
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/group+of+units"} group of units
            %p
              Then the
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group+of+units"} ∞-group of units
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mo ×
                    %mo ≔
                    %msub
                      %mi GL
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    A^\times \coloneqq GL_1(A)
            %p
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi GL
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} GL_1(A)
              in
            #eq:GL1AsPullback.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi GL
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %msup
                              %mi Ω
                              %mn ∞
                            %mi A
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi pb
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi π
                              %mn 0
                            %msup
                              %mi Ω
                              %mn ∞
                            %mi A
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo ×
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi π
                              %mn 0
                            %msup
                              %mi Ω
                              %mn ∞
                            %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    GL_1(A) &amp;\to&amp; \Omega^\infty A
                    \\\
                    \\downarrow &amp;(pb)&amp; \downarrow
                    \\\
                    (\pi_0 \Omega^\infty A)^\times &amp;\to&amp; \pi_0 \Omega^\infty A
                    }
                    \\,.
          .num_remark
            %h6#remark Remark
            %p
              In terms of
              %a.existingWikiWord{:href => "/nlab/show/derived+algebraic+geometry"} derived algebraic geometry
              one has that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi GL
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi 𝔾
                      %mi m
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi Spec
                    %mi A
                    %mo ,
                    %msub
                      %mi 𝔾
                      %mi m
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    GL_1(A) \simeq \mathbb{G}_m(A) = Hom(Spec A, \mathbb{G}_m)
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spec
                    %mi A
                  %annotation{:encoding => "application/x-tex"} Spec A
              into the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/multiplicative+group"} multiplicative group
              = succeed ")." do
                %a{:href => "#Lurie"} Lurie, p. 20
          %h3#AugmentedDefinition Augmented definition
          %p
            There is slight refinement of the above definition, which essentially adds one 0-th “grading” homotopy group to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %msub
                    %mi gl
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B gl_1(E)
            and thereby makes the
            = succeed "-group" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+rings"} E-∞ rings
            be canonically
            %a.existingWikiWord{:href => "/nlab/show/augmented+%E2%88%9E-group"} augmented
            over the
            %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
            (
            %a{:href => "#Sagave11"}> Sagave 11
            ).
          #AugmentedGroupOfUnits.num_defn
            %h6#definition_3 Definition
            %p There is a functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi gl
                      %mn 1
                      %mi J
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi CRing
                      %mn ∞
                    %mo →
                    %msub
                      %mi AbGrp
                      %mn ∞
                    %mo{:stretchy => "false"} /
                    %mi 𝕊
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    gl_1^J \colon CRing_\infty \to AbGrp_\infty/\mathbb{S}
                    \\,,
            %p given by …
          %p
            This is (
            %a{:href => "#Sagave11"}> Sagave 11, def. 3.14 in view of example 3.8
            ,
            = succeed ")." do
              %a{:href => "#SagaveSchlichtkrull11"} Sagave-Schlichtkrull 11, above theorem 1.8
            = succeed ")" do
              %a{:href => "#Sagave11"} Sagave 11, section 1.4
            = succeed "-version" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-grading" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
          %p
            In fact this grading extends form the group of units to the full
            = succeed "-ring" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed ")." do
              %a{:href => "#SagaveSchlichtkrull11"} Sagave-Schlichtkrull 11, theorem 1.7- 1.8
          #FiberSequenceForExtendedGl1.num_prop
            %h6#proposition Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+ring"} E-∞ ring
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequence"} homotopy fiber sequence
              of
              %a.existingWikiWord{:href => "/nlab/show/abelian+%E2%88%9E-groups"} abelian ∞-groups
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi gl
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msubsup
                      %mi gl
                      %mn 1
                      %mi J
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi 𝕊
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    gl_1(E) \to gl_1^J(E) \to \mathbb{S}
                    \\,,
            %p
              where on the left we have the ordinary
              = succeed "-group" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %a.maruku-ref{:href => "#PlainInfinityGroupOfUnits"}
              and on the right we have the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/connective+spectrum"} connective spectrum
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/abelian+%E2%88%9E-group"} abelian ∞-group
          %p
            Here the existence of the map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi gl
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msubsup
                    %mi gl
                    %mn 1
                    %mi J
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} gl_1(E) \to gl_1^J(E)
            is (
            %a{:href => "#Sagave11"}> Sagave 11, lemma 2.12 + lemma 3.16
            ). The fact that the resulting sequence is a homotopy fiber sequence is (
            %a{:href => "#Sagave11"}> Sagave 11, prop. 4.1
            ).
          %p
            Using this, there is now a modified delooping of the ordinary
            = succeed "-group" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          .num_defn
            %h6#definition_4 Definition
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi bgl
                      %mn 1
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} bgl_1^\ast(E)
              for the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+cofiber"} homotopy cofiber
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi gl
                      %mn 1
                      %mi J
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi 𝕊
                  %annotation{:encoding => "application/x-tex"} gl_1^J(E) \to \mathbb{S}
              to yield
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi gl
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msubsup
                      %mi gl
                      %mn 1
                      %mi J
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi 𝕊
                    %mo →
                    %msubsup
                      %mi bgl
                      %mn 1
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    gl_1(E) \to gl_1^J(E) \to \mathbb{S} \to bgl_1^\ast(E)
                    \\,.
          %p
            (
            %a{:href => "#Sagave11"}> Sagave 11, prop. 4.3
            )
          .num_remark
            %h6#remark_2 Remark
            %p
              It ought to be true that the non-connective delooping
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi bgl
                      %mn 1
                      %mo *
