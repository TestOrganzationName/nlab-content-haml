          %title Absolutely continuous measures
          %h1#absolutely_continuous_measures Absolutely continuous measures
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#definition"} Definition
              %li
