          %h2#idea Idea
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/measure"} measure
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                %annotation{:encoding => "application/x-tex"} \mu
            is absolutely continuous with respect to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ν
                %annotation{:encoding => "application/x-tex"} \nu
            if we can think of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                %annotation{:encoding => "application/x-tex"} \mu
            as a weighted variation on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ν
                  %annotation{:encoding => "application/x-tex"} \nu
          %h2#definition Definition
          %p
            Fix a
            %a.existingWikiWord{:href => "/nlab/show/measurable+space"} measurable space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                %annotation{:encoding => "application/x-tex"} \mu
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ν
                %annotation{:encoding => "application/x-tex"} \nu
            be two
            %a.existingWikiWord{:href => "/nlab/show/measures"} measures
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          .num_defn
            %h6#definition_2 Definition
            %p
              The measure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
              is
              %strong absolutely continuous
              with respect to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ν
                  %annotation{:encoding => "application/x-tex"} \nu
              if every
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ν
                    %annotation{:encoding => "application/x-tex"} \nu
              %a.existingWikiWord{:href => "/nlab/show/full+set"} full set
              is also
              = succeed "-full." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi μ
                    %annotation{:encoding => "application/x-tex"} \mu
          %p
            Because
            %a.existingWikiWord{:href => "/nlab/show/null+sets"} null sets
            are more familiar than
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/full+sets"} full sets
            = succeed "):" do
              %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive mathematics
          .num_defn
            %h6#definition_classical Definition (classical)
            %p
              The measure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
              is
              %strong absolutely continuous
              with respect to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ν
                  %annotation{:encoding => "application/x-tex"} \nu
              if every
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ν
                    %annotation{:encoding => "application/x-tex"} \nu
              %a.existingWikiWord{:href => "/nlab/show/null+set"} null set
              is also
              = succeed "-null." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi μ
                    %annotation{:encoding => "application/x-tex"} \mu
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                %annotation{:encoding => "application/x-tex"} \mu
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ν
                %annotation{:encoding => "application/x-tex"} \nu
            are
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/positive+measures"} positive measures
          .num_defn
            %h6#definition_positive_classical Definition (positive, classical)
            %p
              The positive measure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
              is
              %strong absolutely continuous
              with respect to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ν
                  %annotation{:encoding => "application/x-tex"} \nu
              if, for every
              %a.existingWikiWord{:href => "/nlab/show/measurable+set"} measurable set
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \mu(A) = 0
              if
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ν
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \nu(A) = 0
          %p
            Since the
            %a.existingWikiWord{:href => "/nlab/show/absolute+value"} absolute value
            of a measure is a positive measure, we can also express the general definition as follows:
          .num_defn
            %h6#definition_classical_2 Definition (classical)
            %p
              The measure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
              is
              %strong absolutely continuous
              with respect to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ν
                  %annotation{:encoding => "application/x-tex"} \nu
              if, for every
              %a.existingWikiWord{:href => "/nlab/show/measurable+set"} measurable set
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi μ
                      %mo{:stretchy => "false"} |
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} {|\mu|}(A) = 0
              if
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi ν
                        %mo{:stretchy => "false"} |
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} {|\nu|}(A) = 0
          %h2#generalisation Generalisation
          %p
            Since only the
            %a.existingWikiWord{:href => "/nlab/show/full+sets"} full sets
            (or, classically, the
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/null+sets"} null sets
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/measure"} measure
            %a.existingWikiWord{:href => "/nlab/show/measurable+space"} measurable space
            with a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                  %annotation{:encoding => "application/x-tex"} \delta
            %a.existingWikiWord{:href => "/nlab/show/delta-filter"} filter
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℱ
                %annotation{:encoding => "application/x-tex"} \mathcal{F}
            of full sets (or a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            %a.existingWikiWord{:href => "/nlab/show/sigma-ideal"} ideal
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒩
                %annotation{:encoding => "application/x-tex"} \mathcal{N}
            of null sets) without specifying a measure that produces these. (For example, a
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            is so equipped, effectively the full/null sets under
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lebesgue+measure"} Lebesgue measure
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/coordinate+chart"} coordinate chart
          .num_defn
            %h6#definition_3 Definition
            %p
              The measure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
              is
              %strong absolutely continuous
              with respect to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℱ
                  %annotation{:encoding => "application/x-tex"} \mathcal{F}
              (or
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒩
                    %annotation{:encoding => "application/x-tex"} \mathcal{N}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℱ
                  %annotation{:encoding => "application/x-tex"} \mathcal{F}
              is
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi μ
                    %annotation{:encoding => "application/x-tex"} \mu
              %a.existingWikiWord{:href => "/nlab/show/full+set"} full
              (or every element of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒩
                  %annotation{:encoding => "application/x-tex"} \mathcal{N}
              is
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi μ
                    %annotation{:encoding => "application/x-tex"} \mu
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/null+set"} null
          %p
            In fact, only the full/null sets of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                %annotation{:encoding => "application/x-tex"} \mu
            matter either, but until somebody has use for the notion of one
            = succeed "-filter" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                  %annotation{:encoding => "application/x-tex"} \delta
            = succeed "-ideal)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/centipede+mathematics"} centipede mathematics
          %h2#defaults Defaults
          %p
            If one calls a measure on the
            %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
            ‘absolutely continuous’, this means with respect to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lebesgue+measure"} Lebesgue measure
          %p
            This generalises to any
            %a.existingWikiWord{:href => "/nlab/show/cartesian+space"} cartesian space
            (with Lebesgue measure) or indeed to any
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            of
            %a.existingWikiWord{:href => "/nlab/show/finite+dimension"} finite dimension
            (where there is no canonical Lebesgue measure but a family of local ones and so still a notion of Lebesgue-full and Lebesgue-null sets).
          %p
            Or, this generalises to any
            %a.existingWikiWord{:href => "/nlab/show/compact+group"} compact group
            (with
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Haar+measure"} Haar measure
            %a.existingWikiWord{:href => "/nlab/show/locally+compact+group"} locally compact group
            (where there is no canonical Haar measure but a proportional family of them and so still a canonical notion of Haar-full and Haar-null sets).
          %h2#properties Properties
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ν
                %annotation{:encoding => "application/x-tex"} \nu
            be a measure, and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ∈
                  %msup
                    %mi L
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi ν
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f \in L^1(\nu)
            be an
            %a.existingWikiWord{:href => "/nlab/show/absolutely+integrable+function"} absolutely integrable function
            with respect to
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ν
                  %annotation{:encoding => "application/x-tex"} \nu
            %a.existingWikiWord{:href => "/nlab/show/integration"} integration
            defines a measure
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mi ν
                  %annotation{:encoding => "application/x-tex"} f \nu
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mi ν
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mo ∫
                    %mi E
                  %mi f
                  %mi ν
                  %mo =
                  %msub
                    %mo ∫
                    %mi E
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mi ν
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} d
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} (f \nu)(E) = \int_E f \nu = \int_E f(x) \nu(\mathrm{d}x) .
          %p
            This measure
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mi ν
                %annotation{:encoding => "application/x-tex"} f \nu
            is absolutely continuous with respect to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ν
                  %annotation{:encoding => "application/x-tex"} \nu
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/almost+equality"} almost equality
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            such that
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo =
                    %mi f
                    %mi ν
                  %annotation{:encoding => "application/x-tex"} \mu = f \nu
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                %annotation{:encoding => "application/x-tex"} \mu
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ν
                %annotation{:encoding => "application/x-tex"} \nu
            are
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/localizable+measure"} localizable
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Radon%E2%80%93Nikodym+theorem"} Radon–Nikodym theorem
          %p
            A function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi ℝ
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} f\colon \mathbb{R} \to \mathbb{R}
            is
            %a.existingWikiWord{:href => "/nlab/show/absolutely+continuous+function"} absolutely continuous
            iff the
            %a.existingWikiWord{:href => "/nlab/show/Stieltjes+integral"} Lebesgue–Stieltjes measure
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} d
                  %mi f
                %annotation{:encoding => "application/x-tex"} \mathrm{d}f
            is absolutely continuous with respect to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lebesgue+measure"} Lebesgue measure
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous
