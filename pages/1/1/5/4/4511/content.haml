          %h3#RespectForDirectSumsAndFilteredColimits Respect for direct sums and filtered colimits
          #Tor1RespectsDirectSum.num_prop
            %h6#proposition Proposition
            %p
              Each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Tor
                      %mi n
                      %mi R
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi N
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Tor_n^R(-,N)
              respects
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/direct+sums"} direct sums
          .proof
            %h6#proof_2 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} S \in
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi N
                      %mi s
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi s
                        %mo ∈
                        %mi S
                  %annotation{:encoding => "application/x-tex"} \{N_s\}_{s \in S}
              be an
              = succeed "-family" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/modules"} modules
            %ol
              %li
                %p
                  if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi F
                          %mi s
                        %msub
                          %mo{:stretchy => "false"} )
                          %mo •
                        %msub
                          %mo{:stretchy => "false"} }
                          %mrow
                            %mi s
                            %mo ∈
                            %mi S
                      %annotation{:encoding => "application/x-tex"} \{(F_s)_\bullet\}_{s \in S}
                  is an family of
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/projective+resolutions"} projective resolutions
                  %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mo ⊕
                          %mrow
                            %mi s
                            %mo ∈
                            %mi S
                        %mi F
                        %msub
                          %mo{:stretchy => "false"} )
                          %mo •
                      %annotation{:encoding => "application/x-tex"} (\oplus_{s \in S} F)_\bullet
                  is a projective resolution of
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mo ⊕
                            %mrow
                              %mi s
                              %mo ∈
                              %mi S
                          %msub
                            %mi N
                            %mi s
                        %annotation{:encoding => "application/x-tex"} \oplus_{s \in S} N_s
              %li
                %p
                  the tensor product functor distributes over direct sums (this is discussed at
                  = succeed ")" do
                    %em
                      %a{:href => "module#MonoidalCategoryStructure"} tensor product of modules – monoidal category structure
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/chain+homology"} chain homology
                  functor preserves direct sums (this is discussed at
                  = succeed ")." do
                    %em
                      %a{:href => "http://ncatlab.org/nlab/show/chain+homology+and+cohomology#RespectForDirectSum"} chain homology - respect for direct sums
            %p Using this we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msubsup
                              %mi Tor
                              %mi n
                              %mi R
                            %mo{:stretchy => "false"} (
                            %msub
                              %mo ⊕
                              %mrow
                                %mi s
                                %mo ∈
                                %mi S
                            %msub
                              %mi N
                              %mi s
                            %mo ,
                            %mi N
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                            %msub
                              %mi H
                              %mi n
                            %mrow
                              %mo (
                              %mrow
                                %mo (
                                %msub
                                  %mo ⊕
                                  %mrow
                                    %mi s
                                    %mo ∈
                                    %mi S
                                %mi F
                                %mo )
                              %mo ⊗
                              %mi N
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mi H
                              %mi n
                            %mrow
                              %mo (
                              %msub
                                %mo ⊕
                                %mrow
                                  %mi s
                                  %mo ∈
                                  %mi S
                              %mrow
                                %mo (
                                %msub
                                  %mi F
                                  %mi s
                                %mo ⊗
                                %mi N
                                %mo )
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mo ⊕
                              %mrow
                                %mi s
                                %mo ∈
                                %mi S
                            %msub
                              %mi H
                              %mi n
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi F
                              %mi s
                            %mo ⊗
                            %mi N
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mo ⊕
                              %mrow
                                %mi s
                                %mo ∈
                                %mi S
                            %msub
                              %mi Tor
                              %mi n
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi N
                              %mi s
                            %mo ,
                            %mi N
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    Tor_n^R(\oplus_{s \in S} N_s, N)
                    \&amp; \simeq
                    H_n\left( \left(\oplus_{s \in S} F\right) \otimes  N  \right)
                    \\\
                    \&amp; \simeq
                    H_n\left( \oplus_{s \in S} \left(F_s \otimes N \right)  \right)
                    \\\
                    \&amp; \simeq \oplus_{s \in S} H_n( F_s \otimes N )
                    \\\
                    \&amp; \simeq \oplus_{s \in S} Tor_n(N_s, N)
                    \\end{aligned}
                    \\,.
          #TorPreservesFilteredColimits.num_prop
            %h6#proposition_2 Proposition
            %p
              Each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Tor
                      %mi n
                      %mi R
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi N
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Tor_n^R(-,N)
              respects
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/filtered+colimits"} filtered colimits
          .proof
            %h6#proof_3 Proof
            %p
              Let hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:lspace => "verythinmathspace"} :
                    %mi I
                    %mo →
                    %mi R
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} A \colon I \to R Mod
              be a
              %a.existingWikiWord{:href => "/nlab/show/filtered+category"} filtered
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              of modules. For each
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mi i
                    %annotation{:encoding => "application/x-tex"} A_i
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} i \in I
              we may find a
              %a.existingWikiWord{:href => "/nlab/show/projective+resolution"} projective resolution
              and in fact a
              %a.existingWikiWord{:href => "/nlab/show/free+resolution"} free resolution
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Y
                        %mi i
                      %msub
                        %mo{:stretchy => "false"} )
                        %mo •
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mo ≃
                            %mi qi
                      %mi A
                    %annotation{:encoding => "application/x-tex"} (Y_i)_\bullet \stackrel{\simeq_{qi}}{\to} A
              %a.existingWikiWord{:href => "/nlab/show/chain+homology"} chain homology
              commutes with filtered colimits (this is discussed at
              = succeed ")," do
                %em
                  %a{:href => "http://ncatlab.org/nlab/show/chain+homology+and+cohomology#RespectForDirectSum"} chain homology - respect for filtered colimits
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %munder
                      %mi lim
                      %mrow
                        %msub
                          %mo →
                          %mi i
                    %msub
                      %mi Y
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    (\underset{\to_i}{\lim} Y_i)_\bullet \to A
            %p
              is still a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
              %a.existingWikiWord{:href => "/nlab/show/Lazard%27s+criterion"} Lazard's criterion
              the degreewise filtered colimits of
              %a.existingWikiWord{:href => "/nlab/show/free+modules"} free modules
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi lim
                      %mrow
                        %msub
                          %mo →
                          %mi i
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Y
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \underset{\to_i}{\lim} (Y_i)_n
              for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              are
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/flat+modules"} flat modules
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi lim
                      %mrow
                        %msub
                          %mo →
                          %mi i
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Y
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \underset{\to_i}{\lim} (Y_i)_\bullet \to A
              is
              %a.existingWikiWord{:href => "/nlab/show/flat+resolution"} flat resolution
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/flat+modules"} flat modules
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo ⊗
                      %mi N
                    %annotation{:encoding => "application/x-tex"} (-)\otimes N
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/acyclic+resolution"} acyclic resolution
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Tor
                      %mi n
                      %mi ℤ
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %munder
                      %mi lim
                      %mrow
                        %msub
                          %mo →
                          %mi i
                    %msub
                      %mi Y
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Tor_n^\mathbb{Z}(A,N)
                    \\simeq
                    H_n( (\underset{\to_i}{\lim} Y_i) \otimes N )
                    \\,.
            %p
              Now the
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+modules"} tensor product of modules
              is a
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              (the
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              being the
              %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
              of modules) and so it commutes over the filtered colimit to yield, using again that
              %a.existingWikiWord{:href => "/nlab/show/chain+homology"} chain homology
              commutes with filtered colimits,
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi ⋯
                          %mtd
                            %mo ≃
                            %msub
                              %mi H
                              %mi n
                            %mo{:stretchy => "false"} (
                            %munder
                              %mi lim
                              %mrow
                                %msub
                                  %mo →
                                  %mi i
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Y
                              %mi i
                            %mo ⊗
                            %mi N
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %munder
                              %mi lim
                              %mrow
                                %msub
                                  %mo →
                                  %mi i
                            %msub
                              %mi H
                              %mi n
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Y
                              %mi i
                            %mo ⊗
                            %mi N
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %munder
                              %mi lim
                              %mrow
                                %msub
                                  %mo →
                                  %mi i
                            %msub
                              %mi Tor
                              %mi n
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi A
                              %mi i
                            %mo ,
                            %mi N
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\cdots
                    \&amp;
                    \\simeq
                    H_n( \underset{\to_i}{\lim} (Y_i \otimes N) )
                    \\\
                    \&amp; \simeq
                    \\underset{\to_i}{\lim} H_n( Y_i \otimes N )
                    \\\
                    \&amp; \simeq
                    \\underset{\to_i}{\lim} Tor_n( A_i, N)
                    \\end{aligned}
                    \\,.
          %h3#SymmetryInTheTwoArguments Symmetry in the two arguments
          .num_prop
            %h6#proposition_3 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mn 1
                    %mo ,
                    %msub
                      %mi N
                      %mn 2
                    %mo ∈
                    %mi R
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} N_1, N_2 \in R Mod
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              there is a
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Tor
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi Tor
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Tor_n(A,B) \simeq Tor_n(B,A)
                    \\,.
          %p
            We first give a proof for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            a
            %a.existingWikiWord{:href => "/nlab/show/principal+ideal+domain"} principal ideal domain
            such as
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
          .proof
            %h6#proof_4 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              be a
              %a.existingWikiWord{:href => "/nlab/show/principal+ideal+domain"} principal ideal domain
              such as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              (in the latter case
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              %a.existingWikiWord{:href => "/nlab/show/Mod"} Mod
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≃
                  %annotation{:encoding => "application/x-tex"} \simeq
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
              %em
                %a{:href => "projective+resolution#Lenght1ResolutionsOfAbelianGroups"} projective resolution – length-1 resolutions
              there is always a
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msub
                      %mi F
                      %mn 1
                    %mo →
                    %msub
                      %mi F
                      %mn 0
                    %mo →
                    %mi N
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    0 \to F_1 \to F_0 \to N \to 0
            %p
              exhibiting a
              %a.existingWikiWord{:href => "/nlab/show/projective+resolution"} projective resolution
              of any module
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                    %annotation{:encoding => "application/x-tex"} N
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Tor
                        %mrow
                          %mi n
                          %mo ≥
                          %mn 2
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} Tor_{n \geq 2}(-,-) = 0
            %p
              Let then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msub
                      %mi F
                      %mn 1
                    %mo →
                    %msub
                      %mi F
                      %mn 2
                    %mo →
                    %msub
                      %mi N
                      %mn 2
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0 \to F_1 \to F_2 \to N_2 \to 0
              be such a short resolution for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi N
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} N_2
              %a{:href => "derived+functor+in+homological+algebra#LongExactSequence"} long exact sequence of a derived functor
              this induces an
              %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exact sequence
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msub
                      %mi Tor
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi N
                      %mn 1
                    %mo ,
                    %msub
                      %mi F
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi Tor
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi N
                      %mn 1
                    %mo ,
                    %msub
                      %mi F
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi Tor
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi N
                      %mn 1
                    %mo ,
                    %msub
                      %mi N
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi N
                      %mn 1
                    %mo ⊗
                    %msub
                      %mi F
                      %mn 1
                    %mo →
                    %msub
                      %mi N
                      %mn 1
                    %mo ⊗
                    %msub
                      %mi F
                      %mn 0
                    %mo →
                    %msub
                      %mi N
                      %mn 1
                    %mo ⊗
                    %msub
                      %mi N
                      %mn 2
                    %mo →
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    0 \to Tor_1(N_1, F_1) \to Tor_1(N_1, F_0) \to Tor_1(N_1, N_2) \to N_1 \otimes F_1 \to N_1 \otimes F_0 \to N_1 \otimes N_2 \to 0
                    \\,.
            %p
              Since by construction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} F_0
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} F_1
              are already
              %a.existingWikiWord{:href => "/nlab/show/projective+modules"} projective modules
              themselves this collapses to an exact sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msub
                      %mi Tor
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi N
                      %mn 1
                    %mo ,
                    %msub
                      %mi N
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %msub
                      %mi N
                      %mn 1
                    %mo ⊗
                    %msub
                      %mi F
                      %mn 1
                    %mo →
                    %msub
                      %mi N
                      %mn 1
                    %mo ⊗
                    %msub
                      %mi F
                      %mn 0
                    %mo →
                    %msub
                      %mi N
                      %mn 1
                    %mo ⊗
                    %msub
                      %mi N
                      %mn 2
                    %mo →
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    0 \to Tor_1(N_1, N_2) \hookrightarrow N_1 \otimes F_1 \to N_1 \otimes F_0 \to N_1 \otimes N_2 \to 0
                    \\,.
            %p
              To the last three terms we apply the natural
              %a.existingWikiWord{:href => "/nlab/show/braided+monoidal+category"} symmetric braiding
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mi Mod
                    %mo ,
                    %msub
                      %mo ⊗
                      %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (R Mod, \otimes_R)
              to get
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi Tor
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi N
                              %mn 1
                            %mo ,
                            %msub
                              %mi N
                              %mn 2
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↪
                          %mtd
                            %msub
                              %mi N
                              %mn 1
                            %mo ⊗
                            %msub
                              %mi F
                              %mn 1
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi N
                              %mn 1
                            %mo ⊗
                            %msub
                              %mi F
                              %mn 0
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi N
                              %mn 1
                            %mo ⊗
                            %msub
                              %mi N
                              %mn 2
                          %mtd
                            %mo →
                          %mtd
                            %mn 0
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ≃
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ≃
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ≃
                          %mtd
                          %mtd
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi Tor
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi N
                              %mn 2
                            %mo ,
                            %msub
                              %mi N
                              %mn 1
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↪
                          %mtd
                            %msub
                              %mi F
                              %mn 1
                            %mo ⊗
                            %msub
                              %mi N
                              %mn 1
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi F
                              %mn 0
                            %mo ⊗
                            %msub
                              %mi N
                              %mn 1
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi N
                              %mn 2
                            %mo ⊗
                            %msub
                              %mi N
                              %mn 1
                          %mtd
                            %mo →
                          %mtd
                            %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    0 &amp;\to&amp; Tor_1(N_1, N_2) &amp;\hookrightarrow&amp; N_1 \otimes F_1 &amp;\to&amp; N_1 \otimes F_0 &amp;\to&amp; N_1 \otimes N_2 &amp;\to&amp; 0
                    \\\
                    \&amp;&amp; \downarrow &amp;&amp; \downarrow^{\mathrlap{\simeq}} &amp;&amp; \downarrow^{\mathrlap{\simeq}} &amp;&amp; \downarrow^{\mathrlap{\simeq}}
                    \&amp;&amp;
                    \\\
                    0 &amp;\to&amp; Tor_1(N_2, N_1) &amp;\hookrightarrow&amp; F_1 \otimes N_1 &amp;\to&amp; F_0 \otimes N_1 &amp;\to&amp; N_2 \otimes N_1 &amp;\to&amp; 0
                    }
                    \\,.
            %p
              This exhibits a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Tor
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi N
                      %mn 1
                    %mo ,
                    %msub
                      %mi N
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi Tor
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi N
                      %mn 2
                    %mo ,
                    %msub
                      %mi N
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Tor_1(N_1,N_2) \to Tor_1(N_2, N_1)
              as the morphism induced on
              %a.existingWikiWord{:href => "/nlab/show/kernels"} kernels
              from an isomorphism between two morphisms. Hence this is itself an isomorphism. (This is just by the
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/four+lemma"} four lemma
              = succeed ".)" do
                %a.existingWikiWord{:href => "/nlab/show/five+lemma"} five lemma
          %h3#Localization Localization
          %p (…)
          %p
            For instance (
            %a{:href => "#Weibel"}> Weibel, cor. 3.2.13
            ).
          %h2#explicit_computations_for_
            Explicit computations for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Tor
                    %mn 1
                %annotation{:encoding => "application/x-tex"} Tor_1
          %p
            Over a commutative ring
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Tor
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %mi R
                  %mo{:stretchy => "false"} /
                  %mi I
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Tor(M, R/I)
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            is a finitely generated ideal of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
          %h3#RelationToTorsionGroups
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Tor
                    %mn 1
                %annotation{:encoding => "application/x-tex"} Tor_1
            and the torsion modules
          %p
            We shall start looking at the case where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            is a principal ideal generated by a
            %a.existingWikiWord{:href => "/nlab/show/regular+element"} regular element
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo ∈
                    %mi R
                  %annotation{:encoding => "application/x-tex"} r \in R
          %p
          .num_defn
            %h6 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              and
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
              a
              %a.existingWikiWord{:href => "/nlab/show/regular+element"} regular element
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                      %mi r
                    %mi M
                    %mo ≔
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo ∈
                    %mi M
                    %mo{:stretchy => "false"} |
                    %mi r
                    %mo ⋅
                    %mi x
                    %mo =
                    %mn 0
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"}
                    {}_r M \coloneqq \{ x \in M | r \cdot x = 0 \}
            %p
              for the
              = succeed "." do
                %strong
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi r
                      %annotation{:encoding => "application/x-tex"} r
                  \-
                  %span.newWikiWord
                    torsion submodule
                    %a{:href => "/nlab/new/torsion+submodule"} ?
          %p The following proposition explains why Tor functors are called this way.
          %p
          #TorOutOfCyclicGroup.num_prop
            %h6 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              be a commutative ring, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              be an
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo ∈
                    %mi R
                  %annotation{:encoding => "application/x-tex"} r \in R
              be a
              %a.existingWikiWord{:href => "/nlab/show/regular+element"} regular element
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Tor
                      %mn 1
                      %mi R
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mi r
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi M
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mrow
                      %mi r
                    %mi M
                  %annotation{:encoding => "application/x-tex"}
                    Tor_1^R(R/(r), M)
                    \=
                    {}_r M
            %p
          %p
          .proof
            %h6 Proof
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
              is regular, one has a short exact sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mi R
                    %mover
                      %mo →
                      %mrow
                        %mo ⋅
                        %mi r
                    %mi R
                    %mover
                      %mo →
                      %mrow
                        %mi mod
                        %mspace{:width => "thinmathspace"}
                        %mi r
                    %mi R
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mi r
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    0 \to R \stackrel{\cdot r}{\to} R \stackrel{mod\, r}{\to}
                    R/(r) \to 0
            %p
              which once tensored with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              gives us the long exact sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msub
                      %mi Tor
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mi r
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi M
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi M
                    %mover
                      %mo →
                      %mrow
                        %mo ⋅
                        %mi r
                    %mi M
                    %mo →
                    %mi M
                    %mo{:stretchy => "false"} /
                    %mi rM
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    0 \to Tor_1(R/(r), M) \to M \stackrel{\cdot r}{\to} M \to M/rM \to 0
            %p
              One can then identify
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Tor
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mi r
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi M
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Tor_1(R/(r), M)
              with the kernel of the map
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ↦
                      %mi rx
                    %annotation{:encoding => "application/x-tex"} x \mapsto rx
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mrow
                        %mi r
                      %mi M
                    %annotation{:encoding => "application/x-tex"} {}_r M
          %p
            This is no longer the case when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                %annotation{:encoding => "application/x-tex"} r
            is not regular.
          %p
          .num_prop
            %h6 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                  %annotation{:encoding => "application/x-tex"} \pi
              be an idempotent element of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mi π
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} R/(\pi)
              is flat, that is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Tor
                      %mn 1
                      %mi R
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mi π
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    Tor_1^R(R/(\pi), X) = 0
            %p
              for every
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          %p
          .proof
            %h6 Proof
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                  %annotation{:encoding => "application/x-tex"} \pi
              is idempotent,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mi π
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} R/(\pi)
              can be identified with the direct summand
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo −
                    %mi π
                    %mo{:stretchy => "false"} )
                    %mi R
                  %annotation{:encoding => "application/x-tex"} (1-\pi)R
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
          %h3#the_case_of_abelian_groups The case of abelian groups
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ∈
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            with
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n \geq 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℤ
                    %mi n
                  %mo =
                  %mi ℤ
                  %mo{:stretchy => "false"} /
                  %mi n
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}_n = \mathbb{Z}/n\mathbb{Z}
            for the
            %a.existingWikiWord{:href => "/nlab/show/cyclic+group"} cyclic group
            of
            %a.existingWikiWord{:href => "/nlab/show/order"} order
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p
            In the ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            all non-zero elements are regular, we have thus that for any abelian group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Tor
                    %mn 1
                    %mi ℤ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi ℤ
                    %mi n
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mrow
                    %mi n
                  %mi A
                %annotation{:encoding => "application/x-tex"}
                  Tor_1^\mathbb{Z}(\mathbb{Z}_n, A)
                  \\simeq
                  {}_n A
          %p
            for every
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≠
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} n \neq 0
          %p One can now leverage the knowledge of the structure of finite abelian groups to deduce the following proposition.
          .num_prop
            %h6#proposition_4 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              be a
              %a.existingWikiWord{:href => "/nlab/show/finite+abelian+group"} finite abelian group
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              any abelian group. Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Tor
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Tor_1(A,B)
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/torsion+group"} torsion group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Tor
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Tor_1(A,B)
              is a
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              of
              %a.existingWikiWord{:href => "/nlab/show/torsion+subgroups"} torsion subgroups
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
          .proof
            %h6#proof_5 Proof
            %p
              By a fundamental fact about
              %a.existingWikiWord{:href => "/nlab/show/finite+abelian+groups"} finite abelian groups
              (see
              = succeed ")," do
                %em
                  %a{:href => "finite+abelian+group#FiniteAbelianGroupIsDirectSumOfCyclics"} this theorem
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is a
              %a.existingWikiWord{:href => "/nlab/show/direct+sum+of+abelian+groups"} direct sum
              of
              %a.existingWikiWord{:href => "/nlab/show/cyclic+group"} cyclic group
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ≃
                      %msub
                        %mo ⊕
                        %mi k
                      %msub
                        %mi ℤ
                        %mrow
                          %msub
                            %mi p
                            %mi k
                    %annotation{:encoding => "application/x-tex"} A \simeq \oplus_k \mathbb{Z}_{p_k}
              %a.maruku-ref{:href => "#Tor1RespectsDirectSum"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Tor
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} Tor_1
              respects this direct sum, so that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Tor
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mo ⊕
                      %mi k
                    %msub
                      %mi Tor
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ℤ
                      %mrow
                        %msub
                          %mi p
                          %mi k
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Tor_1(A,B) \simeq \oplus_k Tor_1(\mathbb{Z}_{p_k}, B)
                    \\,.
            %p
              By prop.
              %a.maruku-ref{:href => "#TorOutOfCyclicGroup"}
              every direct summand on the right is a torsion group and hence so is the whole direct sum.
          %p More generally we have:
          .num_prop
            %h6#proposition_5 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              be
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Tor
                      %mi ℤ
                  %annotation{:encoding => "application/x-tex"} Tor^\mathbb{Z}
              for the
              %a.existingWikiWord{:href => "/nlab/show/left+derived+functor"} left derived functor
              of tensoring over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo =
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} R = \mathbb{Z}
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi Tor
                          %mn 1
                          %mi ℤ
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo ,
                        %mi B
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Tor^\mathbb{Z}_1(A,B)
                  is a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/torsion+group"} torsion group
                  %a.existingWikiWord{:href => "/nlab/show/filtered+colimit"} filtered colimit
                  of torsion subgroups of
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi B
                        %annotation{:encoding => "application/x-tex"} B
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi Tor
                          %mn 1
                          %mi ℤ
                        %mo{:stretchy => "false"} (
                        %mi ℚ
                        %mo{:stretchy => "false"} /
                        %mi ℤ
                        %mo ,
                        %mi A
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Tor^{\mathbb{Z}}_1(\mathbb{Q}/\mathbb{Z}, A)
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/torsion+subgroup"} torsion subgroup
                  of
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi A
                        %annotation{:encoding => "application/x-tex"} A
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/torsion+subgroup"} torsion-free group
                  precisely if
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msubsup
                            %mi Tor
                            %mn 1
                            %mi ℤ
                          %mo{:stretchy => "false"} (
                          %mi A
                          %mo ,
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} Tor^\mathbb{Z}_1(A,-) = 0
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msubsup
                            %mi Tor
                            %mn 1
                            %mi ℤ
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo ,
                          %mi A
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} Tor^\mathbb{Z}_1(-,A) = 0
          %p
            For instance (
            %a{:href => "#Weibel"}> Weibel, prop. 3.1.2, prop. 3.1.3, cor. 3.1.5
            ).
          .proof
            %h6#proof_6 Proof
            %p
              The group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              may be expressed as a
              %a.existingWikiWord{:href => "/nlab/show/filtered+colimit"} filtered colimit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ≃
                    %munder
                      %mi lim
                      %mrow
                        %msub
                          %mo →
                          %mi i
                    %msub
                      %mi A
                      %mi i
                  %annotation{:encoding => "application/x-tex"}
                    A \simeq \underset{\to_i}{\lim} A_i
            %p
              of finitely generated
              %a.existingWikiWord{:href => "/nlab/show/subgroups"} subgroups
              (this is discussed at
              = succeed ")." do
                %em
                  %a{:href => "http://ncatlab.org/nlab/show/Mod#LimitsAndColimits"} Mod - Limits and colimits
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cyclic+groups"} cyclic groups
            %p
              By prop.
              %a.maruku-ref{:href => "#TorPreservesFilteredColimits"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Tor
                      %mn 1
                      %mi ℤ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Tor_1^\mathbb{Z}(-,B)
              preserves these colimits. By prop.
              %a.maruku-ref{:href => "#TorOutOfCyclicGroup"}
              every cyclic group is sent to a torsion group (of either
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              or
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              %a.maruku-ref{:href => "#TorOutOfCyclicGroup"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Tor
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Tor_1(A,B)
              is a filtered colimit of direct sums of torsion groups. This is itself a torsion group.
          .num_remark
            %h6#remark Remark
            %p
              Analogous results fail, in general, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              replaced by another ring
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
          .num_cor
            %h6#corollary Corollary
            %p
              An
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
              is
              %a.existingWikiWord{:href => "/nlab/show/torsion+subgroup"} torsion free
              precisely if regarded as a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              %a.existingWikiWord{:href => "/nlab/show/module"} module
              it is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/flat+module"} flat module
          %p
            See at
            %em
              %a{:href => "flat+module#Examles"} flat module - Examples
            for more.
          %h3#_of_two_cyclic_modules
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Tor
                    %mn 1
                %annotation{:encoding => "application/x-tex"} Tor_1
            of two cyclic modules
          %p
          .num_prop
            %h6 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              be a commutative ring and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo ⊂
                    %mi R
                  %annotation{:encoding => "application/x-tex"} I \subset R
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                    %mo ⊂
                    %mi R
                  %annotation{:encoding => "application/x-tex"} J \subset R
              be two ideals. Then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Tor
                      %mn 1
                      %mi R
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} /
                    %mi I
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} /
                    %mi J
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo ∩
                    %mi J
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi IJ
                  %annotation{:encoding => "application/x-tex"}
                    Tor^R_1(R/I, R/J) \simeq (I \cap J) /IJ
            %p
          %p
          .proof
            %h6 Proof
            %p
              One has a short exact sequence
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo →
                      %mi I
                      %mo →
                      %mi R
                      %mo →
                      %mi R
                      %mo{:stretchy => "false"} /
                      %mi I
                      %mo →
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} 0 \to I \to R \to R/I \to 0
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo{:stretchy => "false"} /
                      %mi J
                    %annotation{:encoding => "application/x-tex"} R/J
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msub
                      %mi Tor
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} /
                    %mi I
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} /
                    %mi J
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi I
                    %mo ⊗
                    %mi R
                    %mo{:stretchy => "false"} /
                    %mi J
                    %mo →
                    %mi R
                    %mo{:stretchy => "false"} /
                    %mi J
                    %mo →
                    %mi R
                    %mo{:stretchy => "false"} /
                    %mi I
                    %mo ⊗
                    %mi R
                    %mo{:stretchy => "false"} /
                    %mi J
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    0 \to Tor_1(R/I, R/J) \to I \otimes R/J \to R/J \to R/I \otimes R/J \to 0
            %p
              Hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Tor
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} /
                    %mi I
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} /
                    %mi J
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Tor_1(R/I, R/J)
              can be identified with the kernel of the map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo ⊗
                    %mi R
                    %mo{:stretchy => "false"} /
                    %mi J
                    %mo →
                    %mi R
                    %mo{:stretchy => "false"} /
                    %mi J
                  %annotation{:encoding => "application/x-tex"} I \otimes R/J \to R/J
              which is isomorphic to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi I
                      %mo ∩
                      %mi J
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mi IJ
                    %annotation{:encoding => "application/x-tex"} (I \cap J)/IJ
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ext"} Ext
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Cotor"} Cotor
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/flat+resolution+lemma"} flat resolution lemma
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/universal+coefficient+theorem"} universal coefficient theorem
          %h2#references References
          %p Standard textbook accounts include the following:
          %ul#Weibel
            %li
              %a.existingWikiWord{:href => "/nlab/show/Charles+Weibel"}> Charles Weibel
              ,
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/An+Introduction+to+Homological+Algebra"} An Introduction to Homological Algebra
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Henri+Cartan"}> Henri Cartan
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Samuel+Eilenberg"} Samuel Eilenberg
                = succeed "," do
                  %em Homological algebra
            %li
              %p
                M. Kashiwara and P. Schapira,
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Categories+and+Sheaves"} Categories and Sheaves
            %li
              %p
                S. I . Gelfand, Yu. I. Manin,
                %em Methods of homological algebra
          %p Lecture notes include
          %ul
            %li
              Daniel Murfet,
              %em Tor
              (
              %a{:href => "http://therisingsea.org/notes/Tor.pdf"}> pdf
              )
          %p section 3 of
          %ul#May
            %li
              %a.existingWikiWord{:href => "/nlab/show/Peter+May"}> Peter May
              ,
              %em Notes on Tor and Ext
              (
              %a{:href => "http://www.math.uchicago.edu/~may/MISC/TorExt.pdf"}> pdf
              )
          %p
            and specifically for
            %a.existingWikiWord{:href => "/nlab/show/symmetric+smash+product+of+spectra"} symmetric
            %a.existingWikiWord{:href => "/nlab/show/model+categories+of+spectra"} model categories of spectra
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Anthony+Elmendorf"}> Anthony Elmendorf
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Igor+Kriz"} Igor Kriz
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Peter+May"} Peter May
              %em
