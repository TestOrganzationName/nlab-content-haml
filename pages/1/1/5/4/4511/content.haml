          %h2#idea Idea
          %p
            In the context of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homological+algebra"} homological algebra
            %em
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi Tor
                  %annotation{:encoding => "application/x-tex"} Tor
              \-functor
            is the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/derived+tensor+product"} derived tensor product
            %a.existingWikiWord{:href => "/nlab/show/left+derived+functor"} left derived functor
            of the
            %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+modules"} tensor product of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/modules"} modules
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
          %p
            Together with the
            %a.existingWikiWord{:href => "/nlab/show/Ext-functor"} Ext-functor
            it constitutes one of the central operations of interest in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homological+algebra"} homological algebra
          %h2#definition Definition
          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            the
            %a.existingWikiWord{:href => "/nlab/show/bifunctor"} bifunctor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ⊗
                    %mi R
                  %mo :
                  %msub
                    %mi Mod
                    %mi R
                  %mo ×
                  %msub
                    %mrow
                    %mi R
                  %mi Mod
                  %mo →
                  %mi Ab
                %annotation{:encoding => "application/x-tex"} \otimes_R : Mod_{R} \times {}_{R}Mod\to Ab
            from two copies of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %a.existingWikiWord{:href => "/nlab/show/Mod"} Mod
            to
            %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/right+exact+functor"} right exact functor
            %a.existingWikiWord{:href => "/nlab/show/left+derived+functors"} left derived functors
            are the
            %strong Tor-functors
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Tor
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msub
                    %mi Mod
                    %mi R
                  %mo →
                  %mi Ab
                %annotation{:encoding => "application/x-tex"}
                  Tor(-,B)
                  \:
                  Mod_R \to Ab
          %p and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Tor
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msub
                    %mrow
                    %mi R
                  %mi Mod
                  %mo →
                  %mi Ab
                %annotation{:encoding => "application/x-tex"}
                  Tor(A,-)
                  \:
                  {}_{R}Mod \to Ab
          %p with respect to one argument with fixed another, if they exist, are parts of a bifunctor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Tor
                  %mo :
                  %msub
                    %mi Mod
                    %mi R
                  %mo ×
                  %msub
                    %mrow
                    %mi R
                  %mi Mod
                  %mo →
                  %mi Ab
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Tor : Mod_{R}\times {}_{R}Mod\to Ab
                  \\,.
          %h2#properties Properties
          %h3#ExistenceAndBalancing Existence and balancing
          %p
            Given a right
            = succeed "-module" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %msub
                    %mi Mod
                    %mi R
                %annotation{:encoding => "application/x-tex"}
                  A \in Mod_R
          %p
            and a left
            = succeed "-module" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo ∈
                  %msub
                    %mrow
                    %mi R
                  %mi Mod
                %annotation{:encoding => "application/x-tex"}
                  B \in {}_R Mod
          %p
            there are in principle three different ways to compute their derived tensor product
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Tor
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Tor_\bullet(A,B)
          %ol
            %li
              %p
                keeping
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
                fixed and deriving the functor
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo ⊗
                        %mi R
                      %mi B
                      %mo :
                      %msub
                        %mi Mod
                        %mi R
                      %mo →
                      %mi Ab
                    %annotation{:encoding => "application/x-tex"}
                      (-) \otimes_R B : Mod_R \to Ab
            %li
              %p
                keeping
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                fixed and deriving the functor
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %msub
                        %mo ⊗
                        %mi R
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo :
                      %msub
                        %mrow
                        %mi R
                      %mi Mod
                      %mo →
                      %mi Ab
                    %annotation{:encoding => "application/x-tex"}
                      A \otimes_R (-) : {}_R Mod \to Ab
            %li
              %p deriving the functor
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo ⊗
                        %mi R
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo :
                      %msub
                        %mi Mod
                        %mi R
                      %mo ×
                      %msub
                        %mrow
                        %mi R
                      %mi Mod
                      %mo →
                      %mi Ab
                    %annotation{:encoding => "application/x-tex"}
                      (-) \otimes_R (-) : Mod_R \times {}_R Mod \to Ab
              %p in both arguments
          .num_theorem
            %h6#theorem Theorem
            %p
              If both
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Mod
                      %mi R
                  %annotation{:encoding => "application/x-tex"} Mod_{R}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo
                      %mi R
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} _{R}Mod
              have
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/projective+object"} enough projectives
          .proof
            %h6#proof Proof
            %p
              Existence is clear from the very definition of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/derived+functor+in+homological+algebra"} derived functor in homological algebra
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Q
                      %mo •
                      %mi A
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mo ≃
                          %mi qi
                    %mi A
                  %annotation{:encoding => "application/x-tex"} Q^A_\bullet \stackrel{\simeq_{qi}}{\to} A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Q
                      %mo •
                      %mi B
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mo ≃
                          %mi qi
                    %mi B
                  %annotation{:encoding => "application/x-tex"} Q^B_\bullet \stackrel{\simeq_{qi}}{\to} B
              be
              %a.existingWikiWord{:href => "/nlab/show/projective+resolutions"} projective resolutions
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+chain+complexes"} tensor product of chain complexes
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Tot
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi Q
                        %mo •
                        %mi A
                      %mo ⊗
                      %msubsup
                        %mi Q
                        %mo •
                        %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Tot (Q^A_\bullet\otimes Q^B_\bullet)
              %a.existingWikiWord{:href => "/nlab/show/total+complex"} total complex
              of the degreewise
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+modules"} tensor product of modules
              %a.existingWikiWord{:href => "/nlab/show/double+complex"} double complex
              carries the
              %a.existingWikiWord{:href => "/nlab/show/filtered+chain+complex"} filtration
              by horizontal degree as well as that by vertical degree.
            %p
              Accordingly there are the corresponding two
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/spectral+sequences+of+a+double+complex"} spectral sequences of a double complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mrow
                      %mi A
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mi r
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi r
                        %mo ,
                        %mi p
                        %mo ,
                        %mi q
                  %annotation{:encoding => "application/x-tex"} \{{}^{A}E^r_{p,q}\}_{r,p,q}
              (for the filtering by
              = succeed "-degree)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mrow
                      %mi B
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mi r
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi r
                        %mo ,
                        %mi p
                        %mo ,
                        %mi q
                  %annotation{:encoding => "application/x-tex"} \{{}^{B}E^r_{p,q}\}_{r,p,q}
              (for the filtering by
              = succeed "-degree)." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
            %p
              We find the value of both spectral sequences on low degree pages according to the general discussion at
              = succeed "." do
                %em
                  %a{:href => "spectral+sequence+of+a+double%20complex#LowDegreePages"} spectral sequence of a double complex - low degree pages
            %p The 0th page for both is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mrow
                      %mi A
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mn 0
                    %mo =
                    %msup
                      %mrow
                      %mi B
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mn 0
                    %mo ≔
                    %msubsup
                      %mi Q
                      %mi p
                      %mi A
                    %msub
                      %mo ⊗
                      %mi R
                    %msubsup
                      %mi Q
                      %mi q
                      %mi B
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    {}^A E^0_{p,q} = {}^B E^0_{p,q} \coloneqq Q^A_p \otimes_R Q^B_q
                    \\,.
            %p For the first page we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mi A
                            %msubsup
                              %mi E
                              %mrow
                                %mi p
                                %mo ,
                                %mi q
                              %mn 1
                          %mtd
                            %mo ≃
                            %msub
                              %mi H
                              %mi q
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi C
                              %mrow
                                %mi p
                                %mo ,
                                %mo •
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mi H
                              %mi q
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi Q
                              %mi p
                              %mi A
                            %mo ⊗
                            %msubsup
                              %mi Q
                              %mo •
                              %mi B
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    {}^A E^1_{p,q}
                    \&amp; \simeq H_q(C_{p,\bullet})
                    \\\
                    \&amp; \simeq  H_q( Q^A_p \otimes Q^B_\bullet )
                    \\end{aligned}
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mi B
                            %msubsup
                              %mi E
                              %mrow
                                %mi p
                                %mo ,
                                %mi q
                              %mn 1
                          %mtd
                            %mo ≃
                            %msub
                              %mi H
                              %mi q
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi C
                              %mrow
                                %mo •
                                %mo ,
                                %mi p
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mi H
                              %mi q
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi Q
                              %mo •
                              %mi A
                            %mo ⊗
                            %msubsup
                              %mi Q
                              %mi p
                              %mi B
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    {}^B E^1_{p,q}
                    \&amp; \simeq H_q(C_{\bullet,p})
                    \\\
                    \&amp; \simeq  H_q( Q^A_\bullet \otimes Q^B_p )
                    \\end{aligned}
                    \\,.
            %p
              Now using the
              %a.existingWikiWord{:href => "/nlab/show/universal+coefficient+theorem"} universal coefficient theorem
              %a{:href => "universal%20coefficient%20theorem#InHomology"} in homology
              and the fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Q
                      %mo •
                      %mi A
                  %annotation{:encoding => "application/x-tex"} Q^A_\bullet
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Q
                      %mo •
                      %mi B
                  %annotation{:encoding => "application/x-tex"} Q^B_\bullet
              is a
              %a.existingWikiWord{:href => "/nlab/show/resolution"} resolution
              by
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/projective+objects"} projective objects
              %a.existingWikiWord{:href => "/nlab/show/acyclic+objects"} acyclic objects
              for which all
              = succeed "-modules" do
                %a.existingWikiWord{:href => "/nlab/show/Tor"} Tor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mi A
                            %msubsup
                              %mi E
                              %mrow
                                %mi p
                                %mo ,
                                %mi q
                              %mn 1
                          %mtd
                            %mo ≃
                            %msubsup
                              %mi Q
