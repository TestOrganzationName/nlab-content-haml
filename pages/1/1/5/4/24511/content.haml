          %h2#properties Properties
          %p
          .num_prop
            %h6 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is a commutative rig, then the symmetric algebra defines an algebra modality in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Mod
                        %mi R
                    %annotation{:encoding => "application/x-tex"} Mod_{R}
            %ul
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sym
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Sym(A)
                is the
                %a.existingWikiWord{:href => "/nlab/show/symmetric+algebra"} symmetric algebra
                of the module
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
              %li
                We have
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mo ∇
                          %mi A
                        %mo :
                        %mi Sym
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                        %mo ⊗
                        %mi Sym
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi Sym
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \nabla_{A}:Sym(A) \otimes Sym(A) \rightarrow Sym(A)
              %li
                We have
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi η
                          %mi A
                        %mo :
                        %mi A
                        %mo →
                        %mi Sym
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \eta_{A}:A \rightarrow Sym(A)
              %li
                The unit
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo →
                      %mi Sym
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} A \rightarrow Sym(A)
                of the monad is just the injection
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ↦
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x \mapsto x
              %li
                The multiplication
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sym
                      %mo{:stretchy => "false"} (
                      %mi Sym
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi Sym
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Sym(Sym(A)) \rightarrow Sym(A)
                of the monad is given on pure tensors by
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msubsup
                          %mi x
                          %mn 1
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                        %msub
                          %mo ⊗
                          %mi s
                        %mo .
                        %mo .
                        %mo .
                        %msub
                          %mo ⊗
                          %mi s
                        %msubsup
                          %mi x
                          %mrow
                            %msub
                              %mi n
                              %mn 1
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo ⊠
                          %mi s
                        %mo .
                        %mo .
                        %mo .
                        %msub
                          %mo ⊠
                          %mi s
                        %mo{:stretchy => "false"} (
                        %msubsup
                          %mi x
                          %mn 1
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi p
                            %mo{:stretchy => "false"} )
                        %msub
                          %mo ⊗
                          %mi s
                        %mo .
                        %mo .
                        %mo .
                        %msub
                          %mo ⊗
                          %mi s
                        %msubsup
                          %mi x
                          %mrow
                            %msub
                              %mi n
                              %mi p
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi p
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo ↦
                        %msubsup
                          %mi x
                          %mn 1
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                        %msub
                          %mo ⊗
                          %mi s
                        %mo .
                        %mo .
                        %mo .
                        %msub
                          %mo ⊗
                          %mi s
                        %msubsup
                          %mi x
                          %mrow
                            %msub
                              %mi n
                              %mn 1
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                        %mo ⊗
                        %mo .
                        %mo .
                        %mo .
                        %mo ⊗
                        %msubsup
                          %mi x
                          %mn 1
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi p
                            %mo{:stretchy => "false"} )
                        %msub
                          %mo ⊗
                          %mi s
                        %mo .
                        %mo .
                        %mo .
                        %msub
                          %mo ⊗
                          %mi s
                        %msubsup
                          %mi x
                          %mrow
                            %msub
                              %mi n
                              %mi p
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi p
                            %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (x_{1}^{(1)} \otimes_{s} ... \otimes_{s} x_{n_{1}}^{(1)}) \boxtimes_{s} ... \boxtimes_{s}  (x_{1}^{(p)} \otimes_{s} ... \otimes_{s} x_{n_{p}}^{(p)}) \mapsto x_{1}^{(1)} \otimes_{s} ... \otimes_{s} x_{n_{1}}^{(1)} \otimes ... \otimes x_{1}^{(p)} \otimes_{s} ... \otimes_{s} x_{n_{p}}^{(p)}
            %p
          %p
          .num_prop
            %h6 Proposition
            %p
              %a.existingWikiWord{:href => "/nlab/show/rigs"} Commutative rigs
              are exactly the
              %a.existingWikiWord{:href => "/nlab/show/algebra+over+a+monad"} algebras
              (over a monad) over the algebra modality
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sym
                  %annotation{:encoding => "application/x-tex"} Sym
              in the category of commutative monoids.
          %h2#references References
          %p
            Algebra modalities are part of the definition of a codifferential category ie. a category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝒞
                    %mi op
                %annotation{:encoding => "application/x-tex"} \mathcal{C}^{op}
            is a differential category.
          %p Differential categories were introduced in:
          %ul
            %li#BluteCocketSeely06
              %a.existingWikiWord{:href => "/nlab/show/R.+F.+Blute"}> R. F. Blute
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/J.+R.+B.+Cockett"} J. R. B. Cockett
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/R.+A.+G.+Seely"} R. A. G. Seely
              = succeed "." do
                %em Differential categories
              = succeed ")" do
                %a{:href => "https://doi.org/10.1017/S0960129506005676"} doi:10.1017/S0960129506005676
          %p and revised in:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Richard+Blute"}> Richard Blute
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Robin+Cockett"} Robin Cockett
              %a.existingWikiWord{:href => "/nlab/show/Jean-Simon+Lemay"} Jean-Simon Lemay
              and
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Robert+Seely"} Robert Seely
              %em Differential categories revisited,
              Appl. Categ. Struct. 28, 171-235 (2020). (
              %a{:href => "https://arxiv.org/abs/1806.04804"}> arXiv:1806.04804
              ,
              = succeed ")" do
                %a{:href => "https://doi.org/10.1007/s10485-019-09572-y"} doi:10.1007/s10485-019-09572-y
