            dimensional spacetime is
            %a.existingWikiWord{:href => "/nlab/show/anti+de+Sitter+spacetime"} anti de Sitter spacetime
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi AdS
                    %mn 2
                %annotation{:encoding => "application/x-tex"} AdS_{2}
            (
            %a{:href => "#KLR07"}> KLR 07
            ,
            = succeed "," do
              %a{:href => "#AGJST06"} AGJST 06
            = succeed "," do
              %a{:href => "#AY07"} AY 07
            = succeed ")." do
              %a{:href => "#ANT07"} ANT 07
          %p
            The
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi AdS
                    %mn 2
                  %mo ×
                  %msup
                    %mi S
                    %mrow
                      %mi d
                      %mo −
                      %mn 2
                %annotation{:encoding => "application/x-tex"} AdS_2 \times S^{d-2}
            %a.existingWikiWord{:href => "/nlab/show/near+horizon+geometry"} near horizon geometry
            of near-extremal black holes is well approximated by
            %a.existingWikiWord{:href => "/nlab/show/Jackiw-Teitelboim+gravity"} Jackiw-Teitelboim gravity
            (
            %a{:href => "#NSST18"}> NSST 18
            ,
            = succeed ")." do
              %a{:href => "#MTV18"} MTV 18
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/black+holes+in+string+theory"}> black holes in string theory
                ,
                %a.existingWikiWord{:href => "/nlab/show/black+brane"} black brane
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/BPS+state"} BPS state
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bridgeland+stability+condition"} Bridgeland stability condition
          %h2#references References
          %h3#general General
          %ul
            %li#ANT07
              %p
                Tatsuo Azeyanagi, Tatsuma Nishioka, Tadashi Takayanagi,
                = succeed "," do
                  %em
                    Near Extremal Black Hole Entropy as Entanglement Entropy via
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi AdS
                            %mn 2
                          %mo{:stretchy => "false"} /
                          %msub
                            %mi CFT
                            %mn 1
                        %annotation{:encoding => "application/x-tex"} AdS_2/CFT_1
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/0710.2956"} arXiv:0710.2956
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Sean+Carroll"}> Sean Carroll
                , Matthew C. Johnson,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Lisa+Randall"} Lisa Randall
                = succeed "," do
                  %em Extremal limits and black hole entropy
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/0901.0931"} arXiv:0901.0931
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ashoke+Sen"}> Ashoke Sen
                ,
                = succeed "," do
                  %em Extremal black holes
                = succeed ")" do
                  %a{:href => "https://www.icts.res.in/sites/default/files/1250480845tifr.pdf"} pdf
          %p See also
          %ul
            %li
              Wikipedia,
              %em
                %a{:href => "https://en.wikipedia.org/wiki/Extremal_black_hole"} Extremal black hole
          %h3#bh_entropy BH entropy
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/black+hole+entropy"} black hole entropy
            of (near-)
            %a.existingWikiWord{:href => "/nlab/show/extremal+black+holes"}> extremal black holes
            \:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Luca+Iliesiu"}> Luca Iliesiu
              ,
              = succeed "," do
                %em From statistical mechanics to microstate counting for extremal and near-extremal black holes
              %em
                %a.existingWikiWord{:href => "/nlab/show/Strings+2022"} Strings 2022
              \&amp;lbrack;
              %a{:href => "https://indico.cern.ch/event/1085701/contributions/4940850"}> indico:4940850
              ,
              = succeed "," do
                %a{:href => "https://indico.cern.ch/event/1085701/contributions/4940850/attachments/2482365/4261646/Luca%20Iliesiu%20Tuesday-Reserach-Iliesiu-v2.pdf"} slides
              = succeed "&rbrack;" do
