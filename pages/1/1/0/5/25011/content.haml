                %annotation{:encoding => "application/x-tex"} \mathrm{Reg}(R)
            and first localizing at
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} Reg
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{Reg}(R)
            then taking the quotient by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi I
                    %mrow
                      %mo ¬
                      %mi{:mathvariant => "normal"} Reg
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} I_{\neg \mathrm{Reg}(R)}
            results in isomorphic possibly trivial fields, because no element is both a zero divisor and regular.
          %p
            Thus, one has a
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo :
                  %mi{:mathvariant => "normal"} CRing
                  %mo →
                  %mi{:mathvariant => "normal"} Prefield
                %annotation{:encoding => "application/x-tex"} L:\mathrm{CRing} \to \mathrm{Prefield}
            which takes a commutative ring to its
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/ring+of+fractions"} ring of fractions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                  %mo :
                  %mi{:mathvariant => "normal"} CRing
                  %mo →
                  %mi{:mathvariant => "normal"} PTIntDom
                %annotation{:encoding => "application/x-tex"} Q:\mathrm{CRing} \to \mathrm{PTIntDom}
            taking a commutative ring to its quotient possibly trivial integral domain, and because the category of prefield rings and the category of possibly trivial integral domains are subcategories of the category of commutative rings, there are also
            %a.existingWikiWord{:href => "/nlab/show/subfunctors"} subfunctors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo ′
                  %mo :
                  %mi{:mathvariant => "normal"} PTIntDom
                  %mo →
                  %mi{:mathvariant => "normal"} PTField
                %annotation{:encoding => "application/x-tex"} L':\mathrm{PTIntDom} \to \mathrm{PTField}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                  %mo ′
                  %mo :
                  %mi{:mathvariant => "normal"} Prefield
                  %mo →
                  %mi{:mathvariant => "normal"} PTField
                %annotation{:encoding => "application/x-tex"} Q':\mathrm{Prefield} \to \mathrm{PTField}
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo ′
                  %mo ⊆
                  %mi L
                %annotation{:encoding => "application/x-tex"} L' \subseteq L
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo ′
                    %mo ⊆
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q' \subseteq Q
            %a.existingWikiWord{:href => "/nlab/show/commutative+square"} commutative square
            with
            %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi L
                    %mo ′
                    %mo ∘
                    %mi Q
                    %mo ≅
                    %mi Q
                    %mo ′
                    %mo ∘
                    %mi L
                  %annotation{:encoding => "application/x-tex"} p:L' \circ Q \cong Q' \circ L
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                          %mi{:mathvariant => "normal"} CRing
                        %mtd
                          %mover
                            %mo →
                            %mi L
                        %mtd
                          %mi{:mathvariant => "normal"} Prefield
                        %mtd
                      %mtr
                        %mtd
                          %mi Q
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %mo ≅
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %mi Q
                          %mo ′
                      %mtr
                        %mtd
                        %mtd
                          %mi{:mathvariant => "normal"} PTIntDom
                        %mtd
                          %munder
                            %mo →
                            %mrow
                              %mi L
                              %mo ′
                        %mtd
                          %mi{:mathvariant => "normal"} PTField
                        %mtd
                      %mtr
                        %mtd
                %annotation{:encoding => "application/x-tex"}
                  \\array{&amp; \mathrm{CRing} &amp; \overset{L}\rightarrow &amp; \mathrm{Prefield} &amp; \\
                  Q &amp; \downarrow &amp; \cong &amp;\downarrow &amp; Q'\\
                  \&amp; \mathrm{PTIntDom} &amp; \underset{L'}\rightarrow&amp; \mathrm{PTField} &amp; \\
                  }
          %h2#in_constructive_mathematics In constructive mathematics
          %p
            In constructive mathematics, the notion of field bifurcates into multiple notions. The definition given above results in a possibly trivial
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/weak+Heyting+field"} weak Heyting field
            %a.existingWikiWord{:href => "/nlab/show/Heyting+fields"} Heyting fields
            and possibly trivial
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/discrete+fields"} discrete fields
          %h3#possibly_trivial_heyting_fields Possibly trivial Heyting fields
          %p
            A possibly trivial field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is
            %strong Heyting
            if, whenever the sum of two elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo +
                  %mi b
                %annotation{:encoding => "application/x-tex"} a + b
            is invertible, then either
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            is invertible or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                %annotation{:encoding => "application/x-tex"} b
            is invertible. These are simply called
            %em Heyting fields
            in
            = succeed "." do
              %a{:href => "#LombardiQuitté2010"} LombardiQuitté2010
          %h3#possibly_trivial_discrete_fields Possibly trivial discrete fields
          %p
            A possibly trivial field is
            %strong discrete
            if every element is either zero or invertible. These are simply called
            %em discrete fields
            in
            = succeed "." do
              %a{:href => "#LombardiQuitté2010"} LombardiQuitté2010
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/decidable+equality"} decidable equality
          %h2#see_also See also
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
            %li
              %a.existingWikiWord{:href => "/nlab/show/field"} field
            %li
              %a.existingWikiWord{:href => "/nlab/show/possibly+trivial+integral+domain"} possibly trivial integral domain
            %li
              %a.existingWikiWord{:href => "/nlab/show/weak+local+ring"} weak local ring
          %h2#references References
          %p The concept of a possibly trivial field appeared in
          %ul
            %li{:id => "LombardiQuitté2010"}
              %a.existingWikiWord{:href => "/nlab/show/Henri+Lombardi"}> Henri Lombardi
              ,
              %a.existingWikiWord{:href => "/nlab/show/Claude+Quitt%C3%A9"} Claude Quitté
              (2010):
              %em Commutative algebra: Constructive methods (Finite projective modules)
              Translated by Tania K. Roblo, Springer (2015) (
              %a{:href => "https://link.springer.com/book/10.1007/978-94-017-9944-7"}> doi:10.1007/978-94-017-9944-7
              ,
              = succeed ")" do
                %a{:href => "http://hlombardi.free.fr/CACM.pdf"} pdf
          %p where the possibly trivial Heyting fields are called “Heyting fields” and the possibly trivial discrete field are called “discrete fields”.
