            %h6 Lemma
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} h \colon A \rightarrow B
              be a homomorphism between two
              = succeed "-algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi φ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi F
                    %mi A
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \varphi \colon F A \rightarrow A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi F
                    %mi B
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} \psi \colon F B \rightarrow B
              so that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                      %mo ∘
                      %mi φ
                      %mo =
                      %mi ψ
                      %mo ∘
                      %mi F
                      %mi h
                    %annotation{:encoding => "application/x-tex"} h \circ \varphi = \psi \circ F h
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
