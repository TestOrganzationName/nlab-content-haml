                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi cata
                    %mi φ
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %mi out
                  %annotation{:encoding => "application/x-tex"} cata \varphi = \varphi \circ F (cata \varphi) \circ out
