                  %mo ≺
                  %mi x
                %annotation{:encoding => "application/x-tex"} a \prec x
            with again
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∼
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a \sim b
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≺
                %annotation{:encoding => "application/x-tex"} \prec
            is
            %strong strongly extensional
            if every bisimulation is contained in the identity relation; i.e.,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo =
                  %mi y
                %annotation{:encoding => "application/x-tex"} x = y
            whenever
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∼
                  %mi y
                %annotation{:encoding => "application/x-tex"} x \sim y
            for any bisimulation
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∼
                  %annotation{:encoding => "application/x-tex"} \sim
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≺
                %annotation{:encoding => "application/x-tex"} \prec
            is simply
            = succeed "." do
              %strong extensional
          %p
            Finsler and Scott extensionality may be understood as special cases of this for particular bisimulations
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∼
                  %annotation{:encoding => "application/x-tex"} \sim
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≈
                  %annotation{:encoding => "application/x-tex"} \approx
          %p In particular, strong extensionality implies Scott extensionality, and the converse holds for well-founded relations. Thus, all forms of extensionality are equivalent for well-founded relations.
          %h3#weak_extensionality_for_arbitrary_binary_relations Weak extensionality for arbitrary binary relations
          %p
            Given sets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≺
                %annotation{:encoding => "application/x-tex"} \prec
            be a binary relation on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            %a.existingWikiWord{:href => "/nlab/show/predicate"} predicate
            on the cartesian product
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ×
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A \times B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≺
                %annotation{:encoding => "application/x-tex"} \prec
            is (weakly) extensional if, given any elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                %annotation{:encoding => "application/x-tex"} y
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %msub
                    %mo =
                    %mi B
                  %mi y
                %annotation{:encoding => "application/x-tex"} x =_B y
            whenever for all
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} t:A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo ≺
                  %mi x
                %annotation{:encoding => "application/x-tex"} t \prec x
            if and only if
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo ≺
                    %mi y
                  %annotation{:encoding => "application/x-tex"} t \prec y
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∀
                  %mi x
                  %mo :
                  %mi B
                  %mo .
                  %mo ∀
                  %mi y
                  %mo :
                  %mi B
                  %mo .
                  %mo{:stretchy => "false"} (
                  %mi x
                  %msub
                    %mo =
                    %mi B
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo ⇔
                  %mo ∀
                  %mi t
                  %mo :
                  %mi A
                  %mo .
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo ≺
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ⇔
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo ≺
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \forall x:B.\forall y:B.(x =_B y) \iff \forall t:A.(t \prec x) \iff (t \prec y)
          %h3#in_homotopy_type_theory In homotopy type theory
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
            = succeed "-valued" do
              %a.existingWikiWord{:href => "/nlab/show/h-proposition"} h-proposition
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/type+family"} type family
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≺
                %annotation{:encoding => "application/x-tex"} \prec
            on a carrier type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is
            %strong weakly extensional
            if for all terms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo :
                  %mi S
                %annotation{:encoding => "application/x-tex"} a:S
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                  %mo :
                  %mi S
                %annotation{:encoding => "application/x-tex"} b:S
            the canonical function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} idtoextcond
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi a
                  %msub
                    %mo =
                    %mi S
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo →
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi c
                      %mo :
                      %mi S
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ≺
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ≺
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{idtoextcond}(a, b):(a =_S b) \to \prod_{c:S} (c \prec a) \simeq (c \prec b)
          %p
            is an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+types"} equivalence of types
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/h-set"} h-set
          %h2#examples Examples
          %ul
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/axiom+of+extensionality"} axiom of extensionality
                in material
                %a.existingWikiWord{:href => "/nlab/show/set+theory"} set theory
                states membership is an extensional relation on the class of
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/pure+sets"} pure sets
                %a.existingWikiWord{:href => "/nlab/show/axiom+of+foundation"} axiom of foundation
                states that membership is a well-founded relation, so one usually doesn't worry about the different notions of extensionality for ill-founded relations.) More generally, the membership relation on the
                %a.existingWikiWord{:href => "/nlab/show/transitive+closure"} transitive closure
                or reflexive-transitive closure of a pure set is an extensional relation on a set.
            %li
              %p
                Conversely, one can
                %em define
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/pure+set"} pure set
                %em structural
                %a.existingWikiWord{:href => "/nlab/show/set+theory"} set theory
                in part as sets equipped with an extensional (and optionally well-founded) relation.
            %li
              %p
                In any
                %a.existingWikiWord{:href => "/nlab/show/single-sorted+definition+of+a+category"} single-sorted definition
                of a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/topos"} topos
                %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 1
                (represented by the
                %a.existingWikiWord{:href => "/nlab/show/identity+morphism"} identity morphism
                of the terminal object), one could define the relation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ≺
                    %annotation{:encoding => "application/x-tex"} \prec
                on the set of morphisms
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ≺
                  %mi b
                  %mo ≔
                  %mi s
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 1
                  %mo ∧
                  %mi t
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 1
                  %mo ∧
                  %mi t
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi s
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} a \prec b \coloneqq s(a) = 1 \wedge t(b) = 1 \wedge t(a) = s(b)
          %p
            Due to the
            %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
            of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≺
                %annotation{:encoding => "application/x-tex"} \prec
            is weakly extensional. However,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≺
                %annotation{:encoding => "application/x-tex"} \prec
            is not strongly extensional. The relation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∼
                %annotation{:encoding => "application/x-tex"} \sim
            defined by equality on every pair of functions
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∼
                    %mi b
                    %mo ≔
                    %mi a
                    %mo =
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a \sim b \coloneqq a = b
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} id
                    %mn 2
                  %mo ∼
                  %mi{:mathvariant => "normal"} swap
                %annotation{:encoding => "application/x-tex"} \mathrm{id}_2 \sim \mathrm{swap}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} swap
                  %mo ∼
                  %msub
                    %mi{:mathvariant => "normal"} id
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \mathrm{swap} \sim \mathrm{id}_2
            for the identity function and the swap function on the set with two elements
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≺
                  %annotation{:encoding => "application/x-tex"} \prec
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} id
                      %mn 2
                    %mo =
                    %mi{:mathvariant => "normal"} swap
                  %annotation{:encoding => "application/x-tex"} \mathrm{id}_2 = \mathrm{swap}
          %ul
            %li
              In any
              %a.existingWikiWord{:href => "/nlab/show/single-sorted+definition+of+a+category"} single-sorted definition
              of a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topos"} topos
              %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
              (represented by the
              %a.existingWikiWord{:href => "/nlab/show/identity+morphism"} identity morphism
              of the initial object). One could define the relation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} \in
              on the set of morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ∈
                  %mi b
                  %mo ≔
                  %mi s
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 1
                  %mo ∧
                  %mi s
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 0
                  %mo ∧
                  %mi t
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi t
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} a \in b \coloneqq s(a) = 1 \wedge s(b) = 0 \wedge t(a) = t(b)
          %p
            Due to the
            %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
            of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∈
                %annotation{:encoding => "application/x-tex"} \in
            is weakly extensional. However,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∈
                %annotation{:encoding => "application/x-tex"} \in
            is not strongly extensional, for the same reason that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≺
                %annotation{:encoding => "application/x-tex"} \prec
            defined above is not strongly extensional.
          %ul
            %li
              %p
                A
                %a.existingWikiWord{:href => "/nlab/show/well-order"} well-order
                is precisely a well-founded,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/transitive+relation"} transitive
                = succeed "s." do
                  %a.existingWikiWord{:href => "/nlab/show/ordinal+number"} ordinal number
            %li
              %p
                On the set
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mn 2
                        %mo =
                        %mo{:stretchy => "false"} {
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \mathbf{2} = \{0,1\}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo ≺
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} 0 \prec 0
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo ≺
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 0 \prec 1
                (but no other relationships). This relation is not weakly extensional, although it does satisfy the other half of Finsler extensionality, since
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mn 2
                        %msup
                          %mo{:stretchy => "false"} ↓
                          %mo *
                        %mn 0
                        %mo ≇
                        %mstyle{:mathvariant => "bold"}
                          %mn 2
                        %msup
                          %mo{:stretchy => "false"} ↓
                          %mo *
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} \mathbf{2} \downarrow^* 0 \ncong \mathbf{2} \downarrow^* 1
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mstyle{:mathvariant => "bold"}
                          %mn 2
                        %msup
                          %mo{:stretchy => "false"} ↓
                          %mo +
                        %mn 0
                        %msup
                          %mo{:stretchy => "false"} )
                          %mo ⊤
                        %mo ≅
                        %mo{:stretchy => "false"} (
                        %mstyle{:mathvariant => "bold"}
                          %mn 2
                        %msup
                          %mo{:stretchy => "false"} ↓
                          %mo +
                        %mn 1
                        %msup
                          %mo{:stretchy => "false"} )
                          %mo ⊤
                      %annotation{:encoding => "application/x-tex"} (\mathbf{2} \downarrow^+ 0)^\top \cong (\mathbf{2} \downarrow^+ 1)^\top
            %li
              %p
                On the set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbf{2}
                again, let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo ≺
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 0 \prec 1
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mo ≺
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} 1 \prec 0
                (but
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo ⊀
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} 0 \nprec 0
                and
                = succeed ")." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 1
                        %mo ⊀
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} 1 \nprec 1
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mn 2
                        %msup
                          %mo{:stretchy => "false"} ↓
                          %mo *
                        %mn 0
                        %mo ≅
                        %mstyle{:mathvariant => "bold"}
                          %mn 2
                        %msup
                          %mo{:stretchy => "false"} ↓
                          %mo *
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} \mathbf{2} \downarrow^* 0 \cong \mathbf{2} \downarrow^* 1
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} 0
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 1
                can hardly be distinguished by
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ≺
                    %annotation{:encoding => "application/x-tex"} \prec
                when there is an
                %a.existingWikiWord{:href => "/nlab/show/automorphism"} automorphism
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mn 2
                      %mo ,
                      %mo ≺
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\mathbf{2},\prec)
                that swaps them; this and the other examples below motivate the stronger notions of extensionality.
            %li
              %p
                On the set
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mn 3
                        %mo =
                        %mo{:stretchy => "false"} {
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo ,
                        %mn 2
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \mathbf{3} = \{0,1,2\}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mo ⊀
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} 2 \nprec 0
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ⊀
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i \nprec i
                but all other relationships hold. Then this relation is Finsler-extensional but not Scott-extensional, since
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi T
                          %mn 2
                        %mo ≅
                        %msub
                          %mi T
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} T_2 \cong T_1
            %li
              %p
                Finally, on the set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbf{2}
                again, let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mo ⊀
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} 1 \nprec 0
                but all other relationships hold. Then this relation is Scott-extensional but not strongly extensional, since
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 0
                        %mo ≈
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} 0 \approx 1
          %h2#extensional_quotients Extensional quotients
          %p
            Weak extensionality is a kind of
            %a.existingWikiWord{:href => "/nlab/show/antisymmetric+relation"} antisymmetry
            condition: Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ≤
                  %mi y
                %annotation{:encoding => "application/x-tex"} x \leq y
            mean that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo ≺
                  %mi y
                %annotation{:encoding => "application/x-tex"} t \prec y
            whenever
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo ≺
                    %mi x
                  %annotation{:encoding => "application/x-tex"} t \prec x
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≤
                %annotation{:encoding => "application/x-tex"} \leq
            is clearly a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/preorder"} preorder
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/partial+order"} partial order
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≺
                %annotation{:encoding => "application/x-tex"} \prec
            is weakly extensional.
          %p
            Now suppose that if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo ≺
                  %mi x
                %annotation{:encoding => "application/x-tex"} t \prec x
            if and only if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo ≺
                  %mi y
                %annotation{:encoding => "application/x-tex"} t \prec y
            for all
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ≺
                  %mi z
                %annotation{:encoding => "application/x-tex"} x \prec z
            if and only if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                  %mo ≺
                  %mi z
                %annotation{:encoding => "application/x-tex"} y \prec z
            for all
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                  %annotation{:encoding => "application/x-tex"} z
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ≡
                  %mi y
                %annotation{:encoding => "application/x-tex"} x \equiv y
            to mean that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ≤
                  %mi y
                %annotation{:encoding => "application/x-tex"} x \leq y
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ≤
                    %mi x
                  %annotation{:encoding => "application/x-tex"} y \leq x
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≡
                %annotation{:encoding => "application/x-tex"} \equiv
            is an equivalence relation such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≺
                %annotation{:encoding => "application/x-tex"} \prec
            descends to a weakly extensional relation on the
            %a.existingWikiWord{:href => "/nlab/show/quotient+set"} quotient set
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo{:stretchy => "false"} /
                    %mo ≡
                  %annotation{:encoding => "application/x-tex"} S/{\equiv}
          %p
            Strongly extensional quotients are even easier to construct, although they do create additional relationships. It is easy to see that the union of any family of bisimulations is a bisimulation, and therefore there is a largest bisimulation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≈
                %annotation{:encoding => "application/x-tex"} \approx
            for any binary relation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≺
                %annotation{:encoding => "application/x-tex"} \prec
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≈
                %annotation{:encoding => "application/x-tex"} \approx
            is an equivalence relation (though not every bisimulation need be so), and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≺
                %annotation{:encoding => "application/x-tex"} \prec
            descends to a strongly extensional relation on the quotient
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo{:stretchy => "false"} /
                    %mo ≈
                  %annotation{:encoding => "application/x-tex"} S/\approx
          %h2#simulations Simulations
          %p
            Given two sets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≺
                  %annotation{:encoding => "application/x-tex"} \prec
            %a.existingWikiWord{:href => "/nlab/show/function"} function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi S
                  %mo →
                  %mi T
                %annotation{:encoding => "application/x-tex"} f\colon S \to T
            is a
            %strong
              %a.existingWikiWord{:href => "/nlab/show/simulation"} simulation
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            if
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≺
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(x) \prec f(y)
              whenever
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ≺
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x \prec y
              and
            %li
              given
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mo ≺
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} t \prec f(x)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ≺
                    %mi x
                  %annotation{:encoding => "application/x-tex"} y \prec x
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mo =
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} t = f(y)
          %p
            Then sets so equipped form a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            with simulations as
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
          %p
            Note that there is at most one simulation from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            to
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            is equivalent to saying that any two simulations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo ⇉
                  %mi T
                %annotation{:encoding => "application/x-tex"} S \rightrightarrows T
            are equal. Also, any simulation from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            must be an
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/injection"} injection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is equivalent to saying that any simulation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo →
                  %mi T
                %annotation{:encoding => "application/x-tex"} S \to T
            is injective.
          %p
            Thus, we have a (large)
            %a.existingWikiWord{:href => "/nlab/show/poset"} poset
            of sets equipped with extensional relations, and we can consistently interpret the simulations as
            %a.existingWikiWord{:href => "/nlab/show/subset"} subset
            inclusion. This leads to the model of sets equipped with extensional relations as
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/transitive+set"} transitive set
          %h2#references References
          %ul
            %li
              Peter Aczel;
              = succeed "," do
                %a{:href => "https://web.archive.org/web/20161020002632/https://standish.stanford.edu/pdf/00000056.pdf"} Non-Well-Founded Sets
          %p
            For extensional relations in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/H%C3%A5kon+Robbestad+Gylterud"}> Håkon Robbestad Gylterud
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Elisabeth+Stenholm"} Elisabeth Stenholm
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Niccol%C3%B2+Veltri"} Niccolò Veltri
              %em Terminal Coalgebras and Non-wellfounded Sets in Homotopy Type Theory
              \&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/2001.06696"}> arXiv:2001.06696
              \&amp;rbrack;
        .revisedby
          %p
            Last revised on June 13, 2025 at 15:15:51.
            See the
            %a{:href => "/nlab/history/extensional+relation", :style => "color: #005c19"} history
            of this page for a list of all contributions to it.
