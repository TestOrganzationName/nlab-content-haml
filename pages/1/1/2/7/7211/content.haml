          %h2#idea Idea
          %p
            (
            %a.existingWikiWord{:href => "/nlab/show/gauged+supergravity"}> gauged
            )
            %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
            in
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            3.
          %h2#properties Properties
          %h3#PossibleGaugings Possible gaugings
          %p
            The (
            %a.existingWikiWord{:href => "/nlab/show/U-duality"}> U-duality
            \-)
            %a.existingWikiWord{:href => "/nlab/show/global+gauge+group"} global gauge group
            of maximally
            %a.existingWikiWord{:href => "/nlab/show/supersymmetry"} supersymmetric
            3d supergravity is
            %a.existingWikiWord{:href => "/nlab/show/E8"} E8
            (its
            %a.existingWikiWord{:href => "/nlab/show/split+real+form"} split real form
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mrow
                        %mn 8
                        %mo{:stretchy => "false"} (
                        %mn 8
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E_{8(8)}
            %a.existingWikiWord{:href => "/nlab/show/subgroups"} subgroups
            of this may be promoted to
            %a.existingWikiWord{:href => "/nlab/show/local+gauge+groups"} local gauge groups
            (with
            %a.existingWikiWord{:href => "/nlab/show/gauge+fields"} gauge fields
            in
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/gauged+supergravity"} gauged supergravity
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/flux+compactification"} fluxed
            %a.existingWikiWord{:href => "/nlab/show/KK-compactification"} KK-compactification
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/11-dimensional+supergravity"} 11-dimensional supergravity
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mrow
                      %mn 8
                      %mo{:stretchy => "false"} (
                      %mn 8
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E_{8(8)}
            is promoted to a local gauge group (
            %a{:href => "#NicolaiSamtleben00"}> Nicolai-Samtleben 00
            ,
            = succeed "))." do
              %a{:href => "#NicolaiSamtleben01"} Nicolai-Samtleben 01, table 1
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/11-dimensional+supergravity"} 11-dimensional supergravity
            = succeed ")" do
              %a{:href => "#NicolaiSamtleben01"} Nicolai-Samtleben 01, section 7
            = succeed ")." do
              %a{:href => "#HohmSamtleben13"} Hohm-Samtleben 13
            = succeed ")" do
              %a{:href => "#deWitNicolai13"} de Wit-Nicolai 13, section 13
            = succeed "-gauge" do
              %a.existingWikiWord{:href => "/nlab/show/U-duality"} U-duality
            %a.existingWikiWord{:href => "/nlab/show/non-perturbative+effect"} non-perturvative
            %a.existingWikiWord{:href => "/nlab/show/electric-magnetic+duality"} dual
            of the
            %a.existingWikiWord{:href => "/nlab/show/graviton"} graviton
            (
            %a.existingWikiWord{:href => "/nlab/show/dual+graviton"}> dual graviton
            ).
