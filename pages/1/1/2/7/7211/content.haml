                        %annotation{:encoding => "application/x-tex"} 3D
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi N
                          %mo =
                          %mn 2
                        %annotation{:encoding => "application/x-tex"} N=2
                    AdS supergravity in superspace
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/1202.0109"} arXiv:1202.0109
            %li
              %p
