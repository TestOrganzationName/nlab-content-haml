          %h2#idea Idea
          %p
            Given any
            %a.existingWikiWord{:href => "/nlab/show/homotopy+commutative+ring+spectrum"} homotopy commutative ring spectrum
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi μ
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E, \mu, e)
            %em Boardman homomorphism
            is the
            %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            from
            %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+groups"} stable homotopy groups
            (hence from
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+homology+theory"} stable homotopy homology theory
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %a.existingWikiWord{:href => "/nlab/show/generalized+homology"} generalized homology
            groups that is induced by
            %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
            with the unit map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                  %mo{:lspace => "verythinmathspace"} :
                  %mi 𝕊
                  %mo ⟶
                  %mi E
                %annotation{:encoding => "application/x-tex"} e \colon \mathbb{S} \longrightarrow E
            from the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi π
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi 𝕊
                  %mo ∧
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %msub
                    %mi π
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo ∧
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi E
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\pi_\bullet(-)
                  \\simeq
                  \\pi_\bullet(\mathbb{S} \wedge (-))
                  \\longrightarrow
                  \\pi_\bullet(E \wedge (-))
                  \=
                  E_\bullet(-)
                  \\,.
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo =
                  %mi H
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} E = H \mathbb{Z}
            the
            %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+spectrum"} Eilenberg-MacLane spectrum
            for
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/ordinary+homology"} ordinary homology
            %a.existingWikiWord{:href => "/nlab/show/Hurewicz+homomorphism"} Hurewicz homomorphism
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_\bullet(-) \to H_\bullet(-)
          %p
            Dually, there is the Boardman homomorphism from
            %a.existingWikiWord{:href => "/nlab/show/stable+cohomotopy"} stable cohomotopy
            to
            %a.existingWikiWord{:href => "/nlab/show/generalized+cohomology"} generalized cohomology
            induced under forming
            %a.existingWikiWord{:href => "/nlab/show/mapping+spectra"} mapping spectra
            into the unit map of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi π
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi π
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi 𝕊
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %msub
                    %mi π
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi E
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msup
                    %mi E
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\pi^\bullet(-)
                  \\simeq
                  \\pi_\bullet([(-),\mathbb{S}])
                  \\longrightarrow
                  \\pi_\bullet([(-),E])
                  \=
                  E^\bullet(-)
                  \\,.
          %p
            Unifying these two cases, there is the bivariant Boardman homomorphism (
            %a{:href => "#Adams74"}> Adams 74, p. 58
            )
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mi Y
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mo •
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mi Y
                  %mo ∧
                  %mi 𝕊
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mo •
                  %mo ⟶
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mi Y
                  %mo ∧
                  %mi E
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mo •
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  [X, Y]_\bullet
                  \\;\simeq\;
                  [X, Y \wedge \mathbb{S}]_\bullet
                  \\longrightarrow
                  [X,Y \wedge E]_\bullet
                  \\,.
          %p
            Since
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/generalized+homology"} generalized homology
            %a.existingWikiWord{:href => "/nlab/show/generalized+cohomology"} generalized cohomology
            is typically more tractable than
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
            %a.existingWikiWord{:href => "/nlab/show/cohomotopy"} cohomotopy
            (in particular when
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/homology+spectra+split"} homology spectra split
          %p
            One example is the computation of the homotopy groups of
            %a.existingWikiWord{:href => "/nlab/show/MU"} MU
            via the
            %a.existingWikiWord{:href => "/nlab/show/homology+of+MU"} homology of MU
            (
            %a.existingWikiWord{:href => "/nlab/show/Quillen%27s+theorem+on+MU"}> Quillen's theorem on MU
            ), see
            = succeed "." do
              %a{:href => "#ForComplexOrientedCohomologyTheories"} below
          %h2#examples Examples
          %h3#in_ordinary_cohomology In ordinary cohomology
          %p
            Consider the
            %a.existingWikiWord{:href => "/nlab/show/unit"} unit
            morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝕊
                  %mo ⟶
                  %mi H
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"}
                  \\mathbb{S} \longrightarrow H \mathbb{Z}
          %p
            from the
            %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
            to the
            %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+spectrum"} Eilenberg-MacLane spectrum
            of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/integers"} integers
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %a.existingWikiWord{:href => "/nlab/show/spectrum"} spectrum
            postcomposition with this morphism induces
            %a.existingWikiWord{:href => "/nlab/show/Boardman+homomorphisms"} Boardman homomorphisms
            of
            %a.existingWikiWord{:href => "/nlab/show/cohomology+groups"} cohomology groups
            (in fact of
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/commutative+rings"} commutative rings
          #eq:BoardmandCohomotopyToOrdinaryCohomology.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi b
                    %mi n
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi π
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %msup
                    %mi H
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  b^n
                  \\;\colon\;
                  \\pi^n(X)
                  \\longrightarrow
                  H^n(X, \mathbb{Z})
          %p
            from the
            %a.existingWikiWord{:href => "/nlab/show/stable+cohomotopy"} stable cohomotopy
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            in degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            to its
            %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
            in degree
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          #BoundsOnCoKernelOfBoardmandFromStableCohomotopyToOrdinaryCohomology.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (bounds on (
                %a.existingWikiWord{:href => "/nlab/show/cokernel"}> co-
                )
                %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
                of
                %a.existingWikiWord{:href => "/nlab/show/Boardman+homomorphism"} Boardman homomorphism
                from
                %a.existingWikiWord{:href => "/nlab/show/stable+cohomotopy"} stable cohomotopy
                to
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/integral+cohomology"} integral cohomology
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a
              %a.existingWikiWord{:href => "/nlab/show/CW-spectrum"} CW-spectrum
              which
            %ol
              %li
                %p
                  is
                  %a.existingWikiWord{:href => "/nlab/show/n-connected+object+of+an+%28infinity%2C1%29-topos"} (m-1)-connected
              %li
                %p
                  of dimension
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mo ∈
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} d \in \mathbb{N}
            %p then
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/Boardman+homomorphism"} Boardman homomorphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi b
                          %mi n
                      %annotation{:encoding => "application/x-tex"} b^n
                  %a.maruku-eqref{:href => "#eq:BoardmandCohomotopyToOrdinaryCohomology"} (1)
                  for
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi m
                        %mo ≤
                        %mi n
                        %mo ≤
                        %mi d
                        %mo −
                        %mn 1
                      %annotation{:encoding => "application/x-tex"}
                        m \leq n\leq d -1
                %p
                  is a
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mover
                              %mi ρ
                              %mo ¯
                            %mrow
                              %mi d
                              %mo −
                              %mi n
                        %annotation{:encoding => "application/x-tex"} \overline{\rho}_{d-n}
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/torsion+subgroup"} torsion group
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mover
                            %mi ρ
                            %mo ¯
                          %mrow
                            %mi d
                            %mo −
                            %mi n
                        %mi ker
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi b
                          %mi n
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo ≃
                        %mspace{:width => "thickmathspace"}
                        %mn 0
                      %annotation{:encoding => "application/x-tex"}
                        \\overline{\rho}_{d-n} ker(b^n) \;\simeq\; 0
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/cokernel"} cokernel
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/Boardman+homomorphism"} Boardman homomorphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi b
                          %mi n
                      %annotation{:encoding => "application/x-tex"} b^n
                  %a.maruku-eqref{:href => "#eq:BoardmandCohomotopyToOrdinaryCohomology"} (1)
                  for
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi m
                        %mo ≤
                        %mi n
                        %mo ≤
                        %mi d
                        %mo −
                        %mn 2
                      %annotation{:encoding => "application/x-tex"}
                        m \leq n  \leq d - 2
                %p
                  is a
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mover
                              %mi ρ
                              %mo ¯
                            %mrow
                              %mi d
                              %mo −
                              %mi n
                              %mo −
                              %mn 1
                        %annotation{:encoding => "application/x-tex"} \overline{\rho}_{d-n-1}
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/torsion+subgroup"} torsion group
                #eq:TorsionEstimateCokernel.maruku-equation
                  %span.maruku-eq-number (2)
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mover
                            %mi ρ
                            %mo ¯
                          %mrow
                            %mi d
                            %mo −
                            %mi n
                            %mo −
                            %mn 1
                        %mi coker
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi b
                          %mi n
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo ≃
                        %mspace{:width => "thickmathspace"}
                        %mn 0
                      %annotation{:encoding => "application/x-tex"}
                        \\overline{\rho}_{d-n-1} coker(b^n) \;\simeq\; 0
            %p where
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi ρ
                        %mo ¯
                      %mi i
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mn 1
                            %mtd
                              %mo{:stretchy => "false"} |
                            %mtd
                              %mi i
                              %mo ≤
                              %mn 1
                          %mtr
                            %mtd
                              %munderover
                                %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                                %mrow
                                  %mi j
                                  %mo =
                                  %mn 1
                                %mi i
                              %mi exp
                              %mrow
                                %mo (
                                %msub
                                  %mi π
                                  %mi j
                                %mrow
                                  %mo (
                                  %mi 𝕊
                                  %mo )
                                %mo )
                            %mtd
                              %mo{:stretchy => "false"} |
                            %mtd
                              %mtext otherwise
                  %annotation{:encoding => "application/x-tex"}
                    \\overline{\rho}_{i}
                    \\;\coloneqq\;
                    \\left\{
                    \\array{
                    1 &amp;\vert&amp; i\leq 1
                    \\\
                    \\underoverset{j = 1}{i}{\prod}
                    exp\left(
                    \\pi_j\left( \mathbb{S}\right)
                    \\right)
                    \&amp;\vert&amp;
                    \\text{otherwise}
                    }
                    \\right.
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/multiplication"} product
              of the
              %a.existingWikiWord{:href => "/nlab/show/exponent+of+a+group"} exponents
              of the
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+groups+of+spheres"} stable homotopy groups of spheres
              in
              %a.existingWikiWord{:href => "/nlab/show/positive+number"} positive
              degree
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ≤
                      %mi i
                    %annotation{:encoding => "application/x-tex"} \leq i
          %p
            (
            %a{:href => "#Arlettaz04"}> Arlettaz 04, theorem 1.2
            )
          #ExampleForEstimatesOfTorsionOfCokernelOfBeta.num_example
            %h6#example Example
            %p
              %strong (estimates for torsion of cokernel of Boardman homomorphism)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
            %ul
              %li
                %p
                  of
                  %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mo =
                        %mn 6
                      %annotation{:encoding => "application/x-tex"} d = 6
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/simply+connected+topological+space"} simply connected
                  with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi π
                          %mn 2
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo ≠
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} \pi_2(X) \neq 0
            %p
              then Prop.
              %a.maruku-ref{:href => "#BoundsOnCoKernelOfBoardmandFromStableCohomotopyToOrdinaryCohomology"}
              asserts that the
              %a.existingWikiWord{:href => "/nlab/show/cokernel"} cokernel
              of the
              %a.existingWikiWord{:href => "/nlab/show/Boardman+homomorphism"} Boardman homomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi β
                      %mn 4
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi 𝕊
                      %mn 4
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mi H
                      %mn 4
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\beta^4
                    \\;\colon\;
                    \\mathbb{S}^4(X)
                    \\longrightarrow
                    H^4( X, \mathbb{Z} )
            %p in
            %ul
              %li
                degree
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo =
                      %mn 4
                    %annotation{:encoding => "application/x-tex"} n = 4
            %p
              is
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/torsion+subgroup"} 2-torsion
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mi coker
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi β
                      %mn 4
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    2 coker(\beta^4) \;=\; 0
                    \\,.
            %p
              This is because in this case
              %a.maruku-eqref{:href => "#eq:TorsionEstimateCokernel"} (2)
              gives that the relevant torsion degree is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mover
                                %mi ρ
                                %mo ¯
                              %mrow
                                %mi d
                                %mo −
                                %mi n
                                %mo −
                                %mn 1
                          %mtd
                            %mo =
                            %msub
                              %mover
                                %mi ρ
                                %mo ¯
                              %mn 1
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi π
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mi 𝕊
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %mi ℤ
                            %mo{:stretchy => "false"} /
                            %mn 2
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\overline{\rho}_{d-n-1}
                    \&amp; =
                    \\overline{\rho}_{1}
                    \\\
                    \&amp; = \exp( \pi_1(\mathbb{S}) )
                    \\\
                    \&amp; = \exp( \mathbb{Z}/2 )
                    \\\
                    \&amp; = 2
                    \\end{aligned}
                    \\,.
            %p
              Similarly, if instead the manifold has dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo =
                    %mn 7
                  %annotation{:encoding => "application/x-tex"} d = 7
              but sticking to degree
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo =
                      %mn 4
                    %annotation{:encoding => "application/x-tex"} n = 4
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/torsion+subgroup"} 4-torsion
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 4
                    %mi coker
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi β
                      %mn 4
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    4 coker(\beta^4) \;=\; 0
                    \\,.
            %p since then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mover
                                %mi ρ
                                %mo ¯
                              %mrow
                                %mi d
                                %mo −
                                %mi n
                                %mo −
                                %mn 1
                          %mtd
                            %mo =
                            %msub
                              %mover
                                %mi ρ
                                %mo ¯
                              %mn 2
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi π
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mi 𝕊
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo ⋅
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi π
                              %mn 2
                            %mo{:stretchy => "false"} (
                            %mi 𝕊
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %mi ℤ
                            %mo{:stretchy => "false"} /
                            %mn 2
                            %mo{:stretchy => "false"} )
                            %mo ⋅
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %mi ℤ
                            %mo{:stretchy => "false"} /
                            %mn 2
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mn 2
                            %mo ⋅
                            %mn 2
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mn 4
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\overline{\rho}_{d-n-1}
                    \&amp; =
                    \\overline{\rho}_{2}
                    \\\
                    \&amp; = \exp( \pi_1(\mathbb{S}) ) \cdot \exp( \pi_2(\mathbb{S}) )
                    \\\
                    \&amp; = \exp( \mathbb{Z}/2 ) \cdot \exp( \mathbb{Z}/2 )
                    \\\
                    \&amp; = 2 \cdot 2
                    \\\
                    \&amp; = 4
                    \\end{aligned}
                    \\,.
            %p
              Next for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo =
                    %mn 8
                  %annotation{:encoding => "application/x-tex"} d = 8
              we
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mover
                                %mi ρ
                                %mo ¯
                              %mrow
                                %mi d
                                %mo −
                                %mi n
                                %mo −
                                %mn 1
                          %mtd
                            %mo =
                            %msub
                              %mover
                                %mi ρ
                                %mo ¯
                              %mn 3
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi π
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mi 𝕊
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo ⋅
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi π
                              %mn 2
                            %mo{:stretchy => "false"} (
                            %mi 𝕊
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo ⋅
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi π
                              %mn 3
                            %mo{:stretchy => "false"} (
                            %mi 𝕊
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %mi ℤ
                            %mo{:stretchy => "false"} /
                            %mn 2
                            %mo{:stretchy => "false"} )
                            %mo ⋅
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %mi ℤ
                            %mo{:stretchy => "false"} /
                            %mn 2
                            %mo{:stretchy => "false"} )
                            %mo ⋅
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %mi ℤ
                            %mo{:stretchy => "false"} /
                            %mn 24
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mn 2
                            %mo ⋅
                            %mn 2
                            %mo ⋅
                            %mn 6
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mn 24
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\overline{\rho}_{d-n-1}
                    \&amp; =
                    \\overline{\rho}_{3}
                    \\\
                    \&amp; =
                    \\exp( \pi_1(\mathbb{S}) )
                    \\cdot \exp( \pi_2(\mathbb{S}) )
                    \\cdot \exp( \pi_3(\mathbb{S}) )
                    \\\
                    \&amp; = \exp( \mathbb{Z}/2 )
                    \\cdot \exp( \mathbb{Z}/2 )
                    \\cdot \exp( \mathbb{Z}/{24} )
                    \\\
                    \&amp; = 2 \cdot 2 \cdot 6
                    \\\
                    \&amp; = 24
                    \\end{aligned}
                    \\,.
          #BoardmanIsoOn7SphereMod2I.num_prop
            %h6#proposition_2 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Boardman+homomorphism"} Boardman
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
                on
                %a.existingWikiWord{:href => "/nlab/show/2-sphere"} 2-sphere
                mod
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/binary+icosahedral+group"} binary icosahedral group
            %p
              Consider the
              %a.existingWikiWord{:href => "/nlab/show/binary+icosahedral+group"} binary icosahedral group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mi I
                  %annotation{:encoding => "application/x-tex"} 2 I
              and its
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              on the
              %a.existingWikiWord{:href => "/nlab/show/7-sphere"} 7-sphere
              induced via the identification
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 7
                    %mo ≃
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi ℍ
                    %mo ×
                    %mi ℍ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S^7 \simeq S(\mathbb{H} \times \mathbb{H})
              from the
              %a.existingWikiWord{:href => "/nlab/show/diagonal+action"} diagonal
              of the canonical action of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mi I
                  %annotation{:encoding => "application/x-tex"} 2I
              on the
              %a.existingWikiWord{:href => "/nlab/show/quaternions"} quaternions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℍ
                  %annotation{:encoding => "application/x-tex"} \mathbb{H}
              induced via it being a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/finite+subgroup+of+SU%282%29"} finite subgroup of SU(2)
            %p
              On the
              %a.existingWikiWord{:href => "/nlab/show/quotient+space"} quotient space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 7
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mi I
                  %annotation{:encoding => "application/x-tex"} S^7/2 I
              the
              %a.existingWikiWord{:href => "/nlab/show/Boardman+homomorphism"} Boardman homomorphism
              in degree 4 is an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝕊
                      %mn 4
                    %mrow
                      %mo (
                      %msup
                        %mi S
                        %mn 7
                      %mo{:stretchy => "false"} /
                      %mn 2
                      %mi I
                      %mo )
                    %munderover
                      %mo ⟶
                      %mo ≃
                      %mi β
                    %msup
                      %mi H
                      %mn 4
                    %mrow
                      %mo (
                      %msup
                        %mi S
                        %mn 7
                      %mo{:stretchy => "false"} /
                      %mn 2
                      %mi I
                      %mo ,
                      %mi ℤ
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{S}^4\left(
                    S^7/2I
                    \\right)
                    \\underoverset{\simeq}{\beta}{\longrightarrow}
                    H^4\left( S^7/2I , \mathbb{Z} \right)
            %p
              from
              %a.existingWikiWord{:href => "/nlab/show/stable+cohomotopy"} stable cohomotopy
              in degree 4 to
              %a.existingWikiWord{:href => "/nlab/show/integral+cohomology"} integral cohomology
              in degree 4.
          .proof
            %h6#proof Proof
            %p
              In terms of the
              %a.existingWikiWord{:href => "/nlab/show/Atiyah-Hirzebruch+spectral+sequence"} Atiyah-Hirzebruch spectral sequence
              for
              %a.existingWikiWord{:href => "/nlab/show/stable+cohomotopy"} stable cohomotopy
              it is sufficient to see that the two differentials
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mn 4
                    %mrow
                      %mo (
                      %msup
                        %mi S
                        %mn 7
                      %mo{:stretchy => "false"} /
                      %mn 2
                      %mi I
                      %mo ,
                      %msubsup
                        %mi π
                        %mi s
                        %mn 0
                      %mo =
                      %msubsup
                        %mi π
                        %mn 0
                        %mi s
                      %mo =
                      %mi ℤ
                      %mo )
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi d
                          %mn 3
                    %msup
                      %mi H
                      %mn 6
                    %mrow
                      %mo (
                      %msup
                        %mi S
                        %mn 7
                      %mo{:stretchy => "false"} /
                      %mn 2
                      %mi I
                      %mo ,
                      %msubsup
                        %mi π
                        %mi s
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo =
                      %msubsup
                        %mi π
                        %mn 1
                        %mi s
                      %mo =
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mn 2
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    H^4\left(
                    S^7/2I, \pi^0_s = \pi^s_0 =\mathbb{Z}
                    \\right)
                    \\overset{d_3}{\longrightarrow}
                    H^6\left(
                    S^7/2I, \pi^{-1}_s = \pi^s_{1} =\mathbb{Z}/2
                    \\right)
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mn 4
                    %mrow
                      %mo (
                      %msup
                        %mi S
                        %mn 7
                      %mo{:stretchy => "false"} /
                      %mn 2
                      %mi I
                      %mo ,
                      %msubsup
                        %mi π
                        %mi s
                        %mn 0
                      %mo =
                      %msubsup
                        %mi π
                        %mn 0
                        %mi s
                      %mo =
                      %mi ℤ
                      %mo )
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi d
                          %mn 3
                    %msup
                      %mi H
                      %mn 7
                    %mrow
                      %mo (
                      %msup
                        %mi S
                        %mn 7
                      %mo{:stretchy => "false"} /
                      %mn 2
                      %mi I
                      %mo ,
                      %msubsup
                        %mi π
                        %mi s
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 2
                      %mo =
                      %msubsup
                        %mi π
                        %mn 2
                        %mi s
                      %mo =
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mn 2
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    H^4\left(
                    S^7/2I, \pi^0_s = \pi^s_0 =\mathbb{Z}
                    \\right)
                    \\overset{d_3}{\longrightarrow}
                    H^7\left(
                    S^7/2I, \pi^{-2}_s = \pi^s_{2} =\mathbb{Z}/2
                    \\right)
            %p
              both vanish (all higher differentials on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mn 4
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %msubsup
                      %mi π
                      %mi s
                      %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^4(-,\pi^0_s)
              vanish simply for dimensional reasons as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 7
                  %annotation{:encoding => "application/x-tex"} S^7
              is of
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              7, while there are no differentials into
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mn 4
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %msubsup
                      %mi π
                      %mi s
                      %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^4(-,\pi^0_s)
              simply because the
              %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/connective+spectrum"} connective
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+groups+of+spheres"} stable homotopy groups of spheres
              vanish in
              %a.existingWikiWord{:href => "/nlab/show/negative+number"} negative
              degree).
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} d_2
              to vanish, it is sufficient that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mn 6
                    %mrow
                      %mo (
                      %msup
                        %mi S
                        %mn 7
                      %mo{:stretchy => "false"} /
                      %mn 2
                      %mi I
                      %mo ,
                      %msubsup
                        %mi π
                        %mi s
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo =
                      %msubsup
                        %mi π
                        %mn 1
                        %mi s
                      %mo =
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mn 2
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    H^6\left(
                    S^7/2I, \pi^{-1}_s = \pi^s_{1} =\mathbb{Z}/2
                    \\right)
                    \\;\simeq\;
                    0
            %p We now first show that this is the case:
            %p
              First, by the
              %a.existingWikiWord{:href => "/nlab/show/Gysin+sequence"} Gysin sequence
              for the
              %a.existingWikiWord{:href => "/nlab/show/spherical+fibration"} spherical fibration
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi S
                              %mn 7
                          %mtd
                            %mo ⟶
                          %mtd
                            %msup
                              %mi S
                              %mn 7
                            %mo{:stretchy => "false"} /
                            %mi SI
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi B
                            %mo{:stretchy => "false"} (
                            %mn 2
                            %mi I
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    S^7 &amp;\longrightarrow&amp; S^7/SI
                    \\\
                    \&amp;&amp; \downarrow
                    \\\
                    \&amp;&amp; B (2 I)
                    }
            %p we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mn 6
                    %mrow
                      %mo (
                      %msup
                        %mi S
                        %mn 7
                      %mo{:stretchy => "false"} /
                      %mn 2
                      %mi I
                      %mo ,
                      %mspace{:width => "thinmathspace"}
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mn 2
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi H
                      %mn 6
                    %mrow
                      %mo (
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mi I
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mspace{:width => "thinmathspace"}
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mn 2
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    H^6\left(
                    S^7/2I, \, \mathbb{Z}/2
                    \\right)
                    \\;\simeq\;
                    H^6\left(
                    B(2I),\, \mathbb{Z}/2
                    \\right)
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi I
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo *
                    %mo ⫽
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi I
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B (2 I) \simeq \ast \sslash (2I)
              is the
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mi I
                  %annotation{:encoding => "application/x-tex"} 2I
              (see e.g. at
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/infinity-action"} infinity-action
            %p
              Moreover, by the
              %a.existingWikiWord{:href => "/nlab/show/universal+coefficient+theorem"} universal coefficient theorem
              (
              %a{:href => "universal+coefficient+theorem#OrdinaryStatementInTopology"}> this Prop.
              ) we have a
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msup
                      %mi Ext
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi H
                      %mn 5
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi I
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo ⟶
                    %msup
                      %mi H
                      %mn 6
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi I
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo ⟶
                    %msub
                      %mi Hom
                      %mi Ab
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi H
                      %mn 6
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi I
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo →
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    0
                    \\to
                    Ext^1(H_{5}\big(B(2I), \mathbb{Z}), \mathbb{Z}/2\big)
                    \\longrightarrow
                    H^6\big(B(2I), \mathbb{Z}/2\big)
                    \\longrightarrow
                    Hom_{Ab}\big( H_6( B(2I), \mathbb{Z}) , \mathbb{Z}/2 \big)
                    \\to
                    0
                    \\,.
            %p This means that it is sufficient to see that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mn 5
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi I
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mn 0
                    %mphantom
                      %mi AAA
                    %msub
                      %mi H
                      %mn 6
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi I
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    H_{5}\big(B(2I), \mathbb{Z}) \simeq 0
                    \\phantom{AAA}
                    H_{6}\big(B(2I), \mathbb{Z}) \simeq 0
            %p
              But for every
              %a.existingWikiWord{:href => "/nlab/show/finite+subgroup+of+SU%282%29"} finite subgroup of SU(2)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mi ADE
                    %mo ⊂
                    %mi SU
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G_{ADE} \subset SU(2)
              we have (by
              = succeed ")" do
                %a{:href => "https://ncatlab.org/nlab/show/finite+rotation+group#GroupCohomologyOfFiniteSubgroupsOfSU2"} this Prop.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mn 5
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi I
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msubsup
                      %mi G
                      %mi ADE
                      %mi ab
                    %mphantom
                      %mi AAA
                    %msub
                      %mi H
                      %mn 6
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi I
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    H_{5}\big(B(2I), \mathbb{Z}) \simeq G^{ab}_{ADE}
                    \\phantom{AAA}
                    H_{6}\big(B(2I), \mathbb{Z}) \simeq 0
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi G
                      %mi ADE
                      %mi ab
                  %annotation{:encoding => "application/x-tex"} G^{ab}_{ADE}
              is the
              %a.existingWikiWord{:href => "/nlab/show/abelianization"} abelianization
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi G
                        %mi ADE
                    %annotation{:encoding => "application/x-tex"} G_{ADE}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mi ADE
                    %mo =
                    %mn 2
                    %mi I
                  %annotation{:encoding => "application/x-tex"} G_{ADE} = 2I
              this does vanish: the
              %a.existingWikiWord{:href => "/nlab/show/binary+icosahedral+group"} binary icosahedral group
              is a
              %a.existingWikiWord{:href => "/nlab/show/perfect+group"} perfect group
              (
              %a{:href => "icosahedral+group#2IIsPerfect"}> this Prop.
              ).
            %p
              This shows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} d_2
              vanishes on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi H
                        %mn 4
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %msup
                        %mi π
                        %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} H^4(-, \pi^0)
            %p
              Now by a standard argument, the AHSS-differentials between ordinary cohomology groups are stable
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cohomology+operations"} cohomology operations
              %a.existingWikiWord{:href => "/nlab/show/Steenrod+operations"} Steenrod operations
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Sq
                      %mi n
                  %annotation{:encoding => "application/x-tex"} Sq^n
              (e.g.
              = succeed "," do
                %a{:href => "https://mathgroove.wordpress.com/2016/11/30/filling-the-details-5-two-words-about-the-atiyah-hirzebruch-spectral-sequence/"} here
            %p
              This means first of all that if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} d_2
              is not trivial then
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mn 2
                      %mo =
                      %msup
                        %mi Sq
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} d_2 = Sq^2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mn 4
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %msup
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^4(-,\pi^0)
              by the above argument, and on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mn 7
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %msup
                      %mi π
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^7(-,\pi^2)
              for dimension reasons, so that the relevant entries pass as ordinary cohomology groups to the third page of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/spectral+sequence"} spectral sequence
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mn 3
                      %mo =
                      %msup
                        %mi Sq
                        %mn 3
                    %annotation{:encoding => "application/x-tex"} d_3 = Sq^3
            %p
              But by the
              %a.existingWikiWord{:href => "/nlab/show/Adem+relation"} Adem relation
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Sq
                        %mn 3
                      %mo =
                      %msup
                        %mi Sq
                        %mn 1
                      %mo ∘
                      %msup
                        %mi Sq
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} Sq^3 = Sq^1 \circ Sq^2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Sq
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} Sq_2
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
