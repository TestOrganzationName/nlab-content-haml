                    %mrow
                      %mi j
                      %mo ∈
                      %mi S
                  %msub
                    %mi X
                    %mi j
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\bigotimes_{i\in F} X_i \to \bigotimes_{j\in S} X_j ,
          %p
