              %semantics
                %mrow
                  %msub
                    %mi X
                    %mi i
                %annotation{:encoding => "application/x-tex"} X_i
            and their projections, with the arrows in the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
