          %h2#definition Definition
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/special+unitary+group"} special unitary group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SU
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SU(n)
            for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} n = 2
          .num_prop
            %h6#proposition Proposition
            %p
              As a
              %a.existingWikiWord{:href => "/nlab/show/matrix+group"} matrix group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SU
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SU(2)
              is equivalent to the subgroup of the
              %a.existingWikiWord{:href => "/nlab/show/general+linear+group"} general linear group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo ,
                    %mi ℂ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} GL(2, \mathbb{C})
              on those of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi u
                            %mtd
                              %mi v
                          %mtr
                            %mtd
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mover
                                %mi v
                                %mo ¯
                            %mtd
                              %mover
                                %mi u
                                %mo ¯
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi with
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi u
                        %mo{:stretchy => "false"} |
                      %mn 2
                    %mo +
                    %msup
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi v
                        %mo{:stretchy => "false"} |
                      %mn 2
                    %mo =
                    %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    \\array{
                    u &amp; v
                    \\\
                    \- \overline{v} &amp; \overline{u}
                    }
                    \\right)
                    \\;\;\;
                    with
                    \\;\;
                    {\vert u\vert}^2 + {\vert v\vert}^2 = 1
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo ,
                    %mi v
                    %mo ∈
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} u,v \in \mathbb{C}
              are
              %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"} \overline{(-)}
              denotes
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/complex+conjugation"} complex conjugation
          %h2#properties Properties
          %h3#general General
          .num_prop
            %h6#proposition_2 Proposition
            %p
              The underlying
              %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SU
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SU(2)
              is
              %a.existingWikiWord{:href => "/nlab/show/diffeomorphism"} diffeomorphic
              to the 3-
              %a.existingWikiWord{:href => "/nlab/show/sphere"} sphere
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mn 3
                    %annotation{:encoding => "application/x-tex"} S^3
          #ExceptionalIsomorphismOfSU2ToSpin3AndSp1.num_prop
            %h6#proposition_3 Proposition
            %p
              There are
              %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
              of
              %a.existingWikiWord{:href => "/nlab/show/Lie+groups"} Lie groups
            %ol
              %li
                %p
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi SU
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} SU(2)
                  with the
                  %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin group
                  in
                  %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
                  3 and with the
                  %a.existingWikiWord{:href => "/nlab/show/quaternionic+unitary+group"} quaternionic unitary group
                  in one dimension
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi SU
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo ≃
                        %mspace{:width => "thickmathspace"}
                        %mi Spin
                        %mo{:stretchy => "false"} (
                        %mn 3
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo ≃
                        %mspace{:width => "thickmathspace"}
                        %mi Sp
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        SU(2)
                        \\;\simeq\;
                        Spin(3)
                        \\;\simeq\;
                        Sp(1)
              %li
                %p
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/direct+product+group"} direct product group
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi SU
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} SU(2)
                  with itself, to
                  %a.existingWikiWord{:href => "/nlab/show/Spin%284%29"} Spin(4)
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi SU
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo{:stretchy => "false"} )
                        %mo ×
                        %mi SU
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo ≃
                        %mspace{:width => "thickmathspace"}
                        %mi Spin
                        %mo{:stretchy => "false"} (
                        %mn 3
                        %mo{:stretchy => "false"} )
                        %mo ×
                        %mi Spin
                        %mo{:stretchy => "false"} (
                        %mn 3
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo ≃
                        %mspace{:width => "thickmathspace"}
                        %mi Spin
                        %mo{:stretchy => "false"} (
                        %mn 4
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        SU(2) \times SU(2)
                        \\;\simeq\;
                        Spin(3) \times Spin(3)
                        \\;\simeq\;
                        Spin(4)
                %p
                  with respect to which the canonical inclusion
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Spin
                        %mo{:stretchy => "false"} (
                        %mn 3
                        %mo{:stretchy => "false"} )
                        %mo ↪
                        %mi Spin
                        %mo{:stretchy => "false"} (
                        %mn 4
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Spin(3) \hookrightarrow Spin(4)
                  is given by the
                  %a.existingWikiWord{:href => "/nlab/show/diagonal"} diagonal
                  map.
          %p
            See at
            = succeed "." do
              %em
                %a{:href => "spin%20group#ExceptionalIsomorphisms"} spin group – Exceptional isomorphisms
          .num_prop
            %h6#proposition_4 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/maximal+torus"} maximal torus
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SU
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SU(2)
              is the
              %a.existingWikiWord{:href => "/nlab/show/circle+group"} circle group
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U(1)
              %a.existingWikiWord{:href => "/nlab/show/matrix+group"} matrix group
              presentation this is naturally identified with the subgroup of matrices of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi t
                            %mtd
                              %mn 0
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %msup
                                %mi t
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mn 1
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi with
                    %mi t
                    %mo ∈
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi ℂ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    \\array{
                    t &amp; 0
                    \\\
