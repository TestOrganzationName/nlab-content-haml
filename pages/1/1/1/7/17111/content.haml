                    %mn 3
                    %mo ⋅
                    %mstyle{:mathvariant => "bold"}
                      %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo ⊕
                    %mspace{:width => "thickmathspace"}
                    %mn 1
                    %mo ⋅
                    %mstyle{:mathvariant => "bold"}
                      %mn 3
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi{:mathvariant => "normal"} RO
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} Sp
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\wedge^2 \mathbf{4}
                    \\;\simeq\;
                    3 \cdot \mathbf{1}
                    \\;\oplus\;
                    1 \cdot \mathbf{3}
                    \\;\;\;\in\;
                    \\mathrm{RO}(\mathrm{Sp}(1))
          .proof
            %h6#proof Proof
            %p
              Consider the canonical
              %a.existingWikiWord{:href => "/nlab/show/linear+basis"} linear basis
