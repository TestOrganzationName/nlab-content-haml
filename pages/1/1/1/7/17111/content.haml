          #4Wedge4SpSp1Is3TimesTrivialPlusThree.num_lemma
            %h6#lemma Lemma
            %p We have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
