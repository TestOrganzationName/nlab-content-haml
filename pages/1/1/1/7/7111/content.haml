          %h2#idea Idea
          %p
            %strong Berkovich analytic spaces
            are a version of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/analytic+space"} analytic space
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/nonarchimedean+fields"} nonarchimedean fields
            %em rigid analytic spaces
            (see
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/rigid+analytic+geometry"} rigid analytic geometry
            %a.existingWikiWord{:href => "/nlab/show/maximal+spectra"} maximal spectra
            of Tate algebras glued via the
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topology"} Grothendieck
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/G-topology"} G-topology
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            equipped with a cover by
            %a.existingWikiWord{:href => "/nlab/show/affinoid+domains"} affinoid domains
            via the
            %a.existingWikiWord{:href => "/nlab/show/analytic+spectrum"} analytic spectrum
            construction, due to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Vladimir+Berkovich"} Vladimir Berkovich
            %a.existingWikiWord{:href => "/nlab/show/Huber%27s+adic+spaces"} Huber's adic spaces
            which may also contain valuations of higher order).
          %p
            For more background see
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/analytic+geometry"} analytic geometry
          %h2#definition_of_berkovich_analytic_spaces Definition of Berkovich analytic spaces
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/non-archimedean+field"} non-archimedean field
          .num_defn
            %h6#definition Definition
            %p
              Given
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              and positive elements
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi r
                        %mn 1
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %msub
                        %mi r
                        %mi n
                      %mo ∈
                      %mi k
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{r_1, \cdots, r_n \in k\}
              %a.existingWikiWord{:href => "/nlab/show/power+series"} power series
              %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} algebra
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              of those series which
              %a.existingWikiWord{:href => "/nlab/show/convergence"} converge
              inside the radii
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi k
                        %mi i
                    %annotation{:encoding => "application/x-tex"} k_i
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mfrac
                      %mn 1
                      %mrow
                        %msub
                          %mi r
                          %mn 1
                    %msub
                      %mi T
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mfrac
                      %mn 1
                      %mrow
                        %msub
                          %mi r
                          %mi n
                    %msub
                      %mi T
                      %mi n
                    %mo{:stretchy => "false"} }
                    %mo :
                    %mo =
                    %mrow
                      %mo {
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mi ν
                      %msub
                        %mi a
                        %mi ν
                      %msup
                        %mi T
                        %mi ν
                      %mo{:stretchy => "false"} |
                      %munder
                        %mi lim
                        %mrow
                          %mrow
                            %mo{:stretchy => "false"} |
                            %mi ν
                            %mo{:stretchy => "false"} |
                          %mo →
                          %mn ∞
                      %mrow
                        %mo{:stretchy => "false"} |
                        %msub
                          %mi a
                          %mi ν
                        %mo{:stretchy => "false"} |
                      %msup
                        %mi r
                        %mi ν
                      %mo =
                      %mn 0
                      %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\{\frac{1}{r_1} T_1 , \cdots, \frac{1}{r_n}T_n\}
                    \:=
                    \\left\{
                    \\sum_\nu a_\nu T^\nu | \lim_{{\vert \nu\vert} \to \infty} {\vert a_\nu \vert} r^\nu = 0
                    \\right\}
                    \\,.
            %p
              This is a commutative
              %a.existingWikiWord{:href => "/nlab/show/Banach+algebra"} Banach algebra
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              with
              %a.existingWikiWord{:href => "/nlab/show/norm"} norm
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} ‖
                        %mi f
                        %mo{:stretchy => "false"} ‖
                      %mo =
                      %mi max
                      %mrow
                        %mo{:stretchy => "false"} |
                        %msub
                          %mi a
                          %mi ν
                        %mo{:stretchy => "false"} |
                      %msup
                        %mi r
                        %mi ν
                    %annotation{:encoding => "application/x-tex"} {\Vert f \Vert} = max {\vert a_\nu\vert} r^\nu
            %p
              A
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
                \-
                %a.existingWikiWord{:href => "/nlab/show/affinoid+algebra"} affinoid algebra
              is a commutative Banach
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              for which there exists
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi r
                      %mi i
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{r_i\}
              as above and an
              %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mfrac
                      %mn 1
                      %mrow
                        %msub
                          %mi r
                          %mn 1
                    %msub
                      %mi T
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mfrac
                      %mn 1
                      %mrow
                        %msub
                          %mi r
                          %mi n
                    %msub
                      %mi T
                      %mi n
                    %mo{:stretchy => "false"} }
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    \\{\frac{1}{r_1} T_1 , \cdots, \frac{1}{r_n}T_n\}
                    \\to
                    A
            %p
              such that the
              %a.existingWikiWord{:href => "/nlab/show/norm"} norm
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/quotient+norm"} quotient norm
            %p
              If one can choose here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi r
                      %mi i
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} r_i = 1
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is called
              = succeed "." do
                %strong
                  strictly
                  = succeed "-affinoid" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                        %annotation{:encoding => "application/x-tex"} k
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              of
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
                \-
                %a.existingWikiWord{:href => "/nlab/show/affinoid+spaces"} affinoid spaces
              is the
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
              of the category of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %a.existingWikiWord{:href => "/nlab/show/affinoid+algebras"} affinoid algebras
              and bounded
              %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
              between them.
          %p
            Via the
            %a.existingWikiWord{:href => "/nlab/show/analytic+spectrum"} analytic spectrum
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Spec
                    %mi an
                %annotation{:encoding => "application/x-tex"} Spec_{an}
            there is a
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            associated with any
            = succeed "-affinoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "." do
              %em the analytic space
          .num_defn
            %h6#definition_2 Definition
            %p
              An
              %strong
                %a.existingWikiWord{:href => "/nlab/show/affinoid+domain"} affinoid domain
              in an
              %a.existingWikiWord{:href => "/nlab/show/affinoid+space"} affinoid space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %msub
                      %mi Spec
                      %mi an
                    %mi A
                  %annotation{:encoding => "application/x-tex"} X = Spec_{an} A
              is a
              %a.existingWikiWord{:href => "/nlab/show/closed+subset"} closed subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} V \subset X
              such that there is a
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of
              = succeed "-affinoid" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo :
                    %msub
                      %mi Spec
                      %mi an
                    %msub
                      %mi A
                      %mi V
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\phi : Spec_{an} A_V \to X
            %p
              for some
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mi V
                    %annotation{:encoding => "application/x-tex"} A_V
              %a.existingWikiWord{:href => "/nlab/show/image"} image
              is
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              = succeed "-affinoid" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              whose image is contained in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              uniquely factors through this morphism.
          .num_defn
            %h6#definition_3 Definition
            %p
              A
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
                \-analytic space
              is a
              %a.existingWikiWord{:href => "/nlab/show/locally+Hausdorff+topological+space"} locally Hausdorff
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              equipped with an
              %a.existingWikiWord{:href => "/nlab/show/atlas"} atlas
              by
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %a.existingWikiWord{:href => "/nlab/show/affinoid+domains"} affinoid domains
              and
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/affinoid+domain+embeddings"} affinoid domain embeddings
              %a.existingWikiWord{:href => "/nlab/show/analytic+spectra"} analytic spectra
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              form a
              %a.existingWikiWord{:href => "/nlab/show/quasinet"} net
              of
              %a.existingWikiWord{:href => "/nlab/show/compact+subsets"} compact subsets
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          %p
            (
            %a{:href => "#Berkovich09"}> Berkovich 09, def. 3.1.4
            )
          %h2#properties Properties
          %h3#Cohomology Cohomology
          %p
            Under some mild conditions, the algebraic and the analytic
            %a.existingWikiWord{:href => "/nlab/show/%C3%A9tale+cohomology"} étale cohomology
            of Berkovich spaces agree. (
            %a{:href => "#Berkovich95"}> Berkovich 95
            )
          %p
            The underlying
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mi an
                %annotation{:encoding => "application/x-tex"} X^{an}
            given by the
            %a.existingWikiWord{:href => "/nlab/show/Berkovich+analytic+spectrum"} Berkovich analytic spectrum
            has as
            %a.existingWikiWord{:href => "/nlab/show/singular+cohomology"} singular cohomology
            the
            = succeed "-cohomology" do
              %a.existingWikiWord{:href => "/nlab/show/weight+filtration"} weight 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            (
            %a{:href => "#Berkovich09"}> Berkovich 09
            ).
          %p
            See also MO discussion
            = succeed "." do
              %a{:href => "http://mathoverflow.net/a/171653/381"} here
          %h3#LocalContractibility Local contractibility
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/complex+analytic+manifold"} complex analytic manifold
            and a
            %em smooth
            %a.existingWikiWord{:href => "/nlab/show/complex+analytic+space"} complex analytic space
            is locally isomorphic to a
            %a.existingWikiWord{:href => "/nlab/show/polydisk"} polydisk
            and hence is trivially a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/locally+contractible+space"} locally contractible space
            %a.existingWikiWord{:href => "/nlab/show/non-archimedean+field"} non-archimedean field
            analytic spaces no longer need to be locally isomorphic to polydisks (but
            = succeed "-adic" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed "))." do
              %a{:href => "#Berkovich90"} Berkovich 90
          %p
            Assume that the
            %a.existingWikiWord{:href => "/nlab/show/valuation"} valuation
            on the ground field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            is nontrivial.
          #LocallyEmbeddableInASmoothSpace.num_defn
            %h6#definition_4 Definition
            %p
              A
              = succeed "-analytic" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is called
              %em locally embeddable in a smooth space
              if each point of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              has an
              %a.existingWikiWord{:href => "/nlab/show/open+neighbourhood"} open neighbourhood
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
              to a strictly
              = succeed "-analytic" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "-analytic" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
          .num_theorem
            %h6#theorem Theorem
            %p
              Every
              = succeed "-analytic" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "," do
                %a.maruku-ref{:href => "#LocallyEmbeddableInASmoothSpace"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/locally+contractible+space"} locally contractible space
            %p
              More precisely, every point of a locally smooth
              = succeed "-analytic" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              which is contractible, and which is a
              %a.existingWikiWord{:href => "/nlab/show/union"} union
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo =
                    %msubsup
                      %mo ∪
                      %mrow
                        %mi i
                        %mo =
                        %mn 1
                      %mn ∞
                    %msub
                      %mi U
                      %mi i
                  %annotation{:encoding => "application/x-tex"} U = \cup_{i = 1}^\infty U_i
              of analytic domains.
          %p
            The local contractibility is
            = succeed "." do
              %a{:href => "#BerkovichContractible"} Berkovich (1999), theorem 9.1
            = succeed "." do
              %a{:href => "#BerkovichContractibleII"} Berkovich (2004)
          %h2#examples Examples
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/analytic+affine+line"} analytic affine line
          %h2#applications Applications
          %ul
            %li
              The proof of the
              %a.existingWikiWord{:href => "/nlab/show/local+Langlands+conjecture"} local Langlands conjecture
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi GL
                      %mi n
                  %annotation{:encoding => "application/x-tex"} GL_n
              by Harris–Taylor uses
              %a.existingWikiWord{:href => "/nlab/show/%C3%A9tale+cohomology"} étale cohomology
              on non-archimedean analytic spaces (in the sense of Berkovich) to construct the required Galois representations over local fields.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/non-commutative+analytic+space"} non-commutative analytic space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/p-adic+geometry"} p-adic geometry
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/G-topology"} G-topology
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Huber+space"}> Huber space
                ,
                %a.existingWikiWord{:href => "/nlab/show/perfectoid+space"} perfectoid space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/global+analytic+geometry"} global analytic geometry
          %h2#references References
          %h3#introductions_and_reviews Introductions and reviews
          %p A nice survey is in
          %ul
            %li#LeStum12
              %a.existingWikiWord{:href => "/nlab/show/Bernard+Le+Stum"}> Bernard Le Stum
              ,
              = succeed "," do
                %em
                  One century of
                  = succeed "-adic" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi p
                        %annotation{:encoding => "application/x-tex"} p
              = succeed ")" do
                %a{:href => "http://www-irma.u-strasbg.fr/IMG/pdf/NotesCoursLeStum.pdf"} pdf
          %p A good introduction to the general idea is at the beginning of
          %ul
            %li#Payne13
              %a.existingWikiWord{:href => "/nlab/show/Sam+Payne"}> Sam Payne
              ,
              %em Topology of nonarchimedean analytic spaces and relations to complex algebraic geometry
              (
              %a{:href => "http://arxiv.org/abs/1309.4403"}> arXiv:1309.4403
              )
          %p Basic notions are listed in
          %ul
            %li
              M. Temkin,
              %em Non-archimedean analytic spaces
              (
              %a{:href => "http://www.math.huji.ac.il/~temkin/lectures/Non-Archimedean_Analytic_Spaces.pdf"}> pdf slides
              )
          %p
            A review of basic definitions and facts about affinoid and rigid
            = succeed "-analytic" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          %ul
            %li
              Gaëtan Chenevier,
              %em lecture 5
              (
              %a{:href => "http://www.math.polytechnique.fr/~chenevier/coursIHP/chenevier_lecture5.pdf"}> pdf
              )
          %p
            See also the references at
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/rigid+analytic+geometry"} rigid analytic geometry
          %p
            A review of definitions and results on
            = succeed "-analytic" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          %ul
            %li#Berkovich98
              %a.existingWikiWord{:href => "/nlab/show/Vladimir+Berkovich"}> Vladimir Berkovich
              ,
              = succeed "," do
                %em
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
                  \-Adic analytic spaces
              = succeed ")" do
                %a{:href => "http://www.wisdom.weizmann.ac.il/~vova/ICM98_1998.pdf"} pdf
          %p A more detailed set of lecture notes along these lines is
          %ul
            %li#Berkovich09
              %a.existingWikiWord{:href => "/nlab/show/Vladimir+Berkovich"}> Vladimir Berkovich
              ,
              = succeed "," do
                %em Non-archimedean analytic spaces
              = succeed "," do
                %em
                  Advanced School on
                  = succeed "-adic" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi p
                        %annotation{:encoding => "application/x-tex"} p
              = succeed ")" do
                %a{:href => "http://www.wisdom.weizmann.ac.il/~vova/Trieste_2009.pdf"} pdf
          %p
            Introductory exposition of the Berkovich
            %a.existingWikiWord{:href => "/nlab/show/analytic+spectrum"} analytic spectrum
            is
          %ul
            %li#Poineau07
              %p
                %a.existingWikiWord{:href => "/nlab/show/J%C3%A9r%C3%B4me+Poineau"}> Jérôme Poineau
                ,
                = succeed "," do
                  %em Global analytic geometry
                = succeed ")" do
                  %a{:href => "http://www.ems-ph.org/journals/newsletter/pdf/2007-09-65.pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Fr%C3%A9d%C3%A9ric+Paugam"}> Frédéric Paugam
                , section 2.1.4 of_Global analytic geometry and the functional equation_ (2010) (
                %a{:href => "http://www.math.jussieu.fr/~fpaugam/documents/enseignement/master-global-analytic-geometry.pdf"}> pdf
                )
          %p A exposition of examples of Berkovich spectra is in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Scott+Carnahan"}> Scott Carnahan
              ,
              %em Berkovich spaces I
              (
              %a{:href => "http://sbseminar.wordpress.com/2007/09/18/berkovich-spaces-i/"}> web
              )
          %h3#original_articles Original articles
          %ul
            %li
              %p#Berkovich90
                %a.existingWikiWord{:href => "/nlab/show/Vladimir+Berkovich"}> Vladimir Berkovich
                ,
                = succeed "," do
                  %em Spectral theory and analytic geometry over non-Archimedean fields
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Vladimir+Berkovich"}> Vladimir Berkovich
                ,
                = succeed "," do
                  %em Étale cohomology for non-Archimedean analytic spaces
          %p Discussion of Berkovich09cohomology of Berkovich analytic spaces includes
          %ul
            %li#Berkovich95
              %p
                %a.existingWikiWord{:href => "/nlab/show/Vladimir+Berkovich"}> Vladimir Berkovich
                ,
                %em On the comparison theorem for étale cohomology of non-Archimedean analytic spaces.
                Israel Journal of Mathematics 92.1-3 (1995): 45-59.
            %li#Berkovich09
              %p
                %a.existingWikiWord{:href => "/nlab/show/Vladimir+Berkovich"}> Vladimir Berkovich
                ,
                = succeed "," do
                  %em A non-Archimedean interpretation of the weight zero subspaces of limit mixed Hodge structures
          %p
            Discussion of local contractibility of smooth
            = succeed "-analytic" do
