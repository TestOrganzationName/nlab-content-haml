          %h2#idea Idea
          %p
            The
            %em Brauer induction theorem
            (
            %a{:href => "#Brauer46"}> Brauer 1946
            ) states that, for
            %a.existingWikiWord{:href => "/nlab/show/ground+field"} ground field
            the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
            %a.existingWikiWord{:href => "/nlab/show/finite+dimensional+vector+space"} finite-dimensional
            %a.existingWikiWord{:href => "/nlab/show/linear+representations"} linear representations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            of a
            %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            all arise as
            %a.existingWikiWord{:href => "/nlab/show/virtual+representation"} virtual combinations
            of
            %a.existingWikiWord{:href => "/nlab/show/induced+representations"} induced representations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi ind
                    %mi H
                    %mi G
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi W
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"} ind_{H}^G \big(W\big)
            of just 1-dimensional representations
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi dim
                      %mi ℂ
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} dim_{\mathbb{C}}(W) =1
          #eq:GenericExampleOfBrauerInduction.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi V
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mpadded{:lspace => "-50%width", :width => "0"}
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mrow
                            %msub
                              %mi H
                              %mi i
                            %mo ↪
                            %mi G
                        %mrow
                          %mfrac{:linethickness => "0"}
                            %mrow
                              %mrow
                                %msub
                                  %mi W
                                  %mi i
                                %mo ∈
                                %mi Rep
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi H
                                  %mi i
                                %mo{:stretchy => "false"} )
                                %mspace{:width => "thinmathspace"}
                                %mo ,
                            %mrow
                              %mrow
                                %mi dim
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi W
                                  %mi i
                                %mo{:stretchy => "false"} )
                                %mo =
                                %mn 1
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi n
                    %mi i
                  %mspace{:width => "thinmathspace"}
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} [
                  %msubsup
                    %mi ind
                    %mrow
                      %msub
                        %mi H
                        %mi i
                    %mi G
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msub
                    %mi W
                    %mi i
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                  %mphantom
                    %mi AAA
                  %msub
                    %mi n
                    %mi i
                  %mo ∈
                  %mi ℤ
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  [V]
                  \\;=\;
                  \\underset{
                  \\mathclap{
                  {
                  H_i \hookrightarrow G
                  }
                  \\atop
                  {
                  {W_i \in Rep(H_i)\,,}
                  \\atop
                  { dim(W_i) = 1 }
                  }
                  }
                  }{\sum}
                  \\,
                  n_i
                  \\,
                  \\Big[
                  ind_{H_i}^G \big(W_i\big)
                  \\Big]
                  \\,,
                  \\phantom{AAA}
                  n_i \in \mathbb{Z}
                  \\,.
          %p
            In other words, this says that the
            %a.existingWikiWord{:href => "/nlab/show/representation+ring"} representation ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi R
                    %mi ℂ
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} R_{\mathbb{C}}(G)
            is generated from
            %a.existingWikiWord{:href => "/nlab/show/isomorphism+classes"} isomorphism classes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo [
                    %msubsup
                      %mi ind
                      %mi H
                      %mi G
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi W
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo ]
                %annotation{:encoding => "application/x-tex"} \left[ind_{H}^G \big(W\big)\right]
            of
            %a.existingWikiWord{:href => "/nlab/show/induced+representations"} induced representations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi ind
                    %mi H
                    %mi G
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi W
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"} ind_{H}^G \big(W\big)
            of 1-dimensional representations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                %annotation{:encoding => "application/x-tex"} W
            of
            %a.existingWikiWord{:href => "/nlab/show/subgroups"} subgroups
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo ⊂
                    %mi G
                  %annotation{:encoding => "application/x-tex"} H \subset G
          %p
            This may be thought of as (implying) a
            %a.existingWikiWord{:href => "/nlab/show/splitting+principle"} splitting principle
            for
            %a.existingWikiWord{:href => "/nlab/show/linear+representations"} linear representations
            (
            %a{:href => "#Symonds91"}> Symonds 91
            ), for more on this see at
            %em
              %a.existingWikiWord{:href => "/nlab/show/characteristic+classes+of+linear+representations"} characteristic classes of linear representations
            the section
            = succeed "." do
              %em
                %a{:href => "characteristic+class+of+a+linear+representation#SplittingPrinciple"} splitting principle
          %p
            Brauer induction generalizes the immediate statement that
            %a.existingWikiWord{:href => "/nlab/show/finite+dimensional+vector+space"} finite-dimensional
            %a.existingWikiWord{:href => "/nlab/show/permutation+representations"} permutation representations
            are all
            %a.existingWikiWord{:href => "/nlab/show/direct+sums"} direct sums
            of
            %a.existingWikiWord{:href => "/nlab/show/induced+representations"} induced representations
            of the
            %em
              %a.existingWikiWord{:href => "/nlab/show/trivial+representation"} trivial
            1-dimensional representation; see at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/induced+representation+of+the+trivial+representation"} induced representation of the trivial representation
          %p
            The analogous statement holds true also for
            %a.existingWikiWord{:href => "/nlab/show/ground+ring"} ground ring
            the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quaternions"} quaternions
            %a.existingWikiWord{:href => "/nlab/show/ground+field"} ground field
            the
            %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
            one has to induce not just from 1-dimensional but also from 2-dimensional representations.
          %p
            Of course, the expansions
            %a.maruku-eqref{:href => "#eq:GenericExampleOfBrauerInduction"} (1)
            are not unique. But one may find
            %a.existingWikiWord{:href => "/nlab/show/functor"} functorial
            choices that satisfy good extra properties, see below at
            %em
              %a{:href => "#SnaithExpansion"} Snaith’s explicit Brauer induction
            and
            = succeed "." do
              %em
                %a{:href => "#SymondExplicitBrauerInduction"} Symond’s explicit Brauer induction
          %p
            We may also restrict the collection of subgroups needed. For example, in the representation ring of a finite group
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/elementary+subgroups"} elementary subgroups
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi p
                    %mi n
                %annotation{:encoding => "application/x-tex"} p^n
            times a cyclic group whose order is relatively prime to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %a.existingWikiWord{:href => "/nlab/show/Artin+induction+theorem"} Artin induction theorem
            saying that every element of the representation ring of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is a
            %em rational
            linear combination of elements induced from
            %em cyclic
            subgroups of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %p
            %br/
          %h2#properties Properties
          %h3#SnaithExpansion Snaith’s explicit Brauer induction
          %p (…)
          %h3#SymondExplicitBrauerInduction Symonds’ explicit Brauer induction
          %p
            We state an explicit and
            %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural
            choice of Brauer induction due to
            %a{:href => "#Symonds91"} Symonds 91
            (Prop.
            = succeed ")" do
              %a.maruku-ref{:href => "#SymondsExplicitBrauerInd"}
            %a.existingWikiWord{:href => "/nlab/show/total+Chern+classes+of+linear+representations"} total Chern classes of linear representations
            via a certain multiplicative transfer map on
            %a.existingWikiWord{:href => "/nlab/show/integral+cohomology"} integral cohomology
            (the latter recalled as Lemma
            %a.maruku-ref{:href => "#TransferEvens"}
            below).
          #TransferEvens.num_lemma
            %h6#lemma Lemma
            %p
              %strong (Evens’ multiplicative transfer)
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              a
              %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite group
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo ⊂
                    %mi G
                  %annotation{:encoding => "application/x-tex"} H \subset G
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
              %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi 𝒩
                      %mi H
                      %mi G
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi k
                        %mo ∈
                        %mi ℕ
                    %msup
                      %mi H
                      %mrow
                        %mn 2
                        %mi k
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi B
                    %mi H
                    %mo ,
                    %mi ℤ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo ⟶
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi k
                        %mo ∈
                        %mi ℕ
                    %msup
                      %mi H
                      %mrow
                        %mn 2
                        %mi k
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi B
                    %mi G
                    %mo ,
                    %mi ℤ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{N}_H^G
                    \\;\colon\;
                    \\underset{k \in \mathbb{N}}{\prod} H^{2k}\big( B H, \mathbb{Z}\big)
                    \\longrightarrow
                    \\underset{k \in \mathbb{N}}{\prod} H^{2k}\big( B G, \mathbb{Z}\big)
            %p
              from the
              %a.existingWikiWord{:href => "/nlab/show/cohomology+ring"} cohomology ring
              of the
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              to that of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              which is multiplicative in that its respects the product structure, hence the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cup+product"} cup product
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi 𝒩
                      %mi H
                      %mi G
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi α
                    %mo ⌣
                    %mi β
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi 𝒩
                      %mi H
                      %mi G
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi α
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo ⌣
                    %msubsup
                      %mi 𝒩
                      %mi H
                      %mi G
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi β
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{N}_H^G\big( \alpha \smile \beta\big)
                    \\;=\;
                    \\mathcal{N}_H^G\big( \alpha\big)  \smile \mathcal{N}_H^G\big( \beta\big)
                    \\,.
          %p
            This is due to
            = succeed "." do
              %a{:href => "#Evens63"} Evens 63
          #SymondsExplicitBrauerInd.num_prop
            %h6#proposition Proposition
            %p
              %strong (Symonds’ explicit Brauer induction)
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} G \in
              %a.existingWikiWord{:href => "/nlab/show/FinGrp"} FinGrp
              there is a
              %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
              (
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi R
                      %mi ℂ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi G
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mover
                      %mo ⟶
                      %mi L
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi H
                        %mo ⊂
                        %mi G
                        %mo{:stretchy => "false"} ]
                    %mi ℤ
                    %mrow
                      %mo [
                      %mn 1
                      %msub
                        %mi dRep
                        %mi ℂ
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mi H
                      %msub
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mrow
                          %mo{:stretchy => "false"} /
                          %mo ∼
                      %mo ]
                  %annotation{:encoding => "application/x-tex"}
                    R_{\mathbb{C}}\big( G \big)
                    \\overset
                    {L}
                    {\longrightarrow}
                    \\underset{
                    [H \subset G]
                    }{\prod}
                    \\mathbb{Z}
                    \\left[
                    1dRep_{\mathbb{C}}\big( H \big)_{/\sim}
                    \\right]
            %p
              from the underlying abelian group of the
              %a.existingWikiWord{:href => "/nlab/show/representation+ring"} representation ring
              to the
              %a.existingWikiWord{:href => "/nlab/show/product+group"} product group
              of the
              %a.existingWikiWord{:href => "/nlab/show/free+abelian+groups"} free abelian groups
              that are spanned by the
              %a.existingWikiWord{:href => "/nlab/show/isomorphism+classes"} isomorphism classes
              of 1-dimensional representations over all
              %a.existingWikiWord{:href => "/nlab/show/conjugacy+classes"} conjugacy classes
              of
              %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                      %mo ⊂
                      %mi G
                    %annotation{:encoding => "application/x-tex"} H \subset G
            %p such that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                      %annotation{:encoding => "application/x-tex"} L
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
                  of
                  %a.existingWikiWord{:href => "/nlab/show/functors"} functors
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi FinGrp
                            %mi op
                          %mo →
                          %mi Ab
                        %annotation{:encoding => "application/x-tex"} FinGrp^{op} \to Ab
                %p
                  hence
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi L
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %msup
                            %mi f
                            %mo *
                          %mi V
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mo =
                          %msup
                            %mi f
                            %mo *
                          %mo{:stretchy => "false"} (
                          %mi L
                          %mo{:stretchy => "false"} (
                          %mi V
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} L\big( f^\ast V\big) = f^\ast( L(V) )
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                      %annotation{:encoding => "application/x-tex"} L
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/section"} section
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                          %mrow
                            %mo{:stretchy => "false"} [
                            %mi H
                            %mo ⊂
                            %mi G
                            %mo{:stretchy => "false"} ]
                        %msubsup
                          %mi R
                          %mi ℤ
                          %mrow
                            %mn 1
                            %mi d
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mi H
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mover
                          %mo ⟶
                          %mrow
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                            %mi ind
                        %msub
                          %mi R
                          %mi ℂ
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mi G
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\underset{
                        [H \subset G]
                        }{\prod}
                        R^{1d}_{\mathbb{Z}}\big( H\big)
                        \\overset
                        {\sum ind}
                        {\longrightarrow}
                        R_{\mathbb{C}}\big( G \big)
                %p
                  which applies
                  %a.existingWikiWord{:href => "/nlab/show/induced+representation"} induction
                  and then sums everything up, in that the
                  %a.existingWikiWord{:href => "/nlab/show/composition"} composition
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mi ind
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mo ∘
                        %mi L
                      %annotation{:encoding => "application/x-tex"} \big( \sum ind \big) \circ L
                  is the
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/identity+morphism"} identity
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mi ind
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mo ∘
                        %mi L
                        %mo{:stretchy => "false"} (
                        %mi V
                        %mo{:stretchy => "false"} )
                        %mo ≔
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mrow
                            %mo{:stretchy => "false"} [
                            %mi H
                            %mo ⊂
                            %mi G
                            %mo{:stretchy => "false"} ]
                        %msubsup
                          %mi ind
                          %mi H
                          %mi G
                        %mrow
                          %mo [
                          %mi L
                          %mo{:stretchy => "false"} (
                          %mi V
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi H
                          %mo ]
                        %mspace{:width => "thickmathspace"}
