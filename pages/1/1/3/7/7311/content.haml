            %p
          %p However, the shape modality does preserve some useful classes of homotopy fiber products after all:
          %h4#general General
          %p
          #CohesiveShapePreservesLoopingOfDeloopings.num_prop
            %h6 Proposition
            %p
              %strong (cohesive shape preserves looping and delooping)
              %br/
              = succeed "For" do
                %br/
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              a
              %a.existingWikiWord{:href => "/nlab/show/cohesive+%28infinity%2C1%29-topos"}
                cohesive
                = succeed "-topos" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi 𝒢
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}\mathcal{G} \,\in\, \mathbf{H}
              a pointed connected object,
              %a.existingWikiWord{:href => "/nlab/show/May+recognition+theorem"} hence
              the
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              of an
              %a.existingWikiWord{:href => "/nlab/show/infinity-group"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
                \-group
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒢
                      %mspace{:width => "thinmathspace"}
                      %mo ∈
                      %mspace{:width => "thinmathspace"}
                      %mi Grp
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathcal{G} \,\in\, Grp(\mathbf{H})
              %a.existingWikiWord{:href => "/nlab/show/looping"} looping
              homotopy fiber product:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} ʃ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo *
                    %munder
                      %mo ×
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi 𝒢
                    %mo *
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo *
                    %munder
                      %mo ×
                      %mrow
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} ʃ
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi 𝒢
                    %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\esh
                    \\big(
                    \\ast
                    \\underset
                    {\mathbf{B}\mathcal{G}}{\times}
                    \\ast
                    \\big)
                    \\;\;
                    \\simeq
                    \\;\;
                    \\ast
                    \\underset
                    {\esh \mathbf{B}\mathcal{G}}{\times}
                    \\ast
                    \\,.
            %p
          .proof
            %h6 Proof
            %p
              Since
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/groupoid+objects+in+an+%28%E2%88%9E%2C1%29-topos+are+effective"} groupoid objects in an (∞,1)-topos are effective
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              of an
              %a.existingWikiWord{:href => "/nlab/show/infinity-group"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
                \-group
              is the simplicial
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-colimit"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
                \-colimit
              of the
              %a.existingWikiWord{:href => "/nlab/show/simplicial+object"} simplicial object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒢
                      %mrow
                        %msup
                          %mo ×
                          %mo •
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}^{\times^\bullet}
              of
              %a.existingWikiWord{:href => "/nlab/show/finite+products"} finite products
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}
              %a.existingWikiWord{:href => "/nlab/show/preserved+limit"} preserves
              finite products and general colimits, it preserves the delooping:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} ʃ
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi 𝒢
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} ʃ
                    %munder
                      %mi lim
                      %munder
                        %mo ⟶
                        %mrow
                          %mi n
                          %mo ∈
                          %mi ℕ
                    %msup
                      %mi 𝒢
                      %mrow
                        %msup
                          %mo ×
                          %mi n
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mi lim
                      %munder
                        %mo ⟶
                        %mrow
                          %mi n
                          %mo ∈
                          %mi ℕ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} ʃ
                    %mi 𝒢
                    %msup
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mrow
                        %msup
                          %mo ×
                          %mi n
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} ʃ
                    %mi 𝒢
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\esh
                    \\mathbf{B}\mathcal{G}
                    \\;\simeq\;
                    \\esh
                    \\underset{\underset{n \in \mathbb{N}}{\longrightarrow}}
                    {\lim}
                    \\mathcal{G}^{\times^n}
                    \\;\simeq\;
                    \\underset{\underset{n \in \mathbb{N}}{\longrightarrow}}
                    {\lim}
                    \\big(
                    \\esh
                    \\mathcal{G}
                    \\big)^{\times^n}
                    \\;\simeq\;
                    \\mathbf{B} \esh \mathcal{G}
                    \\,.
            %p
              Finally, using again that
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/groupoid+objects+in+an+%28%E2%88%9E%2C1%29-topos+are+effective"} groupoid objects in an (∞,1)-topos are effective
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} ʃ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo *
                    %munder
                      %mo ×
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi 𝒢
                    %mo *
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} ʃ
                    %mi 𝒢
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} ʃ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo *
                    %munder
                      %mo ×
                      %mrow
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} ʃ
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi 𝒢
                    %mo *
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\esh
                    \\big(
                    \\ast
                    \\underset{\mathbf{B}\mathcal{G}}{\times}
                    \\ast
                    \\big)
                    \\;\simeq\;
                    \\esh
                    \\mathcal{G}
                    \\;\simeq\;
                    \\esh
                    \\big(
                    \\ast
                    \\underset{\esh\mathbf{B}\mathcal{G}}{\times}
                    \\ast
                    \\big)
                    \\,.
            %p
          %p
          #ShapePreservesHomotopyFibersOverDiscreteObjects.num_prop
            %h6 Proposition
            %p
              %strong (cohesive shape preserves homotopy fiber products over discrete objects)
              %br/
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              is a
              %a.existingWikiWord{:href => "/nlab/show/cohesive+%28infinity%2C1%29-topos"}
                cohesive
                = succeed "-topos" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
              %a.existingWikiWord{:href => "/nlab/show/base+%28infinity%2C1%29-topos"}
                over
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Infinity-Grpd"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Grpd
                          %mn ∞
                      %annotation{:encoding => "application/x-tex"} Grpd_\infty
              %a.existingWikiWord{:href => "/nlab/show/shape+modality"} shape modality
              %a.existingWikiWord{:href => "/nlab/show/preserved+limit"} preserves
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+products"} homotopy fiber products
              over
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/discrete+objects"} discrete objects
          The following argument follows
          = succeed "," do
            %a.existingWikiWord{:href => "/schreiber/show/differential+cohomology+in+a+cohesive+topos"} dcct, Thm. 3.8.19
          = succeed "." do
            %a.existingWikiWord{:href => "/nlab/show/Mike+Shulman"} Mike Shulman
          = succeed "." do
            %a.existingWikiWord{:href => "/schreiber/show/Equivariant+principal+infinity-bundles"} SS21, Prop. 3.38
          .proof
            %h6 Proof
            %p
              By a version of the
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-Grothendieck+construction"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
                \-Grothendieck construction
              (
              %a{:href => "infinity1-Grothendieck+construction#BeardsleyPéroux22"}> Beardsley &amp; Péroux 2022, Lem. 3.10
              ), a
              %a.existingWikiWord{:href => "/nlab/show/slice+%28infinity%2C1%29-topos"}
                slice
                = succeed "-topos" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
              over the
              %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
              of a plain
              %a.existingWikiWord{:href => "/nlab/show/infinity-groupoid"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
                \-groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              is
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28infinity%2C1%29-categories"} equivalent
              to the
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-category+of+%28infinity%2C1%29-functors"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
                \-category of
                = succeed "-functors" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} B \to \mathbf{H}
              %a{:href => "adjoint+infinity1-functor#OnSlices"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
