          %p
          #ConditionHOnFamiliesOfGroupHomomorphisms.num_defn
            %h6 Definition
            %p
              %strong (Condition H on families of topological group homomorphisms)
              %br/
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ,
                    %mi Γ
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mi Grp
