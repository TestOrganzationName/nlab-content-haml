                            %mi ρ
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} \Gamma \longrightarrow \Gamma/Stab_\Gamma(\rho)
                    %p
                      (by the the
                      %a.existingWikiWord{:href => "/nlab/show/stabilizer+subgroup"} stabilizer subgroup
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
