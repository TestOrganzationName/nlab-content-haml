            %p
              Now
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Fnctr
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ,
                    %mi Shp
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Fnctr(B,Shp)
              preserves
              %a.existingWikiWord{:href => "/nlab/show/binary+products"} binary products
              as soon as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Shp
                  %annotation{:encoding => "application/x-tex"} Shp
              does (because products of presheaves are computed objectwise). But binary products in the equivalent slice category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi B
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}_{/B}
              are the homotopy fiber products in question, and hence the claim follows.
          %p
          #ShapePreservesHomotopyFibersOfMapsFromDiscreteToDeloopedObjects.num_prop
            %h6 Proposition
            %p
              %strong (shape preserves homotopy fibers of maps from discrete to delooped objects)
              %br/
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              is a
              %a.existingWikiWord{:href => "/nlab/show/cohesive+%28infinity%2C1%29-topos"}
                cohesive
                = succeed "-topos" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
              %a.existingWikiWord{:href => "/nlab/show/base+%28infinity%2C1%29-topos"}
                over
              %a.existingWikiWord{:href => "/nlab/show/Infinity-Grpd"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Grpd
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} Grpd_\infty
              the shape modality preserves the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fibers"} homotopy fibers
              of morphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mi X
                    %mo ⟶
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"}
                    f \,\colon\, X \longrightarrow \mathbf{B}\mathcal{G}
            %ul
              %li
                %p
                  from any
                  %a.existingWikiWord{:href => "/nlab/show/discrete+object"} discrete object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mspace{:width => "thinmathspace"}
                        %mo ∈
                        %mspace{:width => "thinmathspace"}
                        %msub
                          %mi Grpd
                          %mn ∞
                        %mover
                          %mo ↪
                          %mi Dscr
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                      %annotation{:encoding => "application/x-tex"} X \,\in\, Grpd_\infty \xhookrightarrow{Dscr} \mathbf{H}
              %li
                %p
                  to any
                  %a.existingWikiWord{:href => "/nlab/show/delooping"} delooped
                  object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi 𝒢
                        %mspace{:width => "thinmathspace"}
                        %mo ∈
                        %mspace{:width => "thinmathspace"}
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                      %annotation{:encoding => "application/x-tex"} \mathbf{B}\mathcal{G} \,\in\, \mathbf{H}
            %p in that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} ʃ
                    %mi fib
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi fib
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} ʃ
                    %mi f
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\esh
                    fib(f)
                    \\;\simeq\;
                    fib\big( \esh f \big)
                    \\,.
            %p
          .proof
            %h6 Proof
            %p
              Since a discrete
              = succeed "-groupoid" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is the
              %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
              of its
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
              %a.existingWikiWord{:href => "/nlab/show/preserved+colimit"} preserved
              by
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
              (due to
              %a.existingWikiWord{:href => "/nlab/show/universal+colimits"} universal colimits
              in an
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-topos"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
                  \-topos
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
