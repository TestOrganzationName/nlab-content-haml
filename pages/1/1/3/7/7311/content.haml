                    %mi kTop
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G, \Gamma \,\in\, Grp(kTop)
              be
              %a.existingWikiWord{:href => "/nlab/show/topological+groups"} topological groups
              and let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℛ
                    %mspace{:width => "thinmathspace"}
                    %mo ⊂
                    %mspace{:width => "thinmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mi H
                        %mo ⊂
                        %mi G
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi H
                    %mo ,
                    %mi Γ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{R}
                    \\,\subset\,
                    \\underset{
                    H \subset G
                    }{\coprod}
                    Hom(H,\Gamma)
            %p
              be a
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              of
              %a.existingWikiWord{:href => "/nlab/show/pairs"} pairs
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi H
                    %mo ,
                    %mi ρ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (H,\rho)
              consisting of a topological
              %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              and a
              %a.existingWikiWord{:href => "/nlab/show/continuous+map"} continuous
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo →
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} H \to \Gamma
              such that (
              %a{:href => "equivariant+bundle#UribeLück14"}> Uribe &amp; Lück 2014, Def. 3.4
              )
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℛ
                  %annotation{:encoding => "application/x-tex"} \mathcal{R}
              is closed under:
            %ol
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/fiber+products"}> fiber products
                  , i.e. under products in
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Grp
                          %mo{:stretchy => "false"} (
                          %mi kTop
                          %msub
                            %mo{:stretchy => "false"} )
                            %mrow
                              %mo{:stretchy => "false"} /
                              %mi Γ
                        %annotation{:encoding => "application/x-tex"} Grp(kTop)_{/\Gamma}
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/conjugation"} conjugation
                  by
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Γ
                      %annotation{:encoding => "application/x-tex"} \Gamma
                  (under postcomposition),
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/conjugation"} conjugation
                  by
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                  (under precomposition).
            %p
              We say (with
              = succeed ")" do
                %a{:href => "equivariant+bundle#UribeLück14"} Uribe &amp; Lück 2014, Def. 6.1
              %em Condition H
              if for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi H
                    %mo ,
                    %mi ρ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mi ℛ
                  %annotation{:encoding => "application/x-tex"}
                    (H,
                    \\rho) \,\in\, \mathcal{R}
              we have:
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/path+component"} path component
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ρ
                      %annotation{:encoding => "application/x-tex"} \rho
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi HomMap
                        %mo{:stretchy => "false"} (
                        %mi H
                        %mo ,
                        %mi Γ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} HomMap(H,\Gamma)
                  is contained in its
                  %a.existingWikiWord{:href => "/nlab/show/orbit"} orbit
                  under the
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Γ
                        %annotation{:encoding => "application/x-tex"} \Gamma
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/conjugation+action"} conjugation action
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi HomMap
                        %mo{:stretchy => "false"} (
                        %mi H
                        %mo ,
                        %mi Γ
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi ρ
