                        \\big\}
              %li
                %p
                  the
                  = succeed "-" do
                    %a.existingWikiWord{:href => "/nlab/show/coset+space"} coset space
                  %a.existingWikiWord{:href => "/nlab/show/coprojections"} coprojections
                %ol
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi G
                            %mo ⟶
                            %mi G
                            %mo{:stretchy => "false"} /
                            %mi H
                          %annotation{:encoding => "application/x-tex"} G \longrightarrow G/H
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi Γ
                            %mo ⟶
                            %mi Γ
                            %mo{:stretchy => "false"} /
                            %msub
                              %mi Stab
