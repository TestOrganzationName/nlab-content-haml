            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %msup
                    %mi C
                    %mi op
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} F: C^{op} \to Set
          %p
            on the
            %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            with values in
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            is
            %strong representable
            if it is
            %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} naturally isomorphic
            to a
            %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi h
                      %mi X
                    %mo :
                    %mo =
                    %msub
                      %mi hom
                      %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msup
                      %mi C
                      %mi op
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} h_X := \hom_C(-, X): C^{op} \to Set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ∈
                  %mi C
                %annotation{:encoding => "application/x-tex"} U \in C
            to the
            %a.existingWikiWord{:href => "/nlab/show/hom-set"} hom-set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Hom
                    %mi C
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Hom_C(U,X)
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
          %p
            %img{:src => "http://ncatlab.org/ericforgy/files/hx2.jpg", :width => "200"}/
          %p
            and which sends a
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo :
                  %mi U
                  %mo ′
                  %mo →
                  %mi U
                %annotation{:encoding => "application/x-tex"} \alpha : U' \to U
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            to the
            %a.existingWikiWord{:href => "/nlab/show/function"} function
            which sends each morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} U \to X
            to the composite
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ′
                  %mover
                    %mo →
                    %mi α
                  %mi U
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} U' \stackrel{\alpha}{\to} U \to X
          %p
            %img{:src => "http://ncatlab.org/ericforgy/files/hxalpha3.jpg", :width => "400"}/
          %p
            If we picture
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Hom
                    %mi C
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Hom_C(U,X)
            as strands of morphisms as above, then the morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo :
                  %mi U
                  %mo ′
                  %mo →
                  %mi U
                %annotation{:encoding => "application/x-tex"} \alpha:U'\to U
            serves to “comb” the strands back from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Hom
                    %mi C
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Hom_C(U,X)
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi C
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ′
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom_C(U',X)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi h
                    %mi X
                  %mi α
                  %mo :
                  %msub
                    %mi Hom
                    %mi C
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi Hom
                    %mi C
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ′
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} h_X\alpha: Hom_C(U,X)\to Hom_C(U',X).
          %p
            The object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is determined uniquely up to
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %strong representing object
            for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
          %p
            Representability is one of the most fundamental concepts of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
            %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjoint functor
            and to the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
            = succeed "\u201D," do
              %a.existingWikiWord{:href => "/nlab/show/limit"} limit
            = succeed "\u201D," do
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
            = succeed "\u201D," do
              %a.existingWikiWord{:href => "/nlab/show/exponential+object"} exponential object
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/Kan+extension"} Kan extension
          %h2#definition Definition
          %h3#in_ordinary_category_theory In ordinary category theory
          %p
            For a functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %msup
                    %mi C
                    %mi op
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} F: C^{op} \to Set
            (also called a
            %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
            on
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %strong representation
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            is a specified
            %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi θ
                  %mo :
                  %msub
                    %mi hom
                    %mi C
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mo ∼
                  %mi F
                %annotation{:encoding => "application/x-tex"} \theta: \hom_C(-, c) \stackrel{\sim}{\to} F
          %p
            By the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi θ
                %annotation{:encoding => "application/x-tex"} \theta
            (isomorphism or not) is uniquely determined by an element
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ξ
                    %mo ∈
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \xi \in F(c)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
            is called a
            %strong representing object
            (or often,
            = succeed ")" do
              %strong universal object
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ξ
                %annotation{:encoding => "application/x-tex"} \xi
            is called a
            %strong
              %a.existingWikiWord{:href => "/nlab/show/universal+element"} universal element
            for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
            that the pair
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mi ξ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (c, \xi)
            is determined uniquely up to unique isomorphism.
          %p
            Following the proof of the Yoneda lemma, representability means precisely this: given any object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and any element
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo ∈
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \alpha \in F(x)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi x
                  %mo →
                  %mi c
                %annotation{:encoding => "application/x-tex"} f: x \to c
            such that the function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F(f)
            carries the universal element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ξ
                  %mo ∈
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \xi \in F(c)
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo ∈
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \alpha \in F(x)
          %p
            Abstractly, a presheaf
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            is representable if and only if it admits a
            %a.existingWikiWord{:href => "/nlab/show/relative+adjunction"} left adjoint relative to
            the functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mo{:lspace => "verythinmathspace"} :
                  %mstyle{:mathvariant => "bold"}
                    %mn 1
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} 1 \colon \mathbf 1 \to Set
            from the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/terminal+category"} terminal category
            %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbf 1
          %h3#in_enriched_category_theory In enriched category theory
          %p
            The above definition generalizes straightforwardly to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/enriched+category+theory"} enriched category theory
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            be a
            %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed monoidal category
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
          %p
            Then for every object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo ∈
                  %mi C
                %annotation{:encoding => "application/x-tex"} c \in C
            there is a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %a.existingWikiWord{:href => "/nlab/show/enriched+functor"} enriched functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi C
                  %mo →
                  %mi V
                %annotation{:encoding => "application/x-tex"}
                  C(c,-) : C \to V
          %p
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            regarded canonically as a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
          %p This is defined
          %ul
            %li
              %p
                on objects by
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi d
                      %mo ↦
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo ,
                      %mi d
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi V
                    %annotation{:encoding => "application/x-tex"} C(c,-) : d \mapsto C(c,d) \in V
            %li
              %p
                on morphisms between
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                    %annotation{:encoding => "application/x-tex"} d
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} d'
                by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi d
                      %mo ,
                      %mi d
                      %mo ′
                  %mo :
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo ,
                  %mi d
                  %mo ′
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mi d
                  %mo ′
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  C(c,-)_{d,d'} : C(d,d') \to [C(c,d), C(c,d')]
                  \\,,
          %p
            being the
            %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
            of the composition morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∘
                    %mrow
                      %mi c
                      %mo ,
                      %mi d
                      %mo ,
                      %mi d
                      %mo ′
                  %mo :
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo ,
                  %mi d
                  %mo ′
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mi d
                  %mo ′
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\circ_{c,d,d'} : C(d,d') \otimes C(c,d) \to C(c,d')
                  \\,.
          %p
            A
            = succeed "-enriched" do
