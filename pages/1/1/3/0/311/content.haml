                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} [J,Set](\Delta pt, C(-,F(-)))
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mi pt
                  %mo :
                  %mi J
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} \Delta pt : J \to Set
            by any other functor leads to the notion of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/weighted+limit"} weighted limit
          %h3#exponential_objects Exponential objects
          %p
            Suppose
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is a category which admits finite products; given objects
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ,
                    %mi d
                  %annotation{:encoding => "application/x-tex"} c, d
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi hom
                    %mi C
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ×
                  %mi c
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msup
                    %mi C
                    %mi op
                  %mo →
                  %mi Set
                  %mo .
                %annotation{:encoding => "application/x-tex"} \hom_C(- \times c, d): C^{op} \to Set.
          %p
            A representing or universal object for this presheaf is an
            %a.existingWikiWord{:href => "/nlab/show/exponential+object"} exponential object
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi d
                      %mi c
                  %annotation{:encoding => "application/x-tex"} d^c
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                  %mo ∈
                  %msub
                    %mi hom
                    %mi C
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi d
                    %mi c
                  %mo ×
                  %mi c
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} e \in \hom_C(d^c \times c, d)
          %p
            is a morphism called the
            %strong evaluation
            map
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi eval
                    %mo :
                    %msup
                      %mi d
                      %mi c
                    %mo ×
                    %mi c
                    %mo →
                    %mi d
                  %annotation{:encoding => "application/x-tex"} eval: d^c \times c \to d
          %h3#classifying_bundles Classifying bundles
          %p
            Consider a category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Top
                %annotation{:encoding => "application/x-tex"} Top
            of ‘nice’ spaces (just to fix the discussion, let’s say paracompact spaces, although this is a technical point), and a topological group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            therein, i.e., a group internal to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} Top
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} Bund
                  %mo :
                  %msup
                    %mi Top
                    %mi op
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} G\Bund: Top^{op} \to Set
          %p
            which assigns to each space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            the set of isomorphism classes of
            = succeed "-bundles" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f: X \to Y
            the function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} Bund
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi G
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} Bund
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi G
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} Bund
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G\Bund(f): G\Bund(Y) \to G\Bund(X)
          %p
            which carries a (class of a)
            = succeed "-bundle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} E \to Y
            to the (class of the) pullback bundle
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mi E
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} f^*E \to X
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} Bund
                  %mo :
                  %msubsup
                    %mi Ho
                    %mi Top
                    %mi op
                  %mo →
                  %mi Set
                  %mo .
                %annotation{:encoding => "application/x-tex"} G\Bund: Ho_{Top}^{op} \to Set.
          %p
            A
            %strong
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℬ
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathcal{B}G
            is precisely a representing object for this functor; the universal element is the (isomorphism class of the) classifying
            = succeed "-bundle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi π
                    %mo :
                    %mi ℰ
                    %mi G
                    %mo →
                    %mi ℬ
                    %mi G
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\pi: \mathcal{E}G \to \mathcal{B}G]
          %p These general considerations are quite commonplace in algebraic topology, where they crop up for example in the connection between generalized cohomology theories and spectra; cf. Brown’s representability theorem.
          %h2#properties Properties
          %ul
            %li
              A functor is representable if and only if its
              %a.existingWikiWord{:href => "/nlab/show/category+of+elements"} category of elements
              has a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C/X \to C
              from the slice over the representing object
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/discrete+fibration"} discrete fibration
              for more.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/representable+functor+theorem"} representable functor theorem
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/weak+representation+of+a+functor"} weak representation of a functor
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"}> Yoneda lemma
                ,
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/classifying+space"}> classifying space
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/classifying+stack"} classifying stack
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/moduli+space"} moduli space
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
                %a.existingWikiWord{:href => "/nlab/show/derived+moduli+space"} derived moduli space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/classifying+morphism"} classifying morphism
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/representable+morphism+of+stacks"} representable morphism of stacks
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Artin+representability+theorem"}> Artin representability theorem
                ,
                %a.existingWikiWord{:href => "/nlab/show/Artin-Lurie+representability+theorem"} Artin-Lurie representability theorem
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/multirepresentable+functor"} multirepresentable functor
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/relative+adjunction"} relative adjunction
          %h2#references References
          %p Early accounts:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Alexander+Grothendieck"}> Alexander Grothendieck
              , Section A.1 of:
              = succeed "," do
                %em Technique de descente et théorèmes d’existence en géométrie algébriques. II. Le théorème d’existence en théorie formelle des modules
              = succeed ")" do
                %a{:href => "http://www.numdam.org/item/?id=SB_1958-1960__5__369_0"} numdam:SB_1958-1960__5__369_0
          %p
            A discussion of representable functors in the context of
            %a.existingWikiWord{:href => "/nlab/show/enriched+category+theory"} enriched category theory
            is in section 1.6 and section 1.10 of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Max+Kelly"}> Max Kelly
              ,
              %em Basic concepts of enriched category theory
              (
              %a{:href => "http://www.tac.mta.ca/tac/reprints/articles/10/tr10.pdf"}> pdf
              )
          %p
            A query discussion on differences between representable functor and representation of a functor is archived
            = succeed "." do
              %a{:href => "https://nforum.ncatlab.org/discussion/4497/representable-functor/"} here
