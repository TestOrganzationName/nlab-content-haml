                    %annotation{:encoding => "application/x-tex"} g \circ (f_1 \cdot \sigma_1, ..., f_n \cdot \sigma_n) = (g \circ (f_1, ..., f_n)) \cdot (\sigma_1 + ... + \sigma_n),
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
