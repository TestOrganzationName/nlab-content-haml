                  %mo +
                  %mo .
                  %mo .
                  %mo .
                  %mo +
                  %msub
                    %mi k
                    %mi n
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \sigma \wr (k_1, ..., k_n) : \{ 1, ... , k_{\sigma 1} + ... + k_{\sigma m} \} \to \{1, ..., k_{1} + ... + k_{n}\}
          %p denotes the “block function”
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mn 1
                  %mo ,
                  %mo .
                  %mo .
                  %mo .
                  %mo ,
                  %msub
                    %mi k
                    %mrow
                      %mi σ
                      %mn 1
                  %mo +
                  %mo .
                  %mo .
                  %mo .
                  %mo +
                  %msub
                    %mi k
                    %mrow
                      %mi σ
                      %mi m
                  %mo{:stretchy => "false"} }
                  %mo ≅
                  %mo{:stretchy => "false"} {
                  %mn 1
                  %mo ,
                  %mo .
                  %mo .
                  %mo .
                  %mo ,
