                %annotation{:encoding => "application/x-tex"} \{ 1, ... , k_{\sigma 1} + ... + k_{\sigma m} \} \cong \{1, ..., k_{\sigma 1}\} + ... + \{1, ..., k_{\sigma m}\} \xrightarrow{\hat{\sigma}} \{1, ..., k_{1}\} + ... + \{1, ..., k_{n}\} \cong \{1, ..., k_{1} + ... + k_{n}\}
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
