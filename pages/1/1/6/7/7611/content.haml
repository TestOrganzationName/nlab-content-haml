                      %mo .
                      %mo .
                      %mo .
                      %mo ,
                      %msub
                        %mi k
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ,
                    %annotation{:encoding => "application/x-tex"} (g \cdot \sigma) \circ (f_1 , ..., f_n) = (g \circ (f_{\sigma 1} , ... , f_{\sigma m})) \cdot (\sigma \wr (k_1, ..., k_n)),
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi k
                        %mi i
                    %annotation{:encoding => "application/x-tex"} k_i
                is the arity of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mi i
                      %mo ,
                    %annotation{:encoding => "application/x-tex"} f_i,
          %p
            where for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                  %mo :
                  %mo{:stretchy => "false"} {
                  %mn 1
                  %mo ,
                  %mo .
                  %mo .
                  %mo .
                  %mo ,
                  %mi m
                  %mo{:stretchy => "false"} }
                  %mo →
                  %mo{:stretchy => "false"} {
                  %mn 1
                  %mo ,
                  %mo .
                  %mo .
                  %mo .
                  %mo ,
                  %mi n
                  %mo{:stretchy => "false"} }
                  %mo ,
                %annotation{:encoding => "application/x-tex"} \sigma : \{1,...,m\} \to \{1, ...,n\},
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                  %mo ≀
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi k
                    %mn 1
                  %mo ,
                  %mo .
                  %mo .
                  %mo .
                  %mo ,
                  %msub
                    %mi k
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo{:stretchy => "false"} {
                  %mn 1
                  %mo ,
                  %mo .
                  %mo .
                  %mo .
                  %mo ,
                  %msub
                    %mi k
                    %mrow
                      %mi σ
                      %mn 1
                  %mo +
                  %mo .
                  %mo .
                  %mo .
                  %mo +
                  %msub
                    %mi k
                    %mrow
                      %mi σ
                      %mi m
                  %mo{:stretchy => "false"} }
                  %mo →
                  %mo{:stretchy => "false"} {
                  %mn 1
                  %mo ,
                  %mo .
                  %mo .
                  %mo .
                  %mo ,
