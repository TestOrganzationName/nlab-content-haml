                      %mo{:stretchy => "false"} (
                      %msub
                        %mi f
                        %mn 1
                      %mo ⋅
                      %msub
                        %mi σ
                        %mn 1
                      %mo ,
                      %mo .
                      %mo .
                      %mo .
                      %mo ,
                      %msub
                        %mi f
                        %mi n
                      %mo ⋅
                      %msub
                        %mi σ
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo ∘
                      %mo{:stretchy => "false"} (
