                  %mo ,
                  %mo .
                  %mo .
                  %mo .
                  %mo ,
                  %msub
                    %mi k
                    %mrow
                      %mi σ
                      %mi m
                  %mo{:stretchy => "false"} }
                  %mover
                    %mo →
                    %mover
                      %mi σ
                      %mo{:stretchy => "false"} ^
                  %mo{:stretchy => "false"} {
                  %mn 1
                  %mo ,
                  %mo .
                  %mo .
                  %mo .
                  %mo ,
                  %msub
                    %mi k
                    %mn 1
                  %mo{:stretchy => "false"} }
                  %mo +
                  %mo .
                  %mo .
                  %mo .
                  %mo +
                  %mo{:stretchy => "false"} {
