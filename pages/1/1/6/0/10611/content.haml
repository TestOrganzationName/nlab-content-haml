                              %mo ⊣
                            %annotation{:encoding => "application/x-tex"} \dashv
                        %a.existingWikiWord{:href => "/nlab/show/sharp+modality"} sharp modality
          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %ul
                %li
                  %a{:href => "#IdeaInPhilosophy"} In philosophy
                %li
                  %a{:href => "#InFormalLogic"} In formal logic and type theory
                %ul
                  %li
                    %a{:href => "#idempotent_monadic_modalities_in_homotopy_type_theory"} Idempotent monadic modalities in homotopy type theory
                %li
                  %a{:href => "#Notation"} Notation
              %li
                %a{:href => "#examples"} Examples
              %li
                %a{:href => "#related_concepts"} Related concepts
              %li
                %a{:href => "#References"} References
              %ul
                %li
                  %a{:href => "#in_philosopy"} In philosopy
                %li
                  %a{:href => "#in_formal_logic"} In formal logic
                %li
                  %a{:href => "#in_category_theory"} In category theory
          %h2#idea Idea
          %p
            A
            %em modality
            in
            %a.existingWikiWord{:href => "/nlab/show/philosophy"} philosophy
            and formally in
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/formal+logic"} formal logic
            %a.existingWikiWord{:href => "/nlab/show/type+theory"} type theory
            expresses a certain
            %em mode
            (or “moment” as in
            = succeed ")" do
              %a{:href => "#Hegel12"} Hegel 12
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/being"} being
          %h3#IdeaInPhilosophy In philosophy
          %p
            According to (
            %a{:href => "#Kant1900"}> Kant 1900
            ) (see
            = succeed ")" do
              %a{:href => "http://de.wikipedia.org/wiki/Kategorie_%28Philosophie%29"} WP
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/category+%28philosophy%29"} categories
          %ol
            %li
              %p Quantity
            %li
              %p Quality
            %li
              %p Relation
            %li
              %p Modality
          %p
            and the modalities contain the three
            %a.existingWikiWord{:href => "/nlab/show/unity+of+opposites"} pairs of opposites
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/possibility"} possibility
                \- impossibility
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/being"} being
                \-
                %a.existingWikiWord{:href => "/nlab/show/nothing"} nothing
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/necessity"} necessity
                \- Zufälligkeit
          %h3#InFormalLogic In formal logic and type theory
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/formal+logic"} formal logic
            and
            %a.existingWikiWord{:href => "/nlab/show/type+theory"} type theory
            modalities are formalized by
            %em
              %a.existingWikiWord{:href => "/nlab/show/modal+operators"} modal operators
            or
            %em
              %a.existingWikiWord{:href => "/nlab/show/closure+operators"} closure operators
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ♯
                  %annotation{:encoding => "application/x-tex"} \sharp
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/propositions"} propositions
            %a.existingWikiWord{:href => "/nlab/show/types"} types
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to new propositions/types
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ♯
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \sharp X
          %p
            Adding such modalities to
            %a.existingWikiWord{:href => "/nlab/show/propositional+logic"} propositional logic
            or similar produces what is called
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/modal+logic"} modal logic
            %a.existingWikiWord{:href => "/nlab/show/necessity"} necessity
            (denoted
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo □
                  %annotation{:encoding => "application/x-tex"} \Box
            %a.existingWikiWord{:href => "/nlab/show/possibility"} possibility
            (denoted
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ◊
                  %annotation{:encoding => "application/x-tex"} \lozenge
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/S4+modal+logic"} S4 modal logic
            %a.existingWikiWord{:href => "/nlab/show/type+theory"} type theory
            and
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
            yields
            %em
              %a.existingWikiWord{:href => "/nlab/show/modal+type+theory"} modal type theory
            and
            = succeed ";" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/modal+homotopy+type+theory"} modal homotopy type theory
          %p
            In general, the
            %a.existingWikiWord{:href => "/nlab/show/categorical+semantics"} categorical semantics
            of these modalities is that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ♯
                %annotation{:encoding => "application/x-tex"} \sharp
            is interpreted as some kind of
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            on the
            %a.existingWikiWord{:href => "/nlab/show/category+of+contexts"} category of contexts
            or types. Often it is either a
            %a.existingWikiWord{:href => "/nlab/show/monad"} monad
            or
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/comonad"} comonad
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/idempotent+monad"} idempotent
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
            %a.existingWikiWord{:href => "/nlab/show/categorical+semantics"} categorical semantics
            of a
            %em higher modality
            or
            %em homotopy modality
            is an
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-functor"} (infinity,1)-functor
            or
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-monad"} monad
          %h4#idempotent_monadic_modalities_in_homotopy_type_theory Idempotent monadic modalities in homotopy type theory
          %p
            Since idempotent monadic modalities are very common and important in homotopy type theory, and other sorts are more difficult to formalize internally, sometimes those adjectives are dropped and we speak merely of “modalities” (e.g.
            = succeed "," do
              %a{:href => "#Shulman"} Shulman 12
            %a{:href => "#RSS"} Rijke, Shulman, Spitters
            ). Here we describe the idempotent monadic case, although it should be noted that comonadic and non-idempotent modalities also arise and are important; they are generally formalized using some kind of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/modal+type+theory"} modal type theory
          %p
            In fact, there are a number of different but equivalent ways to define an (idempotent, monadic) modality in
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
            (see at
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/modal+homotopy+type+theory"} modal homotopy type theory
            = succeed ":" do
              %a{:href => "#RSS"} Rijke, Shulman, Spitters 17
          %ul
            %li
              Higher modality: A modality consists of a modal operator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo :
                    %mi Type
                    %mo →
                    %mi Type
                  %annotation{:encoding => "application/x-tex"} L : {Type} \to {Type}
              and for every type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a modal unit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi L
                    %mo :
                    %mi X
                    %mo →
                    %mi LX
                  %annotation{:encoding => "application/x-tex"} (-)^L : X \to LX
              together with
          %ol
            %li
              %p an induction principle of type
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mtext ind
                      %mo :
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo :
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi LB
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi a
                        %mi L
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mi u
                      %mo :
                      %mi LA
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi LB
                      %mo{:stretchy => "false"} (
                      %mi u
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \text{ind} : ((a : A) \to LB(a^L)) \to ((u : LA) \to LB(u))
              %p
                for any type
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                and type
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
                depending on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi LA
                    %annotation{:encoding => "application/x-tex"} LA
            %li
              %p a computation rule
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mtext com
                      %mo :
                      %mtext ind
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi a
                        %mi L
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo .
                    %annotation{:encoding => "application/x-tex"} \text{com} : \text{ind}(f)(a^L) = f(a).
            %li
              %p
                a witness that for any
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ,
                        %mi y
                        %mo :
                        %mi LA
                      %annotation{:encoding => "application/x-tex"} x, y : LA
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi L
                      %mo :
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo =
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi L
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo =
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (-)^L : (x = y) \to L(x = y)
                is an equivalence.
          %ul
            %li
              %p Uniquely eliminating modality: A modality consists of a modal operator and modal unit such that operation
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ↦
                      %mi f
                      %mo ∘
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi L
                      %mo :
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mi u
                      %mo :
                      %mi LA
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi LB
                      %mo{:stretchy => "false"} (
                      %mi u
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo :
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi LB
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi a
                        %mi L
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f \mapsto f \circ (-)^L : ((u : LA) \to LB(u)) \to ((a : A) \to LB(a^L))
              %p
                is an equivalence for all types
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                and types
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
                depending on
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi LA
                      %annotation{:encoding => "application/x-tex"} LA
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
                \-closed reflective subuniverse (aka localization): A reflective subuniverse (a.k.a. localization) consists of a proposition
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi isLocal
                      %mo :
                      %mi Type
                      %mo →
                      %mi Prop
                    %annotation{:encoding => "application/x-tex"} isLocal : {Type} \to {Prop}
                together with an operator
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mo :
                      %mi Type
                      %mo →
                      %mi Type
                    %annotation{:encoding => "application/x-tex"} L : {Type} \to {Type}
                and a unit
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi L
                      %mo :
                      %mi X
                      %mo →
                      %mi LX
                    %annotation{:encoding => "application/x-tex"} (-)^L : X \to LX
                such that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi LX
                    %annotation{:encoding => "application/x-tex"} LX
                is local for any type
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                and for any local type
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Z
                      %annotation{:encoding => "application/x-tex"} Z
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ↦
                      %mi f
                      %mo ∘
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi L
                      %mo :
                      %mo{:stretchy => "false"} (
                      %mi LA
                      %mo →
                      %mi Z
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo →
                      %mi Z
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f \mapsto f \circ (-)^L : (LA \to Z) \to (A \to Z)
              %p
                is an equivalence. A localization is
                = succeed "-closed" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Σ
                      %annotation{:encoding => "application/x-tex"} \Sigma
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                is local and for all
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo :
                        %mi A
                      %annotation{:encoding => "application/x-tex"} a : A
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} B(a)
                is local, then the dependent sum
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Σ
                        %mrow
                          %mi a
                          %mo :
                          %mi A
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Sigma_{a : A} B(a)
                is local.
            %li
              %p
                Stable factorization systems: A modality consists of an orthogonal factorization system
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi ℒ
                      %mo ,
                      %mi ℛ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\mathcal{L}, \mathcal{R})
                in which the left class is stable under pullback.
            %li
              %p
                A localization (reflective subuniverse) whose units
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi L
                      %mo :
                      %mi X
                      %mo →
                      %mi LX
                    %annotation{:encoding => "application/x-tex"} (-)^L : X \to LX
                are
                = succeed "-connected." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                      %annotation{:encoding => "application/x-tex"} L
          %p
            We say that a type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is
            = succeed "-modal" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi L
                  %mo :
                  %mi X
                  %mo →
                  %mi LX
                %annotation{:encoding => "application/x-tex"} (-)^L : X \to LX
            is an equivalence. We say a type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            = succeed "-connected" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi LX
                %annotation{:encoding => "application/x-tex"} LX
            is contractible.
          %p
            In terms of the other structure, the stable factorization system associated to a modality
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            has
          %ul
            %li
              %p
                left class the
                = succeed "-connected" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                      %annotation{:encoding => "application/x-tex"} L
                = succeed "-connected." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                      %annotation{:encoding => "application/x-tex"} L
            %li
              %p
                right class the
                = succeed "-modal" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                      %annotation{:encoding => "application/x-tex"} L
                = succeed "-modal." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                      %annotation{:encoding => "application/x-tex"} L
          %p Conversely, given a stable factorization system, the modal operator and unit are given by factorizing the terminal map.
          %h3#Notation Notation
          %p
            Typical notation (e.g.
            = succeed "," do
              %a{:href => "#SEP"} SEP
            = succeed "," do
              %a{:href => "#Reyes91"} Reyes 91
            = succeed ")" do
              %a{:href => "#Hermida10"} Hermida 10
          %ul
            %li
              %p
                a co-modality represented by a
                %a.existingWikiWord{:href => "/nlab/show/comonad"} comonad
                (perhaps idempotent) is typically denoted by
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo □
                      %annotation{:encoding => "application/x-tex"} \Box
                %em
                  %a.existingWikiWord{:href => "/nlab/show/necessity"} necessity
                in
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/modal+logic"} modal logic
            %li
              %p
                a modality represented by a
                %a.existingWikiWord{:href => "/nlab/show/monad"} monad
                (perhaps idempotent) is typically denoted by
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ◊
                    %annotation{:encoding => "application/x-tex"} \lozenge
                or (less often) by
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ◯
                      %annotation{:encoding => "application/x-tex"} \bigcirc
                %em
                  %a.existingWikiWord{:href => "/nlab/show/possibility"} possibility
                in
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/modal+logic"} modal logic
          %p
            When
            %a.existingWikiWord{:href => "/nlab/show/adjunctions"} adjunctions
            between modalities matter (
            %a.existingWikiWord{:href => "/nlab/show/adjoint+modalities"}> adjoint modalities
            ), then some authors (
            %a{:href => "#Reyes91"} Reyes 91, p. 367
            = succeed "," do
              %a{:href => "#ReyesEtAl"} RRZ 04, p. 116
            = succeed ")" do
              %a{:href => "#Hermida10"} Hermida 10, p.11
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ◊
                %annotation{:encoding => "application/x-tex"} \lozenge
            for a
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            of a
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo □
                  %annotation{:encoding => "application/x-tex"} \Box
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ◯
                %annotation{:encoding => "application/x-tex"} \bigcirc
            as the natural choice of notation for a
            %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            (if any) of a
            = succeed "-modality." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo □
                  %annotation{:encoding => "application/x-tex"} \Box
          %p
            This way for instance for
            %a.existingWikiWord{:href => "/nlab/show/cohesion"} cohesion
            with
            %a.existingWikiWord{:href => "/nlab/show/shape+modality"} shape modality
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊣
                %annotation{:encoding => "application/x-tex"} \dashv
            %a.existingWikiWord{:href => "/nlab/show/flat+modality"} flat comodality
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊣
                %annotation{:encoding => "application/x-tex"} \dashv
            %a.existingWikiWord{:href => "/nlab/show/sharp+modality"} sharp modality
            the generic notation would be:
          .maruku-equation
