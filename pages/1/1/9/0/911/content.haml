            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                  %mo :
                  %msub
                    %mi d
                    %mn 1
                  %mo →
                  %msub
                    %mi d
                    %mn 2
                %annotation{:encoding => "application/x-tex"} u:d_1\to d_2
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
