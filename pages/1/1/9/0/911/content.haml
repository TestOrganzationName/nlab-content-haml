                      %mstyle{:mathvariant => "bold"}
                        %mi Cat
                    %annotation{:encoding => "application/x-tex"} \mathcal{C} \xrightarrow{F} \mathbf{Set} \xrightarrow{disc} \mathbf{Cat}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Grothendieck+construction"} Grothendieck construction
          %p
            When
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            is a
            %a.existingWikiWord{:href => "/nlab/show/concrete+category"} concrete category
            and the functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi 𝒞
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi Set
                %annotation{:encoding => "application/x-tex"} F:\mathcal{C}\to \mathbf{Set}
            is simply the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Explode
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %msub
                    %mi El
                    %mi F
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Explode(-) \coloneqq El_F(-)
                  \\,.
          %p This is intended to illustrate the concept that constructing a category of elements is like “unpacking” or “exploding” a category into its elements.
          %h2#properties Properties
          %p
            The category of elements defines a functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi el
                    %mo :
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Set
                      %mi 𝒞
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi Cat
                  %annotation{:encoding => "application/x-tex"} el : \mathbf{Set}^{\mathcal{C}} \to \mathbf{Cat}
          #ColimitPreserving.num_theorem
            %h6#theorem Theorem
            %p
              The functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi el
                    %mo :
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Set
                      %mi 𝒞
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi Cat
                  %annotation{:encoding => "application/x-tex"} el : \mathbf{Set}^{\mathcal{C}} \to \mathbf{Cat}
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cocontinuous+functor"} cocontinuous
          .proof
            %h6#proof Proof
            %p
              As remarked above,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi el
                  %annotation{:encoding => "application/x-tex"} el
              is a strict
              %a.existingWikiWord{:href => "/nlab/show/weighted+colimit"} weighted
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/2-colimit"} 2-colimit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi el
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≅
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mo ∫
                      %mrow
                        %mi c
                        %mo ∈
                        %mi 𝒞
                    %mi J
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi disc
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    el(F)
                    \\;\cong\;
                    \\int^{c\in \mathcal{C}}
                    J(c) \times disc\big(F(c)\big)
                    \\,,
            %p
              where the weight
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                    %mo :
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi Cat
                  %annotation{:encoding => "application/x-tex"} J:\mathcal{C}^{op} \to \mathbf{Cat}
              is the functor
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo ↦
                      %mi c
                      %mo{:stretchy => "false"} /
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} c\mapsto c/\mathcal{C}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi disc
                    %mo :
                    %mstyle{:mathvariant => "bold"}
                      %mi Set
                    %mo ↪
                    %mstyle{:mathvariant => "bold"}
                      %mi Cat
                  %annotation{:encoding => "application/x-tex"} disc:\mathbf{Set}\hookrightarrow \mathbf{Cat}
              is the inclusion of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/discrete+categories"} discrete categories
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi disc
                  %annotation{:encoding => "application/x-tex"} disc
              (regarded purely as a 1-functor) has a right adjoint (the functor which sends a -small- category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              into its set of elements
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒞
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}_0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} el
                  %annotation{:encoding => "application/x-tex"} \el
              also preserves colimits.
          #ColimitPreserving2.num_theorem
            %h6#theorem_2 Theorem
            %p
              The functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi el
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Set
                      %mi 𝒞
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi Cat
                  %annotation{:encoding => "application/x-tex"} el\colon \mathbf{Set}^{\mathcal{C}} \to \mathbf{Cat}
              has a right adjoint (which is maybe a more direct way to see that it is cocontinuous).
          .proof
            %h6#proof_2 Proof
            %p
              By a simple
              %a.existingWikiWord{:href => "/nlab/show/coend"} coend
              computation:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi Cat
                            %mo{:stretchy => "false"} (
                            %mi el
                            %mo{:stretchy => "false"} (
                            %mi F
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi D
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≅
                            %mstyle{:mathvariant => "bold"}
                              %mi Cat
                            %mrow
                              %mo (
                              %msup
                                %mo ∫
                                %mi c
                              %mi J
                              %mi c
                              %mo ×
                              %mi δ
                              %mo{:stretchy => "false"} (
                              %mi F
                              %mi c
                              %mo{:stretchy => "false"} )
                              %mo ,
                              %mi D
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≅
                            %msub
                              %mo ∫
                              %mi c
                            %mstyle{:mathvariant => "bold"}
                              %mi Cat
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mi J
                            %mi c
                            %mo ×
                            %mi δ
                            %mo{:stretchy => "false"} (
                            %mi F
                            %mi c
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi D
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≅
                            %msub
                              %mo ∫
                              %mi c
                            %mstyle{:mathvariant => "bold"}
                              %mi Set
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mi F
                            %mi c
                            %mo ,
                            %mo{:stretchy => "false"} [
                            %mi J
                            %mi c
                            %mo ,
                            %mi D
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mn 0
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≅
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi Set
                              %mi 𝒞
                            %mo{:stretchy => "false"} (
                            %mi F
                            %mo ,
                            %mi K
                            %mo{:stretchy => "false"} (
                            %mi D
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\mathbf{Cat}(el(F),D)&amp;\cong \mathbf{Cat}\left(  \int^c J c\times\delta(F  c), D\right)\\ &amp;\cong \int_c\mathbf{Cat}\big(J c\times \delta(F c),D\big)\\
                    \&amp;\cong \int_c \mathbf{Set}\big(F c,[J c,D]_0\big)\\
                    \&amp;\cong \mathbf{Set}^{\mathcal{C}}(F, K(D))
                    \\end{aligned}
            %p
              where
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                      %mo{:stretchy => "false"} (
                      %mi D
                      %mo{:stretchy => "false"} )
                      %mo{:lspace => "verythinmathspace"} :
                      %mi c
                      %mo ↦
                      %mo{:stretchy => "false"} [
                      %mi J
                      %mi c
                      %mo ,
                      %mi D
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} K(D)\colon c\mapsto [J c,D]_0
          %p
            Now for any
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi Set
                    %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathbf{Set}^\mathcal{C}
            is the functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mn 1
                %annotation{:encoding => "application/x-tex"} \Delta 1
            constant at the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/point"} point
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mn 1
                %annotation{:encoding => "application/x-tex"} \Delta 1
            is easily seen to be just
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            itself, so the unique transformation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo →
                  %mi Δ
                  %mn 1
                %annotation{:encoding => "application/x-tex"} F\to \Delta 1
            induces a
            %em projection functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mi F
                  %mo :
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} el
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \pi_F: \el(F) \to \mathcal{C}
            defined by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mi c
                %annotation{:encoding => "application/x-tex"} (c,x)\mapsto c
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo ↦
                    %mi u
                  %annotation{:encoding => "application/x-tex"} u\mapsto u
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/discrete+opfibration"} discrete opfibration
            = succeed "-indexed" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/family+of+sets"} family of sets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} el
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \el(F)
            as equipped with
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi F
                  %annotation{:encoding => "application/x-tex"} \pi_F
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi Set
                    %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathbf{Set}^\mathcal{C}
            into
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Cat
                    %mo{:stretchy => "false"} /
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathbf{Cat}/\mathcal{C}
          %p
            Note that the canonical projection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} El
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                %annotation{:encoding => "application/x-tex"} \operatorname{El}(F) \to \mathbf{C}
            is not usually
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/full+functor"} full
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} \mathbf{B}\mathbb{N}
            be the one-object category which carries the monoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi ℕ
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathbb{N}, +)
            as its endomorphism monoid, and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            be the action of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi ℕ
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathbb{N}, +)
            on the set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} \mathbb{N}
            by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo .
                    %mi m
                    %mo =
                    %mi m
                    %mo +
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n.m = m + n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo ,
                  %mi k
                  %mo ′
                %annotation{:encoding => "application/x-tex"} k, k'
            is a subsingleton subset of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \mathbb{N}
          %p
            More generally, the
            %a.existingWikiWord{:href => "/nlab/show/universal+covering+groupoid"} universal covering groupoid
            of a groupoid is just the category of elements of its action on itself by composition. Since this action is faithful and transitive, hom-sets in the category of elements are always
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            or
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
          %p
          .num_prop
            %h6 Proposition
            %p
              The category of elements of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              has an
              %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
              if and only if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representable functor
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo ∈
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (i \in F(x))
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is isomorphic to the functor
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi hom
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \hom(x,-)
          %h2#examples Examples
          %h3#representable_presheaves Representable Presheaves
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msup
                    %mi 𝒞
                    %mi op
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi Set
                %annotation{:encoding => "application/x-tex"} Y(c):\mathcal{C}^{op}\to \mathbf{Set}
            be a
            %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representable presheaf
            with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Y(c)(d)=Hom_{\mathcal{C}}(d,c)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mi 𝒞
                  %mi Y
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \int_\mathcal{C} Y(c)
            \. This has objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
