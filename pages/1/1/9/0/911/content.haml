                %annotation{:encoding => "application/x-tex"} (d_1, p_1)
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi d
                    %mn 2
                  %mo ,
                  %msub
                    %mi p
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (d_2, p_2)
