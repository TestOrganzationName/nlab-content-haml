          .num_prop
            %h6#proposition Proposition
            %p
              The strong monad structures obtained from monoidal monads via Def.
              %a.maruku-ref{:href => "#StrengthFromMonoidalness"}
              are
              %a.existingWikiWord{:href => "/nlab/show/commutative+monads"} commutative monads
              (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#CommutativeMonad"}
          .proof
            %h6#proof Proof
            %p In fact, the two composites
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
