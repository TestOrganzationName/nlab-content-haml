                %use{:x => "75.103919", "xlink:href" => "#Z0it8Zyx7sl8QfGwqixQYSagtso=-glyph3-2", :y => "10.04029"}
              %path{:d => "M 25.927567 -0.000162658 L 52.728801 -0.000162658 ", :style => "fill:none;stroke-width:0.79701;stroke-linecap:butt;stroke-linejoin:miter;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(0.990655,0,0,-0.990655,133.599878,15.640464)"}
              %path{:d => "M -4.142862 4.782815 C -3.385787 1.91224 -1.698141 0.559757 0.0013336 -0.000162658 C -1.698141 -0.556139 -3.385787 -1.912565 -4.142862 -4.78314 ", :style => "fill:none;stroke-width:0.79701;stroke-linecap:round;stroke-linejoin:round;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(0.990655,0,0,-0.990655,186.229148,15.640464)"}
              %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                %use{:x => "168.584866", "xlink:href" => "#Z0it8Zyx7sl8QfGwqixQYSagtso=-glyph4-2", :y => "11.96018"}
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                %annotation{:encoding => "application/x-tex"} \nabla
            is the monoidal multiplication of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
          %ul
            %li
              The associator and unitor are induced by those of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
          %h2#examples Examples
          %p
            See
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/commutative+monad#examples"} examples of commutative monads
          %h2#see_also See also
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/strong+monad"}> strong monad
              ,
              %a.existingWikiWord{:href => "/nlab/show/tensorial+strength"} tensorial strength
            %li
              %a.existingWikiWord{:href => "/nlab/show/monoidal+functor"} monoidal functor
            %li
              %a.existingWikiWord{:href => "/nlab/show/commutative+monad"}> commutative monad
              ,
              %a.existingWikiWord{:href => "/nlab/show/commutative+algebraic+theory"} commutative algebraic theory
          %h2#References References
          %p The definition originally appears inside statement and proof of Thm. 3.2 in:
          %ul
            %li#Kock70
              %a.existingWikiWord{:href => "/nlab/show/Anders+Kock"}> Anders Kock
              ,
              = succeed "," do
                %em Monads on symmetric monoidal closed categories
              %strong 21
              (1970) 1-10 &amp;lbrack;
              %a{:href => "https://doi.org/10.1007/BF01220868"}> doi:10.1007/BF01220868
              \&amp;rbrack;
          %p
            establishing right away the relation to
            %a.existingWikiWord{:href => "/nlab/show/commutative+monads"} commutative
            %a.existingWikiWord{:href => "/nlab/show/strong+monads"} strong monads
            (in the case that the underlying
            %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            is
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+closed+category"} symmetric monoidal closed
          %ul
            %li#Kock71
              %p
                %a.existingWikiWord{:href => "/nlab/show/Anders+Kock"}> Anders Kock
                ,
                = succeed "," do
                  %em Closed categories generated by commutative monads
                %strong 12
                4 (1971) 405-424 &amp;lbrack;
                %a{:href => "https://doi.org/10.1017/S1446788700010272"}> doi:10.1017/S1446788700010272
                ,
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/KockMonoidalMonads.pdf", :title => "pdf"} pdf
            %li#Kock72
              %p
                %a.existingWikiWord{:href => "/nlab/show/Anders+Kock"}> Anders Kock
                ,
                = succeed "," do
                  %em Strong functors and monoidal monads
                %strong 23
                (1972) 113–120 &amp;lbrack;
                %a{:href => "https://doi.org/10.1007/BF01304852"}> doi:10.1007/BF01304852
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://tildeweb.au.dk/au76680/SFMM.pdf"} pdf
          %p Further discussion:
          %ul
            %li#Lindner75
              %p
                H. Lindner,
                %em Commutative monads
                in:
                %em Deuxiéme colloque sur l’algébre des catégories
                Amiens-1975. Résumés des conférences, pages 283-288. Cahiers de topologie et géométrie différentielle catégoriques, tome 16, nr. 3 (1975) &amp;lbrack;
                %a{:href => "http://www.numdam.org/item/CTGDC_1975__16_3_217_0"}> numdam:CTGDC_1975__16_3_217_0
                ,
                = succeed "&rbrack;" do
                  %a{:href => "http://www.numdam.org/article/CTGDC_1975__16_3_217_0.pdf"} pdf
            %li#Keigher78
              %p
                %a.existingWikiWord{:href => "/nlab/show/William+Keigher"}> William Keigher
                ,
                = succeed "," do
                  %em Symmetric monoidal closed categories generated by commutative adjoint monads
                = succeed "," do
                  %a{:href => "http://www.numdam.org/numdam-bin/fitem?id=CTGDC_1978__19_3_269_0"} numdam:CTGDC_1978__19_3_269_0
                = succeed "&rbrack;" do
                  %a{:href => "http://archive.numdam.org/article/CTGDC_1978__19_3_269_0.pdf"} pdf
            %li
              %p
                Kosta Dosen, Zoran Petric,
                = succeed "," do
                  %em Coherence for Monoidal Monads and Comonads
                %strong 20
                4 (2010) 545-561 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/0907.2199"}> arXiv:0907.2199
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1017/S0960129510000034"} doi:10.1017/S0960129510000034
            %li#Seal12
              %p
                %a.existingWikiWord{:href => "/nlab/show/Gavin+J.+Seal"}> Gavin J. Seal
                ,
                = succeed "," do
                  %em Tensors, monads and actions
                %strong 28
                15 (2013) 403-434. &amp;lbrack;
                %a{:href => "http://arxiv.org/abs/1205.0101"}> arXiv:1205.0101
                ,
                = succeed "&rbrack;" do
                  %a{:href => "http://www.tac.mta.ca/tac/volumes/28/15/28-15abs.html"} tac:28-15
              %blockquote
                %p
                  (on the
                  %a.existingWikiWord{:href => "/nlab/show/Eilenberg-Moore+categories"} Eilenberg-Moore categories
                  of monoidal monads)
            %li#Brandenburg2014
              %p
                %a.existingWikiWord{:href => "/nlab/show/Martin+Brandenburg"}> Martin Brandenburg
                ,
                %em Tensor categorical foundations of algebraic geometry
                (
                %a{:href => "https://arxiv.org/abs/1410.1716"}> arXiv:1410.1716
                )
            %li#McDermottUustalu22
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dylan+McDermott"}> Dylan McDermott
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Tarmo+Uustalu"} Tarmo Uustalu
                = succeed "," do
                  %em What Makes a Strong Monad?
                %strong 360
                (2022) 113-133 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2207.00851"}> arXiv:2207.00851
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.4204/EPTCS.360.6"} doi:10.4204/EPTCS.360.6
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paolo+Perrone"}> Paolo Perrone
                ,
                = succeed "," do
                  %em Starting Category Theory
                = succeed ")" do
                  %a{:href => "https://www.worldscientific.com/worldscibooks/10.1142/13670"} website
          %p
            Formalisation in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/cubical+Agda"} cubical Agda
          %ul
            %li#1Lab
              %a.existingWikiWord{:href => "/nlab/show/1lab"}> 1lab
              ,
              %em
                %a{:href => "https://1lab.dev/Cat.Monoidal.Monad.html"} Monoidal monads
          %p
            Discussion in the context of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/monads+in+computer+science"} monads in computer science
          %ul
            %li#GLLN08
              %a.existingWikiWord{:href => "/nlab/show/Jean+Goubault-Larrecq"}> Jean Goubault-Larrecq
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Slawomir+Lasota"} Slawomir Lasota
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/David+Nowak"} David Nowak
              = succeed "," do
                %em Logical Relations for Monadic Types
              %strong 18
              6 (2008) 1169-1217 &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/cs/0511006"}> arXiv:cs/0511006
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1017/S0960129508007172"} doi:10.1017/S0960129508007172
          %p A statement in the above text is from
          %ul
            %li#support
              %a.existingWikiWord{:href => "/nlab/show/Tobias+Fritz"}> Tobias Fritz
              ,
              %a.existingWikiWord{:href => "/nlab/show/Paolo+Perrone"} Paolo Perrone
              and Sharwin Rezagholi, Appendix C of:
              = succeed "," do
                %em Probability, valuations, hyperspace: Three monads on Top and the support as a morphism
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/1910.03752"} arXiv:1910.03752
