            %p
          %h4#from_monoidal_to_commutative_strong_monads From monoidal to commutative strong monads
          %p
          #StrengthFromMonoidalness.num_defn
            %h6 Definition
            %p
              %strong (strength from monoidalness)
              %br/
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
