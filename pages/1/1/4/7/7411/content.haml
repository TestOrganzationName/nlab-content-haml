                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ⊗
                    %mi T
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %mi T
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi τ
                          %mrow
                            %mi A
