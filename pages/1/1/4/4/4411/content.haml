              satisfies an equation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mi n
                    %mo +
                    %msub
                      %mi a
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %msup
                      %mi x
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo +
                    %mi …
                    %mo +
                    %msub
                      %mi a
                      %mn 0
                    %mo =
                    %mn 0
