                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mi y
                  %mo −
                  %mn 17
                  %mo =
                  %mn 0
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} f(x) = max \{y: y^5 - (e^{e^x - (\log x)^2 + 1/x})y^2 + \log(1 + x^{\sqrt{2}}))y - 17 = 0\}
          %p
            and many, many more. Of interest are
            %em rates of growth
            (cf.
            = succeed ")" do
              %span.newWikiWord
                O notation
                %a{:href => "/nlab/new/O+notation"} ?
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ≤
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f(x) \leq g(x)
            when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            is large. A quite remarkable and deep fact is the following:
          .un_thm
            %h6#theorem_2 Theorem
            %p
              Any such definable function is either positive for all sufficiently large
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
              for all sufficiently large
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
          %p
            This theorem implies that the germs at infinity of such functions (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mo ∼
                %annotation{:encoding => "application/x-tex"} \sim
            \-equivalence classes of functions where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ∼
                  %mi g
                %annotation{:encoding => "application/x-tex"} f \sim g
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f(x) = g(x)
            for all sufficiently large
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/ordered+field"} ordered field
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/real+closed+field"} real closed field
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mo −
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mi x
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} 2 - [1/x]
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo +
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mi log
                    %mi log
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} 1 + [1/\log \log(x)]
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi e
                      %mi x
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [e^x]
          %p
            Sitting inside this field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Germ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi ℝ
                    %mi exp
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Germ(\mathbb{R}_{exp})
            is the valuation ring of germs of bounded definable functions—in other words, the ring of finite “numbers”, which contains infinitesimals of incredibly rich variety.
          %p
            Such examples are close in spirit to
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/hyperreal+number"} hyperreal number
            %em all
            functions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℕ
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{N} \to \mathbb{R}
            in the neighborhood of a non-principal ultrafilter on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \mathbb{N}
            %a.existingWikiWord{:href => "/nlab/show/ultrapower"} ultrapower
            of the standard real numbers. Again, the finite hyperreals form a valuation ring sitting inside.
          %h2#the_valuation_function The valuation function
          %p (also called multiplicative or exponential valuation)
          %p
            The nonzero elements of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            may be partially ordered as follows: write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ≤
                  %mi y
                %annotation{:encoding => "application/x-tex"} x \leq y
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo{:stretchy => "false"} /
                  %mi y
                %annotation{:encoding => "application/x-tex"} x/y
            belongs to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                  %annotation{:encoding => "application/x-tex"} O
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                %annotation{:encoding => "application/x-tex"} y
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo{:stretchy => "false"} /
                      %mi y
                    %annotation{:encoding => "application/x-tex"} x/y
                is a non-unit of
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi O
                      %annotation{:encoding => "application/x-tex"} O
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo{:stretchy => "false"} /
                      %mi y
                    %annotation{:encoding => "application/x-tex"} x/y
                is a unit of
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi O
                      %annotation{:encoding => "application/x-tex"} O
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo{:stretchy => "false"} /
                      %mi y
                    %annotation{:encoding => "application/x-tex"} x/y
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo{:stretchy => "false"} /
                      %mi x
                    %annotation{:encoding => "application/x-tex"} y/x
                belong to
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi O
                      %annotation{:encoding => "application/x-tex"} O
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo{:stretchy => "false"} /
                      %mi x
                    %annotation{:encoding => "application/x-tex"} y/x
                is a non-unit of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi O
                      %annotation{:encoding => "application/x-tex"} O
          %p
            We call this the
            = succeed "." do
              %em trichotomy law
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi O
                    %mo *
                %annotation{:encoding => "application/x-tex"} O^*
            for the units of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                  %annotation{:encoding => "application/x-tex"} O
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi K
                    %mo *
                %annotation{:encoding => "application/x-tex"} K^*
            descends to a
            %a.existingWikiWord{:href => "/nlab/show/total+order"} total order
            on the quotient group
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo =
                    %msup
                      %mi K
                      %mo *
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi O
                      %mo *
                  %annotation{:encoding => "application/x-tex"} G = K^*/O^*
            %strong value group
            of the valuation ring
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                  %annotation{:encoding => "application/x-tex"} O
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi O
                %annotation{:encoding => "application/x-tex"} O
            is called a
            = succeed "." do
              %strong discrete valuation ring
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+integer"} algebraic integer
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi O
                %annotation{:encoding => "application/x-tex"} O
            with respect to a prime ideal
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝓅
                  %annotation{:encoding => "application/x-tex"} \mathcal{p}
            = succeed "-adic" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝓅
                  %annotation{:encoding => "application/x-tex"} \mathcal{p}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi O
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi 𝓅
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} O_{(\mathcal{p})}
          %p
            We may then define a
            %strong valuation
            function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                  %mo :
                  %mi K
                  %mo →
                  %msup
                    %mi K
                    %mo *
                  %mo{:stretchy => "false"} /
                  %msup
                    %mi O
                    %mo *
                  %mo ∪
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} v: K \to K^*/O^* \cup \{0\}
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} v(x)
            is the coset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %msup
                    %mi O
                    %mo *
                %annotation{:encoding => "application/x-tex"} x O^*
            if
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %msup
                      %mi K
                      %mo *
                  %annotation{:encoding => "application/x-tex"} x \in K^*
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} v(0) = 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            is regarded as the bottom element and is
            %em absorbent
            (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mi x
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0 x = 0
            for all
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
          %ol
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} v(x) = 0
                if and only if
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} x = 0
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi v
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi v
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mi v
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} v(x y) = v(x)v(y)
                ;
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo +
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo ≤
                      %mi max
                      %mo{:stretchy => "false"} {
                      %mi v
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi v
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} v(x + y) \leq \max \{v(x), v(y)\}
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                    %annotation{:encoding => "application/x-tex"} v
                is surjective.
          %h3#example_rates_of_growth Example: rates of growth
          %p
            Let us return to our earlier example of a valuation ring
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                  %annotation{:encoding => "application/x-tex"} O
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi f
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [f]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi g
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [g]
            have the same coset,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi f
                    %mo{:stretchy => "false"} ]
                    %msup
                      %mi O
                      %mo *
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mi g
                    %mo{:stretchy => "false"} ]
                    %msup
                      %mi O
                      %mo *
                  %annotation{:encoding => "application/x-tex"} [f]O^* = [g]O^*
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi f
                  %mo{:stretchy => "false"} /
                  %mi g
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [f/g]
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi g
                  %mo{:stretchy => "false"} /
                  %mi f
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [g/f]
            are bounded. But this is precisely to say
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} O(g)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            is
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} O(f)
          %p
            Thus, the elements of the value group in this case can be described as the various “rates of growth” of definable functions. The order relation is that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi f
                  %mo{:stretchy => "false"} ]
                  %msup
                    %mi O
                    %mo *
                  %mo ≤
                  %mo{:stretchy => "false"} [
                  %mi g
                  %mo{:stretchy => "false"} ]
                  %msup
                    %mi O
                    %mo *
                %annotation{:encoding => "application/x-tex"} [f]O^* \leq [g]O^*
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} O(g)
          %p
            Rates of growth, as elements of the value group
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi K
                      %mo *
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi O
                      %mo *
                  %annotation{:encoding => "application/x-tex"} K^*/O^*
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            would correspond to rates of growth of power functions
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mi a
                  %annotation{:encoding => "application/x-tex"} x^a
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi log
                  %mi x
                %annotation{:encoding => "application/x-tex"} \log x
            is infinitesimal and the rate of growth of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi e
                    %mi x
                %annotation{:encoding => "application/x-tex"} e^x
            is infinite. The fact that rates of growth of definable functions are totally ordered is essentially due to G.H. Hardy, and in his honor, fields of germs of definable functions are frequently called “Hardy fields”.
          %ul
            %li Hardy actually studied the class of functions definable from polynomials, exponential, and logarithmic functions using the four arithmetic operations and composition. This of course is a small subclass of the definable functions considered above, but contains all functions likely to be of interest in analytic number theory (for example).
          %h2#valuation_rings_from_valuation_functions Valuation rings from valuation functions
          %p
            Quite generally, we may define a
            %strong valuation
            on a field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            to be a function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                  %mo :
                  %mi K
                  %mo →
                  %mi G
                  %mo ∪
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} v: K \to G \cup \{0\}
          %p
            (where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is a totally ordered group, extended to a totally ordered monoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo ∪
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} G \cup \{0\}
            as above), satisfying conditions 1 - 4 listed above. Two valuations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                %annotation{:encoding => "application/x-tex"} v
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                  %mo ′
                %annotation{:encoding => "application/x-tex"} v'
            are
            %strong equivalent
            if there is an isomorphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo :
                  %mi G
                  %mo ∪
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo{:stretchy => "false"} }
                  %mo →
                  %mi G
                  %mo ′
                  %mo ∪
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \phi: G \cup \{0\} \to G' \cup \{0\}
          %p
            of totally ordered monoids such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ′
                    %mo =
                    %mi ϕ
                    %mo ∘
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v' = \phi \circ v
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                %annotation{:encoding => "application/x-tex"} v
            may be
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/preorder"} preordered
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                %annotation{:encoding => "application/x-tex"} v
            as a special sort of group homomorphism
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo :
                    %msup
                      %mi K
                      %mo *
                    %mo →
                    %mi G
                  %annotation{:encoding => "application/x-tex"} v: K^* \to G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                  %mo ≤
                  %mi v
                  %mo ′
                %annotation{:encoding => "application/x-tex"} v \leq v'
            if there is a surjective homomorphism of ordered groups
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo :
                  %mi G
                  %mo →
                  %mi G
                  %mo ′
                %annotation{:encoding => "application/x-tex"} \phi: G \to G'
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ′
                    %mo =
                    %mi ϕ
                    %mo ∘
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v' = \phi \circ v
          %p
            From the data of a valuation on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi O
                    %mi v
                %annotation{:encoding => "application/x-tex"} O_v
            inside
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi O
                    %mi v
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi x
                  %mo ∈
                  %mi K
                  %mo :
                  %mi v
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ≤
                  %mn 1
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} O_v = \{x \in K: v(x) \leq 1\}
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            is the identity element of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi O
                    %mi v
                %annotation{:encoding => "application/x-tex"} O_v
            is a ring follows straightforwardly from the axioms 1 - 3, and that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi O
                    %mi v
                %annotation{:encoding => "application/x-tex"} O_v
            is a valuation ring follows from the fact that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is totally ordered.)
          %p In summary, we have the following result whose proof is straightforward:
          .un_prop
            %h6#proposition_3 Proposition
            %p
              There is a natural bijective correspondence between equivalence classes of valuations on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              and valuation rings in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
          %p To express the naturality more precisely: there are two functors
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo :
                  %msup
                    %mi Field
                    %mi op
                  %mo →
                  %mi Pos
                  %mo ,
                  %mspace{:width => "2em"}
                  %mi V
                  %mo ′
                  %mo :
                  %msup
                    %mi Field
                    %mi op
                  %mo →
                  %mi Pos
                %annotation{:encoding => "application/x-tex"} V: Field^{op} \to Pos, \qquad V': Field^{op} \to Pos
          %p
            from fields to posets. Here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            assigns to a field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            the poset of equivalence classes of valuations on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo ′
                %annotation{:encoding => "application/x-tex"} V'
            assigns to a field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            the poset of valuation rings inside
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo :
                  %mi K
                  %mo →
                  %mi K
                  %mo ′
                %annotation{:encoding => "application/x-tex"} i: K \to K'
            is a field homomorphism, then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo ′
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi V
                  %mo ′
                  %mo{:stretchy => "false"} (
                  %mi K
                  %mo ′
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi V
                  %mo ′
                  %mo{:stretchy => "false"} (
                  %mi K
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} V'(i): V'(K') \to V'(K)
            takes a valuation ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi O
                  %mo ′
                  %mo ⊆
                  %mi K
                %annotation{:encoding => "application/x-tex"} O' \subseteq K
            to the valuation ring
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi i
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi O
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo ⊆
                    %mi K
                  %annotation{:encoding => "application/x-tex"} i^{-1}(O') \subseteq K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} V(i)
            is defined similarly. The proposition asserts that the functors
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo ′
                %annotation{:encoding => "application/x-tex"} V'
            are naturally isomorphic. We freely conflate them, denoting either functor as
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Val
                    %mo :
                    %msup
                      %mi Field
                      %mi op
                    %mo →
                    %mi Pos
                  %annotation{:encoding => "application/x-tex"} Val: Field^{op} \to Pos
          %h3#examples Examples
          %ol
            %li
              %p
                The algebraic notion of a Riemann surface from the 19th century is constructed in a way in which valuations are used to construct points of Riemann surfaces over various fields. See
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Riemann+surface+via+valuations"} Riemann surface via valuations
            %li
              %p
                There is a very general construction which takes as input an arbitrary field
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
                and a totally ordered abelian group
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Hahn+series"} Hahn series
          %h2#equivalent_characterisations Equivalent characterisations
          %p
          .num_prop
            %h6 Proposition
            %p
              (Homological characterisation) For a commutative
              %a.existingWikiWord{:href => "/nlab/show/local+ring"} local ring
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
            %ol
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
                is a valuation ring;
              %li
                all
                %a.existingWikiWord{:href => "/nlab/show/torsion-free"} torsion-free
                = succeed "-modules" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                      %annotation{:encoding => "application/x-tex"} V
              %li
                the
                %span.newWikiWord
                  weak global dimension
                  %a{:href => "/nlab/new/weak+global+dimension"} ?
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
                satisfies
                = succeed "\u202F;" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi wgldim
                        %mo{:stretchy => "false"} (
                        %mi V
                        %mo{:stretchy => "false"} )
                        %mo ≤
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} wgldim(V) \leq 1
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
                is
                = succeed "." do
                  %span.newWikiWord
                    semi-hereditary
                    %a{:href => "/nlab/new/semi-hereditary"} ?
            %p
          %p
          .proof
            %h6 Proof
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mn 1
                    %mo ⇒
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 1 \Rightarrow 2
              \. Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              be a torsion-free
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mn 0
                        %mo ≤
                        %mi i
                        %mo ≤
                        %mi n
                    %msub
                      %mi v
                      %mi i
                    %msup
                      %mi m
                      %mi i
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \sum_{0 \leq i\leq n} v_i m^i = 0
              be a linear relation in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mn 0
                    %mo ∈
                    %mi V
                  %annotation{:encoding => "application/x-tex"} v_0 \in V
              is the element with the minimal valuation. It follows that for every
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} i \gt 0
              ,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mi i
                  %annotation{:encoding => "application/x-tex"} v_i
              is divisible by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} v_0
              in V. Now since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              is torsion-free, it means that we can divide the whole linear equation by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} v_0
              and reduce to the case where
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi v
                        %mn 0
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} v_0 = 1
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi m
                        %mn 0
