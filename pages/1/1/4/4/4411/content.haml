                %annotation{:encoding => "application/x-tex"} \lt
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo =
                  %annotation{:encoding => "application/x-tex"} =
            %a.existingWikiWord{:href => "/nlab/show/logarithm"} logarithm
            function and any function which can be built from
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/polynomials"} polynomials
            = succeed "," do
