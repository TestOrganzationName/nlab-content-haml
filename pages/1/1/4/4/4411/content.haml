                  %mi y
                  %mo :
                  %msup
                    %mi y
                    %mn 5
                  %mo −
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi e
                    %mrow
                      %msup
                        %mi e
                        %mi x
                      %mo −
