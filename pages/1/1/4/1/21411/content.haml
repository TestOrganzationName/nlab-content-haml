                  %msub
                    %mi δ
                    %mrow
                      %mi n
                      %mo ,
                      %mi m
                %annotation{:encoding => "application/x-tex"}
                  \\int_{\mathbb{R}^1}
                  h_{n}(x)
                  h_{m}(x)
                  \\,
                  d x
                  \\;=\;
                  \\delta_{n,m}
          %p
