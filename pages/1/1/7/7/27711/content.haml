              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %ul
            %li
              %p
                Unary bridge types
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi{:mathvariant => "normal"} Br
                          %mi A
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathrm{Br}_A(x)
                = succeed "," do
                  %a{:href => "#BM12"} Bernardy &amp; Moulin 2012
                = succeed "," do
                  %a{:href => "#BCM15"} Bernardy, Coquand, &amp; Moulin 2015
                %a{:href => "#KS23"} Kolomatskaia &amp; Shulman 2023
            %li
              %p
                Binary bridge types
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi{:mathvariant => "normal"} Br
                          %mi A
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathrm{Br}_A(x, y)
                %a{:href => "#CH21"} Cavallo &amp; Harper 2021
          %p
            %a.existingWikiWord{:href => "/nlab/show/Narya"} Narya
            has
            = succeed "-ary" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ≤
                    %mi n
                    %mo ≤
                    %mn 9
                  %annotation{:encoding => "application/x-tex"} 1 \leq n \leq 9
          %p
            Unlike identity types, binary bridge types do not have
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/transport"} transport
          %h3#infinitary_bridge_types Infinitary bridge types
          %p
            There are also bridge types which are not finitary. One such example of “infinitary” bridge types is the bridge types in the
            %a.existingWikiWord{:href => "/nlab/show/internal+logic"} internal
            %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/topos+of+trees"} topos of trees
          %h3#OfArbitraryArity Bridge types of arbitrary arity
          %p
            More generally, one can consider
            = succeed "." do
              %strong
                bridge types of
                %a.existingWikiWord{:href => "/nlab/show/arbitrary+arity"} arbitrary arity
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
            %a.existingWikiWord{:href => "/nlab/show/arity"} arity
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            are parameterized by an
            = succeed "-indexed" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi x
                    %mo ¯
                  %mo :
                  %mi I
                  %mo →
                  %mi A
                  %mo ⊢
                  %msub
                    %mi{:mathvariant => "normal"} Br
                    %mrow
                      %mi I
                      %mo ,
                      %mi A
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi x
                    %mo ¯
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mi{:mathvariant => "normal"} type
                %annotation{:encoding => "application/x-tex"} \overline{x}:I \to A \vdash \mathrm{Br}_{I, A}(\overline{x}) \; \mathrm{type}
          %p
            The
            = succeed "-ary" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            is the standard
            %a.existingWikiWord{:href => "/nlab/show/finite+type"} finite type
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            elements
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} Fin
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi m
                        %mo :
                        %mi ℕ
                    %mi m
                    %mo &lt;
                    %mi n
                  %annotation{:encoding => "application/x-tex"} \mathrm{Fin}(n) \coloneqq \sum_{m:\mathbb{N}} m \lt n
            %a.existingWikiWord{:href => "/nlab/show/induction+principle"} induction principle
            of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/natural+numbers+type"} natural numbers type
          %h2#properties Properties
          %h3#reflexivity Reflexivity
          %p
            Bridge types are
            %em reflexive
            in that for all elements
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} x:A
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} refl
                    %mrow
                      %mi I
                      %mo ,
                      %mi A
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msub
                    %mi{:mathvariant => "normal"} Br
                    %mrow
                      %mi I
                      %mo ,
                      %mi A
                  %mo{:stretchy => "false"} (
                  %mi λ
                  %mi t
                  %mo .
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{refl}_{I, A}(x):\mathrm{Br}_{I, A}(\lambda t.x)
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                  %mi t
                  %mo .
                  %mi x
                  %mo :
                  %mi I
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} \lambda t.x:I \to A
            is the
            %a.existingWikiWord{:href => "/nlab/show/constant+function"} constant function
            which always returns
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mo ≡
                  %mi{:mathvariant => "normal"} bool
                %annotation{:encoding => "application/x-tex"} I \equiv \mathrm{bool}
            the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/type+of+booleans"} type of booleans
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} Br
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{Br}_A(x, y)
            %a.existingWikiWord{:href => "/nlab/show/induction+principle"} induction principle
            of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/type+of+booleans"} type of booleans
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} Br
                    %mrow
                      %mi A
                      %mo ,
                      %mi{:mathvariant => "normal"} bool
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi{:mathvariant => "normal"} rec
                    %mrow
                      %mi{:mathvariant => "normal"} bool
                      %mo ,
                      %mi A
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{Br}_{A, \mathrm{bool}}(\mathrm{rec}_{\mathrm{bool}, A}(x, y))
            is
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+types"} equivalent
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} Br
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{Br}_A(x, y)
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} rec
                      %mrow
                        %mi{:mathvariant => "normal"} bool
                        %mo ,
                        %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %mi λ
                    %mi t
                    %mo .
                    %mi x
                  %annotation{:encoding => "application/x-tex"} \mathrm{rec}_{\mathrm{bool}, A}(x, x) \equiv \lambda t.x
          %h3#function_application Function application
          %p
            In the same way that functions preserve
            %a.existingWikiWord{:href => "/nlab/show/identifications"} identifications
            via
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/function+application+to+identifications"} function application to identifications
            %strong function application to bridges
            or the
            = succeed "." do
              %strong action on bridges
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi x
                    %mo ¯
                  %mo :
                  %mi I
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} \overline{x}:I \to A
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f:A \to B
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %msub
                      %mi{:mathvariant => "normal"} Br
                      %mrow
                        %mi I
                        %mo ,
                        %mi A
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi x
                      %mo ¯
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p:\mathrm{Br}_{I, A}(\overline{x})
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} ap
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mover
                      %mi x
                      %mo ¯
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msub
                      %mi{:mathvariant => "normal"} Br
                      %mrow
                        %mi I
                        %mo ,
                        %mi A
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ∘
                    %mover
                      %mi x
                      %mo ¯
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{ap}(f, \overline{x}, p):\mathrm{Br}_{I, A}(f \circ \overline{x})
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi A
                  %mo →
                  %mi B
                  %mo ,
                  %mover
                    %mi x
                    %mo ¯
                  %mo :
                  %mi I
                  %mo →
                  %mi A
                  %mo ,
                  %mi p
                  %mo :
                  %msub
                    %mi{:mathvariant => "normal"} Br
                    %mrow
                      %mi I
                      %mo ,
                      %mi A
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi x
                    %mo ¯
                  %mo{:stretchy => "false"} )
                  %mo ⊢
                  %mi{:mathvariant => "normal"} ap
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mover
                    %mi x
                    %mo ¯
                  %mo ,
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msub
                    %mi{:mathvariant => "normal"} Br
                    %mrow
                      %mi I
                      %mo ,
                      %mi A
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ∘
                  %mover
                    %mi x
                    %mo ¯
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f:A \to B, \overline{x}:I \to A, p:\mathrm{Br}_{I, A}(\overline{x}) \vdash \mathrm{ap}(f, \overline{x}, p):\mathrm{Br}_{I, A}(f \circ \overline{x})
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mo ≡
                  %mi{:mathvariant => "normal"} bool
                %annotation{:encoding => "application/x-tex"} I \equiv \mathrm{bool}
            the
            %a.existingWikiWord{:href => "/nlab/show/type+of+booleans"} type of booleans
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi x
                      %mo ¯
                    %mo ≡
                    %msub
                      %mi{:mathvariant => "normal"} rec
                      %mrow
                        %mi{:mathvariant => "normal"} bool
