            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %msub
                      %mi{:mathvariant => "normal"} Br
                      %mrow
                        %mi I
                        %mo ,
                        %mi A
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi x
                      %mo ¯
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p:\mathrm{Br}_{I, A}(\overline{x})
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} ap
                  %mo{:stretchy => "false"} (
                  %mi λ
                  %mi x
                  %mo .
                  %mi x
                  %mo ,
