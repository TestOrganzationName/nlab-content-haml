                            %mi 𝕀
                            %mi I
                      %mo{:stretchy => "false"} (
                      %mi{:mathvariant => "normal"} pts
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash I \; \mathrm{type}}{\Gamma \vdash \mathrm{pts}:I \to \mathbb{I}_I} \qquad \frac{\Gamma \vdash I \; \mathrm{type}}{\Gamma \vdash \mathrm{br}_I:\mathrm{Br}_{I, \mathbb{I}_I}(\mathrm{pts})}
