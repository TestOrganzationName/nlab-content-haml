                      %mi{:mathvariant => "normal"} ind
                      %mrow
                        %mi{:mathvariant => "normal"} bool
                        %mo ,
                        %mi λ
                        %mi t
                        %mo .
                        %mi B
                        %mo{:stretchy => "false"} (
                        %mover
                          %mi x
                          %mo ¯
                        %mo{:stretchy => "false"} (
                        %mi t
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi y
                      %mn 0
                    %mo ,
                    %msub
                      %mi y
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \overline{y} \equiv \mathrm{ind}_{\mathrm{bool}, \lambda t.B(\overline{x}(t))}(y_0, y_1)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} hBr
                      %mrow
                        %mi A
                        %mo ,
                        %mi B
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 0
                    %mo ,
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi p
                    %mo ,
                    %msub
                      %mi y
                      %mn 0
                    %mo ,
                    %msub
                      %mi y
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{hBr}_{A, B}(x_0, x_1, p, y_0, y_1)
            %a.existingWikiWord{:href => "/nlab/show/induction+principle"} induction principle
            of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/type+of+booleans"} type of booleans
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+types"} equivalence of types
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} hBr
                    %mrow
                      %mi{:mathvariant => "normal"} bool
                      %mo ,
                      %mi A
                      %mo ,
                      %mi B
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi{:mathvariant => "normal"} rec
                    %mrow
                      %mi{:mathvariant => "normal"} bool
                      %mo ,
                      %mi A
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi x
                    %mn 0
                  %mo ,
                  %msub
                    %mi x
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi p
                  %mo ,
                  %msub
                    %mi{:mathvariant => "normal"} ind
                    %mrow
                      %mi{:mathvariant => "normal"} bool
                      %mo ,
                      %mi B
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi y
                    %mn 0
                  %mo ,
                  %msub
                    %mi y
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi{:mathvariant => "normal"} hBr
                    %mrow
                      %mi A
                      %mo ,
                      %mi B
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi x
                    %mn 0
                  %mo ,
                  %msub
                    %mi x
                    %mn 1
                  %mo ,
                  %mi p
                  %mo ,
                  %msub
                    %mi y
                    %mn 0
                  %mo ,
                  %msub
                    %mi y
                    %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{hBr}_{\mathrm{bool}, A, B}(\mathrm{rec}_{\mathrm{bool}, A}(x_0, x_1), p, \mathrm{ind}_{\mathrm{bool}, B}(y_0, y_1)) \simeq \mathrm{hBr}_{A, B}(x_0, x_1, p, y_0, y_1)
          %p
            Like
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/heterogeneous+identity+types"} heterogeneous identity types
            %a.existingWikiWord{:href => "/nlab/show/dependent+sum+type"} dependent sum type
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi x
                    %mo ¯
                  %mo :
                  %mi I
                  %mo →
                  %mi A
                  %mo ,
                  %mover
                    %mi y
                    %mo ¯
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi i
                      %mo :
                      %mi I
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi x
                    %mo ¯
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
