                      %mi I
                      %mo ,
                      %mi A
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi λ
                  %mi t
                  %mo .
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{apd}(f, \lambda t.x, \mathrm{refl}_{I, A}(x)) \equiv \mathrm{refl}_{I, B(x)}(f(x)):\mathrm{hBr}_{I, A, B}(\lambda t.x, \mathrm{refl}_{I, A}(x), \lambda t.f(x))
          %h2#the_walking_bridge The walking bridge
          %p
            Given a bridge type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} Br
                    %mrow
                      %mi I
                      %mo ,
                      %mi A
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi x
                    %mo ¯
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{Br}_{I, A}(\overline{x})
            indexed by functions
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi x
                      %mo ¯
                    %mo :
                    %mi I
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \overline{x}:I \to A
            %em walking bridge type
            is a
            %a.existingWikiWord{:href => "/nlab/show/higher+inductive+type"} higher inductive type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝕀
                    %mi I
                %annotation{:encoding => "application/x-tex"} \mathbb{I}_I
            generated by a function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} pts
                  %mo :
                  %mi I
                  %mo →
                  %msub
                    %mi 𝕀
                    %mi I
                %annotation{:encoding => "application/x-tex"} \mathrm{pts}:I \to \mathbb{I}_I
            and a bridge
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} br
                    %mo :
                    %msub
                      %mi{:mathvariant => "normal"} Br
                      %mrow
                        %mi I
                        %mo ,
                        %msub
                          %mi 𝕀
                          %mi I
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} pts
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{br}:\mathrm{Br}_{I, \mathbb{I}_I}(\mathrm{pts})
          %p
            The idea of the walking bridge is that every bridge in a bridge type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} Br
                    %mrow
                      %mi I
                      %mo ,
                      %mi A
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi x
                    %mo ¯
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{Br}_{I, A}(\overline{x})
            is given by a function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} I \to A
            that factors through
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕀
                      %mi I
                  %annotation{:encoding => "application/x-tex"} \mathbb{I}_I
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mo →
                  %msub
                    %mi 𝕀
                    %mi I
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} I \to \mathbb{I}_I \to A
          %p
            in the same way that
            %a.existingWikiWord{:href => "/nlab/show/identifications"} identifications
            are given by a function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} bool
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} \mathrm{bool} \to A
            that factors through the
            %a.existingWikiWord{:href => "/nlab/show/interval+type"} interval type
            (the
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/walking+identification"} walking identification
          %h3#inference_rules Inference rules
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/inference+rules"} inference rules
            of the walking bridge are as follows:
          %p Formation rules for the walking bridge:
