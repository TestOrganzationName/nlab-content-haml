                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{Br}_A(x, y)
            %a.existingWikiWord{:href => "/nlab/show/induction+principle"} induction principle
            of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/type+of+booleans"} type of booleans
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} Br
