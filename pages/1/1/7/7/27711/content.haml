                      %mo ,
                      %mi A
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi x
                    %mo ¯
                  %mo{:stretchy => "false"} )
                  %mo ⊢
                  %mi{:mathvariant => "normal"} apd
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mover
                    %mi x
                    %mo ¯
                  %mo ,
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msub
                    %mi{:mathvariant => "normal"} hBr
                    %mrow
                      %mi I
                      %mo ,
                      %mi A
                      %mo ,
                      %mi B
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi x
                    %mo ¯
                  %mo ,
                  %mi p
                  %mo ,
                  %mi λ
                  %mi t
                  %mo .
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi x
                    %mo ¯
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f:\prod_{x:A} B(x), \overline{x}:I \to A, p:\mathrm{Br}_{I, A}(\overline{x}) \vdash \mathrm{apd}(f, \overline{x}, p):\mathrm{hBr}_{I, A, B}(\overline{x}, p, \lambda t.f(\overline{x}(t)))
          %p
            Dependent function application of bridges satisfies some of the same judgmental equalities as that of identifications. These include, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f:\prod_{x:A} B(x)
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} x:A
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} apd
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mi λ
                  %mi t
                  %mo .
                  %mi x
                  %mo ,
                  %msub
                    %mi{:mathvariant => "normal"} refl
                    %mrow
                      %mi I
                      %mo ,
                      %mi A
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ≡
                  %msub
                    %mi{:mathvariant => "normal"} refl
                    %mrow
                      %mi I
                      %mo ,
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msub
                    %mi{:mathvariant => "normal"} hBr
                    %mrow
                      %mi I
                      %mo ,
                      %mi A
                      %mo ,
                      %mi B
                  %mo{:stretchy => "false"} (
                  %mi λ
                  %mi t
                  %mo .
                  %mi x
                  %mo ,
                  %msub
                    %mi{:mathvariant => "normal"} refl
