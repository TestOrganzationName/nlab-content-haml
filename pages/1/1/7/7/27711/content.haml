          %h2#heterogeneous_bridge_types Heterogeneous bridge types
          %p
            Similarly to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/heterogeneous+identity+types"} heterogeneous identity types
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and a type family
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                %annotation{:encoding => "application/x-tex"} (B(x))_{x:A}
            and an index type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            for the bridge types, the heterogeneous bridge type is a type family
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi x
                    %mo ¯
                  %mo :
                  %mi I
                  %mo →
                  %mi A
                  %mo ,
                  %mi p
                  %mo :
                  %msub
                    %mi{:mathvariant => "normal"} Br
                    %mrow
                      %mi I
                      %mo ,
                      %mi A
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi x
                    %mo ¯
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mover
                    %mi y
                    %mo ¯
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi i
                      %mo :
                      %mi I
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi x
                    %mo ¯
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ⊢
                  %msub
                    %mi{:mathvariant => "normal"} hBr
                    %mrow
                      %mi I
                      %mo ,
                      %mi A
                      %mo ,
                      %mi B
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi x
                    %mo ¯
                  %mo ,
                  %mi p
                  %mo ,
                  %mover
                    %mi y
                    %mo ¯
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \overline{x}:I \to A, p:\mathrm{Br}_{I, A}(\overline{x}), \overline{y}:\prod_{i:I} B(\overline{x}(i)) \vdash \mathrm{hBr}_{I, A, B}(\overline{x}, p, \overline{y})
          %p
            The usual version of a bridge type can be called
            %strong homogeneous
            to contrast with heterogeneous bridge types.
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mo ≡
                  %mi{:mathvariant => "normal"} bool
                %annotation{:encoding => "application/x-tex"} I \equiv \mathrm{bool}
            the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/type+of+booleans"} type of booleans
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi x
                      %mo ¯
                    %mo ≡
                    %msub
                      %mi{:mathvariant => "normal"} rec
                      %mrow
                        %mi{:mathvariant => "normal"} bool
                        %mo ,
                        %mi A
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 0
                    %mo ,
                    %msub
                      %mi x
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \overline{x} \equiv \mathrm{rec}_{\mathrm{bool}, A}(x_0, x_1)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi y
                      %mo ¯
                    %mo ≡
