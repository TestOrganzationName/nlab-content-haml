                      %mo :
                      %msub
                        %mi{:mathvariant => "normal"} Br
                        %mrow
                          %mi I
                          %mo ,
                          %mi A
                      %mo{:stretchy => "false"} (
                      %mover
                        %mi x
                        %mo ¯
                      %mo{:stretchy => "false"} )
                  %msub
                    %mi{:mathvariant => "normal"} hBr
                    %mrow
                      %mi I
                      %mo ,
                      %mi A
                      %mo ,
                      %mi B
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi x
                    %mo ¯
                  %mo ,
                  %mi p
                  %mo ,
                  %mover
                    %mi y
                    %mo ¯
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \overline{x}:I \to A, \overline{y}:\prod_{i:I} B(\overline{x}(i)) \vdash \mathrm{hBr}_{I, A, B}(\overline{x}, \overline{y}) \coloneqq \sum_{p:\mathrm{Br}_{I, A}(\overline{x})} \mathrm{hBr}_{I, A, B}(\overline{x}, p, \overline{y})
          %p
            These heterogeneous bridge types can be called
            = succeed "," do
              %strong fibered heterogeneous bridge types
            = succeed "," do
              %strong indexed heterogeneous bridge types
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/heterogeneous+identity+types"} heterogeneous identity types
          %h3#relation_to_homogeneous_bridge_types Relation to homogeneous bridge types
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be a type. Then heterogeneous bridge types over the constant type family at
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            are the same as homogeneous bridge types of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} hBr
                    %mrow
                      %mi A
                      %mo ,
                      %mi λ
                      %mi t
                      %mo .
                      %mi C
                      %mo ,
                      %mi I
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi x
                    %mo ¯
                  %mo ,
                  %mi p
                  %mo ,
                  %mover
                    %mi y
                    %mo ¯
                  %mo{:stretchy => "false"} )
                  %mo ≡
                  %msub
                    %mi{:mathvariant => "normal"} Br
                    %mrow
                      %mi I
                      %mo ,
                      %mi C
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi y
                    %mo ¯
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{hBr}_{A, \lambda t.C, I}(\overline{x}, p, \overline{y}) \equiv \mathrm{Br}_{I, C}(\overline{y})
          %p
            Similarly, given an element
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} x:A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                  %mi t
                  %mo .
                  %mi x
                  %mo :
                  %mi I
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} \lambda t.x:I \to A
            and reflexivity
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} refl
