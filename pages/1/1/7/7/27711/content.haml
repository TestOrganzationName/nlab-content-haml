                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash I \; \mathrm{type} \quad \Gamma, x:\mathbb{I}_I \vdash C(x) \; \mathrm{type} \quad \Gamma\vdash c_\mathrm{pts}:\prod_{i:I} C(\mathrm{pts}(i)) \quad \Gamma \vdash c_\mathrm{br}:\mathrm{hBr}_{I, \mathbb{I}_I, C}(\mathrm{pts}, \mathrm{br}_I, c_\mathrm{pts})}{\Gamma \vdash \mathrm{apd}(\mathrm{ind}_\mathbb{I}^{C}(c_\mathrm{pts}, c_\mathrm{br}), \mathrm{pts}, \mathrm{br}_I) \equiv c_\mathrm{br}:\mathrm{Br}_{I, \mathbb{I}_I}(\mathrm{pts})}
          %h2#discrete_types Discrete types
          %p
            Since bridge types are reflexive, we can define the
            %a.existingWikiWord{:href => "/nlab/show/diagonal"} diagonal
            as the
            %a.existingWikiWord{:href => "/nlab/show/function"} function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mrow
                      %mi I
                      %mo ,
                      %mi A
                  %mo ≔
                  %mi λ
                  %mi x
                  %mo .
                  %mo{:stretchy => "false"} (
                  %mi λ
                  %mi t
                  %mo .
                  %mi x
                  %mo ,
                  %msub
                    %mi{:mathvariant => "normal"} refl
                    %mrow
                      %mi I
                      %mo ,
                      %mi A
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi A
                  %mo →
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mover
                        %mi x
                        %mo ¯
                      %mo :
                      %mi I
                      %mo →
                      %mi A
                  %msub
                    %mi{:mathvariant => "normal"} Br
                    %mrow
                      %mi I
                      %mo ,
                      %mi A
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi x
                    %mo ¯
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Delta_{I, A} \coloneqq \lambda x.(\lambda t.x, \mathrm{refl}_{I, A}(x)):A \to \sum_{\overline{x}:I \to A} \mathrm{Br}_{I, A}(\overline{x})
          %p
            Let
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} Id
                      %mrow
                        %mi I
                        %mo ,
                        %mi A
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi x
                      %mo ¯
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{Id}_{I, A}(\overline{x})
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi x
                      %mo ¯
                    %mo :
                    %mi I
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \overline{x}:I \to A
            %a.existingWikiWord{:href => "/nlab/show/identity+type#OfArbitraryArity"} identity type
            of
            %a.existingWikiWord{:href => "/nlab/show/arity"} arity
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
            %a.existingWikiWord{:href => "/nlab/show/identity+type"} identity type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} Id
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{Id}_A(x, y)
            by the
            %a.existingWikiWord{:href => "/nlab/show/recursion+principle"} recursion principle
            of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/type+of+booleans"} type of booleans
          %p
            A type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is
            %strong
              %a.existingWikiWord{:href => "/nlab/show/discrete"} discrete
            %a.existingWikiWord{:href => "/nlab/show/if+and+only+if"} if and only if
            one of the following equivalent conditions holds:
          %ul
            %li
              %p
                the diagonal
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Δ
                        %mrow
                          %mi I
                          %mo ,
                          %mi A
                    %annotation{:encoding => "application/x-tex"} \Delta_{I, A}
                is an
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/equivalence+of+types"} equivalence of types
            %li
              %p
                the canonical function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi{:mathvariant => "normal"} const
                        %mrow
                          %mi A
                          %mo ,
                          %msub
                            %mi 𝕀
                            %mi I
                      %mo ≔
                      %mi λ
                      %mi a
                      %mo .
                      %mi λ
                      %mi i
                      %mo .
                      %mi a
                    %annotation{:encoding => "application/x-tex"} \mathrm{const}_{A, \mathbb{I}_I} \coloneqq \lambda a.\lambda i.a
                which takes elements in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                to constant functions
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝕀
                        %mi I
                      %mo →
                      %mi A
                    %annotation{:encoding => "application/x-tex"} \mathbb{I}_I \to A
                out of the walking bridge is an
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/equivalence+of+types"} equivalence of types
            %li
              %p
                the canonical inductively defined family of functions
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi{:mathvariant => "normal"} Id
                        %mrow
                          %mi I
                          %mo ,
                          %mi A
                      %mo{:stretchy => "false"} (
                      %mover
                        %mi x
                        %mo ¯
                      %mo{:stretchy => "false"} )
                      %mo →
                      %msub
                        %mi{:mathvariant => "normal"} Br
                        %mrow
                          %mi I
                          %mo ,
                          %mi A
                      %mo{:stretchy => "false"} (
                      %mover
                        %mi x
                        %mo ¯
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathrm{Id}_{I, A}(\overline{x}) \to \mathrm{Br}_{I, A}(\overline{x})
                defined via
                %a.existingWikiWord{:href => "/nlab/show/identification+elimination"} identification elimination
                is an
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+types"} equivalence of types
                for all
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi x
                          %mo ¯
                        %mo :
                        %mi I
                        %mo →
                        %mi A
                      %annotation{:encoding => "application/x-tex"} \overline{x}:I \to A
          %p
            The second condition is essentially saying that the
            %a.existingWikiWord{:href => "/nlab/show/localization+of+a+type"} localization
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mrow
                      %msub
                        %mi 𝕀
                        %mi I
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} L_{\mathbb{I}_I}(A)
            at the walking bridge
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝕀
                    %mi I
                %annotation{:encoding => "application/x-tex"} \mathbb{I}_I
            is equivalent to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            itself.
          %p
            In a
            %a.existingWikiWord{:href => "/nlab/show/spatial+type+theory"} spatial type theory
            with a
            %a.existingWikiWord{:href => "/nlab/show/flat+modality"} flat modality
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/sharp+modality"} sharp modality
            %a.existingWikiWord{:href => "/nlab/show/cohesive+type+theory"} cohesive type theory
            by adding an
            %a.existingWikiWord{:href => "/nlab/show/axiom+of+cohesion"} axiom of cohesion
            for the walking bridge, that says that a type is discrete in the spatial sense
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ≃
                  %mo ♭
                  %mi A
                %annotation{:encoding => "application/x-tex"} A \simeq \flat A
            if and only if a type is discrete in the bridge sense. The
            %a.existingWikiWord{:href => "/nlab/show/shape+modality"} shape modality
            of the cohesive type theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} ʃ
                  %mo ≔
                  %msub
                    %mi L
                    %mrow
                      %msub
                        %mi 𝕀
                        %mi I
                %annotation{:encoding => "application/x-tex"} \esh \coloneqq L_{\mathbb{I}_I}
            is then given by localization at the walking bridge.
          %p
            The semantics of such a
            %a.existingWikiWord{:href => "/nlab/show/cohesive+type+theory"} cohesive type theory
            for a finite type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            with
            = succeed "-elements" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/cohesive+%28infinity%2C1%29-topos"} cohesive (infinity,1)-topos
            of
            = succeed "-ary" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/cubical+objects"} cubical objects
            in a base
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-topos"} (infinity,1)-topos
            of cubically discrete objects.
          %h2#relativity Relativity
          %p
            There is an analogue of the
            %a.existingWikiWord{:href => "/nlab/show/univalence+axiom"} univalence axiom
            for
            %a.existingWikiWord{:href => "/nlab/show/type+universes"} type universes
            called
            %strong relativity
            (see
            = succeed ")," do
              %a{:href => "#CH21"} Cavallo &amp; Harper 2021
            %a.existingWikiWord{:href => "/nlab/show/identity+types"} identity types
            and types of
            = succeed "-ary" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/type+families"} type families
            instead of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/types+of+equivalences"} types of equivalences
            %strong relativistic
            if it satisfies the
            = succeed ":" do
              %strong axiom of relativity
          %p
          .num_defn
            %h6 Definition
            %p
              Given an index type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              and bridge types
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi{:mathvariant => "normal"} Br
                        %mrow
                          %mi I
                          %mo ,
                          %mi A
                      %mo{:stretchy => "false"} (
                      %mover
                        %mi x
                        %mo ¯
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathrm{Br}_{I, A}(\overline{x})
              %strong relativity
              for a
              %a.existingWikiWord{:href => "/nlab/show/type+universe"} type universe
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              states that for all
              = succeed "-indexed" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi X
                        %mo ¯
                      %mo :
                      %mi I
                      %mo →
                      %mi U
                    %annotation{:encoding => "application/x-tex"} \overline{X}:I \to U
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} Br
                      %mrow
                        %mi I
                        %mo ,
                        %mi U
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi X
                      %mo ¯
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{Br}_{I, U}(\overline{X})
              and the type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi i
                          %mo :
                          %mi I
                      %mover
                        %mi X
                        %mo ¯
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mo →
                    %mi U
                  %annotation{:encoding => "application/x-tex"} \left(\prod_{i:I} \overline{X}(i)\right) \to U
              of
              = succeed "-small" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              = succeed "-ary" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
          %p
            Special cases of relativity for when the index type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mo ≡
                  %mi{:mathvariant => "normal"} Fin
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} I \equiv \mathrm{Fin}(n)
            is the finite type with
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} n = 0
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n = 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 2
                %annotation{:encoding => "application/x-tex"} n = 2
            elements respectively:
          %ul
            %li
              %p
                Nullary relativity of a
                %a.existingWikiWord{:href => "/nlab/show/type+universe"} type universe
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                      %annotation{:encoding => "application/x-tex"} U
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mo ≡
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} I \equiv \emptyset
                the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/empty+type"} empty type
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+types"} equivalence of types
                between the bridge type
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi{:mathvariant => "normal"} Br
                        %mi U
                    %annotation{:encoding => "application/x-tex"} \mathrm{Br}_U
                and the type of types
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi{:mathvariant => "normal"} unit
                        %mo →
                        %mi U
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %mi U
                      %annotation{:encoding => "application/x-tex"} (\mathrm{unit} \to U) \simeq U
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/unit+type"} unit type
            %li
              %p
                Unary relativity of a
                %a.existingWikiWord{:href => "/nlab/show/type+universe"} type universe
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                      %annotation{:encoding => "application/x-tex"} U
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mo ≡
                      %mi{:mathvariant => "normal"} unit
                    %annotation{:encoding => "application/x-tex"} I \equiv \mathrm{unit}
                the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/unit+type"} unit type
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+types"} equivalence of types
                between the bridge type
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi{:mathvariant => "normal"} Br
                        %mi U
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathrm{Br}_U(A)
                and the type of type families
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi{:mathvariant => "normal"} Copy
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi U
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo →
                        %mi U
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\mathrm{Copy}(A) \to U) \simeq (A \to U)
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/copy+type"} copy type
            %li
              %p
                Binary relativity of a
                %a.existingWikiWord{:href => "/nlab/show/type+universe"} type universe
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                      %annotation{:encoding => "application/x-tex"} U
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mo ≡
                      %mi{:mathvariant => "normal"} bool
                    %annotation{:encoding => "application/x-tex"} I \equiv \mathrm{bool}
                the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/type+of+booleans"} type of booleans
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+types"} equivalence of types
                between the bridge type
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi{:mathvariant => "normal"} Br
                        %mi U
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathrm{Br}_U(A, B)
                and the type of correspondences
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo ×
                        %mi B
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi U
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo →
                        %mi B
                        %mo →
                        %mi U
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} ((A \times B) \to U) \simeq (A \to B \to U)
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/internal+parametricity"} internal parametricity
            %li
              %p
