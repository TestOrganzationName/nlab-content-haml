                  %mi t
                  %mo .
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{hBr}_{I, A, B}(\lambda t.x, \mathrm{refl}_{I, A}(x), \lambda t.y)
            is the same as the homogeneous bridge type
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} Br
                      %mrow
                        %mi I
                        %mo ,
                        %mi B
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi λ
                    %mi t
                    %mo .
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{Br}_{I, B(x)}(\lambda t.y)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} hrefl
                    %mrow
                      %mi I
                      %mo ,
                      %mi A
                      %mo ,
                      %mi B
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo ≡
                  %msub
                    %mi{:mathvariant => "normal"} refl
                    %mrow
                      %mi I
                      %mo ,
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msub
                    %mi{:mathvariant => "normal"} Br
                    %mrow
                      %mi I
                      %mo ,
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi λ
                  %mi t
                  %mo .
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{hrefl}_{I, A, B}(x, y) \equiv \mathrm{refl}_{I, B(x)}(y):\mathrm{Br}_{I, B(x)}(\lambda t.y)
          %h3#dependent_function_application Dependent function application
          %p
            In the same way that dependent functions preserve
            %a.existingWikiWord{:href => "/nlab/show/heterogeneous+identifications"} heterogeneous identifications
            via dependent function application to identifications, dependent functions preserve bridges via
            %strong dependent function application to bridges
            or the
            = succeed "." do
              %strong dependent action on bridges
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi x
                    %mo ¯
                  %mo :
                  %mi I
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} \overline{x}:I \to A
            and dependent functions
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi x
                        %mo :
                        %mi A
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f:\prod_{x:A} B(x)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %msub
                      %mi{:mathvariant => "normal"} Br
                      %mrow
                        %mi I
                        %mo ,
                        %mi A
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi x
                      %mo ¯
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p:\mathrm{Br}_{I, A}(\overline{x})
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} apd
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mover
                      %mi x
                      %mo ¯
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msub
                      %mi{:mathvariant => "normal"} hBr
                      %mrow
                        %mi I
                        %mo ,
                        %mi A
                        %mo ,
                        %mi B
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi x
                      %mo ¯
                    %mo ,
                    %mi p
                    %mo ,
                    %mi λ
                    %mi t
                    %mo .
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi x
                      %mo ¯
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{apd}(f, \overline{x}, p):\mathrm{hBr}_{I, A, B}(\overline{x}, p, \lambda t.f(\overline{x}(t)))
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mover
                    %mi x
                    %mo ¯
                  %mo :
                  %mi I
                  %mo →
                  %mi A
                  %mo ,
                  %mi p
                  %mo :
                  %msub
