                    %mrow
                      %mi I
                      %mo ,
                      %mi A
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi x
                    %mo ¯
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{ap}(\lambda t.x, \overline{x}, p) \equiv \mathrm{refl}_{I, A}(x):\mathrm{Br}_{I, A}(\overline{x})
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} ap
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo ∘
                  %mi f
                  %mo ,
                  %mover
                    %mi x
                    %mo ¯
                  %mo ,
                  %mi p
                  %mo{:stretchy => "false"} )
