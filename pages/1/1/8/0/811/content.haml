                                %mi h
                                %mi a
                                %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                                %msub
                                  %mi p
                                  %mn 1
                                %mo{:stretchy => "false"} ↓
                              %mtd
                              %mtd
                                %mo{:stretchy => "false"} ↓
                                %msub
                                  %mi p
                                  %mn 2
                            %mtr
                              %mtd
                                %msub
                                  %mi B
                                  %mn 1
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi p
                                  %mn 1
                                %mi b
                                %mo ,
                                %msub
                                  %mi p
                                  %mn 1
                                %mi a
                                %mo{:stretchy => "false"} )
                              %mtd
                                %munder
                                  %mo →
                                  %mi g
                              %mtd
                                %msub
                                  %mi B
                                  %mn 2
                                %mo{:stretchy => "false"} (
                                %mi g
                                %msub
                                  %mi p
                                  %mn 1
                                %mi b
                                %mo ,
                                %mi g
                                %msub
                                  %mi p
                                  %mn 1
                                %mi a
                                %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\array{E_1(b,a) &amp; \overset{h}{\to} &amp; E_2(h b, h a)\\
                        p_1 \downarrow &amp;&amp; \downarrow p_2\\
                        B_1(p_1 b, p_1 a)&amp; \underset{g}{\to} &amp; B_2(g p_1 b, g p_1 a)}
                %p
                  is a morphism of
                  = succeed "-fibrations." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo −
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (n-1)
          %h2#remarks Remarks
          %ul
            %li
              %p
                The definition is recursive in
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo =
                        %mi ω
                      %annotation{:encoding => "application/x-tex"} n=\omega
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                is a fibration requires some things about cartesian 1-cells, and also that its action on hom-categories be a fibration–which in turn requires some things about cartesian 2-cells, and also that
                %em its
                action on hom-categories be a fibration—which in turn which requires some things about cartesian 3-cells, and so on. After
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ω
                    %annotation{:encoding => "application/x-tex"} \omega
                steps of unraveling, we are left with a list of conditions on cartesian
                = succeed "-cells" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
              %p
                An equivalent, conciser way to say this is that we interpret the definition in the case
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo =
                      %mi ω
                    %annotation{:encoding => "application/x-tex"} n=\omega
                as a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/coinductive+definition"} coinductive definition
            %li
              %p
                When
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo =
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} n=1
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Street+fibration"} Street fibration
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Grothendieck+fibration"} Grothendieck fibration
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mi E
                    %annotation{:encoding => "application/x-tex"} a\in E
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi x
                      %mo →
                      %mi p
                      %mi a
                    %annotation{:encoding => "application/x-tex"} f:x\to p a
                in
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                      %annotation{:encoding => "application/x-tex"} B
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo :
                      %mi b
                      %mo →
                      %mi a
                    %annotation{:encoding => "application/x-tex"} \phi:b\to a
                such that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"} p\phi
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                are
                = succeed "." do
                  %em equal
                %a.existingWikiWord{:href => "/nlab/show/principle+of+equivalence"} principle of equivalence
                as stated, but not if it is rephrased to apply to
                %a.existingWikiWord{:href => "/nlab/show/displayed+categories"} displayed categories
                instead.
            %li
              %p
                When
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo =
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} n=2
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/bicategories"} bicategories
                = succeed "." do
                  %a{:href => "#Buckley"} (Buckley)
                %a.existingWikiWord{:href => "/nlab/show/strict+2-categories"} strict 2-categories
                (though with one condition missing) was originally studied by
                = succeed "." do
                  %a{:href => "#Hermida"} (Hermida)
            %li
              %p
                In general, given any notion of (semi)strict
                = succeed "-category," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
          %h2#fibrations_versus_functors Fibrations versus functors
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo :
                  %mi E
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} p:E\to B
            is an
            = succeed "-fibration," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-pseudofunctor\u2019)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} n Cat
            as follows. (Like the above definition, this is only a schematic sketch.)
          %ul
            %li
              %p
                Send
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi B
                    %annotation{:encoding => "application/x-tex"} x\in B
                to the
                %a.existingWikiWord{:href => "/nlab/show/essential+fiber"} essential fiber
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi E
                          %mi x
                      %annotation{:encoding => "application/x-tex"} E_x
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mi E
                    %annotation{:encoding => "application/x-tex"} a\in E
                equipped with a equivalence
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %mi a
                        %mo ≃
                        %mi x
                      %annotation{:encoding => "application/x-tex"} p a \simeq x
            %li
              %p
                For a morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi y
                      %mo →
                      %mi x
                    %annotation{:encoding => "application/x-tex"} f:y\to x
                in
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                      %annotation{:encoding => "application/x-tex"} B
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mo *
                      %mo :
                      %msub
                        %mi E
                        %mi x
                      %mo →
                      %msub
                        %mi E
                        %mi y
                    %annotation{:encoding => "application/x-tex"} f^*:E_x\to E_y
                by choosing, for each
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo ∈
                        %msub
                          %mi E
                          %mi x
                      %annotation{:encoding => "application/x-tex"} a\in E_x
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo :
                      %mi b
                      %mo →
                      %mi a
                    %annotation{:encoding => "application/x-tex"} \phi:b\to a
                over
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                and defining
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi f
                          %mo *
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi b
                      %annotation{:encoding => "application/x-tex"} f^*(a)=b
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mo *
                    %annotation{:encoding => "application/x-tex"} f^*
                a functor.
            %li
              %p
                For a 2-cell
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                      %mo :
                      %mi f
                      %mo →
                      %mi g
                      %mo :
                      %mi y
                      %mo →
                      %mi x
                    %annotation{:encoding => "application/x-tex"} \alpha:f\to g:y\to x
                in
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                      %annotation{:encoding => "application/x-tex"} B
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi α
                        %mo *
                      %mo :
                      %msup
                        %mi g
                        %mo *
                      %mo →
                      %msup
                        %mi f
                        %mo *
                    %annotation{:encoding => "application/x-tex"} \alpha^*:g^*\to f^*
                as follows. Given
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo ∈
                        %msub
                          %mi E
                          %mi x
                      %annotation{:encoding => "application/x-tex"} a\in E_x
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo :
                      %msup
                        %mi g
                        %mo *
                      %mi a
                      %mo →
                      %mi a
                    %annotation{:encoding => "application/x-tex"} \phi:g^*a\to a
                over
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                      %annotation{:encoding => "application/x-tex"} g
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi μ
                      %mo :
                      %mi ψ
                      %mo →
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"} \mu:\psi\to \phi
                over
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                    %annotation{:encoding => "application/x-tex"} \alpha
                in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi g
                          %mo *
                        %mi a
                        %mo ,
                        %mi a
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} E(g^*a,a)
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %mi ψ
                        %mo =
                        %mi f
                      %annotation{:encoding => "application/x-tex"} p \psi = f
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ψ
                    %annotation{:encoding => "application/x-tex"} \psi
                factors essentially uniquely through the cartesian arrow
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi χ
                        %mo :
                        %msup
                          %mi f
                          %mo *
                        %mi a
                        %mo →
                        %mi a
                      %annotation{:encoding => "application/x-tex"} \chi:f^*a\to a
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi g
                          %mo *
                        %mi a
                        %mo →
                        %msup
                          %mi f
                          %mo *
                        %mi a
                      %annotation{:encoding => "application/x-tex"} g^*a \to f^*a
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi α
                        %mo *
                    %annotation{:encoding => "application/x-tex"} \alpha^*
                at
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                      %annotation{:encoding => "application/x-tex"} a
            %li
              %p and so on…
          %p
            Note that the functor we obtain is “totally contravariant:” it is contravariant on
            = succeed "-cells" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ≤
                    %mi k
                    %mo ≤
                    %mi n
                  %annotation{:encoding => "application/x-tex"} 1\le k\le n
          %p
            Conversely, if we have a totally contravariant ‘
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            \-pseudofunctor’ from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} n Cat
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo :
                  %mi E
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} p:E\to B
            by a generalization of the
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+construction"} Grothendieck construction
            as follows:
          %ul
            %li
              %p
                The objects of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
                over
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi B
                    %annotation{:encoding => "application/x-tex"} x\in B
                are those of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mi x
                        %mo ∈
                        %mi n
                        %mi Cat
                      %annotation{:encoding => "application/x-tex"} F x \in n Cat
            %li
              %p
                The morphisms of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
                over
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi y
                      %mo →
                      %mi x
                    %annotation{:encoding => "application/x-tex"} f:y\to x
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
                from
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo ∈
                      %mi F
                      %mi y
                    %annotation{:encoding => "application/x-tex"} b\in F y
                to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mi F
                      %mi x
                    %annotation{:encoding => "application/x-tex"} a\in F x
                are the morphisms from
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                    %annotation{:encoding => "application/x-tex"} b
                to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mi f
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F_f(a)
                in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mi y
                      %annotation{:encoding => "application/x-tex"} F y
            %li
              %p
                The 2-cells of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
                over
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                      %mo :
                      %mi f
                      %mo →
                      %mi g
                      %mo :
                      %mi y
                      %mo →
                      %mi x
                    %annotation{:encoding => "application/x-tex"} \alpha:f\to g:y\to x
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
                from
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ψ
                      %mo :
                      %mi b
                      %mo →
                      %msub
                        %mi F
                        %mi f
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \psi : b \to F_f(a)
                to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo :
                      %mi b
                      %mo →
                      %msub
                        %mi F
                        %mi g
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \phi : b \to F_g(a)
                are the 2-cells in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mi y
                    %annotation{:encoding => "application/x-tex"} F y
                from
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ψ
                    %annotation{:encoding => "application/x-tex"} \psi
                to the composite
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                        %mover
                          %mo →
                          %mi ϕ
                        %msub
                          %mi F
                          %mi g
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo →
                          %mrow
                            %msub
                              %mi F
                              %mi α
                            %mo{:stretchy => "false"} (
                            %mi a
                            %mo{:stretchy => "false"} )
                        %msub
                          %mi F
                          %mi f
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} b \xrightarrow{\phi} F_g(a) \xrightarrow{F_\alpha(a)} F_f(a)
            %li
              %p and so on…
          %p
            One expects that in this way, the
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n+1)
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            is equivalent to the
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n+1)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo →
                    %mi n
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} B\to n Cat
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} n=2
          %h2#examples Examples
          %ul
            %li
              The prototypical example is that if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              is an
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Fib
                      %mi K
                  %annotation{:encoding => "application/x-tex"} Fib_K
              of
              %em internal
              = succeed "-fibrations" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n-1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              should admit an
              = succeed "-fibration" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi cod
                      %mo :
                      %msub
                        %mi Fib
                        %mi K
                      %mo →
                      %mi K
                    %annotation{:encoding => "application/x-tex"} cod : Fib_K \to K
              = succeed "-fibration" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n-1)
              = succeed "-category;" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} n=2
              this gives the notion of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/fibration+in+a+2-category"} fibration in a 2-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi cod
                    %mo :
                    %msub
                      %mi Fib
                      %mi K
                    %mo →
                    %mi K
                  %annotation{:encoding => "application/x-tex"} cod : Fib_K \to K
              is a 2-fibration is in
              = succeed "." do
                %a{:href => "#Hermida"} (Hermida)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n=1
              it is just the standard fact that the
              %a.existingWikiWord{:href => "/nlab/show/codomain+fibration"} codomain fibration
              is a fibration, i.e. every morphism in a 1-category is an “internal 0-fibration”.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Grothendieck+fibration"}> Grothendieck fibration
                ,
                %a.existingWikiWord{:href => "/nlab/show/Street+fibration"} Street fibration
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/fibration+in+a+2-category"} fibration in a 2-category
            %li
              %p
                A notion of fibration of
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-categories
                exists in terms of
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+fibrations"} Cartesian fibrations
                of
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/fibration+of+quasi-categories"} fibration of quasi-categories
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/left+fibration"} left fibration
                = succeed ".)" do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/right+fibration"} right fibration
          %h2#references References
          %p The notion of 2-fibrations was introduced in:
          %ul
            %li#Hermida
              %a.existingWikiWord{:href => "/nlab/show/Claudio+Hermida"}> Claudio Hermida
              ,
              = succeed "," do
                %em
                  Some properties of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Fib
                      %annotation{:encoding => "application/x-tex"} Fib
                  as a fibred 2-category
              %strong 134
              (1999) 83-109 &amp;lbrack;
              %a{:href => "https://doi.org/10.1016/S0022-4049(97)00129-1"}> doi:10.1016/S0022-4049(97)00129-1
              ,
              = succeed "&rbrack;" do
                %a{:href => "http://maggie.cs.queensu.ca/chermida/papers/jpaa.ps.gz"} ps.gz
          %p
            In fact they also appeared earlier, in some form, in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Gray-adjointness-for-2-categories"} Gray's book
          %p However, Hermida’s definition was missing the stability of cartesian 2-cells under postcomposition, which is necessary for the “Grothendieck construction” turning a pseudofunctor into a fibration to have an inverse. This was rectified, and the definition generalized to bicategories, in
          %ul
            %li#Bakovic
              %p
                %a.existingWikiWord{:href => "/nlab/show/Igor+Bakovi%C4%87"}> Igor Baković
                ,
                %em Fibrations of bicategories
                (2010) &amp;lbrack;
                %a{:href => "http://www.irb.hr/korisnici/ibakovic/groth2fib.pdf"}> pdf
                ,
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Bakovic-FibrationsOfBicategories.pdf", :title => "pdf"} pdf
            %li#Buckley
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mitchell+Buckley"}> Mitchell Buckley
                ,
                = succeed "," do
                  %em Fibred 2-categories and bicategories
                %strong 218
                6 (2014) 1034-1074 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1212.6283"}> arXiv:1212.6283
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1016/j.jpaa.2013.11.002"} doi:10.1016/j.jpaa.2013.11.002
          %p
            A definition for strict
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "," do
              %a{:href => "http://www.math.mcgill.ca/bunge"} Marta Bunge
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Marta+Bunge"}> Marta Bunge
              , “Intrinsic
              = succeed "-stack" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a{:href => "https://www.researchgate.net/publication/230792798_Intrinsic_n-stack_completions_over_a_topos"} here
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            \-pseudofunctors may be viewed (and defined) as
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/anafunctor"} anafunctor
            = succeed "-groupoids" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-pseudofunctors" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %ul
            %li
              %a{:href => "http://www-lmpa.univ-littoral.fr/~bourn"}> D. Bourn
              , Pseudo functors and non abelian weak equivalences, in “Categorical algebra and its applications”, Springer LNM 1348 (1988), 55–70.
