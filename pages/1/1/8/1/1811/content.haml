          %p
            The
            %strong Legendre polynomial
            %math#mathml_e85dda7d172d409bde2e1b87c13377df717b4797_1.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi P
                    %mi l
                %annotation{:encoding => "application/x-tex"} P_l
            (for
            = succeed ")" do
              %math#mathml_e85dda7d172d409bde2e1b87c13377df717b4797_2.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi l
                    %mo =
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo ,
                    %mn 2
                    %mo ,
                    %mi …
                  %annotation{:encoding => "application/x-tex"} l =0,1,2,\ldots
            %a.existingWikiWord{:href => "/nlab/show/polynomial"} polynomial
            in one variable given by the formula
          .maruku-equation
            %math#mathml_e85dda7d172d409bde2e1b87c13377df717b4797_3.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi P
                    %mi l
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mfrac
                    %mn 1
                    %mrow
                      %msup
                        %mn 2
                        %mi l
                      %mi l
                      %mo !
                  %mfrac
                    %mrow
                      %msup
                        %mi d
                        %mi l
                    %mrow
                      %mi d
                      %msup
                        %mi x
                        %mi l
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi x
                    %mn 2
                  %mo −
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi l
                %annotation{:encoding => "application/x-tex"}
                  P_l(x) = \frac{1}{2^l l!} \frac{d^l}{d x^l}(x^2-1)^l
          %p Alternatively they can be defined via a generating function:
          .maruku-equation
            %math#mathml_e85dda7d172d409bde2e1b87c13377df717b4797_4.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mn 1
                    %msqrt
                      %mrow
                        %mn 1
                        %mo −
                        %mn 2
                        %mi tx
                        %mo +
                        %msup
                          %mi t
                          %mn 2
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi n
                      %mo ≥
                      %mn 0
                  %msub
                    %mi P
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %msup
                    %mi t
                    %mi n
                %annotation{:encoding => "application/x-tex"}
                  \\frac{1}{\sqrt{1-2tx+t^2}} = \sum_{n\geq 0} P_n(x) t^n
          %p The Legendre polynomials satisfy:
          %ul
            %li
              the following
              %a.existingWikiWord{:href => "/nlab/show/differential+equation"} differential equation
              of the second order
              .maruku-equation
                %math#mathml_e85dda7d172d409bde2e1b87c13377df717b4797_5.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mfrac
                        %mi d
                        %mrow
                          %mi d
                          %mi x
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo −
                      %msup
                        %mi x
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mfrac
                        %mrow
                          %mi d
                          %msub
                            %mi P
                            %mi l
                        %mrow
                          %mi d
                          %mi x
                      %mo{:stretchy => "false"} ]
                      %mo +
                      %mi l
                      %mo{:stretchy => "false"} (
                      %mi l
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %msub
                        %mi P
                        %mi l
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"}
                      \\frac{d}{d x}[(1-x^2)\frac{d P_l}{d x}] + l(l+1) P_l = 0
            %li
              the recursion relations
              .maruku-equation
                %math#mathml_e85dda7d172d409bde2e1b87c13377df717b4797_6.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi l
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %msub
                        %mi P
                        %mrow
                          %mi l
                          %mo +
                          %mn 1
                      %mo −
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mi l
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mi x
                      %msub
                        %mi P
                        %mi l
                      %mo +
                      %mi l
                      %msub
                        %mi P
                        %mrow
                          %mi l
                          %mo −
                          %mn 1
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"}
                      (l+1)P_{l+1}-(2l+1)x P_l+l P_{l-1}=0
            %li
              the mixed differential recursion relations
              .maruku-equation
                %math#mathml_e85dda7d172d409bde2e1b87c13377df717b4797_7.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi P
                              %msub
                                %mo ′
                                %mrow
                                  %mi l
                                  %mo +
                                  %mn 1
                              %mo −
                              %mi P
                              %msub
                                %mo ′
                                %mrow
                                  %mi l
                                  %mo −
                                  %mn 1
                              %mo =
                              %mo{:stretchy => "false"} (
                              %mn 2
                              %mi l
                              %mo +
                              %mn 1
                              %mo{:stretchy => "false"} )
                              %msub
                                %mi P
                                %mi l
                          %mtr
                            %mtd
                              %mi P
                              %msub
                                %mo ′
                                %mrow
                                  %mi l
                                  %mo +
                                  %mn 1
                              %mo −
                              %mi x
                              %mi P
                              %msub
                                %mo ′
                                %mi l
                              %mo =
                              %mo{:stretchy => "false"} (
                              %mi l
                              %mo +
                              %mn 1
                              %mo{:stretchy => "false"} )
                              %msub
                                %mi P
                                %mi l
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} (
                              %msup
                                %mi x
                                %mn 2
                              %mo −
                              %mn 1
                              %mo{:stretchy => "false"} )
                              %msub
                                %mi P
                                %mi l
                              %mo ′
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mi l
                              %mi x
                              %msub
                                %mi P
                                %mi l
                              %mo +
                              %mi l
                              %msub
                                %mi P
                                %mrow
                                  %mi l
                                  %mo −
                                  %mn 1
                              %mo =
                              %mn 0
                    %annotation{:encoding => "application/x-tex"}
                      \\array {
                      P'_{l+1}-P'_{l-1} = (2l+1)P_l
                      \\\
                      P'_{l+1}-x P'_l = (l+1)P_l
                      \\\
                      (x^2-1)P_l'-l x P_l+l P_{l-1} = 0
                      }
          %p
            The Legendre polynomials form a complete system of orthogonal polynomials on the interval
            = succeed "," do
              %math#mathml_e85dda7d172d409bde2e1b87c13377df717b4797_8.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [-1,1]
            %a.existingWikiWord{:href => "/nlab/show/Hilbert+space"} Hilbert space
            = succeed "." do
              %math#mathml_e85dda7d172d409bde2e1b87c13377df717b4797_9.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi L
                      %mn 2
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} L^2[-1,1]
          %p
            The first few Legendre polynomials are
            = succeed "," do
              %math#mathml_e85dda7d172d409bde2e1b87c13377df717b4797_10.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi P
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} P_0(x) = 1
            = succeed "," do
