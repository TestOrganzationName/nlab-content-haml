                  %mo ;
                  %mfrac
                    %mrow
                      %mn 1
                      %mo −
                      %mi x
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  P_\nu(x)={}_2 F_1(-\nu,\nu+1;1;\frac{1-x}{2})
          %p
            Legendre polynomials enter the expressions for the
            = succeed "s" do
              %span.newWikiWord
                spherical function
                %a{:href => "/nlab/new/spherical+function"} ?
            %math#mathml_e85dda7d172d409bde2e1b87c13377df717b4797_31.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mn 2
                %annotation{:encoding => "application/x-tex"} S^2
            in 3d:
          .maruku-equation
            %math#mathml_e85dda7d172d409bde2e1b87c13377df717b4797_32.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Y
                    %mrow
                      %mi l
                      %mi m
                  %mo{:stretchy => "false"} (
                  %mi θ
                  %mo ,
                  %mi ϕ
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msqrt
                    %mrow
                      %mfrac
                        %mrow
                          %mn 2
                          %mi l
                          %mo +
                          %mn 1
                        %mrow
                          %mn 4
                          %mi π
                      %mfrac
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi l
                          %mo −
                          %mi m
                          %mo{:stretchy => "false"} )
                          %mo !
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi l
                          %mo +
                          %mi m
                          %mo{:stretchy => "false"} )
                          %mo !
                  %msubsup
                    %mi P
                    %mi l
                    %mi m
                  %mo{:stretchy => "false"} (
                  %mi cos
                  %mi θ
                  %mo{:stretchy => "false"} )
                  %msup
                    %mi e
                    %mrow
                      %mi im
                      %mi ϕ
                %annotation{:encoding => "application/x-tex"}
                  Y_{l m}(\theta,\phi) = \sqrt{ \frac{2l+1}{4\pi}\frac{(l-m)!}{(l+m)!} } P^m_l(cos\theta) e^{im\phi}
          %p (If it is not clear from mathML rendering – both fractions are under square root – including both the numerators and denominators).
          %p
            If
            %math#mathml_e85dda7d172d409bde2e1b87c13377df717b4797_33.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi θ
                  %mo ,
                  %mi ϕ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\theta,\phi)
            and
            %math#mathml_e85dda7d172d409bde2e1b87c13377df717b4797_34.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi θ
                  %mo ′
                  %mo ,
                  %mi ϕ
                  %mo ′
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\theta',\phi')
            are two points of the
            %a.existingWikiWord{:href => "/nlab/show/unit+sphere"} unit sphere
            in spherical coordinates (polar angle, azimuth), and
            %math#mathml_e85dda7d172d409bde2e1b87c13377df717b4797_35.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi γ
                %annotation{:encoding => "application/x-tex"} \gamma
            is the angle between the two corresponding rays from the origin then
          .maruku-equation
            %math#mathml_e85dda7d172d409bde2e1b87c13377df717b4797_36.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi P
                    %mi l
                  %mo{:stretchy => "false"} (
                  %mi cos
                  %mi γ
                  %mo{:stretchy => "false"} )
                  %mo =
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi m
                      %mo =
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi l
                    %mi l
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi m
                  %msubsup
                    %mi P
                    %mi l
                    %mi m
                  %mo{:stretchy => "false"} (
                  %mi cos
                  %mi θ
                  %mo{:stretchy => "false"} )
                  %msubsup
                    %mi P
                    %mi l
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi m
                  %mo{:stretchy => "false"} (
                  %mi cos
                  %mi θ
                  %mo ′
                  %mo{:stretchy => "false"} )
                  %mi cos
                  %mo{:stretchy => "false"} (
                  %mi m
                  %mo{:stretchy => "false"} (
                  %mi ϕ
                  %mo −
                  %mi ϕ
                  %mo ′
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mfrac
                    %mrow
                      %mn 4
                      %mi π
                    %mrow
                      %mn 2
                      %mi l
                      %mo +
                      %mn 1
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi m
                      %mo =
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi l
                    %mi l
                  %msub
                    %mi Y
                    %mi lm
                  %mo{:stretchy => "false"} (
                  %mi θ
                  %mo ,
                  %mi ϕ
                  %mo{:stretchy => "false"} )
                  %msubsup
                    %mi Y
                    %mi lm
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi θ
                  %mo ′
                  %mo ,
                  %mi ϕ
                  %mo ′
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  P_l(cos \gamma) = \sum_{m=-l}^l (-1)^m P_l^m(cos \theta)P_l^{-m}(cos \theta') cos(m(\phi-\phi')) = \frac{4\pi}{2l+1}\sum_{m=-l}^l Y_{lm}(\theta,\phi) Y_{lm}^*(\theta',\phi')
          %p
            what for
            %math#mathml_e85dda7d172d409bde2e1b87c13377df717b4797_37.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi l
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} l=1
            reduces to the
            %strong spherical law of cosine
            from
            = succeed ":" do
              %a{:href => "http://en.wikipedia.org/wiki/Spherical_trigonometry"} spherical trigonometry
          .maruku-equation
            %math#mathml_e85dda7d172d409bde2e1b87c13377df717b4797_38.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi cos
                  %mi γ
                  %mo =
                  %msub
                    %mi P
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi cos
                  %mi γ
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi cos
                  %mi θ
                  %mi cos
                  %mi θ
                  %mo ′
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %mi sin
                  %mi θ
                  %mi sin
                  %mi θ
                  %mo ′
                  %mi cos
                  %mo{:stretchy => "false"} (
                  %mi ϕ
                  %mo −
                  %mi ϕ
                  %mo ′
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  cos \gamma = P_1(cos \gamma) = cos\theta cos\theta' + sin\theta sin\theta' cos(\phi-\phi')
          %p The orthogonality relation for Legendre polynomials gives Laplace’s formula
          .maruku-equation
            %math#mathml_e85dda7d172d409bde2e1b87c13377df717b4797_39.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mrow
                      %msup
                        %mi S
                        %mn 2
                  %mi d
                  %msub
                    %mi Ω
                    %mover
                      %mi k
                      %mo{:stretchy => "false"} ^
                  %msub
                    %mi Y
                    %mi l
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi k
                    %mo{:stretchy => "false"} ^
                  %mo{:stretchy => "false"} )
                  %msub
                    %mi P
                    %mi l
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi k
                    %mo{:stretchy => "false"} ^
                  %mover
                    %mi p
                    %mo{:stretchy => "false"} ^
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mfrac
                    %mrow
                      %mn 4
                      %mi π
                    %mrow
                      %mn 2
                      %mi l
                      %mo +
                      %mn 1
                  %msub
                    %mi δ
                    %mrow
                      %mi ll
                      %mo ′
                  %msub
                    %mi Y
                    %mi l
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi p
                    %mo{:stretchy => "false"} ^
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\int_{S^2} d\Omega_{\hat{k}} Y_l(\hat{k}) P_l(\hat{k}\hat{p}) = \frac{4\pi}{2l+1} \delta_{ll'} Y_l(\hat{p})
          %p
            where
            %math#mathml_e85dda7d172d409bde2e1b87c13377df717b4797_40.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi k
                    %mo{:stretchy => "false"} ^
                  %mo ,
                  %mover
                    %mi p
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat{k},\hat{p}
            are unit vectors and
            %math#mathml_e85dda7d172d409bde2e1b87c13377df717b4797_41.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Y
                    %mi l
                  %mo =
                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                  %msub
                    %mi a
                    %mi m
                  %msub
                    %mi Y
                    %mi lm
                %annotation{:encoding => "application/x-tex"} Y_l = \sum a_m Y_{lm}
            is some spherical function.
          %p
            The following orthogonality integral relation is over product of unit spheres in
            = succeed ":" do
              %math#mathml_e85dda7d172d409bde2e1b87c13377df717b4797_42.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^3
          .maruku-equation
            %math#mathml_e85dda7d172d409bde2e1b87c13377df717b4797_43.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mover
                      %mi k
                      %mo{:stretchy => "false"} ^
                  %msub
                    %mo ∫
                    %mover
                      %mi p
                      %mo{:stretchy => "false"} ^
                  %mi d
                  %msub
                    %mi Ω
                    %mover
                      %mi k
                      %mo{:stretchy => "false"} ^
                  %mi d
                  %msub
                    %mi Ω
                    %mover
                      %mi p
                      %mo{:stretchy => "false"} ^
                  %msub
                    %mi P
                    %mi l
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi k
                    %mo{:stretchy => "false"} ^
                  %mover
                    %mi p
                    %mo{:stretchy => "false"} ^
                  %mo{:stretchy => "false"} )
                  %msub
                    %mi P
                    %mrow
                      %mi l
                      %mo ′
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi k
                    %mo{:stretchy => "false"} ^
                  %mover
                    %mi q
                    %mo{:stretchy => "false"} ^
                  %mo{:stretchy => "false"} )
                  %msub
                    %mi P
                    %mrow
                      %mi l
                      %mo ″
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi p
                    %mo{:stretchy => "false"} ^
                  %mover
                    %mi q
                    %mo{:stretchy => "false"} ^
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mrow
                    %mo (
                    %mfrac
                      %mrow
                        %mn 4
                        %mi π
                      %mrow
                        %mn 2
                        %mi l
                        %mo +
                        %mn 1
                    %mo )
                  %msub
                    %mi δ
                    %mrow
                      %mi ll
                      %mo ′
                  %msub
                    %mi δ
                    %mrow
                      %mi ll
                      %mo ″
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mspace{:width => "thinmathspace"}
                  %mspace{:width => "thinmathspace"}
                  %mspace{:width => "thinmathspace"}
                  %mspace{:width => "thinmathspace"}
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\int_{\hat{k}}\int_{\hat{p}} d\Omega_{\hat{k}}d\Omega_{\hat{p}} P_l(\hat{k}\hat{p}) P_{l'}(\hat{k}\hat{q}) P_{l''}(\hat{p}\hat{q}) = \left(\frac{4\pi}{2l+1}\right)\delta_{ll'}\delta_{ll''}, \,\,\,\,\,(*)
          %p
            where the arguments of Legendre polynomials are the
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/inner+product"} inner product
          %p
            %em> Zoran
            \: the last formula
            %math#mathml_e85dda7d172d409bde2e1b87c13377df717b4797_44.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (*)
            is in my own formula notes which I have written as a student many years ago and used hundreds of times, but it now looks to me suspicious; I have no time to check it right now.
