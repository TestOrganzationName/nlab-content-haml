          %h2#properties Properties
          #EulerLagrangeDerivativeIsDerivationViaAdjointFrechetDerivatives.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+derivative"} Euler-Lagrange derivative
                is
                %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
                via
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/evolutionary+derivatives"} evolutionary derivatives
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mover
                      %mo →
                      %mi vb
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} V \overset{vb}{\to} \Sigma
              be a
              %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
              and write
