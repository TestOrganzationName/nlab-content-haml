                      %mi L
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi δ
                      %mi EL
                    %mi L
                    %mo ∧
                    %msub
                      %mi dvol
                      %mi Σ
                  %annotation{:encoding => "application/x-tex"}
                    \\delta_{EL}\mathbf{L}
                    \\;=\;
                    \\delta_{EL}L \wedge dvol_\Sigma
            %p
