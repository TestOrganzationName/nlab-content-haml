            %h6#proof_2 Proof
            %p
              By definition of the
              %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+form"} Euler-Lagrange form
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                        %msub
                          %mi δ
                          %mi EL
                        %mi L
                      %mrow
                        %mi δ
                        %msup
                          %mi ϕ
                          %mi a
                    %mi δ
                    %msup
                      %mi ϕ
                      %mi a
                    %mspace{:width => "thinmathspace"}
                    %mo ∧
                    %msub
                      %mi dvol
                      %mi Σ
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi δ
                    %mi L
                    %mspace{:width => "thinmathspace"}
                    %mo ∧
                    %msub
                      %mi dvol
                      %mi Σ
                    %mspace{:width => "thickmathspace"}
                    %mo +
                    %mspace{:width => "thickmathspace"}
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mo .
                    %mo .
                    %mo .
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\frac{\delta_{EL} L }{\delta \phi^a}
                    \\delta \phi^a
                    \\,
                    \\wedge
                    dvol_\Sigma
                    \\;=\;
                    \\delta L \,\wedge dvol_\Sigma \;+\; d(...)
                    \\,.
            %p
              Applying the
              %a.existingWikiWord{:href => "/nlab/show/variational+derivative"} variational derivative
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                  %annotation{:encoding => "application/x-tex"} \delta
              to both sides of this equation yields
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mi δ
                      %mfrac
                        %mrow
                          %msub
                            %mi δ
                            %mi EL
                          %mi L
                        %mrow
                          %mi δ
                          %msup
                            %mi ϕ
                            %mi a
                      %mo )
                    %mo ∧
                    %mi δ
                    %msup
                      %mi ϕ
                      %mi a
                    %mspace{:width => "thinmathspace"}
                    %mo ∧
                    %msub
                      %mi dvol
                      %mi Σ
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %munder
                        %mrow
                          %mi δ
                          %mi δ
                          %mi L
                        %mo ⏟
                      %mrow
                        %mo =
                        %mn 0
                    %mo ∧
                    %msub
                      %mi dvol
                      %mi Σ
                    %mspace{:width => "thickmathspace"}
                    %mo +
                    %mspace{:width => "thickmathspace"}
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mo .
                    %mo .
                    %mo .
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left(\delta \frac{\delta_{EL} L }{\delta \phi^a}\right)
                    \\wedge
                    \\delta \phi^a
                    \\,
                    \\wedge
                    dvol_\Sigma
                    \\;=\;
                    \\underset{= 0}{\underbrace{\delta \delta L}} \wedge dvol_\Sigma
                    \\;+\;
                    d(...)
                    \\,.
            %p
              It follows that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ,
                    %mi w
                  %annotation{:encoding => "application/x-tex"} v,w
              any two
              %a.existingWikiWord{:href => "/nlab/show/evolutionary+vector+fields"} evolutionary vector fields
              the contraction of their prolongations
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi v
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat v
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi w
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat w
              into the
              %a.existingWikiWord{:href => "/nlab/show/variational+differential+form"} differential 2-form
              on the left is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mi δ
                      %mfrac
                        %mrow
                          %msub
                            %mi δ
                            %mi EL
                          %mi L
                        %mrow
                          %mi δ
                          %msup
                            %mi ϕ
                            %mi a
                      %mo ∧
                      %mi δ
                      %msup
                        %mi ϕ
                        %mi a
                      %mo )
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo ,
                    %mi w
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi w
                      %mi a
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi{:mathvariant => "normal"} D
                      %mrow
                        %msub
                          %mi δ
                          %mi EL
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi a
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo −
                    %msup
                      %mi v
                      %mi b
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi{:mathvariant => "normal"} D
                      %mrow
                        %msub
                          %mi δ
                          %mi EL
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi b
                    %mo{:stretchy => "false"} (
                    %mi w
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    \\delta \frac{\delta_{EL} L }{\delta \phi^a}
                    \\wedge
                    \\delta \phi^a
                    \\right)(v,w)
                    \=
                    w^a
                    (\mathrm{D}_{\delta_{EL}})_a(v)
                    \-
                    v^b(\mathrm{D}_{\delta_{EL}})_b(w)
                    \\,,
            %p
              by inspection of the definition of the
              %a.existingWikiWord{:href => "/nlab/show/evolutionary+derivative"} evolutionary derivative
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FieldDependentDifferentialOperatorDerivative"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} ^
                    %msub
                      %mi ι
                      %mover
                        %mi w
                        %mo{:stretchy => "false"} ^
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mo .
                    %mo .
                    %mo .
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mo .
                    %mo .
                    %mo .
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\iota_{\hat v}
                    \\iota_{\hat w}
                    d(...)
                    \\;=\;
                    d(...)
            %p
              by the fact (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#EvolutionaryVectorFieldProlongation"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/total+spacetime+derivative"} total spacetime derivative
            %p Hence the last two equations combined give
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi w
                      %mi a
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi{:mathvariant => "normal"} D
                      %mrow
                        %msub
                          %mi δ
                          %mi EL
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi a
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo −
                    %msup
                      %mi v
                      %mi b
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi{:mathvariant => "normal"} D
                      %mrow
                        %msub
                          %mi δ
                          %mi EL
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi b
                    %mo{:stretchy => "false"} (
                    %mi w
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mo .
                    %mo .
                    %mo .
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    w^a
                    (\mathrm{D}_{\delta_{EL}})_a(v)
                    \-
                    v^b(\mathrm{D}_{\delta_{EL}})_b(w)
                    \\;=\;
                    d(...)
                    \\,.
            %p
              This is the defining condition for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} D
                      %mrow
                        %msub
                          %mi δ
                          %mi EL
                  %annotation{:encoding => "application/x-tex"} \mathrm{D}_{\delta_{EL}}
              to be
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/formally+self-adjoint+differential+operator"} formally self-adjoint differential operator
