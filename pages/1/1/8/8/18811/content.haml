              %a.existingWikiWord{:href => "/nlab/show/vertical+cotangent+bundle"} vertical cotangent bundle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mi EL
                    %mi L
