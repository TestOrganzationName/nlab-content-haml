          %ul#Gilkey
            %li
              %a.existingWikiWord{:href => "/nlab/show/Peter+Gilkey"}> Peter Gilkey
              ,
              %em The Atiyah-Singer Index Theorem – Chapter 5
              (
              %a{:href => "http://www.maths.ed.ac.uk/~aar/papers/gilkey3.pdf"}> pdf
              )
          %ul#AtiyahBott
            %li
              %a.existingWikiWord{:href => "/nlab/show/Michael+Atiyah"}> Michael Atiyah
              ,
              = succeed "," do
