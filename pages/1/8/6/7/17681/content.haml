                    %mi id
                    %mspace{:width => "thinmathspace"}
                    %mo ≡
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi prog
                      %mn 23
                  %annotation{:encoding => "application/x-tex"} prog_{12} \,\equiv\, id \,\equiv\, prog_{23}
              immediately yields, by
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:JoinFromBind"} (7)
            %p#NaturalityFollows
              It just remains to see that the system of transformations
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
