                        D \,\colon\, Type
                        \\;\;\;\;\;\;
                        \\vdash
                        \\;\;\;\;\;\;
                        trans_D
                        \\,\colon\,
                        \\mathcal{E}(D) \to \mathcal{E}'(D)
            %p which
            %ol
              %li
                %p preserves the return-operations, in that
                #eq:RespectForReturnOperation.maruku-equation
                  %span.maruku-eq-number (2)
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi trans
                        %mo ∘
                        %msup
                          %mi ret
                          %mi ℰ
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %msup
                          %mi ret
                          %mrow
                            %mi ℰ
                            %mo ′
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        trans \circ ret^{\mathcal{E}}
                        \\;=\;
                        ret^{\mathcal{E}'}
                        \\,,
              %li
                %p
                  preserves the bind-operations, in that for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi prog
                          %mn 12
                        %mspace{:width => "thinmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thinmathspace"}
