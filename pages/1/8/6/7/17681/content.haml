                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mi ℰ
                    %mo{:stretchy => "false"} (
                    %mi D
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ℰ
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} trans_D \,\colon\, \mathcal{E}(D) \to \mathcal{E}'(D)
              is a monad transformer in the sense of Def.
              %a.maruku-ref{:href => "#MonadTransformer"}
              (cf. Rem.
              = succeed ")" do
                %a.maruku-ref{:href => "#PointedEndofunctorConditionOrNot"}
              %a{:href => "monad#TransformationOfMonadsOnFixedCategory"} homomorphism of monads
              (in the original sense of
              = succeed ")," do
                %a{:href => "monad#Maranda66"} Maranda 1966
            %ol
