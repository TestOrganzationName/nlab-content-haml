                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} prog_{23}\,\colon\, D_2 \to \mathcal{E}(D_3)
                %p we have
                #eq:RespectForBindOperation.maruku-equation
                  %span.maruku-eq-number (3)
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi trans
