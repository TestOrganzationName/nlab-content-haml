                    %semantics
                      %mrow
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} trans
                        %mspace{:width => "thinmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thinmathspace"}
                        %mi ℰ
                        %mo →
                        %mi ℰ
                        %mo ′
                      %annotation{:encoding => "application/x-tex"} \trans \,\colon\, \mathcal{E} \to \mathcal{E}'
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/underlying"} underlying
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/functors"} functors
              %li
                %p
                  respecting the
                  = succeed "," do
