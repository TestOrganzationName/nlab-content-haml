          .proof
            %h6 Proof
            %p Recall that the relation between the bind- and join-operations is:
            #eq:BindFromJoin.maruku-equation
              %span.maruku-eq-number (5)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi bind
                      %mi ℰ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi f
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi D
                      %mn 1
                    %mo →
                    %mi ℰ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi D
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≡
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi join
                      %mrow
                        %msub
                          %mi D
                          %mn 2
                      %mi ℰ
                    %mo ∘
                    %mi ℰ
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    bind^{\mathcal{E}} \big( f \,\colon\, D_1 \to \mathcal{E}(D_2) \big)
                    \\;\equiv\;
                    join^{\mathcal{E}}_{D_2} \circ \mathcal{E}(f)
            %p and
            #eq:FunctorFromBind.maruku-equation
              %span.maruku-eq-number (6)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi D
                      %mn 1
                    %mo →
                    %msub
                      %mi D
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≡
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi bind
                      %mi ℰ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi D
                      %mn 1
                    %mover
                      %mo →
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mi f
                        %mspace{:width => "thickmathspace"}
                    %msub
                      %mi D
                      %mn 2
                    %mover
                      %mo →
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %msubsup
                          %mi ret
                          %mrow
                            %msub
                              %mi D
                              %mn 2
                          %mi ℰ
                        %mspace{:width => "thickmathspace"}
                    %mi ℰ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi D
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{E}(f \,\colon\, D_1 \to D_2)
                    \\;\equiv\;
                    bind^{\mathcal{E}}
                    \\big(
                    D_1
                    \\xrightarrow{\; f \;}
                    D_2
                    \\xrightarrow{\; ret^{\mathcal{E}}_{D_2} \;}
                    \\mathcal{E}(D_2)
                    \\big)
            #eq:JoinFromBind.maruku-equation
              %span.maruku-eq-number (7)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi join
                      %mi D
                      %mi ℰ
                    %mspace{:width => "thickmathspace"}
                    %mo ≡
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi bind
                      %mi ℰ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi id
                      %mrow
                        %mi ℰ
                        %mo{:stretchy => "false"} (
                        %mi D
                        %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    join^{\mathcal{E}}_{D}
                    \\;\equiv\;
                    bind^{\mathcal{E}}\big( id_{\mathcal{E}(D)} \big)
                    \\,.
            %p
              Now in one direction: Given a
              %a{:href => "monad#TransformationOfMonadsOnFixedCategory"} morphism of monads
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi trans
                      %mspace{:width => "thinmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thinmathspace"}
                      %mi ℰ
                      %mo →
                      %mi ℰ
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} trans \,\colon\, \mathcal{E} \to \mathcal{E}'
              %a.existingWikiWord{:href => "/nlab/show/pasting+diagram"} pasting diagram
              of the above square with the
              %a.existingWikiWord{:href => "/nlab/show/naturality+square"} naturality square
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi trans
                  %annotation{:encoding => "application/x-tex"} trans
              as follows:
