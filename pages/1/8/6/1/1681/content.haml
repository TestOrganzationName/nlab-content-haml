                  %annotation{:encoding => "application/x-tex"} \infty
          %h3#CohomologyOfEMSpaces Of EM spaces
          %p
            On the other hand there is the
            %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            of Eilenberg-MacLane spaces itself. This is in general rich. Classical results by
            %a.existingWikiWord{:href => "/nlab/show/Serre"} Serre
            and
            %a.existingWikiWord{:href => "/nlab/show/Henri+Cartan"} Henri Cartan
            are reviewed in (
            %a{:href => "#Clement02"}> Clement 02, section 2
            ).
          #RationalCohomologyOfKZn.num_prop
            %h6#proposition_2 Proposition
            %p
              For all even
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary
              %a.existingWikiWord{:href => "/nlab/show/cohomology+ring"} cohomology ring
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K(\mathbb{Z},n)
              with
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              in the
              %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
              is the
              %a.existingWikiWord{:href => "/nlab/show/polynomial+algebra"} polynomial algebra
              on the generator
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %msup
                        %mi H
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi K
                      %mo{:stretchy => "false"} (
                      %mi ℤ
                      %mo ,
                      %mi n
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi ℚ
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mi ℚ
                    %annotation{:encoding => "application/x-tex"} a \in H^n(K(\mathbb{Z},n),\mathbb{Q}) \simeq \mathbb{Q}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              it is the
              %a.existingWikiWord{:href => "/nlab/show/exterior+algebra"} exterior algebra
              on this generator:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi ℚ
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi ℚ
                              %mo{:stretchy => "false"} [
                              %mi a
                              %mo{:stretchy => "false"} ]
                            %mtd
                              %mi n
                              %mspace{:width => "thickmathspace"}
                              %mi even
                          %mtr
                            %mtd
                              %mi ℚ
                              %mo{:stretchy => "false"} [
                              %mi a
                              %mo{:stretchy => "false"} ]
                              %mo{:stretchy => "false"} /
                              %mo{:stretchy => "false"} (
                              %msup
                                %mi a
                                %mn 2
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mi n
                              %mspace{:width => "thickmathspace"}
                              %mi odd
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^\bullet(K(\mathbb{Z},n),\mathbb{Q})
                    \\simeq
                    \\left\{
                    \\array{
                    \\mathbb{Q}[a] &amp; n \; even
                    \\\
                    \\mathbb{Q}[a]/(a^2) &amp; n \; odd
                    }
                    \\right.
                    \\,.
          %p
            This is reviewed for instance in (
            %a{:href => "#Yin"}> Yin, section 4
            ).
          %p
            In p.130 of
            = succeed "," do
              %a{:href => "#EilenbergMacLane54II"} Eilenberg &amp; MacLane (1954)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} K(A,n)
            are computed.
          #RationalCohomologyOfKZn.num_prop
            %h6#proposition_3 Proposition
            %p There are stable isomorphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mtext Hom
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    H^n(K(A,n),G) \cong \text{Hom}(A,G)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mrow
                        %mi m
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi m
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mtext Extabel
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mtext Ext
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %msup
                      %mi H
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    H^{m+1}(K(A,m),G)\cong \text{Extabel}(A,G)\subset \text{Ext}(A,G)\cong H^2(K(A,1),G)
            %p
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n\geq 1
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                      %mo ≥
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} m\geq 2
          #RationalCohomologyOfKZn.num_prop
            %h6#proposition_4 Proposition
            %p There exists an isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mn 4
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mtext Hom
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Γ
                      %mn 4
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi G
                    %mo{:stretchy => "false"} )
