          %h2#definition Definition
          .num_defn
            %h6#definition_2 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              be an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f : A \to B
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} g : X \to Y
              two
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mrow
                        %mi A
                        %mo ⫽
                        %mi Y
                  %annotation{:encoding => "application/x-tex"} C_{A\sslash Y}
              for the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/over-%28%E2%88%9E%2C1%29-category"} under-over-(∞,1)-category
            %p
              We say that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is
              %strong left orthogonal
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              and that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              is
              %strong right orthogonal
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              and write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ⊥
                    %mi g
                  %annotation{:encoding => "application/x-tex"}
                    f \perp g
            %p
              if for every
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mo →
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi f
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msub
                              %mo ⇙
                              %mo ≃
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi g
                        %mtr
                          %mtd
                            %mi B
                          %mtd
                            %mo →
                          %mtd
                            %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A &amp;\to&amp; X
                    \\\
                    {}^{\mathllap{f}}\downarrow &amp;\swArrow_{\simeq}&amp; \downarrow^{\mathrlap{g}}
                    \\\
                    B &amp;\to&amp; Y
                    }
            %p
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              we have that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mrow
                        %mi A
                        %mo ⫽
                        %mi Y
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo *
                  %annotation{:encoding => "application/x-tex"} C_{A\sslash Y}(B,X) \simeq *
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/contractible"} contractible
          %p
            Note that the notation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mrow
                      %mi A
                      %mo ⫽
                      %mi Y
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C_{A\sslash Y}(B,X)
            subtly includes the given commuting diagram, since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mrow
                      %mi A
                      %mo ⫽
                      %mi Y
                %annotation{:encoding => "application/x-tex"} C_{A\sslash Y}
            is only defined relative to a particular given morphism
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} A\to Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            regarded as objects of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mrow
                      %mi A
                      %mo ⫽
                      %mi Y
                %annotation{:encoding => "application/x-tex"} C_{A\sslash Y}
            via the resulting commuting triangles.
          .num_defn
            %h6#definition_3 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              be an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
              %strong orthogonal factorization system
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is a pair
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mi L
                    %mo ,
                    %msub
                      %mi S
                      %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (S_L, S_R)
              of
              = succeed "es" do
                %a.existingWikiWord{:href => "/nlab/show/class"} class
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              that satisfy the following axioms.
            %ol
              %li
                %p
                  Both classes are stable under
                  = succeed "s." do
                    %a.existingWikiWord{:href => "/nlab/show/retract"} retract
              %li
                %p
                  Every morphism in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi S
                          %mi L
                      %annotation{:encoding => "application/x-tex"} S_L
                  is left orthogonal to every morphism in
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi S
                            %mi R
                        %annotation{:encoding => "application/x-tex"} S_R
              %li
                %p
                  For every morphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi h
                        %mo :
                        %mi X
                        %mo →
                        %mi Z
                      %annotation{:encoding => "application/x-tex"} h : X \to Z
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  there exists a commuting triangle
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %mi Y
                            %mtr
                              %mtd
                              %mtd
                                %msup
                                  %mrow
                                  %mpadded{:lspace => "-100%width", :width => "0"}
                                    %mi f
                                %mo ↗
                              %mtd
                              %mtd
                                %msup
                                  %mo ↘
                                  %mpadded{:width => "0"}
                                    %mi g
                            %mtr
                              %mtd
                                %mi X
                              %mtd
                              %mtd
                                %mover
                                  %mo →
                                  %mi h
                              %mtd
                              %mtd
                                %mi Z
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        \&amp;&amp; Y
                        \\\
                        \&amp; {}^{\mathllap{f}}\nearrow &amp;&amp; \searrow^{\mathrlap{g}}
                        \\\
                        X &amp;&amp;\stackrel{h}{\to}&amp;&amp; Z
                        }
                %p
                  with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo ∈
                        %msub
                          %mi S
                          %mi L
                      %annotation{:encoding => "application/x-tex"} f \in S_L
                  and
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi g
                          %mo ∈
                          %msub
                            %mi S
                            %mi R
                        %annotation{:encoding => "application/x-tex"} g \in S_R
          %h2#properties Properties
          %h3#ClosureProperties Closure properties
          %p
          #RightClassStableUnderLimitsInArrowCategory.num_prop
            %h6 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (L,R)
              a factorization system in an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %a.existingWikiWord{:href => "/nlab/show/full+sub-%28%E2%88%9E%2C1%29-category"} full sub-(∞,1)-category
              of the
              %a.existingWikiWord{:href => "/nlab/show/arrow+category"} arrow category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mn 1
                    %mo ,
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Func(\Delta^1, \mathcal{C})
              on the morphisms in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is closed under
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-limits"} (∞,1)-limits
              of shapes that exist in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/formal+duality"} Dually
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              is closed under
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimits"} (∞,1)-colimits
              that exist in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
          (
          %a{:href => "#Lurie"}> Lurie 2009, prop. 5.2.8.6 (7), (8)
          )
          %p
            In fact:
          #RightClassReflectiveInArrowCategory.num_prop
            %h6 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/full+sub-%28infinity%2C1%29-category"}
                full sub-
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
                \-category
              of the
              %a.existingWikiWord{:href => "/nlab/show/arrow+category"} arrow category
              on the right class is a
              %a.existingWikiWord{:href => "/nlab/show/reflective+sub-%28infinity%2C1%29-category"}
                reflective sub-
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
                \-category
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi 𝒞
                      %mrow
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mi R
                    %munderover
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mo ⊥
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                      %munder
                        %mo ↪
                        %mrow
                      %mover
                        %mo ⟵
                        %mrow
                    %msup
                      %mi 𝒞
                      %mrow
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\big(\mathcal{C}^{\Delta[1]}\big)_R
                    \\underoverset
                    {\underset{}{\hookrightarrow}}
                    {\overset{}{\longleftarrow}}
                    {\;\; \bot \;\;}
                    \\mathcal{C}^{\Delta[1]}
            %p
              Moreover, the
              %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} adjunction units
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi f
                    %mo →
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ¯
                  %annotation{:encoding => "application/x-tex"} \eta_f \colon f \to \bar f
              are of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo ∈
                                %mi L
                          %mtd
                            %mover
                              %mi X
                              %mo{:stretchy => "false"} ¯
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi f
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                          %mtd
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                            %msup
                              %mrow
                              %mpadded{:width => "0"}
                                %mrow
                                  %mover
                                    %mi f
                                    %mo{:stretchy => "false"} ¯
                                  %mo ∈
                                  %mi R
                        %mtr
                          %mtd
                            %mi Y
                          %mtd
                            %mover
                              %mo ⟶
                              %mo ≃
                          %mtd
                            %mover
                              %mi Y
                              %mo{:stretchy => "false"} ¯
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;\stackrel{\in L}{\longrightarrow}&amp; \bar X
                    \\\
                    {}^{\mathllap{f}}
                    \\big\downarrow
                    \&amp;&amp;
                    \\big\downarrow{}^{\mathrlap{\bar f \in R} }
                    \\\
                    Y &amp;\stackrel{\simeq}{\longrightarrow}&amp; \bar Y
                    }
                    \\,.
            %p
              (In words: the reflection into
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi 𝒞
                      %mrow
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mi R
                  %annotation{:encoding => "application/x-tex"} \big(\mathcal{C}^{\Delta[1]}\big)_R
              is given by the factorization in
              = succeed ".)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi L
                      %mo ,
                      %mi R
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (L,R)
          (
          %a{:href => "#Lurie"}> Lurie 2009, Lemma 5.2.8.19
          )
          %h2#examples Examples
          %ul
            %li
              In an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
