                            %mspace{:width => "thinmathspace"}
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbb{H}P^1
                    \&amp;
                    \\overset{
                    \\Sigma^4 1_E
                    }{
                    \\longrightarrow
                    }
                    \&amp;
                    \\Omega^{\infty - 4} E
                    \\\
                    \\big\downarrow
                    \&amp;
                    \\nearrow \mathrlap{ {}_{p_1^E} }
                    \\\
