          #ComplexOrientationByExtensionsAndTheirObstructions.num_remark
            %h6#remark Remark
            %p
              %strong
                (quaternionic
                = succeed "-orientation" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
                %a.existingWikiWord{:href => "/nlab/show/extensions"} extensions
                and their
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/obstructions"} obstructions
            %p
              In terms of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Brown+representability+theorem"} classifying maps
              %a.maruku-ref{:href => "#QuaternionicOrientedCohomologyTheory"}
              means that a quaternionic orientation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi p
                      %mn 1
                      %mi E
                  %annotation{:encoding => "application/x-tex"} p_1^E
              in
              = succeed "-cohomology" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %a.existingWikiWord{:href => "/nlab/show/extension"} extension
              (in the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/classical+homotopy+category"} classical homotopy category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Σ
                      %mn 4
                    %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mi ℍ
                    %msup
                      %mi P
                      %mn 1
                    %mo ⟶
                    %msup
                      %mi Ω
                      %mrow
                        %mn ∞
                        %mo −
                        %mn 4
                    %mi E
                  %annotation{:encoding => "application/x-tex"} \Sigma^4 1 \,\colon\, \mathbb{H}P^1 \longrightarrow \Omega^{\infty -4} E
              (which classifies the suspended
              %a.existingWikiWord{:href => "/nlab/show/ring+unit"} ring unit
              in the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/cohomology+ring"} cohomology ring
              %a.existingWikiWord{:href => "/nlab/show/quaternionic+projective+spaces"} quaternionic projective spaces
            #eq:QuaternionicOrientationAsExtension.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
