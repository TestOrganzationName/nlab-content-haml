                                  %mi Σ
                                  %mn 4
                                %msub
                                  %mn 1
                                  %mi E
                          %mtd
                            %msup
                              %mi Ω
                              %mrow
                                %mn ∞
                                %mo −
                                %mn 4
                            %mi E
                        %mtr
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                          %mtd
                            %mo ↗
