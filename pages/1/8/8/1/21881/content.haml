                    \\,.
                    }
            %p
              Notice that the
              %a.existingWikiWord{:href => "/nlab/show/quaternionic+projective+spaces"} quaternionic projective spaces
              form a
              %a.existingWikiWord{:href => "/nlab/show/cotower"} cotower
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo =
                    %mspace{:width => "thinmathspace"}
                    %mi ℍ
                    %msup
                      %mi P
                      %mn 0
                    %mo ↪
                    %mi ℍ
                    %msup
                      %mi P
                      %mn 1
                    %mo ↪
                    %mi ℍ
