          %h2#idea Idea
          %p
            Quaternionic oriented cohomology theory is the analog of
            %a.existingWikiWord{:href => "/nlab/show/complex+oriented+cohomology+theory"} complex oriented cohomology theory
            as
            %a.existingWikiWord{:href => "/nlab/show/complex+vector+bundles"} complex vector bundles
            are replaced by
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/quaternionic+vector+bundles"} quaternionic vector bundles
          %h2#definition Definition
          #QuaternionicOrientedCohomologyTheory.num_defn
            %h6#definition_2 Definition
            %p
              %strong (quaternionic oriented cohomology theory)
            %p
              A
              %em quaternionic orientation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi p
                      %mn 1
                      %mi E
                  %annotation{:encoding => "application/x-tex"} p_1^E
              (a generalized
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/first+Pontrjagin+class"} first Pontrjagin class
              %a.existingWikiWord{:href => "/nlab/show/multiplicative+cohomology+theory"} multiplicative
              %a.existingWikiWord{:href => "/nlab/show/Whitehead+generalized+cohomology+theory"} Whitehead generalized cohomology theory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is an
              %a.existingWikiWord{:href => "/nlab/show/extension"} extension
              of the 4-suspended
              %a.existingWikiWord{:href => "/nlab/show/ring+unit"} ring unit
              in the
              %a.existingWikiWord{:href => "/nlab/show/cohomology+ring"} cohomology ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mo •
                    %mspace{:width => "thinmathspace"}
                    %mo ≃
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi E
                      %mn 4
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi H
                    %msup
                      %mi ℙ
                      %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"} E_\bullet \,\simeq\, E^4\big( H\mathbb{P}^1\big)
              from the
              %a.existingWikiWord{:href => "/nlab/show/quaternionic+projective+space"} quaternionic projective space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℍ
                    %msup
                      %mi P
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{H}P^1
              (the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/4-sphere"} 4-sphere
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                      %msup
                        %mi ℙ
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} H\mathbb{P}^\infty
            #eq:QuaternionicOrientationByExtension.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
