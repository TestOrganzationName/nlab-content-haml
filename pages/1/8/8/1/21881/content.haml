                    \\hookrightarrow
                    \\cdots
                    \\hookrightarrow
                    \\mathbb{H}P^\infty
                    \\,=\,
                    \\underset{\longrightarrow}{\lim}
                    \\mathbb{H}P^\bullet
            %p
              where each inclusion stage is (by
              = succeed "," do
                %a{:href => "complex+projective+space#CellComplexStructureOnComplexProjectiveSpace"} this Prop.
              = succeed ")" do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/cell+structure+of+projective+spaces"} cell structure of projective spaces
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
              %a{:href => "Top#UniversalConstructions"} of topological spaces
              (or rather: of
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/pointed+topological+spaces"} pointed topological spaces
            .maruku-equation
