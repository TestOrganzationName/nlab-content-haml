          %p Hence:
          #QuaternionicOrientationExistsIf4nMinus1DegreesAreTrivial.num_prop
            %h6#proposition Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is a
              %a.existingWikiWord{:href => "/nlab/show/multiplicative+cohomology+theory"} multiplicative
              %a.existingWikiWord{:href => "/nlab/show/Whitehead+generalized+cohomology+theory"} Whitehead generalized cohomology theory
              whose
              %a.existingWikiWord{:href => "/nlab/show/graded-commutative+ring"} graded
              %a.existingWikiWord{:href => "/nlab/show/cohomology+ring"} cohomology ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mo •
                  %annotation{:encoding => "application/x-tex"} E_\bullet
              is trivial in degrees
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 4
                      %mi n
                      %mo −
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 4 n - 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              admits a quaternionic orientation (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#QuaternionicOrientedCohomologyTheory"}
          %h2#Examples Examples
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
                has coefficient ring concentrated in degree 0, and hence satisfies the sufficient condition of Prop.
                %a.maruku-ref{:href => "#QuaternionicOrientationExistsIf4nMinus1DegreesAreTrivial"}
                to admit quaternionic orientation;
            %li
              %p
