            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Stephen+Lack"}> Stephen Lack
                ,
                = succeed "," do
                  %em Note on the construction of free monoids
          %p
            The list
            %a.existingWikiWord{:href => "/nlab/show/monad"} monad
            as a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/monad+in+computer+science"} monad in computer science
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Tarmo+Uustalu"}> Tarmo Uustalu
              , p.25 of:
              %em Monads and Interaction Lecture 1
              \&amp;lbrack;
              %a{:href => "https://cs.ioc.ee/~tarmo/mgs21/mgs1.pdf"}> pdf
              ,
