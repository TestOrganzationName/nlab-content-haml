          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/list"} list
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/string+%28computer+science%29"}> string (computer science)
                ,
                %a.existingWikiWord{:href => "/nlab/show/stream"} stream
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/classifying+topos+for+the+theory+of+objects"} classifying topos for the theory of objects
            %li
              %p
