                  %div
                    %p
                      %a{:href => "/nlab/edit/monoid+theory+-+contents"} Edit this sidebar
          %h1#finite_lists_and_free_monoids Finite lists and free monoids
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#definitions"} Definitions
              %ul
                %li
                  %a{:href => "#as_functions"} As functions
                %li
                  %a{:href => "#recursively"} Recursively
                %li
                  %a{:href => "#by_general_abstract_nonsense"} By general abstract nonsense
                %li
                  %a{:href => "#in_dependent_type_theory"} In dependent type theory
              %li
                %a{:href => "#examples"} Examples
              %li
                %a{:href => "#the_free_monoid_monad"} The free monoid monad
              %li
                %a{:href => "#foundational_relevance"} Foundational relevance
              %li
                %a{:href => "#stacks_and_queues"} Stacks and queues
              %li
                %a{:href => "#related_concepts"} Related concepts
              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %em free monoid
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is the set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mo *
                %annotation{:encoding => "application/x-tex"} S^*
            of all
            %em
              %a.existingWikiWord{:href => "/nlab/show/lists"} lists
            (finite
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/sequences"} sequences
            %a.existingWikiWord{:href => "/nlab/show/elements"} elements
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
            via
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/concatenation"} concatenation
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/free+functor"} free functor
            from
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            to
            %a.existingWikiWord{:href => "/nlab/show/Mon"} Mon
            takes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mo *
                  %annotation{:encoding => "application/x-tex"} S^*
            %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
            this is the
            %em
              %a.existingWikiWord{:href => "/nlab/show/list+monad"} list monad
            whose
            %a.existingWikiWord{:href => "/nlab/show/modules+over+a+monad"} modules
            are
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/monoids"} monoids
          %h2#definitions Definitions
          %p We will give three definitions, which can all be shown equivalent.
          %h3#as_functions As functions
          %p
            An element of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mo *
                %annotation{:encoding => "application/x-tex"} S^*
            consists of a
            %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            (possibly
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} n = 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [n]
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [n]
            is the
            %a.existingWikiWord{:href => "/nlab/show/subset"} subset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi i
                  %mo{:lspace => "verythinmathspace"} :
                  %mstyle{:mathvariant => "bold"}
                    %mi N
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} |
                  %mspace{:width => "thickmathspace"}
                  %mi i
                  %mo &lt;
                  %mi n
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{i\colon \mathbf{N} \;|\; i \lt n\}
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi N
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo ,
                    %mn 2
                    %mo ,
                    %mi …
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \mathbf{N} = \{0, 1, 2, \ldots\}
            %strong list
            or (to specify
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              \-tuple
            of elements of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            is called the
            %strong length
            of the list.
          %p
            The
            %strong
              %a.existingWikiWord{:href => "/nlab/show/empty+list"} empty list
            is the unique list of length
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ()
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} *
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                  %annotation{:encoding => "application/x-tex"} \epsilon
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            if desired.
          %p
            If
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} n \gt 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo ,
                  %mi …
                  %mo ,
                  %mi n
                  %mo −
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 0, \ldots, n - 1
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mn 0
                  %mo ,
                  %msub
                    %mi a
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi a
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} a_0, a_1, \ldots, a_{n-1}
            may be written
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mn 0
                    %mo ,
                    %msub
                      %mi a
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi a
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (a_0, a_1, \ldots, a_{n-1})
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ,
                  %mi b
                  %mo ,
                  %mi c
                %annotation{:encoding => "application/x-tex"} a,b,c
            are elements of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (a,b,c)
            is an element of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mo *
                  %annotation{:encoding => "application/x-tex"} S^*
          %p
            Given two lists
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                %annotation{:encoding => "application/x-tex"} m
            and the latter of length
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %strong
              %a.existingWikiWord{:href => "/nlab/show/concatenation"} concatenation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo *
                  %mi y
                %annotation{:encoding => "application/x-tex"} x * y
            is a list of length
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo +
                    %mi n
                  %annotation{:encoding => "application/x-tex"} m + n
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo ↦
                  %mrow
                    %mo {
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi x
                              %mi i
                          %mtd
                            %mi if
                            %mspace{:width => "thickmathspace"}
                            %mi i
                            %mo &lt;
                            %mi m
                        %mtr
                          %mtd
                            %msub
                              %mi y
                              %mrow
                                %mi i
                                %mo −
                                %mi m
                          %mtd
                            %mi if
                            %mspace{:width => "thickmathspace"}
                            %mi i
                            %mo ≥
                            %mi m
                %annotation{:encoding => "application/x-tex"}
                  i \mapsto \left\{ \array { x_i     &amp; if\; i \lt m \\
                  y_{i-m} &amp; if\; i \geq m } \right.
          %p
            One can now show that
            %a.existingWikiWord{:href => "/nlab/show/concatenation"} concatenation
            is
            %a.existingWikiWord{:href => "/nlab/show/associativity"} associative
            with the empty list as identity; hence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mo *
                %annotation{:encoding => "application/x-tex"} S^*
            is a monoid.
          %h3#recursively Recursively
          %p
            The (underlying) set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mo *
                %annotation{:encoding => "application/x-tex"} S^*
            may be defined as an
            %a.existingWikiWord{:href => "/nlab/show/inductive+type"} inductive type
            as follows. There are two basic constructors, one with no arguments, and one with two arguments, of which one is an element of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            and the other is an element of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mo *
                  %annotation{:encoding => "application/x-tex"} S^*
          %p
            So, a
            %strong list
            is either the
            %strong
              %a.existingWikiWord{:href => "/nlab/show/empty+list"} empty list
            or the
            %strong cons
            (short for ‘constructor’ and deriving from Lisp) of an element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            and a (previously constructed) list
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ()
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} *
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi nil
                  %annotation{:encoding => "application/x-tex"} nil
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            if desired; the cons of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            may be written
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo :
                    %mi x
                  %annotation{:encoding => "application/x-tex"} a : x
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo *
                    %mi x
                  %annotation{:encoding => "application/x-tex"} (a) * x
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi cons
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} cons(a,x)
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/recursion"} recursively
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mo *
                %annotation{:encoding => "application/x-tex"} S^*
            in the order in which they appear:
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ()
              ,
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi a
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} a : ()
              ,
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi a
                    %mo :
                    %mi b
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} a : b : ()
              ,
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi a
                    %mo :
                    %mi b
                    %mo :
                    %mi c
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} a : b : c : ()
              ,
            %li etc.
          %p
            Here,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ,
                  %mi b
                  %mo ,
                  %mi c
                  %mo ,
                  %mi …
                %annotation{:encoding => "application/x-tex"} a, b, c, \ldots
            are elements of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/corecursion"} corecursively
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/stream"} stream
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ()
              ,
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (a)
              ,
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (a,b)
              ,
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (a,b,c)
              ,
            %li etc.
          %p
            We still must define the monoidal structure on
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mo *
                  %annotation{:encoding => "application/x-tex"} S^*
            %strong concatenation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo *
                  %mi y
                %annotation{:encoding => "application/x-tex"} x * y
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                %annotation{:encoding => "application/x-tex"} y
            recursively in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} )
                    %mo *
                    %mi y
                    %mo =
                    %mi y
                  %annotation{:encoding => "application/x-tex"} () * y = y
              ;
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo :
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo *
                    %mi y
                    %mo =
                    %mi a
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo *
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (a : x) * y = a : (x * y)
              (with parentheses for grouping, but the parentheses can be dropped now that have this definition).
          %p
            One can now show that concatenation is associative with the empty list as identity; hence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mo *
                %annotation{:encoding => "application/x-tex"} S^*
            is a monoid.
          %h3#by_general_abstract_nonsense By general abstract nonsense
          %p
            To prove that the category
            %a.existingWikiWord{:href => "/nlab/show/Mon"} Mon
            of monoids is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/complete+category"} complete category
            %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            (from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Mon
                %annotation{:encoding => "application/x-tex"} Mon
            to the category
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            of sets) preserves all
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/limits"} limits
            %a.existingWikiWord{:href => "/nlab/show/adjoint+functor+theorem"} adjoint functor theorem
            defines a
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            if a size condition is met; this adjoint is the functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                %annotation{:encoding => "application/x-tex"} *
            that takes a set to its free monoid
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mo *
                  %annotation{:encoding => "application/x-tex"} S^*
          %p To be sure, meeting the solution set condition basically requires starting the constructions in one of the other definitions above; but the proofs may all be thrown onto the adjoint functor theorem.
          %p
            Another abstract approach is given in the following general theorem, which applies to more general
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/monoid+in+a+monoidal+category"} monoids in a monoidal category
          #monoid_in_monoidal.num_theorem
            %h6#theorem Theorem
            %p
              Suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is a monoidal category with countable coproducts for which the tensor product distributes over countable coproducts (for example, a
              %a.existingWikiWord{:href => "/nlab/show/cocomplete+category"} cocomplete
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/monoidal+biclosed+category"} monoidal biclosed category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Mon
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} Mon(C) \to C
              exists, taking an object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi n
                        %mo ≥
                        %mn 0
                    %msup
                      %mi c
                      %mrow
                        %mo ⊗
                        %mi n
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} \sum_{n \geq 0} c^{\otimes n},
            %p
              which thereby becomes the free monoid on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                    %annotation{:encoding => "application/x-tex"} c
          %p
            This applies immediately to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo =
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} C = Set
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+category"} cartesian closed category
          %h3#in_dependent_type_theory In dependent type theory
          %p
            In a general
            %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            where we do not assume
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/uniqueness+of+identity+proofs"} uniqueness of identity proofs
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is the
            %a.existingWikiWord{:href => "/nlab/show/0-truncation"} 0-truncation
            of the
            %a.existingWikiWord{:href => "/nlab/show/type+of+lists"} type of lists
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} FreeMonoid
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mo{:stretchy => "false"} [
                    %mi{:mathvariant => "normal"} List
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \mathrm{FreeMonoid}(A) \coloneqq [\mathrm{List}(A)]_0
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/uniqueness+of+identity+proofs"} uniqueness of identity proofs
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is the free monoid of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %p
            Alternatively, the free monoid on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            can be constructed via the
            %a.existingWikiWord{:href => "/nlab/show/James+construction+type"} James construction type
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %h2#examples Examples
          %ul
            %li
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
                is the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/empty+set"} empty set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mo *
                    %annotation{:encoding => "application/x-tex"} S^*
                consists only of the empty list; it is the trivial monoid, one manifestation of the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/point"} point
            %li
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
                is the point, then
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mo *
                    %annotation{:encoding => "application/x-tex"} S^*
                is
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi N
                      %annotation{:encoding => "application/x-tex"} \mathbf{N}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi N
                    %annotation{:encoding => "application/x-tex"} \mathbf{N}
                is addition.
            %li
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
                is
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi N
                      %annotation{:encoding => "application/x-tex"} \mathbf{N}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi N
                        %mo *
                    %annotation{:encoding => "application/x-tex"} \mathbf{N}^*
                is still a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/denumerable+set"} denumerable set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi N
                      %mo ≅
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi N
                        %mo *
                    %annotation{:encoding => "application/x-tex"} \mathbf{N} \cong \mathbf{N}^*
                only as sets (that is,
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %msup
                          %mstyle{:mathvariant => "bold"}
                            %mi N
                          %mo *
                        %mo{:stretchy => "false"} |
                      %mo =
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mstyle{:mathvariant => "bold"}
                          %mi N
                        %mo{:stretchy => "false"} |
                      %mo =
                      %msub
                        %mi ℵ
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} {|\mathbf{N}^*|} = {|\mathbf{N}|} = \aleph_0
                as
                = succeed ");" do
                  %a.existingWikiWord{:href => "/nlab/show/cardinal+numbers"} cardinal numbers
            %li
              %p
                Generalising the above,
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %msup
                          %mi S
                          %mo *
                        %mo{:stretchy => "false"} |
                      %mo =
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi S
                        %mo{:stretchy => "false"} |
                    %annotation{:encoding => "application/x-tex"} {|S^*|} = {|S|}
                if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
                is an
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/infinite+set"} infinite set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %msup
                          %mi S
                          %mo *
                        %mo{:stretchy => "false"} |
                      %mo =
                      %mi max
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi ℵ
                        %mn 0
                      %mo ,
                      %mi S
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} {|S^*|} = max(\aleph_0,S)
                if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
                is an
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/inhabited+set"} inhabited set
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/computer+science"} computer science
            %a.existingWikiWord{:href => "/nlab/show/alphabet"} alphabet
            is the
            %a.existingWikiWord{:href => "/nlab/show/categorical+semantics"} categorical semantics
            for the
            %a.existingWikiWord{:href => "/nlab/show/data+type"} data type
            “
            %a.existingWikiWord{:href => "/nlab/show/String+%28computer+science%29"}> String
            ” with characters in that alphabet.
          %h2#the_free_monoid_monad The free monoid monad
          %p
            If the free monoid functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:lspace => "verythinmathspace"} :
                  %mi Set
                  %mo →
                  %mi Mon
                %annotation{:encoding => "application/x-tex"} F\colon Set \to Mon
            is followed by the forgetful functor
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Mon
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} U\colon Mon \to Set
            %a.existingWikiWord{:href => "/nlab/show/monad"} monad
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/monad+in+computer+science"} monad in computer science
            = succeed "." do
              %strong
                %a.existingWikiWord{:href => "/nlab/show/list+monad"} list monad
          %p
            The list monad bears the same relation to
            %a.existingWikiWord{:href => "/nlab/show/multicategories"} multicategories
            as the
            %a.existingWikiWord{:href => "/nlab/show/identity+monad"} identity monad
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Set
                %annotation{:encoding => "application/x-tex"} Set
            bears to ordinary
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/categories"} categories
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/generalized+multicategory"} generalized multicategory
          %h2#foundational_relevance Foundational relevance
          %p
            Every definition of free monoid makes use of some form of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+infinity"} axiom of infinity
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi N
                %annotation{:encoding => "application/x-tex"} \mathbf{N}
            directly or the ability to form general inductive types. Indeed, as
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi N
                    %mo =
                    %msup
                      %mi pt
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \mathbf{N} = pt^*
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/topos+theory"} topos theory
            the equivalent of the above theorem
            %a.maruku-ref{:href => "#monoid_in_monoidal"}
            is due to C. J. Mikkelsen:
          #free_monoids_in_topos.num_prop
            %h6#proposition Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}
              be a topos and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi mon
                    %mo{:stretchy => "false"} (
                    %mi 𝒮
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{mon}(\mathcal{S})
              its category of internal monoids. Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}
              has a NNO precisely if the forgetful functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo :
                    %mstyle{:mathvariant => "bold"}
                      %mi mon
                    %mo{:stretchy => "false"} (
                    %mi 𝒮
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi 𝒮
                  %annotation{:encoding => "application/x-tex"} U:\mathbf{mon}(\mathcal{S})\to \mathcal{S}
              has a left adjoint.
          %p
            For a proof see Johnstone (
            %a{:href => "#JT77"}> 1977
            ,p.190).
          %p
            Furthermore then it is a theorem due to
            %a.existingWikiWord{:href => "/nlab/show/Andreas+Blass"} Andreas Blass
            (
            %a{:href => "#Blass"}> 1989
            ) that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒮
                %annotation{:encoding => "application/x-tex"} \mathcal{S}
            has a NNO precisely if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒮
                %annotation{:encoding => "application/x-tex"} \mathcal{S}
            has an
            %a.existingWikiWord{:href => "/nlab/show/classifying+topos+for+the+theory+of+objects"} object classifier
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                    %mo{:stretchy => "false"} [
                    %mi 𝕆
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}[\mathbb{O}]
          %p
            A consequence of this, discussed in sec. B4.2 of (Johnstone 2002,I p.431), is that
            %a.existingWikiWord{:href => "/nlab/show/classifying+topos"} classifying toposes
            for
            %a.existingWikiWord{:href => "/nlab/show/geometric+theories"} geometric theories
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒮
                %annotation{:encoding => "application/x-tex"} \mathcal{S}
            exist precisely if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒮
                %annotation{:encoding => "application/x-tex"} \mathcal{S}
            has a NNO.
          %p
            From a different perspective then, in a topos the existence of free objects over various gadgets like e.g.
            %a.existingWikiWord{:href => "/nlab/show/algebraic+theory"} algebraic theories
            or
            %a.existingWikiWord{:href => "/nlab/show/geometric+theory"} geometric theories
            often hinge on the existence of free monoids, the intuition being that the free monoids permit to construct a free model
            %em syntactically
            by providing for the (syntactic) building blocks needed for this process.
          %p
            Notice that algebraic theories can nevertheless have free algebras even if the ambient topos lacks a NNO. This may happen for algebraic theories that have the property that the free algebra on a finite set of generators has a finite carrier e.g. in the topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi FinSet
                %annotation{:encoding => "application/x-tex"} FinSet
            of finite sets
            %a.existingWikiWord{:href => "/nlab/show/graphic+category"} free graphic monoids
            exist, and
            %a.existingWikiWord{:href => "/nlab/show/free+Boolean+algebras"} free Boolean algebras
            exist.
          %h2#stacks_and_queues Stacks and queues
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/computer+science"} computer science
            %em stacks
            (not to be confused with the
            %a.existingWikiWord{:href => "/nlab/show/stacks"} stacks
            from higher sheaf theory) and
            = succeed "." do
              %em queues
          %p
            Fix a
            %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            that has
            %a.existingWikiWord{:href => "/nlab/show/coproducts"} coproducts
            with the
            %a.existingWikiWord{:href => "/nlab/show/unit+object"} unit object
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
            %a.existingWikiWord{:href => "/nlab/show/object"} object
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %strong stacks
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is an object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mi A
                %annotation{:encoding => "application/x-tex"} S_A
            equipped with
            %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi push
                    %mi A
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi S
                    %mi A
                  %mo ⊗
                  %mi A
                  %mo →
                  %msub
                    %mi S
                    %mi A
                %annotation{:encoding => "application/x-tex"} push_A\colon S_A \otimes A \to S_A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi pop
                    %mi A
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi S
                    %mi A
                  %mo →
                  %msub
                    %mi S
                    %mi A
                  %mo ⊗
                  %mi A
                  %mo +
                  %mi I
                %annotation{:encoding => "application/x-tex"} pop_A\colon S_A \to S_A \otimes A + I
            such that these diagrams commute:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mi S
                            %mi A
                          %mo ⊗
                          %mi A
                        %mtd
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mi ι
                                %mrow
                                  %msub
                                    %mi S
                                    %mi A
                                  %mo ⊗
                                  %mi A
                                  %mo ,
                                  %mi I
                        %mtd
                        %mtd
                          %msub
                            %mi S
                            %mi A
                          %mo ⊗
                          %mi A
                          %mo +
                          %mi I
                      %mtr
                        %mtd
                        %mtd
                          %msub
                            %mrow
                            %mrow
                              %msub
                                %mi push
                                %mi A
                          %mo ↘
                        %mtd
                        %mtd
                          %msub
                            %mo ↗
                            %mrow
                              %msub
                                %mi pop
                                %mi A
                        %mtd
                        %mtd
                          %msup
                            %mo ↘
                            %mrow
                              %msub
                                %mi push
                                %mi A
                              %mo +
                              %msub
                                %mi id
                                %mi I
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msub
                            %mi S
                            %mi A
                        %mtd
                        %mtd
                          %munder
                            %mo →
                            %mrow
                              %msub
                                %mi ι
                                %mrow
                                  %msub
                                    %mi S
                                    %mi A
                                  %mo ⊗
                                  %mi A
                                  %mo ,
                                  %mi I
                        %mtd
                        %mtd
                          %msub
                            %mi S
                            %mi A
                          %mo +
                          %mi I
                %annotation{:encoding => "application/x-tex"}
                  \\array {
                  S_A \otimes A &amp;                     &amp; \overset{\iota_{S_A \otimes A,I}}\to &amp;                  &amp; S_A \otimes A + I \\
                  \&amp; {}_{push_A}\searrow &amp;                                      &amp; \nearrow_{pop_A} &amp;                                       &amp; \searrow^{push_A + id_I} \\
                  \&amp;                     &amp; S_A                                  &amp;                  &amp; \underset{\iota_{S_A \otimes A,I}}\to &amp;                          &amp; S_A + I
                  }
          %p
            The idea is that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi push
                    %mi A
                %annotation{:encoding => "application/x-tex"} push_A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi pop
                    %mi A
                %annotation{:encoding => "application/x-tex"} pop_A
            are as close to
            %a.existingWikiWord{:href => "/nlab/show/inverse+morphism"} inverses
            as reasonably possible, but
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi pop
                    %mi A
                %annotation{:encoding => "application/x-tex"} pop_A
            takes us to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mi A
                  %mo ⊗
                  %mi A
                  %mo +
                  %mi I
                %annotation{:encoding => "application/x-tex"} S_A \otimes A + I
            rather than to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mi A
                    %mo ⊗
                    %mi A
                  %annotation{:encoding => "application/x-tex"} S_A \otimes A
          %p
            Queues are a little more complicated. An object of
            %strong queues
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is an object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Q
                    %mi A
                %annotation{:encoding => "application/x-tex"} Q_A
            equipped with morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ins
                    %mi A
                  %mo{:lspace => "verythinmathspace"} :
                  %mi A
                  %mo ⊗
                  %msub
                    %mi Q
                    %mi A
                  %mo →
                  %msub
                    %mi Q
                    %mi A
                %annotation{:encoding => "application/x-tex"} ins_A\colon A \otimes Q_A \to Q_A
            (‘insert’) and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi rem
                    %mi A
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi Q
                    %mi A
                  %mo →
                  %msub
                    %mi Q
                    %mi A
                  %mo ⊗
                  %mi A
                  %mo +
                  %mi I
                %annotation{:encoding => "application/x-tex"} rem_A\colon Q_A \to Q_A \otimes A + I
            (‘remove’). These operations are far from inverses; whereas popping a stack returns the last item to be pushed onto it, removing an item from a queue returns the
            %em first
            item to have been inserted into it.
          .query
            %p
              What are the diagrams for this? I seem to recall that we need a
              = succeed ";" do
                %a.existingWikiWord{:href => "/nlab/show/distributive+category"} distributive category
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cartesian+monoidal+category"} cartesian monoidal category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊗
                  %annotation{:encoding => "application/x-tex"} \otimes
              is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ×
                    %annotation{:encoding => "application/x-tex"} \times
              %a.existingWikiWord{:href => "/nlab/show/2-rig"} 2-rig
              will be sufficient?
