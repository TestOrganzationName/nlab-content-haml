          %h2#idea Idea
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/formal+dual"} formal dual
            of
            = succeed ":" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/unitality"} unitality
          %p
            An object in a
            %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            which is equipped with a
            %a.existingWikiWord{:href => "/nlab/show/comultiplication"} comultiplication
            map which satisfies both co-unitality and
            %a.existingWikiWord{:href => "/nlab/show/co-associativity"} co-associativity
            is called a
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/co-monoid"} co-monoid
          %h2#definition Definition
          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo ,
                  %mo ⊗
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathcal{C}, \otimes)
            and an
            %a.existingWikiWord{:href => "/nlab/show/object"} object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            equipped with a morphism (“
            %a.existingWikiWord{:href => "/nlab/show/co-multiplication"}> co-multiplication
            ”)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo{:lspace => "verythinmathspace"} :
