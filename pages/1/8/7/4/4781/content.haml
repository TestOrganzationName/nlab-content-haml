            %li#Gollinger16
              %p
                William Gollinger, Section 1.1.4 in:
                = succeed "," do
                  %em Madsen-Tillmann-Weiss Spectra and a Signature Problem for Manifolds
                = succeed "," do
                  %a{:href => "https://repositorium.uni-muenster.de/document/miami/7369e8b5-6ae4-4e42-b6f3-4602ec24427a/diss_gollinger.pdf"} pdf
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/files/GollingerMTWSpectra.pdf", :title => "pdf"} pdf
            %li#Berglund20
              %p
                Alexander Berglund,
