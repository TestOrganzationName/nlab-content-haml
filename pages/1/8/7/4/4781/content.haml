          %h3#horizontal_differential_forms Horizontal differential forms
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/differential+form"} differential form
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            is a
            %a.existingWikiWord{:href => "/nlab/show/horizontal+differential+form"} horizontal differential form
            with respect to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} P \to X
            it it
            %em vanishes
            on vertical vector fields.
          %h2#properties Properties
          %p
          #SplittingOfTotalSpaceTangentBundle.num_prop
            %h6 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mover
                      %mo ⟶
                      %mi π
                    %mi X
                  %annotation{:encoding => "application/x-tex"} P \overset{\pi}{\longrightarrow} X
              is a
              %a.existingWikiWord{:href => "/nlab/show/surjective+submersion"} surjective submersion
              (for instance a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/fiber+bundle"} fiber bundle
              %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
              of its total space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              is
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
              to the
              %a.existingWikiWord{:href => "/nlab/show/direct+sum+of+vector+bundles"} direct sum
              of the vertical tangent bundle (
              %a{:href => "#VerticalTangentBundle"}> above
              ) with the
              %a.existingWikiWord{:href => "/nlab/show/pullback+bundle"} pullback
              of the
              %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
              of the base space:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mi P
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi π
                      %mo *
                    %mi T
                    %mi B
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %msub
                      %mo ⊕
                      %mi P
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi T
                      %mi π
                    %mi P
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    T P
                    \\;\simeq\;
                    \\big(
                    \\pi^\ast T B
                    \\big)
                    \\oplus_P
                    \\big(
                    T_\pi P
                    \\big)
            %p
          %p
          .proof
            %h6 Proof
            %p
              The assumption that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                  %annotation{:encoding => "application/x-tex"} \pi
              is a
              %a.existingWikiWord{:href => "/nlab/show/surjective+submersion"} surjective submersion
              implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mi π
                    %mo{:lspace => "verythinmathspace"} :
                    %mi T
                    %mi P
                    %mo ⟶
                    %msup
                      %mi π
                      %mo *
                    %mi T
                    %mi B
                  %annotation{:encoding => "application/x-tex"} d \pi \colon T P \longrightarrow \pi^\ast T B
              is a
              %a.existingWikiWord{:href => "/nlab/show/surjection"} surjection
              and hence that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msub
                      %mi T
                      %mi π
                    %mi P
                    %mo ⟶
                    %mi T
                    %mi P
                    %mover
                      %mo ⟶
                      %mrow
                        %mi d
                        %mi π
                    %msup
                      %mi π
                      %mo *
                    %mi T
                    %mi B
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    0
                    \\to
                    T_\pi P
                    \\longrightarrow
                    T P
                    \\overset{d \pi}{\longrightarrow}
                    \\pi^\ast T B
                    \\to
                    0
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
              of smooth
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/real+vector+bundles"} real vector bundles
            %p
              Now all
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequences"} short exact sequences
              of
              %a.existingWikiWord{:href => "/nlab/show/real+vector+bundles"} real vector bundles
              over
              %a.existingWikiWord{:href => "/nlab/show/paracompact+topological+spaces"} paracompact topological spaces
              (such as
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
              %a.existingWikiWord{:href => "/nlab/show/split+exact+sequence"} split
              (by a choice of fiberwise metric, see at
              = succeed ")," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence+of+vector+bundles"} short exact sequence of vector bundles
          %h2#examples Examples
          %p
          #VerticalTangentBundleOfRealVectorBundle.num_prop
            %h6 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/vertical+tangent+bundle"} vertical tangent bundle
                of a
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/real+vector+bundle"} real vector bundle
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝒱
                    %mo ⟶
                    %mi M
                  %annotation{:encoding => "application/x-tex"} \pi \colon \mathcal{V} \longrightarrow M
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/real+vector+bundle"} real vector bundle
              %a.existingWikiWord{:href => "/nlab/show/vertical+tangent+bundle"} vertical tangent bundle
              is
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
              to the its
              %a.existingWikiWord{:href => "/nlab/show/pullback+bundle"} pullback
              along itself:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi π
                    %mi 𝒱
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mo ≃
                      %mrow
                        %msub
                          %mrow
                          %mi 𝒱
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi π
                      %mo *
                    %mi 𝒱
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    T_\pi \mathcal{V}
                    \\;\simeq_{{}_{\mathcal{V}}}\;
                    \\pi^\ast \mathcal{V}
                    \\,.
            %p
          %p
            (e.g.
            = succeed "," do
              %a{:href => "#tomDieck00"} tomDieck 00 (6.9)
            = succeed "," do
              %a{:href => "#tomDieck2008"} tomDieck 08 (15.6.7)
            = succeed ")" do
              %a{:href => "#Gollinger16"} Gollinger 16, inside the proof of Prop. 1.1.9
          %p
          #StableTangentBundleOfUnitSphereBundle.num_prop
            %h6 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/stable+tangent+bundle"} stable tangent bundle
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/unit+sphere+bundle"} unit sphere bundle
              %br/
              The once-
              %a.existingWikiWord{:href => "/nlab/show/stable+tangent+bundle"} stabilized
              %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
              of a
              %a.existingWikiWord{:href => "/nlab/show/unit+sphere+bundle"} unit sphere bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi 𝒱
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S(\mathcal{V})
              in a
              %a.existingWikiWord{:href => "/nlab/show/real+vector+bundle"} real vector bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒱
                    %mover
                      %mo ⟶
                      %mi p
                    %mi M
                  %annotation{:encoding => "application/x-tex"} \mathcal{V} \overset{p}{\longrightarrow} M
              (Example
              = succeed ")" do
                %a.maruku-ref{:href => "#UnitSphereBundles"}
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              is
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
              to the
              %a.existingWikiWord{:href => "/nlab/show/pullback+bundle"} pullback
              of the
              %a.existingWikiWord{:href => "/nlab/show/direct+sum+of+vector+bundles"} direct sum
              of the
              %a.existingWikiWord{:href => "/nlab/show/stable+tangent+bundle"} stable tangent bundle
              of the base manifold with that vector bundle:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi 𝒱
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi ℝ
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mo ≃
                      %mrow
                        %msub
                          %mrow
                          %mi M
                    %mspace{:width => "thickmathspace"}
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi p
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi T
                    %mi M
                    %msub
                      %mo ⊕
                      %mi M
                    %mi 𝒱
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    T S(\mathcal{V}) \times \mathbb{R}
                    \\;
                    \\simeq_{{}_M}
                    \\;
                    S(p)^\ast
                    \\big(
                    T M
                    \\oplus_M
                    \\mathcal{V}
                    \\big)
                    \\,.
            %p
          %p
            This is stated without proof as
            = succeed "," do
              %a{:href => "#CrowleyEscher03"} Crowley-Escher 03, Fact. 3.1
            = succeed "." do
              %a{:href => "#Milnor1956"} Milnor 56, p. 403
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mrow
                      %mi S
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} )
                  %mi S
                  %mo{:stretchy => "false"} (
                  %mi 𝒱
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi ℝ
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mo ≃
                    %mrow
                      %msub
                        %mrow
                        %mi M
                  %mspace{:width => "thickmathspace"}
                  %mi 𝒱
                %annotation{:encoding => "application/x-tex"}
                  T_{S(p)} S(\mathcal{V}) \times \mathbb{R}
                  \\;\simeq_{{}_M}\;
                  \\mathcal{V}
          %p
            is made explicit in
            %a{:href => "#Gollinger16"} Gollinger 16, Prop. 1.1.9
          %p
          #ProofOfStableTangentBundleOfUnitSphereBundle.proof
            %h6 Proof
            %p
              Consider first the actual
              %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
              but to the
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/open+ball"} open ball
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/disk"} disk
              %a.existingWikiWord{:href => "/nlab/show/fiber+bundle"} fiber bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi 𝒱
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D(\mathcal{V})
              that fills the given sphere-fiber bundle: By the standard splitting (
              %a{:href => "vertical+vector+field#SplittingOfTotalSpaceTangentBundle"}> this Prop.
              ) this is the
              %a.existingWikiWord{:href => "/nlab/show/direct+sum+of+vector+bundles"} direct sum
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi 𝒱
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi p
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mi T
                    %mi M
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %msub
                      %mo ⊕
                      %mi M
                    %msub
                      %mi T
                      %mi p
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi 𝒱
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    T
                    \\big(
                    D(\mathcal{V})
                    \\big)
                    \\;\simeq\;
                    \\big(
                    D(p)^\ast T M
                    \\big)
                    \\oplus_M
                    T_p D(\mathcal{V})
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi p
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi 𝒱
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} T_p D(\mathcal{V})
              is the
              %a.existingWikiWord{:href => "/nlab/show/vertical+tangent+bundle"} vertical tangent bundle
              of the disk bundle. But, by definition of disk bundles, that is the restriction of the vertical tangent bundle of the vector bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒱
                  %annotation{:encoding => "application/x-tex"} \mathcal{V}
              itself, and that is just the pullback of that vector bundle along itself (by
              = succeed "):" do
                %a{:href => "vertical+vector+field#SplittingOfTotalSpaceTangentBundle"} this Example
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi ⋯
                          %mtd
                            %mo ≃
                            %mspace{:width => "thickmathspace"}
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mi D
                            %mo{:stretchy => "false"} (
                            %mi p
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo *
                            %mi T
                            %mi M
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %msub
                              %mo ⊕
                              %mi M
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mi D
                            %mo{:stretchy => "false"} (
                            %mi p
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo *
                            %mi 𝒱
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mspace{:width => "thickmathspace"}
                            %mi D
                            %mo{:stretchy => "false"} (
                            %mi p
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo *
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mi T
                            %mi M
                            %msub
                              %mo ⊕
                              %mi M
                            %mi 𝒱
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %mspace{:width => "thinmathspace"}
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\cdots
                    \&amp;
                    \\simeq\;
                    \\big(
                    D(p)^\ast T M
                    \\big)
                    \\oplus_M
                    \\big(
                    D(p)^\ast \mathcal{V}
                    \\big)
                    \\\
                    \&amp; \simeq\;
                    D(p)^\ast
                    \\big(
                    T M \oplus_M \mathcal{V}
                    \\big)
                    \\,.
                    \\end{aligned}
            %p
              To conclude, it just remains to observe that the
              %a.existingWikiWord{:href => "/nlab/show/normal+bundle"} normal bundle
              of the
              = succeed "-boundary" do
                %a.existingWikiWord{:href => "/nlab/show/n-sphere"} n-sphere
              = succeed "-ball" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n+1)
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/trivial+bundle"} trivial
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi 𝒱
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D(\mathcal{V})
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi 𝒱
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S(\mathcal{V})
              is the
              %a.existingWikiWord{:href => "/nlab/show/stable+tangent+bundle"} stable tangent bundle
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo{:stretchy => "false"} (
                      %mi 𝒱
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} S(\mathcal{V})
