                = succeed "," do
                  %em Topologie
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1515/9783110802542"} doi:10.1515/9783110802542
            %li#tomDieck2008
              %p
                %a.existingWikiWord{:href => "/nlab/show/Tammo+tom+Dieck"}> Tammo tom Dieck
