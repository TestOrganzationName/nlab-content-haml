              There is a canonical
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-geometric+morphism"} (∞,1)-geometric morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mover
                      %mover
                        %munder
                          %mo ⟶
                          %mrow
                            %msub
                              %mi X
                              %mo *
                        %mover
                          %mo ⟵
                          %mrow
                            %msup
                              %mi X
                              %mo *
                      %mover
                        %mo ⟶
                        %mrow
                          %msub
                            %mi X
                            %mo !
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{H}/X
                    \\stackrel{\overset{X_!}{\longrightarrow}}{\stackrel{\overset{X^*}{\longleftarrow}}{\underset{X_*}{\longrightarrow}}}
                    \\mathbf{H}
            %p
              where the extra
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo !
                  %annotation{:encoding => "application/x-tex"} X_!
              is the obvious projection
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mo !
                      %mo :
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo →
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo ↦
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X_! : (Y \to X) \mapsto X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo *
                  %annotation{:encoding => "application/x-tex"} X_*
              is given by forming the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-limit"} (∞,1)-product
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          %p
            This is called an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/etale+geometric+morphism"} etale geometric morphism
          .proof
            %h6#proof Proof
            %p
              The fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mo !
                    %mo ⊣
                    %msup
                      %mi X
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X_! \dashv X^*)
              follows from the universal property of the products. The fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mo *
                  %annotation{:encoding => "application/x-tex"} X^*
              preserves
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimit"} (∞,1)-colimit
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo *
                  %annotation{:encoding => "application/x-tex"} X_*
              by the
              %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functor+theorem"} adjoint (∞,1)-functor theorem
              follows from that fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              has
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/universal+colimits"} universal colimits
          .num_cor
            %h6#corollary Corollary
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              is a
              %a.existingWikiWord{:href => "/nlab/show/locally+%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} locally ∞-connected (∞,1)-topos
              then for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
              also the over-
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
              \-topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} /
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}/X
              is locally
              = succeed "-connected." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
          .proof
            %h6#proof_2 Proof
            %p
              The composite of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-geometric+morphism"} (∞,1)-geometric morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mover
                      %mover
                        %munder
                          %mo ⟶
                          %mrow
                            %msub
                              %mi X
                              %mo *
                        %mover
                          %mo ⟵
                          %mrow
                            %msup
                              %mi X
                              %mo *
                      %mover
                        %mo ⟶
                        %mrow
                          %msub
                            %mi X
                            %mo !
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mover
                      %mover
                        %munder
                          %mo ⟶
                          %mrow
                            %msub
                              %mi Γ
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                        %mover
                          %mo ⟵
                          %mrow
                            %msub
                              %mi LConst
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                      %mover
                        %mo ⟶
                        %mrow
                          %msub
                            %mi Π
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{H}/X
                    \\stackrel{\overset{X_!}{\longrightarrow}}{\stackrel{\overset{X^*}{\longleftarrow}}{\underset{X_*}{\longrightarrow}}}
                    \\mathbf{H}
                    \\stackrel{\overset{\Pi_{\mathbf{H}}}{\longrightarrow}}{\stackrel{\overset{LConst_{\mathbf{H}}}{\longleftarrow}}{\underset{\Gamma_{\mathbf{H}}}{\longrightarrow}}}
                    \\infty Grpd
            %p
              is itself a geometric morphism. Since
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
              is the
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              in
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29Topos"} (∞,1)Topos
              this must be the
              %a.existingWikiWord{:href => "/nlab/show/global+section"} global section
              geometric morphism for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mo{:stretchy => "false"} /
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}/X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo ∘
                    %msub
                      %mi X
                      %mo !
                  %annotation{:encoding => "application/x-tex"} \Pi \circ X_!
              it is locally
              = succeed "-connected." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
          .num_prop
            %h6#proposition_3 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mi Topos
                    %mo{:stretchy => "false"} /
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi et
                    %mo ⊂
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mi Topos
                    %mo{:stretchy => "false"} /
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} ((\infty,1)Topos/\mathbf{H})_{et} \subset (\infty,1)Topos/\mathbf{H}
              be the full
              %a.existingWikiWord{:href => "/nlab/show/sub-%28%E2%88%9E%2C1%29-category"} sub-(∞,1)-category
              on the
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/etale+geometric+morphism"} etale geometric morphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mo{:stretchy => "false"} /
                      %mi X
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}/X \to \mathbf{H}
              %a.existingWikiWord{:href => "/nlab/show/equivalence+in+an+%28%E2%88%9E%2C1%29-category"} equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mi Topos
                    %mo{:stretchy => "false"} /
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi et
                    %mo ≃
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"}
                    ((\infty,1)Topos/\mathbf{H})_{et}
                    \\simeq
                    \\mathbf{H}
          %p
            See
            %a.existingWikiWord{:href => "/nlab/show/etale+geometric+morphism"} etale geometric morphism
            for more details.
          %h3#general_base_change General base change
          %p
            See
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/base+change+geometric+morphism"} base change geometric morphism
          %h3#SheavesOnBigSite
            As
            = succeed "-sheaves" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "-site" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %p
            We spell out how
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} /
                  %mi X
                %annotation{:encoding => "application/x-tex"} \mathbf{H}/X
            is the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-sheaves"} (∞,1)-category of (∞,1)-sheaves
            over the
            %a.existingWikiWord{:href => "/nlab/show/big+site"} big site
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            The following may be seen as the presheaf version of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/fundamental+theorem+of+%28infinity%2C1%29-topos+theory"}
                fundamental theorem of
                = succeed "-topos" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
          #SlicingCommutesWithPassingToPresheaves.num_prop
            %h6#proposition_4 Proposition
            %p
              %strong (forming overcategories commutes with passing to presheaves)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              be a
              %a.existingWikiWord{:href => "/nlab/show/small+%28%E2%88%9E%2C1%29-category"} small (∞,1)-category
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:lspace => "verythinmathspace"} :
                    %mi K
                    %mo ⟶
                    %mi C
                  %annotation{:encoding => "application/x-tex"} X \colon K \longrightarrow C
              a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi X
                  %annotation{:encoding => "application/x-tex"} C_{/X}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi X
                  %annotation{:encoding => "application/x-tex"} PSh(C)_{/X}
              for the corresponding
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/over+%28%E2%88%9E%2C1%29-categories"} over (∞,1)-categories
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Yoneda+embedding"} (∞,1)-Yoneda embedding
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo ↪
                      %mi PSh
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C \hookrightarrow PSh(C)
            %p
              Then we have an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalence of (∞,1)-categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PSh
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi C
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi X
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    PSh\big(
                    C_{/X}
                    \\big)
                    \\stackrel{\simeq}{\longrightarrow}
                    PSh(C)_{/X}
                    \\,.
          %p
            This appears as
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, 5.1.6.12
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-presheaves"} (∞,1)-category of (∞,1)-presheaves
          .num_remark
            %h6#remark Remark
            %p
              Here we may think of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} /
                    %mi X
                  %annotation{:encoding => "application/x-tex"} C/X
              as the
              %a.existingWikiWord{:href => "/nlab/show/big+site"} big site
              of the object
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo ∈
                      %mi PSh
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} c \in PSh(C)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PSh(C/X)
              as presheaves on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          #CommaSiteForSliceTopos.num_prop
            %h6#proposition_5 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              be equipped with a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/subcanonical+coverage"} subcanonical coverage
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} X \in C
              and regard
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} /
                    %mi X
                  %annotation{:encoding => "application/x-tex"} C/X
              as an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-site"} (∞,1)-site
              with the
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/big+site"} big site
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Sh(C/X) \simeq Sh(C)/X
                    \\,.
          .proof
            %h6#proof_3 Proof
            %p
              By the discussion of
              %a{:href => "http://ncatlab.org/nlab/show/adjoint+(infinity%2C1)-functor#OnSlices"} adjoint (∞,1)-functors on over-(∞,1)-categories
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functor"} adjoint (∞,1)-functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo ⊣
                    %mi i
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ↪
                      %mover
                        %mo ←
                        %mi F
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (F \dashv i) : Sh(C) \stackrel{\overset{F}{\leftarrow}}{\hookrightarrow}
                    PSh(C)
            %p
              passes to an adjunction on the
              %a.existingWikiWord{:href => "/nlab/show/over-%28%E2%88%9E%2C1%29-categories"} over-(∞,1)-categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mo ⊣
                    %mi i
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mover
                      %mo ↪
                      %mover
                        %mo ←
                        %mi F
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    (F/X \dashv i/X) : Sh(C)/X \stackrel{\overset{F}{\leftarrow}}{\hookrightarrow}
                    PSh(C)/X
                    \\,,
            %p
              (where we are using that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mi i
                    %mi X
                    %mo ≃
                    %mi X
                  %annotation{:encoding => "application/x-tex"} F  i X \simeq X
              by the assumption that the coverage is subcanonical, so that the representable
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-sheaf"} (∞,1)-sheaf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo{:stretchy => "false"} /
                    %mi X
                  %annotation{:encoding => "application/x-tex"} i/X
              is still a
              %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+%28%E2%88%9E%2C1%29-functor"} full and faithful (∞,1)-functor
              (where we are using that the unit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi F
                    %mi i
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X \to F i X
              is an equivalence, since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a sheaf).
            %p
              Since moreover the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-limits"} (∞,1)-limits
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Sh(C)/X
              are computed as limits in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh(C)
              over diagrams with a bottom element adjoined (as discussed at
              = succeed ")" do
                %a{:href => "http://ncatlab.org/nlab/show/limit+in+a+quasi-category#InOvercategories"} limits in over-(∞,1)-categories
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              preserving all finite limits, so does
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} /
                      %mi X
                    %annotation{:encoding => "application/x-tex"} F/X
            %p
              In summary we have that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mo ⊣
                    %mi i
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (F/X \dashv i/X)
              is a
              %a.existingWikiWord{:href => "/nlab/show/reflective+sub-%28%E2%88%9E%2C1%29-category"} reflective sub-(∞,1)-category
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PSh(C/X)
              hence is the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-sheaves"} (∞,1)-category of (∞,1)-sheaves
              on the category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} /
                    %mi X
                  %annotation{:encoding => "application/x-tex"} C/X
              for
              %em some
              = succeed "-structure." do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-site"} (∞,1)-site
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} /
                    %mi X
                  %annotation{:encoding => "application/x-tex"} F/X
              inverts precisely those morphisms that are inverted by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              under the projection
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi PSh
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mi X
                      %mo →
                      %mi PSh
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} PSh(C)/X \to PSh(C)
              %a.existingWikiWord{:href => "/nlab/show/big+site"} big site
              structure on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} /
                    %mi X
                  %annotation{:encoding => "application/x-tex"} C/X
              (this is the defining property of the big site).
          %p
            Specifically for the
            = succeed "-topos" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo =
                %annotation{:encoding => "application/x-tex"} \mathbf{H} =
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            we also have the following characterization.
          .num_prop
            %h6#proposition_6 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo =
                  %annotation{:encoding => "application/x-tex"} \mathbf{H} =
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
              we have that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mn ∞
                    %mi Grp
                  %annotation{:encoding => "application/x-tex"} X \in \infty Grp
              any
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
              the corresponding over-
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
              \-topos is equivalent to the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-presheaves"} (∞,1)-category of (∞,1)-presheaves
              on
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                    %mi Grpd
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mo ≃
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mn ∞
                    %mi Grpd
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\infty Grpd/X \simeq PSh(X) \simeq [X, \infty Grpd]
                    \\,.
          .proof
            %h6#proof_4 Proof
            %p
              This is a special case of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Grothendieck+construction"} (∞,1)-Grothendieck construction
              = succeed "." do
                %a{:href => "http://ncatlab.org/nlab/show/(infinity,1)-Grothendieck+construction#GrpdFibsOverGrpds"} (∞,0)-fibrations over ∞-groupoids
          %p
            The following proposition asserts that the over-
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\infty,1)
            \-topos over an
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/truncated"} truncated
            object indeed behaves like a generalized
            %a.existingWikiWord{:href => "/nlab/show/n-groupoid"} n-groupoid
          %p
          #SliceOfNLocalicToposOverNTruncatedObject.num_prop
            %h6 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒳
                  %annotation{:encoding => "application/x-tex"} \mathcal{X}
              an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/n-localic+%28%E2%88%9E%2C1%29-topos"} n-localic (∞,1)-topos
              = succeed "-topos" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒳
                    %mo{:stretchy => "false"} /
                    %mi U
                  %annotation{:encoding => "application/x-tex"} \mathcal{X}/U
              is
              = succeed "-localic" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              is
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/truncated"} truncated
          %p
            This is (
            %a{:href => "#StrSp"}> StrSp, lemma 2.3.16
            ).
          %h3#ObjectClassifier Object classifier
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Obj
                    %mi κ
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} Obj_\kappa \in \mathbf{H}
            is an
            %a.existingWikiWord{:href => "/nlab/show/object+classifier"} object classifier
            for
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                  %annotation{:encoding => "application/x-tex"} \kappa
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/small+objects"} small objects
            %a.existingWikiWord{:href => "/nlab/show/projection"} projection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Obj
                    %mi Κ
                  %mo ×
                  %mi X
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} Obj_\Kappa \times X \to X
            regarded as an object in the slice is a
            = succeed "-small" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                  %annotation{:encoding => "application/x-tex"} \kappa
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi X
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}_{/X}
          %h3#InHomotopyTypeTheory In homotopy type theory
          %p
            If a
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
            is the
            %a.existingWikiWord{:href => "/nlab/show/internal+language"} internal language
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
            %a.existingWikiWord{:href => "/nlab/show/context"} context
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi X
                  %mo ⊢
                  %mi ⋯
                %annotation{:encoding => "application/x-tex"} x : X \vdash \cdots
            is the internal language of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi X
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}_{/X}
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/fundamental+theorem+of+topos+theory"} fundamental theorem of topos theory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/arrow+category"} arrow category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/over-category"} over-category
              %ul
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/slice+category"} slice category
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/under+category"} under category
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/over+topos"} over topos
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/over+%28%E2%88%9E%2C1%29-category"}> over (∞,1)-category
                ,
              %ul
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/model+structure+on+an+over+category"} model structure on an over category
                %li
                  %p
                    %strong over-(∞,1)-topos
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/arrow+%28%E2%88%9E%2C1%29-category"}> arrow (∞,1)-category
                ,
                %a.existingWikiWord{:href => "/nlab/show/arrow+%28%E2%88%9E%2C1%29-topos"} arrow (∞,1)-topos
          %h2#references References
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              , Section 6.3.5 of:
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} Higher Topos Theory
              = succeed "," do
                %a{:href => "https://press.princeton.edu/titles/8957.html"} pup:8957
              = succeed ")" do
                %a{:href => "https://www.math.ias.edu/~lurie/papers/HTT.pdf"} pdf
          %p Some related remarks are in:
          %ul
            %li#StrSp
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              ,
              %em
                %a.existingWikiWord{:href => "/nlab/show/Structured+Spaces"} Structured Spaces
        .revisedby
