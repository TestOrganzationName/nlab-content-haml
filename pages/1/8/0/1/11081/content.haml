                            %mo −
                            %mrow
                              %mo (
                              %mfrac
                                %mo ∂
                                %mrow
                                  %mo ∂
                                  %mover
                                    %mi γ
                                    %mo ˙
                              %mi L
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi γ
                                %mi u
                              %mo{:stretchy => "false"} (
                              %mn 0
                              %mo{:stretchy => "false"} )
                              %mo ,
                              %msub
                                %mover
                                  %mi γ
                                  %mo ˙
                                %mi u
                              %mo{:stretchy => "false"} (
                              %mn 0
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                              %mfrac
                                %mrow
                                  %mo ∂
                                  %msub
                                    %mi γ
                                    %mi u
                                  %mo{:stretchy => "false"} (
                                  %mn 0
                                  %mo{:stretchy => "false"} )
                                %mrow
                                  %mo ∂
                                  %mi u
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\int_{0}^1 \frac{\partial}{\partial t}
                    \\left(
                    \\frac{\partial}{\partial \dot\gamma} L(\gamma_u(s), \dot \gamma_u(s))
                    \\frac{\partial \gamma_u(s)}{\partial u}
                    \\right)
                    d s
                    \&amp; =
                    \\left(
                    \\frac{\partial}{\partial \dot\gamma} L(\gamma_u(1), \dot \gamma_u(1))
                    \\frac{\partial \gamma_u(1)}{\partial u}
                    \\right)
                    \-
                    \\left(
                    \\frac{\partial}{\partial \dot\gamma} L(\gamma_u(0), \dot \gamma_u(0))
                    \\frac{\partial \gamma_u(0)}{\partial u}
                    \\right)
                    \\\
                    \&amp; = 0
                    \\end{aligned}
            %p
              since by prop.
              %a.maruku-ref{:href => "#PlotsOfMappingSpaceWithNonVaryingBoundary"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi γ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \gamma_{(-)}(1)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi γ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \gamma_{(-)}(0)
              are constant.
