          #DifferentialCohesiveStructureOfSmoothSpaces.num_prop
            %h6#proposition_6 Proposition
            %p
              All three functors in def.
              %a.maruku-ref{:href => "#TheMorphismsOfSitesForCartSpInfinitesimalNeighbourhood"}
              are
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/morphisms+of+sites"} morphisms of sites
              %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
              of
              %a.existingWikiWord{:href => "/nlab/show/sheaf+toposes"} sheaf toposes
              is of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi CartSp
                    %mo{:stretchy => "false"} )
                    %mover
                      %mover
                        %mover
                          %mover
                            %munder
                              %mo ←
                              %mrow
                                %msub
                                  %mi Ran
                                  %mi p
                            %mover
                              %mo ↪
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo{:stretchy => "false"} )
                                %mo ∘
                                %mi p
                          %mover
                            %mo ←
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo{:stretchy => "false"} )
                              %mo ∘
                              %mi i
                        %mover
                          %mo ↪
                          %mrow
                            %msub
                              %mi Lan
                              %mi i
                      %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi CartSp
                      %mi th
                    %mo{:stretchy => "false"} )
                    %mover
                      %munder
                        %mo →
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                          %mo ∘
                          %mi ι
                      %mover
                        %mo ←
                        %mrow
                          %msub
                            %mi Lan
                            %mi ι
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi InfPoint
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Sh(CartSp)
                    \\stackrel{}{\stackrel{\overset{Lan_i}{\hookrightarrow}}{\stackrel{\overset{(-)\circ i}{\leftarrow}}{\stackrel{\overset{(-)\circ p}{\hookrightarrow}}{\underset{Ran_p}{\leftarrow}}}}}
                    Sh(CartSp_{th})
                    \\stackrel{\overset{Lan_\iota}{\leftarrow}}{\underset{(-)\circ \iota}{\to}}
                    Sh(InfPoint)
            %p
              where hence the morphism on the left is in particular an
              %a.existingWikiWord{:href => "/nlab/show/essential+geometric+morphism"} essential
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/geometric+embedding"} geometric embedding
          .num_prop
            %h6#proposition_7 Proposition
            %p
              The sequence of
              %a.existingWikiWord{:href => "/nlab/show/geometric+morphisms"} geometric morphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi CartSp
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %msup
                          %mi p
                          %mo *
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi CartSp
                      %mi th
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %msup
                          %mi ι
                          %mo *
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi InfPoint
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Sh(CartSp) \stackrel{p^*}{\to} Sh(CartSp_{th}) \stackrel{\iota^*}{\to} Sh(InfPoint)
            %p
              exhibit a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+cofiber+sequence"} homotopy cofiber sequence
              in the
              %a.existingWikiWord{:href => "/nlab/show/%282%2C1%29-category"} (2,1)-category
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Topos"} Topos
          .proof
            %h6#proof_2 Proof
            %p
              By the discussion at
              %em
                %a{:href => "%28infinity%2C1%29Topos#ExistenceOfLimitsAndColimits"} (∞,1)Topos – Existence of limits and colimits
              the statement is equivalently that the
              %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
              functors
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi CartSp
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ←
                      %mrow
                        %msub
                          %mi Lan
                          %mi p
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi CartSp
                      %mi th
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ←
                      %mrow
                        %msub
                          %mi Lan
                          %mi ι
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi InfPoint
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Sh(CartSp)
                    \\stackrel{Lan_p}{\leftarrow}
                    Sh(CartSp_{th})
                    \\stackrel{Lan_\iota}{\leftarrow}
                    Sh(InfPoint)
            %p
              form a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequence"} homotopy fiber sequence
              in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29Cat"} (∞,1)Cat
              %a.existingWikiWord{:href => "/nlab/show/model+structure+for+quasi-categories"} model structure for quasi-categories
              after passing to
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/nerves"} nerves
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Lan
                      %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} N(Lan_p)
              is clearly an
              %a.existingWikiWord{:href => "/nlab/show/inner+Kan+fibration"} inner Kan fibration
              because of the
              %a.existingWikiWord{:href => "/nlab/show/subcategory"} subcategory
              inclusion
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %mi CartSp
                      %mo{:stretchy => "false"} )
                      %mo ↪
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi CartSp
                        %mi th
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Sh(CartSp) \hookrightarrow Sh(CartSp_{th})
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
              the homotopy fiber is given by the 1-categorical fiber of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Lan
                      %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} N(Lan_p)
              in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              %em
                %a{:href => "http://ncatlab.org/nlab/show/Kan+extension#LeftKanOnRepresentables"} Left Kan extension - on representables
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Lan
                      %mi p
                  %annotation{:encoding => "application/x-tex"} Lan_p
              acts as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              on
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representables
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi N
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi CartSp
                      %mi th
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi CartSp
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} N(p) \colon N(CartSp_{th}) \to N(CartSp)
              is evidently
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi InfPoint
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} N(InfPoint)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Lan
                      %mi ι
                  %annotation{:encoding => "application/x-tex"} Lan_\iota
              is a
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              it preserves colimits and since ever sheaf is a colimit of representables, this is sufficient to imply the claim.
          %h4#DifferentialCohesion Differential cohesion
          %p
            We axiomatize the existence of infinitesimals by further
            %a.existingWikiWord{:href => "/nlab/show/modal+logic"} modalities
            on a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cohesive+topos"} cohesive topos
          #DifferentialCohesiveTopos.num_defn
            %h6#definition_19 Definition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/cohesive+topos"} cohesive topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo =
                    %mi Cohesive
                    %mn 0
                    %mi Type
                  %annotation{:encoding => "application/x-tex"} \mathbf{H} = Cohesive0Type
              over a
              %a.existingWikiWord{:href => "/nlab/show/base+topos"} base topos
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Disc%E2%88%9EGrpd"} Discrete0Type
              %strong
                %a.existingWikiWord{:href => "/nlab/show/differential+cohesion"} differential cohesion
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              is an
              %a.existingWikiWord{:href => "/nlab/show/geometric+embedding"} geometric embedding
              into a
              %a.existingWikiWord{:href => "/nlab/show/cohesive+topos"} cohesive topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi th
                    %mo =
                    %mi InfThickenedCohesive
                    %mn 0
                    %mi Type
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}_{th} = InfThickenedCohesive0Type
              with an extra
              %span.newWikiWord
                left eadjoint
                %a{:href => "/nlab/new/left+eadjoint"} ?
              that preserves the terminal object:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Cohesive
                            %mn 0
                            %mi Type
                          %mtd
                          %mtd
                            %mover
                              %mover
                                %munder
                                  %mo ↪
                                  %mrow
                                    %msub
                                      %mi i
                                      %mo *
                                %mover
                                  %mo ←
                                  %mrow
                                    %msup
                                      %mi i
                                      %mo *
                              %mover
                                %mo ↪
                                %mrow
                                  %msub
                                    %mi i
                                    %mo !
                          %mtd
                          %mtd
                            %mi InfThickenedCohesive
                            %mn 0
                            %mi Type
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi Γ
                            %mo ↘
                            %msup
                              %mo ↖
                              %mpadded{:width => "0"}
                                %mi Disc
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi Γ
                                    %mi th
                            %mo ↙
                            %msub
                              %mo ↗
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi Disc
                                    %mi th
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi Discrete
                            %mn 0
                            %mi Type
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Cohesive0Type
                    \&amp;&amp;\stackrel{\overset{i_!}{\hookrightarrow}}{\stackrel{\overset{i^*}{\leftarrow}}{\underset{i_*}{\hookrightarrow}}}&amp;&amp;
                    InfThickenedCohesive0Type
                    \\\
                    \&amp; {}_{\mathllap{\Gamma}}\searrow \nwarrow^{\mathrlap{Disc}} &amp;&amp; {}^{\mathllap{\Gamma_{th}}}\swarrow \nearrow_{\mathrlap{Disc_{th}}}
                    \\\
                    \&amp;&amp; Discrete0Type
                    }
          .num_defn
            %h6#definition_20 Definition
            %p
              Given
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/differential+cohesion"} differential cohesion
              = succeed "," do
                %a.maruku-ref{:href => "#DifferentialCohesiveTopos"}
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/monad"} monad
              %a.existingWikiWord{:href => "/nlab/show/comonad"} comonad
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Red
                    %mo ⊣
                    %msub
                      %mi Π
                      %mi inf
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi th
                    %mover
                      %munder
                        %mo →
                        %mrow
                          %msup
                            %mi i
                            %mo *
                      %mover
                        %mo ←
                        %mrow
                          %msub
                            %mi i
                            %mo *
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mover
                      %munder
                        %mo →
                        %mrow
                          %msub
                            %mi i
                            %mo *
                      %mover
                        %mo ←
                        %mrow
                          %msub
                            %mi i
                            %mo !
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (Red \dashv \Pi_{inf})
                    \\colon
                    \\mathbf{H}_{th}
                    \\stackrel{\overset{i_*}{\leftarrow}}{\underset{i^*}{\to}}
                    \\mathbf{H}
                    \\stackrel{\overset{i_!}{\leftarrow}}{\underset{i_*}{\to}}
                    \\mathbf{H}
                    \\,.
            %p
              We call
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Red
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Red(X)
              the
              %strong
                %a.existingWikiWord{:href => "/nlab/show/reduced+type"} reduced type
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
