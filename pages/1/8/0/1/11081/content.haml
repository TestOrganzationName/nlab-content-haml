          %h5#infinitesimal_smooth_loci Infinitesimal smooth loci
          #SmoothL.num_defn
            %h6#definition_10 Definition
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SmoothLoci
                    %mo ≔
                    %msup
                      %mi SmoothAlgebras
                      %mi op
                    %mo ≔
                    %msup
                      %mi Func
                      %mo ×
                    %mo{:stretchy => "false"} (
                    %mi CartSp
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    SmoothLoci \coloneqq SmoothAlgebras^{op} \coloneqq Func^\times(CartSp,Set)
            %p
              for the category of
              %a.existingWikiWord{:href => "/nlab/show/spaces"} spaces
              which are
              %a.existingWikiWord{:href => "/nlab/show/Isbell+duality"} formally dual
              to
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/smooth+algebras"} smooth algebras
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
              of that of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/smooth+algebras"} smooth algebras
              = succeed "." do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/smooth+loci"} smooth loci
          #InfinitesimalAlgebra.num_defn
            %h6#definition_11 Definition
            %p
              A
              %strong
                %a.existingWikiWord{:href => "/nlab/show/Artin+ring"} smooth Artin algebra
              (also called a “Weil algebra” in the
              = succeed "-literature)" do
                %a.existingWikiWord{:href => "/nlab/show/synthetic+differential+geometry"} synthetic differential geometry
              %a.existingWikiWord{:href => "/nlab/show/smooth+algebra"} smooth algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              whose underlying
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
              %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
              is a
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo =
                    %mi ℝ
                    %mo ⊕
                    %mi V
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    A = \mathbb{R} \oplus V
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              is of finite
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              and such that every element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ∈
                    %mi V
                    %mo ⊂
                    %mi A
                  %annotation{:encoding => "application/x-tex"} v \in V \subset A
              is nilpotent, in that there is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              such that the
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              with itself in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              vanishes:
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi v
                        %mi n
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} v^n = 0
          .num_example
            %h6#example_3 Example
            %p
              The smallest smooth Artin algebra is the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/ring+of+dual+numbers"} ring of dual numbers
              = succeed "," do
                %a.maruku-ref{:href => "#DualNumbers"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo =
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} V = \mathbb{R}
          #InfinitesimallyThickenedPoints.num_defn
            %h6#definition_12 Definition
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi InfPoint
                    %mo ↪
                    %mi SmoothLoci
                  %annotation{:encoding => "application/x-tex"}
                    InfPoint \hookrightarrow SmoothLoci
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SmoothLoci
                    %annotation{:encoding => "application/x-tex"} SmoothLoci
              = succeed "," do
                %a.maruku-ref{:href => "#SmoothL"}
              = succeed "." do
                %a.maruku-ref{:href => "#InfinitesimalAlgebra"}
            %p
              We call this the category of
              = succeed "." do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/infinitesimally+thickened+points"} infinitesimally thickened points
          %h5#de_rham_space de Rham space
          %ul
