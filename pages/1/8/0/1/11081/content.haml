                            %munderover
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi i
                                %mo =
                                %mn 1
                              %mi k
                            %mfrac
                              %mrow
                                %mo ∂
                                %mi f
                              %mrow
                                %mo ∂
                                %msup
                                  %mi x
                                  %mi i
                            %mstyle{:mathvariant => "bold"}
                              %mi d
                            %msup
                              %mi x
                              %mi i
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %munderover
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi i
                                %mo =
                                %mn 1
                              %mi k
                            %munderover
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi j
                                %mo =
