            %p
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"}> commutes
              \.
          .proof
            %h6#proof Proof
            %p
              This is equivalently the statement of the
              %em
                %a.existingWikiWord{:href => "/nlab/show/chain+rule"} chain rule
              of
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/differentiation"} differentiation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \in C^\infty(\mathbb{R}^k)
              we have on the one hand, by def.
              %a.maruku-ref{:href => "#PullbackOfDifferential1FormsOnCartesianSpaces"}
              and def.
              %a.maruku-ref{:href => "#DeRhamDifferentialOn1Forms"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi d
                            %msup
                              %mi ϕ
                              %mo *
                            %mi f
                          %mtd
                            %mo =
                            %mstyle{:mathvariant => "bold"}
