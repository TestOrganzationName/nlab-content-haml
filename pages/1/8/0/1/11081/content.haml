                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    C^\infty(\mathbb{R}^k)
                    \&amp;\stackrel{\mathbf{d}}{\to}&amp;
                    \\Omega^1(\mathbb{R}^k)
                    \\\
                    \\downarrow^{\mathrlap{\phi^\ast}} &amp;&amp; \downarrow^{\mathrlap{\phi^\ast}}
                    \\\
