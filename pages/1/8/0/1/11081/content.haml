                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo ∘
                            %mi ϕ
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %munderover
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi j
                                %mo =
                                %mn 1
                              %mover
                                %mi k
                                %mo{:stretchy => "false"} ˜
                            %mfrac
                              %mrow
                                %mo ∂
                                %mo{:stretchy => "false"} (
                                %mi f
                                %mo ∘
                                %mi ϕ
                                %mo{:stretchy => "false"} )
                              %mrow
                                %mo ∂
