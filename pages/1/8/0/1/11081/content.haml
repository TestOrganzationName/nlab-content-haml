                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mover
                        %mi k
                        %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\frac{\partial (f \circ \phi)}{\partial x^j}
                    \=
                    \\sum_{i = 1}^k \left(\frac{\partial f}{\partial x^i}\circ \phi\right) \cdot \left(\frac{\partial \phi^i}{\partial x^j}\right)
                    \\;\;\;
                    \\in
                    C^\infty(\mathbb{R}^{\tilde k})
                    \\,.
            %p
              This is precisely the statement of the
              %em
                %a.existingWikiWord{:href => "/nlab/show/chain+rule"} chain rule
              for
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/differentiation"} differentiation
          %p
            Notice that as smooth spaces
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
