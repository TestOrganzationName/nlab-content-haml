                  InfPoint \hookrightarrow SmoothLoci
                  \\,.
          #InfinitesimallyThickenedCartesianSpaces.num_defn
            %h6#definition_13 Definition
            %p
              Write
              %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                      %mi th
                    %mo ↪
                    %mi SmoothLocus
                  %annotation{:encoding => "application/x-tex"} {}_{th} \hookrightarrow SmoothLocus
              for the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              of that of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/smooth+loci"} smooth loci
              = succeed "," do
                %a.maruku-ref{:href => "#SmoothL"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi U
                    %mo =
                    %mi U
                    %mo ×
                    %mi D
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{U} = U \times D
            %p
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                    %mi CartSp
                    %mo ↪
                    %mi SmoothLoci
                  %annotation{:encoding => "application/x-tex"} U \in CartSp \hookrightarrow SmoothLoci
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %mo ∈
                      %mi InfPoint
                      %mo ↪
                      %mi SmoothLoci
                    %annotation{:encoding => "application/x-tex"} D \in InfPoint \hookrightarrow SmoothLoci
            %p
              We may call this the category of
              %strong infinitesimally thickened Cartesian spaces
              or or
              = succeed "." do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/formal+smooth+manifold"} formal smooth Cartesian spaces
          %p
            The category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi CartSp
                    %mi th
                %annotation{:encoding => "application/x-tex"} CartSp_{th}
            carries several
            %a.existingWikiWord{:href => "/nlab/show/coverages"} coverages
            of interest. One is this:
          #CahiersTopos.num_defn
            %h6#definition_14 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi U
                    %mo =
                    %mi U
                    %mo ×
                    %mi D
                    %mo ∈
                    %msub
                      %mi CartSp
                      %mi th
                  %annotation{:encoding => "application/x-tex"} \mathbf{U} = U \times D \in CartSp_{th}
              say that a
              %a.existingWikiWord{:href => "/nlab/show/covering+family"} covering family
              is a set of morphisms in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi CartSp
                      %mi th
                  %annotation{:encoding => "application/x-tex"} CartSp_{th}
              of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ×
                    %mi D
                    %mover
                      %mo →
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi ϕ
                          %mi i
                        %mo ,
                        %msub
                          %mi id
                          %mi D
                        %mo{:stretchy => "false"} )
                    %mi U
                    %mo ×
                    %mi D
                    %msub
                      %mo{:stretchy => "false"} }
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \{ U_i \times D \stackrel{(\phi_i, id_D)}{\to} U \times D\}_i
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi ϕ
                          %mi i
                    %mi U
                    %msub
                      %mo{:stretchy => "false"} }
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \{ U_i \stackrel{\phi_i}{\to} U\}_i
              is a
              %a.existingWikiWord{:href => "/nlab/show/covering"} covering
              family in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
            %p
              The corresponding
              %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi CartSp
                      %mi th
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh(CartSp_{th})
              is known as the
              = succeed "." do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/Cahiers+topos"} Cahiers topos
          .num_prop
            %h6#proposition_5 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Cahiers+topos"} Cahiers topos
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi CartSp
                        %mi th
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Sh(CartSp_{th})
              = succeed "," do
                %a.maruku-ref{:href => "#CahiersTopos"}
              = succeed "is" do
                %br/
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cohesive+topos"} cohesive topos
          .num_defn
            %h6#definition_15 Definition
            %p We write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SynthDiff
                    %mn 0
                    %mi Type
                    %mo ≔
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi CartSp
                      %mi th
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    SynthDiff0Type \coloneqq Sh(CartSp_{th})
                    \\,.
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/synthetic+differential+infinity-groupoid"} synthetic differential infinity-groupoid
          %h5#tangent_bundle Tangent bundle
          %p
            Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo ∈
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi CartSp
                    %mi th
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} D \in Sh(CartSp_{th})
            for the
            %a.existingWikiWord{:href => "/nlab/show/smooth+locus"} smooth locus
            formally dual to the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/ring+of+dual+numbers"} ring of dual numbers
            = succeed "." do
              %a.maruku-ref{:href => "#"}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo{:lspace => "verythinmathspace"} :
                  %mo *
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"}
                  i \colon * \to D
          %p for the unique point inclusion.
          .num_defn
            %h6#definition_16 Definition
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mi SynthDiff
                      %mn 0
                      %mi Type
                    %annotation{:encoding => "application/x-tex"} X \in SynthDiff0Type
              %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mi X
                    %mo ≔
                    %mo{:stretchy => "false"} [
                    %mi D
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %mi SynthDiff
                    %mn 0
                    %mi Type
                  %annotation{:encoding => "application/x-tex"}
                    T X \coloneqq [D,X] \in SynthDiff0Type
            %p equipped with the morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi i
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} [
                    %mi D
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mo *
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mo ≃
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    [i,X] \colon [D,X] \to [*,X] \simeq X
            %p
              is the
              %strong
                %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          .num_defn
            %h6#definition_17 Definition
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mi SynthDiff
                      %mn 0
                      %mi Type
                    %annotation{:encoding => "application/x-tex"} X \in SynthDiff0Type
              %strong
                %a.existingWikiWord{:href => "/nlab/show/vector+field"} vector field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a
