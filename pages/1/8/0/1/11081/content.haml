              is a
              %a.existingWikiWord{:href => "/nlab/show/diffeological+space"} diffeological space
              whose underlying set is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^\infty(\Sigma,X)
              and whose
              = succeed "-plots" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} U \in
              %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              are smooth functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi U
                    %mo ×
                    %mi Σ
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \phi \colon U \times \Sigma \to X
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi s
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi U
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \phi(-,s) \colon U \to X
              is the constant function for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                      %mo ∈
                      %mo ∂
                      %mi Σ
                      %mo ↪
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} s \in \partial \Sigma \hookrightarrow \Sigma
          #SmoothFunctional.num_defn
            %h6#definition_7 Definition
            %p
              A
              %strong
                %a.existingWikiWord{:href => "/nlab/show/nonlinear+functional"} functional
              on the mapping space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\Sigma, X]
              is a
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of smooth spaces
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo ,
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mo ∂
                        %mi Σ
                    %mo →
                    %mi ℝ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S \colon [\Sigma, X]_{\partial \Sigma} \to \mathbb{R}
                    \\,.
          %h5#FunctionalDerivative Functional derivative / variational derivative
          %p Write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %mo{:lspace => "verythinmathspace"} :
                  %mi ℝ
                  %mo →
                  %msup
                    %mi Ω
                    %mn 1
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{d} \colon \mathbb{R} \to \Omega^1
          %p
            for the
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+differential"} de Rham differential
            incarnated as a
            %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            of
            %a.existingWikiWord{:href => "/nlab/show/smooth+spaces"} smooth spaces
            from the
            %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
            to the smooth
            %a.existingWikiWord{:href => "/nlab/show/moduli+space"} moduli space
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/differential+1-forms"} differential 1-forms
          .num_defn
            %h6#definition_8 Definition
            %p
              The
              %strong functional derivative
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %mi S
                    %mo ∈
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo ,
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mo ∂
                        %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{d}S
                    \\in
                    \\Omega^1([\Sigma,X]_{\partial \Sigma})
            %p
              of a functional
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
