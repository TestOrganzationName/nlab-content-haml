                                    %mi x
                                    %mi i
                              %mo ∘
                              %mi ϕ
                              %mo )
                            %mo ⋅
                            %mrow
                              %mo (
                              %mfrac
                                %mrow
                                  %mo ∂
                                  %msup
                                    %mi ϕ
                                    %mi i
                                %mrow
                                  %mo ∂
                                  %msup
                                    %mi x
                                    %mi j
                              %mo )
                            %mstyle{:mathvariant => "bold"}
                              %mi d
                            %msup
                              %mi x
                              %mi j
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\phi^* \mathbf{d}f
                    \&amp; =
                    \\phi^* \sum_{i = 1}^k \frac{\partial f}{\partial x^i} \mathbf{d}x^i
                    \\\
                    \&amp; = \sum_{i = 1}^k \sum_{j = 1}^{\tilde k}
                    \\left(\frac{\partial f}{\partial x^i}\circ \phi \right)
                    \\cdot
                    \\left(\frac{\partial \phi^i}{\partial x^j}\right) \mathbf{d}x^j
                    \\end{aligned}
                    \\,.
            %p
              Both expressions agree precisely if for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                        %mo ∂
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo ∘
                        %mi ϕ
                        %mo{:stretchy => "false"} )
                      %mrow
                        %mo ∂
                        %msup
                          %mi x
                          %mi j
                    %mo =
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo =
                        %mn 1
                      %mi k
                    %mrow
                      %mo (
                      %mfrac
                        %mrow
                          %mo ∂
