                %annotation{:encoding => "application/x-tex"}
                  A = \phi \mathbf{d}t + A_1 \mathbf{d}x^1 + A_2 \mathbf{d}x^2 + A_3 \mathbf{d}x^3
          %p
            then the
            %a.existingWikiWord{:href => "/nlab/show/electromagnetic+field+strength"} electromagnetic field strength
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo ≔
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %mi A
                  %mo =
                  %msub
                    %mi E
                    %mn 1
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %msup
                    %mi x
                    %mn 1
                  %mo ∧
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %mi t
                  %mo +
                  %msub
                    %mi E
                    %mn 2
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %msup
                    %mi x
                    %mn 2
                  %mo ∧
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %mi t
                  %mo +
