                  +
                  B_2 \mathbf{d}x^3 \wedge \mathbf{d}x^1
                  +
                  B_3 \mathbf{d}x^1 \wedge \mathbf{d}x^2
          %p with
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mi i
                  %mo =
                  %mfrac
                    %mrow
                      %mo ∂
                      %mi ϕ
