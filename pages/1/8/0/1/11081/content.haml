                    %mo =
                    %msup
                      %mi Ω
                      %mn 0
                    %mo =
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{R} = \Omega^0 = C^\infty(-)
            = succeed "." do
              %a.maruku-ref{:href => "#SpaceOf0FormsIsRealLine"}
          .num_prop
            %h6#proposition_2 Proposition
            %p
              The
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/de+Rham+differential"} de Rham differential
              = succeed "," do
