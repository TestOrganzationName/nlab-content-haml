                      %annotation{:encoding => "application/x-tex"} [\partial \Sigma \hookrightarrow \Sigma, X]
                  of configurations to the boundary;
              %li
                %p
                  the right vertical morphism is the homomorphism from def.
                  = succeed "." do
                    %a.maruku-ref{:href => "#MapFromDiscretizationOfSmooth0Type"}
          #PlotsOfMappingSpaceWithNonVaryingBoundary.num_prop
            %h6#proposition_4 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/smooth+space"} smooth space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo ,
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mo ∂
                        %mi Σ
