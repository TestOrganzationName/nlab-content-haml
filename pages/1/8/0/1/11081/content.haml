                        %mi A
                        %mn 3
                    %mrow
                      %mo ∂
                      %msup
                        %mi x
                        %mn 2
                %annotation{:encoding => "application/x-tex"}
                  B_1 = \frac{\partial A_2}{\partial x^3} - \frac{\partial A_3}{\partial x^2}
          %p etc
          %p
            This are the first 2 of 4
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Maxwell+equations"} Maxwell equations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %mi F
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} \mathbf{d} F = 0
          %p
            (the other 2 are discussed below in
            = succeed ")" do
              %a{:href => "#RiemannianGeometry"} Riemannian geometry
          %p for
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ,
                  %mi A
                  %mo ′
                  %mo :
                  %mi X
                  %mo →
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  A,A' : X \to \Omega^1(-)
          %p
            a
            %a.existingWikiWord{:href => "/nlab/show/gauge+transformation"} gauge transformation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo →
                  %mi A
                  %mo ′
                %annotation{:encoding => "application/x-tex"} A \to A'
            is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                  %mo :
                  %mi X
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \lambda : X \to \mathbb{R}
            with
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ′
                  %mo =
                  %mi A
                  %mo +
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %mi λ
                %annotation{:encoding => "application/x-tex"}
                  A' = A + \mathbf{d} \lambda
          %h4#VariationalCalculus Variational calculus
          %p
            Traditionally a
            %em
              %a.existingWikiWord{:href => "/nlab/show/functional"} functional
            is a
            %a.existingWikiWord{:href => "/nlab/show/function"} function
            which is sufficiently like a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
            %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
            between manifolds. Also traditionally, a
            %em
              %a.existingWikiWord{:href => "/nlab/show/variational+derivative"} variational derivative
            of such a functional is something aking to a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/derivative"} derivative
            = succeed "." do
              %em preserve some boundary conditions
          %p
            We formulate this classical theory in the context of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/smooth+spaces"} smooth spaces
            %a.existingWikiWord{:href => "/nlab/show/nonlinear+functional"} functional
            is simply a homomorphism of smooth spaces out of a smooth
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
            = succeed "." do
              %a.maruku-ref{:href => "#SmoothFunctionSpace"}
            %em respect for boundary conditions
            by forming the
            %a.existingWikiWord{:href => "/nlab/show/fiber+product"} fiber product
            of this mapping space with a
            = succeed "," do
              %em discrete smooth space inclusion
            %a.maruku-ref{:href => "#MapFromDiscretizationOfSmooth0Type"}
            below. Then the
            %em variational derivative
            is simply the ordinary derivative of def.
            = succeed "." do
              %a.maruku-ref{:href => "#DeRhamDifferentialOverSmoothSpaces"}
          %h5#discrete_points_of_a_smooth_space Discrete points of a smooth space
          #DiscretizationOfSmooth0Type.num_defn
            %h6#definition_4 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi Smooth
                    %mn 0
                    %mi Type
                  %annotation{:encoding => "application/x-tex"} X \in Smooth0Type
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/smooth+space"} smooth space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mi X
                    %mo ≔
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi Set
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma X
                    \\coloneqq
                    Hom(*,X)
                    \\in Set
            %p
              for its
              = succeed "," do
                %em set of points
              = succeed "," do
                %a.maruku-ref{:href => "#HomomorphismOfSmoothSpaces"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ♭
                    %mi X
                    %mo ≔
                    %mi Disc
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\flat X \coloneqq Disc (\Gamma(X))
            %p
              for the discrete smooth space, def.
              = succeed "," do
                %a.maruku-ref{:href => "#DiscreteSmoothSpace"}
          #MapFromDiscretizationOfSmooth0Type.num_defn
            %h6#definition_5 Definition
            %p
              For every smooth space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              there is a canonical homomorphism of smooth spaces
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ♭
                    %mi X
                    %mo →
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\flat X \to X
                    \\,.
            %p
              This sends a plot
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo →
                      %mo ♭
                      %mi X
                    %annotation{:encoding => "application/x-tex"} U \to \flat X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Disc(-)
              is a point in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \Gamma X
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo{:lspace => "verythinmathspace"} :
                      %mo *
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x \colon * \to X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo →
                    %mo *
                    %mover
                      %mo →
                      %mi x
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U \to * \stackrel{x}{\to} X
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          %h5#SmoothFunctionals Smooth functionals
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            be a
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth
            %a.existingWikiWord{:href => "/nlab/show/manifold+with+boundary"} manifold with boundary
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                    %mi Σ
                    %mo ↪
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \partial \Sigma \hookrightarrow \Sigma
          %p Write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi Σ
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mo ∈
                  %mi Smooth
                  %mn 0
                  %mi Type
                %annotation{:encoding => "application/x-tex"}
                  [\Sigma, X] \in Smooth0Type
          %p
            for the
            %a.existingWikiWord{:href => "/nlab/show/smooth+space"} smooth space
            (a
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/diffeological+space"} diffeological space
            %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ∈
                %annotation{:encoding => "application/x-tex"} U \in
            %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
            we have
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi Σ
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ×
                  %mi Σ
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  [\Sigma, X](U) = C^\infty(U \times \Sigma, X)
                  \\,.
          #MappingSpaceWithNonVaryingBoundary.num_defn
            %h6#definition_6 Definition
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo ,
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mo ∂
                        %mi Σ
                    %mo ≔
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %msub
                      %mo ×
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mo ∂
                        %mi Σ
                        %mo ,
                        %mi X
                        %mo{:stretchy => "false"} ]
                    %mo ♭
                    %mo{:stretchy => "false"} [
                    %mo ∂
                    %mi Σ
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    [\Sigma, X]_{\partial \Sigma}
                    \\coloneqq
                    [\Sigma, X] \times_{[\partial \Sigma,X]} \flat [\partial \Sigma,X]
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              in smooth spaces
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mi Σ
                            %mo ,
                            %mi X
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mrow
                                %mo ∂
                                %mi Σ
                          %mtd
                            %mo →
                          %mtd
                            %mo ♭
                            %mo{:stretchy => "false"} [
                            %mo ∂
                            %mi Σ
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} ]
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mi Σ
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo{:stretchy => "false"} )
                                %msub
                                  %mo{:stretchy => "false"} |
                                  %mrow
                                    %mo ∂
                                    %mi Σ
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mo ∂
                            %mi Σ
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    [\Sigma,X]_{\partial \Sigma}
                    \&amp;\to&amp;
                    \\flat [\partial \Sigma, X]
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    [\Sigma,X] &amp;\stackrel{(-)|_{\partial \Sigma}}{\to}&amp; [\partial \Sigma,X]
                    }
                    \\,,
            %p where
            %ul
              %li
                %p
                  the bottom morphism is the restriction
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
