                                      %msub
                                        %mi μ
                                        %mrow
                                          %msub
                                            %mn 1
                                            %mi 𝒞
                                          %mo ,
                                          %mi x
                            %mtr
                              %mtd
                                %mi F
                                %mo{:stretchy => "false"} (
                                %mi x
                                %mo{:stretchy => "false"} )
                              %mtd
                                %mover
                                  %mo ⟵
                                  %mrow
                                    %mi F
                                    %mo{:stretchy => "false"} (
                                    %msubsup
                                      %mi ℓ
                                      %mi x
                                      %mi 𝒞
                                    %mo{:stretchy => "false"} )
                              %mtd
                                %mi F
                                %mo{:stretchy => "false"} (
                                %mn 1
                                %msub
                                  %mo ⊗
                                  %mi 𝒞
                                %mi x
                                %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        1_{\mathcal{D}} \otimes_{\mathcal{D}} F(x)
                        \&amp;\overset{\epsilon \otimes id}{\longrightarrow}&amp;
                        F(1_{\mathcal{C}}) \otimes_{\mathcal{D}} F(x)
                        \\\
                        {}^{\mathllap{\ell^{\mathcal{D}}_{F(x)}}}\downarrow
                        \&amp;&amp;
                        \\downarrow^{\mathrlap{\mu_{1_{\mathcal{C}}, x }}}
                        \\\
                        F(x)
                        \&amp;\overset{F(\ell^{\mathcal{C}}_x )}{\longleftarrow}&amp;
                        F(1 \otimes_{\mathcal{C}} x  )
                        }
                %p and
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi F
                                %mo{:stretchy => "false"} (
