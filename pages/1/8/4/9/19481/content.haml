              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
              of sets, and the
              %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
              is the
              %a.existingWikiWord{:href => "/nlab/show/function+set"} function set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [X,Y]
              of functions from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
          #ExampleAbelianGroupsOfMonoidalCategory.num_example
            %h6#example_3 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
                of
                %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
                is
                %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed monoidal category
                %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric
                = succeed "-" do
                  %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/structure"} structure
            %p
              The category
              %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
              of
              %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
              (as in Example
              = succeed ")" do
                %a.maruku-ref{:href => "#ExamplesOfConcreteCategories"}
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SymmetricMonoidalCategory"}
              %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
              the actual
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+abelian+groups"} tensor product of abelian groups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ⊗
                      %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \otimes_{\mathbb{Z}}
              and with
              %a.existingWikiWord{:href => "/nlab/show/tensor+unit"} tensor unit
              the additive group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/integers"} integers
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/associator"} associator
              %a.existingWikiWord{:href => "/nlab/show/unitor"} unitor
              and
              %a.existingWikiWord{:href => "/nlab/show/braiding"} braiding
              isomorphism are the evident ones coming from the underlying sets.
            %p
              This is a
              %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed monoidal category
              with
              %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi hom
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} hom(A,B)
              being the set of
              %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi Ab
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom_{Ab}(A,B)
              equipped with the pointwise group structure for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mn 1
                    %mo ,
                    %msub
                      %mi ϕ
                      %mn 2
                    %mo ∈
                    %msub
                      %mi Hom
                      %mi Ab
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \phi_1, \phi_2 \in Hom_{Ab}(A,B)
              then
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi ϕ
                        %mn 1
                      %mo +
                      %msub
                        %mi ϕ
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %msub
                        %mi ϕ
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo +
                      %msub
                        %mi ϕ
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ∈
                      %mi B
                    %annotation{:encoding => "application/x-tex"} (\phi_1 + \phi_2)(a) \coloneqq \phi_1(a) + \phi_2(b) \; \in B
            %p
              This is the archetypical case that motivates the notation “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo ⊗
                  %annotation{:encoding => "application/x-tex"} \otimes
              ” for the pairing operation in a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
          #GrpdIsACartesianClosedCategory.num_example
