                        %mi id
                        %mi c
                    %annotation{:encoding => "application/x-tex"} id_c
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi d
                    %mo →
                    %mi c
                  %annotation{:encoding => "application/x-tex"} g \;\colon\; d \to c
              be any morphism and chase
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi id
                      %mi c
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (id_c, x )
              through the naturality diagram for
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mover
                          %mi f
                          %mo ˜
                        %mi c
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \widetilde f_c(a)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi Hom
                              %mi 𝒞
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo ,
                            %mi c
                            %mo{:stretchy => "false"} )
                            %mo ×
                            %mstyle{:mathvariant => "bold"}
                              %mi X
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mover
                                    %mi f
                                    %mo ˜
                                  %mi c
                                %mo{:stretchy => "false"} (
                                %mi a
                                %mo{:stretchy => "false"} )
                                %msub
                                  %mo{:stretchy => "false"} )
                                  %mi c
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi Y
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msup
                                    %mi g
                                    %mo *
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msup
                                    %mi g
                                    %mo *
                        %mtr
                          %mtd
                            %msub
                              %mi Hom
                              %mi 𝒞
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo ,
                            %mi c
                            %mo{:stretchy => "false"} )
                            %mo ×
                            %mstyle{:mathvariant => "bold"}
                              %mi X
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mover
                                    %mi f
                                    %mo ˜
                                  %mi c
                                %mo{:stretchy => "false"} (
