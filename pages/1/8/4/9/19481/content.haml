                          %mi a
                          %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} a^{\mathcal{C}}
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi a
                          %mi 𝒟
                      %annotation{:encoding => "application/x-tex"} a^{\mathcal{D}}
                  denote the
                  %a.existingWikiWord{:href => "/nlab/show/associators"} associators
                  of the monoidal categories;
              %li
                %p
                  %strong
                    (
                    %a.existingWikiWord{:href => "/nlab/show/unitality"}> unitality
                    )
                  For all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} x \in \mathcal{C}
                  the following
                  %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} diagrams commutes
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %msub
                                  %mn 1
                                  %mi 𝒟
                                %msub
                                  %mo ⊗
                                  %mi 𝒟
                                %mi F
