              as in prop.
              = succeed "," do
                %a.maruku-ref{:href => "#MonoidalCategoryOfModules"}
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
