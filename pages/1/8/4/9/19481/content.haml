              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi Y
                    %mo ∈
                    %msub
                      %mi Obj
                      %mi 𝒱
                  %annotation{:encoding => "application/x-tex"} X,Y \in Obj_{\mathcal{V}}
              be two
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              = succeed ")" do
                %a.maruku-ref{:href => "#ChangeOfCosmosFromVToSet"}
              %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
