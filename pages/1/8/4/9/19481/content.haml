                                        %mi x
                                        %mo ,
                                        %mi y
                                        %mo ,
                                        %mi z
                                      %mi 𝒞
                                    %mo{:stretchy => "false"} )
                              %mtd
                                %mi F
                                %mo{:stretchy => "false"} (
