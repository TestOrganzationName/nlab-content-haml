                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ,
                            %mi a
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    ev_c( x, \widetilde f_c(a) )
                    \&amp; \coloneqq
                    (\widetilde f_c(a))_c( id_c, x )
                    \\\
