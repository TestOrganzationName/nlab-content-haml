                  %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} diagram commutes
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} (
                                %mi F
