                  %annotation{:encoding => "application/x-tex"} [X,Y] \in \mathcal{V}
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ClosedMonoidalCategory"}
              %a.existingWikiWord{:href => "/nlab/show/hom-set"} hom-set
              (Def.
              = succeed "):" do
