                                  %mo ⊗
                                  %mi 𝒞
                                %mi y
                                %mo{:stretchy => "false"} )
                                %msub
                                  %mo ⊗
                                  %mi 𝒞
                                %mi z
                                %mo{:stretchy => "false"} )
                              %mtd
                                %munder
                                  %mo ⟶
                                  %mrow
                                    %mi F
                                    %mo{:stretchy => "false"} (
                                    %msubsup
