                                %mo{:stretchy => "false"} )
                              %mtd
                                %mover
                                  %mo ⟵
                                  %mrow
                                    %mi F
                                    %mo{:stretchy => "false"} (
                                    %msubsup
                                      %mi r
                                      %mi x
                                      %mi 𝒞
                                    %mo{:stretchy => "false"} )
                              %mtd
                                %mi F
                                %mo{:stretchy => "false"} (
                                %mi x
                                %msub
                                  %mo ⊗
                                  %mi 𝒞
                                %mn 1
                                %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        F(x) \otimes_{\mathcal{D}}  1_{\mathcal{D}}
                        \&amp;\overset{id \otimes \epsilon }{\longrightarrow}&amp;
                        F(x) \otimes_{\mathcal{D}}  F(1_{\mathcal{C}})
                        \\\
                        {}^{\mathllap{r^{\mathcal{D}}_{F(x)}}}\downarrow
                        \&amp;&amp;
                        \\downarrow^{\mathrlap{\mu_{x, 1_{\mathcal{C}} }}}
                        \\\
                        F(x)
                        \&amp;\overset{F(r^{\mathcal{C}}_x )}{\longleftarrow}&amp;
                        F(x \otimes_{\mathcal{C}} 1  )
                        }
                        \\,,
                %p
                  where
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi ℓ
                            %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \ell^{\mathcal{C}}
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi ℓ
                            %mi 𝒟
                        %annotation{:encoding => "application/x-tex"} \ell^{\mathcal{D}}
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi r
                            %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} r^{\mathcal{C}}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
