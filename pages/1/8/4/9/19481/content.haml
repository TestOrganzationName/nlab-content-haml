                            %mo{:stretchy => "false"} )
                            %mo ,
                            %msup
                              %mi g
                              %mo *
                            %mo{:stretchy => "false"} (
                            %mi a
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Hom_{\mathcal{C}}(c,c) \times \mathbf{X}(c)
                    \&amp;\overset{ (\widetilde f_c(a))_c }{\longrightarrow}&amp;
                    \\mathbf{Y}(c)
                    \\\
                    {}^{\mathllap{ g^\ast }}\big\downarrow
                    \&amp;&amp;
                    \\big\downarrow^{\mathrlap{ g^\ast }}
                    \\\
                    Hom_{\mathcal{C}}(d,c) \times \mathbf{X}(d)
                    \&amp;\overset{ (\widetilde f_c(a))_d }{\longrightarrow}&amp;
                    \\mathbf{Y}(d)
                    }
                    \\phantom{AAAA}
                    \\array{
                    \\{ (id_c, x ) \} &amp;\longrightarrow&amp; \{ f_c( x, a ) \}
                    \\\
                    \\big\downarrow &amp;&amp; \big\downarrow
                    \\\
                    \\{ (g, g^\ast(x)) \}  &amp;\longrightarrow&amp; \{ f_d( g^\ast(x), g^\ast(a) ) \}
                    }
            %p
              This shows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mover
                        %mi f
                        %mo ˜
                      %mi c
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi d
                  %annotation{:encoding => "application/x-tex"} (\widetilde f_c(a))_d
              is fixed to be given by
            #eq:ComponentFormulaForEvaluationMapInPresheaves.maruku-equation
              %span.maruku-eq-number (6)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mover
                        %mi f
                        %mo ˜
                      %mi c
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi d
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo ,
                    %mi x
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi f
                      %mi d
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ′
                    %mo ,
                    %msup
                      %mi g
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (\widetilde f_c(a))_d( g, x' )
                    \\;=\;
                    f_d( x', g^\ast(a) )
            %p
              at least on those pairs
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo ,
                    %mi x
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (g,x')
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} x'
              is in the image of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi g
                        %mo *
                    %annotation{:encoding => "application/x-tex"} g^\ast
            %p
              But, finally,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mover
                        %mi f
                        %mo ˜
                      %mi c
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi d
                  %annotation{:encoding => "application/x-tex"} (\widetilde f_c(a))_d
              is also natural in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi A
                            %mo{:stretchy => "false"} (
                            %mi c
