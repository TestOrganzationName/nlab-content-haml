                            %mi d
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mover
                                    %mi f
                                    %mo ˜
                                  %mi d
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mstyle{:mathvariant => "bold"}
                              %mi X
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mi Y
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbf{A}(c)
                    \&amp;\overset{ \widetilde f_c }{\longrightarrow}&amp; [\mathbf{X},\mathbf{Y}](c)
                    \\\
                    {}^{\mathllap{g^\ast}}\big\downarrow &amp;&amp; \big\downarrow^{\mathrlap{g^\ast}}
                    \\\
                    \\mathbf{A}(d)
                    \&amp;\overset{ \widetilde f_d }{\longrightarrow}&amp; [\mathbf{X},\mathbf{Y}](d)
                    }
            %p
              which implies that
              %a.maruku-eqref{:href => "#eq:ComponentFormulaForEvaluationMapInPresheaves"} (6)
              must hold generally. Hence naturality implies that
              %a.maruku-eqref{:href => "#eq:UniversalArrowConditionForEvaluationMapInPresheaves"} (5)
              indeed has a unique solution.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
            (Def.
            = succeed ")" do
              %a.maruku-ref{:href => "#ClosedMonoidalCategory"}
            %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
            (Def.
            = succeed ")," do
              %a.maruku-ref{:href => "#HomFunctor"}
          #InternalHomBifunctor.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/bifunctor"} bifunctor
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              a
              %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed monoidal category
              (Def.
              = succeed ")," do
                %a.maruku-ref{:href => "#ClosedMonoidalCategory"}
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Functors"}
              %a.existingWikiWord{:href => "/nlab/show/product+category"} product category
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ProductCategory"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              with its
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#OppositeCategory"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ×
                    %mi 𝒞
                    %mo ⟶
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"}
                    [-,-]
                    \\;\colon\;
                    \\mathcal{C}^{op} \times \mathcal{C}
                    \\longrightarrow
                    \\mathcal{C}
            %p
              such that for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} X \in \mathcal{C}
              it coincides with the
              %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [X,-]
              %a.maruku-eqref{:href => "#eq:InternalHomAdjunction"} (2)
              as a functor in the second variable, and such that there is a
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mi Y
                    %mo ,
                    %mi Z
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ⊗
                    %mi Y
                    %mo ,
                    %mi Z
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Hom(X, [Y,Z])
                    \\;\simeq\;
                    Hom(X \otimes Y, Z)
            %p
              which is natural not only in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Z
                    %annotation{:encoding => "application/x-tex"} Z
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
          .proof
            %h6#proof_2 Proof
            %p
              We have a natural isomorphism for each fixed
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              and fixed
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} Z
              by
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:InternalHomAdjunction"} (2)
              = succeed "." do
                %a.maruku-ref{:href => "#AdjointFunctorFromObjectwiseRepresentingObject"}
          %p
            In fact the 3-variable adjunction from Prop.
            %a.maruku-ref{:href => "#InternalHomBifunctor"}
            even holds internally:
          #TensorHomAdjunctionIsoInternally.num_prop
            %h6#proposition_2 Proposition
            %p
              %strong (internal tensor/hom-adjunction)
            %p
              In a
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric
              %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed monoidal category
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ClosedMonoidalCategory"}
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphisms"} natural isomorphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ⊗
                    %mi Y
                    %mo ,
                    %mi Z
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mi Y
                    %mo ,
                    %mi Z
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    [X \otimes Y, Z]
                    \\;\simeq\;
                    [X, [Y,Z]]
            %p
              whose image under
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom_{\mathcal{C}}(1,-)
              (see also Example
              %a.maruku-ref{:href => "#ChangeOfCosmosFromVToSet"}
              below) are the defining
              %a.existingWikiWord{:href => "/nlab/show/natural+bijections"} natural bijections
              of Prop.
              = succeed "." do
                %a.maruku-ref{:href => "#InternalHomBifunctor"}
          .proof
            %h6#proof_3 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} A \in \mathcal{C}
              be any object. By applying the natural bijections from Prop.
              = succeed "," do
                %a.maruku-ref{:href => "#InternalHomBifunctor"}
              %a.existingWikiWord{:href => "/nlab/show/natural+bijections"} natural bijections
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi Hom
                              %mi 𝒞
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo ,
                            %mo{:stretchy => "false"} [
                            %mi X
                            %mo ⊗
                            %mi Y
                            %mo ,
                            %mi Z
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                            %msub
                              %mi Hom
                              %mi 𝒞
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo ⊗
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ⊗
                            %mi Y
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi Z
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mi Hom
                              %mi 𝒞
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo ⊗
                            %mi X
                            %mo{:stretchy => "false"} )
                            %mo ⊗
                            %mi Y
                            %mo ,
                            %mi Z
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mi Hom
                              %mi 𝒞
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo ⊗
                            %mi X
                            %mo ,
                            %mo{:stretchy => "false"} [
                            %mi Y
                            %mo ,
                            %mi Z
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mi Hom
                              %mi 𝒞
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo ,
                            %mo{:stretchy => "false"} [
                            %mi X
                            %mo ,
                            %mo{:stretchy => "false"} [
                            %mi Y
                            %mo ,
                            %mi Z
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    Hom_{\mathcal{C}}(A , [X \otimes Y, Z])
                    \&amp; \simeq
                    Hom_{\mathcal{C}}(A \otimes (X \otimes Y), Z)
                    \\\
                    \&amp; \simeq
                    Hom_{\mathcal{C}}((A \otimes X)\otimes Y, Z)
                    \\\
                    \&amp; \simeq
                    Hom_{\mathcal{C}}(A \otimes X, [Y,Z])
                    \\\
                    \&amp; \simeq
                    Hom_{\mathcal{C}}(A, [X, [Y,Z]])
                    \\end{aligned}
            %p
              Since this holds for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithfulness
              of the
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
              (Prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#YonedaEmbedding"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo ⊗
                      %mi Y
                      %mo ,
                      %mi Z
                      %mo{:stretchy => "false"} ]
                      %mo ≃
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo ,
                      %mo{:stretchy => "false"} [
                      %mi Y
                      %mo ,
                      %mi Z
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [ X\otimes Y, Z ] \simeq [X, [Y,Z]]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} A = 1
              in the above and using the left
              %a.existingWikiWord{:href => "/nlab/show/unitor"} unitor
              isomorphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ⊗
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi X
                    %mo ⊗
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} A \otimes (X \otimes Y) \simeq X \otimes Y
              and
