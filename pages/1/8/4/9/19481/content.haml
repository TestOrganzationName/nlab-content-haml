          #UnderlyingCategoryOfTopEnrichedCategory.num_example
            %h6#example_17 Example
            %p
              %strong
                (underlying
                %a.existingWikiWord{:href => "/nlab/show/category"} category
                of an
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒱
                    %annotation{:encoding => "application/x-tex"} \mathcal{V}
              %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
              (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#TopEnrichedCategory"}
            %p
              Using the
              %a.existingWikiWord{:href => "/nlab/show/lax+monoidal+functor"} lax monoidal
              %a.existingWikiWord{:href => "/nlab/show/structure"} structure
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LaxMonoidalFunctor"}
              %a.existingWikiWord{:href => "/nlab/show/hom+functor"} hom functor
              (Example
              = succeed ")" do
                %a.maruku-ref{:href => "#ChangeOfCosmosFromVToSet"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi 𝒱
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒱
                    %mo ⟶
                    %mi Set
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{\mathcal{V}}(1,-)
                    \\;\colon\;
                    \\mathcal{V} \longrightarrow Set
            %p
              out of the
              %a.existingWikiWord{:href => "/nlab/show/tensor+unit"} tensor unit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} 1 \in \mathcal{C}
              this induces a
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi 𝒞
                    %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} \vert \mathcal{C}\vert
              with hence an ordinary
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              (Example
              = succeed ")," do
                %a.maruku-ref{:href => "#SetEnrichedCategoriesArePlainCategories"}
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msub
                          %mi Obj
                          %mrow
                            %mo{:stretchy => "false"} |
                            %mi 𝒞
                            %mo{:stretchy => "false"} |
                        %mspace{:width => "thickmathspace"}
                        %mo ≔
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mi Obj
                          %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} Obj_{\vert \mathcal{C}\vert} \;\coloneqq\; Obj_{\mathcal{C}}
                  ;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msub
                          %mi Hom
                          %mrow
                            %mo{:stretchy => "false"} |
                            %mi 𝒞
                            %mo{:stretchy => "false"} |
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi Y
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo ≔
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mi Hom
                          %mi 𝒱
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo ,
                        %mi 𝒞
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi Y
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        Hom_{\vert \mathcal{C}\vert}( X, Y )
                        \\;\coloneqq\;
                        Hom_{\mathcal{V}}(1, \mathcal{C}(X,Y))
                  \.
            %p
              It is in this sense that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is a plain
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi 𝒞
                      %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} {\vert \mathcal{C}\vert}
              equipped with
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/extra+structure"} extra structure
              = succeed "\u201D." do
                %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
          %p
            The archetypical example is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒱
                %annotation{:encoding => "application/x-tex"} \mathcal{V}
            itself:
          #TopkAsATopologicallyEnrichedCategory.num_example
            %h6#example_18 Example
            %p
              %strong
                (
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒱
                    %annotation{:encoding => "application/x-tex"} \mathcal{V}
                as a
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒱
                      %annotation{:encoding => "application/x-tex"} \mathcal{V}
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
            %p
              Evert
              %a.existingWikiWord{:href => "/nlab/show/cosmos"} cosmos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Cosmos"}
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒱
                    %annotation{:encoding => "application/x-tex"} \mathcal{V}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
              = succeed ":" do
                %a.maruku-ref{:href => "#TopEnrichedCategory"}
            %p
              the
              %a.existingWikiWord{:href => "/nlab/show/hom-objects"} hom-objects
              are the
              %a.existingWikiWord{:href => "/nlab/show/internal+homs"} internal homs
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝓋
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{v}(X,Y)
                    \\coloneqq
                    [X,Y]
            %p
              and with
              %a.existingWikiWord{:href => "/nlab/show/composition"} composition
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
