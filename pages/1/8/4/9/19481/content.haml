                            %mstyle{:mathvariant => "bold"}
                              %mi X
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mi Y
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msup
                                    %mi g
                                    %mo *
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msup
                                    %mi g
                                    %mo *
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi A
