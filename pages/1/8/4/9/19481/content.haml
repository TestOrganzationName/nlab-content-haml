              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TopEnrichedCategory"}
              %a.existingWikiWord{:href => "/nlab/show/cosmos"} cosmos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒱
