                                  %mn 1
                                  %mi 𝒞
                                %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                                %msup
                                  %mrow
                                  %mpadded{:lspace => "-100%width", :width => "0"}
                                    %mrow
                                      %msubsup
                                        %mi r
