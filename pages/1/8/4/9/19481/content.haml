          .proof
            %h6#proof Proof
            %p
              The first statement is a special case of the general fact that
              %a.existingWikiWord{:href => "/nlab/show/limits+of+presheaves+are+computed+objectwise"} limits of presheaves are computed objectwise
              (Example
              = succeed ")." do
                %a.maruku-ref{:href => "#LimitsOfPresheavesAreComputedObjectwise"}
            %p
              For the second statement, first assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\mathbf{X}, \mathbf{Y}]
              does exist. Then by the adjunction hom-isomorphism
              %a.maruku-eqref{:href => "#eq:HomIsomorphismForAdjointFunctors"} (?)
              we have for any other presheaf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Z
                  %annotation{:encoding => "application/x-tex"} \mathbf{Z}
              a
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
              of the form
            #eq:InternalHomIsoInPresheaves.maruku-equation
              %span.maruku-eq-number (4)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi 𝒞
                          %mi op
                        %mo ,
                        %mi Set
                        %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi Z
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Hom
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi 𝒞
                          %mi op
                        %mo ,
                        %mi Set
                        %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi Z
                    %mo ×
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{[\mathcal{C}^{op}, Set]}(\mathbf{Z}, [\mathbf{X},\mathbf{Y}])
                    \\;\simeq\;
                    Hom_{[\mathcal{C}^{op}, Set]}(\mathbf{Z} \times \mathbf{X}, \mathbf{Y})
                    \\,.
            %p
              This holds in particular for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Z
                    %mo =
                    %mi y
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{Z} = y(c)
              a
              %a.existingWikiWord{:href => "/nlab/show/representable+presheaf"} representable presheaf
              (Example
              = succeed ")" do
                %a.maruku-ref{:href => "#RepresentablePresheaves"}
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
              (Prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#YonedaLemma"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\mathbf{X}, \mathbf{Y}]
              must have the claimed form:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mstyle{:mathvariant => "bold"}
                              %mi X
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mi Y
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                            %msub
                              %mi Hom
                              %mrow
                                %mo{:stretchy => "false"} [
                                %msup
                                  %mi 𝒞
                                  %mi op
                                %mo ,
                                %mi Set
                                %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} (
                            %mi y
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mo{:stretchy => "false"} [
                            %mstyle{:mathvariant => "bold"}
                              %mi X
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mi Y
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mi Hom
                              %mrow
                                %mo{:stretchy => "false"} [
                                %msup
                                  %mi 𝒞
                                  %mi op
                                %mo ,
                                %mi Set
                                %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} (
                            %mi y
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                            %mo ×
                            %mstyle{:mathvariant => "bold"}
                              %mi X
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mi Y
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    [\mathbf{X}, \mathbf{Y}](c)
                    \&amp; \simeq
                    Hom_{[\mathcal{C}^{op}, Set]}( y(c), [\mathbf{X}, \mathbf{Y}] )
                    \\\
                    \&amp; \simeq Hom_{ [\mathcal{C}^{op}, Set] }( y(c) \times \mathbf{X}, \mathbf{Y} )
                    \\,.
                    \\end{aligned}
            %p
              Hence it remains to show that this formula does make
              %a.maruku-eqref{:href => "#eq:InternalHomIsoInPresheaves"} (4)
              hold generally.
            %p
              For this we use the equivalent characterization of
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
              from Prop.
              = succeed "," do
                %a.maruku-ref{:href => "#CollectionOfUniversalArrowsEquivalentToAdjointFunctor"}
              %a.existingWikiWord{:href => "/nlab/show/adjunction+counit"} adjunction counit
              providing a system of
              %a.existingWikiWord{:href => "/nlab/show/universal+arrows"} universal arrows
              (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#UniversalArrow"}
            %p
              Define a would-be
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/adjunction+counit"} adjunction counit
              %em
                %a.existingWikiWord{:href => "/nlab/show/evaluation"} evaluation
              morphism
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:EvaluationMorphism"} (3)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi X
                            %mo ×
                            %mo{:stretchy => "false"} [
                            %mstyle{:mathvariant => "bold"}
                              %mi X
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mi Y
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mover
                              %mo ⟶
                              %mi ev
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi Y
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi X
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                            %mo ×
                            %msub
                              %mi Hom
                              %mrow
                                %mo{:stretchy => "false"} [
                                %msup
                                  %mi 𝒞
                                  %mi op
                                %mo ,
                                %mi Set
                                %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} (
                            %mi y
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                            %mo ×
                            %mstyle{:mathvariant => "bold"}
                              %mi X
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mi Y
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi ev
                                  %mi c
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi Y
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ,
                            %mi ϕ
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %msub
                              %mi ϕ
                              %mi c
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi id
                              %mi c
                            %mo ,
                            %mi x
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbf{X} \times [\mathbf{X} , \mathbf{Y}]
                    \&amp;\overset{ev}{\longrightarrow}&amp;
                    \\mathbf{Y}
                    \\\
                    \\mathbf{X}(c) \times Hom_{[\mathcal{C}^{op}, Set]}(y(c) \times \mathbf{X}, \mathbf{Y})
                    \&amp;\overset{ev_c}{\longrightarrow}&amp;
                    \\mathbf{Y}(c)
                    \\\
                    (x, \phi) &amp;\mapsto&amp; \phi_c( id_c, x )
                    }
            %p
              Then it remains to show that for every morphism of presheaves of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                    %mo ×
                    %mstyle{:mathvariant => "bold"}
                      %mi A
                    %mover
                      %mo ⟶
                      %mrow
                        %mphantom
                          %mi A
                        %mi f
                        %mphantom
                          %mi A
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} \mathbf{X} \times \mathbf{A} \overset{\phantom{A}f\phantom{A}}{\longrightarrow} \mathbf{Y}
              there is a
              %em unique
              morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo ˜
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi A
                    %mo ⟶
                    %mo{:stretchy => "false"} [
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \widetilde f \;\colon\; \mathbf{A} \longrightarrow [\mathbf{X}, \mathbf{Y}]
              such that
            #eq:UniversalArrowConditionForEvaluationMapInPresheaves.maruku-equation
              %span.maruku-eq-number (5)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi X
                            %mo ×
                            %mstyle{:mathvariant => "bold"}
                              %mi A
                          %mtd
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mstyle{:mathvariant => "bold"}
                                  %mi X
                                %mo ×
                                %mover
                                  %mi f
                                  %mo ˜
                          %mtd
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi X
                            %mo ×
                            %mo{:stretchy => "false"} [
                            %mstyle{:mathvariant => "bold"}
                              %mi X
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mi Y
                            %mo{:stretchy => "false"} ]
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mpadded{:width => "0"}
                                  %mi f
                            %mo ↘
                          %mtd
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mi ev
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbf{X} \times \mathbf{A}
                    \&amp;&amp; \overset{ \mathbf{X} \times \widetilde f  }{\longrightarrow} &amp;&amp;
                    \\mathbf{X} \times [\mathbf{X}, \mathbf{Y}]
                    \\\
                    \&amp; {}_{\mathllap{ \mathrlap{f} }}\searrow
                    \&amp;&amp;
                    \\swarrow_{ \mathrlap{  ev } }
                    \\\
                    \&amp;&amp; \mathbf{Y}
                    }
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commutativity
              of this diagram means in components at
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} c \in \mathcal{C}
              that, that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x \in \mathbf{X}(c)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} a \in \mathbf{A}(c)
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi ev
                              %mi c
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ,
                            %msub
                              %mover
                                %mi f
                                %mo ˜
                              %mi c
                            %mo{:stretchy => "false"} (
                            %mi a
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≔
                            %mo{:stretchy => "false"} (
                            %msub
                              %mover
                                %mi f
                                %mo ˜
                              %mi c
                            %mo{:stretchy => "false"} (
                            %mi a
                            %mo{:stretchy => "false"} )
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi c
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi id
                              %mi c
                            %mo ,
