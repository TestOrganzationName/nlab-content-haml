          .proof
            %h6#proof_9 Proof
            %p Take the monoidal transformations (eq“MonoidalComponentsOfMonoidalFunctor) to be
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
