                          %mi A
                      %mo{:lspace => "verythinmathspace"} :
                      %mi E
                      %msub
                        %mo ⊗
                        %mi A
                      %mi E
                      %mo ⟶
                      %mi E
                    %annotation{:encoding => "application/x-tex"} \mu_{E/A} \colon E \otimes_A E \longrightarrow E
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mi E
                  %annotation{:encoding => "application/x-tex"} \mu_E
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi E
                            %mo ⊗
                            %mi A
                            %mo ⊗
                            %mi E
                          %mtd
