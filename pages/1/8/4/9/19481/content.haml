              is called a
              = succeed "." do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/strong+monoidal+functor"} strong monoidal functor
            %p
              If moreover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %msub
                      %mo ⊗
                      %mi 𝒞
                    %mo ,
                    %msub
                      %mn 1
                      %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{C},\otimes_{\mathcal{C}}, 1_{\mathcal{C}})
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒟
                    %mo ,
                    %msub
                      %mo ⊗
                      %mi 𝒟
                    %mo ,
                    %msub
                      %mn 1
                      %mi 𝒟
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{D},\otimes_{\mathcal{D}}, 1_{\mathcal{D}} )
              are equipped with the structure of
              %a.existingWikiWord{:href => "/nlab/show/braided+monoidal+categories"} braided monoidal categories
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#BraidedMonoidalCategory"}
              %a.existingWikiWord{:href => "/nlab/show/braidings"} braidings
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi τ
                      %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \tau^{\mathcal{C}}
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi τ
                        %mi 𝒟
                    %annotation{:encoding => "application/x-tex"} \tau^{\mathcal{D}}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is called a
              %strong
                %a.existingWikiWord{:href => "/nlab/show/braided+monoidal+functor"} braided monoidal functor
              if in addition the following
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} diagram commutes
              for all objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ,
                    %mi y
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} x,y \in \mathcal{C}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %msub
                              %mo ⊗
                              %mi 𝒞
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi y
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msubsup
                                  %mi τ
                                  %mrow
                                    %mi F
                                    %mo{:stretchy => "false"} (
                                    %mi x
                                    %mo{:stretchy => "false"} )
                                    %mo ,
                                    %mi F
                                    %mo{:stretchy => "false"} (
                                    %mi y
                                    %mo{:stretchy => "false"} )
                                  %mi 𝒟
                          %mtd
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi y
                            %mo{:stretchy => "false"} )
                            %msub
                              %mo ⊗
                              %mi 𝒟
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi μ
                                    %mrow
                                      %mi x
                                      %mo ,
                                      %mi y
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi μ
