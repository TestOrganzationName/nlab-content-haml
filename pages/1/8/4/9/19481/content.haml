          #AlgebrasOverAAreMonoidsUnderA.num_prop
            %h6#proposition_7 Proposition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal
              %a.existingWikiWord{:href => "/nlab/show/category+of+modules"} category of modules
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
