                      %annotation{:encoding => "application/x-tex"}
                        \\mu_{x,y}
                        \\;\colon\;
                        F(x) \otimes_{\mathcal{D}} F(y)
                        \\longrightarrow
                        F(x \otimes_{\mathcal{C}} y)
                %p
                  for all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ,
                        %mi y
                        %mo ∈
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} x,y \in \mathcal{C}
            %p satisfying the following conditions:
