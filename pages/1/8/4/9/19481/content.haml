            %p
              Moreover, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} \mathcal{D}
              are
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+categories"} symmetric monoidal categories
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SymmetricMonoidalCategory"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is a
              %a.existingWikiWord{:href => "/nlab/show/braided+monoidal+functor"} braided monoidal functor
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LaxMonoidalFunctor"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is a
              %a.existingWikiWord{:href => "/nlab/show/commutative+monoid"} commutative monoid
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#MonoidsInMonoidalCategory"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F(A)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CMon
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi CMon
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %msub
                      %mo ⊗
                      %mi 𝒞
                    %mo ,
                    %msub
                      %mn 1
                      %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi CMon
                    %mo{:stretchy => "false"} (
                    %mi 𝒟
                    %mo ,
                    %msub
                      %mo ⊗
                      %mi 𝒟
                    %mo ,
                    %msub
                      %mn 1
                      %mi 𝒟
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    CMon(F)
                    \\;\colon\;
                    CMon(\mathcal{C}, \otimes_{\mathcal{C}}, 1_{\mathcal{C}})
                    \\longrightarrow
                    CMon(\mathcal{D},\otimes_{\mathcal{D}}, 1_{\mathcal{D}})
                    \\,.
          .proof
            %h6#proof_8 Proof
            %p
              This follows immediately from combining the associativity and unitality (and symmetry) constraints of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              with those of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %h3#EnrichedCategories Enriched categories
          %p
            The plain definition of
            %a.existingWikiWord{:href => "/nlab/show/categories"} categories
            in Def.
            %a.maruku-ref{:href => "#Categories"}
            is phrased in terms of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/sets"} sets
            %a.maruku-ref{:href => "#CategoryOfSets"}
            this assigns a special role to the category
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            of all sets, as the “base” on top, or the “
            %a.existingWikiWord{:href => "/nlab/show/cosmos"}> cosmos
            ” inside which
            %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
            takes place. For instance, the fact that
            %a.existingWikiWord{:href => "/nlab/show/hom-sets"} hom-sets
            in a plain
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            are indeed sets, is what makes the
            %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
            (Example
            = succeed ")" do
              %a.maruku-ref{:href => "#HomFunctor"}
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
            (Prop.
            = succeed ")" do
              %a.maruku-ref{:href => "#YonedaLemma"}
            %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
            (Prop.
            = succeed ")" do
              %a.maruku-ref{:href => "#YonedaEmbedding"}
            %a.existingWikiWord{:href => "/nlab/show/presheaves"} presheaves
            of sets (Example
            = succeed ")." do
              %a.maruku-ref{:href => "#CategoryOfPresheaves"}
          %p
            At the same time,
            %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
            witnesses the utility of abstracting away from concrete choices to their abstract properties that are actually used in constructions. This makes it natural to ask if one could replace the category
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            by some other category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒱
                %annotation{:encoding => "application/x-tex"} \mathcal{V}
            which could similarly serve as a “
            %a.existingWikiWord{:href => "/nlab/show/cosmos"}> cosmos
            ” inside which category theory may be developed.
          %p
            Indeed, such
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒱
                  %annotation{:encoding => "application/x-tex"} \mathcal{V}
            %a.existingWikiWord{:href => "/nlab/show/enriched+category+theory"} enriched category theory
            (see Example
            %a.maruku-ref{:href => "#UnderlyingCategoryOfTopEnrichedCategory"}
            below for the terminology) exists, beginning with the concept of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒱
                  %annotation{:encoding => "application/x-tex"} \mathcal{V}
            %a.existingWikiWord{:href => "/nlab/show/enriched+categories"} enriched categories
            (Def.
            %a.maruku-ref{:href => "#TopEnrichedCategory"}
            below) and from there directly paralleling, hence generalizing, plain category theory, as long as one assumes the “cosmos” category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒱
                %annotation{:encoding => "application/x-tex"} \mathcal{V}
            to share a minimum of abstract properties with
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            (Def.
            %a.maruku-ref{:href => "#Cosmos"}
            below).
          %p
            This turns out to be most useful. In fact, the perspective of
            %a.existingWikiWord{:href => "/nlab/show/enriched+categories"} enriched categories
            is helpful already when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒱
                  %mo =
                %annotation{:encoding => "application/x-tex"} \mathcal{V} =
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            %a.maruku-ref{:href => "#SetEnrichedCategoriesArePlainCategories"}
            below), for instance in that it puts the
            %a.existingWikiWord{:href => "/nlab/show/limit"} (co)limits
            of the special form of
            %a.existingWikiWord{:href => "/nlab/show/end"} (co)ends
            (Def.
            %a.maruku-ref{:href => "#EndAndCoendInTopcgSmash"}
            below) to the forefront (discussed
            = succeed ")." do
              %a{:href => "#TopologicalEndsAndCoends"} below
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          #Cosmos.num_defn
            %h6#definition_11 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/cosmos"}> cosmos
                )
            %p
              A
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Jean+Benabou"} Bénabou
                  %a.existingWikiWord{:href => "/nlab/show/cosmos"} cosmos
