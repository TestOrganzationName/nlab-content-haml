                              %mphantom
                                %mi AAA
                              %munder
                                %mo ⟶
                                %mrow
                              %mover
                                %mo ⟶
                                %mrow
                          %mtd
                            %mi E
                            %mo ⊗
                            %mi E
                          %mtd
                            %mover
                              %mo ⟶
                              %mi coeq
                          %mtd
                            %mi E
                            %msub
                              %mo ⊗
                              %mi A
                            %mi E
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi μ
                                    %mi E
                            %mo ↘
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi μ
                                    %mrow
                                      %mi E
                                      %mo{:stretchy => "false"} /
                                      %mi A
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi E
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    E \otimes A \otimes E
                    \&amp;
                    \\underoverset
                    {\underset{}{\longrightarrow}}
                    {\overset{}{\longrightarrow}}
                    {\phantom{AAA}}
                    \&amp;
                    E \otimes E
                    \&amp;\overset{coeq}{\longrightarrow}&amp;
                    E \otimes_A E
                    \\\
                    \&amp;&amp; &amp; {}_{\mathllap{\mu_E}}\searrow &amp; \downarrow^{\mathrlap{\mu_{E/A}}}
                    \\\
                    \&amp;&amp; &amp;&amp; E
                    }
                    \\,.
            %p
              By considering a diagram of such coequalizer diagrams with middle vertical morphism
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi e
                        %mi E
                      %mo ∘
                      %msub
                        %mi e
                        %mi A
                    %annotation{:encoding => "application/x-tex"} e_E\circ e_A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mi E
                  %annotation{:encoding => "application/x-tex"} \mu_E
              and that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
