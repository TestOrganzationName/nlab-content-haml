                    %mo ⊗
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{C},\otimes, 1)
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#MonoidalCategory"}
              %a.existingWikiWord{:href => "/nlab/show/tensor+unit"} tensor unit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
              regarded as a
              %a.existingWikiWord{:href => "/nlab/show/monoid+in+a+monoidal+category"} monoid in a monoidal category
              via example
              = succeed "," do
                %a.maruku-ref{:href => "#MonoidGivenByTensorUnit"}
              %a.existingWikiWord{:href => "/nlab/show/unitor"} unitor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
