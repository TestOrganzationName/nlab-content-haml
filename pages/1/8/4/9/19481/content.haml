                    %annotation{:encoding => "application/x-tex"} A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo ⋆
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                            %mo ⊗
                            %mi A
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mi id
                                %mo ⊗
                                %msub
                                  %mi e
                                  %mi E
                          %mtd
                            %mi A
                            %mo ⊗
                            %mi E
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi μ
                                    %mi A
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi ρ
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi e
                                  %mi E
                          %mtd
                            %mi E
                  %annotation{:encoding => "application/x-tex"}
                    (\star)
                    \\;\;\;\;\;
                    \\;\;\;\;\;
                    \\array{
                    A \otimes A &amp;\overset{id \otimes e_E}{\longrightarrow}&amp; A \otimes E
                    \\\
                    {}^{\mathllap{\mu_A}}\downarrow &amp;&amp; \downarrow^{\mathrlap{\rho}}
                    \\\
                    A &amp;\underset{e_E}{\longrightarrow}&amp; E
                    }
            %p
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"}> commutes
              \. Moreover it satisfies the unit property
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                            %msub
                              %mo ⊗
                              %mi A
                            %mi E
                          %mtd
