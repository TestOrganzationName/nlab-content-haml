                    \\end{aligned}
            %p
              Hence this fixes the component
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi f
                        %mo ˜
                      %mi c
                    %mo{:stretchy => "false"} (
                    %mi a
