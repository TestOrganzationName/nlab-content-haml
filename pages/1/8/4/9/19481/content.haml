              %a.existingWikiWord{:href => "/nlab/show/preserved+limit"} preserves
              %a.existingWikiWord{:href => "/nlab/show/limits"} limits
              in the second variable, and sends
              %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
              in the first variable to limits:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
