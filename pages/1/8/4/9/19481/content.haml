                    \\,.
            %p Consider the composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ˜
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi C
                    %munderover
                      %mo ⟶
                      %mo ≃
                      %mrow
                        %msub
                          %mi ℓ
                          %mi C
                    %mn 1
                    %mo ⊗
                    %mi C
                    %mover
                      %mo ⟶
                      %mrow
                        %mi e
                        %mo ⊗
                        %mi id
                    %mi A
                    %mo ⊗
                    %mi C
