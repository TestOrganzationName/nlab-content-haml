              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} A Mod
              and the
              %a.existingWikiWord{:href => "/nlab/show/coslice+category"} coslice category
              of commutative monoids in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
