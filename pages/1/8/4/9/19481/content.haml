                                %mi F
                                %mo{:stretchy => "false"} (
                                %mi z
                                %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                                %msup
                                  %mrow
                                  %mpadded{:lspace => "-100%width", :width => "0"}
                                    %mrow
                                      %msub
