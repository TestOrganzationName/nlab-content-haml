                                %mo{:stretchy => "false"} )
                              %mtd
                              %mtd
                                %mi F
                                %mo{:stretchy => "false"} (
                                %mi x
                                %mo{:stretchy => "false"} )
                                %msub
                                  %mo ⊗
                                  %mi 𝒟
                                %mo{:stretchy => "false"} (
                                %mi F
                                %mo{:stretchy => "false"} (
                                %mi x
                                %msub
                                  %mo ⊗
                                  %mi 𝒞
                                %mi y
                                %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} )
                            %mtr
