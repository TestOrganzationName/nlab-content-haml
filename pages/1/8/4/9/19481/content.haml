          #TopEnrichedCategory.num_defn
            %h6#definition_12 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/enriched+category"}> enriched category
                )
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒱
                  %annotation{:encoding => "application/x-tex"} \mathcal{V}
              a
              %a.existingWikiWord{:href => "/nlab/show/cosmos"} cosmos
              (Def.
              = succeed ")," do
                %a.maruku-ref{:href => "#Cosmos"}
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi 𝒱
                    %annotation{:encoding => "application/x-tex"} \mathcal{V}
                \-
                %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is:
            %ol
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/class"} class
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi Obj
                            %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} Obj_{\mathcal{C}}
                  = succeed ";" do
                    %strong
                      class of
                      %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              %li
                %p
                  for each
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi a
                          %mo ,
                          %mi b
                          %mo ∈
                          %msub
                            %mi Obj
                            %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} a, b\in Obj_{\mathcal{C}}
                  %a.existingWikiWord{:href => "/nlab/show/object"} object
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo ,
                        %mi b
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %mi 𝒱
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        \\mathcal{C}(a,b)\in \mathcal{V}
                        \\,,
                %p
                  called the
                  %strong
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi 𝒱
                        %annotation{:encoding => "application/x-tex"} \mathcal{V}
                    \-
                    %a.existingWikiWord{:href => "/nlab/show/object+of+morphisms"} object of morphisms
                  between
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                      %annotation{:encoding => "application/x-tex"} a
                  and
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi b
                        %annotation{:encoding => "application/x-tex"} b
              %li
                %p
                  for each
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo ,
                        %mi b
                        %mo ,
                        %mi c
                        %mo ∈
                        %mi Obj
                        %mo{:stretchy => "false"} (
                        %mi 𝒞
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} a,b,c\in Obj(\mathcal{C})
                  a
                  %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒱
                      %annotation{:encoding => "application/x-tex"} \mathcal{V}
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mo ∘
                          %mrow
                            %mi a
                            %mo ,
                            %mi b
                            %mo ,
                            %mi c
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi 𝒞
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo ,
                        %mi b
                        %mo{:stretchy => "false"} )
                        %mo ×
                        %mi 𝒞
                        %mo{:stretchy => "false"} (
                        %mi b
                        %mo ,
                        %mi c
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %mi 𝒞
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo ,
                        %mi c
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\circ_{a,b,c}
                        \\;\colon\;
                        \\mathcal{C}(a,b)\times \mathcal{C}(b,c)
                        \\longrightarrow
                        \\mathcal{C}(a,c)
                %p
                  out of the
                  %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
                  of
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/hom-objects"} hom-objects
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/composition"} composition
                  operation;
              %li
                %p
                  for each
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo ∈
                        %mi Obj
                        %mo{:stretchy => "false"} (
                        %mi 𝒞
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} a \in Obj(\mathcal{C})
                  a morphism
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi Id
                            %mi a
                          %mo{:lspace => "verythinmathspace"} :
                          %mo *
                          %mo →
                          %mi 𝒞
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo ,
                          %mi a
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} Id_a \colon \ast \to  \mathcal{C}(a,a)
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/identity"} identity
                  morphism on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                      %annotation{:encoding => "application/x-tex"} a
            %p
              such that the composition is
              %a.existingWikiWord{:href => "/nlab/show/associativity"} associative
              and
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/unitality"} unital
            %p
              If the
              %a.existingWikiWord{:href => "/nlab/show/class"} class
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Obj
                      %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} Obj_{\mathcal{C}}
              happens to be a
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              (hence a
              %a.existingWikiWord{:href => "/nlab/show/small+set"} small set
              instead of a
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/proper+class"} proper class
              = succeed "-enriched" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒱
                    %annotation{:encoding => "application/x-tex"} \mathcal{V}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/small+category"} small
              = succeed "." do
                %a.maruku-ref{:href => "#SmallCategory"}
          #SetEnrichedCategoriesArePlainCategories.num_example
            %h6#example_15 Example
            %p
