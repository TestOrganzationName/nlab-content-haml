                                %mo{:stretchy => "false"} )
                                %msub
                                  %mo{:stretchy => "false"} )
                                  %mi d
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi Y
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo{:stretchy => "false"} )
                    %mphantom
                      %mi AAAA
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} {
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi id
                              %mi c
                            %mo ,
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} }
                          %mtd
                            %mo ⟶
                          %mtd
                            %mo{:stretchy => "false"} {
                            %msub
                              %mi f
                              %mi c
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ,
                            %mi a
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} }
                        %mtr
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                          %mtd
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} {
                            %mo{:stretchy => "false"} (
                            %mi g
                            %mo ,
