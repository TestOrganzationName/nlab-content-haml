                        %mn 2
                      %mo{:stretchy => "false"} (
                      %mi 𝒯
                      %mo ,
                      %mi can
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \hat Sh_{2}(\mathcal{T}, can)
          .num_defn
            %h6#definition_4 Definition
            %p
              An
              %strong internal presheaf
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
              (internal to
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒯
                    %annotation{:encoding => "application/x-tex"} \mathcal{T}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %msup
                      %mover
                        %mi ℂ
                        %mo{:stretchy => "false"} ¯
                      %mi op
                    %mo →
                    %mover
                      %mi 𝒮
                      %mo{:stretchy => "false"} ¯
                  %annotation{:encoding => "application/x-tex"}
                    F : \bar \mathbb{C}^{op} \to \bar \mathcal{S}
            %p
              of
              %a.existingWikiWord{:href => "/nlab/show/2-sheaves"} 2-sheaves
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒮
                    %annotation{:encoding => "application/x-tex"} \mathcal{S}
              = succeed "\u201D" do
                %a.existingWikiWord{:href => "/nlab/show/indexed+functor"} indexed functor
              = succeed "\u201C.)" do
                %a.existingWikiWord{:href => "/nlab/show/indexed+categories"} indexed categories
            %p
              Suppose moreover that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
              is equipped with the structure of an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/internal+site"} internal site
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              above is an
              %strong internal sheaf
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
              if it satisfies the evident
              %a.existingWikiWord{:href => "/nlab/show/descent"} descent
              condition.
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              of internal presheaves is simply a
              %a.existingWikiWord{:href => "/nlab/show/2-morphism"} 2-morphism
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi Sh
                        %mo{:stretchy => "false"} ^
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi 𝒮
                    %mo ,
                    %mi can
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \hat Sh_2(\mathcal{S}, can)
              (also called an “
              %a.existingWikiWord{:href => "/nlab/show/indexed+functor"}> indexed natural transformation
              ”). This yields a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    PSh(\mathbb{C})
            %p
              of internal presheaves. Accordingly we have the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %mo ,
                    %mi 𝒮
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %mo ,
                    %mi 𝒮
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Sh(\mathbb{C}, \mathcal{S})
                    \\hookrightarrow PSh(\mathbb{C}, \mathcal{S})
            %p of internal sheaves.
          %h3#ExplicitDefinition Explicit definition
          %p We unwind what the above amounts to more explicitly.
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi ℂ
                  %mo ,
                  %mi J
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathbb{C},J)
            be an
            %a.existingWikiWord{:href => "/nlab/show/internal+site"} internal site
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}
            %a.existingWikiWord{:href => "/nlab/show/internal+category"} internal category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} \mathbb{C}
            equipped with an internal
            %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝒮
                    %mrow
                      %msup
                        %mi ℂ
                        %mi op
                %annotation{:encoding => "application/x-tex"} \mathcal{S}^{\mathbb{C}^{op}}
            be the topos of
            %a.existingWikiWord{:href => "/nlab/show/internal+diagram"} internal diagrams
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℂ
                      %mi op
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}^{op}
          .num_defn
            %h6#definition_5 Definition
            %ol
              %li
                %p
                  An
                  %strong internal presheaf
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℂ
                      %annotation{:encoding => "application/x-tex"} \mathbb{C}
                  is an internal diagram
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi F
                          %mo ∈
                          %msup
                            %mi 𝒮
                            %mrow
                              %msup
                                %mi ℂ
                                %mi op
                        %annotation{:encoding => "application/x-tex"} F \in \mathcal{S}^{\mathbb{C}^{op}}
              %li
                %p
                  An
                  %strong internal sheaf
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℂ
                      %annotation{:encoding => "application/x-tex"} \mathbb{C}
                  (with respect to
                  = succeed ")" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi J
                        %annotation{:encoding => "application/x-tex"} J
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℂ
                      %annotation{:encoding => "application/x-tex"} \mathbb{C}
                  satisfying one of the following equivalent conditions:
                %ol
                  %li
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi F
                        %annotation{:encoding => "application/x-tex"} F
                    satisfies the
                    %a{:href => "/nlab/show/sheaf#GeneralComponentwiseDefinition"} usual sheaf condition
                    interpreted in the
                    %a.existingWikiWord{:href => "/nlab/show/internal+language"} internal language
                    of
                    = succeed "." do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝒮
                          %annotation{:encoding => "application/x-tex"} \mathcal{S}
                  %li
