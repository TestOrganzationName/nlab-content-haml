          %h2#idea Idea
          %p
            The notions of
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
            %em
              %a.existingWikiWord{:href => "/nlab/show/site"} site
            and
            %em
              %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
            can be formulated
            %a.existingWikiWord{:href => "/nlab/show/internalization"} internal
            to any
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
          %p
            More precisely, the direct internalization of these notions is into the
            %a.existingWikiWord{:href => "/nlab/show/universe+enlargement"} very large
            %a.existingWikiWord{:href => "/nlab/show/2-topos"} 2-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mover
                      %mi Sh
                      %mo{:stretchy => "false"} ^
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi 𝒮
                  %mo ,
                  %mi can
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \hat Sh_2(\mathcal{S},can)
            of the given ambient topos
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}
            = succeed "-valued" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒮
                %annotation{:encoding => "application/x-tex"} \mathcal{S}
            does not quite sit inside itself. It does, however, sit inside
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi Sh
                        %mo{:stretchy => "false"} ^
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi 𝒮
                    %mo ,
                    %mi can
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \hat Sh_2(\mathcal{S},can)
            %a.existingWikiWord{:href => "/nlab/show/2-sheaf"} 2-sheaf
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi 𝒮
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} \bar \mathcal{S}
            corresponding to its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/codomain+fibration"} codomain fibration
          %p
            Therefore, regarding
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mover
                      %mi Sh
