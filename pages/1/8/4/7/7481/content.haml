          %h2#properties Properties
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒮
                %annotation{:encoding => "application/x-tex"} \mathcal{S}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} \mathbb{C}
            be as above.
          .num_prop
            %h6#proposition Proposition
            %p
              The category of internal presheaves
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %mo ,
                    %mi 𝒮
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PSh(\mathbb{C}, \mathcal{S})
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topos"} topos
          %p
            This appears as (
            %a{:href => "#Johnstone"}> Johnstone, cor. B.2.3.17
            ).
          .num_prop
            %h6#proposition_2 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi ℂ
                    %mo →
                    %mi 𝔻
                  %annotation{:encoding => "application/x-tex"} f : \mathbb{C} \to \mathbb{D}
              be an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/internal+functor"} internal functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ¯
                    %mo :
                    %mover
                      %mi ℂ
                      %mo{:stretchy => "false"} ¯
                    %mo →
                    %mover
                      %mi 𝔻
                      %mo{:stretchy => "false"} ¯
                  %annotation{:encoding => "application/x-tex"} \bar f : \bar \mathbb{C} \to \bar \mathbb{D}
              for the corresponding morphism in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mover
                          %mi Sh
                          %mo{:stretchy => "false"} ^
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %mi 𝒮
                      %mo ,
                      %mi can
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \hat Sh_2(\mathcal{S}, can)
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              of internal presheaf catgeories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mo{:lspace => "verythinmathspace"} :
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi 𝔻
                    %mo ,
                    %mi 𝒮
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %mo ,
                    %mi 𝒮
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f^* \colon PSh(\mathbb{D}, \mathcal{S})
                    \\to
                    PSh(\mathbb{C}, \mathcal{S})
                    \\,.
            %p
              This is the
              %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
              of a
              %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
              of
              %a.existingWikiWord{:href => "/nlab/show/toposes"} toposes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %mo ,
                    %mi 𝒮
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi 𝔻
                    %mo ,
                    %mi 𝒮
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f \colon PSh(\mathbb{C}, \mathcal{S})
                    \\to
                    PSh(\mathbb{D}, \mathcal{S})
                    \\,.
          %p
            This appears as (
            %a{:href => "#Johnstone"}> Johnstone, cor. B.2.3.22
            ).
          %p
            The global section functors of internal sheaf toposes in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒮
                %annotation{:encoding => "application/x-tex"} \mathcal{S}
            are
            %a.existingWikiWord{:href => "/nlab/show/bounded+geometric+morphisms"} bounded geometric morphisms
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}
          %h2#related_concepts Related concepts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/internal+diagram"} internal diagram
          %h2#references References
          %p
            On internal presheaves in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/elementary+toposes"} elementary toposes
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Marta+Bunge"}> Marta Bunge
              ,
              = succeed "," do
                %em Internal Presheaf Toposes
              %span.newWikiWord
                Cahiers,Cahiers de topologie et géométrie différentielle catégoriques
                %a{:href => "/nlab/new/Cahiers%2CCahiers+de+topologie+et+g%C3%A9om%C3%A9trie+diff%C3%A9rentielle+cat%C3%A9goriques"} ?
              %strong 18
              3 (1977) 291-330 &amp;lbrack;
              %a{:href => "http://www.numdam.org/item/?id=CTGDC_1977__18_3_291_0"}> numdam:CTGDC_1977__18_3_291_0
              \&amp;rbrack;
          %p
            On internal presheaves in a
            = succeed ":" do
