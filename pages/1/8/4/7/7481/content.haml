                      %mo{:stretchy => "false"} ¯
                  %annotation{:encoding => "application/x-tex"} \bar \mathbb{C}
              for the
              %a.existingWikiWord{:href => "/nlab/show/2-sheaf"} 2-sheaf
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
