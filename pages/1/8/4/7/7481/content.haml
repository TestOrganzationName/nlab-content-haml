                          %mrow
                            %mi j
                          %annotation{:encoding => "application/x-tex"} j
                    %a.existingWikiWord{:href => "/nlab/show/Lawvere-Tierney+topology"} Lawvere-Tierney topology
                    on
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi 𝒮
                            %mrow
                              %msup
                                %mi ℂ
                                %mi op
                        %annotation{:encoding => "application/x-tex"} \mathcal{S}^{\mathbb{C}^{op}}
                    induced by
