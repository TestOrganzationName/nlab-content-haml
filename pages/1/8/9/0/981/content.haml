                %annotation{:encoding => "application/x-tex"} \sigma_j
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi τ
                    %mi n
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo =
                  %mi{:mathvariant => "normal"} id
                %annotation{:encoding => "application/x-tex"} \tau^{n+1}_n = \mathrm{id}
            there are the following identities:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mi τ
                            %mi n
                          %msub
                            %mi δ
                            %mi i
                          %mo =
                          %msub
                            %mi δ
                            %mrow
                              %mi i
                              %mo −
                              %mn 1
                          %msub
                            %mi τ
                            %mrow
                              %mi n
                              %mo −
                              %mn 1
                          %mo ,
                          %mspace{:width => "thinmathspace"}
                          %mspace{:width => "thinmathspace"}
                          %mn 1
                          %mo ≤
                          %mi i
                          %mo ≤
                          %mi n
                      %mtr
                        %mtd
                          %msub
                            %mi τ
                            %mi n
                          %msub
                            %mi δ
                            %mn 0
                          %mo =
                          %msub
                            %mi δ
                            %mi n
                      %mtr
                        %mtd
                          %msub
                            %mi τ
                            %mi n
                          %msub
                            %mi σ
                            %mi i
                          %mo =
                          %msub
                            %mi σ
                            %mrow
                              %mi i
                              %mo −
                              %mn 1
                          %msub
                            %mi τ
                            %mrow
                              %mi n
                              %mo −
                              %mn 1
                          %mo ,
                          %mspace{:width => "thinmathspace"}
                          %mspace{:width => "thinmathspace"}
                          %mn 1
                          %mo ≤
                          %mi i
                          %mo ≤
                          %mi n
                      %mtr
                        %mtd
                          %msub
                            %mi τ
                            %mi m
                          %msub
                            %mi σ
                            %mn 0
                          %mo =
                          %msub
                            %mi σ
                            %mi n
                          %msubsup
                            %mi τ
                            %mrow
                              %mi n
                              %mo +
                              %mn 1
                            %mn 2
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\tau_n\delta_i = \delta_{i-1}\tau_{n-1},\,\, 1\leq i \leq n\\
                  \\tau_n\delta_0 = \delta_n\\
                  \\tau_n\sigma_i = \sigma_{i-1}\tau_{n-1},\,\, 1\leq i \leq n\\
                  \\tau_m\sigma_0 = \sigma_n\tau_{n+1}^2
                  }
          %h2#properties Properties
          %h3#general General
          %p
            We reiterate the development in the
            %a{:href => "#structure"} section on structure
            in summary form:
          .num_theorem
            %h6#theorem Theorem
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} Aut
                          %mi Λ
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mstyle{:mathvariant => "bold"}
                          %mi Z
                        %mo{:stretchy => "false"} /
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo +
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mstyle{:mathvariant => "bold"}
                          %mi Z
                      %annotation{:encoding => "application/x-tex"} \Aut_\Lambda([n]) = \mathbf{Z}/(n+1)\mathbf{Z}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Λ
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} ]
                        %mo ,
                        %mo{:stretchy => "false"} [
                        %mi m
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi Δ
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} ]
                        %mo ,
                        %mo{:stretchy => "false"} [
                        %mi m
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} )
                        %mo ×
                        %mstyle{:mathvariant => "bold"}
                          %mi Z
                        %mo{:stretchy => "false"} /
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo +
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mstyle{:mathvariant => "bold"}
                          %mi Z
                      %annotation{:encoding => "application/x-tex"} \Lambda([n],[m]) = \Delta([n],[m])\times \mathbf{Z}/(n+1)\mathbf{Z}
                  (as a set)
              %li
                %p
                  Any morphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Λ
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} ]
                        %mo ,
                        %mo{:stretchy => "false"} [
                        %mi m
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \Lambda([n],[m])
                  can be uniquely written as a composition
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo =
                        %mi ϕ
                        %mo ∘
                        %mi g
                      %annotation{:encoding => "application/x-tex"} f = \phi\circ g
                  where
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                        %mo ∈
                        %mi Δ
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} ]
                        %mo ,
                        %mo{:stretchy => "false"} [
                        %mi m
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \phi\in\Delta([n],[m])
                  and
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi g
                          %mo ∈
                          %msub
                            %mo{:lspace => "0em", :rspace => "thinmathspace"} Aut
                            %mi Λ
                          %mo{:stretchy => "false"} (
                          %mo{:stretchy => "false"} [
                          %mi n
                          %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} g\in\Aut_\Lambda([n])
          %p
            The generalizations of this theorem are the starting point of the theory of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/skew-simplicial+set"} skew-simplicial set
          %p
            The cyclic category is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/generalized+Reedy+category"} generalized Reedy category
            = succeed "." do
              %a{:href => "http://arxiv.org/abs/0809.3341"} here
          %h3#generalized_reedy_model_structure Generalized Reedy model structure
          %p
            The cycle category is a
            %a.existingWikiWord{:href => "/nlab/show/generalized+Reedy+category"} generalized Reedy category
            (see
            = succeed ")." do
              %a{:href => "#BM08"} Berger-Moerdijk 08, example 2.7
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/generalized+Reedy+model+structure"} generalized Reedy model structure
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/minimal+simplicial+circle"} minimal simplicial circle
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/cyclic+object"} cyclic object
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/cyclic+set"}> cyclic set
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/cyclic+space"} cyclic space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/cyclotomic+space"}> cyclotomic space
                ,
                %a.existingWikiWord{:href => "/nlab/show/cyclotomic+spectrum"} cyclotomic spectrum
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/cyclic+homology"} cyclic homology
          %h2#references References
          %p The original definition:
          %ul
            %li#Connes83
              %p
                %a.existingWikiWord{:href => "/nlab/show/Alain+Connes"}> Alain Connes
                ,
                = succeed "," do
                  %em
                    Cohomologie cyclique et foncteurs
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi Ext
                            %mi n
                        %annotation{:encoding => "application/x-tex"} Ext^n
                %strong 296
                (1983), Série I, 953-958 (
                %a{:href => "https://alainconnes.org/wp-content/uploads/n83.pdf"}> pdf
                ,
                = succeed ")." do
                  %a.existingWikiWord{:href => "/nlab/files/Connes_CohomologieCyclique.pdf", :title => "pdf"} pdf
            %li#Cartier85
              %p
                %a.existingWikiWord{:href => "/nlab/show/Pierre+Cartier"}> Pierre Cartier
                , Section 1.6 of:
                = succeed "," do
                  %em Homologie cyclique : rapport sur des travaux récents de Connes, Karoubi, Loday, Quillen…
                = succeed ")" do
                  %a{:href => "http://www.numdam.org/item/?id=SB_1983-1984__26__123_0"} numdam:SB_1983-1984__26__123_0
          %p Exposition:
          %ul
            %li#Malkiewich15
              %a.existingWikiWord{:href => "/nlab/show/Cary+Malkiewich"}> Cary Malkiewich
              ,
              = succeed "," do
                %em A visual introduction to cyclic sets and cyclotomic spectra
              = succeed ")" do
                %a{:href => "https://people.math.binghamton.edu/malkiewich/ytm_2015.pdf"} pdf
          %p Textbook account:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jean-Louis+Loday"}> Jean-Louis Loday
                ,
                %em The Cyclic Category, Tor and Ext Interpretation
                (
                %a{:href => "https://doi.org/10.1007/978-3-662-21739-9_6"}> doi:10.1007/978-3-662-21739-9_6
                ) and
                %em
                  Cyclic Spaces and
                  = succeed "-Equivariant" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi S
                            %mn 1
                        %annotation{:encoding => "application/x-tex"} S^1
                (
                %a{:href => "https://link.springer.com/chapter/10.1007/978-3-662-21739-9_7"}> doi:10.1007/978-3-662-21739-9_7
                )
              %p
