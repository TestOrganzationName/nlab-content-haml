                            %mo{:stretchy => "false"} )
                            %mo +
                            %mi n
                            %mo +
                            %mn 1
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mi iff
                          %mtd
                            %msup
                              %mi f
                              %mo *
                            %mo{:stretchy => "false"} (
                            %mi j
                            %mo +
                            %mi n
                            %mo +
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mo ≤
                            %msup
                              %mi f
                              %mo *
                            %mo{:stretchy => "false"} (
                            %mi j
                            %mo +
                            %mi n
                            %mo +
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    f^\ast(j)+m+1 \leq f^\ast(j+n+1) &amp; iff &amp; f^\ast(j) \leq f^\ast(j+n+1)-m-1 \\
                    \&amp; iff &amp; j \leq f(f^\ast(j+n+1)-m-1) \\
                    \&amp; iff &amp; j \leq f(f^\ast(j+n+1))-n-1 \\
                    \&amp; iff &amp; j + n + 1\leq f(f^\ast(j) + n + 1) \\
                    \&amp; iff &amp; f^\ast(j+n+1) \leq f^\ast(j+n+1).
                    }
            %p
              Also, since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo ,
                    %mo ≤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathbb{Z}, \leq)
              as a category is self-dual, every morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              dually has a right adjoint that is a morphism of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                    %annotation{:encoding => "application/x-tex"} L
          .num_cor
            %h6#corollary Corollary
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              is a self-dual category.
          .proof
            %h6#proof_2 Proof
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} duality
              functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi L
                      %mi op
                    %mo →
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L^{op} \to L
              is the identity on objects and takes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi m
                    %mo →
                    %mi n
                  %annotation{:encoding => "application/x-tex"} f: m \to n
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mo *
                      %mo :
                      %mi n
                      %mo →
                      %mi m
                    %annotation{:encoding => "application/x-tex"} f^\ast: n \to m
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mi g
                  %annotation{:encoding => "application/x-tex"} f g
              is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi g
                        %mo *
                      %msup
                        %mi f
                        %mo *
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mi g
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                    %annotation{:encoding => "application/x-tex"} g^\ast f^\ast = (f g)^\ast
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ↦
                      %msub
                        %mi f
                        %mo *
                    %annotation{:encoding => "application/x-tex"} f \mapsto f_\ast
          .num_prop
            %h6#proposition_2 Proposition
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Λ
                  %annotation{:encoding => "application/x-tex"} \Lambda
              is a self-dual category.
          .proof
            %h6#proof_3 Proof
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∼
                    %mi g
                  %annotation{:encoding => "application/x-tex"} f \sim g
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mo{:stretchy => "false"} (
                      %mi m
                      %mo ,
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} L(m, n)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo =
                    %msup
                      %mi τ
                      %mrow
                        %mi k
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo +
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo ∘
                    %mi g
                  %annotation{:encoding => "application/x-tex"} f = \tau^{k (n+1)} \circ g
              for some
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ∈
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} k \in \mathbb{Z}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi τ
                        %mo *
                      %mo =
                      %msup
                        %mi τ
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} \tau^\ast = \tau^{-1}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mo =
                    %msup
                      %mi g
                      %mo *
                    %mo ∘
                    %msup
                      %mi τ
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi k
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo +
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi τ
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi k
                        %mo{:stretchy => "false"} (
                        %mi m
                        %mo +
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo ∘
                    %msup
                      %mi g
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^\ast = g^\ast \circ \tau^{-k(n+1)} = \tau^{-k(m+1)} \circ g^\ast
              where the last equation holds because
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi g
                      %mo *
                    %mo :
                    %mi n
                    %mo →
                    %mi m
                  %annotation{:encoding => "application/x-tex"} g^\ast: n \to m
              is spiraling. This shows
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mo *
                      %mo ∼
                      %msup
                        %mi g
                        %mo *
                    %annotation{:encoding => "application/x-tex"} f^\ast \sim g^\ast
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              descends to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Λ
                    %annotation{:encoding => "application/x-tex"} \Lambda
          .num_prop
            %h6#proposition_3 Proposition
            %p
              For a morphism
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ∈
                      %mi L
                      %mo{:stretchy => "false"} (
                      %mi m
                      %mo ,
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f \in L(m, n)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ≤
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} f^\ast(0) \leq 0
              iff
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo ≤
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} 0 \leq f(0)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo ≤
                    %msup
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} 0 \leq f^\ast(0)
              iff
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi m
                      %mo{:stretchy => "false"} )
                      %mo ≤
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f(m) \leq f(n)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} f^\ast(0) = 0
              iff (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo ≤
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} 0 \leq f(0)
              and
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi m
                      %mo{:stretchy => "false"} )
                      %mo ≤
                      %mi n
                    %annotation{:encoding => "application/x-tex"} f(m) \leq n
          .proof
            %h6#proof_4 Proof
            %p
              The first assertion is immediate from the adjunction
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mo *
                      %mo ⊣
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f^\ast \dashv f
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mn 0
                            %mo ≤
                            %msup
                              %mi f
                              %mo *
                            %mo{:stretchy => "false"} (
                            %mn 0
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mi iff
                          %mtd
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                            %mo &lt;
                            %msup
                              %mi f
                              %mo *
                            %mo{:stretchy => "false"} (
                            %mn 0
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mi iff
                          %mtd
                            %mo ¬
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi f
                              %mo *
                            %mo{:stretchy => "false"} (
                            %mn 0
                            %mo{:stretchy => "false"} )
                            %mo ≤
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mi iff
                          %mtd
                            %mo ¬
                            %mo{:stretchy => "false"} (
                            %mn 0
                            %mo ≤
                            %mi f
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mi iff
                          %mtd
                            %mi f
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mo &lt;
                            %mn 0
                        %mtr
                          %mtd
                          %mtd
                            %mi iff
                          %mtd
                            %mi f
                            %mo{:stretchy => "false"} (
                            %mi m
                            %mo{:stretchy => "false"} )
                            %mo &lt;
                            %mi n
                            %mo +
                            %mn 1
                        %mtr
                          %mtd
                          %mtd
                            %mi iff
                          %mtd
                            %mi f
                            %mo{:stretchy => "false"} (
                            %mi m
                            %mo{:stretchy => "false"} )
                            %mo ≤
                            %mi n
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    0 \leq f^\ast(0) &amp; iff &amp; -1 \lt f^\ast(0) \\
                    \&amp; iff &amp; \neg (f^\ast(0) \leq -1) \\
                    \&amp; iff &amp; \neg (0 \leq f(-1)) \\
                    \&amp; iff &amp; f(-1) \lt 0 \\
                    \&amp; iff &amp; f(m) \lt n+1 \\
                    \&amp; iff &amp; f(m) \leq n
                    }
            %p where the step to the penultimate line used the spiraling property.
          %p
            The previous proposition, in conjunction with the self-duality of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            and Remark
            = succeed "," do
              %a.maruku-ref{:href => "#simplex"}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Δ
                    %mi op
                %annotation{:encoding => "application/x-tex"} \Delta^{op}
            faithfully maps to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Δ
                      %mi op
                    %mo{:stretchy => "false"} (
                    %mi m
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mo{:stretchy => "false"} {
                    %mi f
                    %mo ∈
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi m
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \Delta^{op}(m, n) \cong \{f \in L(m, n): f(0) = 0\}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo :
                    %mi L
                    %mo →
                    %mi Λ
                  %annotation{:encoding => "application/x-tex"} q: L \to \Lambda
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Δ
                    %mi op
                %annotation{:encoding => "application/x-tex"} \Delta^{op}
            as sitting inside
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Λ
                  %annotation{:encoding => "application/x-tex"} \Lambda
          #unique1.num_prop
            %h6#proposition_4 Proposition
            %p
              Every morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi m
                    %mo →
                    %mi n
                  %annotation{:encoding => "application/x-tex"} f: m \to n
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Λ
                  %annotation{:encoding => "application/x-tex"} \Lambda
              may be uniquely decomposed as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo =
                    %msubsup
                      %mi τ
                      %mi n
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                    %mi g
                  %annotation{:encoding => "application/x-tex"} f = \tau_n^{f(0)} g
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              belongs to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Δ
                        %mi op
                      %mo{:stretchy => "false"} (
                      %mi m
                      %mo ,
                      %mi n
                      %mo{:stretchy => "false"} )
                      %mo ⊂
                      %mi L
                      %mo{:stretchy => "false"} (
                      %mi m
                      %mo ,
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Delta^{op}(m, n) \subset L(m, n)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(0)
              is considered modulo
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n+1
          #action.num_prop
            %h6#proposition_5 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/cyclic+group"} cyclic group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mi m
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/(m+1)
              %a.existingWikiWord{:href => "/nlab/show/group+action"} acts
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Δ
                      %mi op
                    %mo{:stretchy => "false"} (
                    %mi m
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Delta^{op}(m, n)
              via the following formula for
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ∈
                      %mi L
                      %mo{:stretchy => "false"} (
                      %mi m
