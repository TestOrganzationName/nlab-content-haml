            %li
              %p
                R. Krasauskas,
                = succeed "," do
                  %em Skew-simplicial groups
                %strong 27
                (1987), no. 1, 89–99,
                %a{:href => "http://www.ams.org/mathscinet-getitem?mr=88m:18022"} MR88m:18022
                (English transl.
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/files/krasauskas.pdf", :title => "R. Krasauskas, Skew-simplicial groups, Lith. Math. J. "} R. Krasauskas, Skew-simplicial groups, Lith. Math. J.
            %li
