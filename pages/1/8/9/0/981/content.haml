                = succeed "," do
                  %em Cyclic Homology
                = succeed "," do
                  %strong 301
                = succeed ")" do
                  %a{:href => "https://link.springer.com/book/10.1007/978-3-662-21739-9"} doi:10.1007/978-3-662-21739-9
          %p See also:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/V.+Drinfeld"}> V. Drinfeld
                ,
                = succeed "," do
