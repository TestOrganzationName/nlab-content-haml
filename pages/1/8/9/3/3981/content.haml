          %p
            The coequaliser of this diagram is
            %math#mathml_aa4aa9075830b6d749d1c29a560732ae809d1b7b_43.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                  %mo ∪
                  %mo{:stretchy => "false"} {
                  %mo *
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \mathbb{R} \cup \{*\}
            where the
            %math#mathml_aa4aa9075830b6d749d1c29a560732ae809d1b7b_44.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                %annotation{:encoding => "application/x-tex"} *
            is a doubled-point at
            = succeed "." do
              %math#mathml_aa4aa9075830b6d749d1c29a560732ae809d1b7b_45.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
            %math#mathml_aa4aa9075830b6d749d1c29a560732ae809d1b7b_46.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
