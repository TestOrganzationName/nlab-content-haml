              %line#svg_83382_14{:fill => "none", "marker-end" => "url(#se_arrow_83382_fw2)", :stroke => "#000093", "stroke-width" => "2", :x1 => "421.5", :x2 => "218.5", :y1 => "74.5", :y2 => "205.5"}
