                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \psi(0) = \psi(*)
            %math#mathml_aa4aa9075830b6d749d1c29a560732ae809d1b7b_48.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo :
                  %mi ℝ
                  %mo →
                  %mi ℝ
                  %mo ∪
                  %mo{:stretchy => "false"} {
                  %mo *
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \alpha : \mathbb{R} \to \mathbb{R} \cup \{*\}
            can choose whether to pass through
            %math#mathml_aa4aa9075830b6d749d1c29a560732ae809d1b7b_49.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            or
            %math#mathml_aa4aa9075830b6d749d1c29a560732ae809d1b7b_50.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                %annotation{:encoding => "application/x-tex"} *
            completely arbitrarily.
          %p
            We consider this as a coequaliser of spaces over
            %math#mathml_aa4aa9075830b6d749d1c29a560732ae809d1b7b_51.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            by taking the obvious map to
            %math#mathml_aa4aa9075830b6d749d1c29a560732ae809d1b7b_52.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            in each case. The colimit is the same whether we work in the full category of Frölicher spaces or just those over
            = succeed "." do
              %math#mathml_aa4aa9075830b6d749d1c29a560732ae809d1b7b_53.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
          %p
            Now let
            %math#mathml_aa4aa9075830b6d749d1c29a560732ae809d1b7b_54.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            be any Frölicher space and consider it as a space over
            %math#mathml_aa4aa9075830b6d749d1c29a560732ae809d1b7b_55.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            via the
            %a.existingWikiWord{:href => "/nlab/show/constant+function"} constant
            zero map,
            = succeed "." do
              %math#mathml_aa4aa9075830b6d749d1c29a560732ae809d1b7b_56.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
