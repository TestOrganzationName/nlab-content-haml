                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \psi : \mathbb{R} \cup \{*\} \to \mathbb{R}
            has to satisfy
            = succeed "," do
              %math#mathml_aa4aa9075830b6d749d1c29a560732ae809d1b7b_47.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
