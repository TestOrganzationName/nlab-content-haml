                  %use{:x => "53.900423", "xlink:href" => "#VmWIj3zschJagdEQnEU4aQAlBHY=-glyph4-2", :y => "49.392132"}
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is symmetric, then we call
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mo ⊙
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{C}, \odot)
              a
              = succeed "." do
                %strong symmetric monoidal actegory
          %h2#classifying_objects Classifying objects
          %p
            Actegories are famously equivalent to monoidal functors
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℳ
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mi 𝒞
                    %mo ,
                    %mi 𝒞
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathcal{M} \to [\mathcal{C},\mathcal{C}]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi 𝒞
                  %mo ,
                  %mi 𝒞
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [\mathcal{C},\mathcal{C}]
            %em classifies
            actions on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
          %p When the action is monoidal, braided or symmetric monoidal, the classifier is different:
          %ul
            %li
              Monoidal actions are classified by
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Z
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Z(\mathcal{C})
              %a.existingWikiWord{:href => "/nlab/show/Drinfeld+center"} Drinfeld center
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %li
              Braided monoidal actions are classified by
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Sigma(\mathcal{C})
              %span.newWikiWord
                symmetric center
                %a{:href => "/nlab/new/symmetric+center"} ?
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              spanned by those objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} x:\mathcal{C}
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi β
                        %mrow
                          %mi x
                          %mo ,
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msub
                        %mi β
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo ,
                          %mi x
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} \beta_{x,-}\beta_{-,x} = 1
            %li
              Symmetric monoidal actions are classified by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              itself. In fact a symmetric monoidal action
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊙
                  %annotation{:encoding => "application/x-tex"} \odot
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℳ
                  %annotation{:encoding => "application/x-tex"} \mathcal{M}
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              gives a symmetric monoidal functor
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ⊙
                      %mi i
                      %mo :
                      %mi ℳ
                      %mo →
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} - \odot i : \mathcal{M} \to \mathcal{C}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ⊠
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %annotation{:encoding => "application/x-tex"} F(-) \boxtimes -
              is a symmetric monoidal action whenever
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℳ
                    %mo →
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{M} \to \mathcal{C}
              is a
              %a.existingWikiWord{:href => "/nlab/show/braided+monoidal+functor"} braided monoidal functor
              between
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+categories"} symmetric monoidal categories
          %p
            This is all proven in Section 5.5 of
            = succeed "." do
              %a{:href => "#CG22"} Capucci &amp; Gavranović 2022
          %h2#see_also See also
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/actegories"}> actegories
              ,
              %a.existingWikiWord{:href => "/nlab/show/pseudoaction"} pseudoaction
            %li
              %a.existingWikiWord{:href => "/nlab/show/para+construction"} para construction
              (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Para
                    %mo{:stretchy => "false"} (
                    %mo ⊙
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{Para}(\odot)
              is monoidal iff
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊙
                  %annotation{:encoding => "application/x-tex"} \odot
              is)
            %li
              %a.existingWikiWord{:href => "/nlab/show/periodic+table"} periodic table
          %h2#references References
          %ul
            %li#CG22
              %a.existingWikiWord{:href => "/nlab/show/Matteo+Capucci"}> Matteo Capucci
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Bruno+Gavranovi%C4%87"} Bruno Gavranović
              %em Actegories for the working amthematician
              \&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/2203.16351"}> arXiv:2203.16351
              \&amp;rbrack;
