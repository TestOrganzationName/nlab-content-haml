          %h2#idea Idea
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            a (
            %a.existingWikiWord{:href => "/nlab/show/spacetime"}> spacetime
            )
            %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} E \to X
            a
            %a.existingWikiWord{:href => "/nlab/show/bundle"} bundle
            (in
            %a.existingWikiWord{:href => "/nlab/show/physics"} physics
            called the
            = succeed ")" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
            %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Jet
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Jet(E) \to X
            %strong variational bicomplex
            is essentially the
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+complex"} de Rham complex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                  %msup
                    %mi Ω
                    %mo •
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi Jet
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                %annotation{:encoding => "application/x-tex"} \Big(\Omega^\bullet\big(Jet(E)\big),\mathbf{d}\Big)
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Jet
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Jet(E)
            with
            %a.existingWikiWord{:href => "/nlab/show/differential+forms"} differential forms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mi n
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi Jet
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mo =
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨁
                    %mrow
                      %mi h
                      %mo +
                      %mi v
                      %mo =
                      %mi n
                  %msup
                    %mi Ω
                    %mrow
                      %mi h
                      %mo ,
                      %mi v
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Omega^n\big(Jet(E)\big) = \bigoplus_{h+v=n} \Omega^{h,v}(E)
            bigraded by
            %a.existingWikiWord{:href => "/nlab/show/horizontal+differential+form"} horizontal
            degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                %annotation{:encoding => "application/x-tex"} h
            (with respect to
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                %annotation{:encoding => "application/x-tex"} v
            (along the
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
            = succeed "))." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi j
                      %mn ∞
                    %mi E
                  %annotation{:encoding => "application/x-tex"} j_\infty E
            %a.existingWikiWord{:href => "/nlab/show/differential"} differential
            decomposes as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %mo =
                  %mi d
                  %mo +
                  %mi δ
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{d}
                  \=
                  d + \delta
                  \\,,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                %annotation{:encoding => "application/x-tex"} \mathbf{d}
            is the
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+differential"} de Rham differential
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Jet
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Jet(E)
            and where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                %annotation{:encoding => "application/x-tex"} d
            is called the
            %strong horizontal differential
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi δ
                %annotation{:encoding => "application/x-tex"} \delta
            is called the
            = succeed "." do
              %strong vertical differential
          %p
            With
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} E \to X
            thought of as a
            %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
            over
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/worldvolume"} worldvolume
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                %annotation{:encoding => "application/x-tex"} d
            is a measure for how quantities change over spacetime, while
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi δ
                %annotation{:encoding => "application/x-tex"} \delta
            is the
            %a.existingWikiWord{:href => "/nlab/show/variational+calculus"} variational
            differential that measures how quantities change as the field configurations are varied.
          %p
            Accordingly, much of the
            %a.existingWikiWord{:href => "/nlab/show/variational+calculus"} variational calculus
            involved in
            %a.existingWikiWord{:href => "/nlab/show/classical+mechanics"} classical mechanics
            and
            %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian
            %a.existingWikiWord{:href => "/nlab/show/classical+field+theory"} classical field theory
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            (the “
            %a.existingWikiWord{:href => "/nlab/show/principle+of+extremal+action"}> principle of extremal action
            ”) is formalized in terms of the variational bicomplex. For instance
          %ul
            %li
              %p
                a field configuration is a
                %a.existingWikiWord{:href => "/nlab/show/section"} section
                of
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
            %li
              %p
                a
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
                is an element
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                        %mo ∈
                        %msup
                          %mi Ω
                          %mrow
                            %mi n
                            %mo ,
                            %mn 0
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} L \in \Omega^{n,0}(E)
            %li
              %p
                a
                %a.existingWikiWord{:href => "/nlab/show/local+action+functional"} local action functional
                is a map
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo :
                      %mi Γ
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"}
                      S : \Gamma(E) \to \mathbb{R}
              %p of the form
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo{:stretchy => "false"} (
                      %mi ϕ
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mo ∫
                        %mi X
                      %mi L
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi j
                        %mn ∞
                      %mi ϕ
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      S(\phi) = \int_X L(j^\infty \phi)
                      \\,,
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+equation"} Euler-Lagrange equation
                is
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mo{:stretchy => "false"} (
                      %mi L
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %mi δ
                      %mi L
                      %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} mod
                      %mi im
                      %mi d
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"}
                      E(L) \coloneqq \delta L \mod im d = 0
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/covariant+phase+space"} covariant phase space
                is the locus
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                      %mi ϕ
                      %mo ∈
                      %mi Γ
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                      %mi E
                      %mo{:stretchy => "false"} (
                      %mi L
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi j
                        %mn ∞
                      %mi ϕ
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                    %annotation{:encoding => "application/x-tex"}
                      \\big\{
                      \\phi \in \Gamma(E) | E(L)(j^\infty \phi) = 0
                      \\big\}
            %li
              %p
                a
                %a.existingWikiWord{:href => "/nlab/show/conserved+current"} conserved current
                is an element
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                      %mo ∈
                      %msup
                        %mi Ω
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                          %mo ,
                          %mn 0
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \eta\in \Omega^{n-1,0}(E)
                that is horizontally closed on the covariant phase space
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mi η
                      %mo =
                      %mn 0
                      %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} mod
                      %mi E
                      %mo{:stretchy => "false"} (
                      %mi L
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      d \eta = 0 \mod E(L)
            %li
              %p
                a
                %a.existingWikiWord{:href => "/nlab/show/symmetry"} symmetry
                is an
                %a.existingWikiWord{:href => "/nlab/show/evolutionary+vector+field"} evolutionary vector field
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                    %annotation{:encoding => "application/x-tex"} v
                such that
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                      %mo{:stretchy => "false"} (
                      %mi L
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                      %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} mod
                      %mi im
                      %mi d
                    %annotation{:encoding => "application/x-tex"}
                      v(L) = 0 \mod im d
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Noether%27s+theorem"} Noether's theorem
                asserts that every
                %a.existingWikiWord{:href => "/nlab/show/symmetry"} symmetry
                induces a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/conserved+current"} conserved current
          %h2#definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            be a
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo :
                  %mi E
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} p : E \to X
            some smooth
            %a.existingWikiWord{:href => "/nlab/show/bundle"} bundle
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Jet
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} Jet(E) \to X
            for the corresponding
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
          %h3#the_bicomplex The bicomplex
          %p
            The spaces of
            %a.existingWikiWord{:href => "/nlab/show/sections"} sections
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Gamma(E)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi Jet
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Gamma(Jet(E))
            canonically inherit a generalized smooth structure that makes them
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/diffeological+spaces"} diffeological spaces
            %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
            %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
            of diffeological spaces
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi Γ
                          %mo{:stretchy => "false"} (
                          %mi E
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ⟶
                        %mtd
                          %mo *
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mi id
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} [
                          %mi X
                          %mo ,
                          %mi E
                          %mo{:stretchy => "false"} ]
                        %mtd
                          %mover
                            %mo ⟶
                            %mrow
                              %msub
                                %mi p
                                %mo *
                        %mtd
                          %mo{:stretchy => "false"} [
                          %mi X
                          %mo ,
                          %mi X
                          %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\Gamma(E) &amp; \longrightarrow &amp; *
                  \\\
                  \\downarrow &amp;&amp; \downarrow^{id}
                  \\\
                  [X,E] &amp;\stackrel{p_*}{\longrightarrow}&amp; [X,X]
                  }
                  \\,.
          %p
            This induces the
            %a.existingWikiWord{:href => "/nlab/show/evaluation+map"} evaluation map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ×
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi E
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  X \times \Gamma(E) \to E
                  \\,.
          %p and composed with the jet prolongation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi j
                    %mn ∞
                  %mo :
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi Jet
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  j^\infty : \Gamma(E)  \to \Gamma(Jet(E))
          %p
            it yields a smooth map (
            %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            of
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/diffeological+spaces"} diffeological spaces
          #eq:EProlongation.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi e
                    %mn ∞
                  %mo :
                  %mi X
                  %mo ×
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi id
                      %mo ,
                      %msup
                        %mi j
                        %mn ∞
                      %mo{:stretchy => "false"} )
                  %mi X
                  %mo ×
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi Jet
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mi ev
                  %mi Jet
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  e_\infty : X \times \Gamma(E) \stackrel{(id,j^\infty)}{\to}
                  X \times \Gamma(Jet(E))
                  \\stackrel{ev}{\to}
                  Jet(E)
                  \\,.
          %p Write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mrow
                      %mo •
                      %mo ,
                      %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ×
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\Omega^{\bullet, \bullet}(X \times \Gamma(E))
          %p
            for the
            %a.existingWikiWord{:href => "/nlab/show/cochain+complex"} cochain complex
            of smooth differential forms on the
            %a.existingWikiWord{:href => "/nlab/show/product"} product
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \times \Gamma(E)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %mo ≔
                  %mi d
                  %mo +
                  %mi δ
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{d} \coloneqq d + \delta
                  \\,,
          %p
            where the
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                  %annotation{:encoding => "application/x-tex"} \mathbf{d}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                %annotation{:encoding => "application/x-tex"} d
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                  %annotation{:encoding => "application/x-tex"} \delta
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+differentials"} de Rham differentials
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X\times\Gamma(E)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Gamma(E)
          .num_defn
            %h6#definition_2 Definition
            %p
              The
              %strong variational bicomplex
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} E \to X
              is the sub–bi-complex of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mrow
                        %mo •
                        %mo ,
                        %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega^{\bullet, \bullet}(X \times \Gamma(E))
              that is the
              %a.existingWikiWord{:href => "/nlab/show/image"} image
              of the pullback of forms along the map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi e
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} e_\infty
              = succeed ":" do
                %a.maruku-eqref{:href => "#eq:EProlongation"} (1)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi e
                      %mn ∞
                      %mo *
                    %mo :
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi Jet
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    e_\infty^* : \Omega^{\bullet}(Jet(E)) \to
                    \\Omega^\bullet(X \times \Gamma(E))
                    \\,.
            %p We write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi loc
                      %mrow
                        %mo •
                        %mo ,
                        %mo •
                    %mo ≔
                    %mi im
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi e
                      %mn ∞
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^{\bullet, \bullet}_{loc}
                    \\coloneqq
                    im (e_\infty^*)
            %p
              and speak of the bicomplex of
              %strong local forms
              on sections on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
          %p
            The bicomplex structure on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Ω
                    %mi loc
                    %mrow
                      %mo •
                      %mo ,
                      %mo •
                %annotation{:encoding => "application/x-tex"} \Omega^{\bullet, \bullet}_{loc}
            is attributed by
            %a{:href => "#Olver86"} Olver 1986
            to
            = succeed "." do
              %a{:href => "#Takens79"} Takens 1979
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ×
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X \times \Gamma(E)
            is due to &amp;lbrack;
            %a{:href => "#Zuckerman87"}> Zuckerman 87, p. 5
            \&amp;rbrack;.
          %p
            %img{:src => "https://ncatlab.org/nlab/files/VariationalBicomplex.jpg", :width => "550"}/
          %h3#MoreOntheHorizontalComplex More on the horizontal differential complex
          #CharacterizationOfHorizontalDifferential.num_remark
            %h6#remark Remark
            %p
              In terms of a
              %a.existingWikiWord{:href => "/nlab/show/coordinate+chart"} coordinate chart
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi x
                      %mi i
                    %mo ,
                    %msup
                      %mi u
                      %mi α
                    %mo ,
                    %msubsup
                      %mi u
                      %mi i
                      %mi α
                    %mo ,
                    %msubsup
                      %mi u
                      %mrow
                        %mi i
                        %mi j
                      %mi α
                    %mo ,
                    %mi ⋯
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x^i, u^\alpha,u^\alpha_i,u^\alpha_{i j},\cdots)
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              covering a coordinate chart
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi X
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X^i)
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi Jet
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \in C^\infty(Jet(E))
              is given by the formula for the
              %a.existingWikiWord{:href => "/nlab/show/total+derivative"} total derivative
              operation, but with concrete differentials substituted by the respective jet coordinates:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi h
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi i
                    %mrow
                      %mo (
                      %mfrac
                        %mrow
                          %mo ∂
                          %mi f
                        %mrow
                          %mo ∂
                          %msup
                            %mi x
                            %mi i
                      %mo +
                      %mfrac
                        %mrow
                          %mo ∂
                          %mi f
                        %mrow
                          %mo ∂
                          %msup
                            %mi u
                            %mi α
                      %msubsup
                        %mi u
                        %mi i
                        %mi α
                      %mo +
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mi j
                      %mfrac
                        %mrow
                          %mo ∂
                          %mi f
                        %mrow
                          %mo ∂
                          %msubsup
                            %mi u
                            %mi j
                            %mi α
                      %msubsup
                        %mi u
                        %mrow
                          %mi j
                          %mi i
                        %mi α
                      %mo +
                      %mi ⋯
                      %mo )
                    %mi d
                    %msup
                      %mi x
                      %mi i
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    d_h f
                    \\;\coloneqq\;
                    \\sum_i
                    \\left(
                    \\frac{\partial f}{\partial x^i}
                    +
                    \\frac{\partial f}{\partial u^\alpha}u^\alpha_i
                    +
                    \\sum_j \frac{\partial f}{\partial u^\alpha_j} u^\alpha_{j i}
                    +
                    \\cdots
                    \\right)
                    d x^i
                    \\,.
            %p
              (
              %a{:href => "#Anderson89"}> Anderson 89, p. 10
              ).
          %p More abstractly, the horizontal differential is characterized as follows:
          #HorizontalDifferentialCompatibleWithPullbackAlongJetProlongations.num_prop
            %h6#proposition Proposition
            %p
              The horizontal differential takes horizontal forms to horizontal forms, and for all sections
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo ∈
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \phi \in \Gamma(E)
              it respects
              %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pullback of differential forms
              along the jet prolongation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi j
                      %mn ∞
                    %mi ϕ
                    %mo ∈
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi Jet
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} j_\infty \phi \in \Gamma(Jet(E))
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi j
                      %mn ∞
                    %mi ϕ
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mo ∘
                    %msub
                      %mi d
                      %mi h
                    %mo =
                    %mi d
                    %mo ∘
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi j
                      %mn ∞
                    %mi ϕ
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"}
                    (j^\infty \phi)^\ast \circ d_h = d \circ (j^\infty \phi)^\ast
            %p (where on the right we have the ordinary de Rham differential on the base space).
          %p
            Yet more abstractly, the horizontal complex may be understood in terms of
            %a.existingWikiWord{:href => "/nlab/show/differential+operators"} differential operators
            and the
            %a.existingWikiWord{:href => "/nlab/show/jet+comonad"} jet comonad
            as follows.
          #HorizontalComplexViaDifferentialOperators.num_remark
            %h6#remark_2 Remark
            %p
              A horizontal differential
              = succeed "-form" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Jet
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Jet(E) \to X
              is equivalently a homomorphism of
              %a.existingWikiWord{:href => "/nlab/show/bundles"} bundles
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Jet
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mo ∧
                      %mi n
                    %msup
                      %mi T
                      %mo *
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\alpha \colon Jet(E) \longrightarrow \wedge^n T^\ast X
            %p
              from the
              %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Jet
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Jet(E)
              to the
              %a.existingWikiWord{:href => "/nlab/show/exterior+bundle"} exterior bundle
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mo ∧
                        %mi n
                      %msup
                        %mi T
                        %mo *
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \wedge^n T^\ast X
              %a.existingWikiWord{:href => "/nlab/show/differential+operator"} differential operator
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                      %mo{:lspace => "verythinmathspace"} :
                      %mi E
                      %mo →
                      %msup
                        %mo ∧
                        %mi n
                      %msup
                        %mi T
                        %mo *
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \alpha \colon E \to \wedge^n T^\ast X
            %p
              Now of course also the
              %a.existingWikiWord{:href => "/nlab/show/de+Rham+differential"} de Rham differential
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi X
                  %annotation{:encoding => "application/x-tex"} d_X
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a differential operator
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mo ∧
                        %mi n
                      %msup
                        %mi T
                        %mo *
                      %mi X
                      %mo →
                      %msup
                        %mo ∧
                        %mi n
                      %msup
                        %mi T
                        %mo *
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \wedge^n T^\ast X \to \wedge^n T^\ast X
              %a.existingWikiWord{:href => "/nlab/show/composition"} composition
              operation of differential operators, with horizontal forms regarded as differential operators as above.
            %p
              By the fact that differential operators are the
              %a.existingWikiWord{:href => "/nlab/show/co-Kleisli+morphisms"} co-Kleisli morphisms
              of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Jet+comonad"} Jet comonad
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi H
                    %mi α
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Jet
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi Jet
                    %mo{:stretchy => "false"} (
                    %mi Jet
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %mi Jet
                        %mo{:stretchy => "false"} (
                        %mi α
                        %mo{:stretchy => "false"} )
                    %mi Jet
                    %mo{:stretchy => "false"} (
                    %msup
                      %mo ∧
                      %mi n
                    %msup
                      %mi T
                      %mo *
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mover
                            %mi d
                            %mo{:stretchy => "false"} ˜
                          %mi X
                    %msup
                      %mo ∧
                      %mi n
                    %msup
                      %mi T
                      %mo *
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    d_H \alpha
                    \\colon
                    Jet(F)
                    \\longrightarrow
                    Jet(Jet(F))
                    \\stackrel{Jet(\alpha)}{\longrightarrow}
                    Jet(\wedge^n T^\ast X)
                    \\stackrel{\tilde d_X}{\longrightarrow}
                    \\wedge^n T^\ast X
                    \\,.
          %p
            (e.g.
            = succeed "," do
              %a{:href => "#KrasilshchikVerbovertsky98"} Krasil’shchik-Verbovertsky 98, around def. 3.27
            = succeed ")" do
              %a{:href => "#KrasilshchikVinogradov99"} Krasil’shchik-Vinogradov 99, ch 4, around def. 1.8
          %h3#evolutionary_vector_fields Evolutionary vector fields
          %p
            Vector fields on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi J
                    %mn ∞
                  %mi E
                %annotation{:encoding => "application/x-tex"} J^\infty E
            also split into a direct sum of
            %strong vertical
            and
            %strong horizontal
            ones, respectively being annihilated by contraction with any horizontal
            = succeed "-forms" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            = succeed "-forms," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔛
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi J
                      %mn ∞
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi 𝔛
                      %mi H
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi J
                      %mn ∞
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ⊕
                    %msub
                      %mi 𝔛
                      %mi V
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi J
                      %mn ∞
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{X}(J^\infty E) = \mathfrak{X}_H(J^\infty E) \oplus \mathfrak{X}_V(J^\infty E)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                  %mo ∈
                  %msub
                    %mi 𝔛
                    %mi V
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi J
                    %mn ∞
                  %mi E
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} v \in \mathfrak{X}_V(J^\infty E)
            is called an
            %strong
              %a.existingWikiWord{:href => "/nlab/show/evolutionary+vector+field"} evolutionary vector field
            provided it satisfies
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℒ
                    %mi v
                  %mi d
                  %mo =
                  %mi d
                  %msub
                    %mi ℒ
                    %mi v
                %annotation{:encoding => "application/x-tex"} \mathcal{L}_v d = d \mathcal{L}_v
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℒ
                      %mi v
                    %mo =
                    %msub
                      %mi ι
                      %mi v
                    %mi δ
                    %mo +
                    %mi δ
                    %msub
                      %mi ι
                      %mi v
                  %annotation{:encoding => "application/x-tex"} \mathcal{L}_v = \iota_v \delta + \delta \iota_v
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔛
                      %mi ev
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi J
                      %mn ∞
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %msub
                      %mi 𝔛
                      %mi V
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi J
                      %mn ∞
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{X}_{ev}(J^\infty E) \subset \mathfrak{X}_V(J^\infty E)
          %h2#properties Properties
          %h3#horizontal_vertical_and_total_cohomology Horizontal, vertical, and total cohomology
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} E \to X
            be a smooth
            %a.existingWikiWord{:href => "/nlab/show/fiber+bundle"} fiber bundle
            over a base
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            of
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo .
                %annotation{:encoding => "application/x-tex"} n.
            Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi J
                    %mn ∞
                  %mi E
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} J^\infty E \to X
            for the
            %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} E\to X
          %p Write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℱ
                    %mi s
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi J
                    %mn ∞
                  %mi E
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mi I
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Ω
                    %mrow
                      %mi n
                      %mo ,
                      %mi s
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi J
                    %mn ∞
                  %mi E
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{F}^s(J^\infty E) \coloneqq I (\Omega^{n,s}(J^\infty E))
          %p
            for the projection of
            = succeed "-forms" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo ,
                    %mi s
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n,s)
            = succeed ")." do
              %a{:href => "#Anderson89"} Anderson 89, p. 21 (50/318)
          #ELComplexHasSameCohomologyAsDeRhamComplex.num_prop
            %h6#proposition_2 Proposition
            %p
              %strong (Takens acyclicity theorem)
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cochain cohomology
              of the
              %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+complex"} Euler-Lagrange complex
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mi ℝ
                    %mo →
                    %msup
                      %mi Ω
                      %mrow
                        %mn 0
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi J
                      %mn ∞
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi d
                          %mi H
                    %msup
                      %mi Ω
                      %mrow
                        %mn 1
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi J
                      %mn ∞
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi d
                          %mi H
                    %mi ⋯
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi d
                          %mi H
                    %msup
                      %mi Ω
                      %mrow
                        %mi n
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi J
                      %mn ∞
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mi E
                    %msup
                      %mi ℱ
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi J
                      %mn ∞
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi δ
                          %mi V
                    %msup
                      %mi ℱ
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi J
                      %mn ∞
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi δ
                          %mi V
                    %mi ⋯
                  %annotation{:encoding => "application/x-tex"}
                    0 \to \mathbb{R}
                    \\to
                    \\Omega^{0,0}(J^\infty E)
                    \\stackrel{d_H}{\to}
                    \\Omega^{1,0}(J^\infty E)
                    \\stackrel{d_H}{\to}
                    \\cdots
                    \\stackrel{d_H}{\to}
                    \\Omega^{n,0}(J^\infty E)
                    \\stackrel{E}{\to}
                    \\mathcal{F}^1(J^\infty E)
                    \\stackrel{\delta_V}{\to}
                    \\mathcal{F}^2(J^\infty E)
                    \\stackrel{\delta_V}{\to}
                    \\cdots
            %p
              is
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
              to the
              %a.existingWikiWord{:href => "/nlab/show/de+Rham+cohomology"} de Rham cohomology
              of the total space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              of the given fiber bundle.
          %p
            For smooth functions of locally bounded jet order this is due to (
            %a{:href => "#Takens79"}> Takens 79
            ). A proof is also in (
            %a{:href => "#Anderson89"}> Anderson 89, theorem 5.9
            ).
          %p
            For smooth functions of globally bounded order and going up to the Euler-Lagrange operator
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            = succeed ")." do
              %a{:href => "#Deligne99"} Deligne 99, vol 1, p.188
          %h3#the_fundamental_variational_formula The fundamental variational formula
          .num_defn
            %h6#BicomplexDefinition Definition
            %p
              A
              %strong source form
              is an element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi loc
                      %mrow
                        %mi n
                        %mo ,
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \Omega^{n,1}_{loc}
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi α
                      %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi δ
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\alpha_\phi(\delta \phi)
            %p
              depends only on the 0-jet of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi δ
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"} \delta \phi
          #VariationOfLagrangian.num_prop
            %h6#proposition_3 Proposition
            %p
              Let
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mo ∈
                      %msubsup
                        %mi Ω
                        %mi loc
                        %mrow
                          %mi n
                          %mo ,
                          %mn 0
                    %annotation{:encoding => "application/x-tex"} L \in \Omega^{n,0}_{loc}
            %p
              Then there is a unique source form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E(L)
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %mi L
                    %mo =
                    %mi E
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mi d
                    %mi Θ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\delta L = E(L) - d \Theta
                    \\,.
            %p Moreover
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                        %mo{:stretchy => "false"} (
                        %mi L
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} E(L)
                  is independent of changes of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                      %annotation{:encoding => "application/x-tex"} L
                  by
                  = succeed "-exact" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi d
                        %annotation{:encoding => "application/x-tex"} d
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                        %mo{:stretchy => "false"} (
                        %mi L
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi E
                        %mo{:stretchy => "false"} (
                        %mi L
                        %mo +
                        %mi d
                        %mi K
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        E(L) = E(L + d K)
                        \\,.
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Θ
                      %annotation{:encoding => "application/x-tex"} \Theta
                  is unique up to
                  = succeed "-exact" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi d
                        %annotation{:encoding => "application/x-tex"} d
          %p
            This is &amp;lbrack;
            %a{:href => "#Zuckerman87"}> Zuckerman 87, theorem 3
            \&amp;rbrack;.
          %p
            Here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            is the
            %em
              %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+equations"} Euler-Lagrange operator
            \.
          .num_defn
            %h6#definition_4 Definition
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                    %mo =
                    %mi δ
                    %mi Θ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega = \delta \Theta
                    \\,.
          #HorizontalDOfOmega.num_remark
            %h6#remark_3 Remark
            %p
              By prop.
              %a.maruku-ref{:href => "#VariationOfLagrangian"}
              have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mi Ω
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi δ
                    %mi E
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    d \Omega = -\delta E(L)
                    \\,.
          #SecondOrderVariationVanishesOnShell.num_prop
            %h6#proposition_4 Proposition
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %mi E
                  %annotation{:encoding => "application/x-tex"} \delta E
              vanishes when restricted to vertical tangent vectors based in
              %a.existingWikiWord{:href => "/nlab/show/covariant+phase+space"} covariant phase space
              (but not necessarily tangential to it).
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %mi E
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msub
                          %mi T
                          %mrow
                            %mi E
                            %mo{:stretchy => "false"} (
                            %mi L
                            %mo{:stretchy => "false"} )
                            %mo =
                            %mn 0
                        %mi Γ
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\delta E(L) |_{T_{E(L) = 0} \Gamma(E)} = 0
                    \\,.
          %p
            This is &amp;lbrack;
            %a{:href => "#Zuckerman87"}> Zuckerman 87, lemma 8
            \&amp;rbrack;.
          %h3#presymplectic_covariant_phase_space Presymplectic covariant phase space
          .num_cor
            %h6#corollary Corollary
            %p
              The form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                  %annotation{:encoding => "application/x-tex"} \Omega
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/conserved+current"} conserved current
          .proof
            %h6#proof Proof
            %p
              By remark
              %a.maruku-ref{:href => "#HorizontalDOfOmega"}
              and prop.
              = succeed "." do
                %a.maruku-ref{:href => "#SecondOrderVariationVanishesOnShell"}
          #ThePresymplecticForm.num_defn
            %h6#definition_5 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \Sigma \subset X
              a
              %a.existingWikiWord{:href => "/nlab/show/compact+space"} compact
              %a.existingWikiWord{:href => "/nlab/show/closed+manifold"} closed
              submanifold of
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n-1
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo ≔
                    %msub
                      %mo ∫
                      %mi Σ
                    %mi Ω
                    %mo ∈
                    %msubsup
                      %mi Ω
                      %mi loc
                      %mrow
                        %mn 0
                        %mo ,
                        %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\omega \coloneqq \int_\Sigma \Omega \in \Omega^{0,2}_{loc}
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/presymplectic+structure"} presymplectic structure
              on
              %a.existingWikiWord{:href => "/nlab/show/covariant+phase+space"} covariant phase space
              relative to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
          .num_prop
            %h6#proposition_5 Proposition
            %p
              The 2-form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              is indeed closed
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %mi ω
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\delta \omega = 0
            %p and in fact exact:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                    %mo ≔
                    %msub
                      %mo ∫
                      %mi Σ
                    %mi Θ
                  %annotation{:encoding => "application/x-tex"}
                    \\theta \coloneqq \int_\Sigma \Theta
            %p
              is its
              %em presymplectic potential
              \.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %mi θ
                    %mo =
                    %mi ω
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\delta \theta  = \omega
                    \\,.
          %h3#symmetries Symmetries
          %p
            Let
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo ∈
                    %msubsup
                      %mi Ω
                      %mi loc
                      %mrow
                        %mi n
                        %mo ,
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} L \in \Omega^{n,0}_{loc}
          .num_defn
            %h6#definition_6 Definition
            %p
              An evolutionary vertical vector field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ∈
                    %msub
                      %mi 𝔛
                      %mi ev
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi J
                      %mn ∞
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} v \in \mathfrak{X}_{ev}(J^\infty E)
              is a
              %strong
                %a.existingWikiWord{:href => "/nlab/show/symmetry"} symmetry
              if
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                    %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} mod
                    %mi im
                    %mi d
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    v(L) = 0 \mod im d
                    \\,.
          .num_prop
            %h6#proposition_6 Proposition
            %p
              The presymplectic form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              from def.
              %a.maruku-ref{:href => "#ThePresymplecticForm"}
              is annihilated by the Lie derivative of the vector field on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Gamma(E)
              induced by a symmetry.
          %p
            This appears as &amp;lbrack;
            %a{:href => "#Zuckerman87"}> Zuckerman 87, theorem 13
            \&amp;rbrack;.
          %h2#FormalizationInDifferentialCohesion Elementary formalization in differential cohesion
          %p
            We discuss aspects of an
            %a.existingWikiWord{:href => "/nlab/show/elementary+%28infinity%2C1%29-topos"} elementary
            formalization in
            %a.existingWikiWord{:href => "/nlab/show/differential+cohesion"} differential cohesion
            of the concept of the variational bicomplex .
          %blockquote
            %p under construction
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            be a context of
            %a.existingWikiWord{:href => "/nlab/show/cohesion"} cohesion
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/differential+cohesion"} differential cohesion
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/flat+modality"} flat modality
                denoted
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ♭
                      %annotation{:encoding => "application/x-tex"} \flat
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+shape+modality"} infinitesimal shape modality
                denoted
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℑ
                      %annotation{:encoding => "application/x-tex"} \Im
          %p Choose
          %ol
            %li
              %p
                an
                %a.existingWikiWord{:href => "/nlab/show/object"} object
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Σ
                        %mo ∈
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                      %annotation{:encoding => "application/x-tex"} \Sigma \in \mathbf{H}
                %em base space
                (or
                %em
                  %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
                or
                = succeed ");" do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/worldvolume"} worldvolume
            %li
              %p
                an object
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                        %mo ∈
                        %msub
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                          %mrow
                            %mo{:stretchy => "false"} /
                            %mi Σ
                      %annotation{:encoding => "application/x-tex"} E \in \mathbf{H}_{/\Sigma}
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
            %li
              %p
                an object
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi A
                        %mo ∈
                        %mi Stab
                        %mo{:stretchy => "false"} (
                        %msub
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                          %mrow
                            %mo{:stretchy => "false"} /
                            %mi Σ
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo →
                          %mi Ω
                        %msub
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                          %mrow
                            %mo{:stretchy => "false"} /
                            %mi Σ
                      %annotation{:encoding => "application/x-tex"} \mathbf{A} \in Stab(\mathbf{H}_{/\Sigma}) \stackrel{\Omega}{\to} \mathbf{H}_{/\Sigma}
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/differential+cohomology"} differential
                    %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
          %p Write
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mrow
                          %mo{:stretchy => "false"} /
                          %mi Σ
                      %mover
                        %mover
                          %munder
                            %mo ⟶
                            %mrow
                              %msub
                                %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                                %mi Σ
                          %mover
                            %mo ⟵
                            %mrow
                              %msup
                                %mi Σ
                                %mo *
                        %mover
                          %mo ⟶
                          %mrow
                            %msub
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mi Σ
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbf{H}_{/\Sigma}
                      \\stackrel{\overset{\sum_\Sigma}{\longrightarrow}}{\stackrel{\overset{\Sigma^\ast}{\longleftarrow}}{\underset{\prod_\Sigma}{\longrightarrow}}}
                      \\mathbf{H}
                for the
                %a.existingWikiWord{:href => "/nlab/show/base+change"} base change
                %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"} adjoint triple
                over
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Σ
                      %annotation{:encoding => "application/x-tex"} \Sigma
                %a.existingWikiWord{:href => "/nlab/show/%C3%A9tale+geometric+morphism"} étale geometric morphism
                of the
                %a.existingWikiWord{:href => "/nlab/show/slice+%28infinity%2C1%29-topos"} slice (infinity,1)-topos
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                          %mrow
                            %mo{:stretchy => "false"} /
                            %mi Σ
                      %annotation{:encoding => "application/x-tex"} \mathbf{H}_{/\Sigma}
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Γ
                        %mi X
                      %mo ≔
                      %mo ♭
                      %mo ∘
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mi Σ
                      %mo{:lspace => "verythinmathspace"} :
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mrow
                          %mo{:stretchy => "false"} /
                          %mi Σ
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \Gamma_X \coloneqq \flat \circ \prod_\Sigma \colon \mathbf{H}_{/\Sigma} \to \mathbf{H}
                for the external
                %a.existingWikiWord{:href => "/nlab/show/space+of+sections"} space of sections
                functor;
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo{:lspace => "verythinmathspace"} :
                      %mi Σ
                      %mo ⟶
                      %mi ℑ
                      %mo{:stretchy => "false"} (
                      %mi Σ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} i \colon \Sigma \longrightarrow \Im(\Sigma)
                for the
                = succeed "-component" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Σ
                      %annotation{:encoding => "application/x-tex"} \Sigma
                %a.existingWikiWord{:href => "/nlab/show/unit+of+a+monad"} unit
                of
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℑ
                      %annotation{:encoding => "application/x-tex"} \Im
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Jet
                        %mi Σ
                      %mo ≔
                      %msup
                        %mi i
                        %mo *
                      %msub
                        %mi i
                        %mo *
                    %annotation{:encoding => "application/x-tex"} Jet_\Sigma \coloneqq i^\ast i_\ast
                for the induced
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/jet+comonad"} jet comonad
            %li
              %p
