                        %mi Σ
                    %annotation{:encoding => "application/x-tex"} free\colon \mathbf{H} \to PDE(\mathbf{H})_\Sigma
              %a.existingWikiWord{:href => "/nlab/show/co-Kleisli+category"} co-Kleisli category
              of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/jet+comonad"} jet comonad
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}
            %p
              As such, the left hand side of the equality is given in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              by the composite morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mover
                      %mo →
                      %mo ≃
                    %mi Jet
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %mi Jet
                        %mo{:stretchy => "false"} (
                        %mi σ
                        %mo{:stretchy => "false"} )
                    %mi Jet
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                    %mi Jet
                    %mo{:stretchy => "false"} (
                    %mi Jet
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %mi Jet
                        %mo{:stretchy => "false"} (
                        %mover
                          %mi α
                          %mo{:stretchy => "false"} ˜
                        %mo{:stretchy => "false"} )
                    %mi Jet
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi A
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mover
                        %mi d
                        %mo{:stretchy => "false"} ˜
                    %mstyle{:mathvariant => "bold"}
                      %mi A
                    %mo ′
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\Sigma
                    \\stackrel{\simeq}{\to}
                    Jet(\Sigma)
                    \\stackrel{Jet(\sigma)}{\longrightarrow}
                    Jet(E)
                    \\stackrel{}{\to}
                    Jet(Jet(E))
                    \\stackrel{Jet(\tilde \alpha)}{\longrightarrow}
                    Jet(\mathbf{A})
                    \\stackrel{\tilde d}{\longrightarrow}
                    \\mathbf{A}'
                    \\,,
            %p
              thought of as bracketed to the right. By
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} naturality
              of the Jet-counit this is equivalently
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Jet
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≃
                    %mi Jet
                    %mo{:stretchy => "false"} (
                    %mi Jet
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %mi Jet
                        %mo{:stretchy => "false"} (
                        %mi Jet
                        %mo{:stretchy => "false"} (
                        %mi σ
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                    %mi Jet
                    %mo{:stretchy => "false"} (
                    %mi Jet
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %mi Jet
                        %mo{:stretchy => "false"} (
                        %mover
                          %mi α
                          %mo{:stretchy => "false"} ˜
                        %mo{:stretchy => "false"} )
                    %mi Jet
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi A
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mover
                        %mi d
                        %mo{:stretchy => "false"} ˜
                    %mstyle{:mathvariant => "bold"}
                      %mi A
                    %mo ′
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    Jet(\Sigma) \stackrel{\simeq}{\to} Jet(Jet(\Sigma))
                    \\stackrel{Jet(Jet(\sigma))}{\longrightarrow}
                    Jet(Jet(E))
                    \\stackrel{Jet(\tilde \alpha)}{\longrightarrow}
                    Jet(\mathbf{A})
                    \\stackrel{\tilde d}{\longrightarrow}
                    \\mathbf{A}'
                    \\,,
            %p
              By functorality of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Jet
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Jet(-)
              this is equivalent to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Jet
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≃
                    %mi Jet
                    %mo{:stretchy => "false"} (
                    %mi Jet
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %mi Jet
                        %mo{:stretchy => "false"} (
                        %mover
                          %mi α
                          %mo{:stretchy => "false"} ˜
                        %mo ∘
                        %mi Jet
                        %mo{:stretchy => "false"} (
                        %mi σ
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                    %mi Jet
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi A
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mover
                        %mi d
                        %mo{:stretchy => "false"} ˜
                    %mstyle{:mathvariant => "bold"}
                      %mi A
                    %mo ′
                  %annotation{:encoding => "application/x-tex"}
                    Jet(\Sigma)
                    \\stackrel{\simeq}{\to}
                    Jet(Jet(\Sigma)) \stackrel{Jet ( \tilde \alpha \circ Jet(\sigma) )}{\longrightarrow}
                    Jet(\mathbf{A})
                    \\stackrel{\tilde d}{\to}
                    \\mathbf{A}'
            %p which is the right hand side of the equivalence to be proven.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/local+Lagrangian"}> local Lagrangian
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+form"} Euler-Lagrange form
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/source+form"} source form
                %a.existingWikiWord{:href => "/nlab/show/Lepage+form"} Lepage form
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/variational+calculus"} variational calculus
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/secondary+differential+calculus"} secondary differential calculus
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/variational+sequence"} variational sequence
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/BV-BRST+complex"} BV-BRST complex
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/BV-BRST+variational+bicomplex"} BV-BRST variational bicomplex
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/presymplectic+current"}> presymplectic current
                ,
                %a.existingWikiWord{:href => "/nlab/show/covariant+phase+space"} covariant phase space
          %h2#references References
          %p The earliest occurrence of the variational bicomplex in the literature is in Section 2.2 of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/D.+B.+Fuchs"}> D. B. Fuchs
              , A. M. Gabrielov,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/I.+M.+Gel%27fand"} I. M. Gel'fand
              = succeed "," do
                %em The Gauss-Bonnet theorem and the Atiyah-Patodi-Singer functionals for the characteristic classes of foliations
              %a{:href => "https://doi.org/10.1016/0040-9383(76)90007-0"} DOI
          %p
            which attributes it to
            %a.existingWikiWord{:href => "/nlab/show/Israel+Gelfand"} Israel Gelfand
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Mark+Losik"} Mark Losik
          %p Further work appeared independently in
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Alexandre+Vinogradov"}> Alexandre Vinogradov
                ,
                = succeed "," do
                  %em A spectral sequence associated with a non-linear differential equation, and the algebro-geometric foundations of Lagrangian field theory with constraints
                = succeed "." do
                  %a{:href => "https://dmitripavlov.org/scans/vinogradov-a-spectral-sequence-associated-with-a-nonlinear-differential-equation-and-algebro-geometric-foundations-of-lagrangian-field-theory-with-constraints.pdf"} PDF
                = succeed "," do
                  %em Одна спектральная последовательность, связанная с нелинейным дифференциальным уравнением и алгебро-геометрические основания лагранжевой теории поля со связями
                = succeed "." do
                  %a{:href => "https://www.mathnet.ru/rus/dan/v238/i5/p1028"} PDF
            %li
              %p
                W. M. Tulczyjew,
                = succeed "," do
                  %em The Euler-Lagrange resolution
                = succeed "." do
                  %a{:href => "https://doi.org/10.1007/bfb0089725"} DOI
          %p See also
          %ul
            %li
              %p
                Toru Tsujishita,
                = succeed "," do
                  %em On variation bicomplexes associated to differential equations
                = succeed "." do
                  %a{:href => "http://projecteuclid.org/euclid.ojm/1200775039"} Project Euclid
            %li#Takens79
              %p
                %a.existingWikiWord{:href => "/nlab/show/Floris+Takens"}> Floris Takens
                ,
                = succeed "," do
                  %em A global version of the inverse problem of the calculus of variations
                = succeed "." do
                  %a{:href => "https://doi.org/10.4310/jdg/1214435235"} DOI
          %p Chapter 2 (Lagrangian Theory of Classical Fields) in
          %ul
            %li#Deligne99
              %a.existingWikiWord{:href => "/nlab/show/Pierre+Deligne"}> Pierre Deligne
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Daniel+S.+Freed"} Daniel S. Freed
              = succeed "," do
                %em Classical Field Theory
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Quantum+Fields+and+Strings"}> Quantum Fields and Strings
                  \: A Course for Mathematicians
          %p An introduction is in
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ian+Anderson"}> Ian Anderson
                ,
                = succeed "," do
                  %em Introduction to the variational bicomplex
                = succeed "," do
                  %em Mathematical aspects of classical field theory
                = succeed "." do
                  %a{:href => "https://digitalcommons.usu.edu/mathsci_facpub/32/"} PDF
            %li
              %p
                Toru Tsujishita,
                = succeed "," do
                  %em Formal geometry of systems of differential equations
                = succeed "." do
                  %a{:href => "https://dmitripavlov.org/scans/tsujishita-formal-geometry-of-systems-of-differential-equations.pdf"} PDF
                = succeed "." do
                  %a{:href => "https://doi.org/10.11429/sugaku1947.35.332"} 微分方程式系の形式幾何学
          %p A careful discussion that compares the two versions (one over smooth functions globally of finite jet order, one over smooth functions locally of finite jet order) is in
          %ul
            %li
              G. Giachetta, L. Mangiarotti,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Gennadi+Sardanashvily"} Gennadi Sardanashvily
              = succeed "," do
                %em Cohomology of the variational bicomplex on the infinite order jet space
              = succeed ")" do
                %a{:href => "http://arxiv.org/abs/math/0006074"} arXiv:math/0006074
          %p Textbook accounts include
          %ul
            %li#Olver86
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+Olver"}> Peter Olver
                , section 5.4 of:
                = succeed "," do
                  %em Applications of Lie groups to differential equations
                = succeed "," do
                  %strong 107
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/978-1-4612-4350-2"} doi:10.1007/978-1-4612-4350-2
            %li#Anderson89
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ian+Anderson"}> Ian Anderson
                ,
                = succeed "," do
                  %em The variational bicomplex
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/files/AndersonVariationalBicomplex.pdf", :title => "pdf"} pdf
            %li#KrasilshchikVerbovetsky98
              %p
                %a.existingWikiWord{:href => "/nlab/show/Joseph+Krasil%27shchik"}> Joseph Krasil'shchik
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Alexander+Verbovetsky"} Alexander Verbovetsky
                %em Homological Methods in Equations of Mathematical Physics
                (
                %a{:href => "http://arxiv.org/abs/math/9808130"}> arXiv:math/9808130
                )
            %li#KrasilshchikVinogradov99
              %p
                %a.existingWikiWord{:href => "/nlab/show/Joseph+Krasil%27shchik"}> Joseph Krasil'shchik
                ,
                %a.existingWikiWord{:href => "/nlab/show/Alexandre+Vinogradov"} Alexandre Vinogradov
                et al. (eds.)
                = succeed "," do
                  %em Symmetries and Conservation Laws for Differential Equations of Mathematical Physics
          %p Other surveys include
          %ul
            %li
              Juha Pohjanpelto,
              %em Symmetries, Conservation Laws, and Variational Principles for Differential Equations
              (2014) (
              %a{:href => "http://math.usask.ca/~cheviakov/bluman2014/talks/Pohjanpelto.pdf"}> pdf slides
              )
          %p
            An early discussion with application to
            %a.existingWikiWord{:href => "/nlab/show/covariant+phase+spaces"} covariant phase spaces
            and their
            %a.existingWikiWord{:href => "/nlab/show/presymplectic+structure"} presymplectic structure
            is in
          %ul
            %li#Zuckerman87
              %a.existingWikiWord{:href => "/nlab/show/Gregg+Zuckerman"}> Gregg Zuckerman
              ,
              = succeed "," do
                %em Action principles and global geometry
              %a.existingWikiWord{:href => "/nlab/show/Shing-Tung+Yau"} Shing-Tung Yau
              (ed.)
              = succeed "," do
                %em Mathematical Aspects of String Theory
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/files/ZuckermanVariation.pdf", :title => "pdf"} pdf
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1142/0383"} doi:10.1142/0383
          %p An invariant version (under group action) is in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Irina+Kogan"}> Irina Kogan
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Peter+Olver"} Peter Olver
              = succeed "," do
                %em The invariant variational bicomplex
              %a{:href => "http://www4.ncsu.edu/~iakogan/papersPDF/sivKoganOlver.pdf"} pdf
          %p A more detailed version of this is in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Irina+Kogan"}> Irina Kogan
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Peter+Olver"} Peter Olver
              = succeed "," do
                %em Invariant Euler-Lagrange Equations and the Invariant Variational Bicomplex
              %a{:href => "http://www4.ncsu.edu/~iakogan/papersPDF/ivbKoganOlver-cor.pdf"} pdf
          %p See also
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Victor+Kac"}> Victor Kac
              ,
              = succeed "," do
                %em An explicit construction of the complex of variational calculus and Lie conformal algebra cohomology
              %a{:href => "http://sms.cam.ac.uk/media/538761"} video
          %p
            An application to
            %a.existingWikiWord{:href => "/nlab/show/multisymplectic+geometry"} multisymplectic geometry
            is discussed in
          %ul
            %li
              Thomas Bridges, Peter Hydon, Jeffrey Lawson,
              %em Multisymplectic structures and the variational bicomplex
              (
              %a{:href => "http://personal.maths.surrey.ac.uk/st/T.Bridges/PAPERS/MPCPS-Paper-09024.pdf"}> pdf
              )
          %p
            Discussion in the context of
            %a.existingWikiWord{:href => "/nlab/show/supergeometry"} supergeometry
            is in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Gennadi+Sardanashvily"}> Gennadi Sardanashvily
              ,
              %em Grassmann-graded Lagrangian theory of even and odd variables
              (
              %a{:href => "https://arxiv.org/abs/1206.2508"}> arXiv:1206.2508
              )
          %p
            Discussion in the convenient context of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/smooth+sets"} smooth sets
          %ul
            %li#GiotopoulosSati23
              %a.existingWikiWord{:href => "/nlab/show/Grigorios+Giotopoulos"}> Grigorios Giotopoulos
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Hisham+Sati"} Hisham Sati
              %em
                Field Theory via Higher Geometry I:
                %a.existingWikiWord{:href => "/schreiber/show/Smooth+Sets+of+Fields"} Smooth Sets of Fields
              \&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/2312.16301"}> arXiv:2312.16301
              \&amp;rbrack;
        .revisedby
