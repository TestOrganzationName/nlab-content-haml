                        %annotation{:encoding => "application/x-tex"} \{\tilde g_{j k}\}
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi h
                          %mi i
                        %mo{:lspace => "verythinmathspace"} :
                        %msub
                          %mi U
                          %mi i
                        %mo ⟶
                        %mi G
                      %annotation{:encoding => "application/x-tex"}
                        h_{i} \colon U_i \longrightarrow G
                %p such that on each intersection of charts
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi g
                          %mrow
                            %mi i
                            %mi j
                        %msub
                          %mi h
                          %mi j
                        %mo =
                        %msub
                          %mi h
                          %mi i
                        %msub
                          %mover
                            %mi g
