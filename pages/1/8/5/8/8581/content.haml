                          %mo ∧
                          %mstyle{:mathvariant => "bold"}
                            %mi d
                          %mi t
                          %mo +
                          %msub
                            %mi E
                            %mn 1
                          %mstyle{:mathvariant => "bold"}
                            %mi d
                          %msup
                            %mi x
                            %mn 1
                          %mo ∧
                          %mstyle{:mathvariant => "bold"}
                            %mi d
                          %mi t
                          %mo +
                      %mtr
                        %mtd
                        %mtd
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                          %msub
                            %mi B
                            %mn 1
                          %mstyle{:mathvariant => "bold"}
                            %mi d
                          %msup
                            %mi x
                            %mn 2
