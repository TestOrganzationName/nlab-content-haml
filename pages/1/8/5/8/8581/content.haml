              %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              a
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              of that of pre-smooth groupoids (the
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi PreSmooth
                    %mn 1
                    %mi Type
                  %annotation{:encoding => "application/x-tex"} X\in PreSmooth1Type
              and any Cartesian space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
