                            %mi B
                            %mn 2
                          %mstyle{:mathvariant => "bold"}
                            %mi d
                          %msup
                            %mi x
                            %mn 3
                          %mo ∧
                          %mstyle{:mathvariant => "bold"}
                            %mi d
                          %msup
                            %mi x
                            %mn 1
                          %mo +
                          %msub
                            %mi B
                            %mn 3
                          %mstyle{:mathvariant => "bold"}
                            %mi d
                          %msup
                            %mi x
                            %mn 1
                          %mo ∧
                          %mstyle{:mathvariant => "bold"}
                            %mi d
                          %msup
                            %mi x
                            %mn 2
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  F &amp; = \mathbf{d}A
                  \\\
                  \&amp; =
                  E_1 \mathbf{d}x^1 \wedge \mathbf{d}t
                  +
                  E_1 \mathbf{d}x^1 \wedge \mathbf{d}t
                  +
                  E_1 \mathbf{d}x^1 \wedge \mathbf{d}t
                  +
                  \\\
                  \&amp;
                  + B_1 \mathbf{d}x^2 \wedge \mathbf{d}x^3
                  + B_2 \mathbf{d}x^3 \wedge \mathbf{d}x^1
                  + B_3 \mathbf{d}x^1 \wedge \mathbf{d}x^2
                  \\end{aligned}
          %p
            with electric
            %a.existingWikiWord{:href => "/nlab/show/field+strength"} field strength
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi E
                    %mi i
                  %mo ∈
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mn 4
                  %mo{:stretchy => "false"} )
                  %msubsup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi i
                      %mo =
                      %mn 1
                    %mn 3
                %annotation{:encoding => "application/x-tex"} (E_i \in C^\infty(\mathbb{R}^4))_{i = 1}^3
            and magnetic
            %a.existingWikiWord{:href => "/nlab/show/field+strength"} field strength
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi B
                    %mi i
                  %mo ∈
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mn 4
                  %mo{:stretchy => "false"} )
                  %msubsup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi i
                      %mo =
                      %mn 1
                    %mn 3
                %annotation{:encoding => "application/x-tex"} (B_i \in C^\infty(\mathbb{R}^4))_{i = 1}^3
            given that is given by the
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+differential"} de Rham differential
            of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mi F
                          %mo =
                          %mstyle{:mathvariant => "bold"}
                            %mi d
                          %mi A
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  F = \mathbf{d}A
                  \\end{aligned}
                  \\,.
          %p
            After Maxwell it was thought that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo ∈
                  %msup
                    %mi Ω
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mn 4
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F \in \Omega^2(\mathbb{R}^4)
            alone genuinely reflects the configuration of the electromagnetic field. But with the discovery of
            %a.existingWikiWord{:href => "/nlab/show/quantum+mechanics"} quantum mechanics
            it became clear that it is indeed the potential
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            itself that reflects the configuration of the electromagnetic field: in the presence of
            %a.existingWikiWord{:href => "/nlab/show/magnetic+flux"} magnetic flux
            or other topoligical constraints, there can be different
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ,
                  %mi A
                  %mo ′
                %annotation{:encoding => "application/x-tex"} A, A'
            with the
            %em same
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo =
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %mi A
                  %mo =
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %mi A
                  %mo ′
                %annotation{:encoding => "application/x-tex"} F = \mathbf{d}A = \mathbf{d}A'
            which nevertheless describe experimentally distinguishable electromagnetic field configurations. (Distinguishable by the
            %a.existingWikiWord{:href => "/nlab/show/Aharonov-Bohm+effect"} Aharonov-Bohm effect
            and also to some extent by
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/Dirac+charge+quantization"} Dirac charge quantization
            %em
              %a{:href => "#CirclePrincipalConnections"} Circle-principal connections
            below.)
          %p
            However, not all different gauge potentials describe different physics. The actual configuration space of electromagnetism on a
            %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is finer than
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mstyle{:mathvariant => "bold"}
                      %mi Ω
                    %mi cl
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{\Omega}^2_{cl}(X)
            but coarser than
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{\Omega}^1(X)
            = succeed ":" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/smooth+groupoid"} smooth groupoid
          %p
            one finds that two electromagnetic potentials
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ,
                  %mi A
                  %mo ′
                  %mo ∈
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mn 4
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A, A' \in \Omega^1(\mathbb{R}^4)
            for which there is a function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                  %mo ∈
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mn 4
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \lambda \in C^\infty(\mathbb{R}^4)
            such that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ′
                  %mo =
                  %mi A
                  %mo +
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %mi λ
                %annotation{:encoding => "application/x-tex"}
                  A' = A + \mathbf{d}\lambda
          %p
            represent
            %em
              different but
              %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalent
            field configurations. One says that
            = succeed "." do
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                    %annotation{:encoding => "application/x-tex"} \lambda
                induces a
                %a.existingWikiWord{:href => "/nlab/show/gauge+transformation"} gauge transformation
                from
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} A'
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                  %mo{:lspace => "verythinmathspace"} :
                  %mi A
                  %mover
                    %mo →
                    %mo ≃
                  %mi A
                  %mo ′
                %annotation{:encoding => "application/x-tex"} \lambda \colon A \stackrel{\simeq}{\to} A'
            to reflect this.
          %p So the configuration space of electromagnetism does not just have points and coordinate systems. But it is also equipped with the information of a space of gauge transformations between any two coordinate systems laid out in it (which may be empty).
          %p
            To see what the structure of such a
            %em smooth gauge groupoid
            should be, notice that the above defines an
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            of smooth functions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                %annotation{:encoding => "application/x-tex"} \lambda
            on smooth
            = succeed "-forms" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          #ActionOfFunctionsOnForms.num_defn
            %h6#definition_10 Definition
            %p
              For any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} U \in
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi vert
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega^1_{vert}(X \times U)
              for the set of
              %a.existingWikiWord{:href => "/nlab/show/differential+1-forms"} differential 1-forms
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi U
                  %annotation{:encoding => "application/x-tex"} X \times U
              with no components along
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi U
                    %mo ,
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^\infty(X \times U , U(1))
              for the
              %a.existingWikiWord{:href => "/nlab/show/group"} group
              of
              %a.existingWikiWord{:href => "/nlab/show/circle+group"} circle group
              valued
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              of this group on the 1-forms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ρ
                      %mi U
                    %mo{:lspace => "verythinmathspace"} :
                    %msubsup
                      %mi Ω
                      %mi vert
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi U
                    %mo ,
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msubsup
                      %mi Ω
                      %mi vert
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\rho_U
                    \\colon
                    \\Omega^1_{vert}(X \times U) \times C^\infty(X \times U, U(1))
                    \\to
                    \\Omega^1_{vert}(X \times U)
            %p given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ρ
                      %mi U
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi λ
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mi A
                    %mo +
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi d
                      %mi X
                    %mi λ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\rho_U \colon (A,\lambda) \mapsto A + \mathbf{d}_X \lambda
                    \\,.
          %p
            Given such an action of a
            %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete group
            on a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/set"} set
            %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
            set
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi vert
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi U
                    %mo ,
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega^1_{vert}(X\times U)/C^\infty(X \times U, U(1))
            %a.existingWikiWord{:href => "/nlab/show/equivalence+classes"} equivalence classes
            of
            = succeed "-parameterized" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
