              and that all maps from the disks into
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              are required to be
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/embeddings"} embeddings
            %p
              On the other hand the
              = succeed "-stalk" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(\{U_i\})
              is the groupoid whose set of objects is the set of germs, in this sense, of the disjoint union
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                        %mi i
                      %msub
                        %mi U
                        %mi i
                    %annotation{:encoding => "application/x-tex"} \underset{i}{\coprod} U_i
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                        %mrow
                          %mi i
                          %mo ,
                          %mi j
                      %msub
                        %mi U
                        %mi i
                      %munder
                        %mo ×
                        %mi X
                      %msub
                        %mi U
                        %mi j
                    %annotation{:encoding => "application/x-tex"} \underset{i,j}{\coprod} U_i \underset{X}{\times} U_j
            %p
              But now since the cover is by
              %em
                %a.existingWikiWord{:href => "/nlab/show/open+subset"} open
              subsets, it follows that for every
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi i
                      %mo ,
                      %mi j
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                        %mrow
                          %mi i
                          %mo ,
                          %mi j
                      %msub
                        %mi U
                        %mi i
                      %munder
                        %mo ×
                        %mi X
                      %msub
                        %mi U
                        %mi j
                    %annotation{:encoding => "application/x-tex"} (x,i,j) \in \underset{i,j}{\coprod} U_i \underset{X}{\times} U_j
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi g
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [g]
              around
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x,i)
              has a representative
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              that factors through this double intersection charts:
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo{:lspace => "verythinmathspace"} :
                      %msubsup
                        %mi D
                        %mi r
                        %mi n
                      %mo →
                      %msub
                        %mi U
                        %mi i
                      %munder
                        %mo ×
                        %mi X
                      %msub
                        %mi U
                        %mi j
                      %mo →
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                        %mi i
                      %msub
                        %mi U
                        %mi u
                    %annotation{:encoding => "application/x-tex"} g \colon D^n_r \to U_i \underset{X}{\times} U_j \to \underset{i}{\coprod} U_u
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi j
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (x,j)
            %p
              This means that the groupoid of
              = succeed "-stalks" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+groupoids"} equivalent
              to the point.
            %p
              Now the canonical cover projection sends each of these connected components to the germ that it corresponds to. Hence this is a an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+groupoids"} equivalence of groupoids
          %h3#hypercovers Hypercovers
          #SplitHypercover.num_defn
            %h6#definition_8 Definition
            %p
              A morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Y
                    %mo ⟶
                    %mi X
                  %annotation{:encoding => "application/x-tex"} p \colon Y \longrightarrow X
              of pre-smooth groupoids is called a
              %a.existingWikiWord{:href => "/nlab/show/split+hypercover"} split hypercover
              if
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} Y
                  is
                %ol
                  %li
                    %p
                      degreewise a
                      %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
                      of
                      = succeed ";" do
                        %a.existingWikiWord{:href => "/nlab/show/Cartesian+spaces"} Cartesian spaces
                  %li
                    %p such that the degenerate elements split off as a dijoint summand.
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
                  is a weak equivalence, def.
                  = succeed "." do
                    %a.maruku-ref{:href => "#LocalWeakEquivalence"}
          #GoodCechCoverIsSplitHypercover.num_prop
            %h6#proposition_6 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U_i \to X\}
              an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} C(\{U_i\}) \to X
              from the corresponding
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Cech+groupoid"} Cech groupoid
              = succeed "," do
                %a.maruku-ref{:href => "#GroupoidOfCover"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good
          .proof
            %h6#proof_4 Proof
            %p
              For every cover the map is a weak equivalence, by prop.
              = succeed "." do
                %a.maruku-ref{:href => "#CoveringMapIsLocalWeakEquivalence"}
            %p
              For the Cech groupoid the condition of cofibrancy in def.
              %a.maruku-ref{:href => "#SplitHypercover"}
              means that every non-empty finite intersection of patches is
              %a.existingWikiWord{:href => "/nlab/show/diffeomorphism"} diffeomorphic
              to a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/open+ball"} open ball
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
          %h3#the_category_of_smooth_groupoids
            The
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (2,1)
          %p
            The
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
            %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
            of genuine smooth groupoids is that obtained from that of pre-smooth groupoids, def.
            %a.maruku-ref{:href => "#HomGroupoidsOfPreSmoothGroupoids"}
            by “universally turning local
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/weak+equivalences"} weak equivalences
            = succeed "," do
              %a.maruku-ref{:href => "#LocalWeakEquivalence"}
            = succeed "\u201D." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalences"} homotopy equivalences
            %a.maruku-ref{:href => "#SmoothGroupoidsBySimplicialLocalization"}
            below, but for many applications in practice certain concrete presentations of what this means concretely are well sufficient, one of these we state below in prop.
            = succeed "." do
              %a.maruku-ref{:href => "#HomGroupoidsOutOfCofibrantIntoFibrantGroupoidPresheaves"}
          #SmoothGroupoidsBySimplicialLocalization.num_defn
            %h6#definition_9 Definition
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Smooth
                    %mn 1
                    %mi Type
                    %mo ≔
                    %msub
                      %mi L
                      %mi lwe
                    %mi PreSmooth
                    %mn 1
                    %mi Type
                  %annotation{:encoding => "application/x-tex"}
                    Smooth1Type
                    \\coloneqq
                    L_{lwe} PreSmooth1Type
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/%282%2C1%29-category"} (2,1)-category
              which is the
              %a.existingWikiWord{:href => "/nlab/show/simplicial+localization"} simplicial localization
              of groupoid-valued presheaves at the local weak equivalences, def.
              = succeed "." do
                %a.maruku-ref{:href => "#LocalWeakEquivalence"}
            %p
              An
              %a.existingWikiWord{:href => "/nlab/show/object"} object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi Smooth
                    %mn 1
                    %mi Type
                  %annotation{:encoding => "application/x-tex"} X \in Smooth1Type
              we call a
              %strong
                %a.existingWikiWord{:href => "/nlab/show/smooth+groupoid"} smooth groupoid
              or
              = succeed "." do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/smooth+homotopy+type"} smooth homotopy 1-type
          #HomGroupoidsOutOfCofibrantIntoFibrantGroupoidPresheaves.num_prop
            %h6#proposition_7 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi A
                    %mo ∈
                    %mi PreSmooth
                    %mn 1
                    %mi Type
                  %annotation{:encoding => "application/x-tex"} X,A \in PreSmooth1Type
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              satisfies descent, def.
              = succeed "." do
                %a.maruku-ref{:href => "#DescentForPreSmoothGroupoids"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Y \to X
              be a
              %a.existingWikiWord{:href => "/nlab/show/split+hypercover"} split hypercover
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "." do
                %a.maruku-ref{:href => "#SplitHypercover"}
            %p
              Then there is an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+groupoids"} equivalence of groupoids
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Smooth
                    %mn 1
                    %mi Type
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi PreSmooth
                    %mn 1
                    %mi Type
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Smooth1Type(X,A)
                    \\simeq
                    PreSmooth1Type(Y,A)
            %p
              between the
              %a.existingWikiWord{:href => "/nlab/show/hom-groupoid"} hom-groupoid
              of smooth groupoids from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "," do
                %a.maruku-ref{:href => "#HomGroupoidsOfPreSmoothGroupoids"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
          %p
            Such statements follow with
            %a.existingWikiWord{:href => "/nlab/show/model+structures+on+simplicial+presheaves"} model structures on simplicial presheaves
            after embedding the present situation in the more general context of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/smooth+infinity-groupoids"} smooth infinity-groupoids
          #NotationForLocalization.num_remark
            %h6#remark_7 Remark
            %p There is a canonical localization functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PreSmooth
                    %mn 1
                    %mi Type
                    %mo ⟶
                    %msub
                      %mi L
                      %mi lwe
                    %mi PreSmooth
                    %mn 1
                    %mi Type
                    %mo =
                    %mi Smooth
                    %mn 1
                    %mi Type
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    PreSmooth1Type
                    \\longrightarrow
                    L_{lwe} PreSmooth1Type
                    \=
                    Smooth1Type
                    \\,.
            %p
              which is really just the identity as a functor. Instead of doing anything to the objects, passing along this functor just means to change the definition of the hom-groupoids from the direct definition of def.
              %a.maruku-ref{:href => "#HomGroupoidsOfPreSmoothGroupoids"}
              to the localized definition.
            %p
              When a pre-smooth groupoid is given by an
              %a.existingWikiWord{:href => "/nlab/show/internal+groupoid"} internal groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒢
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}_\bullet
              in
              %a.existingWikiWord{:href => "/nlab/show/smooth+sets"} smooth sets
              via example
              = succeed "," do
                %a.maruku-ref{:href => "#ExternalYonedaEmbeddingsIntoPreSmooth1Type"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Smooth
                    %mn 1
                    %mi Type
                  %annotation{:encoding => "application/x-tex"} Smooth1Type
              it no longer makes sense to ask what the space of 0-cells and of 1-cells of an object is, as these are concepts not invariant under local weak equivalence.
            %p
              In particular this means that we write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G
              for the image of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                  %annotation{:encoding => "application/x-tex"} (\mathbf{B}G)_\bullet
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Smooth
                      %mn 1
                      %mi Type
                    %annotation{:encoding => "application/x-tex"} Smooth1Type
          #StackMapsFromXtoDeloopingOfG.num_prop
            %h6#proposition_8 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G
              (example
              = succeed "," do
                %a.maruku-ref{:href => "#DeloopedGroupAsPreSmoothGroupoid"}
              = succeed ")." do
                %a.maruku-ref{:href => "#NotationForLocalization"}
            %p Then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Smooth
                    %mn 1
                    %mi Type
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi G
                    %mi Bund
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Smooth1Type(X,\mathbf{B}G)
                    \\simeq
                    G Bund(X)
            %p
              is equivalently the
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
              of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/principal+bundles"} principal bundles
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          .proof
            %h6#proof_5 Proof
            %p
              By prop.
              %a.maruku-ref{:href => "#bfBGbulletSatisfiesDescent"}
              the object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                  %annotation{:encoding => "application/x-tex"} (\mathbf{B}G)_\bullet
              satisfies descent on
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U_i \to X\}
              a differentiably
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
              %a.maruku-ref{:href => "#GoodCechCoverIsSplitHypercover"}
              the correspoding
              %a.existingWikiWord{:href => "/nlab/show/Cech+groupoid"} Cech groupoid
              projection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} C(\{U_i\}) \to X
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/split+hypercover"} split hypercover
              = succeed "." do
                %a.maruku-ref{:href => "#SplitHypercover"}
              = succeed "," do
                %a.maruku-ref{:href => "#HomGroupoidsOutOfCofibrantIntoFibrantGroupoidPresheaves"}
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+groupoids"} equivalence of groupoids
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Smooth
                    %mn 1
                    %mi Type
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi PreSmooth
                    %mn 1
                    %mi Type
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Smooth1Type(X,\mathbf{B}G)
                    \\simeq
                    PreSmooth1Type(C(\{U_i\}), (\mathbf{B}G)_\bullet)
                    \\,.
            %p
              The groupoid on the right is, by prop.
              = succeed "," do
                %a.maruku-ref{:href => "#CechCoyclesAsSmoothMaps"}
              %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech 1-cocycles and coboundaries
              with values in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              relative to a good open cover. This is equivalently the groupoid of
              = succeed "-principal" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
          .num_remark
            %h6#remark_8 Remark
            %p
              The content of prop.
              %a.maruku-ref{:href => "#StackMapsFromXtoDeloopingOfG"}
              is in common jargon that:
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                      %mo ∈
                      %mi SmoothGrpd
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}G \in SmoothGrpd
                is the
                %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
                of
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                = succeed "\u201C." do
                  %a.existingWikiWord{:href => "/nlab/show/principal+bundles"} principal bundles
          %h2#properties Properties
          %h3#embedding_into_smooth_groupoids
            Embedding into smooth
            = succeed "-groupoids" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            By generalizing here
            %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
            to general
            %a.existingWikiWord{:href => "/nlab/show/Kan+complexes"} Kan complexes
            and
            %a.existingWikiWord{:href => "/nlab/show/equivalences+of+groupoids"} equivalences of groupoids
            to
            %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalences"} homotopy equivalences
            of Kan complexes, one obtains
            %em
              smooth
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-stacks"} ∞-stacks
            or
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/smooth+%E2%88%9E-groupoids"} smooth ∞-groupoids
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                %annotation{:encoding => "application/x-tex"} \;\;\;
            %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} Smooth∞Grpd
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≔
                    %msub
                      %mi Sh
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi CartSp
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi L
                      %mi lhe
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %mi KanCplx
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \coloneqq Sh_{(\infty,1)}(CartSp) \simeq L_{lhe} Func(CartSp^{op}, KanCplx)
          %p
            We often write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo ≔
                %annotation{:encoding => "application/x-tex"} \mathbf{H} \coloneqq
            %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} Smooth∞Grpd
            for short.
          %p
            By the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Yoneda+lemma"} (∞,1)-Yoneda lemma
            there is a sequence of
            %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+%28%E2%88%9E%2C1%29-functor"} faithful inclusions
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                %annotation{:encoding => "application/x-tex"} \;\;\;
            %a.existingWikiWord{:href => "/nlab/show/SmoothMfd"} SmoothMfd
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ↪
                %annotation{:encoding => "application/x-tex"} \hookrightarrow
            %a.existingWikiWord{:href => "/nlab/show/SmoothGrpd"} SmoothGrpd
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ↪
                %annotation{:encoding => "application/x-tex"} \hookrightarrow
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} Smooth∞Grpd
          %p
            This induces a corresponding inclusion of
            %a.existingWikiWord{:href => "/nlab/show/simplicial+objects"} simplicial objects
            and hence of
            %a.existingWikiWord{:href => "/nlab/show/groupoid+objects+in+an+%28%E2%88%9E%2C1%29-category"} groupoid objects
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi LieGrpd
                  %mo ↪
                  %msub
                    %mi Grpd
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi SmoothMfd
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %msub
                    %mi Grpd
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi Smooth
                  %mn ∞
                  %mi Grpd
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  LieGrpd \hookrightarrow Grpd_\infty(SmoothMfd)  \hookrightarrow  Grpd_\infty(Smooth\infty Grpd)
                  \\,.
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒢
                    %mo •
                  %mo ∈
                  %msub
                    %mi Grpd
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{G}_\bullet \in Grpd_\infty(\mathbf{H})
            a groupoid object we write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒢
                    %mn 0
                  %mo →
                  %mi 𝒢
                  %mo ≔
                  %msub
                    %munder
                      %mi lim
                      %mo ⟶
                    %mi n
                  %msub
                    %mi 𝒢
                    %mi n
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{G}_0 \to \mathcal{G} \coloneqq \underset{\longrightarrow}{\lim}_{n} \mathcal{G}_n
          %p
            for its
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimit"} (∞,1)-colimiting
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cocone"} cocone
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒢
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathcal{G} \in \mathbf{H}
            (without subscript decoration) denotes the
            %a.existingWikiWord{:href => "/nlab/show/realization"} realization
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒢
                    %mo •
                %annotation{:encoding => "application/x-tex"} \mathcal{G}_\bullet
            as a single object in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
          %p
            By the
            %a.existingWikiWord{:href => "/nlab/show/Giraud-Rezk-Lurie+axioms"} Giraud-Rezk-Lurie axioms
            of the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            this morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒢
                    %mn 0
                  %mo →
                  %mi 𝒢
                %annotation{:encoding => "application/x-tex"} \mathcal{G}_0 \to \mathcal{G}
            is a
            %a.existingWikiWord{:href => "/nlab/show/1-epimorphism"} 1-epimorphism
            – an
            %a.existingWikiWord{:href => "/nlab/show/atlas"} atlas
            – and its construction establishes is an
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalence of (∞,1)-categories
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Grpd
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msubsup
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mn 1
                        %mi epi
                      %mrow
                        %msup
                          %mi Δ
                          %mn 1
                  %annotation{:encoding => "application/x-tex"} Grpd_\infty(\mathbf{H}) \simeq \mathbf{H}^{\Delta^1}_{1epi}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒢
                    %mo •
                  %mo →
                  %msub
                    %mi 𝒦
                    %mo •
                %annotation{:encoding => "application/x-tex"} \mathcal{G}_\bullet \to \mathcal{K}_\bullet
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Grpd
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Grpd_\infty(\mathbf{H})
            are equivalently
            %a.existingWikiWord{:href => "/nlab/show/diagrams"} diagrams
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mi 𝒢
                            %mn 0
                        %mtd
                          %mo →
                        %mtd
                          %msub
                            %mi 𝒦
                            %mn 0
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %mo ⇙
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi 𝒢
                        %mtd
                          %mo →
                        %mtd
                          %mi 𝒦
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\mathcal{G}_0 &amp;\to&amp; \mathcal{K}_0
                  \\\
                  \\downarrow &amp;\swArrow&amp; \downarrow
                  \\\
                  \\mathcal{G} &amp;\to&amp; \mathcal{K}
                  }
                  \\,.
          %p This is evidently more constrained that just morphisms
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒢
                  %mo →
                  %mi 𝒦
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{G} \to \mathcal{K}
          %p
            by themselves. The latter are the “generalized” or
            %a.existingWikiWord{:href => "/nlab/show/Morita+morphisms"} Morita morphisms
            between the groupoid objects
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒢
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}_\bullet
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒦
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \mathcal{K}_\bullet
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒢
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}_\bullet
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒦
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \mathcal{K}_\bullet
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/bibundles"} bibundles
          %h2#examples Examples
          %h3#zoo_of_concepts_subsumed_by_smooth_groupoids Zoo of concepts subsumed by smooth groupoids
          .num_example
            %h6#example_6 Example
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/smooth+space"} smooth space
              is canonically a
              %a.existingWikiWord{:href => "/nlab/show/smooth+groupoid"} smooth groupoid
              with only identity morphisms.
          .num_prop
            %h6#proposition_9 Proposition
            %p
              The canonical identification yields a
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Smooth
                    %mn 0
                    %mi Type
                    %mo ↪
                    %mi Smooth
                    %mn 1
                    %mi Type
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Smooth0Type \hookrightarrow Smooth1Type
                    \\,.
          %p
            Every
            %a.existingWikiWord{:href => "/nlab/show/Lie+groupoid"} Lie groupoid
            presents a smooth groupoids. Those of this form are also called
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/differentiable+stacks"} differentiable stacks
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/0-truncated"} 0-truncated
            smooth groupoid is equivalently a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/smooth+space"} smooth space
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/smooth+group"} smooth group
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{B}G
            is a smooth groupoid, the
            %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
            of smooth
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/principal+bundles"} principal bundles
          %h3#action_groupoids Action groupoids
          .num_example
            %h6#example_7 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              %a.existingWikiWord{:href => "/nlab/show/smooth+space"} smooth space
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              a
              %a.existingWikiWord{:href => "/nlab/show/smooth+group"} smooth group
              and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo :
                    %mi X
                    %mo ×
                    %mi G
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\rho : X \times G \to X
            %p
              an
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              then the
              %a.existingWikiWord{:href => "/nlab/show/action+groupoid"} action groupoid
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi G
                    %mo ∈
                    %mi Smooth
                    %mn 1
                    %mi Type
                  %annotation{:encoding => "application/x-tex"}
                    X // G \in Smooth1Type
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi G
                    %mo =
                    %mrow
                      %mo (
                      %mi X
