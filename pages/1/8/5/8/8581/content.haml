                  %annotation{:encoding => "application/x-tex"}
                    X // G =
                    \\left(
                    X \times G
                    \\stackrel{\overset{\rho}{\longrightarrow}}{\underset{p_1}{\longrightarrow}}
                    X
                    \\right)
            %p
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/smooth+groupoid"} smooth groupoid
          %h3#moduli_spaces_of_gauge_fields Moduli spaces of gauge fields
          %h4#groupoid_of_electromagnetic_field_configurations Groupoid of electromagnetic field configurations
          %p
            The mathematical concept of
            %em
              %a.existingWikiWord{:href => "/nlab/show/smooth+groupoid"} smooth groupoid
            is well familiar, in slight disguise, in the
            %a.existingWikiWord{:href => "/nlab/show/physics"} physics
            of basic
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/gauge+theory"} gauge theory
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/electromagnetism"} electromagnetism
            = succeed ")." do
              %a{:href => "#Eggersson14"} Eggersson 14
          %p
            We have seen in
            %em
              %a{:href => "#ElectromagneticFieldStrength"} The electromagnetic field strength
            that a configuration of the electromagnetic field on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mn 4
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^4
            is given by a
            %a.existingWikiWord{:href => "/nlab/show/differential+1-form"} differential 1-form
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mn 4
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \in \Omega^1(\mathbb{R}^4)
            = succeed "\u201D." do
              %a.existingWikiWord{:href => "/nlab/show/electromagnetic+potential"} electromagnetic potential
            %a.existingWikiWord{:href => "/nlab/show/field+strength"} field strength
            Lorentz tensor (with respect to the canonical
            %a.existingWikiWord{:href => "/nlab/show/coordinates"} coordinates
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo ,
                  %msup
                    %mi x
                    %mn 1
                  %mo ,
                  %msup
                    %mi x
                    %mn 2
                  %mo ,
                  %msup
                    %mi x
                    %mn 3
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi x
                    %mi i
                  %msubsup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi i
                      %mo =
                      %mn 1
                    %mn 4
                  %mo =
                %annotation{:encoding => "application/x-tex"} (t, x^1, x^2, x^3) \coloneqq (x^i)_{i = 1}^4 =
            on
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mn 4
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^4
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mi F
                        %mtd
                          %mo =
                          %mstyle{:mathvariant => "bold"}
                            %mi d
                          %mi A
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %msub
                            %mi E
                            %mn 1
                          %mstyle{:mathvariant => "bold"}
                            %mi d
                          %msup
                            %mi x
                            %mn 1
                          %mo ∧
                          %mstyle{:mathvariant => "bold"}
                            %mi d
                          %mi t
                          %mo +
