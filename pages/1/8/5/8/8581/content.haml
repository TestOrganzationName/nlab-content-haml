                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} )
