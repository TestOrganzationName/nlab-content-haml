          %h2#idea Idea
          %p
            Recall that a
            %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            is a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            that behaves likes the category
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/set"} sets
          %p
            A
            %strong natural numbers object
            (NNO) in a topos is an
            %a.existingWikiWord{:href => "/nlab/show/object"} object
            that behaves in that topos like the set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} \mathbb{N}
            of
            %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural numbers
            does in
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            %a.existingWikiWord{:href => "/nlab/show/set+theory"} set theory
            (such as
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/ETCS"} ETCS
            %a.existingWikiWord{:href => "/nlab/show/William+Lawvere"} William Lawvere
            (
            %a{:href => "#Law63"}> 1963
            ).
          %h2#definition Definition
          %h3#CCC In a topos or cartesian closed category
          %p
            A
            %strong natural numbers object
            in a
            %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            (or any
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+category"} cartesian closed category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            with
            %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            is
          %ul
            %li
              %p
                an
                %a.existingWikiWord{:href => "/nlab/show/object"} object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} \mathbb{N}
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
            %li
              %p equipped with
              %ul
                %li
                  %p
                    a
                    %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi z
                          %mo :
                          %mn 1
                          %mo →
                          %mi ℕ
                        %annotation{:encoding => "application/x-tex"} z :1 \to \mathbb{N}
                    from the
                    %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
                    = succeed ";" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mn 1
                          %annotation{:encoding => "application/x-tex"} 1
                %li
                  %p
