              %path{:d => "M -1.826031 20.781531 L -1.826031 -20.386437 ", :fill => "none", :stroke => "rgb(0%, 0%, 0%)", "stroke-linecap" => "butt", "stroke-linejoin" => "miter", "stroke-miterlimit" => "10", "stroke-opacity" => "1", "stroke-width" => "0.47818", :transform => "matrix(1, 0, 0, -1, 90.119, 42.262)"}
              %path{:d => "M -2.487983 2.867456 C -2.030951 1.148706 -1.019233 0.336206 0.00029875 0.00026875 C -1.019233 -0.335669 -2.030951 -1.148169 -2.487983 -2.870825 ", :fill => "none", :stroke => "rgb(0%, 0%, 0%)", "stroke-linecap" => "round", "stroke-linejoin" => "round", "stroke-miterlimit" => "10", "stroke-opacity" => "1", "stroke-width" => "0.47818", :transform => "matrix(0, 1, 1, 0, 88.2927, 62.88642)"}
              %g{:fill => "rgb(0%, 0%, 0%)", "fill-opacity" => "1"}
                %use{:x => "91.808", "xlink:href" => "#59LBD6UxK0KJvMh0p3MjiS-YHCc=-glyph-3-4", :y => "44.448"}
              %path{:d => "M 78.201313 20.781531 L 78.201313 -20.386437 ", :fill => "none", :stroke => "rgb(0%, 0%, 0%)", "stroke-linecap" => "butt", "stroke-linejoin" => "miter", "stroke-miterlimit" => "10", "stroke-opacity" => "1", "stroke-width" => "0.47818", :transform => "matrix(1, 0, 0, -1, 90.119, 42.262)"}
              %path{:d => "M -2.487983 2.8675 C -2.030951 1.14875 -1.019233 0.33625 0.00029875 0.0003125 C -1.019233 -0.335625 -2.030951 -1.148125 -2.487983 -2.870781 ", :fill => "none", :stroke => "rgb(0%, 0%, 0%)", "stroke-linecap" => "round", "stroke-linejoin" => "round", "stroke-miterlimit" => "10", "stroke-opacity" => "1", "stroke-width" => "0.47818", :transform => "matrix(0, 1, 1, 0, 168.32, 62.88642)"}
              %g{:fill => "rgb(0%, 0%, 0%)", "fill-opacity" => "1"}
                %use{:x => "171.835", "xlink:href" => "#59LBD6UxK0KJvMh0p3MjiS-YHCc=-glyph-3-4", :y => "44.448"}
              %path{:d => "M 10.341938 -33.058312 L 65.552875 -33.058312 ", :fill => "none", :stroke => "rgb(0%, 0%, 0%)", "stroke-linecap" => "butt", "stroke-linejoin" => "miter", "stroke-miterlimit" => "10", "stroke-opacity" => "1", "stroke-width" => "0.47818", :transform => "matrix(1, 0, 0, -1, 90.119, 42.262)"}
              %path{:d => "M -2.486969 2.870311 C -2.033844 1.147655 -1.018219 0.335155 0.0013125 -0.0007825 C -1.018219 -0.332814 -2.033844 -1.14922 -2.486969 -2.86797 ", :fill => "none", :stroke => "rgb(0%, 0%, 0%)", "stroke-linecap" => "round", "stroke-linejoin" => "round", "stroke-miterlimit" => "10", "stroke-opacity" => "1", "stroke-width" => "0.47818", :transform => "matrix(1, 0, 0, -1, 155.91275, 75.31953)"}
              %g{:fill => "rgb(0%, 0%, 0%)", "fill-opacity" => "1"}
                %use{:x => "125.214", "xlink:href" => "#59LBD6UxK0KJvMh0p3MjiS-YHCc=-glyph-3-5", :y => "85.754"}
          %h3#withparams In a category with finite products
          %p
            Note that this definition actually makes sense in any category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            having finite
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/product"} product
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/pretopos"} pretopos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            is not
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+category"} cartesian closed
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            is cartesian closed, such as when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            is a topos). What this amounts to is demanding that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi ℕ
                  %mo ,
                  %mi z
                  %mo ,
                  %mi s
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathbb{N}, z, s)
            not only be a natural numbers object (in the above, unparametrized sense) in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %a.existingWikiWord{:href => "/nlab/show/Kleisli+category"} Kleisli category
            of the
            %a.existingWikiWord{:href => "/nlab/show/comonad"} comonad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ↦
                  %mi A
                  %mo ×
                  %mi X
                %annotation{:encoding => "application/x-tex"} X \mapsto A \times X
            (which may be thought of as the category of maps parametrized by
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            gives rise to a canonical
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/self-indexing"} self-indexing
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/indexed+category"} indexed category
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
          %p To be explicit:
          .num_defn
            %h6#definition_2 Definition
            %p
              In a category with finite products, a
              %em parametrized natural numbers object
              is an object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              together with maps
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi z
                      %mo :
                      %mn 1
                      %mo →
                      %mi N
                    %annotation{:encoding => "application/x-tex"} z: 1 \to N
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo :
                    %mi N
                    %mo →
                    %mi N
                  %annotation{:encoding => "application/x-tex"} s: N \to N
              such that given any objects
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and maps
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi A
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} f: A \to X
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo :
                      %mi X
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} g: X \to X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mrow
                        %mi f
                        %mo ,
                        %mi g
                    %mo :
                    %mi A
                    %mo ×
                    %mi N
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \phi_{f, g}: A \times N \to X
              making the following diagram commute:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mo{:stretchy => "false"} ⟨
                                %msub
                                  %mn 1
                                  %mi A
                                %mo ,
                                %mi z
                                %mo ∘
                                %mo !
                                %mo{:stretchy => "false"} ⟩
                          %mtd
                            %mi A
                            %mo ×
                            %mi N
                          %mtd
                            %mover
                              %mo ←
                              %mrow
                                %msub
                                  %mn 1
                                  %mi A
                                %mo ×
                                %mi s
                          %mtd
                            %mi A
                            %mo ×
                            %mi N
                        %mtr
                          %mtd
                          %mtd
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi f
                            %mo ↘
                          %mtd
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %msub
                                  %mi ϕ
                                  %mrow
                                    %mi f
                                    %mo ,
                                    %mi g
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %msub
                                  %mi ϕ
                                  %mrow
                                    %mi f
                                    %mo ,
                                    %mi g
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi X
                          %mtd
                            %munder
                              %mo ←
                              %mi g
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A &amp; \stackrel{\langle 1_A, z \circ !\rangle}{\to} &amp; A \times N &amp; \stackrel{1_A \times s}{\leftarrow} &amp; A \times N \\
                    \&amp; \mathllap{f} \searrow &amp; \downarrow \mathrlap{\phi_{f, g}} &amp; &amp; \downarrow \mathrlap{\phi_{f, g}} \\
                    \&amp; &amp; X &amp; \underset{g}{\leftarrow} &amp; X
                    }
          %p
            In the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/internal+language"} internal language
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ϕ
                    %mrow
                      %mi f
                      %mo ,
                      %mi g
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi z
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \phi_{f,g}(a,z) = f(a)
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mrow
                        %mi f
                        %mo ,
                        %mi g
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi g
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ϕ
                      %mrow
                        %mi f
                        %mo ,
                        %mi g
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \phi_{f,g}(a,s(n)) = g(\phi_{f,g}(a,n))
          %p
            It may seem odd that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            only appears in the domain of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            and not
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            to the domain of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            as well:
          .num_prop
            %h6#proposition_2 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo ,
                    %mi z
                    %mo ,
                    %mi s
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (N,z,s)
              is a parametrized natural numbers object in a category with finite products, then for any objects
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with maps
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi A
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} f:A\to X
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo :
                      %mi A
                      %mo ×
                      %mi N
                      %mo ×
                      %mi X
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} g:A\times N\times X \to X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mrow
                        %mi f
                        %mo ,
                        %mi g
                    %mo :
                    %mi A
                    %mo ×
                    %mi N
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \phi_{f,g} : A\times N \to X
              such that, in the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/internal+language"} internal language
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mrow
                        %mi f
                        %mo ,
                        %mi g
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \phi_{f,g}(a,z) = f(a)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mrow
                        %mi f
                        %mo ,
                        %mi g
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi n
                    %mo ,
                    %msub
                      %mi ϕ
                      %mrow
                        %mi f
                        %mo ,
                        %mi g
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \phi_{f,g}(a,s(n)) = g(a,n,\phi_{f,g}(a,n))
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo :
                      %mi N
                    %annotation{:encoding => "application/x-tex"} n:N
          .proof
            %h6#proof Proof
            %p
              Let
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ′
                      %mo =
                      %mi A
                      %mo ×
                      %mi N
                      %mo ×
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X' = A\times N\times X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ′
                    %mo :
                    %mi A
                    %mo →
                    %mi X
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} f':A\to X'
              by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi z
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f'(a) = (a,z,f(a))
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ′
                    %mo :
                    %mi X
                    %mo ′
                    %mo →
                    %mi X
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} g':X'\to X'
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi n
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi n
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} g'(a,n,x) = (a,s(n),g(a,n,x)).
            %p
              Then the assumption gives
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo ′
                    %mo :
                    %mi A
                    %mo ×
                    %mi N
                    %mo →
                    %mi X
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \phi': A\times N \to X'
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi f
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi z
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mspace{:width => "2em"}
                    %mi ϕ
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi g
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} \phi'(a,z) = f'(a) = (a,z,f(a)), \qquad \phi'(a,s(n)) = g'(\phi'(a,n)).
            %p
              The composite
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ×
                    %mi N
                    %mover
                      %mo →
                      %mrow
                        %mi ϕ
                        %mo ′
                    %mi X
                    %mo ′
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi π
                          %mn 1
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A \times N \xrightarrow{\phi'} X' \xrightarrow{\pi_1} A
              satisfies
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mi ϕ
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi z
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi a
                    %mo ,
                    %mspace{:width => "2em"}
                    %msub
                      %mi π
                      %mn 1
                    %mi ϕ
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi π
                      %mn 1
                    %mi g
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi π
                      %mn 1
                    %mi ϕ
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} \pi_1 \phi'(a,z) = \pi_1(a,z,f(a)) = a, \qquad \pi_1\phi'(a,s(n)) = \pi_1 g'(\phi'(a,n)) = \pi_1 \phi'(a,n).
            %p
              Thus, by the uniqueness assumption, we have
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mi ϕ
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi a
                  %annotation{:encoding => "application/x-tex"} \pi_1 \phi'(a,n) = a
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ,
                      %mi n
                    %annotation{:encoding => "application/x-tex"} a,n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 2
                    %mi ϕ
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi n
                  %annotation{:encoding => "application/x-tex"} \pi_2 \phi'(a,n) = n
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ,
                      %mi n
                    %annotation{:encoding => "application/x-tex"} a,n
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi s
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi n
                      %mo ,
                      %mi g
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi n
                      %mo ,
                      %mi ϕ
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi n
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \phi'(a,s(n)) = (a,n,g(a,n,\phi'(a,n)))
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ×
                    %mi N
                    %mover
                      %mo →
                      %mrow
                        %mi ϕ
                        %mo ′
                    %mi X
                    %mo ′
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi π
                          %mn 3
                    %mi X
                  %annotation{:encoding => "application/x-tex"} A\times N  \xrightarrow{\phi'} X' \xrightarrow{\pi_3} X
              is the desired
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ϕ
                        %mrow
                          %mi f
                          %mo ,
                          %mi g
                    %annotation{:encoding => "application/x-tex"} \phi_{f,g}
          %p
            The functions which are constructible out of the structure of a category with finite products and such a “parametrized NNO” are precisely the
            %a.existingWikiWord{:href => "/nlab/show/partial+recursive+function"} primitive recursive
            ones. Specifically, the unique structure-preserving functor from the free such category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            into
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            yields a bijection between
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Hom
                    %mi F
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mi ℕ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Hom_F(1, \mathbb{N})
            and the actual natural numbers, as well as surjections from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Hom
                    %mi F
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℕ
                    %mi m
                  %mo ,
                  %mi ℕ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Hom_F(\mathbb{N}^m, \mathbb{N})
            onto the primitive recursive functions of arity
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                %annotation{:encoding => "application/x-tex"} m
            for each finite
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                  %annotation{:encoding => "application/x-tex"} m
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/partial+recursive+function"} Ackermann function
          %p
            In this context an important class is the class of
            %a.existingWikiWord{:href => "/nlab/show/pretopos"} pretoposes
            with a parametrized NNO - the so called
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/arithmetic+pretopos"} arithmetic pretoposes
          %h3#in_a_symmetric_monoidal_category In a symmetric monoidal category
          %p
            One could generalize the above definition of a parameterised natural numbers object to any
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
            %a.existingWikiWord{:href => "/nlab/show/pointed+objects+in+a+monoidal+category"} pointed objects in a symmetric monoidal category
            are represented by morphisms out of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/tensor+unit"} tensor unit
          .num_defn
            %h6#definition_3 Definition
            %p
              In a
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
              with
              %a.existingWikiWord{:href => "/nlab/show/tensor+unit"} tensor unit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
              and
              %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mi B
                      %mo{:stretchy => "false"} )
                      %mo ↦
                      %mi A
                      %mo ⊗
                      %mi B
                    %annotation{:encoding => "application/x-tex"} (A, B) \mapsto A \otimes B
              %em parametrized natural numbers object
              is an object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              together with maps
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi z
                      %mo :
                      %mn 1
                      %mo →
                      %mi N
                    %annotation{:encoding => "application/x-tex"} z: 1 \to N
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo :
                    %mi N
                    %mo →
                    %mi N
                  %annotation{:encoding => "application/x-tex"} s: N \to N
              such that given any objects
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and maps
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi A
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} f: A \to X
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo :
                      %mi X
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} g: X \to X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mrow
                        %mi f
                        %mo ,
                        %mi g
                    %mo :
                    %mi A
                    %mo ⊗
                    %mi N
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \phi_{f, g}: A \otimes N \to X
              making the following diagram commute:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                            %mo ⊗
                            %mn 1
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mn 1
                                  %mi A
                                %mo ×
                                %mi z
                          %mtd
                            %mi A
                            %mo ⊗
                            %mi N
                          %mtd
                            %mover
                              %mo ←
                              %mrow
                                %msub
                                  %mn 1
                                  %mi A
                                %mo ×
                                %mi s
                          %mtd
                            %mi A
                            %mo ⊗
                            %mi N
                        %mtr
                          %mtd
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %msub
                                  %mi ρ
                                  %mi A
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %msub
                                  %mi ϕ
                                  %mrow
                                    %mi f
                                    %mo ,
                                    %mi g
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %msub
                                  %mi ϕ
                                  %mrow
                                    %mi f
                                    %mo ,
                                    %mi g
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %munder
                              %mo →
                              %mi f
                          %mtd
                            %mi X
                          %mtd
                            %munder
                              %mo ←
                              %mi g
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A \otimes 1 &amp; \stackrel{1_A \times z}{\to} &amp; A \otimes N &amp; \stackrel{1_A \times s}{\leftarrow} &amp; A \otimes N \\
                    \\mathllap{\rho_A} \downarrow &amp; &amp; \downarrow \mathrlap{\phi_{f, g}} &amp; &amp; \downarrow \mathrlap{\phi_{f, g}} \\
                    A &amp; \underset{f}{\rightarrow} &amp; X &amp; \underset{g}{\leftarrow} &amp; X
                    }
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ρ
                      %mi A
                    %mo :
                    %mi A
                    %mo ⊗
                    %mn 1
                    %mo ≅
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \rho_A:A \otimes 1 \cong A
              is the
              %a.existingWikiWord{:href => "/nlab/show/right+unitor"} right unitor
              of the
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              for object
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
          %h3#in_type_theory In type theory
          %p
            For the moment see at
            %em
              %a.existingWikiWord{:href => "/nlab/show/inductive+type"} inductive type
            the section
            %em
              %a{:href => "inductive+type#NaturalNumbers"} Examples - Natural numbers
          %h2#finite_colimit_characterization Finite colimit characterization
          %p
            In a topos, the natural numbers object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} \mathbb{N}
            is uniquely characterized by the following
            %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
            conditions due to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Peter+Freyd"} Peter Freyd
          #Freyd.num_theorem
            %h6#theorem Theorem
            %p
              In a topos, a triple
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ℕ
                    %mo ,
                    %mn 0
                    %mo :
                    %mn 1
                    %mo →
                    %mi ℕ
                    %mo ,
                    %mi s
                    %mo :
                    %mi ℕ
                    %mo →
                    %mi ℕ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathbb{N}, 0: 1 \to \mathbb{N}, s: \mathbb{N} \to \mathbb{N})
              is a natural numbers object if and only if
            %ol
              %li
                %p
                  The morphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo ,
                        %mi s
                        %mo{:stretchy => "false"} )
                        %mo :
                        %mn 1
                        %mo +
                        %mi ℕ
                        %mo →
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} (0, s): 1 + \mathbb{N} \to \mathbb{N}
                  is an
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              %li
                %p The diagram
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℕ
                        %mover
                          %munder
                            %mo →
                            %mn 1
                          %mover
                            %mo →
                            %mi s
                        %mi ℕ
                        %mo →
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} \mathbb{N} \stackrel{\overset{s}{\to}}{\underset{1}{\to}} \mathbb{N} \to 1
                %p
                  is a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/coequalizer"} coequalizer
          %p The necessity of the first condition holds in any category with binary coproducts and a terminal object, and the necessity of the second holds in any category whatsoever.
          .proof
            %h6#proof_of_theorem__necessity
              Proof of theorem
              = succeed ":" do
                %a.maruku-ref{:href => "#Freyd"}
            %p
              For a category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              with binary coproducts and 1, the natural numbers object can be equivalently described as an
              %a.existingWikiWord{:href => "/nlab/show/initial+algebra"} initial algebra
              structure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mi s
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mn 1
                    %mo +
                    %mi ℕ
                    %mo →
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} (0, s): 1 + \mathbb{N} \to \mathbb{N}
              for the endofunctor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
                    %mo +
                    %mi c
                  %annotation{:encoding => "application/x-tex"} F(c) = 1 + c
              defined on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/initial+algebra+of+an+endofunctor"} Lambek's theorem
            %p
              As for condition 2, given
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi ℕ
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} f: \mathbb{N} \to X
              such that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo =
                      %mi f
                      %mo ∘
                      %mi s
                    %annotation{:encoding => "application/x-tex"} f = f \circ s
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              factors as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℕ
                    %mover
                      %mo →
                      %mo !
                    %mn 1
                    %mover
                      %mo →
                      %mi x
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathbb{N} \overset{!}{\to} 1 \overset{x}{\to} X
            %p
              for some unique
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
