                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 1
                      %mo +
                      %mi X
                    %annotation{:encoding => "application/x-tex"} F(X) = 1+X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              satisfies Freyd’s colimit conditions, then any
              = succeed "-subalgebra" do
