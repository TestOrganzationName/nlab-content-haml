                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              is the entirety of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                    %annotation{:encoding => "application/x-tex"} N
          .proof
            %h6#proof_2 Proof
            %p
              Following
              = succeed "," do
                %a{:href => "#Johnstone"} (Johnstone)
              = succeed "-subalgebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} N'
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              (the internal intersection of all
              = succeed "-subalgebras)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                    %annotation{:encoding => "application/x-tex"} N
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ↪
                    %mi N
                    %mo ×
                    %mi N
                  %annotation{:encoding => "application/x-tex"} S \hookrightarrow N \times N
              be the union of the relation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mn 1
                    %mo ,
                    %mi s
                    %mo{:stretchy => "false"} ⟩
                    %mo :
                    %mi N
                    %mo →
                    %mi N
                    %mo ×
                    %mi N
                  %annotation{:encoding => "application/x-tex"} R = \langle 1, s \rangle: N \to N \times N
              and its opposite, so that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is a symmetric relation. Working in the Mitchell-Bénabou language, one may check directly that the following formula is satisfied:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∀
                    %mi x
                    %mo ,
                    %mi y
                    %mo :
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} ⟨
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} ⟩
                    %mo ∈
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo ⇒
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ∈
                    %mi N
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo ⇔
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ∈
                    %mi N
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \forall x, y: N (\langle x, y \rangle \in S) \Rightarrow ((x \in N') \Leftrightarrow (y \in N'))
            %p
              Let us say a term
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi w
                  %annotation{:encoding => "application/x-tex"} w
              of type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mi N
                  %annotation{:encoding => "application/x-tex"} P N
              is
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %strong closed
              if the formula
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∀
                    %mi x
                    %mo ,
                    %mi y
                    %mo :
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} ⟨
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} ⟩
                    %mo ∈
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo ⇒
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %mi w
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo ⇔
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %mi w
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \forall x, y: N (\langle x, y \rangle \in S) \Rightarrow ((x \in [w]) \Leftrightarrow (y \in [w]))
            %p
              is satisfied. Now define a relation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              by the subobject
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} ⟨
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} ⟩
                    %mo ∈
                    %mi N
                    %mo ×
                    %mi N
                    %mo :
                    %mo ∀
                    %mi w
                    %mo :
                    %mi P
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi w
                    %mspace{:width => "thickmathspace"}
                    %mi is
                    %mspace{:width => "thickmathspace"}
                    %mi S
                    %mi closed
                    %mo{:stretchy => "false"} )
                    %mo ⇒
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %mi w
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo ⇔
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %mi w
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} \{\langle x, y \rangle \in N \times N: \forall w: P N (w \; is \; S closed) \Rightarrow ((x \in [w]) \Leftrightarrow (y \in [w])).
            %p
              Observe that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              is an equivalence relation that contains
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              and therefore
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
              and
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                    %annotation{:encoding => "application/x-tex"} s
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo →
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} N \to 1
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo ×
                      %mi N
                    %annotation{:encoding => "application/x-tex"} N \times N
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} N'
              is
              = succeed "-closed" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              = succeed "-closed" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∀
                    %mi x
                    %mo ,
                    %mi y
                    %mo ∈
                    %mi N
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ∈
                    %mi N
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo ⇔
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ∈
                    %mi N
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \forall x, y \in N: (x \in N') \Leftrightarrow (y \in N')
            %p
              so that, putting
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo =
                      %mn 0
                      %mo :
                      %mn 1
                      %mo →
                      %mi N
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} y = 0: 1 \to N'
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi N
                      %mo ⇒
                      %mi x
                      %mo ∈
                      %mi N
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} x \in N \Rightarrow x \in N'
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} N'
              is all of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                    %annotation{:encoding => "application/x-tex"} N
          .un_remark
            %h6#remark Remark
            %p
              A slightly alternative proof of sufficiency uses the theory of well-founded coalgebras, as given
              = succeed "." do
                %a{:href => "http://ncatlab.org/toddtrimble/published/Initial+algebras+and+terminal+coalgebras"} here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              is a fixpoint of the functor
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 1
                      %mo +
                      %mi X
                    %annotation{:encoding => "application/x-tex"} F(X) = 1+X
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/coalgebra+for+an+endofunctor"} coalgebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              is a natural numbers object
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} \mathbb{N}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℕ
                    %mo ↪
                    %mi N
                  %annotation{:encoding => "application/x-tex"} \mathbb{N} \hookrightarrow N
              can also be regarded as a subalgebra; by the lemma, it is all of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                    %annotation{:encoding => "application/x-tex"} N
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              is a natural numbers object.
          %h2#free_constructions_in_a_topos Free constructions in a topos
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/topos+theory"} topos theory
            the existence of a natural numbers object (NNO) has a couple of far-reaching consequences.
          %p
            Firstly, the existence of a NNO in a topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒮
                %annotation{:encoding => "application/x-tex"} \mathcal{S}
            is equivalent to the existence of
            %a.existingWikiWord{:href => "/nlab/show/free+object"} free
            unary systems in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}
            %a.existingWikiWord{:href => "/nlab/show/endomorphism"} endomorphism
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}
          #free_object_with_endomorphism_in_topos.num_prop
            %h6#proposition_3 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}
              be a topos and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi unsys
                    %mo{:stretchy => "false"} (
                    %mi 𝒮
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{unsys}(\mathcal{S})
              its category of internal unary systems. Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}
              has a NNO precisely if the forgetful functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo :
                    %mstyle{:mathvariant => "bold"}
                      %mi unsys
                    %mo{:stretchy => "false"} (
                    %mi 𝒮
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi 𝒮
                  %annotation{:encoding => "application/x-tex"} U:\mathbf{unsys}(\mathcal{S})\to \mathcal{S}
              has a left adjoint.
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi 𝒮
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi unsys
                  %mo{:stretchy => "false"} (
                  %mi 𝒮
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F:\mathcal{S}\to\mathbf{unsys}(\mathcal{S})
            be a left adjoint to the forgetful functor
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            be a terminal object in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F(1)
            is a NNO in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}
          %p
            Secondly, it is a theorem due to C. J. Mikkelsen that the existence of a NNO in a topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒮
                %annotation{:encoding => "application/x-tex"} \mathcal{S}
            is equivalent to the existence of
            %a.existingWikiWord{:href => "/nlab/show/free+monoid"} free monoids
            in
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}
          #free_monoids_in_topos.num_prop
            %h6#proposition_4 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}
              be a topos and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi mon
                    %mo{:stretchy => "false"} (
                    %mi 𝒮
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{mon}(\mathcal{S})
              its category of internal monoids. Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}
              has a NNO precisely if the forgetful functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo :
                    %mstyle{:mathvariant => "bold"}
                      %mi mon
                    %mo{:stretchy => "false"} (
                    %mi 𝒮
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi 𝒮
                  %annotation{:encoding => "application/x-tex"} U:\mathbf{mon}(\mathcal{S})\to \mathcal{S}
              has a left adjoint.
          %p
            For a proof see Johnstone (
            %a{:href => "#JT77"}> 1977
            ,p.190).
          %p
            It then is a theorem due to
            %a.existingWikiWord{:href => "/nlab/show/Andreas+Blass"} Andreas Blass
            (
            %a{:href => "#Blass"}> 1989
            ) that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒮
                %annotation{:encoding => "application/x-tex"} \mathcal{S}
            has a NNO precisely if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒮
                %annotation{:encoding => "application/x-tex"} \mathcal{S}
            has an
            %a.existingWikiWord{:href => "/nlab/show/classifying+topos+for+the+theory+of+objects"} object classifier
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                    %mo{:stretchy => "false"} [
                    %mi 𝕆
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}[\mathbb{O}]
          %p
            A consequence of this, discussed in sec. B4.2 of (Johnstone 2002,I p.431), is that
            %a.existingWikiWord{:href => "/nlab/show/classifying+topos"} classifying toposes
            for
            %a.existingWikiWord{:href => "/nlab/show/geometric+theories"} geometric theories
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒮
                %annotation{:encoding => "application/x-tex"} \mathcal{S}
            exist precisely if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒮
                %annotation{:encoding => "application/x-tex"} \mathcal{S}
            has a NNO.
          %p
            So from a different perspective, in a topos the existence of free objects over various gadgets like e.g.
            %a.existingWikiWord{:href => "/nlab/show/algebraic+theory"} algebraic theories
            or
            %a.existingWikiWord{:href => "/nlab/show/geometric+theory"} geometric theories
            (often) hinge on the existence of free unary systems or monoids, the intuition being that the free unary systems and free monoids permit to construct a free model
            %em syntactically
            by providing for the (syntactic) building blocks needed for this process.
          %p
            Notice that algebraic theories can nevertheless have free algebras even if the ambient topos lacks a NNO. This may happen for algebraic theories that have the property that the free algebra on a finite set of generators has a finite carrier e.g. in the topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi FinSet
                %annotation{:encoding => "application/x-tex"} FinSet
            of finite sets
            %a.existingWikiWord{:href => "/nlab/show/graphic+category"} free graphic monoids
            exist.
          %h2#examples Examples
          %p There are many examples of natural numbers objects.
          %h3#in_closed_symmetric_monoidal_categories In closed symmetric monoidal categories
          %p
          .num_remark
            %h6 Example
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} natural numbers
              are the natural numbers object in the
              %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Set"} Set
          %p
          .num_remark
            %h6 Example
            %p
              In
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/classical+mathematics"} classical mathematics
              %a.existingWikiWord{:href => "/nlab/show/extended+natural+numbers"} extended natural numbers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi ℕ
                      %mo ¯
                    %mo =
                    %mi ℕ
                    %mo +
                    %mo{:stretchy => "false"} {
                    %mn ∞
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \overline{\mathbb{N}} = \mathbb{N} + \{\infty\}
              are the
              %a.existingWikiWord{:href => "/nlab/show/natural+numbers+object"} natural numbers object
              in the closed symmetric monoidal category of
              %a.existingWikiWord{:href => "/nlab/show/pointed+sets"} pointed sets
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Set
                        %mo *
                    %annotation{:encoding => "application/x-tex"} Set_*
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                    %mo :
                    %mi 𝟚
                    %mo →
                    %mover
                      %mi ℕ
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"} z:\mathbb{2} \to \overline{\mathbb{N}}
              taking the
              %a.existingWikiWord{:href => "/nlab/show/boolean"} boolean
              %a.existingWikiWord{:href => "/nlab/show/true"} true
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
              and
              %a.existingWikiWord{:href => "/nlab/show/false"} false
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo :
                    %mover
                      %mi ℕ
                      %mo ¯
                    %mo →
                    %mover
                      %mi ℕ
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"} s:\overline{\mathbb{N}} \to \overline{\mathbb{N}}
              taking natural numbers to its successor and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive mathematics
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi ℕ
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"} \overline{\mathbb{N}}
              and the
              %a.existingWikiWord{:href => "/nlab/show/disjoint+union"} disjoint union
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℕ
                    %mo +
                    %mo{:stretchy => "false"} {
                    %mn ∞
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \mathbb{N} + \{\infty\}
              are no longer the same; it is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℕ
                    %mo +
                    %mo{:stretchy => "false"} {
                    %mn ∞
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \mathbb{N} + \{\infty\}
              which remains the natural numbers object in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Set
                        %mo *
                    %annotation{:encoding => "application/x-tex"} Set_*
          %p
          .num_remark
            %h6 Example
            %p
              The underlying abelian group of the
              %a.existingWikiWord{:href => "/nlab/show/polynomial+ring"} polynomial ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}[X]
              is the natural numbers object in the closed symmetric monoidal category
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                    %mo :
                    %mi ℤ
                    %mo →
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} z:\mathbb{Z} \to \mathbb{Z}[X]
              taking
              %a.existingWikiWord{:href => "/nlab/show/integers"} integers
              to
              %a.existingWikiWord{:href => "/nlab/show/constant+polynomials"} constant polynomials
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo :
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} s:\mathbb{Z}[X] \to \mathbb{Z}[X]
              multiplying polynomials by the indeterminant
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          %p
          .num_remark
            %h6 Example
            %p
              More generally, given a
              %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %a.existingWikiWord{:href => "/nlab/show/polynomial+ring"} polynomial ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} R[X]
              is the natural numbers object in the closed symmetric monoidal category
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/RMod"} RMod
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                    %mo :
                    %mi R
                    %mo →
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} z:R \to R[X]
              taking
              %a.existingWikiWord{:href => "/nlab/show/scalars"} scalars
              to
              %a.existingWikiWord{:href => "/nlab/show/constant+polynomials"} constant polynomials
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo :
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} s:R[X] \to R[X]
              multiplying polynomials by the indeterminant
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          %h3#ExamplesInASheafTopos In a sheaf topos
          %p
            In any
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topos"} Grothendieck topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo =
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E = Sh(C)
            the natural numbers object is given by the
            %a.existingWikiWord{:href => "/nlab/show/constant+sheaf"} constant sheaf
            on the
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            of ordinary natural numbers, i.e. by the
            %a.existingWikiWord{:href => "/nlab/show/sheafification"} sheafification
            of the
            %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mi op
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} C^{op} \to Set
            that is constant on the set
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \mathbb{N}
          %p
            There are interesting cases in which such sheaf toposes contain objects that look like they ought to be natural numbers objects but do not satisfy the above axioms: for instance some of the models described at
            %a.existingWikiWord{:href => "/nlab/show/Models+for+Smooth+Infinitesimal+Analysis"} Models for Smooth Infinitesimal Analysis
            are sheaf toposes that contain besides the standard natural number object a larger object of
            %strong
              %a.existingWikiWord{:href => "/nlab/show/smooth+natural+numbers"} smooth natural numbers
            that has
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/generalized+element"} generalized element
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/nonstandard+analysis"} nonstandard analysis
          %h2#properties Properties
          %h3#Transfer Transfer along inverse images
          .num_prop
            %h6#proposition_5 Proposition
            %p
              Natural number objects are preserved by
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/inverse+images"} inverse images
            %p
              let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi f
                      %mo *
                    %mo ⊣
                    %msub
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi ℰ
                    %munderover
                      %mo ⇆
                      %mrow
                        %msub
                          %mi f
                          %mo *
                      %mrow
                        %msup
                          %mi f
                          %mo *
                    %mi ℱ
                  %annotation{:encoding => "application/x-tex"} f = (f^* \dashv f_*) : \mathcal{E} \underoverset{f_*}{f^*}{\leftrightarrows} \mathcal{F}
              be a
              %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
              of toposes. If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℕ
                    %mo ∈
                    %mi ℱ
                  %annotation{:encoding => "application/x-tex"} \mathbb{N} \in \mathcal{F}
              is a natural numbers object, then its
              %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} f^* \mathbb{N}
              is a natural numbers object in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}
          %p
            (
            %a{:href => "#Johnstone"}> Johnstone, lemma A.4.1.14
            ). Of course, by the
            = succeed "," do
              %a{:href => "http://ncatlab.org/nlab/show/natural+numbers+object#finite_colimit_characterization_24"} finite colimit characterization
          .num_example
            %h6#example Example
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
              %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Δ
                      %mo ⊣
                      %mi Γ
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi ℰ
                      %munderover
                        %mo ⇆
                        %mi Γ
                        %mi Δ
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} (\Delta \dashv \Gamma): \mathcal{E} \underoverset{\Gamma}{\Delta}{\leftrightarrows} Set
              %a.existingWikiWord{:href => "/nlab/show/global+section"} global section
              geometric morphism, with the
              %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
              being the
              %a.existingWikiWord{:href => "/nlab/show/locally+constant+sheaf"} locally constant sheaf
              functor, it follows that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo{:stretchy => "false"} (
                    %mi ℕ
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mi Δ
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi n
                          %mo :
                          %mi ℕ
                      %mn 1
                      %mo )
                    %mo ≅
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi n
                        %mo :
                        %mi N
                    %mi Δ
                    %mn 1
                    %mo ≅
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi n
                        %mo :
                        %mi ℕ
                    %mn 1
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\Delta(\mathbb{N}) \cong \Delta\left(\sum_{n: \mathbb{N}} 1\right) \cong \sum_{n: N} \Delta 1 \cong \sum_{n: \mathbb{N}} 1,
            %p
              with the evident successor and constant
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} 0
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}
          .num_example
            %h6#example_2 Example
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              is a topos and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} X \in \mathcal{E}
              an object, then the
              %a.existingWikiWord{:href => "/nlab/show/slice+topos"} slice topos
              sits by an
              %a.existingWikiWord{:href => "/nlab/show/etale+geometric+morphism"} etale geometric morphism
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℰ
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi X
                    %mover
                      %munder
                        %mo →
                        %mrow
                          %msub
                            %mi X
                            %mo *
                      %mover
                        %mo ←
                        %mrow
                          %msup
                            %mi X
                            %mo *
                    %mi ℰ
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{E}_{/X}
                    \\stackrel{\overset{X^*}{\leftarrow}}{\underset{X_*}{\to}}
                    
                    \\mathcal{E}
                    \\,,
            %p
              where the
              %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
              form the
              %a.existingWikiWord{:href => "/nlab/show/product"} product
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℕ
                    %mo ∈
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathbb{N} \in \mathcal{E}
              a natural numbers object, the projection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi ℕ
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X \times \mathbb{N} \to X)
              is a natural numbers object in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℰ
                        %mrow
                          %mo{:stretchy => "false"} /
                          %mi X
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}_{/X}
          %h3#relation_to_rig_objects Relation to rig objects
          %p
            The initial
            %a.existingWikiWord{:href => "/nlab/show/rig"} rig
            object in a category with finite products, (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℕ
                  %mo ,
                  %mn 0
                  %mo :
                  %mn 1
                  %mo →
                  %mi ℕ
                  %mo ,
                  %mn 1
                  %mo :
                  %mn 1
                  %mo →
                  %mi ℕ
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %mo :
                  %mi ℕ
                  %mo ×
                  %mi ℕ
                  %mo →
                  %mi ℕ
                  %mo ,
                  %mo ×
                  %mo :
                  %mi ℕ
                  %mo ×
                  %mi ℕ
                  %mo →
                  %mi ℕ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbb{N},0:1\rightarrow\mathbb{N},1:1\rightarrow\mathbb{N},+:\mathbb{N}\times\mathbb{N}\rightarrow\mathbb{N},\times:\mathbb{N}\times\mathbb{N}\rightarrow\mathbb{N})
            with suitable commutative diagrams expressing the rig axioms and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/initial+object"} initiality
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ℕ
                    %mo ,
                    %mn 0
                    %mo :
                    %mn 1
                    %mo →
                    %mi ℕ
                    %mo ,
                    %mi x
                    %mo +
                    %mn 1
                    %mo :
                    %mi ℕ
                    %mo →
                    %mi ℕ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathbb{N}, 0:1\rightarrow\mathbb{N}, x+1:\mathbb{N}\rightarrow\mathbb{N})
          %h3#relation_to_object_of_integers Relation to object of integers
          %p
            Given a natural numbers object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} \mathbb{N}
            in a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/pretopos"} pretopos
            %a.existingWikiWord{:href => "/nlab/show/integers"} integers
            %a.existingWikiWord{:href => "/nlab/show/integers+object"} object
            as follows. Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:lspace => "verythinmathspace"} :
                  %mi E
                  %mo →
                  %mi ℕ
                  %mo ×
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} a, b\colon E \to \mathbb{N} \times \mathbb{N}
            be the
            %a.existingWikiWord{:href => "/nlab/show/kernel+pair"} kernel pair
            of the addition map
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mo{:lspace => "verythinmathspace"} :
                    %mi ℕ
                    %mo ×
                    %mi ℕ
                    %mo →
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} {+}\colon \mathbb{N} \times \mathbb{N} \to \mathbb{N}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 1
                  %mo ,
                  %msub
                    %mi π
                    %mn 2
                  %mo{:lspace => "verythinmathspace"} :
                  %mi ℕ
                  %mo ×
                  %mi ℕ
                  %mo →
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} \pi_1, \pi_2\colon \mathbb{N} \times \mathbb{N} \to \mathbb{N}
            be the
            %a.existingWikiWord{:href => "/nlab/show/product"} product
            projections. We define
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            to be the
            %a.existingWikiWord{:href => "/nlab/show/coequalizer"} coequalizer
            of the
            %a.existingWikiWord{:href => "/nlab/show/congruence"} congruence
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi π
                      %mn 1
                    %mo ∘
                    %mi a
                    %mo ,
                    %msub
                      %mi π
                      %mn 2
                    %mo ∘
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi π
                      %mn 1
                    %mo ∘
                    %mi b
                    %mo ,
                    %msub
                      %mi π
                      %mn 2
                    %mo ∘
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi E
                    %mo →
                    %mi ℕ
                    %mo ×
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} (\pi_1 \circ a, \pi_2 \circ b), (\pi_1 \circ b, \pi_2 \circ a)\colon E \to \mathbb{N} \times \mathbb{N}
            %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
            object
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Q}
          %p
            For a
            %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
            object, rather more care is needed; see
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/real+numbers+object"} real numbers object
