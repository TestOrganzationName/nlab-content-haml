              %li
                %a{:href => "#cocommutative_coassociative_coalgebras"} Cocommutative coassociative coalgebras
              %li
                %a{:href => "#properties"} Properties
              %ul
                %li
                  %a{:href => "#AsFilteredColimits"} As filtered colimits of finite-dimensional pieces
              %li
