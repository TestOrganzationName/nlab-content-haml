                %mrow
                  %mi Coalg
                %annotation{:encoding => "application/x-tex"} Coalg
            to be given by the functor taking
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %msub
                    %mi Alg
                    %mi f
                %annotation{:encoding => "application/x-tex"} A\in Alg_f
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi Alg
