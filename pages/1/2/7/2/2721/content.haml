                                %mrow
                                  %msub
                                    %mi d
                                    %mrow
                                      %mi CE
                                      %mo{:stretchy => "false"} (
                                      %mi 𝔤
                                      %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi d
