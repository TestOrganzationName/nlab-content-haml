                            %mo ←
                          %mtd
                            %mi inv
                            %mo{:stretchy => "false"} (
                            %mi 𝔞
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    0 &amp;&amp; \langle-\rangle &amp;\leftarrow &amp; \langle-\rangle
                    \\\
                    \\;\;\uparrow^{\mathrlap{d_{CE(\mathfrak{g})}}}
                    \&amp;&amp;
                    \\;\;\uparrow^{\mathrlap{d_{W(\mathfrak{g})}}}
                    \\\
                    \\mu &amp;\leftarrow&amp; cs
                    \\\
                    \\\
                    \\\
                    \\\
                    CE(\mathfrak{a})
                    \&amp;\leftarrow&amp;
                    W(\mathfrak{a})
                    \&amp;\leftarrow&amp;
