          %h2#idea Idea
          %p
            For every
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            or
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebra"} ∞-Lie algebra
            or
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebroid"} ∞-Lie algebroid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔞
                %annotation{:encoding => "application/x-tex"} \mathfrak{a}
            there is its
            %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi 𝔞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} CE(\mathfrak{a})
            and its
            %a.existingWikiWord{:href => "/nlab/show/Weil+algebra"} Weil algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mo{:stretchy => "false"} (
                  %mi 𝔞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} W(\mathfrak{a})
            and a canonical
            %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
            morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi 𝔞
                  %mo{:stretchy => "false"} )
                  %mo ←
                  %mi W
                  %mo{:stretchy => "false"} (
                  %mi 𝔞
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  CE(\mathfrak{a}) \leftarrow W(\mathfrak{a})
                  \\,.
          %p
            Recall that a
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebra+cohomology"} cocycle
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔞
                %annotation{:encoding => "application/x-tex"} \mathfrak{a}
            is a closed element in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CE(\mathfrak{a})
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mo{:stretchy => "false"} (
                  %mi 𝔞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} W(\mathfrak{a})
            that sits in the shifted copy
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∧
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi 𝔞
                      %mo *
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \wedge^\bullet (\mathfrak{a}^*[1])
          %p
            This means that for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi 𝔞
                  %annotation{:encoding => "application/x-tex"} X \in \mathfrak{a}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ι
                    %mi X
                  %mo :
                  %mi W
                  %mo{:stretchy => "false"} (
                  %mi 𝔞
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi W
                  %mo{:stretchy => "false"} (
                  %mi 𝔞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \iota_X : W(\mathfrak{a}) \to W(\mathfrak{a})
            the contraction derivation and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ad
                    %mi X
                  %mo :
                  %mo =
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi d
                    %mi W
                  %mo ,
                  %msub
                    %mi ι
                    %mi X
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} ad_X := [d_W, \iota_X]
            the corresponding
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lie+derivative"} Lie derivative
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ⟩
                  %mo ∈
                  %mi W
                  %mo{:stretchy => "false"} (
                  %mi 𝔞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \langle -\rangle \in W(\mathfrak{a})
            is invariant in the sense that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ad
                    %mi X
                  %mo{:stretchy => "false"} ⟨
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ⟩
                  %mo =
                  %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  ad_X \langle -\rangle = 0
                  \\,.
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔞
                  %mo =
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{a} = \mathfrak{g}
            an ordinary
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            is precisely a symmetric multilinear map on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            which is
            = succeed "-invariant" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ad
                  %annotation{:encoding => "application/x-tex"} ad
          %h2#definition Definition
          .num_defn
            %h6#definition_2 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔞
                  %annotation{:encoding => "application/x-tex"} \mathfrak{a}
              an
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebroid"} ∞-Lie algebroid
              (of finite type, i.e. degreewise of finite rank) with
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msup
                      %mo ∧
                      %mo •
                    %msup
                      %mi 𝔞
                      %mo *
                    %mo ,
                    %msub
                      %mi d
                      %mrow
                        %mi CE
                        %mo{:stretchy => "false"} (
                        %mi 𝔞
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    CE(\mathfrak{g}) = (\wedge^\bullet \mathfrak{a}^*, d_{CE(\mathfrak{a}}))
            %p
              and
              %a.existingWikiWord{:href => "/nlab/show/Weil+algebra"} Weil algebra
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi 𝔞
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msup
                      %mo ∧
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi 𝔞
                      %mo *
                    %mo ⊕
                    %msup
                      %mi 𝔞
                      %mo *
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi d
                      %mrow
                        %mi W
                        %mo{:stretchy => "false"} (
                        %mi 𝔞
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    W(\mathfrak{a}) = (\wedge^\bullet (\mathfrak{a}^* \oplus \mathfrak{a}^*[1]), d_{W(\mathfrak{a})})
            %p
              an
              %strong invariant polynomial
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔞
                  %annotation{:encoding => "application/x-tex"} \mathfrak{a}
              is an elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                    %mo ∈
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi 𝔞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \langle - \rangle \in W(\mathfrak{a})
              with the property that
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} ⟨
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} ⟩
                      %annotation{:encoding => "application/x-tex"} \langle - \rangle
                  is a wedge product of generators in the shifted copy of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi 𝔞
                          %mo *
                      %annotation{:encoding => "application/x-tex"} \mathfrak{a}^*
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi W
                          %mo{:stretchy => "false"} (
                          %mi 𝔞
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} W(\mathfrak{a})
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} ⟨
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} ⟩
                        %mo ∈
                        %msup
                          %mo ∧
                          %mo •
                        %msup
                          %mi 𝔞
                          %mo *
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"}
                        \\langle - \rangle \in \wedge^\bullet \mathfrak{a}^*[1]
                %p
                  or equivalently: for all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi 𝔞
                      %annotation{:encoding => "application/x-tex"} x \in \mathfrak{a}
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ι
                          %mi X
                        %mo :
                        %mi W
                        %mo{:stretchy => "false"} (
                        %mi 𝔞
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi W
                        %mo{:stretchy => "false"} (
                        %mi 𝔞
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \iota_X : W(\mathfrak{a}) \to W(\mathfrak{a})
                  the contraction
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ι
                          %mi x
                        %mo{:stretchy => "false"} ⟨
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} ⟩
                        %mo =
                        %mn 0
                        %mspace{:width => "thinmathspace"}
                        %mo ;
                      %annotation{:encoding => "application/x-tex"}
                        \\iota_x \langle -\rangle = 0
                        \\,;
              %li
                %p
                  it is closed in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi W
                        %mo{:stretchy => "false"} (
                        %mi 𝔞
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} W(\mathfrak{a})
                  in that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi d
                          %mrow
                            %mi W
                            %mo{:stretchy => "false"} (
                            %mi 𝔞
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} ⟨
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} ⟩
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} d_{W(\mathfrak{a})} \langle - \rangle = 0
                %p or more generally its differential is again in the shifted copy.
          .num_remark
            %h6#remark Remark
            %p This implies that for
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ad
                      %mi x
                    %mo :
                    %mo =
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi d
                      %mrow
                        %mi W
                        %mo{:stretchy => "false"} (
                        %mi 𝔞
                        %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi ι
                      %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    ad_x := [d_{W(\mathfrak{a})}, \iota_X]
            %p
              the
              %a.existingWikiWord{:href => "/nlab/show/Lie+derivative"} Lie derivative
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi 𝔞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} W(\mathfrak{a})
              along
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi 𝔞
                    %annotation{:encoding => "application/x-tex"} x \in \mathfrak{a}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔞
                  %annotation{:encoding => "application/x-tex"} \mathfrak{a}
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                      %mo{:stretchy => "false"} (
                      %mi 𝔞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} W(\mathfrak{a})
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ad
                      %mi x
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    ad_x \langle - \rangle = 0
            %p
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebra+cohomology"} ∞-Lie algebra cocycles
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo ∈
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mu \in CE(\mathfrak{g})
              which when regarded as elements in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} W(\mathfrak{g})
              are ad-invariant. But being entirely in the un-shifted copy,
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi μ
                      %mo ∈
                      %msup
                        %mo ∧
                        %mo •
                      %msup
                        %mi 𝔤
                        %mo *
                    %annotation{:encoding => "application/x-tex"} \mu \in \wedge^\bullet \mathfrak{g}^*
          #DecomposableInvPolynomial.num_defn
            %h6#definition_3 Definition
            %p
              We say an invariant polynomial is
              %em decomposable
              if it is the wedge product in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} W(\mathfrak{g})
              of two invariant polynomials of non-vanishing degree.
          #HorizontalEquivalence.num_defn
            %h6#definition_4 Definition
            %p
              Two invariant polynomials
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi P
                      %mn 1
                    %mo ,
                    %msub
                      %mi P
                      %mn 2
                    %mo ∈
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P_1, P_2 \in W(\mathfrak{g})
              are
              %em horizontally equivalent
              if there is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo ∈
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \omega \in ker(W(\mathfrak{g}) \to CE(\mathfrak{g}))
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi P
                      %mn 1
                    %mo =
                    %msub
                      %mi P
                      %mn 2
                    %mo +
                    %msub
                      %mi d
                      %mi W
                    %mi ω
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    P_1 = P_2 + d_W \omega
                    \\,.
          #DecomposablePolysAreHorizontallyTrivial.num_prop
            %h6#proposition Proposition
            %p
              Every decomposable invariant polynomial, def.
              = succeed "," do
                %a.maruku-ref{:href => "#DecomposableInvPolynomial"}
          .proof
            %h6#proof Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo =
                    %msub
                      %mi P
                      %mn 1
                    %mo ∧
                    %msub
                      %mi P
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} P = P_1 \wedge P_2
              be a wedge product of two indecomposable polynomials. Then there exists a
              %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+element"} Chern-Simons element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi cs
                      %mn 1
                    %mo ∈
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} cs_1 \in W(\mathfrak{g})
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mi W
                      %msub
                        %mi cs
                        %mn 1
                      %mo =
                      %msub
                        %mi P
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} d_W cs_1 = P_1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi P
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} P_2
              is in non-vanishing degree and hence in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ker(W(\mathfrak{g}) \to CE(\mathfrak{g}))
              it follows that
            %ol
              %li
                %p
                  also
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi cs
                          %mn 1
                        %mo ∧
                        %msub
                          %mi P
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} cs_1 \wedge P_2
                  is in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ker
                        %mo{:stretchy => "false"} (
                        %mi W
                        %mo{:stretchy => "false"} (
                        %mi 𝔤
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi CE
                        %mo{:stretchy => "false"} (
                        %mi 𝔤
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} ker(W(\mathfrak{g}) \to CE(\mathfrak{g}))
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi d
                          %mi W
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi cs
                          %mn 1
                        %mo ∧
                        %msub
                          %mi P
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mo =
                        %msub
                          %mi P
                          %mn 1
                        %mo ∧
                        %msub
                          %mi P
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} d_W (cs_1 \wedge P_2) = P_1 \wedge P_2
                  \.
            %p
              Therefore
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi cs
                      %mn 1
                    %mo ∧
                    %msub
                      %mi P
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} cs_1 \wedge P_1
              exhibits a horizontal equivalence
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi P
                        %mn 1
                      %mo ∧
                      %msub
                        %mi P
                        %mn 2
                      %mo ∼
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} P_1 \wedge P_2 \sim 0
          #ClassesOfInvPolysFormGradedVectorSpace.num_prop
            %h6#observation Observation
            %p
              Horizontal equivalence classes of invariant polynomials on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              form a
              %a.existingWikiWord{:href => "/nlab/show/graded+vector+space"} graded vector space
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi inv
                      %mo{:stretchy => "false"} (
                      %mi 𝔤
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi V
                    %annotation{:encoding => "application/x-tex"} inv(\mathfrak{g})_V
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi inv
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi V
                    %mo ↪
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    inv(\mathfrak{g})_V \hookrightarrow W(\mathfrak{g})
            %p unique up to horizontal equivalence, that sends each horizontal equivalence class to a representative.
          .num_remark
            %h6#remark_2 Remark
            %p
              By prop.
              %a.maruku-ref{:href => "#DecomposablePolysAreHorizontallyTrivial"}
              it follows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi inv
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi V
                  %annotation{:encoding => "application/x-tex"} inv(\mathfrak{g})_V
              contains only indecomposable invariant polynomials.
          .num_defn
            %h6#definition_5 Definition
            %p
              We write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi inv
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} inv(\mathfrak{g})
              for the
              %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
              whose underlying
              %a.existingWikiWord{:href => "/nlab/show/graded+algebra"} graded algebra
              is the
              %a.existingWikiWord{:href => "/nlab/show/free+construction"} free
              graded algebra on the
              %a.existingWikiWord{:href => "/nlab/show/graded+vector+space"} graded vector space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi inv
                      %mo{:stretchy => "false"} (
                      %mi 𝔤
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi V
                    %annotation{:encoding => "application/x-tex"} inv(\mathfrak{g})_V
              %a.existingWikiWord{:href => "/nlab/show/differential"} differential
              is trivial.
            %p
              Since invariant polynomials are closed, the inclusion of graded vector spaces from observation
              %a.maruku-ref{:href => "#ClassesOfInvPolysFormGradedVectorSpace"}
              induces an inclusion (
              %a.existingWikiWord{:href => "/nlab/show/monomorphism"}> monomorphism
              ) of dg-algebras
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi inv
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    inv(g) \hookrightarrow W(g)
                    \\,.
          %h2#examples Examples
          %h3#OnLieAlgebras On Lie algebras
          .num_lemma
            %h6#observation_2 Observation
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
          .proof
            %h6#proof_2 Proof
            %p
              To see this explicitly, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi t
                      %mi a
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{t^a\}
              be a basis of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔤
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}^*
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi r
                      %mi a
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{r^a\}
              the corresponding basis of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝔤
                        %mo *
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}^*[1]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi C
                      %mi a
                    %msub
                      %mrow
                      %mrow
                        %mi b
                        %mi c
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{C^a{}_{b c}\}
              for the structure constants of the Lie bracket in this basis.
            %p
              Then for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo =
                    %msub
                      %mi P
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi a
                          %mn 1
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %msub
                          %mi a
                          %mi k
                        %mo{:stretchy => "false"} )
                    %msup
                      %mi r
                      %mrow
                        %msub
                          %mi a
                          %mn 1
                    %mo ∧
                    %mi ⋯
                    %mo ∧
                    %msup
                      %mi r
                      %mrow
                        %msub
                          %mi a
                          %mi k
                    %mo ∈
                    %msup
                      %mo ∧
                      %mi r
                    %msup
                      %mi 𝔤
                      %mo *
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} P = P_{(a_1 , \cdots , a_k)} r^{a_1} \wedge \cdots \wedge r^{a_k} \in \wedge^{r} \mathfrak{g}^*[1]
              an element in the shifted generators, the condition that it is
              = succeed "-closed" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mrow
                          %mi W
                          %mo{:stretchy => "false"} (
                          %mi 𝔤
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} d_{W(\mathfrak{g})}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi C
                      %mrow
                        %mi c
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi a
                          %mn 1
                      %mi b
                    %msub
                      %mi P
                      %mrow
                        %mi b
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %msub
                          %mi a
                          %mi k
                        %mo{:stretchy => "false"} )
                    %msup
                      %mi t
                      %mi c
                    %mo ∧
                    %msup
                      %mi r
                      %mrow
                        %msub
                          %mi a
                          %mn 1
                    %mo ∧
                    %mi ⋯
                    %mo ∧
                    %msup
                      %mi r
                      %mrow
                        %msub
                          %mi a
                          %mi k
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    C^{b}_{c (a_1} P_{b, \cdots, a_k)} t^c \wedge r^{a_1} \wedge \cdots \wedge r^{a_k}
                    \\,,
            %p where the parentheses around indices denotes symmetrization, as usual, so that this is equivalent to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi i
                    %msubsup
                      %mi C
                      %mrow
                        %mi c
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi a
                          %mi i
                      %mi b
                    %msub
                      %mi P
                      %mrow
                        %msub
                          %mi a
                          %mn 1
                        %mi ⋯
                        %msub
                          %mi a
                          %mrow
                            %mi i
                            %mo −
                            %mn 1
                        %mi b
                        %msub
                          %mi a
                          %mrow
                            %mi i
                            %mo +
                            %mn 1
                        %mi ⋯
                        %mo ,
                        %msub
                          %mi a
                          %mi k
                        %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\sum_{i} C^{b}_{c (a_i} P_{a_1 \cdots a_{i-1} b a_{i+1} \cdots, a_k)}
                    \= 0
            %p for all choice of indices. This is the component-version of the familiar invariance statement
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi i
                    %mi P
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi t
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi t
                      %mrow
                        %mi i
                        %mo −
                        %mn 1
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi t
                      %mi c
                    %mo ,
                    %msub
                      %mi t
                      %mi i
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %msub
                      %mi t
                      %mrow
                        %mi i
                        %mo +
                        %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi t
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\sum_i P(t_1, \cdots, t_{i-1}, [t_c, t_i], t_{i+1}, \cdots , t_k)
                    \= 0
            %p
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi t
                        %mo •
                      %mo ∈
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} t_\bullet \in  \mathfrak{g}
          %h3#SemisimpLie On semisimple Lie algebras
          %p
            See
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Killing+form"} Killing form
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/string+Lie+2-algebra"} string Lie 2-algebra
          %h3#on_tangent_lie_algebroids On tangent Lie algebroids
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            %a.existingWikiWord{:href => "/nlab/show/tangent+Lie+algebroid"} tangent Lie algebroid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔞
                  %mo =
                  %mi T
                  %mi X
                %annotation{:encoding => "application/x-tex"} \mathfrak{a} = T X
            is precisely a closed
            %a.existingWikiWord{:href => "/nlab/show/differential+form"} differential form
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %h3#OnStringLie2Algebra On the string Lie 2-algebra
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            a
            %a.existingWikiWord{:href => "/nlab/show/semisimple+Lie+algebra"} semisimple Lie algebra
            let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi μ
                    %mn 3
                  %mo :
                  %mo =
                  %mo{:stretchy => "false"} ⟨
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} \mu_3 := \langle -,[-,-]\rangle
            be the canonical
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+cocycle"} Lie algebra cocycle
            in degree 3, which is the one in
            %a.existingWikiWord{:href => "/nlab/show/transgression"} transgression
            with the
            %a.existingWikiWord{:href => "/nlab/show/Killing+form"} Killing form
            invariant polynomial
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle -,-\rangle
          %p
            Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔤
                    %mrow
                      %msub
                        %mi μ
                        %mn 3
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}_{\mu_3}
            for the corresponding
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/string+Lie+2-algebra"} string Lie 2-algebra
            %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi 𝔤
                    %mrow
                      %msub
                        %mi μ
                        %mn 3
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} CE(\mathfrak{g}_{\mu_3})
            is given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi CE
                  %msup
                    %mi t
                    %mi a
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mfrac
                    %mn 1
                    %mn 2
                  %msup
                    %mi C
                    %mi a
                  %msub
                    %mrow
                    %mrow
                      %mi b
                      %mi c
                  %msup
                    %mi t
                    %mi b
                  %mo ∧
                  %msup
                    %mi t
                    %mi c
                %annotation{:encoding => "application/x-tex"}
                  d_{CE} t^a = - \frac{1}{2}C^a{}_{b c} t^b \wedge t^c
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi CE
                  %mi b
                  %mo =
                  %msub
                    %mi μ
                    %mn 3
                %annotation{:encoding => "application/x-tex"}
                  d_{CE} b = \mu_3
          %p
            and the
            %a.existingWikiWord{:href => "/nlab/show/Weil+algebra"} Weil algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi 𝔤
                    %mrow
                      %msub
                        %mi μ
                        %mn 3
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} W(\mathfrak{g}_{\mu_3})
            is given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi W
                  %msup
                    %mi t
                    %mi a
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mfrac
                    %mn 1
                    %mn 2
                  %msup
                    %mi C
                    %mi a
                  %msub
                    %mrow
                    %mrow
                      %mi b
                      %mi c
                  %msup
                    %mi t
                    %mi b
                  %mo ∧
                  %msup
                    %mi t
                    %mi c
                  %mo +
                  %msup
                    %mi r
                    %mi a
                %annotation{:encoding => "application/x-tex"}
                  d_W t^a = - \frac{1}{2}C^a{}_{b c} t^b \wedge t^c + r^a
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi W
                  %mi b
                  %mo =
                  %msub
                    %mi μ
                    %mn 3
                  %mo −
                  %mi h
                %annotation{:encoding => "application/x-tex"}
                  d_W b = \mu_3 - h
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi W
                  %msup
                    %mi r
                    %mi a
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msubsup
                    %mi C
                    %mrow
                      %mi b
                      %mi c
                    %mi a
                  %msup
                    %mi t
                    %mi b
                  %mo ∧
                  %msup
                    %mi r
                    %mi c
                %annotation{:encoding => "application/x-tex"}
                  d_W r^a = - C^a_{b c} t^b \wedge r^c
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi W
                  %mi h
                  %mo =
                  %msub
                    %mi d
                    %mi W
                  %msub
                    %mi μ
                    %mn 3
                  %mo =
                  %mi σ
                  %msub
                    %mi μ
                    %mn 3
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  d_W h = d_W \mu_3 = \sigma \mu_3
                  \\,,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                %annotation{:encoding => "application/x-tex"} \sigma
            acts by degree shift isomorphism on unshifted generators.
          %p It follows at once that every invariant polynomial
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo =
                  %msub
                    %mi P
                    %mrow
                      %msub
                        %mi a
                        %mn 1
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %msub
                        %mi a
                        %mi n
                  %msup
                    %mi r
                    %mrow
                      %msub
                        %mi a
                        %mn 1
                  %mo ∧
                  %mi ⋯
                  %mo ∧
                  %msup
                    %mi r
                    %mrow
                      %msub
                        %mi a
                        %mi n
                %annotation{:encoding => "application/x-tex"}
                  P = P_{a_1, \cdots, a_n} r^{a_1} \wedge \cdots \wedge r^{a_n}
          %p
            on the Lie algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            canonically identifies also with an invariant polynomial of the string Lie 2-algebra. But the differnce is that the
            %a.existingWikiWord{:href => "/nlab/show/Killing+form"} Killing form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ⟩
                  %mo :
                  %mo =
                  %msub
                    %mi P
                    %mrow
                      %mi a
                      %mi b
                  %msup
                    %mi r
                    %mi a
                  %mo ∧
                  %msup
                    %mi r
                    %mi b
                %annotation{:encoding => "application/x-tex"} \langle -,- \rangle := P_{a b} r^a \wedge r^b
            is non-trivial as a polynomial on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔤
                    %mrow
                      %msub
                        %mi μ
                        %mn 3
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}_{\mu_3}
            becomes horizontally equivalent ,def.
            = succeed ")," do
              %a.maruku-ref{:href => "#HorizontalEquivalence"}
          .num_prop
            %h6#proposition_2 Proposition
            %p
              On the
              %a.existingWikiWord{:href => "/nlab/show/string+Lie+2-algebra"} string Lie 2-algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔤
                      %mrow
                        %msub
                          %mi μ
                          %mn 3
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}_{\mu_3}
              the
              %a.existingWikiWord{:href => "/nlab/show/Killing+form"} Killing form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle -,-\rangle
              is horizontally equivalent to 0.
          .proof
            %h6#proof_3 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi cs
                      %mn 3
                    %mo ∈
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} cs_3 \in W(\mathfrak{g})
              be any
              %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+element"} Chern-Simons element
              for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ⟩
                    %annotation{:encoding => "application/x-tex"} \langle -,- \rangle
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msub
                          %mi cs
                          %mn 3
                        %msub
                          %mo{:stretchy => "false"} |
                          %mrow
                            %mi CE
                            %mo{:stretchy => "false"} (
                            %mi 𝔤
                            %mo{:stretchy => "false"} )
                        %mo =
                        %msub
                          %mi μ
                          %mn 3
                      %annotation{:encoding => "application/x-tex"} cs_3|_{CE(\mathfrak{g})} = \mu_3
                  ;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msub
                          %mi d
                          %mi W
                        %msub
                          %mi cs
                          %mn 3
                        %mo =
                        %mo{:stretchy => "false"} ⟨
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} ⟩
                      %annotation{:encoding => "application/x-tex"} d_W cs_3 = \langle -,- \rangle
                  \.
            %p
              Then notice that by the above we have in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝔤
                      %mrow
                        %msub
                          %mi μ
                          %mn 3
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} W(\mathfrak{g}_{\mu_3})
              that the differential of the new generator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
              is equal to that of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi μ
                        %mn 3
                    %annotation{:encoding => "application/x-tex"} \mu_3
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi W
                    %mi h
                    %mo =
                    %msub
                      %mi d
                      %mi W
                    %msub
                      %mi μ
                      %mn 3
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    d_W h = d_W \mu_3
                    \\,.
            %p
              We on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔤
                      %mrow
                        %msub
                          %mi μ
                          %mn 4
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}_{\mu_4}
              we can replace
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} \mu_3
              by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
              and still get a
              %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+element"} Chern-Simons element
              for the Killing form:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi cs
                        %mo{:stretchy => "false"} ˜
                      %mn 3
                    %mo :
                    %mo =
                    %msub
                      %mi cs
                      %mn 3
                    %mo −
                    %msub
                      %mi μ
                      %mn 3
                    %mo +
                    %mi h
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde cs_3 := cs_3 - \mu_3 + h
                    \\,.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi W
                    %msub
                      %mover
                        %mi cs
                        %mo{:stretchy => "false"} ˜
                      %mn 3
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    d_W \tilde cs_3 = \langle -,- \rangle
                    \\,.
            %p
              But while
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} \mu_3
              is not in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ker
                      %mo{:stretchy => "false"} (
                      %mi W
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi 𝔤
                        %mrow
                          %msub
                            %mi μ
                            %mn 3
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi CE
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi 𝔤
                        %mrow
                          %msub
                            %mi μ
                            %mn 3
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} ker(W(\mathfrak{g}_{\mu_3}) \to CE(\mathfrak{g}_{\mu_3}))
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
              is, by definition. Therefore
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi cs
                        %mo{:stretchy => "false"} ˜
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} \tilde cs_3
              is in that kernel, and hence exhibits a horizontal equivalence between
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle -,- \rangle
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} 0
          %p
            This is a special case of the more general statement below, about
            = succeed "." do
              %a{:href => "OnShiftedCentralExtenstions"} invariant polynomials on shifted central extensions
          %p For illustration purposes it is useful to consider the following variant of this example:
          .num_defn
            %h6#definition_6 Definition
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mi ℝ
                    %mo →
                    %mi 𝔰𝔱𝔯𝔦𝔫𝔤
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msub
                      %mi L
                      %mn ∞
                    %mi Alg
                  %annotation{:encoding => "application/x-tex"}
                    (b \mathbb{R} \to \mathfrak{string}) \in L_\infty Alg
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra"} L-∞ algebra
              defined by the fact that its
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
              is given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi CE
                    %msup
                      %mi t
                      %mi a
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mfrac
                      %mn 1
                      %mn 2
                    %msup
                      %mi C
                      %mi a
                    %msub
                      %mrow
                      %mrow
                        %mi b
                        %mi c
                    %msup
                      %mi t
                      %mi b
                    %mo ∧
                    %msup
                      %mi t
                      %mi c
                  %annotation{:encoding => "application/x-tex"}
                    d_{CE} t^a = - \frac{1}{2} C^a{}_{b c} t^b \wedge t^c
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi CE
                    %mi b
                    %mo =
                    %msub
                      %mi μ
                      %mn 3
                    %mo −
                    %mi c
                  %annotation{:encoding => "application/x-tex"}
                    d_{CE} b = \mu_3 - c
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi CE
                    %mi c
                    %mo =
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    d_{CE} c = 0
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi t
                      %mi a
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{t^a\}
              is a dual basis in degree 1 for some
              %a.existingWikiWord{:href => "/nlab/show/semisimple+Lie+algebra"} semisimple Lie algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              as above,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              are generators in degree 2 and 3, respectively, and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mn 3
                    %mo ∝
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \mu_3 \propto \langle -,[-,-]\rangle
              is the canonical
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+cohomology"} Lie algebra cocycle
              in degree 3, as above.
          %p It is easily seen that
          .num_prop
            %h6#observation_3 Observation
            %p The canonical morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mi ℝ
                    %mo →
                    %mi 𝔰𝔱𝔯𝔦𝔫𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathfrak{g} \to (b \mathbb{R} \to \mathfrak{string})
            %p given dually by sending
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi t
                      %mi a
                    %mo ↦
                    %msup
                      %mi t
                      %mi a
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mi b
                    %mo ↦
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mi c
                    %mo ↦
                    %msub
                      %mi μ
                      %mn 3
                  %annotation{:encoding => "application/x-tex"}
                    t^a \mapsto t^a\,,\,\,\, b \mapsto 0\,,\, \,\, c \mapsto \mu_3
            %p is a weak equivalence.
          %p
            So the Lie 3-algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mi ℝ
                  %mo →
                  %mi 𝔰𝔱𝔯𝔦𝔫𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (b \mathbb{R} \to \mathfrak{string})
            is a kind of
            %a.existingWikiWord{:href => "/nlab/show/resolution"} resolution
            of the ordinary Lie algebra
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/differential+string+structure"} differential string structure
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} b \mathbb{R}
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mi ℝ
                  %mo →
                  %mi 𝔰𝔱𝔯𝔦𝔫𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (b \mathbb{R} \to \mathfrak{string})
            picks up the failure of
            = succeed "-valued" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔰𝔬
                  %annotation{:encoding => "application/x-tex"} \mathfrak{so}
            %a.existingWikiWord{:href => "/nlab/show/connection+on+an+%E2%88%9E-bundle"} connections
            to lift to
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔰𝔱𝔯𝔦𝔫𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{string}
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/connection+on+a+2-bundle"} 2-connections
          %p
            The proof of the following proposition may be instructive for seeing how the definition of horizontal equivalence of invariant polynomials takes care of having the invariant polynomials of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mi ℝ
                  %mo →
                  %mi 𝔰𝔱𝔯𝔦𝔫𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (b\mathbb{R} \to \mathfrak{string})
            agree with those of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
          .num_prop
            %h6#observation_4 Observation
            %p
              There is an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi inv
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi inv
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mi ℝ
                    %mo →
                    %mi 𝔰𝔱𝔯𝔦𝔫𝔤
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    inv(\mathfrak{g}) \simeq inv(b \mathbb{R} \to \mathfrak{string})
                    \\,.
          .proof
            %h6#proof_4 Proof
            %p
              Notice that the
              %a.existingWikiWord{:href => "/nlab/show/Weil+algebra"} Weil algebra
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mi ℝ
                    %mo →
                    %mi 𝔰𝔱𝔯𝔦𝔫𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (b\mathbb{R} \to \mathfrak{string})
              is given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi W
                    %msup
                      %mi t
                      %mi a
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mfrac
                      %mn 1
                      %mn 2
                    %msup
                      %mi C
                      %mi a
                    %msub
                      %mrow
                      %mrow
                        %mi b
                        %mi c
                    %msup
                      %mi t
                      %mi b
                    %mo ∧
                    %msup
                      %mi t
                      %mi c
                    %mo +
                    %msup
                      %mi r
                      %mi a
                  %annotation{:encoding => "application/x-tex"}
                    d_W t^a = - \frac{1}{2} C^a{}_{b c} t^b \wedge t^c + r^a
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi W
                    %mi b
                    %mo =
                    %msub
                      %mi μ
                      %mn 3
                    %mo −
                    %mi c
                    %mo −
                    %mi h
                  %annotation{:encoding => "application/x-tex"}
                    d_W b = \mu_3 - c - h
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi W
                    %mi c
                    %mo =
                    %mi g
                  %annotation{:encoding => "application/x-tex"}
                    d_W c = g
            %p
              for new generators
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi r
                      %mi a
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{r^a\}
              in degree 2,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
              in degree 3 and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              in degree 4, coming with their
              %a.existingWikiWord{:href => "/nlab/show/Bianchi+identities"} Bianchi identities
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi W
                    %msup
                      %mi r
                      %mi a
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mi C
                      %mi a
                    %msub
                      %mrow
                      %mrow
                        %mi b
                        %mi c
                    %msup
                      %mi t
                      %mi b
                    %mo ∧
                    %msup
                      %mi r
                      %mi c
                  %annotation{:encoding => "application/x-tex"}
                    d_W r^a = - C^a{}_{b c}t^b \wedge r^c
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi W
                    %mi h
                    %mo =
                    %msub
                      %mi d
                      %mi W
                    %msub
                      %mi μ
                      %mn 3
                    %mo −
                    %mi g
                  %annotation{:encoding => "application/x-tex"}
                    d_W h = d_W \mu_3 - g
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi W
                    %mi g
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    d_W g = 0
            %p
              For the following computations let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi k
                      %mrow
                        %mi a
                        %mi b
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{k_{a b}\}
              be the structure constants of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Killing+form"} Killing form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %msub
                      %mi k
                      %mrow
                        %mi a
                        %mi b
                    %msup
                      %mi r
                      %mi a
                    %mo ∧
                    %msup
                      %mi r
                      %mi b
                  %annotation{:encoding => "application/x-tex"}
                    \\langle -,- \rangle = k_{a b} r^a \wedge r^b
            %p
              and assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} \mu_3
              is normalized such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mn 3
                    %mo =
                    %msub
                      %mi k
                      %mrow
                        %mi a
                        %mi a
                        %mo ′
                    %msubsup
                      %mi C
                      %mrow
                        %mi b
                        %mi c
                      %mrow
                        %mi a
                        %mo ′
                    %msup
                      %mi t
                      %mi a
                    %mo ∧
                    %msup
                      %mi t
                      %mi b
                    %mo ∧
                    %msup
                      %mi t
                      %mi c
                  %annotation{:encoding => "application/x-tex"}
                    \\mu_3 = k_{a a'}C^{a'}_{b c} t^a \wedge t^b \wedge t^c
            %p (if another normalization is chosen, then the corresponding factor will float around the following formulas without changing anything of the end result).
            %p
              Now the indecomposable invariant polynomials are those of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              and one additional one:
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mi ℝ
                    %mo →
                    %mi 𝔰𝔱𝔯𝔦𝔫𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (b \mathbb{R} \to \mathfrak{string})
              are not equal to those of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
            %p But we do have the horizontal equivalence relation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mi g
                    %mo +
                    %msub
                      %mi d
                      %mi W
                    %mo{:stretchy => "false"} (
                    %mi cs
                    %mo −
                    %msub
                      %mi μ
                      %mn 3
                    %mo +
                    %mi h
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\langle -,-\rangle = g + d_W (cs - \mu_3 + h)
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi cs
                  %annotation{:encoding => "application/x-tex"} cs
              is any
              %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+element"} Chern-Simons element
              for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:stretchy => "false"} ⟩
                    %annotation{:encoding => "application/x-tex"} \langle - , \rangle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi cs
                    %mo =
                    %mfrac
                      %mn 1
                      %mn 6
                    %msub
                      %mi k
                      %mrow
                        %mi a
                        %mi a
                        %mo ′
                    %msubsup
                      %mi C
                      %mrow
                        %mi b
                        %mi c
                      %mrow
                        %mi a
                        %mo ′
                    %msup
                      %mi t
                      %mi a
                    %mo ∧
                    %msup
                      %mi t
                      %mi b
                    %mo ∧
                    %msup
                      %mi t
                      %mi c
                    %mo +
                    %msub
                      %mi k
                      %mrow
                        %mi a
                        %mi b
                    %msup
                      %mi t
                      %mi a
                    %msup
                      %mi r
                      %mi b
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    cs
                    \=
                    \\frac{1}{6} k_{a a'}C^{a'}_{b c} t^a \wedge t^b \wedge t^c
                    +
                    k_{a b} t^a r^b
                    \\,,
            %p
              Notice that the homotopy
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi cs
                    %mo −
                    %msub
                      %mi μ
                      %mn 3
                    %mo +
                    %mi h
                  %annotation{:encoding => "application/x-tex"} cs - \mu_3 + h
              here is indeed in
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ker
                      %mo{:stretchy => "false"} (
                      %mi W
                      %mo{:stretchy => "false"} (
                      %mi 𝔤
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi CE
                      %mo{:stretchy => "false"} (
                      %mi 𝔤
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} ker(W(\mathfrak{g}) \to CE(\mathfrak{g}))
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi cs
                  %annotation{:encoding => "application/x-tex"} cs
              not in that kernel is precisely
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi μ
                    %annotation{:encoding => "application/x-tex"} \mu
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                    %annotation{:encoding => "application/x-tex"} h
              %em is
              in the kernel and whose image under
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi W
                  %annotation{:encoding => "application/x-tex"} d_W
              is the image of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
              under
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mi W
                    %annotation{:encoding => "application/x-tex"} d_W
            %p
              Therefore in horizontal equivalence classes of invariant polynomials on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mi ℝ
                    %mo →
                    %mi 𝔰𝔱𝔯𝔦𝔫𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (b \mathbb{R} \to \mathfrak{string})
              the superfluous
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              is identified with the Killing form
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ⟩
                    %annotation{:encoding => "application/x-tex"} \langle-,- \rangle
          %h3#on_symplectic_lie_algebroids
            On symplectic Lie
            = succeed "-algebroids" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/symplectic+Lie+n-algebroid"} symplectic Lie n-algebroid
            is an
            %a.existingWikiWord{:href => "/nlab/show/L-infinity+algebroid"} L-infinity algebroid
            that carries a binary and non-degeneraty invariant polynomial of grade
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/symplectic+form"} symplectic form
            to which it reduces for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} n = 0
          %h2#Properties Properties
          %h3#AsFormsOnBGconn As differential forms on the moduli stack of connections
          %p
            The invariant polynomials of a Lie algebra
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi conn
                %annotation{:encoding => "application/x-tex"} \mathbf{B}G_{conn}
            of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/principal+connections"} principal connections
            = succeed "." do
              %a{:href => "#FreedHopkins13"} Freed-Hopkins 13
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} inv
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msup
                    %mi Ω
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi conn
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathrm{inv}(\mathfrak{g})\simeq \Omega^\bullet(\mathbf{B}G_{conn})
                  \\,.
          %p
            For more on this see also at
            = succeed "." do
              %em
                %a{:href => "Weil+algebra#CharacterizationInSmoothTopos"} Weil algebra – Characterization in the smooth infinity-topos
          %h3#OnReductiveLieAlg On reductive Lie algebras
          .num_prop
            %h6#proposition_3 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/reductive+Lie+algebra"} reductive Lie algebra
              %a.existingWikiWord{:href => "/nlab/show/Weil+algebra"} Weil algebra
              is the
              %a.existingWikiWord{:href => "/nlab/show/free+construction"} free graded algebra
              on the
              %a.existingWikiWord{:href => "/nlab/show/graded+vector+space"} graded vector space
              of indecomposable invariant polynomials.
            %p
              This graded vector space has a vector space
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              of degree -1 to the graded vector space of odd generators of the
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+cohomology"} Lie algebra cohomology
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi H
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi 𝔤
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msup
                        %mi H
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi CE
                      %mo{:stretchy => "false"} (
                      %mi 𝔤
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} H^\bullet(\mathfrak{g}) = H^\bullet(CE(\mathfrak{g}))
          %p
            This appears for instance as (
            %a{:href => "#GHV"}> GHV, vol III, page 242, theorem I
            ).
          %h2#role_in_chernweil_theory
            Role in
            = succeed "-Chern-Weil" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            In (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} \infty
            \-)
            %a.existingWikiWord{:href => "/nlab/show/Chern-Weil+theory"} Chern-Weil theory
            the crucial role played by the invariant polynomials is their relation to
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebra+cocycle"} ∞-Lie algebra cocycle
            %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
            = succeed "-Lie" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/differential+cohomology"} differential cohomology
          %h3#TransgressionCocycles Transgression cocycles and Chern-Simons elements
          .un_defn
            %h6#definition_7 Definition
            %p
              %strong (Chern-Simons elements and transgression cocycles)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔞
                    %mo =
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{a} = \mathfrak{g}
              be an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebra"} ∞-Lie algebra
              %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cochain cohomology
              of the
              %a.existingWikiWord{:href => "/nlab/show/Weil+algebra"} Weil algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} W(\mathfrak{g})
              is trivial, for every invariant polynomial
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                    %mo ∈
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \langle -\rangle \in W(\mathfrak{g})
              there is necessarily an element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi cs
                    %mo ∈
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} cs \in W(\mathfrak{g})
              with
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mrow
                        %mi W
                        %mo{:stretchy => "false"} (
                        %mi 𝔤
                        %mo{:stretchy => "false"} )
                    %mi cs
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    d_{W(\mathfrak{g})} cs = \langle -\rangle
                    \\,.
            %p
              This we call a
              %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+element"} Chern-Simons element
              for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ⟩
                    %annotation{:encoding => "application/x-tex"} \langle -\rangle
            %p
              This element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi cs
                  %annotation{:encoding => "application/x-tex"} cs
              will in general not sit entirely in the shifted copy. Its restriction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo :
                    %mo =
                    %mi cs
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msup
                          %mo ∧
                          %mo •
                        %msup
                          %mi 𝔤
                          %mo *
                    %mo ∈
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mu := cs|_{\wedge^\bullet \mathfrak{g}^*} \in CE(\mathfrak{g})
            %p
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebra+cohomology"} ∞-Lie algebra cocycle
              %em in transgression
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ⟩
                    %annotation{:encoding => "application/x-tex"} \langle -\rangle
            %p In total this construction yields a commuting diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi CE
                            %mo{:stretchy => "false"} (
                            %mi 𝔤
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ←
                              %mi μ
                          %mtd
                            %mi CE
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi b
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mi ℝ
                            %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                          %mtd
                            %mi cocycle
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↑
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↑
                        %mtr
                          %mtd
                            %mi W
                            %mo{:stretchy => "false"} (
                            %mi 𝔤
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ←
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi cs
                                %mo ,
                                %mo{:stretchy => "false"} ⟨
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo{:stretchy => "false"} ⟩
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi W
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi b
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mi ℝ
                            %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                          %mtd
                            %mi Chern
                            %mo −
                            %mi Simons
                            %mo −
                            %mi element
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↑
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↑
                        %mtr
                          %mtd
                            %mi inv
                            %mo{:stretchy => "false"} (
                            %mi 𝔤
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ←
                              %mrow
                                %mo{:stretchy => "false"} ⟨
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo{:stretchy => "false"} ⟩
                          %mtd
                            %mi CE
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi b
                              %mi n
                            %mi ℝ
                            %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                          %mtd
                            %mi invariant
                            %mspace{:width => "thickmathspace"}
                            %mi polynomial
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    CE(\mathfrak{g}) &amp;\stackrel{\mu}{\leftarrow}&amp; CE(b^{n-1}\mathbb{R})
                    \&amp;&amp;&amp; cocycle
                    \\\
                    \\uparrow &amp;&amp; \uparrow
                    \\\
                    W(\mathfrak{g}) &amp;\stackrel{(cs,\langle -\rangle)}{\leftarrow}&amp;
                    W(b^{n-1} \mathbb{R})
                    \&amp;&amp;&amp;
                    Chern-Simons-element
                    \\\
                    \\uparrow &amp;&amp; \uparrow
                    \\\
                    inv(\mathfrak{g}) &amp;\stackrel{\langle -\rangle}{\leftarrow}&amp;
                    CE(b^n \mathbb{R})
                    \&amp;&amp;&amp;
                    invariant\; polynomial
                    }
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi b
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} b^{n-1}\mathbb{R}
              denotes the
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebra"} ∞-Lie algebra
              whose CE-algebra has a single generator in degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              and vanishing differential, and where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi b
                      %mi n
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi inv
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi b
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CE(b^n \mathbb{R}) = inv(b^{n-1}\mathbb{R})
              is the algebra of invariant polynomials of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi b
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} b^{n-1} \mathbb{R}
          .un_prop
            %h6#proposition_4 Proposition
            %p
              The element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo ∈
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mu \in CE(\mathfrak{g})
              associated to an invariant polynomial
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle -\rangle
              by the above procedure is indeed a cocycle, and its cohomology class is independent of the choice of the element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi cs
                  %annotation{:encoding => "application/x-tex"} cs
              involved.
          .proof
            %h6#proof_5 Proof
            %p
              The procedure that assigns
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle- \rangle
              is illustarted by the following diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ⟨
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} ⟩
                          %mtd
                            %mo ←
                          %mtd
                            %mo{:stretchy => "false"} ⟨
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} ⟩
                        %mtr
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %msup
                              %mo{:stretchy => "false"} ↑
