          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi inv
                  %mo{:stretchy => "false"} (
                  %mi 𝔞
                  %mo{:stretchy => "false"} )
                  %mo ⊂
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mi 𝔞
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi ker
                  %mo{:stretchy => "false"} (
                  %mi W
                  %mo{:stretchy => "false"} (
                  %mi 𝔞
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi CE
                  %mo{:stretchy => "false"} (
