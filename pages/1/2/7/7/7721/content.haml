                    \\\
                    \- g^{-1} B  &amp; g^{-1}
                    }
                    \\right)
                    \\,,
            %p where
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ≔
                    %msup
                      %mi e
                      %mi T
                    %mi e
                  %annotation{:encoding => "application/x-tex"}
                    g \coloneqq e^T e
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/metric"} metric
              (over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi q
                    %mo ≃
                    %msub
                      %mi U
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^q \simeq U_i
              a smooth function with values in symmetric
              = succeed "-matrices)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ×
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n \times n
              %a.existingWikiWord{:href => "/nlab/show/vielbein"} ordinary vielbein
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi e
                    %annotation{:encoding => "application/x-tex"} e
          %h3#GeometricAndNonGeometric Geometric and “non-geometric” type II geometries
          .num_defn
            %h6#definition_6 Definition
            %p
              An element in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} O(d,d)
              which in the canonical matrix presentation is of the block form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi e
                      %mi ω
                    %mo ≔
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mn 1
                                %mi d
                            %mtd
                              %mn 0
                          %mtr
                            %mtd
                              %mi ω
                            %mtd
                              %msub
                                %mn 1
                                %mi d
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    e^\omega \coloneqq \left(
                    \\array{
                    1_d &amp; 0
                    \\\
                    \\omega &amp;  1_d
                    }
                    \\right)
            %p
              is called a
              = succeed "." do
                %strong
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi B
                      %annotation{:encoding => "application/x-tex"} B
                  \-transform
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi e
                      %mi β
                    %mo ≔
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mn 1
                                %mi d
                            %mtd
                              %mi β
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %msub
                                %mn 1
                                %mi d
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    e^\beta \coloneqq \left(
                    \\array{
                    1_d &amp; \beta
                    \\\
                    0 &amp;  1_d
                    }
                    \\right)
            %p
              is called a
              = succeed "." do
                %strong
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi β
                      %annotation{:encoding => "application/x-tex"} \beta
                  \-transform
              %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mi geom
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    G_{geom}(d) \hookrightarrow O(d,d)
            %p
              generated by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Gl
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Gl(d) \hookrightarrow O(d,d)
              and the B-transforms, hence that of matrices with vaishing top right block is called the
              %strong geometric subgroup
              (e.g.
              = succeed ")." do
                %a{:href => "#GMPW"} GMPW, p.5
            %p
              A type II background where the structure group of the
              %a.existingWikiWord{:href => "/nlab/show/generalized+tangent+bundle"} generalized tangent bundle
              is not in the inclusion of the geometric subgroup is often called a
              %strong non-geometric background
              (e.g.
              = succeed ")." do
                %a{:href => "#GMPW"} GMPW, section 5
          %h2#application_in_type_ii_supergravity Application in type II supergravity
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/target+space"} target space
            geometry for
            %a.existingWikiWord{:href => "/nlab/show/type+II+superstrings"} type II superstrings
            in the NS-NS sector ,
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/type+II+supergravity"} type II supergravity
          %p …
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/exceptional+generalized+geometry"} exceptional generalized geometry
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/non-geometric+string+theory+vacua"} non-geometric string theory vacua
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/T-folds"} T-folds
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/twisted+smooth+cohomology+in+string+theory"} twisted smooth cohomology in string theory
          %h2#references References
          %h3#general General
          %p
            The appearance of type II geometry in
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/type+II+supergravity"} type II supergravity
            %a.existingWikiWord{:href => "/nlab/show/type+II+string+theory"} type II string theory
            is discussed for instance in
          %ul
            %li#Ellwood07
              %p
                Ian Ellwood:
                %em NS-NS fluxes in Hitchin’s generalized geometry
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/hep-th/0612100"}> arXiv:hep-th/0612100
                \&amp;rbrack;
            %li#GMPW
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mariana+Gra%C3%B1a"}> Mariana Graña
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ruben+Minasian"} Ruben Minasian
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Daniel+Waldram"} Daniel Waldram
                %em T-duality, Generalized Geometry and Non-Geometric Backgrounds
                (
                %a{:href => "http://arxiv.org/abs/0807.4527"}> arXiv:0807.4527
                )
          %p
            The genuine reformulation of type II supergravity as a
            = succeed "-gauge/gravity" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"} \big(O(d)\times O(d) \hookrightarrow O(d,d)\big)
          %ul
            %li
              André Coimbra,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Charles+Strickland-Constable"} Charles Strickland-Constable
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Daniel+Waldram"} Daniel Waldram
              = succeed "," do
                %em Supergravity as Generalised Geometry I: Type II Theories
              %strong 2011
              91 (2011). &amp;lbrack;
              %a{:href => "http://arxiv.org/abs/1107.1733"}> arXiv:1107.1733
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1007/JHEP11(2011)091"} doi:10.1007/JHEP11(2011)091
          %p In
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Chris+Hull"}> Chris Hull
              ,
              = succeed "," do
                %em Generalised Geometry for M-Theory
              = succeed ")" do
                %a{:href => "http://arxiv.org/abs/hep-th/0701203"} arXiv:hep-th/0701203
          %p
            the geometry of the reduction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} O(d) \times O(d) \to O(d,d)
            was referred to as “type I geometry”, with “type II geometry” instead referring to further
            %a.existingWikiWord{:href => "/nlab/show/U-duality"} U-duality
            group extensions, discussed at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/exceptional+generalized+geometry"} exceptional generalized geometry
          %p Review:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Charles+Strickland-Constable"}> Charles Strickland-Constable
              \:
              = succeed "," do
                %em Supergravity Fluxes and Generalised Geometry
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Higher+Structures+in+M-Theory+2018"} Higher Structures in M-Theory 2018
              %strong 67
              8-9 &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/1903.02842"}> arXiv:1903.02842
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1002/prop.201910021"} doi:10.1002/prop.201910021
          %p
            Issues with
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/higher+curvature+corrections"} higher curvature corrections
          %ul
            %li
              Steven Weilong Hsia, Ahmed Rakin Kamal,
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Linus+Wulff"} Linus Wulff
              %em
                No manifest T-duality at order
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                      %mo ′
                      %msup
                        %mrow
                        %mn 3
                    %annotation{:encoding => "application/x-tex"} \alpha'{}^3
              \&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/2411.15302"}> arXiv:2411.15302
              \&amp;rbrack;
          %p
            See also for
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/para-Hermitian+manifolds"} para-Hermitian manifolds
          %ul
            %li
              Vincenzo Emilio Marotta,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Richard+J.+Szabo"} Richard J. Szabo
              = succeed "," do
                %em Born Sigma-Models for Para-Hermitian Manifolds and Generalized T-Duality
              %strong 33
              09 (2021) 2150031 &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/1910.09997"}> arXiv:1910.09997
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1142/S0129055X21500318"} doi:10.1142/S0129055X21500318
          %h3#ReferencesDoubledSupergeometry Doubled super-geometry
          %p
            Much of the discussion of type II geometry has in fact been purely bosonic, ignoring the
            %a.existingWikiWord{:href => "/nlab/show/super-geometry"} super-geometry
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
          %p
            In contrast, discussion combining
            %a.existingWikiWord{:href => "/nlab/show/doubled+geometry"} doubled geometry
            with
            %a.existingWikiWord{:href => "/nlab/show/super-geometry"} super-geometry
            includes the following:
          %ul
            %li
              %p
                Machiko Hatsuda, Kiyoshi Kamimura,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Warren+Siegel"} Warren Siegel
                = succeed "," do
                  %em Superspace with manifest T-duality from type II superstring
                %strong 2014
                39 (2014) &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1403.3887"}> arXiv:1403.3887
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/JHEP06(2014)039"} doi:10.1007/JHEP06(2014)039
            %li#Bandos15
              %p
                %a.existingWikiWord{:href => "/nlab/show/Igor+Bandos"}> Igor Bandos
                \:
                = succeed "," do
                  %em Superstring in doubled superspace
                %strong 751
                (2015) 408-412 &amp;lbrack;
                %a{:href => "https://doi.org/10.1016/j.physletb.2015.10.081"}> doi:10.1016/j.physletb.2015.10.081
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://arxiv.org/abs/1507.07779"} arXiv:1507.07779
            %li#Cederwall16
              %p
                %a.existingWikiWord{:href => "/nlab/show/Martin+Cederwall"}> Martin Cederwall
                ,
                = succeed "," do
                  %em Double supergeometry
                %strong 2016
                155 (2016) &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1603.04684"}> arXiv:1603.04684
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/JHEP06(2016)155"} doi:10.1007/JHEP06(2016)155
            %li
              %p
                Bojan Nikolić, Branislav Sazdović,
                = succeed "," do
                  %em T-dualization of type II superstring theory in double space
                %strong 77
                3 (2017) 197 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1505.06044"}> arXiv:1505.06044
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1140/epjc/s10052-017-4758-0"} doi:10.1140/epjc/s10052-017-4758-0
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Domenico+Fiorenza"}> Domenico Fiorenza
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Hisham+Sati"} Hisham Sati
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/schreiber/show/T-Duality+from+super+Lie+n-algebra+cocycles+for+super+p-branes"} T-Duality from super Lie n-algebra cocycles for super p-branes
                %strong 22
                5 (2018) &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1611.06536"}> arXiv:1611.06536
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://dx.doi.org/10.4310/ATMP.2018.v22.n5.a3"} doi:10.4310/ATMP.2018.v22.n5.a3
            %li
              %p
                Bojan Nikolić, Branislav Sazdović,
                %em Advantage of the second-order formalism in double space T-dualization of type II superstring
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1907.03571"}> arXiv:1907.03571
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Chris+D.+A.+Blair"}> Chris D. A. Blair
                , Ondrej Hulik, Alexander Sevrin,
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Daniel+C.+Thompson"} Daniel C. Thompson
                = succeed "," do
                  %em Doubled space and extended supersymmetry
                %strong 2022
                119 (2022) [
                %a{:href => " https://doi.org/10.1007/JHEP08(2022)119"}> doi:10.1007/JHEP08(2022)119
                ]
          %p
            See also the references on the corresponding
            = succeed "-enhancement" do
              %a.existingWikiWord{:href => "/nlab/show/super-geometry"} super-geometry
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/exceptional+generalized+geometry"} exceptional generalized geometry
            %em
              %a{:href => "exceptional+generalized+geometry#SuperExceptionalGeometryReferences"} Super-exceptional geometry – References
