          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#definition"} Definition
              %ul
                %li
                  %a{:href => "#FiberwiseMetric"} By fiberwise metric on the generalized tangent bundle
                %li
                  %a{:href => "#ReductionOfStructureGroup"} By reduction of the generalized tangent bundle
                %li
                  %a{:href => "#GeometricAndNonGeometric"} Geometric and “non-geometric” type II geometries
              %li
                %a{:href => "#application_in_type_ii_supergravity"} Application in type II supergravity
              %li
                %a{:href => "#related_concepts"} Related concepts
              %li
