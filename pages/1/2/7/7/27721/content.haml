                      %mi A
                      %mo ,
                      %mi Δ
                      %mo ⊢
                      %mi B
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo :
                      %mi A
                      %mo ,
                      %mi Δ
                      %mo ⊢
                      %mi b
                      %mo :
                      %mi B
                    %mrow
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo :
                      %mi A
                      %mo ,
                      %mi Δ
                      %mo ⊢
                      %msub
                        %mi ϕ
                        %mi B
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} true
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma, x:A, \Delta \vdash B \; \mathrm{type}}{\Gamma, x:A, \Delta \vdash \phi_B \; \mathrm{prop}} \qquad \frac{\Gamma, x:A, \Delta \vdash B \; \mathrm{type} \quad \Gamma, x:A, \Delta \vdash b:B}{\Gamma, x:A, \Delta \vdash \phi_B \; \mathrm{true}}
          %p
            There is no need for
            %a.existingWikiWord{:href => "/nlab/show/propositional+truncations"} propositional truncations
            in this interpretation: the full
            %a.existingWikiWord{:href => "/nlab/show/intuitionistic+logic"} intuitionistic logic
            results from reflecting all type formers except for the
            %a.existingWikiWord{:href => "/nlab/show/natural+numbers+type"} natural numbers type
            and
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/identity+types"} identity types
