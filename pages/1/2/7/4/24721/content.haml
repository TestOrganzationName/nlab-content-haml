                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{ax}_\Pi:\sum_{\Pi:\prod_{A:U} (T(A) \to U) \to U} \prod_{A:U} \prod_{B:T(A) \to U} T(\Pi(A, B)) \simeq \prod_{x:T(A)} T(B(x))
          %p
            Product-regular univalent Tarski universes are the type theoretic equivalent of
            %a.existingWikiWord{:href => "/nlab/show/product-regular+cardinals"} product-regular cardinals
            in
            = succeed "." do
