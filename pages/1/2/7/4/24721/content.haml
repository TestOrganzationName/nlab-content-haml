                  %mo{:stretchy => "false"} )
                  %msub
                    %mo =
                    %mi U
                  %mi A
                %annotation{:encoding => "application/x-tex"} T(A) \coloneqq \mathrm{fiber}_{T', U}(\mathrm{typeOf},A) \equiv \sum_{t:T'} \mathrm{typeOf}(t) =_U A
          %p
            From the other direction, the entire type of elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo ′
                %annotation{:encoding => "application/x-tex"} T'
            is just the
            %a.existingWikiWord{:href => "/nlab/show/dependent+sum+type"} dependent sum type
            of the universal type family
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo ′
                  %mo ≔
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi A
                      %mo :
                      %mi U
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} T' \coloneqq \sum_{A:U} T(A)
          %p We shall be using the first definition throughout this article, but everything could be translated into the second definition of a Tarski universe.
          %h2#tarski_universes_as_models_of_type_theory Tarski universes as models of type theory
          %p The definitions above are already enough to build an internal model of dependent type theory inside the Tarski universe:
          %ul
            %li
              The type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mspace{:width => "thickmathspace"}
                    %mi{:mathvariant => "normal"} type
                  %annotation{:encoding => "application/x-tex"} A \; \mathrm{type}
              is represented by the small type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo :
                    %mi U
                  %annotation{:encoding => "application/x-tex"} A:U
            %li
              The element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} a:A
              is represented by the element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo :
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} a:T(A)
              for small type
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo :
                      %mi U
                    %annotation{:encoding => "application/x-tex"} A:U
            %li
              The type family
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              indexed by the type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mspace{:width => "thickmathspace"}
                    %mi{:mathvariant => "normal"} type
                  %annotation{:encoding => "application/x-tex"} A \; \mathrm{type}
              is represented by the function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo :
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi U
                  %annotation{:encoding => "application/x-tex"} B:T(A) \to U
              for small type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo :
                    %mi U
                  %annotation{:encoding => "application/x-tex"} A:U
            %li
              The dependent type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo :
                    %mi A
                    %mo ⊢
                    %mi B
                    %mspace{:width => "thickmathspace"}
                    %mi{:mathvariant => "normal"} type
                  %annotation{:encoding => "application/x-tex"} a:A \vdash B \; \mathrm{type}
              is represented by the section
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi U
                  %annotation{:encoding => "application/x-tex"} B(a):U
              for element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo :
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} a:T(A)
              and small type
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo :
                      %mi U
                    %annotation{:encoding => "application/x-tex"} A:U
            %li
              The section
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo :
                    %mi A
                    %mo ⊢
                    %mi b
                    %mo :
                    %mi B
                  %annotation{:encoding => "application/x-tex"} a:A \vdash b:B
              is represented by the element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo :
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} b:T(B(a))
              for element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo :
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} a:T(A)
              and small type
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo :
                      %mi U
                    %annotation{:encoding => "application/x-tex"} A:U
          %h2#properties Properties
          %h3#univalence Univalence
          %p
            There are two notions of equivalence in a Tarski universe
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mi T
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (U, T)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %msub
                    %mo =
                    %mi U
                  %mi B
                %annotation{:encoding => "application/x-tex"} A =_U B
            and equivalence
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} T(A) \simeq T(B)
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/identity+type"} identity type
            %a.existingWikiWord{:href => "/nlab/show/transport"} transport
            dependent function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi{:mathvariant => "normal"} transport
                    %mi T
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi A
                      %mo :
                      %mi U
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi B
                      %mo :
                      %mi U
                  %mo{:stretchy => "false"} (
                  %mi A
                  %msub
                    %mo =
                    %mi U
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{transport}^T:\prod_{A:U} \prod_{B:U} (A =_U B) \to T(A) \simeq T(B)
          %p
            A Tarski universe is a
            %strong univalent Tarski universe
            if for all elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo :
                  %mi U
                %annotation{:encoding => "application/x-tex"} A:U
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo :
                  %mi U
                %annotation{:encoding => "application/x-tex"} B:U
            the function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi{:mathvariant => "normal"} transport
                    %mi T
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{transport}^T(A, B)
            is an
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+types"} equivalence of types
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi A
                      %mo :
                      %mi U
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi B
                      %mo :
                      %mi U
                  %mi{:mathvariant => "normal"} isEquiv
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi{:mathvariant => "normal"} transport
                    %mi T
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \prod_{A:U} \prod_{B:U} \mathrm{isEquiv}(\mathrm{transport}^T(A, B))
          %p
            This is the extensionality principle for any Tarski universe
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mi T
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (U, T)
          %p
            Equivalently, by the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/fundamental+theorem+of+identity+types"} fundamental theorem of identity types
            %strong univalent Tarski universe
            if it comes with a dependent function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi X
                      %mo :
                      %mi U
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi X
                  %mo ,
                  %msub
                    %mi{:mathvariant => "normal"} id
                    %mi X
                  %mo{:stretchy => "false"} )
                  %mo ⊢
                  %mi J
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi A
                      %mo :
                      %mi U
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi B
                      %mo :
                      %mi U
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi R
                      %mo :
                      %mi T
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mi T
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi B
                  %mo ,
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} t:\prod_{X:U} C(X, X, \mathrm{id}_X) \vdash J(t):\prod_{A:U} \prod_{B:U} \prod_{R:T(A) \simeq T(B)} C(A, B, R)
          %p and a dependent function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi X
                      %mo :
                      %mi U
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi X
                  %mo ,
                  %msub
                    %mi{:mathvariant => "normal"} id
                    %mi X
                  %mo{:stretchy => "false"} )
                  %mo ⊢
                  %mi β
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi A
                      %mo :
                      %mi U
                  %mi J
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo ,
                  %mi A
                  %mo ,
                  %mi A
                  %mo ,
                  %msub
                    %mi{:mathvariant => "normal"} id
                    %mi A
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo =
                    %mrow
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mi A
                      %mo ,
                      %msub
                        %mi{:mathvariant => "normal"} id
                        %mi A
                      %mo{:stretchy => "false"} )
                  %mi t
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} t:\prod_{X:U} C(X, X, \mathrm{id}_X) \vdash \beta(t):\prod_{A:U} J(t, A, A, \mathrm{id}_A) =_{C(A, A, \mathrm{id}_A)} t(A)
          %p
            When the Tarski universe is closed under
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/identity+types"} identity types
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+sum+types"} dependent sum types
            %a.existingWikiWord{:href => "/nlab/show/dependent+product+types"} dependent product types
            (see below for more on closure of Tarski universes under type formers), one is able to internalize the
            %a.existingWikiWord{:href => "/nlab/show/type+of+equivalences"} type of equivalences
            in the universe as
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %msub
                      %mo ≃
                      %mi U
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A \simeq_U B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi A
                  %msub
                    %mo ≃
                    %mi U
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} T(A \simeq_U B)
            is equivalent to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} T(A) \simeq T(B)
            %a.existingWikiWord{:href => "/nlab/show/type+of+equivalences"} type of equivalences
            and the canonical function
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} idtoequiv
                  %annotation{:encoding => "application/x-tex"} \mathrm{idtoequiv}
            %a{:href => "https://ncatlab.org/nlab/show/univalence+axiom#for_tarski_universes"} Univalence axiom#For Tarski universes
            for more details on this.
          %h4#construction_of_univalent_tarski_universes_via_a_higher_inductive_type Construction of univalent Tarski universes via a higher inductive type
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ,
                  %mi T
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (U, T)
            be a Tarski universe. Then one could construct a univalent Tarski universe as the
            %a.existingWikiWord{:href => "/nlab/show/higher+inductive+type"} higher inductive type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ′
                  %mo ,
                  %mi T
                  %mo ′
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (U', T')
            generated by
          %ul
            %li
              a function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi U
                    %mo →
                    %mi U
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} F:U \to U'
            %li
              a function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi T
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G(A):T(A) \to T'(A)
              for all elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo :
                    %mi U
                  %annotation{:encoding => "application/x-tex"} a:U
            %li
              a dependent function
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi{:mathvariant => "normal"} ua
                        %mrow
                          %mi U
                          %mo ′
                      %mo :
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi A
                          %mo :
                          %mi U
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi B
                          %mo :
                          %mi U
                      %mi{:mathvariant => "normal"} isEquiv
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi{:mathvariant => "normal"} transport
                        %mrow
                          %mi T
                          %mo ′
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mi B
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathrm{ua}_{U'}:\prod_{A:U} \prod_{B:U} \mathrm{isEquiv}(\mathrm{transport}^{T'}(A, B))
          %h3#regularity_and_productregularity Regularity and product-regularity
          %p
            A univalent Tarski universe
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ,
                  %mi T
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (U, T)
            is
            %strong regular
            if it is closed under
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/dependent+sum+types"} dependent sum types
            = succeed "-small" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
