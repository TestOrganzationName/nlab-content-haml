                      %mi T
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} Id
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
