          %h3#singletons Singletons
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/univalent+Tarski+universe"} univalent Tarski universe
            satisfies the
            %strong axiom of singletons
            if it is closed under the (weak)
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/unit+type"} unit type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝟙
                %annotation{:encoding => "application/x-tex"} \mathbb{1}
            is essentially
            = succeed "-small." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/formation+rule"} formation rule
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/introduction+rules"} introduction rules
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+universal+property+of+the+natural+numbers"} dependent universal property of the natural numbers
          %ul
            %li
              %p
                formation rules:
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝟙
                      %mo :
                      %mi U
                    %annotation{:encoding => "application/x-tex"} \mathbb{1}:U
            %li
              %p
                introduction rules:
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo :
                      %mi T
                      %mo{:stretchy => "false"} (
                      %mi 𝟙
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} 0:T(\mathbb{1})
          %p and either an universal property or a dependent universal property
          %ul
            %li
              %p universal property:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi{:mathvariant => "normal"} up
                        %mi 𝟙
                        %mi U
                      %mo :
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi C
                          %mo :
                          %mi U
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %msub
                            %mi c
                            %mn 0
                          %mo :
                          %mi T
                          %mo{:stretchy => "false"} (
                          %mi C
                          %mo{:stretchy => "false"} )
                      %mo ∃
                      %mo !
                      %mi c
                      %mo :
                      %mi T
                      %mo{:stretchy => "false"} (
                      %mi 𝟙
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi T
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                      %mo .
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo =
                        %mrow
                          %mi T
                          %mo{:stretchy => "false"} (
                          %mi C
                          %mo{:stretchy => "false"} )
                      %msub
                        %mi c
                        %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathrm{up}_\mathbb{1}^U:\prod_{C:U} \prod_{c_0:T(C)} \exists!c:T(\mathbb{1}) \to T(C).(c(0) =_{T(C)} c_0)
            %li
              %p dependent universal property:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi{:mathvariant => "normal"} dup
                        %mi 𝟙
                        %mi U
                      %mo :
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi C
                          %mo :
                          %mi T
                          %mo{:stretchy => "false"} (
                          %mi 𝟙
                          %mo{:stretchy => "false"} )
                          %mo →
                          %mi U
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %msub
                            %mi c
                            %mn 0
                          %mo :
                          %mi T
                          %mo{:stretchy => "false"} (
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                      %mo ∃
                      %mo !
                      %mi c
                      %mo :
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi x
                          %mo :
                          %mi T
                          %mo{:stretchy => "false"} (
                          %mi 𝟙
                          %mo{:stretchy => "false"} )
                      %mi T
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo .
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo =
                        %mrow
                          %mi T
                          %mo{:stretchy => "false"} (
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                      %msub
                        %mi c
                        %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathrm{dup}_\mathbb{1}^U:\prod_{C:T(\mathbb{1}) \to U} \prod_{c_0:T(C(0))} \exists!c:\prod_{x:T(\mathbb{1})} T(C(x)).(c(0) =_{T(C(0))} c_0)
              %p
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∃
                      %mo !
                      %mi x
                      %mo :
                      %mi A
                      %mo .
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \exists!x:A.B(x)
                is the
                %a.existingWikiWord{:href => "/nlab/show/uniqueness+quantifier"} uniqueness quantifier
                for the
                %a.existingWikiWord{:href => "/nlab/show/type+family"} type family
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo :
                        %mi A
                        %mo ⊢
                        %mi B
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} x:A \vdash B(x)
          %p
            By using
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+sum+types"} dependent sum types
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} axsingl
                    %mi U
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi 𝟙
                      %mo :
                      %mi U
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mn 0
                      %mo :
                      %mi T
                      %mo{:stretchy => "false"} (
                      %mi 𝟙
                      %mo{:stretchy => "false"} )
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi C
                      %mo :
                      %mi U
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %msub
                        %mi c
                        %mn 0
                      %mo :
                      %mi T
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                  %mo ∃
                  %mo !
                  %mi c
                  %mo :
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi 𝟙
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo .
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo =
                    %mrow
                      %mi T
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                  %msub
                    %mi c
                    %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{axsingl}_U:\sum_{\mathbb{1}:U} \sum_{0:T(\mathbb{1})} \prod_{C:U} \prod_{c_0:T(C)} \exists!c:T(\mathbb{1}) \to T(C).(c(0) =_{T(C)} c_0)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} axsingl
                    %mi U
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi 𝟙
                      %mo :
                      %mi U
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mn 0
                      %mo :
                      %mi T
                      %mo{:stretchy => "false"} (
                      %mi 𝟙
                      %mo{:stretchy => "false"} )
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi C
                      %mo :
                      %mi 𝟙
                      %mo →
                      %mi U
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %msub
                        %mi c
                        %mn 0
                      %mo :
                      %mi T
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                  %mo ∃
                  %mo !
                  %mi c
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi x
                      %mo :
                      %mi T
                      %mo{:stretchy => "false"} (
                      %mi 𝟙
                      %mo{:stretchy => "false"} )
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo .
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo =
                    %mrow
                      %mi T
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                  %msub
                    %mi c
                    %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{axsingl}_U:\sum_{\mathbb{1}:U} \sum_{0:T(\mathbb{1})} \prod_{C:\mathbb{1} \to U} \prod_{c_0:T(C(0))} \exists!c:\prod_{x:T(\mathbb{1})} T(C(x)).(c(0) =_{T(C(0))} c_0)
          %p
            Alternatively, since the notion of
            %a.existingWikiWord{:href => "/nlab/show/truth"} truth
            could be defined using the type of
            = succeed "-small" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            %a.existingWikiWord{:href => "/nlab/show/contractible+types"} contractible types
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi A
                        %mo :
                        %mi U
                    %mi{:mathvariant => "normal"} isContr
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sum_{A:U} \mathrm{isContr}(T(A))
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/propositional+impredicativity"} propositional impredicativity
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/univalent+Tarski+universe"} univalent Tarski universe
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ,
                  %mi T
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (U, T)
            satisfies the
            %strong axiom of singletons
            if it is closed under the type of all
            = succeed "-small" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/contractible+types"} contractible types
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi A
                      %mo :
                      %mi U
                  %mi{:mathvariant => "normal"} isContr
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \sum_{A:U} \mathrm{isContr}(T(A))
            is
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/essentially+small+type"}
                essentially
                = succeed "-small" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                      %annotation{:encoding => "application/x-tex"} U
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} axSingl
                    %mi U
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi 𝟙
                      %mo :
                      %mi U
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi 𝟙
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi A
                      %mo :
                      %mi U
                  %mi{:mathvariant => "normal"} isContr
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{axSingl}_U:\sum_{\mathbb{1}:U} T(\mathbb{1}) \simeq \sum_{A:U} \mathrm{isContr}(T(A))
          %h3#empty_type Empty type
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/univalent+Tarski+universe"} univalent Tarski universe
            satisfies the
            %strong
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+empty+set"} axiom of empty type
            if it is closed under the (weak)
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/empty+type"} empty type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ∅
                %annotation{:encoding => "application/x-tex"} \emptyset
            is essentially
            = succeed "-small." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            %a.existingWikiWord{:href => "/nlab/show/formation+rule"} formation rule
            and the dependent universal property of the empty type, which are represented by the following elements:
          %ul
            %li
              formation rules:
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ∅
                    %mo :
                    %mi U
                  %annotation{:encoding => "application/x-tex"} \emptyset:U
          %p and either an universal property or a dependent universal property
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi{:mathvariant => "normal"} up
                    %mi ∅
                    %mi U
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi C
                      %mo :
                      %mi U
                  %mi{:mathvariant => "normal"} isContr
                  %mrow
                    %mo (
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi ∅
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo )
                %annotation{:encoding => "application/x-tex"} \mathrm{up}_\emptyset^U:\prod_{C:U} \mathrm{isContr}\left(T(\emptyset) \to T(C)\right)
          %ul
            %li
              dependent universal property:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi{:mathvariant => "normal"} up
                        %mi ∅
                        %mi U
                      %mo :
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi C
                          %mo :
                          %mi T
                          %mo{:stretchy => "false"} (
                          %mi ∅
                          %mo{:stretchy => "false"} )
                          %mo →
                          %mi U
                      %mi{:mathvariant => "normal"} isContr
                      %mrow
                        %mo (
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                          %mrow
                            %mi x
                            %mo :
                            %mi T
                            %mo{:stretchy => "false"} (
                            %mi ∅
                            %mo{:stretchy => "false"} )
                        %mi T
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo )
                    %annotation{:encoding => "application/x-tex"} \mathrm{up}_\emptyset^U:\prod_{C:T(\emptyset) \to U} \mathrm{isContr}\left(\prod_{x:T(\emptyset)} T(C(x))\right)
          %p
            By using
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+sum+types"} dependent sum types
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} axempty
                    %mi U
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi ∅
                      %mo :
                      %mi U
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi C
                      %mo :
                      %mi U
                  %mi{:mathvariant => "normal"} isContr
                  %mrow
                    %mo (
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi ∅
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo )
                %annotation{:encoding => "application/x-tex"} \mathrm{axempty}_U:\sum_{\emptyset:U} \prod_{C:U} \mathrm{isContr}\left(T(\emptyset) \to T(C)\right)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} axempty
                    %mi U
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi ∅
                      %mo :
                      %mi U
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi C
                      %mo :
                      %mi T
                      %mo{:stretchy => "false"} (
                      %mi ∅
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi U
                  %mi{:mathvariant => "normal"} isContr
                  %mrow
                    %mo (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi x
                        %mo :
                        %mi T
                        %mo{:stretchy => "false"} (
                        %mi ∅
                        %mo{:stretchy => "false"} )
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo )
                %annotation{:encoding => "application/x-tex"} \mathrm{axempty}_U:\sum_{\emptyset:U} \prod_{C:T(\emptyset) \to U} \mathrm{isContr}\left(\prod_{x:T(\emptyset)} T(C(x))\right)
          %p
            Alternatively, since
            %a.existingWikiWord{:href => "/nlab/show/falsehood"} falsehood
            or the empty proposition could be defined using the type of
            = succeed "-small" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi A
                        %mo :
                        %mi U
                    %mi{:mathvariant => "normal"} isProp
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sum_{A:U} \mathrm{isProp}(T(A))
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/propositional+impredicativity"} propositional impredicativity
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/univalent+Tarski+universe"} univalent Tarski universe
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ,
                  %mi T
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (U, T)
            satisfies the
            %strong
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+empty+set"} axiom of empty type
            if it is closed under the empty proposition or falsehood: namely, the
            %a.existingWikiWord{:href => "/nlab/show/dependent+product+type"} dependent product type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi A
                      %mo :
                      %mi{:mathvariant => "normal"} Prop
                  %msub
                    %mo
                    %mi U
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \prod_{A:\mathrm{Prop}}_U T(A)
            is
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/essentially+small+type"}
                essentially
                = succeed "-small" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                      %annotation{:encoding => "application/x-tex"} U
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} axempty
                    %mi U
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi ∅
                      %mo :
                      %mi U
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi ∅
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi A
                      %mo :
                      %msub
                        %mi{:mathvariant => "normal"} Prop
                        %mi U
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{axempty}_U:\sum_{\emptyset:U} T(\emptyset) \simeq \prod_{A:\mathrm{Prop}_U} T(A)
          %p where
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} Prop
                    %mi U
                  %mo ≡
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi A
                      %mo :
                      %mi U
                  %mi{:mathvariant => "normal"} isProp
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{Prop}_U \equiv \sum_{A:U} \mathrm{isProp}(T(A))
          %p
            Product regularity and the axiom of empty type imply the axiom of singletons, because the dependent universal property of the empty set states that for every type family
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo :
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi 𝟘
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi U
                %annotation{:encoding => "application/x-tex"} C:T(\mathbb{0}) \to U
            the dependent function type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
