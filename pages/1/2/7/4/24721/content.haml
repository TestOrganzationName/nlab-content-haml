                  \\left(\mathrm{isSet}(T(A)) \times \prod_{x:T(A)} \left(\mathrm{isSet}(T(B(x))) \times \prod_{y:T(B(x))} \mathrm{isProp}(T(C(x, y)))\right)\right) \\
                  \\to \forall x:T(A).\exists y:T(B(x)).T(C(x, y)) \to \exists g:\prod_{x:T(A)} T(B(x)).\forall x:T(A).T(C(x, g(x)))
                  \\end{array}
          %h3#choice_operators_and_existence Choice operators and existence
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/choice+operator"} choice operator
            on a type is a function from its
            %a.existingWikiWord{:href => "/nlab/show/propositional+truncation"} propositional truncation
            to the type itself, and represents the concept that if there exists an element of the set (i.e. the propositional truncation has an element), then the set itself has an element chosen by the choice operator. A Tarski universe satisfies the
            %strong
              %a.existingWikiWord{:href => "/nlab/show/type-theoretic+axiom+of+existence"} type-theoretic axiom of existence
            if every
            = succeed "-small" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ε
                    %mi U
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi A
                      %mo :
                      %mi U
                  %mo{:stretchy => "false"} |
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} |
                  %mo →
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \varepsilon_U:\prod_{A:U} \vert T(A) \vert \to T(A)
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            satisfying the type-theoretic axiom of existence implies that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            satisfies
            %a.existingWikiWord{:href => "/nlab/show/axiom+K"} axiom K
            or
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/UIP"} UIP
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            is also univalent, then it is an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/h-groupoid"} h-groupoid
          %h3#closure_of_tarski_universes_under_other_type_formers Closure of Tarski universes under other type formers
          %p There are many ways of defining type formers internally in a universe:
          %ul
            %li
              %p
                by an equivalence,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/definitional+isomorphism"} definitional isomorphism
                %a.existingWikiWord{:href => "/nlab/show/judgmental+equality"} judgmental equality
                with an existing global type former for the entire type theory.
            %li
              %p
                by translating the rules for the type former into internal structure on the universe - the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/formation+rules"} formation rules
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/introduction+rules"} introduction rules
                %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
                of the structure.
            %li
              %p
                by using the
                %a.existingWikiWord{:href => "/nlab/show/universal+properties"} universal properties
                corresponding to the
                %a.existingWikiWord{:href => "/nlab/show/categorical+semantics"} categorical semantics
                of the types
          %p
            Using a
            %a.existingWikiWord{:href => "/nlab/show/judgmental+equality"} judgmental equality
            with an existing global type former for each type former results in a
            = succeed "," do
              %strong strict Tarski universe
            %span.newWikiWord
              definitinal isomorphisms
              %a{:href => "/nlab/new/definitinal+isomorphisms"} ?
            for each type former results in a
            = succeed "." do
              %strong weak Tarski universe
          %h3#tarski_universes_with_all_propositions Tarski universes with all propositions
          %p
            A Tarski universe
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ,
                  %mi T
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (U, T)
            %strong has all propositions
            if given a type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            with a family of identities
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi A
                    %mo ,
                    %mi y
                    %mo :
                    %mi A
                    %mo ⊢
                    %msub
                      %mi τ
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi x
                    %msub
                      %mo =
                      %mi A
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x:A, y:A \vdash \tau_{-1}(x, y):x =_A y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            comes with the structure of an element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mi U
                  %mo :
                  %mi U
                %annotation{:encoding => "application/x-tex"} A_U:U
            and an equivalence
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mi A
                    %mo :
                    %mi T
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mi U
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \delta_A:T(A_U) \simeq A
          %p The rules for this condition on Tarski universes is as follows:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo :
                      %mi A
                      %mo ,
                      %mi y
                      %mo :
                      %mi A
                      %mo ⊢
                      %msub
                        %mi τ
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi x
                      %msub
                        %mo =
                        %mi A
                      %mi y
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %msub
                        %mi A
                        %mi U
                      %mo :
                      %mi U
                  %mspace{:width => "2em"}
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo :
                      %mi A
                      %mo ,
                      %mi y
                      %mo :
                      %mi A
                      %mo ⊢
                      %msub
                        %mi τ
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi x
                      %msub
                        %mo =
                        %mi A
                      %mi y
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %msub
                        %mi δ
                        %mi A
                      %mo :
                      %mi T
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi A
                        %mi U
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mi A
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A \; \mathrm{type} \quad \Gamma, x:A, y:A \vdash \tau_{-1}(x, y):x =_A y}{\Gamma \vdash A_U:U} \qquad \frac{\Gamma \vdash A \; \mathrm{type} \quad \Gamma, x:A, y:A \vdash \tau_{-1}(x, y):x =_A y}{\Gamma \vdash \delta_A:T(A_U) \simeq A}
          %p
            Given a Tarski universe which has all propositions, the type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi A
                      %mo :
                      %mi U
                  %mi{:mathvariant => "normal"} isProp
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \sum_{A:U} \mathrm{isProp}(T(A))
            is the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/type+of+all+propositions"} type of all propositions
            %a.existingWikiWord{:href => "/nlab/show/impredicativity"} impredicativity
            in the type theory, as given a type
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo →
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi A
                      %mo :
                      %mi U
                  %mi{:mathvariant => "normal"} isProp
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A \to \sum_{A:U} \mathrm{isProp}(T(A))
            is the
            %a.existingWikiWord{:href => "/nlab/show/power+set"} power set
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %h2#tarski_subuniverses Tarski subuniverses
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ,
                  %msub
                    %mi T
                    %mi U
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (U, T_U)
            be a Tarski universe. A Tarski universe
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo ,
                  %msub
                    %mi T
                    %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (V, T_V)
            is a
            %strong Tarski subuniverse
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ,
                  %msub
                    %mi T
                    %mi U
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (U, T_U)
            if it comes with an
            %a.existingWikiWord{:href => "/nlab/show/embedding"} embedding
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo :
                  %mi V
                  %mo ↪
                  %mi U
                %annotation{:encoding => "application/x-tex"} t:V \hookrightarrow U
            and a dependent function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi a
                      %mo :
                      %mi V
                  %msub
                    %mi T
                    %mi U
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi T
                    %mi V
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} p:\prod_{a:V} T_U(t(a)) \simeq T_V(a)
          %p
            This is equivalent to a family of Tarski universes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (U(i), T(i))
            indexed by elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo :
                  %mi 𝟚
                %annotation{:encoding => "application/x-tex"} i:\mathbb{2}
            of the
            %a.existingWikiWord{:href => "/nlab/show/interval+preorder"} interval preorder
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝟚
                    %mo ,
                    %msub
                      %mo ≤
                      %mi 𝟚
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathbb{2}, \leq_\mathbb{2})
          %ul
            %li
              %p a dependent function
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mo :
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi a
                          %mo :
                          %mi 𝟚
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi b
                          %mo :
                          %mi 𝟚
                      %mo{:stretchy => "false"} (
                      %mi a
                      %msub
                        %mo ≤
                        %mi 𝟚
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo ↪
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} t:\prod_{a:\mathbb{2}} \prod_{b:\mathbb{2}} (a \leq_\mathbb{2} b) \to (U(a) \hookrightarrow U(b))
            %li
              %p a dependent function
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                      %mo :
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi a
                          %mo :
                          %mi 𝟚
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi b
                          %mo :
                          %mi 𝟚
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi p
                          %mo :
                          %mi a
                          %msub
                            %mo ≤
                            %mi 𝟚
                          %mi b
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi A
                          %mo :
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo{:stretchy => "false"} )
                      %mi T
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mi T
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi t
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} q:\prod_{a:\mathbb{2}} \prod_{b:\mathbb{2}} \prod_{p:a \leq_\mathbb{2} b} \prod_{A:U(a)} T(a)(A) \simeq T(b)(t(a, b)(p)(A))
              %p indicating that lifting each small type results in a type equivalent to the original small type.
          %h2#modalities_and_comodalities Modalities and comodalities
          %p
            A
            %strong
              %a.existingWikiWord{:href => "/nlab/show/modal+operator"} modal operator
            on a Tarski universe
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ,
                  %mi T
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (U, T)
            is just an
            %a.existingWikiWord{:href => "/nlab/show/endofunction"} endofunction
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo :
                    %mi U
                    %mo →
                    %mi U
                  %annotation{:encoding => "application/x-tex"} L:U \to U
            %strong modal unit family
            is a family of functions
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi L
                      %mo :
                      %mi U
                      %mo →
                      %mi U
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi A
                      %mo :
                      %mi U
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \eta:\prod_{L:U \to U}\prod_{A:U} T(A) \to T(L(A))
          %p
            and the
            %strong comodal counit family
            is a family of functions
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϵ
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi L
                      %mo :
                      %mi U
                      %mo →
                      %mi U
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi A
                      %mo :
                      %mi U
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \epsilon:\prod_{L:U \to U}\prod_{A:U} T(L(A)) \to T(A)
          %p
            Given a modal operator
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo :
                    %mi U
                    %mo →
                    %mi U
                  %annotation{:encoding => "application/x-tex"} L:U \to U
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \eta(L)
            is called the
            %strong modal unit
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϵ
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \epsilon(L)
            is called the
            %strong comodal counit
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo :
                  %mi U
                %annotation{:encoding => "application/x-tex"} A:U
            is
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              \-modal
            if the function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \eta(L)(A):T(A) \to T(L(A))
          %p
            is an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+types"} equivalence of types
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              \-comodal
            if the function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϵ
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \epsilon(L)(A):T(L(A)) \to T(A)
          %p is an equivalence of types.
          %p
            A
            %strong
              %a.existingWikiWord{:href => "/nlab/show/modality"} modality
            is…
          %p
            …and a
            %strong
              %a.existingWikiWord{:href => "/nlab/show/comodality"} comodality
            is…
          %h3#reflective_and_coreflective_tarski_subuniverses Reflective and coreflective Tarski subuniverses
          %p
            (Section under construction see
            %a.existingWikiWord{:href => "/nlab/show/reflective+subuniverse"} reflective subuniverse
            for the
            %a.existingWikiWord{:href => "/nlab/show/Russell+universe"} Russell universe
            variant for the time being)
          %h2#essentially_small_tarski_universes Essentially small Tarski universes
          %p
            A Tarski universe
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo ,
                  %msub
                    %mi T
                    %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (V, T_V)
            inside of a Tarski universe
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ,
                  %msub
                    %mi T
                    %mi U
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (U, T_U)
            consists of an element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo :
                  %mi U
                %annotation{:encoding => "application/x-tex"} V:U
            and a function
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi V
                    %mo :
                    %msub
                      %mi T
                      %mi U
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi U
                  %annotation{:encoding => "application/x-tex"} T_V:T_U(V) \to U
          %p
            Given a Tarski universe
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %msub
                      %mi T
                      %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (U, T_U)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo ,
                  %msub
                    %mi T
                    %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (V, T_V)
            is essentially
            = succeed "-small" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
          %ul
            %li
              %p
                an element
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo ′
                      %mo :
                      %mi U
                    %annotation{:encoding => "application/x-tex"} V':U
            %li
              %p
                a function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mrow
                          %mi V
                          %mo ′
                      %mo :
                      %msub
                        %mi T
                        %mi U
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo ′
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi U
                    %annotation{:encoding => "application/x-tex"} T_{V'}:T_U(V') \to U
            %li
              %p an equivalence
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} smallType
                      %mo :
                      %mi V
                      %mo ≃
                      %msub
                        %mi T
                        %mi U
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo ′
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathrm{smallType}:V \simeq T_U(V')
            %li
              %p a dependent function
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} smallFamily
                      %mo :
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi A
                          %mo :
                          %mi V
                      %msub
                        %mi T
                        %mi V
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %msub
                        %mi T
                        %mi U
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi T
                        %mrow
                          %mi V
                          %mo ′
                      %mo{:stretchy => "false"} (
                      %mi{:mathvariant => "normal"} smallType
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathrm{smallFamily}:\prod_{A:V} T_V(A) \simeq T_U(T_{V'}(\mathrm{smallType}(A)))
          %p
            Equivalently, the entire structure could be regarded as a family of Tarski universes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (U(a), T(a))
            indexed by elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo :
                  %mi 𝟚
                %annotation{:encoding => "application/x-tex"} a:\mathbb{2}
            of the
            %a.existingWikiWord{:href => "/nlab/show/interval+preorder"} interval preorder
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝟚
                    %mo ,
                    %msub
                      %mo ≤
                      %mi 𝟚
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathbb{2}, \leq_\mathbb{2})
          %ul
            %li
              %p a dependent function
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ′
                      %mo :
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi a
                          %mo :
                          %mi 𝟚
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi b
                          %mo :
                          %mi 𝟚
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi p
                          %mo :
                          %mi a
                          %msub
                            %mo ≤
                            %mi 𝟚
                          %mi b
                      %mrow
                        %mo (
                        %mo{:stretchy => "false"} (
                        %mi b
                        %msub
                          %mo ≤
                          %mi 𝟚
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi ∅
                        %mo )
                      %mo →
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U':\prod_{a:\mathbb{2}} \prod_{b:\mathbb{2}} \prod_{p:a \leq_\mathbb{2} b} \left((b \leq_\mathbb{2} a) \to \emptyset\right) \to U(b)
            %li
              %p a dependent function
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo ′
                      %mo :
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi a
                          %mo :
                          %mi 𝟚
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi b
                          %mo :
                          %mi 𝟚
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi p
                          %mo :
                          %mi a
                          %msub
                            %mo ≤
                            %mi 𝟚
                          %mi b
                      %mrow
                        %mo (
                        %mo{:stretchy => "false"} (
                        %mi b
                        %msub
                          %mo ≤
                          %mi 𝟚
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi ∅
                        %mo )
                      %mo →
                      %mrow
                        %mo (
                        %mi T
                        %mo{:stretchy => "false"} (
                        %mi b
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mi U
                        %mo ′
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo ,
                        %mi b
                        %mo ,
                        %mi p
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mi b
                        %mo{:stretchy => "false"} )
                        %mo )
                    %annotation{:encoding => "application/x-tex"} T':\prod_{a:\mathbb{2}} \prod_{b:\mathbb{2}} \prod_{p:a \leq_\mathbb{2} b} \left((b \leq_\mathbb{2} a) \to \emptyset\right) \to \left(T(b)(U'(a, b, p)) \to U(b)\right)
            %li
              %p an dependent function
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} smallType
                      %mo :
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi a
                          %mo :
                          %mi 𝟚
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi b
                          %mo :
                          %mi 𝟚
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi p
                          %mo :
                          %mi a
                          %msub
                            %mo ≤
                            %mi 𝟚
                          %mi b
                      %mrow
                        %mo (
                        %mo{:stretchy => "false"} (
                        %mi b
                        %msub
                          %mo ≤
                          %mi 𝟚
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi ∅
                        %mo )
                      %mo →
                      %mrow
                        %mo (
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %mi T
                        %mo{:stretchy => "false"} (
                        %mi b
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mi U
                        %mo ′
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo ,
                        %mi b
                        %mo ,
                        %mi p
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo )
                    %annotation{:encoding => "application/x-tex"} \mathrm{smallType}:\prod_{a:\mathbb{2}} \prod_{b:\mathbb{2}} \prod_{p:a \leq_\mathbb{2} b} \left((b \leq_\mathbb{2} a) \to \emptyset\right) \to \left(U(a) \simeq T(b)(U'(a, b, p))\right)
            %li
              %p a dependent function
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} smallFamily
                      %mo :
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi a
                          %mo :
                          %mi 𝟚
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi b
                          %mo :
                          %mi 𝟚
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi p
                          %mo :
                          %mi a
                          %msub
                            %mo ≤
                            %mi 𝟚
                          %mi b
                      %mrow
                        %mo (
                        %mo{:stretchy => "false"} (
                        %mi b
                        %msub
                          %mo ≤
                          %mi 𝟚
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi ∅
                        %mo )
                      %mo →
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi A
                          %mo :
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo{:stretchy => "false"} )
                      %mi T
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mi T
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo ,
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi{:mathvariant => "normal"} smallType
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo ,
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathrm{smallFamily}:\prod_{a:\mathbb{2}} \prod_{b:\mathbb{2}} \prod_{p:a \leq_\mathbb{2} b} \left((b \leq_\mathbb{2} a) \to \emptyset\right) \to \prod_{A:U(a)} T(a)(A) \simeq T(b)(T'(a, b, p)(\mathrm{smallType}(a, b, p)(A)))
          %h2#hierarchy_of_tarski_universes Hierarchy of Tarski universes
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/preorder"} preorder
            = succeed "-indexed" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            such that for all indices
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo :
                    %mi P
                  %annotation{:encoding => "application/x-tex"} a:P
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (U(a), T(a))
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo :
                  %mi P
                %annotation{:encoding => "application/x-tex"} a:P
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                  %mo :
                  %mi P
                %annotation{:encoding => "application/x-tex"} b:P
            and witnesses
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi a
                    %msub
                      %mo ≤
                      %mi P
                    %mi b
                  %annotation{:encoding => "application/x-tex"} p:a \leq_P b
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (U(a), T(a))
            is an essentially
            = succeed "-small" do
