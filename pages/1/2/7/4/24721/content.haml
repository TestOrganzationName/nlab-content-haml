                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{ax}_\Sigma:\sum_{\Sigma:\prod_{A:U} (T(A) \to U) \to U} \prod_{A:U} \prod_{B:T(A) \to U} T(\Sigma(A, B)) \simeq \sum_{x:T(A)} T(B(x))
          %p
            Regular univalent Tarski universes are the type theoretic equivalent of
            %a.existingWikiWord{:href => "/nlab/show/regular+cardinals"} regular cardinals
            in
            = succeed "." do
