                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} x:V \vdash \mathrm{El}(x) \coloneqq \mathrm{hom}(1, y)
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
