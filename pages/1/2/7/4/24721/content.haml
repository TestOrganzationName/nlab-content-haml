                  %mn 1
                  %mo :
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} 1:\mathcal{E}
            is the
            %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
            and
            %a.existingWikiWord{:href => "/nlab/show/indecomposable+object"} indecomposable
            %a.existingWikiWord{:href => "/nlab/show/projective+object"} projective
            %a.existingWikiWord{:href => "/nlab/show/separator"} separator
            of the category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
