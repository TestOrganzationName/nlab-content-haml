                        %mtr
                          %mtd
                            %msup
                              %mi E
                              %mo •
                          %mtd
                            %mo ↦
                            %mo{:stretchy => "false"} (
                            %msup
                              %mover
                                %mi E
                                %mo{:stretchy => "false"} ˜
                              %mo •
                            %mo{:lspace => "verythinmathspace"} :
