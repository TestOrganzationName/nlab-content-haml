                    \\stackrel{\delta}{\longrightarrow}
                    \\tilde E^\bullet(X)
                    \\stackrel{}{\longrightarrow}
                    E^\bullet(X)
                    \\stackrel{}{\longrightarrow}
                    E^\bullet(\ast)
                    \\stackrel{\delta}{\longrightarrow}
                    \\tilde E^{\bullet+1}(X)
                    \\to
                    \\cdots
            %p
              which by the exactness clause in def.
              %a.maruku-ref{:href => "#GeneralizedCohomologyTheory"}
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exact
            %p
              Now since the composite
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo →
                    %mi X
                    %mo →
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \ast \to X \to \ast
              is the identity, the morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
