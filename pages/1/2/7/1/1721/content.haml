            %p
              with the right map an epimorphism. Hence this is a
              %a.existingWikiWord{:href => "/nlab/show/split+exact+sequence"} split exact sequence
              and the statement follows.
          %h2#brown_functoriality Brown functoriality
          .num_prop
            %h6#proposition_7 Proposition
            %p
              Given a generalized cohomology functor
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi E
                        %mo •
                      %mo{:lspace => "verythinmathspace"} :
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi op
                      %mo →
                      %msup
                        %mi Ab
                        %mi ℤ
                    %annotation{:encoding => "application/x-tex"} E^\bullet \colon Ho(\mathcal{C})^{op}\to Ab^{\mathbb{Z}}
              = succeed "," do
                %a.maruku-ref{:href => "#GeneralizedCohomologyOnGeneralInfinityCategory"}
              = succeed "-valued" do
                %a.existingWikiWord{:href => "/nlab/show/Set"} Set
