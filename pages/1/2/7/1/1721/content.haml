              be an unreduced cohomology theory, def.
              = succeed "." do
                %a.maruku-ref{:href => "#GeneralizedCohomologyTheory"}
              %a.maruku-ref{:href => "#ReducedGeneralizedCohomology"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mo •
                    %mo ,
                    %mi σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\tilde E^\bullet, \sigma)
              as follows.
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo{:lspace => "verythinmathspace"} :
                    %mo *
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \colon \ast \to X
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/pointed+topological+space"} pointed topological space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde E^\bullet(X,x) \coloneqq E^\bullet(X,\{x\})
                    \\,.
            %p
              This is clearly
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/functor"} functorial
              %a.existingWikiWord{:href => "/nlab/show/suspension+isomorphism"} suspension isomorphism
              to be the composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi E
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mi X
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msup
                          %mi E
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo{:stretchy => "false"} )
                    %msup
                      %mi E
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msup
