              has a
              %a.existingWikiWord{:href => "/nlab/show/section"} section
              and so is in particular an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
              %a.existingWikiWord{:href => "/nlab/show/connecting+homomorphism"} connecting homomorphism
              vanishes,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \delta = 0
              and we have a
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msup
                      %mover
                        %mi E
