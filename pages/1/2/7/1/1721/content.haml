          %h2#RelationBetweenReducedAndUnreduced Relation between reduced and unreduced cohomology
          #FromUnreducedToReducedCohomology.num_defn
            %h6#definition_6 Definition
            %p
              %strong (unreduced to reduced cohomology)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
