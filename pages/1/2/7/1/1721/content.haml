                                    %mi σ
                                    %mi F
                        %mtr
                          %mtd
                            %msup
                              %mover
                                %mi E
                                %mo{:stretchy => "false"} ˜
                              %mrow
                                %mo •
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                                %mn 1
                            %mo{:stretchy => "false"} (
