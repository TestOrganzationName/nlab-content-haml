                %a.maruku-ref{:href => "#ReducedGeneralizedCohomology"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi E
                        %mo •
                    %annotation{:encoding => "application/x-tex"} E^\bullet
              = succeed "," do
                %a.maruku-ref{:href => "#GeneralizedCohomologyTheory"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msup
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
