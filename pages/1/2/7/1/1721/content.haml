              %a.existingWikiWord{:href => "/nlab/show/Brown+functor"} Brown functor
              holds by definition of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
