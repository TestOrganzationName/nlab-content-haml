          %h2#idea Idea
          %p
            The right
            %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjoint functor
            of a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            %a.existingWikiWord{:href => "/nlab/show/weak+inverse"} weak inverse
            of that functor. (The other best approximation is the functor's
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/adjoint+equivalence"} adjoint equivalence
          %p
            A right adjoint to a
            %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
            is called a
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/cofree+functor"} cofree functor
          %p
            The concept generalises immediately to
            %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched categories
            and in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-categories
          %h2#definitions Definitions
          %p
            Given
            %a.existingWikiWord{:href => "/nlab/show/partial+order"} posets
            (or
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/preorder"} prosets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            and a monotone function
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo :
                    %mi C
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} U: C \to D
            %strong right adjoint
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            is a monotone function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo :
                  %mi D
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} G: D \to C
            such that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
