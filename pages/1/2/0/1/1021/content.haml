                  %mspace{:width => "thickmathspace"}
                  %mi x
                  %mo ≤
                  %mi G
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} U(x) \leq y \;\Leftrightarrow\; x \leq G(y)
          %p
            for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
