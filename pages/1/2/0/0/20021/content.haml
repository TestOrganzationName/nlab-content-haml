                    %mrow
                      %msup
                        %mi 𝒞
                        %mstyle{:mathvariant => "bold"}
                          %mn 2
                      %mo ×
                      %msup
                        %mi 𝒞
                        %mstyle{:mathvariant => "bold"}
                          %mn 2
                      %mo →
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\mathbf{2}} \times \mathcal{C}^{\mathbf{2}}\to \mathcal{C}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
