          %h2#definition Definition
          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and an
            %a.existingWikiWord{:href => "/nlab/show/object"} object
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} c \in C
            %strong under category
            (also called
            = succeed ")" do
              %strong coslice category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo{:stretchy => "false"} ↓
                  %mi C
                %annotation{:encoding => "application/x-tex"} c \downarrow C
            (alternative notations include
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mrow
                      %mi c
                      %mo{:stretchy => "false"} /
                %annotation{:encoding => "application/x-tex"} C^{c/}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo{:stretchy => "false"} /
                  %mi C
                %annotation{:encoding => "application/x-tex"} c/C
            and sometimes, confusingly,
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo \
                    %mi C
                  %annotation{:encoding => "application/x-tex"} c\backslash C
          %ul
            %li
              %p
                objects are morphisms in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                starting at
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi c
                      %annotation{:encoding => "application/x-tex"} c
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo →
                      %mi d
                    %annotation{:encoding => "application/x-tex"} c \to d
            %li
              %p
                morphisms are commuting triangles
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mi c
                          %mtr
                            %mtd
                            %mtd
                              %mo ↙
                            %mtd
                            %mtd
                              %mo ↘
                          %mtr
                            %mtd
                              %msub
                                %mi d
                                %mn 1
                            %mtd
                            %mtd
                              %mo →
                            %mtd
                            %mtd
                              %msub
                                %mi d
                                %mn 2
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \&amp;&amp; c
                      \\\
                      \&amp; \swarrow &amp;&amp; \searrow
                      \\\
                      d_1 &amp;&amp;\to &amp;&amp; d_2
                      }
                      \\,.
          %p
            The under category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo{:stretchy => "false"} ↓
                  %mi C
                %annotation{:encoding => "application/x-tex"} c\downarrow C
            is a kind of
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/comma+category"} comma category
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi c
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                          %mi C
                        %mtd
                          %mo →
                        %mtd
                          %mi pt
                      %mtr
                        %mtd
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                        %mtd
                        %mtd
                          %msup
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %mi pt
                                %mo ↦
                                %mi c
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} [
                          %mi I
                          %mo ,
                          %mi C
                          %mo{:stretchy => "false"} ]
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mi d
                                %mn 0
                        %mtd
                          %mi C
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  c \big\downarrow C
                  \&amp;\to&amp;
                  pt
                  \\\
                  \\big\downarrow
                  \&amp;&amp;
                  \\big\downarrow^{\mathrlap{pt \mapsto c}}
                  \\\
                  [I,C]
                  \&amp;\stackrel{d_0}{\to}&amp;
                  C
                  }
          %p
            in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
                is the
                %a.existingWikiWord{:href => "/nlab/show/interval+category"} interval category
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mn 0
                        %mo →
                        %mn 1
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{0 \to 1\}
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi I
                      %mo ,
                      %mi C
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [I,C]
                is the
                %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} internal hom
                in
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
                %a.existingWikiWord{:href => "/nlab/show/arrow+category"} arrow category
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Arr
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Arr(C)
            %li
              %p
                the functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} d_0
                is evaluation at the left end of the interval;
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi pt
                    %annotation{:encoding => "application/x-tex"} pt
                , the point, is the terminal category, the 0th
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/oriental"} oriental
            %li
              %p
                the right vertical morphism maps the single object of the point to the object
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi c
                      %annotation{:encoding => "application/x-tex"} c
          %p
            The left vertical morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo{:stretchy => "false"} ↓
                  %mi C
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} c \downarrow C \to C
            is the forgetful morphism which forgets the tip of the triangles mentioned above.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/duality"} dual
            notion is an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/over+category"} over category
          %h2#examples Examples
          %p
          .num_remark
            %h6 Example
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
              is an
              %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                    %annotation{:encoding => "application/x-tex"} \mathbf{C}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo{:stretchy => "false"} ↓
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                  %annotation{:encoding => "application/x-tex"} 0\downarrow\mathbf{C}
              is isomorphic to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                    %annotation{:encoding => "application/x-tex"} \mathbf{C}
          %p
          #PointedObjects.num_remark
            %h6 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/pointed+objects"}> pointed objects
                )
              %br/
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              has a
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                      %mspace{:width => "thinmathspace"}
                      %mo ∈
                      %mspace{:width => "thinmathspace"}
                      %mi C
                    %annotation{:encoding => "application/x-tex"} \ast \,\in\, C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} C^{\ast/}
              is known as the category of
              %em
                %a.existingWikiWord{:href => "/nlab/show/pointed+objects"} pointed objects
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
            %ul
              %li
                %p
                  the category of
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/pointed+sets"} pointed sets
                  %a.existingWikiWord{:href => "/nlab/show/Set"} Set
                  under the
                  %a.existingWikiWord{:href => "/nlab/show/singleton"} singleton
                  set,
              %li
                %p
                  the category of
                  %a.existingWikiWord{:href => "/nlab/show/pointed+topological+spaces"} pointed topological spaces
                  is the coslice of
                  %a.existingWikiWord{:href => "/nlab/show/Top"} Top
                  under the
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/point+space"} point space
              %li
                %p
                  the category of
                  %a.existingWikiWord{:href => "/nlab/show/pointed+simplicial+sets"} pointed simplicial sets
                  is the coslice of
                  %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
                  under the
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/0-simplex"} 0-simplex
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is a
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
              with
              %a.existingWikiWord{:href => "/nlab/show/tensor+unit"} tensor unit
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mspace{:width => "thinmathspace"}
                      %mo ∈
                      %mspace{:width => "thinmathspace"}
                      %mi C
                    %annotation{:encoding => "application/x-tex"} I \,\in\, C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo{:stretchy => "false"} ↓
                    %mi C
                  %annotation{:encoding => "application/x-tex"} I \downarrow C
              is also known as the category of
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/pointed+objects+in+a+monoidal+category"} pointed objects in a monoidal category
            %ul
              %li
                %p
                  the category of
                  %a.existingWikiWord{:href => "/nlab/show/pointed+abelian+groups"} pointed abelian groups
                  is the coslice of
                  %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
                  under the additive group of
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/integers"} integers
              %li
                %p
                  the category of
                  %a.existingWikiWord{:href => "/nlab/show/pointed+modules"} pointed modules
                  is the coslice of
                  %a.existingWikiWord{:href => "/nlab/show/Mod"} Mod
                  under the additive module of the
                  %a.existingWikiWord{:href => "/nlab/show/ground+ring"} ground ring
              %li
                %p
                  the category of
                  %a.existingWikiWord{:href => "/nlab/show/bi-pointed+object"} bi-pointed sets
                  is the coslice of
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi Set
                            %mo *
                        %annotation{:encoding => "application/x-tex"} Set_*
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/category+of+pointed+sets"} category of pointed sets
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/boolean+domain"} boolean domain
              %li
                %p
                  the category of
                  %a.existingWikiWord{:href => "/nlab/show/pointed+endofunctors"} pointed endofunctors
                  is a coslice of and
                  = succeed "-" do
                    %a.existingWikiWord{:href => "/nlab/show/endofunctor"} endo
                  %a.existingWikiWord{:href => "/nlab/show/functor+category"} functor category
                  under the
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/identity+functor"} identity functor
            %p
              Generally, for any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} c \in C
              one may think of the
              = succeed "-coslice" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                    %annotation{:encoding => "application/x-tex"} c
              = succeed "-pointed" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                    %annotation{:encoding => "application/x-tex"} c
          %p
          .num_remark
            %h6 Example
            %p
              The category of
              %a.existingWikiWord{:href => "/nlab/show/commutative+algebras"} commutative algebras
              over a
              %a.existingWikiWord{:href => "/nlab/show/field"} field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is the coslice under
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              of the category
              %a.existingWikiWord{:href => "/nlab/show/CRing"} CRing
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/commutative+rings"} commutative rings
          %h2#properties Properties
          %h3#LimitsAndColimits Limits and Colimits
          .num_prop
            %h6#proposition Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              with all
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/limits"} limits
              %a.existingWikiWord{:href => "/nlab/show/limit"} limit
              in any of its
              %a.existingWikiWord{:href => "/nlab/show/under+categories"} under categories
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo{:stretchy => "false"} /
                    %mi C
                  %annotation{:encoding => "application/x-tex"} t/C
              is computed as a limit in the underlying category
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
            %p In detail:
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:lspace => "verythinmathspace"} :
                    %mi D
                    %mo →
                    %mi t
                    %mo{:stretchy => "false"} /
                    %mi C
                  %annotation{:encoding => "application/x-tex"} F \colon D \to t/C
              be any
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            %p
              Then, the
              %a.existingWikiWord{:href => "/nlab/show/limit"} limit
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∘
                    %mi F
                  %annotation{:encoding => "application/x-tex"} p \circ F
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is the image under the evident projection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %mi t
                    %mo{:stretchy => "false"} /
                    %mi C
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} p \colon t/C \to C
              of the limit over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              itself:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mi lim
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi lim
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mi F
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    p(\lim F)  \simeq \lim (p F)
            %p
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi lim
                    %mi F
                  %annotation{:encoding => "application/x-tex"} \lim F
              is uniquely characterized by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi lim
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mi F
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \lim (p F)
          .proof
            %h6#proof Proof
            %p
              Over a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo :
                    %mi d
                    %mo →
                    %mi d
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \gamma : d \to d'
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              the limiting cone over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mi F
                  %annotation{:encoding => "application/x-tex"} p F
              (which exists by assumption) looks like
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi lim
                            %mi p
                            %mi F
                        %mtr
                          %mtd
                          %mtd
                            %mo ↙
                          %mtd
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                            %mi p
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi p
                                %mi F
                                %mo{:stretchy => "false"} (
                                %mi γ
                                %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mi p
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo ′
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; \lim p F
                    \\\
                    \&amp; \swarrow &amp;&amp; \searrow
                    \\\
                    p F(d) &amp;&amp;\stackrel{p F(\gamma)}{\to}&amp;&amp; p F(d')
                    }
            %p
              By the universal property of the limit this has a unique lift to a cone in the
              %a.existingWikiWord{:href => "/nlab/show/under+category"} under category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo{:stretchy => "false"} /
                    %mi C
                  %annotation{:encoding => "application/x-tex"} t/C
              over
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi t
                        %mtr
                          %mtd
                          %mtd
                            %mo ↙
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi lim
                            %mi p
                            %mi F
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ↙
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi p
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi p
                                %mi F
                                %mo{:stretchy => "false"} (
                                %mi γ
                                %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mi p
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo ′
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; t
                    \\\
                    \&amp; \swarrow &amp;\downarrow &amp; \searrow
                    \\\
                    \&amp;&amp; \lim p F
                    \\\
                    \\downarrow &amp; \swarrow &amp;&amp; \searrow &amp; \downarrow
                    \\\
                    p F(d) &amp;&amp;\stackrel{p F(\gamma)}{\to}&amp;&amp; p F(d')
                    }
            %p
              It therefore remains to show that this is indeed a limiting cone over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo →
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} t \to Q
              be another cone over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mo{:stretchy => "false"} /
                      %mi C
                    %annotation{:encoding => "application/x-tex"} t/C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
              is another cone over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mi F
                  %annotation{:encoding => "application/x-tex"} p F
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and we get in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              a universal morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo →
                    %mi lim
                    %mi p
                    %mi F
                  %annotation{:encoding => "application/x-tex"} Q \to \lim p F
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi t
                        %mtr
                          %mtd
                          %mtd
                            %mo ↙
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi Q
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ↙
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ↘
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi lim
                            %mi p
                            %mi F
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ↙
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi p
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi p
                                %mi F
                                %mo{:stretchy => "false"} (
                                %mi γ
                                %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mi p
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo ′
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; t
                    \\\
                    \&amp; \swarrow &amp; \downarrow &amp; \searrow
                    \\\
                    \&amp;&amp; Q
                    \\\
                    \\downarrow &amp; \swarrow &amp;\downarrow &amp; \searrow &amp; \downarrow
                    \\\
                    \&amp;&amp; \lim p F
                    \\\
                    \\downarrow &amp; \swarrow &amp;&amp; \searrow &amp; \downarrow
                    \\\
                    p F(d) &amp;&amp;\stackrel{p F(\gamma)}{\to}&amp;&amp; p F(d')
                    }
            %p
              A glance at the diagram above shows that the composite
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo →
                    %mi Q
                    %mo →
                    %mi lim
                    %mi p
                    %mi F
                  %annotation{:encoding => "application/x-tex"} t \to Q \to \lim p F
              constitutes a morphism of cones in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              into the limiting cone over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mi F
                    %annotation{:encoding => "application/x-tex"} p F
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mo →
                      %mi lim
                      %mi p
                      %mi F
                    %annotation{:encoding => "application/x-tex"} t \to \lim p F
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi lim
                      %mi p
                      %mi F
                    %annotation{:encoding => "application/x-tex"} \lim p F
            %p
              This shows that the morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo →
                    %mi lim
                    %mi p
                    %mi F
                  %annotation{:encoding => "application/x-tex"} Q \to \lim p F
              which was the unique one giving a cone morphism on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              does lift to a cone morphism in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mo{:stretchy => "false"} /
                      %mi C
                    %annotation{:encoding => "application/x-tex"} t/C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo →
                    %mi lim
                    %mi p
                    %mi F
                  %annotation{:encoding => "application/x-tex"} t \to \lim p F
              and thus identifies it with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi lim
                      %mi F
                    %annotation{:encoding => "application/x-tex"} \lim F
          .num_remark
            %h6#remark Remark
            %p
              One often says “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              = succeed "\u201D" do
                %a.existingWikiWord{:href => "/nlab/show/reflected+limit"} reflects limits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo :
                    %mi A
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} U: A \to C
              is
              %a.existingWikiWord{:href => "/nlab/show/monadic+functor"} monadic
              (i.e., has a left adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              such that the canonical comparison functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mtext -Alg
                  %annotation{:encoding => "application/x-tex"} A \to (U F)\text{-Alg}
              is an equivalence), then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              both reflects and preserves limits. In the present case, the projection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi A
                    %mo =
                    %mi t
                    %mo{:stretchy => "false"} /
                    %mi C
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} p: A = t/C \to C
              is monadic, is essentially the category of algebras for the monad
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi t
                      %mo +
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} T(-) = t + (-)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              admits binary coproducts. (Added later: the proof is even simpler: if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo :
                    %mi A
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} U: A \to C
              is the underlying functor for the category of algebras of an
              %em endofunctor
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              (as opposed to algebras of a monad), then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              reflects and preserves limits; then apply this to the endofunctor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              above.)
          %p
            The analogue is not true for general colimits in an under category, but it is true for all
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/connected+colimits"} connected colimits
          %p
          #ForgetfulFunctorCreatedConnectedColimits.num_prop
            %h6 Proposition
            %p
              The forgetful functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo{:stretchy => "false"} /
                    %mi C
                    %mo ⟶
                    %mi C
                  %annotation{:encoding => "application/x-tex"} t/C \longrightarrow C
              %a.existingWikiWord{:href => "/nlab/show/created+limit"} creates
              all
              %a.existingWikiWord{:href => "/nlab/show/connected+colimits"} connected colimits
              that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              admits.
          %p
            For this and the previous statement see also for instance
            %a{:href => "#Riehl17"} Riehl 2017 Prop. 3.3.8
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/over-category"} over-category
              %ul
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/slice+category"} slice category
                %li
                  %p
                    %strong under category
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/over+topos"} over topos
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/over+%28%E2%88%9E%2C1%29-category"}> over (∞,1)-category
                ,
              %ul
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/model+structure+on+an+over+category"} model structure on an over category
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/over-%28%E2%88%9E%2C1%29-topos"} over-(∞,1)-topos
          %h2#references References
          %blockquote
            %p
              For more see most of the references at
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
          %p Textbook accounts:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Francis+Borceux"}> Francis Borceux
                \. Ex. 1.2.7 in:
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Handbook+of+Categorical+Algebra"} Handbook of Categorical Algebra
                = succeed ":" do
                  %strong 1
                = succeed "," do
                  %em Basic Category Theory
                = succeed "," do
                  %strong 50
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1017/CBO9780511525858"} doi:10.1017/CBO9780511525858
            %li#Riehl17
              %p
                %a.existingWikiWord{:href => "/nlab/show/Emily+Riehl"}> Emily Riehl
                , Ex. 1.1.3 in:
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Category+Theory+in+Context"} Category Theory in Context
                = succeed "," do
                  %a{:href => "https://store.doverpublications.com/products/9780486809038"} ISBN:9780486809038
                = succeed "," do
                  %a{:href => "https://emilyriehl.github.io/files/context.pdf"} pdf
                = succeed "&rbrack;" do
                  %a{:href => "https://math.jhu.edu/~eriehl/context/"} webpage
          %p
            Discussion in the generality of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-categories"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
                \-categories
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              , Rem. 1.2.5.9 in:
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} Higher Topos Theory
              = succeed "," do
                %strong 170
              = succeed "," do
                %a{:href => "https://press.princeton.edu/titles/8957.html"} pup:8957
              = succeed "&rbrack;" do
                %a{:href => "https://www.math.ias.edu/~lurie/papers/HTT.pdf"} pdf
