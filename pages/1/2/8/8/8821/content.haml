          %h2#idea Idea
          %p
            The
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/empty+set"} empty set
          %ol
            %li
              %p
                there is a
                %em unique
                %a.existingWikiWord{:href => "/nlab/show/function"} function
                %em out
                of the empty set, to any other set;
            %li
              %p
                there is
                %em no
                %a.existingWikiWord{:href => "/nlab/show/function"} function
                %em to
                the empty set, except from itself.
          %p
            The first property generalizes to arbitrary
            %a.existingWikiWord{:href => "/nlab/show/categories"} categories
            as the property of an
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
          %p
            The corresponding generalization including also the second property is that of a
            = succeed ":" do
              %em strict initial object
          %h2#definition Definition
          %p
            An
            %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∅
                %annotation{:encoding => "application/x-tex"} \varnothing
            is called a
            %strong strict initial object
            if every
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            %a.existingWikiWord{:href => "/nlab/show/codomain"} to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∅
                %annotation{:encoding => "application/x-tex"} \varnothing
            is an
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
          #eq:MorphismToStrictInitialObjectIsIsomorphism.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mover
                    %mo ⟶
                    %mi f
                  %mo ∅
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ⇒
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi X
                  %munderover
                    %mo ⟶
                    %mo ≃
                    %mi f
                  %mi ∅
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  X \overset{f}{\longrightarrow} \varnothing
                  \\;\;\;\;\;\;\;\;\;
                  \\Rightarrow
                  \\;\;\;\;\;\;\;\;\;
                  X \underoverset{\simeq}{f}{\longrightarrow} \emptyset
                  \\,.
          %h2#Properties Properties
          %ul
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
                of any
                %a.existingWikiWord{:href => "/nlab/show/object"} object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                with a strict initial object is isomorphic to the strict initial object,
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ×
                        %mo ∅
                        %mo ≃
                        %mo ∅
                      %annotation{:encoding => "application/x-tex"} X \times \varnothing \simeq \varnothing
                %a.existingWikiWord{:href => "/nlab/show/projection"} projection
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi pr
                        %mn 1
                      %mo{:lspace => "verythinmathspace"} :
                      %mo ∅
                      %mo ×
                      %mi X
                      %mo →
                      %mo ∅
                    %annotation{:encoding => "application/x-tex"} pr_1 \colon \varnothing \times X \to \varnothing
                exists by definition of Cartesian products, whence
                %a.maruku-eqref{:href => "#eq:MorphismToStrictInitialObjectIsIsomorphism"} (1)
                implies that it is an isomorphism
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∅
                      %mo ×
                      %mi X
                      %munderover
                        %mo ⟶
                        %mrow
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mo ≃
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                        %mrow
                          %msub
                            %mi pr
                            %mn 1
                      %mo ∅
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\varnothing \times X
                      \\underoverset
                      {\;\;\;\simeq\;\;\;}
                      {pr_1}
                      {\longrightarrow}
                      \\varnothing
                      \\,.
            %li
              %p
                Strict initial objects may be understood as
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/van+Kampen+colimits"} van Kampen colimits
                = succeed "." do
                  %a{:href => "#SobocinskiHeindel11"} Sobocinski &amp; Heindel (2011), Exp. 4.5 (i)
                %a.existingWikiWord{:href => "/nlab/show/slice+category"} slice category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo{:stretchy => "false"} /
                      %mo ∅
                    %annotation{:encoding => "application/x-tex"} C/\varnothing
                be
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
                to the
                %a.existingWikiWord{:href => "/nlab/show/terminal+category"} terminal category
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} \mathbf{1}
          %h2#Examples Examples
          %ul
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/empty+set"} empty set
                is a strict initial object in
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Sets"} Sets
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/empty+topological+space"} empty topological space
                is a strict initial object in
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/TopologicalSpaces"} TopologicalSpaces
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/empty+groupoid"} empty groupoid
                is a strict initial object in
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Groupoids"} Groupoids
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/empty+simplicial+set"} empty simplicial set
                is a strict initial object in
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/SimplicialSets"} SimplicialSets
            %li
              %p The initial objects of any of the following types of categories are strict:
              %ul
                %li
                  %p
                    in
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/posets"} posets
                %li
                  %p
                    in
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/toposes"} toposes
                %li
                  %p
                    in
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/extensive+categories"} extensive categories
                %li
                  %p
                    in
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/distributive+categories"} distributive categories
                %li
                  %p
                    in
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+categories"} cartesian closed categories
                %li
                  %p
                    more generally, in any category where the
                    %a.existingWikiWord{:href => "/nlab/show/products"} products
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo ∅
                          %mo ×
                          %mi X
                        %annotation{:encoding => "application/x-tex"} \varnothing \times X
                    exist and are initial (that is, where the product functor
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo ×
                          %mi X
                        %annotation{:encoding => "application/x-tex"} - \times X
                    = succeed ")." do
                      %a.existingWikiWord{:href => "/nlab/show/preserved+colimit"} preserves initial objects
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                          %mo :
                          %mi X
                          %mo →
                          %mo ∅
                        %annotation{:encoding => "application/x-tex"} f : X \to \varnothing
                    is a
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/section"} section
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/inverse"} inverse
                    = succeed "," do
