                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    p^\alpha_\mu
                    \&amp; \coloneqq
                    \\frac{\partial }{\partial \psi^\alpha_{,\mu}}
                    \\left(
