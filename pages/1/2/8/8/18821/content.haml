              for the
              %a.existingWikiWord{:href => "/nlab/show/B-field"} B-field
              on
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              from example
              = succeed "." do
                %a.maruku-ref{:href => "#BField"}
              %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
              coordinates taken to be
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi b
                      %mrow
                        %mi μ
                        %mi ν
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (b_{\mu \nu})
              with
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi b
                      %mrow
                        %mi μ
                        %mi ν
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mi b
