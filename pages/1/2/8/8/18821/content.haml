                for
                %a.existingWikiWord{:href => "/nlab/show/free+field"} free
                %a.existingWikiWord{:href => "/nlab/show/real+scalar+field"} real scalar field
                on
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
            %p
              Consider the
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              for the
              %a.existingWikiWord{:href => "/nlab/show/real+scalar+field"} real scalar field
              from example
              = succeed "," do
                %a.maruku-ref{:href => "#RealScalarFieldBundle"}
              %a.existingWikiWord{:href => "/nlab/show/trivial+line+bundle"} trivial line bundle
              over
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
            %p
              According to def.
              %a.maruku-ref{:href => "#JetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
              its
              %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi J
                      %mi Σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} J^\infty_\Sigma(E)
              has canonical coordinates
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo {
                      %mo{:stretchy => "false"} {
                      %msup
                        %mi x
                        %mi μ
                      %mo{:stretchy => "false"} }
                      %mo ,
                      %mi ϕ
                      %mo ,
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi ϕ
                        %mrow
                          %mo ,
                          %mi μ
                      %mo{:stretchy => "false"} }
                      %mo ,
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi ϕ
                        %mrow
                          %mo ,
                          %msub
                            %mi μ
                            %mn 1
                          %msub
                            %mi μ
                            %mn 2
                      %mo{:stretchy => "false"} }
                      %mo ,
                      %mi ⋯
                      %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{
                    \\{x^\mu\}, \phi, \{\phi_{,\mu}\}, \{\phi_{,\mu_1 \mu_2}\}, \cdots
                    \\right\}
                    \\,.
            %p
              In these coordinates, the
              %a.existingWikiWord{:href => "/nlab/show/local+Lagrangian+density"} local Lagrangian density
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo ∈
                    %msup
                      %mi Ω
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} L \in \Omega^{p+1,0}(\Sigma)
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LocalLagrangianDensityOnSecondOrderJetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
              %a.existingWikiWord{:href => "/nlab/show/free+field"} free
              %a.existingWikiWord{:href => "/nlab/show/real+scalar+field"} real scalar field
              of
              %a.existingWikiWord{:href => "/nlab/show/mass"} mass
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo ∈
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} m \in \mathbb{R}
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo ≔
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mn 2
                    %mrow
                      %mo (
                      %msup
                        %mi η
                        %mrow
                          %mi μ
                          %mi ν
                      %msub
                        %mi ϕ
                        %mrow
                          %mo ,
                          %mi μ
                      %msub
                        %mi ϕ
                        %mrow
                          %mo ,
                          %mi ν
                      %mo −
                      %msup
                        %mi m
                        %mn 2
                      %msup
                        %mi ϕ
                        %mn 2
                      %mo )
                    %msub
                      %mi{:mathvariant => "normal"} dvol
                      %mi Σ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    L
                    \\coloneqq
                    \\tfrac{1}{2}
                    \\left(
                    \\eta^{\mu \nu} \phi_{,\mu} \phi_{,\nu}
                    \-
                    m^2 \phi^2
                    \\right)
                    \\mathrm{dvol}_\Sigma
                    \\,.
            %p
              This is naturally thought of as a collection of Lagrangians smoothly parameterized by the
              %a.existingWikiWord{:href => "/nlab/show/metric"} metric
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
              and the
              %a.existingWikiWord{:href => "/nlab/show/mass"} mass
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                    %annotation{:encoding => "application/x-tex"} m
              = succeed "-free" do
                %a.existingWikiWord{:href => "/nlab/show/physical+unit"} physical unit
              %a.maruku-ref{:href => "#ParameterizedLagrangianDensities"}
              the
              %a.existingWikiWord{:href => "/nlab/show/physical+unit"} physical unit
              of the parameter
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                  %annotation{:encoding => "application/x-tex"} m
              must be that of the inverse metric, hence must be an inverse
              %a.existingWikiWord{:href => "/nlab/show/length"} length
              according to remark
              %a.maruku-ref{:href => "#MinkowskiMetricAndPhysicalUnitOfLength"}
              This is the
              %em
                inverse
                %a.existingWikiWord{:href => "/nlab/show/Compton+wavelength"} Compton wavelength
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℓ
                      %mi m
                    %mo =
                    %mi ℏ
                    %mo{:stretchy => "false"} /
                    %mi m
                    %mi c
                  %annotation{:encoding => "application/x-tex"} \ell_m = \hbar / m c
              %a.maruku-eqref{:href => "#eq:ComptonWavelength"} (?)
              and hence the
              = succeed "-free" do
                %a.existingWikiWord{:href => "/nlab/show/physical+unit"} physical unit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mrow
                        %mi η
                        %mo ,
                        %msub
                          %mi ℓ
                          %mi m
                    %mspace{:width => "mediummathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mrow
                          %msubsup
                            %mi ℓ
                            %mi m
                            %mn 2
                        %mn 2
                    %mrow
                      %mo (
                      %msup
                        %mi η
                        %mrow
                          %mi μ
                          %mi ν
                      %msub
                        %mi ϕ
                        %mrow
                          %mo ,
                          %mi μ
                      %msub
                        %mi ϕ
                        %mrow
                          %mo ,
                          %mi ν
                      %mo −
                      %msup
                        %mrow
                          %mo (
                          %mstyle{:displaystyle => "false"}
                            %mfrac
                              %mrow
                                %mi m
                                %mi c
                              %mi ℏ
                          %mo )
                        %mn 2
                      %msup
                        %mi ϕ
                        %mn 2
                      %mo )
                    %msub
                      %mi{:mathvariant => "normal"} dvol
                      %mi Σ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{L}_{\eta,\ell_m}
                    \\:\coloneqq\;
                    \\tfrac{\ell_m^2}{2}
                    \\left(
                    \\eta^{\mu \nu} \phi_{,\mu} \phi_{,\nu}
                    \-
                    \\left( \tfrac{m c}{\hbar} \right)^2 \phi^2
                    \\right)
                    \\mathrm{dvol}_\Sigma
                    \\,.
          #phintheoryLagrangian.num_example
            %h6#example_2 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/phi%5En+theory"}> phi^n theory
                )
            %p
              Consider the
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              for the
              %a.existingWikiWord{:href => "/nlab/show/real+scalar+field"} real scalar field
              from example
              = succeed "," do
                %a.maruku-ref{:href => "#RealScalarFieldBundle"}
              %a.existingWikiWord{:href => "/nlab/show/trivial+line+bundle"} trivial line bundle
              over
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              %a.existingWikiWord{:href => "/nlab/show/free+field"} free field
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
              from example
              %a.maruku-ref{:href => "#LagrangianForFreeScalarFieldOnMinkowskiSpacetime"}
              some power of the field coordinate
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mi int
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi g
                    %msup
                      %mi ϕ
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi dvol
                      %mi Σ
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{L}_{int}
                    \\;\coloneqq\;
                    g \phi^n \, dvol_\Sigma
                    \\,,
            %p
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ∈
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} g \in \mathbb{R}
              some number, here called the
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/coupling+constant"} coupling constant
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/interacting+field+theory"} interacting
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              defined by the resulting
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo +
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mi int
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mn 2
                    %mrow
                      %mo (
                      %msup
                        %mi η
                        %mrow
                          %mi μ
                          %mi ν
                      %msub
                        %mi ϕ
                        %mrow
                          %mo ,
                          %mi μ
                      %msub
                        %mi ϕ
                        %mrow
                          %mo ,
                          %mi ν
                      %mo −
                      %msup
                        %mi m
                        %mn 2
                      %msup
                        %mi ϕ
                        %mn 2
                      %mo +
                      %mi g
                      %msup
                        %mi ϕ
                        %mi n
                      %mo )
                    %msub
                      %mi{:mathvariant => "normal"} dvol
                      %mi Σ
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{L}
                    +
                    \\mathbf{L}_{int}
                    \\;=\;
                    \\tfrac{1}{2}
                    \\left(
                    \\eta^{\mu \nu} \phi_{,\mu} \phi_{,\nu}
                    \-
                    m^2 \phi^2
                    +
                    g \phi^n
                    \\right)
                    \\mathrm{dvol}_\Sigma
            %p
              is usually called just
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/phi%5En+theory"} phi^n theory
          #ElectromagnetismLagrangianDensity.num_example
            %h6#example_3 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/local+Lagrangian+density"} local Lagrangian density
                for
                %a.existingWikiWord{:href => "/nlab/show/free+field"} free
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/electromagnetic+field"} electromagnetic field
            %p
              Consider the
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi T
                      %mo *
                    %mi Σ
                    %mo →
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} T^\ast \Sigma \to \Sigma
              for the
              %a.existingWikiWord{:href => "/nlab/show/electromagnetic+field"} electromagnetic field
              on
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              from example
              = succeed "," do
                %a.maruku-ref{:href => "#Electromagnetism"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cotangent+bundle"} cotangent bundle
              %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial vector bundle
              of
              %a.existingWikiWord{:href => "/nlab/show/rank+of+a+vector+bundle"} rank
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo +
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} p+1
              %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
              coordinates taken to be
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi a
                        %mi μ
                      %msubsup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi μ
                          %mo =
                          %mn 0
                        %mi p
                    %annotation{:encoding => "application/x-tex"} (a_\mu)_{\mu = 0}^p
              %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi J
                      %mi Σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi T
                      %mo *
                    %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} J^\infty_\Sigma(T^\ast \Sigma)
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#JetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi x
                        %mi μ
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi a
                        %mi μ
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi a
                        %mrow
                          %mi μ
                          %mo ,
                          %mi ν
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi a
                        %mrow
                          %mi μ
                          %mo ,
                          %msub
                            %mi ν
                            %mn 1
                          %msub
                            %mi ν
                            %mn 2
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi ⋯
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} ( (x^\mu), (a_\mu), (a_{\mu,\nu}), (a_{\mu,\nu_1 \nu_2}), \cdots )
            %p
              Consider then the
              %a.existingWikiWord{:href => "/nlab/show/local+Lagrangian+density"} local Lagrangian density
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LocalLagrangianDensityOnSecondOrderJetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
            #eq:ElectromagnetismLagrangian.maruku-equation
              %span.maruku-eq-number (3)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mn 2
                    %msub
                      %mi f
                      %mrow
                        %mi μ
                        %mi ν
                    %msup
                      %mi f
                      %mrow
                        %mi μ
                        %mi ν
                    %msub
                      %mi dvol
                      %mi Σ
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi Ω
                      %mi Σ
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi T
                      %mo *
                    %mi Σ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{L}
                    \\;\coloneqq\;
                    \\tfrac{1}{2}
                    f_{\mu \nu} f^{\mu \nu} dvol_\Sigma
                    \\;\in\;
                    \\Omega^{p+1,0}_\Sigma(T^\ast \Sigma)
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mrow
                        %mi μ
                        %mi ν
                    %mo ≔
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mn 2
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mrow
                        %mi ν
                        %mo ,
                        %mi μ
                    %mo −
                    %msub
                      %mi a
                      %mrow
                        %mi μ
                        %mo ,
                        %mi ν
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f_{\mu \nu} \coloneqq \tfrac{1}{2}(a_{\nu,\mu} - a_{\mu,\nu})
              are the components of the universal
              %a.existingWikiWord{:href => "/nlab/show/Faraday+tensor"} Faraday tensor
              on the
              %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
              from example
              = succeed "." do
                %a.maruku-ref{:href => "#JetFaraday"}
            %p
              This is the
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
              that defines the Lagrangian field theory of
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/free+field"} free
                  %a.existingWikiWord{:href => "/nlab/show/electromagnetism"} electromagnetism
            %p
              Here for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi T
                      %mo *
                    %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \in \Gamma_\Sigma(T^\ast \Sigma)
              an
              %a.existingWikiWord{:href => "/nlab/show/electromagnetic+field"} electromagnetic field
              history (
              %a.existingWikiWord{:href => "/nlab/show/vector+potential"}> vector potential
              ), then the
              %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pullback
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mrow
                        %mi μ
                        %mi ν
                  %annotation{:encoding => "application/x-tex"} f_{\mu \nu}
              along its
              %a.existingWikiWord{:href => "/nlab/show/jet+prolongation"} jet prolongation
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#JetProlongation"}
              %a.existingWikiWord{:href => "/nlab/show/Faraday+tensor"} Faraday tensor
              = succeed ":" do
                %a.maruku-eqref{:href => "#eq:TensorFaraday"} (?)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msup
                              %mrow
                                %mo (
                                %msubsup
                                  %mi j
                                  %mi Σ
                                  %mn ∞
                                %mo{:stretchy => "false"} (
                                %mi A
                                %mo{:stretchy => "false"} )
                                %mo )
                              %mo *
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi f
                              %mrow
                                %mi μ
                                %mi ν
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mi A
                            %msub
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi μ
                                %mi ν
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi F
                              %mrow
                                %mi μ
                                %mi ν
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\left(
                    j^\infty_\Sigma(A)
                    \\right)^\ast(f_{\mu \nu})
                    \&amp; =
                    (d A)_{\mu \nu}
                    \\\
                    \&amp; = F_{\mu \nu}
                    \\end{aligned}
            %p
              It follows that the pullback of the Lagrangian
              %a.maruku-eqref{:href => "#eq:ElectromagnetismLagrangian"} (3)
              along the jet prologation of the electromagnetic field is
            .maruku-equation
