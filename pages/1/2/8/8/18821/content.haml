                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}^\infty \hookrightarrow J^\infty_\Sigma(E)
              %a.maruku-eqref{:href => "#eq:ProlongedShellInJetBundle"} (12)
              the total spacetime derivative of the
              %a.existingWikiWord{:href => "/nlab/show/presymplectic+current"} presymplectic current
              vanishes:
            #eq:HorizontalDerivativeOfPresymplecticCurrentVanishesOnShell.maruku-equation
              %span.maruku-eq-number (18)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
