                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\delta_{EL}\mathbf{L}
                    \\;=\;
                    \\left(\eta^{\mu \nu} \phi_{,\mu \nu} - m^2 \right) \delta \phi \wedge dvol_\sigma
                    \\;\in\;
                    \\Omega^{p+1,1}_{\Sigma}(E)
                    \\,.
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ω
                      %mi BFV
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %msup
                        %mi η
                        %mrow
                          %mi μ
                          %mi ν
                      %mi δ
                      %msub
                        %mi ϕ
                        %mrow
                          %mo ,
                          %mi μ
                      %mo ∧
                      %mi δ
                      %mi ϕ
                      %mo )
                    %mo ∧
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mo ∂
                          %mi ν
                    %msub
                      %mi dvol
                      %mi Σ
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi Ω
                      %mi Σ
                      %mrow
                        %mi p
                        %mo ,
                        %mn 2
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega_{BFV}
                    \\;=\;
                    \\left(\eta^{\mu \nu} \delta \phi_{,\mu} \wedge \delta \phi \right) \wedge \iota_{\partial_\nu} dvol_{\Sigma}
                    \\;\in\;
                    \\Omega^{p,2}_{\Sigma}(E)
                    \\,,
            %p respectively.
          .proof
            %h6#proof_4 Proof
            %p
              This is a special case of example
              = succeed "," do
                %a.maruku-ref{:href => "#CanonicalMomentum"}
            %p
              We need to show that
              %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+operator"} Euler-Lagrange operator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mi EL
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi Ω
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msubsup
                      %mi Ω
                      %mi S
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                        %mo ,
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \delta_{EL} \colon \Omega^{p+1,0}(\Sigma) \to \Omega^{p+1,1}_S(\Sigma)
              takes the
              %a.existingWikiWord{:href => "/nlab/show/local+Lagrangian+density"} local Lagrangian density
              for the
              %a.existingWikiWord{:href => "/nlab/show/free+field"} free
              %a.existingWikiWord{:href => "/nlab/show/scalar+field"} scalar field
              to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mi EL
                    %mi L
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %msup
                        %mi η
                        %mrow
                          %mi μ
                          %mi ν
                      %msub
                        %mi ϕ
                        %mrow
                          %mo ,
                          %mi μ
                          %mi ν
                      %mo −
                      %msup
                        %mi m
                        %mn 2
                      %mi ϕ
                      %mo )
                    %mi δ
                    %mi ϕ
                    %mo ∧
                    %msub
                      %mi{:mathvariant => "normal"} dvol
                      %mi Σ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\delta_EL L
                    \\;=\;
                    \\left(
                    \\eta^{\mu \nu} \phi_{,\mu \nu} - m^2 \phi
                    \\right)
                    \\delta \phi \wedge \mathrm{dvol}_\Sigma
                    \\,.
            %p
              First of all, using just the
              %a.existingWikiWord{:href => "/nlab/show/variational+derivative"} variational derivative
              (
              %a.existingWikiWord{:href => "/nlab/show/vertical+derivative"}> vertical derivative
              )
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                  %annotation{:encoding => "application/x-tex"} \delta
              is a graded
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %mi L
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %msup
                        %mi η
                        %mrow
                          %mi μ
                          %mi ν
                      %msub
                        %mi ϕ
                        %mrow
                          %mo ,
                          %mi μ
                      %mi δ
                      %msub
                        %mi ϕ
                        %mrow
                          %mo ,
                          %mi ν
                      %mo −
                      %msup
                        %mi m
                        %mn 2
                      %mi ϕ
                      %mi δ
                      %mi ϕ
                      %mo )
                    %mo ∧
                    %msub
                      %mi{:mathvariant => "normal"} dvol
                      %mi Σ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\delta L
                    \\;=\;
                    \\left(
                    \\eta^{\mu \nu} \phi_{,\mu} \delta \phi_{,\nu}
                    \-
                    m^2 \phi \delta \phi
                    \\right)
                    \\wedge \mathrm{dvol}_\Sigma
                    \\,.
            %p
              By definition of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+operator"} Euler-Lagrange operator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mi EL
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                  %annotation{:encoding => "application/x-tex"} \delta_{EL}\mathbf{L}
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Θ
                        %mi BFV
                    %annotation{:encoding => "application/x-tex"} \Theta_{BFV}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo ∧
                      %mi δ
                      %mi ϕ
                      %mo −
                      %mi d
                      %msub
                        %mi Θ
                        %mi BFV
                    %annotation{:encoding => "application/x-tex"} (-) \wedge \delta \phi  - d \Theta_{BFV}
            %p
              The key to find
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Θ
                      %mi BFV
                  %annotation{:encoding => "application/x-tex"} \Theta_{BFV}
              is to realize
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %msub
                      %mi ϕ
                      %mrow
                        %mo ,
                        %mi ν
                    %mo ∧
                    %msub
                      %mi{:mathvariant => "normal"} dvol
                      %mi Σ
                  %annotation{:encoding => "application/x-tex"} \delta \phi_{,\nu}\wedge \mathrm{dvol}_\Sigma
              as a
              %a.existingWikiWord{:href => "/nlab/show/total+derivative"} total spacetime derivative
              (
              %a.existingWikiWord{:href => "/nlab/show/horizontal+derivative"}> horizontal derivative
              ). Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mi ϕ
                    %mo =
                    %msub
                      %mi ϕ
                      %mrow
                        %mo ,
                        %mi μ
                    %mi d
                    %msup
                      %mi x
                      %mi μ
                  %annotation{:encoding => "application/x-tex"} d \phi = \phi_{,\mu} d x^\mu
              this is accomplished by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %msub
                      %mi ϕ
                      %mrow
                        %mo ,
                        %mi ν
                    %mo ∧
                    %msub
                      %mi{:mathvariant => "normal"} dvol
                      %mi Σ
                    %mo =
                    %mi δ
                    %mi d
                    %mi ϕ
                    %mo ∧
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mo ∂
                          %mi ν
                    %msub
                      %mi{:mathvariant => "normal"} dvol
                      %mi Σ
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\delta \phi_{,\nu} \wedge \mathrm{dvol}_\Sigma
                    \=
                    \\delta d \phi \wedge \iota_{\partial_\nu} \mathrm{dvol}_\Sigma
                    \\,,
            %p
              where on the right we have the contraction (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ContractionOfFormsWithVectorFields"}
              %a.existingWikiWord{:href => "/nlab/show/tangent+vector+field"} tangent vector field
              along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mi ν
                  %annotation{:encoding => "application/x-tex"} x^\nu
              into the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/volume+form"} volume form
            %p
              Hence we may take the presymplectic potential
              %a.maruku-eqref{:href => "#eq:PresymplecticPotential"} (13)
              of the free scalar field to be
            #eq:PresymplecticPotentialOfFreeScalarField.maruku-equation
              %span.maruku-eq-number (23)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Θ
                      %mi BFV
                    %mo ≔
                    %msup
                      %mi η
                      %mrow
                        %mi μ
                        %mi ν
                    %msub
                      %mi ϕ
                      %mrow
                        %mo ,
                        %mi μ
                    %mi δ
                    %mi ϕ
                    %mo ∧
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mo ∂
                          %mi ν
                    %msub
                      %mi{:mathvariant => "normal"} dvol
                      %mi Σ
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\Theta_{BFV}
                    \\coloneqq
                    \\eta^{\mu \nu} \phi_{,\mu} \delta \phi \wedge \iota_{\partial_\nu}
                    \\mathrm{dvol}_\Sigma
                    \\,,
            %p because with this we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %msub
                      %mi Θ
                      %mi BFV
                    %mo =
                    %msup
                      %mi η
                      %mrow
                        %mi μ
                        %mi ν
                    %mrow
                      %mo (
                      %msub
                        %mi ϕ
                        %mrow
                          %mo ,
                          %mi μ
                          %mi ν
                      %mi δ
                      %mi ϕ
                      %mo −
                      %msup
                        %mi η
                        %mrow
                          %mi μ
                          %mi ν
                      %msub
                        %mi ϕ
                        %mrow
                          %mo ,
                          %mi μ
                      %mi δ
                      %msub
                        %mi ϕ
                        %mrow
                          %mo ,
                          %mi ν
                      %mo )
                    %mo ∧
                    %msub
                      %mi{:mathvariant => "normal"} dvol
                      %mi Σ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    d \Theta_{BFV}
                    \=
                    \\eta^{\mu \nu}
                    \\left(
                    \\phi_{,\mu \nu} \delta \phi
                    \-
                    \\eta^{\mu \nu} \phi_{,\mu} \delta \phi_{,\nu}
                    \\right) \wedge \mathrm{dvol}_\Sigma
                    \\,.
            %p In conclusion this yields the decomposition of the vertical differential of the Lagrangian density
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %mi L
                    %mo =
                    %munder
                      %munder
                        %mrow
                          %mrow
                            %mo (
                            %msup
                              %mi η
                              %mrow
                                %mi μ
                                %mi ν
                            %msub
                              %mi ϕ
                              %mrow
                                %mo ,
                                %mi μ
                                %mi ν
                            %mo −
                            %msup
                              %mi m
                              %mn 2
                            %mi ϕ
                            %mo )
                          %mi δ
                          %mi ϕ
                          %mo ∧
                          %msub
                            %mi{:mathvariant => "normal"} dvol
                            %mi Σ
                        %mo ⏟
                      %mrow
                        %mo =
                        %msub
                          %mi δ
                          %mi EL
                        %mi ℒ
                    %mo −
                    %mi d
                    %msub
                      %mi Θ
                      %mi BFV
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\delta L
                    \=
                    \\underset{
                    \= \delta_{EL} \mathcal{L}
                    }{
                    \\underbrace{
                    \\left(
                    \\eta^{\mu \nu} \phi_{,\mu \nu}  - m^2 \phi
                    \\right)
                    \\delta \phi \wedge \mathrm{dvol}_\Sigma
                    }
                    }
                    \-
                    d \Theta_{BFV}
                    \\,,
            %p
              which shows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mi EL
                    %mi L
                  %annotation{:encoding => "application/x-tex"} \delta_{EL} L
              is as claimed, and that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Θ
                      %mi BFV
                  %annotation{:encoding => "application/x-tex"} \Theta_{BFV}
              is a presymplectic potential current
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:PresymplecticPotential"} (13)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi Ω
                              %mi BFV
                          %mtd
                            %mo ≔
                            %mi δ
                            %msub
                              %mi Θ
                              %mi BFV
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi δ
                            %mrow
                              %mo (
                              %msup
                                %mi η
                                %mrow
                                  %mi μ
                                  %mi ν
                              %msub
                                %mi ϕ
                                %mrow
                                  %mo ,
                                  %mi μ
                              %mi δ
                              %mi ϕ
                              %mo ∧
                              %msub
                                %mi ι
                                %mrow
                                  %msub
                                    %mo ∂
                                    %mi ν
                              %msub
                                %mi{:mathvariant => "normal"} dvol
                                %mi Σ
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mrow
                              %mo (
                              %msup
                                %mi η
                                %mrow
                                  %mi μ
                                  %mi ν
                              %mi δ
                              %msub
                                %mi ϕ
                                %mrow
                                  %mo ,
                                  %mi μ
                              %mo ∧
                              %mi δ
                              %mi ϕ
                              %mo )
                            %mo ∧
                            %msub
                              %mi ι
                              %mrow
                                %msub
                                  %mo ∂
                                  %mi ν
                            %msub
                              %mi dvol
                              %mi Σ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\Omega_{BFV} &amp;\coloneqq \delta \Theta_{BFV}
                    \\\
                    \&amp; =
                    \\delta \left( \eta^{\mu \nu} \phi_{,\mu} \delta \phi \wedge \iota_{\partial_\nu} \mathrm{dvol}_\Sigma \right)
                    \\\
