                        %mi α
                        %mo ′
                    %msup
                      %mi γ
                      %mrow
                        %mi α
                        %mo ′
                    %msub
                      %mrow
                      %mrow
                        %mi β
                        %mi γ
                  %annotation{:encoding => "application/x-tex"} \gamma_{\alpha \beta \gamma} \coloneqq k_{\alpha \alpha'} \gamma^{\alpha'}{}_{\beta \gamma}
              is totally skew-symmetric in its indices (this being the coefficients of the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+cocycle"} Lie algebra cocycle
              %a.existingWikiWord{:href => "/nlab/show/Killing+form"} Killing form
              %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
