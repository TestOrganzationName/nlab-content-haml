              (def.
              %a.maruku-ref{:href => "#LocalLagrangianDensityOnSecondOrderJetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
              then the corresponding
              %em
                %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+equation"} Euler-Lagrange
                %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
              is the condition on
              %a.existingWikiWord{:href => "/nlab/show/field+histories"} field histories
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SupergeometricSpaceOfFieldHistories"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
