                        %mi ν
                        %mi μ
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    b_{\mu \nu} = - b_{\nu \mu}
                    \\,,
            %p
              the induced fiber coordinates on the corresponding
              %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi J
                      %mi Σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi T
                      %mo *
                    %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} J^\infty_\Sigma(T^\ast \Sigma)
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#JetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi x
                        %mi μ
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi b
                        %mrow
                          %mi μ
                          %mi ν
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi b
                        %mrow
                          %mi μ
                          %mi ν
                          %mo ,
                          %msub
                            %mi μ
                            %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi b
                        %mrow
                          %mi μ
                          %mi ν
                          %mo ,
                          %msub
                            %mi μ
                            %mn 1
                          %msub
                            %mi μ
                            %mn 2
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi ⋯
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} ( (x^\mu), (b_{\mu \nu}), (b_{\mu \nu, \mu_1}), (b_{\mu \nu, \mu_1 \mu_2}), \cdots )
            %p
              Consider then the
              %a.existingWikiWord{:href => "/nlab/show/local+Lagrangian+density"} local Lagrangian density
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LocalLagrangianDensityOnSecondOrderJetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
            #eq:LagrangianForBField.maruku-equation
              %span.maruku-eq-number (5)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mn 2
                    %msub
                      %mi h
                      %mrow
                        %msub
                          %mi μ
                          %mn 1
                        %msub
                          %mi μ
                          %mn 2
                        %msub
                          %mi μ
                          %mn 3
                    %msup
                      %mi h
                      %mrow
                        %msub
                          %mi μ
                          %mn 1
                        %msub
                          %mi μ
                          %mn 2
                        %msub
                          %mi μ
                          %mn 3
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi dvol
                      %mi Σ
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi Ω
                      %mi Σ
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mo ∧
                      %mi Σ
                      %mn 2
                    %msup
                      %mi T
                      %mo *
                    %mi Σ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{L}
                    \\;\coloneqq\;
                    \\tfrac{1}{2}
                    h_{\mu_1 \mu_2 \mu_3} h^{\mu_1 \mu_2 \mu_3} \, dvol_\Sigma
                    \\;\in\;
                    \\Omega^{p+1,0}_\Sigma(\wedge^2_\Sigma T^\ast \Sigma)
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi h
                      %mrow
                        %msub
                          %mi μ
                          %mn 1
                        %msub
                          %mi μ
                          %mn 2
                        %msub
                          %mi μ
                          %mn 3
                  %annotation{:encoding => "application/x-tex"} h_{\mu_1 \mu_2 \mu_3}
              are the components of the universal
              %a.existingWikiWord{:href => "/nlab/show/B-field"} B-
              %a.existingWikiWord{:href => "/nlab/show/field+strength"} field strength
              on the
              %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
              from example
              = succeed "." do
                %a.maruku-ref{:href => "#BFieldJetFaraday"}
          #LagrangianDensityForDiracField.num_example
            %h6#example_6 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
                for
                %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
                %a.existingWikiWord{:href => "/nlab/show/Dirac+field"} Dirac field
                on
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              of
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo +
                    %mn 1
                    %mo ∈
                    %mo{:stretchy => "false"} {
                    %mn 3
                    %mo ,
                    %mn 4
                    %mo ,
                    %mn 6
                    %mo ,
                    %mn 10
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} p + 1 \in \{3,4,6,10\}
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#MinkowskiSpacetime"}
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mo ×
                    %msub
                      %mi S
                      %mi odd
                    %mo →
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma \times S_{odd} \to \Sigma
              for the
              %a.existingWikiWord{:href => "/nlab/show/Dirac+field"} Dirac field
              from example
              = succeed "." do
                %a.maruku-ref{:href => "#DiracFieldBundle"}
              %a.existingWikiWord{:href => "/nlab/show/spinor"} spinor
              %a.existingWikiWord{:href => "/nlab/show/field+fiber"} field fiber
              coordinates from remark
              = succeed "," do
                %a.maruku-ref{:href => "#TwoComponentSpinorNotation"}
              %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
              has induced fiber coordinates as follows:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mrow
                        %mo (
                        %msup
                          %mi ψ
                          %mi α
                        %mo )
                      %mo ,
                      %mrow
                        %mo (
                        %msubsup
                          %mi ψ
                          %mrow
                            %mo ,
                            %mi μ
                          %mi α
                        %mo )
                      %mo ,
                      %mi ⋯
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mrow
                        %mo (
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi χ
                          %mi a
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi χ
                          %mrow
                            %mi a
                            %mo ,
                            %mi μ
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi ⋯
                        %mo )
                      %mo ,
                      %mrow
                        %mo (
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ξ
                          %mrow
                            %mo †
                            %mover
                              %mi a
                              %mo ˙
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mo{:stretchy => "false"} (
                        %msubsup
                          %mi ξ
                          %mrow
                            %mo ,
                            %mi μ
                          %mrow
                            %mo †
                            %mover
                              %mi a
                              %mo ˙
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi ⋯
                        %mo )
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    \\left(\psi^\alpha\right)
                    ,
                    \\left(
                    \\psi^\alpha_{,\mu}
                    \\right)
                    ,
                    \\cdots
                    \\right)
                    \\;=\;
                    \\left(
                    \\left(
                    (\chi_a), (\chi_{a,\mu}), \cdots
                    \\right),
                    \\left(
                    ( \xi^{\dagger \dot a}), (\xi^{\dagger \dot a}_{,\mu}), \cdots
                    \\right)
                    \\right)
            %p
              All of these are odd-graded elements (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SupercommutativeSuperalgebra"}
              %a.existingWikiWord{:href => "/nlab/show/Grassmann+algebra"} Grassmann algebra
              (example
              = succeed ")," do
                %a.maruku-ref{:href => "#GrassmannAlgebra"}
              = succeed ":" do
                %a.maruku-eqref{:href => "#eq:DiracFieldCoordinatesAnticommute"} (?)
            #eq:DiracFieldJetCoordinatesAnticommute.maruku-equation
              %span.maruku-eq-number (6)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi ψ
                      %mrow
                        %mo ,
                        %msub
                          %mi μ
                          %mn 1
                        %mi ⋯
                        %msub
                          %mi μ
                          %mi r
                      %mi α
                    %msubsup
                      %mi ψ
                      %mrow
                        %mo ,
                        %msub
                          %mi μ
                          %mn 1
                        %mi ⋯
                        %msub
                          %mi μ
                          %mi s
                      %mi β
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo −
                    %msubsup
                      %mi ψ
                      %mrow
                        %mo ,
                        %msub
                          %mi μ
                          %mn 1
                        %mi ⋯
                        %msub
                          %mi μ
                          %mi s
                      %mi β
                    %msubsup
                      %mi ψ
                      %mrow
                        %mo ,
                        %msub
                          %mi μ
                          %mn 1
                        %mi ⋯
                        %msub
                          %mi μ
                          %mi r
                      %mi α
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\psi^\alpha_{,\mu_1 \cdots \mu_r}
                    \\psi^\beta_{,\mu_1 \cdots \mu_s}
                    \\;=\;
                    \-
                    \\psi^\beta_{,\mu_1 \cdots \mu_s}
                    \\psi^\alpha_{,\mu_1 \cdots \mu_r}
                    \\,.
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LocalLagrangianDensityOnSecondOrderJetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
              %em
                massless
                %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
                %a.existingWikiWord{:href => "/nlab/show/Dirac+field"} Dirac field
              on
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              is
            #eq:DiracFieldLagrangianMassless.maruku-equation
              %span.maruku-eq-number (7)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mi ψ
                      %mo ¯
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi γ
                      %mi μ
                    %msub
                      %mi ψ
                      %mrow
                        %mo ,
                        %mi μ
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi dvol
                      %mi Σ
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{L}
                    \\;\coloneqq\;
                    \\overline{\psi} \, \gamma^\mu \psi_{,\mu}\, dvol_\Sigma
                    \\,,
            %p
              given by the bilinear pairing
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %mo ¯
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \overline{(-)}\Gamma(-)
              from prop.
              %a.maruku-ref{:href => "#RealSpinorPairingsViaDivisionAlg"}
              of the field coordinate with its first spacetime derivative and expressed here in two-component spinor field coordinates as in
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:TwoComponentNotationForSpinorToVectorPairing"} (?)
              %a.existingWikiWord{:href => "/nlab/show/Dirac+conjugate"} Dirac conjugate
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi ψ
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"} \overline{\psi}
              %a.maruku-eqref{:href => "#eq:DiracConjugate"} (?)
              on the left.
            %p
              Specifically in
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo +
                      %mn 1
                      %mo =
                      %mn 4
                    %annotation{:encoding => "application/x-tex"} p + 1 = 4
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+function"} Lagrangian function
              for the
              %em
                massive
                %a.existingWikiWord{:href => "/nlab/show/Dirac+field"} Dirac field
              of
              %a.existingWikiWord{:href => "/nlab/show/mass"} mass
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo ∈
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} m \in \mathbb{R}
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi L
                          %mtd
                            %mo ≔
                            %munder
                              %munder
                                %mrow
                                  %mi i
                                  %mspace{:width => "thinmathspace"}
                                  %mover
                                    %mi ψ
                                    %mo ¯
                                  %mspace{:width => "thinmathspace"}
                                  %msup
                                    %mi γ
                                    %mi μ
                                  %mspace{:width => "thinmathspace"}
                                  %msub
                                    %mi ψ
                                    %mrow
                                      %mo ,
                                      %mi μ
                                %mo ⏟
                              %mtext kinetic term
                            %mo +
                            %munder
                              %munder
                                %mrow
                                  %mi m
                                  %mover
                                    %mi ψ
                                    %mo ¯
                                  %mi ψ
                                %mo ⏟
                              %mtext mass term
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    L
                    \&amp; \coloneqq
                    \\underset{
                    \\text{kinetic term}
                    }{
                    \\underbrace{
                    i \, \overline{\psi} \, \gamma^\mu \, \psi_{,\mu}
                    }
                    }
                    +
                    \\underset{
                    \\text{mass term}
                    }{
                    \\underbrace{
                    m \overline{\psi} \psi
                    }}
                    \\end{aligned}
            %p
              This is naturally thought of as a collection of Lagrangians smoothly parameterized by the
              %a.existingWikiWord{:href => "/nlab/show/metric"} metric
