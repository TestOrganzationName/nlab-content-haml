          .proof
            %h6#proof_8 Proof
            %p
              In any case the
              %a.existingWikiWord{:href => "/nlab/show/canonical+momentum"} canonical momentum
              of the
              %a.existingWikiWord{:href => "/nlab/show/Dirac+field"} Dirac field
              according to example
              %a.maruku-ref{:href => "#CanonicalMomentum"}
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
