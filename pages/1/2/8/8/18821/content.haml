                        %mo +
                        %mn 1
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{L} \;\in \; \Omega^{p+1,0}_{\Sigma}(E)
                    \\,.
            %p
              By example
              %a.maruku-ref{:href => "#BasicFactsAboutVarationalCalculusOnJetBundleOfTrivialVectorBundle"}
              in terms of the given
              %a.existingWikiWord{:href => "/nlab/show/volume+form"} volume form
              on spacetimes, any such Lagrangian density may uniquely be written as
            #eq:LagrangianFunctionViaVolumeForm.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo =
                    %mi L
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi dvol
                      %mi Σ
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{L} = L \, dvol_\Sigma
            %p
              where the
              %a.existingWikiWord{:href => "/nlab/show/coefficient"} coefficient
              function (the
              = succeed ")" do
                %em Lagrangian function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo =
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi x
                      %mi μ
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ϕ
                      %mi a
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi ϕ
                      %mrow
                        %mo ,
                        %mi μ
                      %mi a
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi ⋯
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    L = L((x^\mu), (\phi^a), (\phi^a_{,\mu}), \cdots )
                    \\,.
            %p
              where by prop.
              %a.maruku-ref{:href => "#JetBundleIsLocallyProManifold"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi x
                      %mi μ
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi ⋯
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} L((x^\mu), \cdots)
              depends locally on an arbitrary but finite order of derivatives
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi ϕ
                        %mrow
                          %mo ,
                          %msub
                            %mi μ
                            %mn 1
                          %mi ⋯
                          %msub
                            %mi μ
                            %mi k
                        %mi a
                    %annotation{:encoding => "application/x-tex"} \phi^a_{,\mu_1 \cdots \mu_k}
            %p
              We say that a
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
                      %mi fb
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} \Sigma
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FieldsAndFieldBundles"}
              %a.existingWikiWord{:href => "/nlab/show/local+Lagrangian+density"} local Lagrangian density
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                  %annotation{:encoding => "application/x-tex"} \mathbf{L}
              is (or defines) a
              %em
                %a.existingWikiWord{:href => "/nlab/show/prequantum+field+theory"} prequantum
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              on the
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
          #ParameterizedLagrangianDensities.num_remark
            %h6#remark Remark
            %p
              %strong
                (parameterized and
                = succeed "-less" do
                  %a.existingWikiWord{:href => "/nlab/show/physical+unit"} physical unit
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Lagrangian+densities"} Lagrangian densities
            %p
              More generally we may consider parameterized collections of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+densities"} Lagrangian densities
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi U
                    %mo ⟶
                    %msubsup
                      %mi Ω
                      %mi Σ
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{L}_{(-)}
                    \\;\colon\;
                    U \longrightarrow \Omega^{p+1,0}_\Sigma(E)
            %p
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              some
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              or generally some
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/super+Cartesian+space"} super Cartesian space
            %p
              For example all
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+densities"} Lagrangian densities
              considered in
              %a.existingWikiWord{:href => "/nlab/show/relativistic+field+theory"} relativistic field theory
              are naturally
              %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
              of the scale of the
              %a.existingWikiWord{:href => "/nlab/show/metric"} metric
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SpacetimeAsMatrices"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi ℝ
                              %mrow
                                %mo &gt;
                                %mn 0
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                            %msubsup
                              %mi Ω
                              %mi Σ
                              %mrow
                                %mi p
                                %mo +
                                %mn 1
                                %mo ,
                                %mn 0
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mi r
                          %mtd
                            %mo ↦
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi L
                              %mrow
                                %msup
                                  %mi r
                                  %mn 2
                                %mi η
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbb{R}_{\gt 0}
                    \&amp;\overset{}{\longrightarrow}&amp;
                    \\Omega^{p+1,0}_\Sigma(E)
                    \\\
                    r &amp;\mapsto&amp; \mathbf{L}_{r^2\eta}
                    }
            %p
              But by the discussion in remark
              = succeed "," do
                %a.maruku-ref{:href => "#MinkowskiMetricAndPhysicalUnitOfLength"}
              %a.existingWikiWord{:href => "/nlab/show/physics"} physics
              a rescaling of the
              %a.existingWikiWord{:href => "/nlab/show/metric"} metric
              is interpreted as reflecting but a change of
              %a.existingWikiWord{:href => "/nlab/show/physical+units"} physical units
              of
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/length"} length
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/distance"} distance
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
              is supposed to express intrinsic content of a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/theory+%28physics%29"} physical theory
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/physical+units"} physical units
            %p
              This is achieved by having the Lagrangian be parameterized by
              %em further
              parameters, whose corresponding
              %a.existingWikiWord{:href => "/nlab/show/physical+units"} physical units
              compensate that of the metric such as to make the Lagrangian density “
              %a.existingWikiWord{:href => "/nlab/show/physical+unit"}> physical unit
              \-less”.
            %p
              This means to consider parameter spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              equipped with an
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              of the multiplicative
              %a.existingWikiWord{:href => "/nlab/show/group"} group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℝ
                      %mrow
                        %mo &gt;
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}_{\gt 0}
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/positive+real+numbers"} positive real numbers
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi U
                    %mo ⟶
                    %msubsup
                      %mi Ω
                      %mi Σ
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{L}_{(-)} \;\colon\; U \longrightarrow \Omega^{p+1,0}_\Sigma(E)
            %p
              which are
              %a.existingWikiWord{:href => "/nlab/show/invariant"} invariant
              under this
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/action"} action
          #LocallyVariationalFieldTheory.num_remark
