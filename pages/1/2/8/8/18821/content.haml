                    \\,.
          .proof
            %h6#proof_2 Proof
            %p
              By prop.
              %a.maruku-ref{:href => "#EulerLagrangeOperatorForTivialVectorBundleOverMinkowskiSpacetime"}
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo =
                    %msub
                      %mi δ
                      %mi EL
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo −
                    %mi d
                    %msub
                      %mi Θ
                      %mi BFV
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\delta \mathbf{L} = \delta_{EL} \mathbf{L} - d \Theta_{BFV}
                    \\,.
            %p
              The claim follows from applying the
              %a.existingWikiWord{:href => "/nlab/show/variational+derivative"} variational derivative
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                  %annotation{:encoding => "application/x-tex"} \delta
              to both sides, using
              = succeed ":" do
                %a.maruku-eqref{:href => "#eq:HorizontalAndVerticalDerivativeAnticommute"} (?)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi δ
                      %mn 2
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \delta^2 = 0
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi δ
                      %mo ∘
                      %mi d
                      %mo =
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi d
                      %mo ∘
                      %mi δ
                    %annotation{:encoding => "application/x-tex"} \delta \circ d = - d \circ \delta
          %p
            Many examples of interest fall into the following two special cases of prop.
            = succeed ":" do
              %a.maruku-ref{:href => "#EulerLagrangeOperatorForTivialVectorBundleOverMinkowskiSpacetime"}
          #ShellForSpacetimeIndependentLagrangians.num_prop
            %h6#example_8 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+form"} Euler-Lagrange form
                for
                = succeed "-independent" do
                  %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Lagrangian+densities"} Lagrangian densities
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
              be a
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LocalLagrangianDensityOnSecondOrderJetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is a
              %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial vector bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ≃
                    %mi Σ
                    %mo ×
                    %mi F
                  %annotation{:encoding => "application/x-tex"} E \simeq \Sigma \times F
              over
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              (example
              = succeed ")." do
                %a.maruku-ref{:href => "#TrivialVectorBundleAsAFieldBundle"}
            %p
              In general the
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                  %annotation{:encoding => "application/x-tex"} \mathbf{L}
              is a function of all the spacetime and field coordinates
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo =
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi x
                      %mi μ
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ϕ
                      %mi a
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi ϕ
                      %mrow
                        %mo ,
                        %mi μ
                      %mi a
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi ⋯
                    %mo{:stretchy => "false"} )
                    %msub
                      %mi dvol
                      %mi Σ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{L} = L((x^\mu), (\phi^a), (\phi^a_{,\mu}), \cdots) dvol_\Sigma
                    \\,.
            %p
              Consider the special case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                  %annotation{:encoding => "application/x-tex"} \mathbf{L}
              is
              %em
                %a.existingWikiWord{:href => "/nlab/show/spacetime"}> spacetime
                \-independent
              in that the Lagrangian function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              is independent of the spacetime coordinate
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi x
                        %mi μ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (x^\mu)
              %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+form"} Euler-Lagrange form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mi EL
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                  %annotation{:encoding => "application/x-tex"} \delta_{EL}\mathbf{L}
              (prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#EulerLagrangeOperatorForTivialVectorBundleOverMinkowskiSpacetime"}
              %a.existingWikiWord{:href => "/nlab/show/shell"} shell
              %a.maruku-eqref{:href => "#eq:ProlongedShellInJetBundle"} (12)
              is itself a
              %a.existingWikiWord{:href => "/nlab/show/trivial+bundle"} trivial bundle
              over spacetime.
            %p
              In this situation every point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi φ
                  %annotation{:encoding => "application/x-tex"} \varphi
              in the jet fiber defines a constant section of the shell:
            #eq:ConstantSectionOfTrivialShellBundle.maruku-equation
              %span.maruku-eq-number (19)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mo ×
                    %mo{:stretchy => "false"} {
                    %mi φ
                    %mo{:stretchy => "false"} }
                    %mo ⊂
                    %msup
                      %mi ℰ
                      %mn ∞
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Sigma \times \{\varphi\} \subset \mathcal{E}^\infty
                    \\,.
          #CanonicalMomentum.num_example
            %h6#example_9 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/canonical+momentum"}> canonical momentum
                )
            %p
              Consider a
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E, \mathbf{L})
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LocalLagrangianDensityOnSecondOrderJetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                  %annotation{:encoding => "application/x-tex"} \mathbf{L}
            %ol
              %li
                %p
                  does not depend on the
                  = succeed "-" do
                    %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
                  %a.existingWikiWord{:href => "/nlab/show/coordinates"} coordinates
                  (example
                  = succeed ");" do
                    %a.maruku-ref{:href => "#ShellForSpacetimeIndependentLagrangians"}
              %li
                %p
                  depends on spacetime derivatives of
                  %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} field
                  coordinates (hence on
                  %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
                  coordinates) at most to first order.
            %p
              Hence if the
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
                      %mi fb
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} \Sigma
              is a
              %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial vector bundle
              over
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#TrivialVectorBundleAsAFieldBundle"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi L
                    %mrow
                      %mo (
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ϕ
                        %mi a
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi ϕ
                        %mrow
                          %mo ,
                          %mi μ
                        %mi a
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mo ∧
                    %msub
                      %mi dvol
                      %mi Σ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{L}
                    \\;=\;
                    L\left(
                    (\phi^a), (\phi^a_{,\mu})
                    \\right) \wedge dvol_\Sigma
                    \\,.
            %p
              Then the
              %a.existingWikiWord{:href => "/nlab/show/presymplectic+current"} presymplectic current
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#EulerLagrangeOperatorForTivialVectorBundleOverMinkowskiSpacetime"}
            #eq:CanonicalMomentumPresymplecticCurrent.maruku-equation
              %span.maruku-eq-number (20)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ω
                      %mi BFV
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi δ
                    %msubsup
                      %mi p
                      %mi a
                      %mi μ
                    %mo ∧
                    %mi δ
                    %msup
                      %mi ϕ
                      %mi a
                    %mo ∧
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mo ∂
                          %mi μ
                    %msub
                      %mi dvol
                      %mi Σ
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega_{BFV}
                    \\;=\;
                    \\delta p_a^\mu
                    \\wedge
                    \\delta \phi^a
                    \\wedge
                    \\iota_{\partial_\mu} dvol_\Sigma
            %p where
            #eq:CanonicalMomentumInCoordinates.maruku-equation
              %span.maruku-eq-number (21)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi p
                      %mi a
                      %mi μ
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mrow
                        %mo ∂
                        %mi L
                      %mrow
                        %mo ∂
                        %msubsup
                          %mi ϕ
                          %mrow
                            %mo ,
                            %mi μ
                          %mi a
                  %annotation{:encoding => "application/x-tex"}
                    p_a^\mu
                    \\;\coloneqq\;
                    \\frac{\partial L}{ \partial \phi^a_{,\mu}}
            %p
              denotes the
              %a.existingWikiWord{:href => "/nlab/show/partial+derivative"} partial derivative
              of the
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian function
              with respect to the spacetime-
              %a.existingWikiWord{:href => "/nlab/show/derivatives"} derivatives
              of the
              %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} field
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/coordinates"} coordinates
            %p Here
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi p
                              %mi a
                          %mtd
                            %mo ≔
                            %msubsup
                              %mi p
                              %mi a
                              %mn 0
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mfrac
                              %mrow
                                %mo ∂
                                %mi L
                              %mrow
                                %mo ∂
                                %msubsup
                                  %mi ϕ
                                  %mrow
                                    %mo ,
                                    %mn 0
                                  %mi a
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    p_a
                    \&amp; \coloneqq
                    p_a^0
                    \\\
                    \&amp; =
                    \\frac{\partial L}{\partial \phi^a_{,0}}
                    \\end{aligned}
            %p
              is called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/canonical+momentum"} canonical momentum
              corresponding to the “
              %a.existingWikiWord{:href => "/nlab/show/canonical+coordinate"}> canonical field coordinate
              ”
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ϕ
                        %mi a
                    %annotation{:encoding => "application/x-tex"} \phi^a
            %p
              In the language of
              %a.existingWikiWord{:href => "/nlab/show/multisymplectic+geometry"} multisymplectic geometry
              the full expression
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi p
                      %mi a
                      %mi μ
                    %mo ∧
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mo ∂
                          %mi μ
                    %msub
                      %mi dvol
                      %mi Σ
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi Ω
                      %mi Σ
                      %mrow
                        %mi p
                        %mo ,
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    p_a^\mu \wedge \iota_{\partial_\mu} dvol_\Sigma
                    \\;\in\;
                    \\Omega^{p,1}_\Sigma(E)
            %p is also called the “canonical multi-momentum”, or similar.
          .proof
            %h6#proof_3 Proof
            %p We compute:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi d
                            %mstyle{:mathvariant => "bold"}
                              %mi L
                          %mtd
                            %mo =
                            %mrow
                              %mo (
                              %mfrac
                                %mrow
                                  %mo ∂
                                  %mi L
                                %mrow
                                  %mo ∂
                                  %msup
                                    %mi ϕ
                                    %mi a
                              %mi δ
                              %msup
                                %mi ϕ
                                %mi a
                              %mo +
                              %mfrac
                                %mrow
                                  %mo ∂
                                  %mi L
                                %mrow
                                  %mo ∂
                                  %msubsup
                                    %mi ϕ
                                    %mrow
                                      %mo ,
                                      %mi μ
                                    %mi a
                              %mi δ
                              %msubsup
                                %mi ϕ
                                %mrow
                                  %mo ,
                                  %mi μ
                                %mi a
                              %mo )
                            %mi δ
                            %msup
                              %mi ϕ
                              %mi a
                            %mo ∧
                            %msub
                              %mi dvol
                              %mi Σ
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mrow
                              %mo (
                              %mfrac
                                %mrow
                                  %mo ∂
                                  %mi L
                                %mrow
                                  %mo ∂
                                  %msup
                                    %mi ϕ
                                    %mi a
                              %mo −
                              %mfrac
                                %mi d
                                %mrow
                                  %mi d
                                  %msup
                                    %mi x
                                    %mi μ
                              %mfrac
                                %mrow
                                  %mo ∂
                                  %mi L
                                %mrow
                                  %mo ∂
                                  %msubsup
                                    %mi ϕ
                                    %mrow
                                      %mo ,
                                      %mi μ
                                    %mi a
                              %mo )
                            %mo ∧
                            %msub
                              %mi dvol
                              %mi Σ
                            %mo −
                            %mi d
                            %munder
                              %munder
                                %mrow
                                  %mrow
                                    %mo (
                                    %mfrac
                                      %mrow
                                        %mo ∂
                                        %mi L
                                      %mrow
                                        %mo ∂
                                        %msubsup
                                          %mi ϕ
                                          %mrow
                                            %mo ,
                                            %mi μ
                                          %mi a
                                    %mi δ
                                    %msup
                                      %mi ϕ
                                      %mi a
                                    %mo )
                                  %mo ∧
                                  %msub
                                    %mi ι
                                    %mrow
                                      %msub
                                        %mo ∂
                                        %mi μ
                                  %msub
                                    %mi dvol
                                    %mi Σ
                                %mo ⏟
                              %mrow
                                %msub
                                  %mi Θ
                                  %mi BFV
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\mathbf{d} \mathbf{L}
                    \&amp; =
                    \\left(
                    \\frac{\partial L}{\partial \phi^a} \delta \phi^a
                    +
                    \\frac{\partial L}{\partial \phi^a_{,\mu}} \delta \phi^a_{,\mu}
                    \\right)
                    \\delta \phi^a
                    \\wedge
                    dvol_\Sigma
                    \\\
                    \&amp; =
                    \\left(
                    \\frac{\partial L}{\partial \phi^a}
                    \-
                    \\frac{d}{d x^\mu} \frac{\partial L}{\partial \phi^a_{,\mu}}
                    \\right)
                    \\wedge
                    dvol_\Sigma
                    \-
                    d
                    \\underset{
                    \\Theta_{BFV}
                    }{
                    \\underbrace{
                    \\left(
                    \\frac{\partial L}{\partial \phi^a_{,\mu}} \delta \phi^a
                    \\right)
                    \\wedge
                    \\iota_{\partial_\mu} dvol_\Sigma
                    }
                    }
                    \\end{aligned}
                    \\,.
            %p Hence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi Ω
                              %mi BFV
                          %mtd
                            %mo ≔
                            %mi δ
                            %msub
                              %mi Θ
                              %mi BFV
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi δ
                            %mrow
                              %mo (
                              %mfrac
                                %mrow
                                  %mo ∂
                                  %mi L
                                %mrow
                                  %mo ∂
                                  %msubsup
                                    %mi ϕ
                                    %mrow
                                      %mo ,
                                      %mi μ
                                    %mi a
                              %mi δ
                              %msubsup
                                %mi ϕ
                                %mrow
                                  %mo ,
                                  %mi μ
                                %mi a
                              %mo ∧
                              %msub
                                %mi ι
                                %mrow
                                  %msub
                                    %mo ∂
                                    %mi μ
                              %msub
                                %mi dvol
                                %mi Σ
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi δ
                            %mfrac
                              %mrow
                                %mo ∂
                                %mi L
                              %mrow
                                %mo ∂
                                %msubsup
                                  %mi ϕ
                                  %mrow
                                    %mo ,
                                    %mi μ
                                  %mi a
                            %mo ∧
                            %mi δ
                            %msubsup
                              %mi ϕ
                              %mrow
                                %mo ,
                                %mi μ
                              %mi a
                            %mo ∧
                            %msub
                              %mi ι
                              %mrow
                                %msub
                                  %mo ∂
                                  %mi μ
                            %msub
                              %mi dvol
                              %mi Σ
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi δ
                            %msubsup
                              %mi p
                              %mi a
                              %mi μ
                            %mo ∧
                            %mi δ
                            %msup
                              %mi ϕ
                              %mi a
                            %mo ∧
                            %msub
                              %mi ι
                              %mrow
                                %msub
                                  %mo ∂
                                  %mi μ
                            %msub
                              %mi dvol
                              %mi Σ
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\Omega_{BFV}
                    \&amp; \coloneqq
                    \\delta \Theta_{BFV}
                    \\\
                    \&amp; =
                    \\delta
                    \\left(
                    \\frac{\partial L}{\partial \phi^a_{,\mu}}
                    \\delta \phi^a_{,\mu}
                    \\wedge \iota_{\partial_\mu} dvol_\Sigma
                    \\right)
                    \\\
                    \&amp; =
                    \\delta
                    \\frac{\partial L}{\partial \phi^a_{,\mu}}
                    \\wedge
                    \\delta \phi^a_{,\mu}
                    \\wedge
                    \\iota_{\partial_\mu} dvol_\Sigma
                    \\\
                    \&amp; =
                    \\delta p_a^\mu \wedge \delta \phi^a \wedge \iota_{\partial_\mu} dvol_\Sigma
                    \\end{aligned}
          #PresymplecticCurrentInterpretation.num_remark
            %h6#remark_4 Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/presymplectic+current"} presymplectic current
                is local version of (
                %a.existingWikiWord{:href => "/nlab/show/presymplectic+form"}> pre-
                )
                %a.existingWikiWord{:href => "/nlab/show/symplectic+form"} symplectic form
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+mechanics"} Hamiltonian mechanics
            %p
              In the simple but very common situation of example
              %a.maruku-ref{:href => "#CanonicalMomentum"}
              the
              %a.existingWikiWord{:href => "/nlab/show/presymplectic+current"} presymplectic current
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#EulerLagrangeOperatorForTivialVectorBundleOverMinkowskiSpacetime"}
              %a.maruku-eqref{:href => "#eq:CanonicalMomentumInCoordinates"} (21)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ω
                      %mi BFV
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi δ
                    %msubsup
                      %mi p
                      %mi a
                      %mi μ
                    %mo ∧
                    %mi δ
                    %msup
                      %mi ϕ
                      %mi a
                    %mo ∧
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mo ∂
                          %mi μ
                    %msub
                      %mi dvol
                      %mi Σ
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega_{BFV}
                    \\;=\;
                    \\delta p_a^\mu
                    \\wedge
                    \\delta \phi^a
                    \\wedge
                    \\iota_{\partial_\mu} dvol_\Sigma
            %p
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ϕ
                      %mi a
                  %annotation{:encoding => "application/x-tex"} \phi^a
              the
              %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} field
              %a.existingWikiWord{:href => "/nlab/show/coordinates"} coordinates
              (“
              %a.existingWikiWord{:href => "/nlab/show/canonical+coordinates"}> canonical coordinates
              ”) and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi p
                      %mi a
                      %mi μ
                  %annotation{:encoding => "application/x-tex"} p_a^\mu
              the “
              %a.existingWikiWord{:href => "/nlab/show/canonical+momentum"}> canonical momentum
              ”
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:CanonicalMomentumInCoordinates"} (21)
            %p
              Notice that this is of the schematic form “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi δ
                    %msub
                      %mi p
                      %mi a
                    %mo ∧
                    %mi δ
                    %msup
                      %mi q
                      %mi a
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %msub
                      %mi dvol
                      %mrow
                        %msub
                          %mi Σ
                          %mi p
                  %annotation{:encoding => "application/x-tex"} (\delta p_a \wedge \delta q^a) \wedge dvol_{\Sigma_p}
              ”, which is reminiscent of the wedge product of a
              %a.existingWikiWord{:href => "/nlab/show/symplectic+form"} symplectic form
              expressed in
              %a.existingWikiWord{:href => "/nlab/show/Darboux+coordinates"} Darboux coordinates
              with a
              %a.existingWikiWord{:href => "/nlab/show/volume+form"} volume form
              for a
              = succeed "-dimensional" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
              %em
                %a{:href => "#PhaseSpace"} Phase space
              we discuss that this
              %a.existingWikiWord{:href => "/nlab/show/presymplectic+current"} presymplectic current
              “
              %a.existingWikiWord{:href => "/nlab/show/transgression+of+variational+differential+forms"}> transgresses
              ” (def.
              %a.maruku-ref{:href => "#TransgressionOfVariationalDifferentialFormsToConfigrationSpaces"}
              below) to a
              %a.existingWikiWord{:href => "/nlab/show/presymplectic+form"} presymplectic form
              of the schematic form “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi d
                    %msub
                      %mi P
                      %mi a
                    %mo ∧
                    %mi d
                    %msup
                      %mi Q
                      %mi a
                  %annotation{:encoding => "application/x-tex"} d P_a \wedge d Q^a
              ” on the
              %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
              %a.existingWikiWord{:href => "/nlab/show/space+of+field+histories"} space of field histories
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#EulerLagrangeEquationsOnTrivialVectorFieldBundleOverMinkowskiSpacetime"}
              %a.existingWikiWord{:href => "/nlab/show/integration+of+differential+forms"} integrating
              it over a
              %a.existingWikiWord{:href => "/nlab/show/Cauchy+surface"} Cauchy surface
              of
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %a.existingWikiWord{:href => "/nlab/show/presymplectic+form"} presymplectic form
              is in fact a
              %a.existingWikiWord{:href => "/nlab/show/symplectic+form"} symplectic form
              on the
              %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
              %a.existingWikiWord{:href => "/nlab/show/space+of+field+histories"} space of field histories
              (theorem
              %a.maruku-ref{:href => "#PPeierlsBracket"}
              below).
            %p
              This shows that the
              %a.existingWikiWord{:href => "/nlab/show/presymplectic+current"} presymplectic current
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ω
                      %mi BFV
                  %annotation{:encoding => "application/x-tex"} \Omega_{BFV}
              is the
              %a.existingWikiWord{:href => "/nlab/show/local+field+theory"} local
              (i.e.
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet level
              %a.existingWikiWord{:href => "/nlab/show/symplectic+form"} symplectic form
              that governs the formulation of
              %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+mechanics"} Hamiltonian mechanics
              in terms of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/symplectic+geometry"} symplectic geometry
            %p
              In fact prop.
              %a.maruku-ref{:href => "#HorizontalDerivativeOfPresymplecticCurrentVanishesOnShell"}
              may be read as saying that the
              %a.existingWikiWord{:href => "/nlab/show/presymplectic+current"} presymplectic current
              is a
              %em
                %a.existingWikiWord{:href => "/nlab/show/conserved+current"} conserved current
              (def.
              %a.maruku-ref{:href => "#SymmetriesAndConservedCurrents"}
              below), only that it takes values not in
              %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
              of the field coordinates and jets, but in
              %a.existingWikiWord{:href => "/nlab/show/variational+differential+form"} variational 2-forms
              on fields. There is a
              %a.existingWikiWord{:href => "/nlab/show/conserved+charge"} conserved charge
              associated with every
              %a.existingWikiWord{:href => "/nlab/show/conserved+current"} conserved current
              (prop.
              %a.maruku-ref{:href => "#ConservedCharge"}
              below) and the conserved charge associated with the
              %a.existingWikiWord{:href => "/nlab/show/presymplectic+current"} presymplectic current
              is the (
              %a.existingWikiWord{:href => "/nlab/show/presymplectic+form"}> pre-
              )
              %a.existingWikiWord{:href => "/nlab/show/symplectic+form"} symplectic form
              on the
              %a.existingWikiWord{:href => "/nlab/show/phase+space"} phase space
              of the field theory (def.
              %a.maruku-ref{:href => "#PhaseSpaceAssociatedWithCauchySurface"}
              below).
          #FreeScalarFieldEOM.num_example
            %h6#example_10 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+form"} Euler-Lagrange form
                and
                %a.existingWikiWord{:href => "/nlab/show/presymplectic+current"} presymplectic current
                for
                %a.existingWikiWord{:href => "/nlab/show/free+field"} free
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/real+scalar+field"} real scalar field
            %p
              Consider the
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              of the
              %a.existingWikiWord{:href => "/nlab/show/free+field"} free
              %a.existingWikiWord{:href => "/nlab/show/real+scalar+field"} real scalar field
              from example
              = succeed "." do
                %a.maruku-ref{:href => "#LagrangianForFreeScalarFieldOnMinkowskiSpacetime"}
            %p
              Then the
              %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+operator"} Euler-Lagrange form
              and
              %a.existingWikiWord{:href => "/nlab/show/presymplectic+current"} presymplectic current
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#EulerLagrangeOperatorForTivialVectorBundleOverMinkowskiSpacetime"}
            #eq:RealScalarFieldLEForm.maruku-equation
              %span.maruku-eq-number (22)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mi EL
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %msup
                        %mi η
                        %mrow
                          %mi μ
                          %mi ν
                      %msub
                        %mi ϕ
                        %mrow
                          %mo ,
                          %mi μ
                          %mi ν
                      %mo −
                      %msup
                        %mi m
                        %mn 2
                      %mo )
                    %mi δ
                    %mi ϕ
                    %mo ∧
                    %msub
                      %mi dvol
                      %mi σ
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi Ω
                      %mi Σ
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                        %mo ,
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi E
