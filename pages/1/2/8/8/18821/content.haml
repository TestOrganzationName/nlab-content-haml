                %a.maruku-ref{:href => "#CanonicalMomentum"}
            %p
              Now regarding the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+form"} Euler-Lagrange form
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo +
                      %mn 1
                      %mo ∈
                      %mo{:stretchy => "false"} {
                      %mn 3
                      %mo ,
                      %mn 4
                      %mo ,
                      %mn 6
                      %mo ,
                      %mn 10
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} p+1 \in \{3,4,6,10\}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
