              a
              %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
              (e.g. a
              %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial vector bundle
              as in example
              = succeed ")" do
                %a.maruku-ref{:href => "#TrivialVectorBundleAsAFieldBundle"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free field theory
              if its
              %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+equation"} Euler-Lagrange
              %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#EulerLagrangeEquationsOnTrivialVectorFieldBundleOverMinkowskiSpacetime"}
              %a.existingWikiWord{:href => "/nlab/show/differential+equation"} differential equation
              that is
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/linear+differential+equation"} linear differential equation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
