            %p
              any two
              %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
              %a.existingWikiWord{:href => "/nlab/show/field+histories"} field histories
              %a.maruku-eqref{:href => "#eq:OnShellFieldHistories"} (27)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
