                        %mn 2
                    %mrow
                      %mo (
                      %msubsup
                        %mover
                          %mi a
                          %mo{:stretchy => "false"} ˜
                        %mrow
                          %mi ν
                          %mo ,
                          %mi μ
                        %mi α
                      %mo −
                      %msubsup
                        %mover
                          %mi a
                          %mo{:stretchy => "false"} ˜
                        %mrow
                          %mi μ
                          %mo ,
                          %mi ν
                        %mi α
                      %mo +
                      %msup
                        %mi γ
                        %mi α
                      %msub
                        %mrow
                        %mrow
                          %mi β
                          %mi γ
                      %msubsup
                        %mover
                          %mi a
                          %mo{:stretchy => "false"} ˜
                        %mi μ
                        %mi β
                      %msubsup
                        %mover
                          %mi a
                          %mo{:stretchy => "false"} ˜
                        %mi ν
                        %mi γ
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi Ω
                      %mi Σ
                      %mrow
                        %mn 0
                        %mo ,
