                    %mspace{:width => "thickmathspace"}
                    %mi i
                    %mover
                      %mi ψ
                      %mo ¯
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi γ
                      %mi μ
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi ψ
                      %mrow
                        %mo ,
                        %mi μ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    L
                    \\;=\;
                    i \overline{\psi} \, \gamma^\mu \, \psi_{,\mu}
                    \\,.
            %p Then we compute as follows:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi δ
                              %mi EL
                            %mi L
                          %mtd
                            %mo =
                            %mi i
                            %mspace{:width => "thinmathspace"}
                            %mover
                              %mrow
                                %mi δ
                                %mi ψ
                              %mo ¯
                            %mspace{:width => "thinmathspace"}
                            %msup
                              %mi γ
                              %mi μ
                            %mspace{:width => "thinmathspace"}
                            %msub
                              %mi ψ
                              %mrow
                                %mo ,
                                %mi μ
                            %munder
                              %munder
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mi i
                                  %mover
                                    %mrow
                                      %msub
                                        %mi ψ
                                        %mrow
                                          %mo ,
                                          %mi μ
                                    %mo ¯
                                  %mspace{:width => "thinmathspace"}
                                  %msup
                                    %mi γ
                                    %mi μ
                                  %mspace{:width => "thinmathspace"}
                                  %mi δ
                                  %mi ψ
                                %mo ⏟
                              %mrow
                                %mo =
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                                %mi i
                                %mspace{:width => "thinmathspace"}
                                %mover
                                  %mrow
                                    %mi δ
                                    %mi ψ
                                  %mo ¯
                                %mspace{:width => "thinmathspace"}
                                %msup
                                  %mi γ
                                  %mi μ
                                %mspace{:width => "thinmathspace"}
                                %msub
                                  %mi ψ
                                  %mrow
                                    %mo ,
                                    %mi μ
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mn 2
                            %mi i
                            %mspace{:width => "thinmathspace"}
                            %mover
                              %mrow
                                %mi δ
                                %mi ψ
                              %mo ¯
                            %mspace{:width => "thinmathspace"}
                            %msup
                              %mi γ
                              %mi μ
                            %mspace{:width => "thinmathspace"}
                            %msub
                              %mi ψ
                              %mrow
                                %mo ,
                                %mi μ
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\delta_{EL} L
                    \&amp; =
                    i \,\overline{\delta \psi} \, \gamma^\mu \, \psi_{,\mu}
                    \\underset{
                    \= +
                    i \,\overline{\delta \psi} \, \gamma^\mu \, \psi_{,\mu}
                    }{
                    \\underbrace{
                    \-
                    i \overline{\psi_{,\mu}} \, \gamma^\mu \, \delta \psi
                    }
                    }
                    \\\
                    \&amp; =
                    2 i \, \overline{\delta \psi} \, \gamma^\mu \, \psi_{,\mu}
                    \\end{aligned}
            %p
              Here the first equation is the general formula
              %a.maruku-eqref{:href => "#eq:EulerLagrangeEquationGeneral"} (10)
              for the Euler-Lagrange variation, while the identity under the braces combines two facts (as in remark
              %a.maruku-ref{:href => "#LagrangianDensityOfDiracFieldSupergeometricNature"}
              above):
            %ol
              %li
                %p
                  the symmetry
                  %a.maruku-eqref{:href => "#eq:SpinorToVectorPairingIsSymmetric"} (?)
                  of the spinor pairing
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                          %mo ¯
                        %msup
                          %mi γ
                          %mi μ
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \overline{(-)}\gamma^\mu(-)
                  (prop.
                  = succeed ");" do
                    %a.maruku-ref{:href => "#RealSpinorPairingsViaDivisionAlg"}
              %li
                %p
                  the anti-commutativity
                  %a.maruku-eqref{:href => "#eq:DiracFieldJetCoordinatesAnticommute"} (6)
                  of the Dirac field and jet coordinates, due to their
                  %a.existingWikiWord{:href => "/nlab/show/supergeometry"} supergeometric
                  nature (remark
                  = succeed ")." do
                    %a.maruku-ref{:href => "#DiracFieldSupergeometric"}
            %p
              Finally in the special case of the massive Dirac field in spacetime dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo +
                    %mn 1
                    %mo =
                    %mn 4
                  %annotation{:encoding => "application/x-tex"} p+1 = 4
              the Lagrangian function is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi i
                    %mspace{:width => "thinmathspace"}
                    %mover
                      %mi ψ
                      %mo ¯
                    %msup
                      %mi γ
                      %mi μ
                    %msub
                      %mi ψ
                      %mrow
                        %mo ,
                        %mi μ
                    %mo +
                    %mi m
                    %mover
                      %mi ψ
                      %mo ¯
                    %mi ψ
                  %annotation{:encoding => "application/x-tex"}
                    L
                    \\;=\;
                    i \, \overline{\psi} \gamma^\mu \psi_{,\mu} + m \overline{\psi}\psi
            %p
              where now
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ψ
                      %mi α
                  %annotation{:encoding => "application/x-tex"} \psi_\alpha
              takes values in the
              %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
              (as opposed to in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℍ
                  %annotation{:encoding => "application/x-tex"} \mathbb{H}
              or
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕆
                    %annotation{:encoding => "application/x-tex"} \mathbb{O}
              %a.existingWikiWord{:href => "/nlab/show/derivative"} derivative
              equivalently by treeating
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                  %annotation{:encoding => "application/x-tex"} \psi
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi ψ
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"} \overline{\psi}
              as independent components of the field. This immediately yields the claim.
          #TrivialLagrangianDensities.num_example
            %h6#example_15 Example
            %p
              %strong
                (trivial
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+densities"} Lagrangian densities
                and the
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+complex"} Euler-Lagrange complex
            %p
              If a
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                  %annotation{:encoding => "application/x-tex"} \mathbf{L}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LagrangianForFreeScalarFieldOnMinkowskiSpacetime"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/total+spacetime+derivative"} total spacetime derivative
              = succeed ")" do
                %a.maruku-ref{:href => "#VariationalBicomplexOnSecondOrderJetBundleOverTrivialVectorBundleOverMinkowskiSpacetime"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi d
                    %mstyle{:mathvariant => "bold"}
                      %mi ℓ
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{L} \;=\; d \mathbf{\ell}
            %p
              for any
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi ℓ
                      %mo ∈
                      %msubsup
                        %mi Ω
                        %mi Σ
                        %mrow
                          %mi p
                          %mo ,
                          %mn 0
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{\ell} \in \Omega^{p,0}_\Sigma(E)
              %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+form"} Euler-Lagrange form
              as well as its
              %a.existingWikiWord{:href => "/nlab/show/presymplectic+current"} presymplectic current
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#EulerLagrangeOperatorForTivialVectorBundleOverMinkowskiSpacetime"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mi EL
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo =
                    %mn 0
                    %mphantom
                      %mi AA
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mphantom
                      %mi AA
                    %msub
                      %mi Ω
                      %mi BFV
                    %mo =
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\delta_{EL}\mathbf{L} = 0
                    \\phantom{AA}
                    \\,,
                    \\phantom{AA}
                    \\Omega_{BFV} = 0
                    \\,.
            %p
              This is because with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %mo ∘
                    %mi d
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi d
                    %mo ∘
                    %mi δ
                  %annotation{:encoding => "application/x-tex"} \delta \circ d = - d \circ \delta
              %a.maruku-eqref{:href => "#eq:HorizontalAndVerticalDerivativeAnticommute"} (?)
              the defining unique decomposition
              %a.maruku-eqref{:href => "#eq:dLDecomposition"} (9)
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                  %annotation{:encoding => "application/x-tex"} \delta \mathbf{L}
              is given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi δ
                            %mstyle{:mathvariant => "bold"}
                              %mi L
                          %mtd
                            %mo =
                            %mi δ
                            %mi d
                            %mstyle{:mathvariant => "bold"}
                              %mi ℓ
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %munder
                              %munder
                                %mn 0
                                %mo ⏟
                              %mrow
                                %mo =
                                %msub
                                  %mi δ
                                  %mi EL
                                %mstyle{:mathvariant => "bold"}
                                  %mi L
                            %mo −
                            %mi d
                            %munder
                              %munder
                                %mrow
                                  %mi δ
                                  %mstyle{:mathvariant => "bold"}
                                    %mi l
                                %mo ⏟
                              %mrow
                                %msub
                                  %mi Θ
                                  %mi BFV
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\delta \mathbf{L}
                    \&amp; =
                    \\delta d \mathbf{\ell}
                    \\\
                    \&amp; =
                    \\underset{= \delta_{EL}\mathbf{L}}{\underbrace{0}}
                    \-
                    d \underset{\Theta_{BFV}}{\underbrace{\delta \mathbf{l}}}
                    \\end{aligned}
            %p
              which then implies with
              %a.maruku-eqref{:href => "#eq:PresymplecticCurrent"} (15)
              that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi Ω
                              %mi BFV
                          %mtd
                            %mo ≔
                            %mi δ
                            %msub
                              %mi Θ
                              %mi BFV
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi δ
                            %mi δ
                            %mstyle{:mathvariant => "bold"}
                              %mi ℓ
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\Omega_{BFV}
                    \&amp; \coloneqq
                    \\delta \Theta_{BFV}
                    \\\
                    \&amp; =
                    \\delta \delta \mathbf{\ell}
                    \\\
                    \&amp; =
                    0
                    \\end{aligned}
            %p
              Therefore the
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+densities"} Lagrangian densities
              which are
              %a.existingWikiWord{:href => "/nlab/show/total+spacetime+derivatives"} total spacetime derivatives
              are also called
              = succeed "." do
                %em trivial Lagrangian densities
            %p
              If the
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
                      %mi fb
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} \Sigma
              is a
              %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial vector bundle
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#TrivialVectorBundleAsAFieldBundle"}
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#MinkowskiSpacetime"}
              %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+form"} Euler-Lagrange form
              vanishes is a total spacetime derivative.
            %p
              Stated more
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/category+theory"} abstractly
              %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exact sequence
              of the total spacetime from prop.
              %a.maruku-ref{:href => "#HorizontalVariationalComplexOfTrivialFieldBundleIsExact"}
              extends to the right via the
              %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+variational+derivative"} Euler-Lagrange variational derivative
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mi EL
                  %annotation{:encoding => "application/x-tex"} \delta_{EL}
              to an
              %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exact sequence
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                    %mover
                      %mo ↪
                      %mrow
                    %msubsup
                      %mi Ω
                      %mi Σ
                      %mrow
                        %mn 0
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mi d
                    %msubsup
                      %mi Ω
                      %mi Σ
                      %mrow
                        %mn 1
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mi d
                    %msubsup
                      %mi Ω
                      %mi Σ
                      %mrow
                        %mn 2
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mi d
                    %mi ⋯
                    %mover
                      %mo ⟶
                      %mi d
                    %msubsup
                      %mi Ω
                      %mi Σ
                      %mrow
                        %mi p
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mi d
                    %msubsup
                      %mi Ω
                      %mi Σ
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi δ
                          %mi EL
                    %msubsup
                      %mi Ω
                      %mi Σ
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mi δ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi δ
                          %mi H
                    %mi ⋯
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R}
                    \\overset{}{\hookrightarrow}
                    \\Omega^{0,0}_\Sigma(E)
                    \\overset{d}{\longrightarrow}
                    \\Omega^{1,0}_\Sigma(E)
                    \\overset{d}{\longrightarrow}
                    \\Omega^{2,0}_\Sigma(E)
                    \\overset{d}{\longrightarrow}
                    \\cdots
                    \\overset{d}{\longrightarrow}
                    \\Omega^{p,0}_\Sigma(E)
                    \\overset{d}{\longrightarrow}
                    \\Omega^{p+1,0}_\Sigma(E)
                    \\overset{\delta_{EL}}{\longrightarrow}
                    \\Omega^{p+1,0}_\Sigma(E) \wedge \delta(C^\infty(E))
                    \\overset{\delta_{H}}{\longrightarrow}
                    \\cdots
                    \\,.
            %p
              In fact, as shown, this
              %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exact sequence
              keeps going to the right; this is also called the
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+complex"} Euler-Lagrange complex
            %p
              (
              %a{:href => "Euler-Lagrange+complex#Anderson89"}> Anderson 89, theorem 5.1
              )
            %p
              The next
              %a.existingWikiWord{:href => "/nlab/show/differential"} differential
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \delta_{H}
              after the
              %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+variational+derivative"} Euler-Lagrange variational derivative
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mi EL
                  %annotation{:encoding => "application/x-tex"} \delta_{EL}
              is known as the
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Helmholtz+operator"} Helmholtz operator
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exact sequence
              %a.existingWikiWord{:href => "/nlab/show/Helmholtz+operator"} Helmholtz operator
              detects whether a
              %a.existingWikiWord{:href => "/nlab/show/partial+differential+equation"} partial differential equation
              on
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/field+histories"} field histories
              %a.existingWikiWord{:href => "/nlab/show/variational+differential+form"} variational differential form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ∈
                    %msubsup
                      %mi Ω
                      %mi Σ
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mi δ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P \in \Omega^{p+1,0}_\Sigma(E) \wedge \delta(C^\infty(E))
              as in
              %a.maruku-eqref{:href => "#eq:EquationOfMotionEL"} (25)
              comes from varying a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
              %a.existingWikiWord{:href => "/nlab/show/equation+of+motion"} equation of motion
              of a
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              via def.
              = succeed "." do
                %a.maruku-ref{:href => "#EulerLagrangeEquationsOnTrivialVectorFieldBundleOverMinkowskiSpacetime"}
            %p
              This way
              %a.existingWikiWord{:href => "/nlab/show/homological+algebra"} homological algebra
              is brought to bear on core questions of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/field+theory"} field theory
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/schreiber/show/Higher+Structures"} Higher Structures in Physics
          #LagrangianDensityOfDiracFieldSupergeometricNature.num_remark
            %h6#remark_5 Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/supergeometry"} supergeometric
                nature of
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
                of the
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Dirac+field"} Dirac field
            %p
              Observe that the
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
              for the
              %a.existingWikiWord{:href => "/nlab/show/Dirac+field"} Dirac field
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LagrangianDensityForDiracField"}
              %a.existingWikiWord{:href => "/nlab/show/supergeometry"} supergeometric
              nature of the
              %a.existingWikiWord{:href => "/nlab/show/Dirac+field"} Dirac field
              (remark
              = succeed "):" do
                %a.maruku-ref{:href => "#DiracFieldSupergeometric"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ψ
                      %mrow
                        %mo ,
                        %msub
                          %mi μ
                          %mn 1
                        %mi ⋯
                        %msub
                          %mi μ
                          %mi k
                  %annotation{:encoding => "application/x-tex"} \psi_{,\mu_1 \cdots \mu_k}
              were not anti-commuting
              %a.maruku-eqref{:href => "#eq:DiracFieldJetCoordinatesAnticommute"} (6)
              then the Dirac’s field Lagrangian density (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LagrangianDensityForDiracField"}
              %a.existingWikiWord{:href => "/nlab/show/total+spacetime+derivative"} total spacetime derivative
              and hence be trivial according to example
              = succeed "." do
                %a.maruku-ref{:href => "#TrivialLagrangianDensities"}
            %p This is because
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mrow
