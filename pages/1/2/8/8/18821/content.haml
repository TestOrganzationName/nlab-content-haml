                      %mi BFV
                  %annotation{:encoding => "application/x-tex"} \Theta_{BFV}
              is
            #eq:StandardThetaForTrivialVectorFieldBundleOnMinkowskiSpacetime.maruku-equation
              %span.maruku-eq-number (14)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
