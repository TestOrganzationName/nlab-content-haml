                on
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              be a
              %a.existingWikiWord{:href => "/nlab/show/finite+number"} finite
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimensional
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
              which is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/semisimple+Lie+algebra"} semisimple
              %a.existingWikiWord{:href => "/nlab/show/Killing+form"} Killing form
              %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝔤
                    %mo ⊗
                    %mi 𝔤
                    %mo ⟶
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    k \colon \mathfrak{g} \otimes \mathfrak{g} \longrightarrow \mathbb{R}
            %p
              is a non-degenerate
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/bilinear+form"} bilinear form
              %a.existingWikiWord{:href => "/nlab/show/special+unitary+Lie+algebras"} special unitary Lie algebras
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔰𝔬
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
