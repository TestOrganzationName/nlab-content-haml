                    \\frac{\partial}{\partial a_{\mu',\nu'}^{\alpha'}}
                    \\left(
                    a_{\nu,\mu}^\alpha
                    +
                    \\tfrac{1}{2}
                    \\gamma^{\alpha}{}_{\alpha_2 \alpha_3}
                    a_{\mu}^{\alpha_2} a_\nu^{\alpha_3}
                    \\right)
                    \\right)
                    k_{\alpha \beta}
                    f^{\beta \mu \nu}
                    \\right)
                    \\delta a_{\mu'}^{\alpha'}
                    \\\
                    \&amp; =
                    \\gamma^{\alpha}{}_{\alpha' \alpha_3} a_\nu^{\alpha_3}
                    f^{\beta \mu \nu}
                    k_{\alpha \beta}
                    \\delta a_{\mu}^{\alpha'}
                    \-
                    \\left(
                    \\frac{d}{d x^{\mu}} f^{\beta \mu \nu}
                    \\right)
                    k_{\alpha \beta}
                    \\delta a_{\nu}^{\alpha}
                    \\\
                    \&amp;=
                    \-
                    \\left(
                    f^{\alpha \mu \nu}_{,\mu}
                    +
                    \\gamma^\alpha{}_{\beta \gamma} a_\mu^\beta f^{\gamma \mu \nu}
                    \\right)
                    k_{\alpha \beta}
                    \\delta a_\nu^\beta
                    \\end{aligned}
            %p
