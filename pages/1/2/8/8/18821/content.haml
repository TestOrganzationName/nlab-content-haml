                  %annotation{:encoding => "application/x-tex"} d \Theta_{BFV}
              in
              %a.maruku-eqref{:href => "#eq:dLDecomposition"} (9)
              is unique, while the
              %em presymplectic potential
            #eq:PresymplecticPotential.maruku-equation
              %span.maruku-eq-number (13)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
