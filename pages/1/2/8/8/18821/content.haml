                    \\delta \phi^a_{,\nu}
                    +
                    \\frac{\partial L}{\partial \phi^a_{,\nu \mu}}
                    \\delta \phi^a_{,\nu \mu}
                    \-
                    \\frac{d^2}{ d x^\mu d x^\nu}
                    \\frac{\partial L}{\partial \phi^a_{,\mu \nu}}
                    \\delta \phi^a
                    \-
                    \\frac{d}{d x^\nu}
                    \\frac{\partial L}{\partial \phi^a_{,\mu \nu}}
                    \\delta \phi^a_{,\mu}
                    \\right)
                    + \cdots
                    \\right)
                    \\wedge dvol_\Sigma
                    \\,,
                    \\end{aligned}
            %p where in the last line we used that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %msup
                      %mi x
