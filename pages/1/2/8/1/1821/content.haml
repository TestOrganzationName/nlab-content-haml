              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi V
                        %mo •
                    %annotation{:encoding => "application/x-tex"} V_\bullet
          %h2#properties Properties
          %h3#functoriality Functoriality
          .num_prop
            %h6#proposition Proposition
            %p
              For all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              forming chain homology extends to a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              from the
              %a.existingWikiWord{:href => "/nlab/show/category+of+chain+complexes"} category of chain complexes
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              itself
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msub
                      %mi Ch
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi 𝒜
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H_n(-) : Ch_\bullet(\mathcal{A}) \to \mathcal{A}
                    \\,.
          .proof
            %h6#proof Proof
            %p
              One checks that
              %a.existingWikiWord{:href => "/nlab/show/chain+homotopy"} chain homotopy
              (see there) respects
              %a.existingWikiWord{:href => "/nlab/show/cycles"} cycles
              and
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/boundaries"} boundaries
          #ChainHomologyRespectsDirectProduct.num_prop
            %h6#proposition_2 Proposition
            %p
              Chain homology commutes with
              %a.existingWikiWord{:href => "/nlab/show/direct+product"} direct product
              of chain complexes:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mi i
                    %msup
                      %mi C
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mi i
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi C
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H_n(\prod_i C^{(i)})
                    \\simeq
                    \\prod_i H_n(C^{(i)})
                    \\,.
            %p
              Similarly for
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
          %h3#RespectForDirectSum Respect for direct sums and filtered colimits
          .num_prop
            %h6#proposition_3 Proposition
            %p
              The chain homology functor preserves
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/direct+sums"} direct sums
            %p
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ,
                    %mi B
                    %mo ∈
                    %msub
                      %mi Ch
                      %mo •
                  %annotation{:encoding => "application/x-tex"} A,B \in Ch_\bullet
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{Z}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ⊕
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ⊕
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    H_n(A \oplus B) \to H_n(A) \oplus H_n(B)
            %p
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
          .num_prop
            %h6#proposition_4 Proposition
            %p
              The chain homology functor preserves
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/filtered+colimits"} filtered colimits
            %p
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:lspace => "verythinmathspace"} :
                    %mi I
                    %mo →
                    %msub
                      %mi Ch
                      %mo •
                  %annotation{:encoding => "application/x-tex"} A \colon I \to Ch_\bullet
              a
              %a.existingWikiWord{:href => "/nlab/show/filtered+category"} filtered
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{Z}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %munder
                      %mi lim
                      %mrow
                        %msub
                          %mo →
                          %mi i
                    %msub
                      %mi A
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo →
                    %munder
                      %mi lim
                      %mrow
                        %msub
                          %mo →
                          %mi i
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    H_n(\underset{\to_i}{\lim} A_i) \to \underset{\to_i}{\lim} H_n(A_i)
            %p
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
          %p
            This is spelled out for instance as (
            %a{:href => "#HopkinsMathew"}> Hopkins-Mathew , prop. 23.1
            ).
          %h2#examples Examples
          %ul
            %li
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                a
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sing
                      %mi X
                    %annotation{:encoding => "application/x-tex"} Sing X
                its
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/singular+simplicial+complex"} singular simplicial complex
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mi Sing
                      %mi X
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} N \mathbb{Z}[Sing X]
                for the
                %a.existingWikiWord{:href => "/nlab/show/normalized+chain+complex"} normalized chain complex
                of the
                %a.existingWikiWord{:href => "/nlab/show/simplicial+abelian+group"} simplicial abelian group
                that is degreewise the
                %a.existingWikiWord{:href => "/nlab/show/free+abelian+group"} free abelian group
                on
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Sing
                        %mi X
                      %annotation{:encoding => "application/x-tex"} Sing X
                %em
                  %a.existingWikiWord{:href => "/nlab/show/singular+homology"} singular homology
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi H
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi N
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mi Sing
                      %mi X
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %msub
                        %mi H
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi ℤ
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      H_\bullet( N \mathbb{Z}[Sing X]) \simeq H_\bullet(X, \mathbb{Z})
                      \\,.
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Koszul+homology"} Koszul homology
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ext"}> Ext
                ,
                %a.existingWikiWord{:href => "/nlab/show/Tor"} Tor
          %h2#InTheContextOfHomotopyTheory In the context of homotopy theory
          %p
            We discuss here the notion of (co)homology of a
            %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
            from a more abstract point of view of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            %a.existingWikiWord{:href => "/nlab/show/nPOV"} nPOV
            on
            %em
              %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            as discussed there.
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
            in non-negative degree is, under the
            %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan correspondence
            a
            %a.existingWikiWord{:href => "/nlab/show/homological+algebra"} homological algebra
            model for a particularly nice
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            or
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+abelian+group"} simplicial abelian group
            %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
            is a model for a
            %a.existingWikiWord{:href => "/nlab/show/spectrum"} spectrum
            with abelian group structure.
          %p One consequence of this embedding
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo :
                  %msub
                    %mi Ch
                    %mo +
                  %mo →
                  %mn ∞
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"}
                  N : Ch_+ \to \infty Grpd
          %p
            induced by the Dold-Kan
            %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
            is that it allows to think of
            %a.existingWikiWord{:href => "/nlab/show/chain+complexes"} chain complexes
            as objects in the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            or equivalently
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            comes with a notion of
            %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
            and
            %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            and so such abstract notions get induced on chain complexes.
          %p
            Of course there is an independent, age-old definition of
            %a.existingWikiWord{:href => "/nlab/show/homology"} homology
            of chain complexes and, by dualization, of cohomology of cochain complexes.
          %p
            This entry describes how these standard definition of chain homology and cohomology follow from the general
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            nonsense described at
            %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
          %p The main statement is that
          %ul
            %li
              %p
                the naïve
                %a.existingWikiWord{:href => "/nlab/show/homology"} homology
                groups of a
                %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
                are really its
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
                = succeed "-groupoid);" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
            %li
              %p
                the naïve cohomology groups of a cochain complex are really the abstract
                %a.existingWikiWord{:href => "/nlab/show/cohomology+groups"} cohomology groups
                of the dual
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
          %h3#preliminaries Preliminaries
          %p Before discussing chain homology and cohomology, we fix some terms and notation.
          %h4#eilenbergmaclane_objects Eilenberg-MacLane objects
          %p
            In a given
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            there is a notion of
            %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
            and
            %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            for every (co-)coefficient object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            ).
          %p
            The particular case of
            %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
            %a.existingWikiWord{:href => "/nlab/show/homology"} homology
            is only the special case induced from coefficients given by the corresponding
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+objects"} Eilenberg-MacLane objects
          %p
            Assume for simplicity here and in the following that we are talking about non-negatively graded chain complexes of vector spaces over some field
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ∈
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi n
                          %mi k
                        %mtd
                          %mo :
                          %mo =
                          %mo{:stretchy => "false"} (
                          %mi ⋯
                          %mo →
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi n
                          %msub
                            %mi k
                            %mi n
                          %mo →
                          %mi ⋯
                          %mo →
                          %mover
                            %mo →
                            %mo ∂
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi n
                          %msub
                            %mi k
                            %mn 1
                          %mover
                            %mo →
                            %mo ∂
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi n
                          %msub
                            %mi k
                            %mn 0
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %mo{:stretchy => "false"} (
                          %mi ⋯
                          %mo →
                          %mi k
                          %mo →
                          %mi ⋯
                          %mo →
                          %mn 0
                          %mo →
                          %mn 0
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  \\mathbf{B}^n k &amp;:=
                  (
                  \\cdots
                  \\to
                  \\mathbf{B}^n k_n
                  \\to
                  \\cdots
                  \\to \stackrel{\partial}{\to} \mathbf{B}^n k_1
                  \\stackrel{\partial}{\to} \mathbf{B}^n k_0)
                  \\\
                  \&amp;=
                  (  \cdots \to k \to \cdots \to 0 \to 0 )
                  \\end{aligned}
          %p
            for the
            = succeed "th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+object"} Eilenberg-MacLane object
          %p
            Notice that this is often also denoted
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} k[n]
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi n
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} k[-n]
            or
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K(k,n)
          %h4#homotopy_and_cohomology Homotopy and cohomology
          %p
            With the
            %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan correspondence
            understood, embedding chain complexes into
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoids"} ∞-groupoids
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                  %annotation{:encoding => "application/x-tex"} X_\bullet
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mo •
                %annotation{:encoding => "application/x-tex"} A_\bullet
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi B
                    %mo •
                %annotation{:encoding => "application/x-tex"} B_\bullet
            we obtain
          %ul
            %li
              %p
                the
                = succeed "-groupoid" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mrow
                          %mn ∞
                          %mi Grpd
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi X
                        %mo •
                      %mo ,
                      %msub
                        %mi A
                        %mo •
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbf{H}_{\infty Grpd}(X_\bullet, A_\bullet)
              %p
                whose * objects are the
                = succeed "-valued" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                = succeed "s;" do
                  %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 0
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi X
                        %mo •
                      %mo ,
                      %msub
                        %mi A
                        %mo •
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi_0 \mathbf{H}(X_\bullet,A_\bullet)
                are the cohomology classes
            %li
              %p
                the
                = succeed "-groupoids" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mrow
                          %mn ∞
                          %mi Grpd
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi B
                        %mo •
                      %mo ,
                      %msub
                        %mi X
                        %mo •
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbf{H}_{\infty Grpd}(B_\bullet, X_\bullet)
              %p
                whose * objects are the
                = succeed "-co-valued" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                      %annotation{:encoding => "application/x-tex"} B
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 0
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi B
                        %mo •
                      %mo ,
                      %msub
                        %mi X
                        %mo •
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi_0 \mathbf{H}(B_\bullet,X_\bullet)
                are the homotopy classes
          %h3#chain_homology_as_homotopy Chain homology as homotopy
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mo •
                  %mo :
                  %mo =
                  %msub
                    %mi V
                    %mo •
                %annotation{:encoding => "application/x-tex"} X_\bullet := V_\bullet
            any
            %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mi n
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi V
                    %mo •
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H_n(V_\bullet)
            its ordinary chain
            %a.existingWikiWord{:href => "/nlab/show/homology"} homology
            in degree
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mi n
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi V
                    %mo •
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi π
                    %mn 0
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} (
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %msub
                    %mi k
                    %mo •
                  %mo ,
                  %msub
                    %mi V
                    %mo •
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  H_n(V_\bullet) \simeq
                  \\pi_0 \mathbf{H}(\mathbf{B}^n k_\bullet, V_\bullet)
                  \\,.
          %p
            A cycle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo :
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %msub
                    %mi k
                    %mo •
                  %mo →
                  %msub
                    %mi V
                    %mo •
                %annotation{:encoding => "application/x-tex"} c : \mathbf{B}^n k_\bullet \to V_\bullet
            is a chain map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi ⋯
                        %mtd
                          %mover
                            %mo →
                            %mo ∂
                        %mtd
                          %mn 0
                        %mtd
                          %mover
                            %mo →
                            %mo ∂
                        %mtd
                          %mi k
                        %mtd
                          %mover
                            %mo →
                            %mo ∂
                        %mtd
                          %mn 0
                        %mtd
                          %mover
                            %mo →
                            %mo ∂
                        %mtd
                          %mi ⋯
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mrow
                              %msub
                                %mi c
                                %mi n
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi ⋯
                        %mtd
                          %mover
                            %mo →
                            %mo ∂
                        %mtd
                          %msub
                            %mi V
                            %mrow
                              %mi n
                              %mo +
                              %mn 1
                        %mtd
                          %mover
                            %mo →
                            %mo ∂
                        %mtd
                          %msub
                            %mi V
                            %mi n
                        %mtd
                          %mover
                            %mo →
                            %mo ∂
                        %mtd
                          %msub
                            %mi V
                            %mrow
                              %mi n
                              %mo −
                              %mn 1
                        %mtd
                          %mover
                            %mo →
                            %mo ∂
                        %mtd
                          %mi ⋯
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\cdots
                  \&amp;\stackrel{\partial}{\to}&amp;
                  0
                  \&amp;\stackrel{\partial}{\to}&amp;
                  k
                  \&amp;\stackrel{\partial}{\to}&amp;
                  0
                  \&amp;\stackrel{\partial}{\to}&amp;
                  \\cdots
                  \\\
                  \&amp;&amp; \downarrow
                  \&amp;&amp; \downarrow^{c_n}
                  \&amp;&amp; \downarrow
                  \\\
                  \\cdots
                  \&amp;\stackrel{\partial}{\to}&amp;
                  V_{n+1}
                  \&amp;\stackrel{\partial}{\to}&amp;
                  V_n
                  \&amp;\stackrel{\partial}{\to}&amp;
                  V_{n-1}
                  \&amp;\stackrel{\partial}{\to}&amp;
                  \\cdots
                  }
          %p
            Such chain maps are clearly in bijection with those elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi c
                    %mi n
                  %mo ∈
                  %msub
                    %mi V
                    %mi n
                %annotation{:encoding => "application/x-tex"} c_n \in V_n
            that are in the kernel of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi V
                    %mi n
                  %mover
                    %mo →
                    %mo ∂
                  %msub
                    %mi V
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} V_n \stackrel{\partial}{\to} V_{n-1}
            in that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                    %msub
                      %mi c
                      %mi n
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \partial c_n = 0
          %p
            A boundary
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                  %mo :
                  %mi c
                  %mo →
                  %mi C
                  %mo ′
                %annotation{:encoding => "application/x-tex"} \lambda : c \to C'
            is a chain homotopy
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi ⋯
                        %mtd
                          %mover
                            %mo →
                            %mo ∂
                        %mtd
                          %mn 0
                        %mtd
                          %mover
                            %mo →
                            %mo ∂
                        %mtd
                          %mi k
                        %mtd
                          %mover
                            %mo →
                            %mo ∂
                        %mtd
                          %mn 0
                        %mtd
                          %mover
                            %mo →
                            %mo ∂
                        %mtd
                          %mi ⋯
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mrow
                              %msub
                                %mi λ
                                %mi n
                          %mo ↙
                      %mtr
                        %mtd
                          %mi ⋯
                        %mtd
                          %mover
                            %mo →
                            %mo ∂
                        %mtd
                          %msub
                            %mi V
                            %mrow
                              %mi n
                              %mo +
                              %mn 1
                        %mtd
                          %mover
                            %mo →
                            %mo ∂
                        %mtd
                          %msub
                            %mi V
                            %mi n
                        %mtd
                          %mover
                            %mo →
                            %mo ∂
                        %mtd
                          %msub
                            %mi V
                            %mrow
                              %mi n
                              %mo −
                              %mn 1
                        %mtd
                          %mover
                            %mo →
                            %mo ∂
                        %mtd
                          %mi ⋯
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\cdots
                  \&amp;\stackrel{\partial}{\to}&amp;
                  0
                  \&amp;\stackrel{\partial}{\to}&amp;
                  k
                  \&amp;\stackrel{\partial}{\to}&amp;
                  0
                  \&amp;\stackrel{\partial}{\to}&amp;
                  \\cdots
                  \\\
                  \&amp;&amp; &amp;
                  {}^{\lambda_n}\swarrow
                  \\\
                  \\cdots
                  \&amp;\stackrel{\partial}{\to}&amp;
                  V_{n+1}
                  \&amp;\stackrel{\partial}{\to}&amp;
                  V_n
                  \&amp;\stackrel{\partial}{\to}&amp;
                  V_{n-1}
                  \&amp;\stackrel{\partial}{\to}&amp;
                  \\cdots
                  }
          %p
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ′
                    %mo =
                    %mi c
                    %mo +
                    %mo ∂
                    %mi λ
                  %annotation{:encoding => "application/x-tex"} c' = c + \partial \lambda
          %p (…)
          %h3#cohomology_of_cochain_complexes Cohomology of cochain complexes
          %p
            The ordinary notion of cohomology of a
            %a.existingWikiWord{:href => "/nlab/show/chain+complex"} cochain complex
            is the special case of cohomology in the
            %a.existingWikiWord{:href => "/nlab/show/stable+%28%E2%88%9E%2C1%29-category"} stable (∞,1)-
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/category+of+chain+complexes"} category of chain complexes
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi V
                    %mo •
                %annotation{:encoding => "application/x-tex"} V^\bullet
            a cochain complex let
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %mo :
                          %mo =
                          %msub
                            %mi V
                            %mo •
                          %mo =
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi V
                            %mo •
                          %msup
                            %mo{:stretchy => "false"} )
                            %mo *
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %mo{:stretchy => "false"} (
                          %mi ⋯
                          %mo →
                          %msub
                            %mi X
                            %mrow
                              %mi n
                              %mo +
                              %mn 1
                          %mover
                            %mo →
                            %mo ∂
                          %msub
                            %mi X
                            %mi n
                          %mover
                            %mo →
                            %mo ∂
                          %msub
                            %mi X
                            %mrow
                              %mi n
                              %mo −
                              %mn 1
                          %mo →
                          %mi ⋯
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo :
                          %mo =
                          %mo{:stretchy => "false"} (
                          %mi ⋯
                          %mo →
                          %msub
                            %mi V
                            %mrow
                              %mi n
                              %mo +
                              %mn 1
                          %mover
                            %mo →
                            %mo ∂
                          %msub
                            %mi V
                            %mi n
                          %mover
                            %mo →
                            %mo ∂
                          %msub
                            %mi V
                            %mrow
                              %mi n
                              %mo −
                              %mn 1
                          %mo →
                          %mi ⋯
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  X &amp;:= V_\bullet = (V^\bullet)^*
                  \\\
                  \&amp;=
                  (\cdots \to X_{n+1} \stackrel{\partial}{\to}
                  X_n \stackrel{\partial}{\to} X_{n-1} \to \cdots)
                  \\\
                  \&amp; :=
                  (\cdots \to V_{n+1} \stackrel{\partial}{\to}
                  V_n \stackrel{\partial}{\to} V_{n-1} \to \cdots)
                  \\end{aligned}
          %p
            be the corresponding dual
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mi A
                        %mtd
                          %mo :
