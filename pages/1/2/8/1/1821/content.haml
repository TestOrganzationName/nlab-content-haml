                        %mo{:stretchy => "false"} (
                        %msub
                          %mo ∂
                          %mi n
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    H_n(V) \coloneqq \frac{Z_n(V)}{B_n(V)} = \frac{ker(\partial_{n-1})}{im(\partial_n)}
            %p
              given by the
              %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
              (
              %a.existingWikiWord{:href => "/nlab/show/cokernel"}> cokernel
              ) of the group of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/cycles"} cycles
              by that of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
