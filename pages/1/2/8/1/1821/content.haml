                      \\cdots
                      \\\
                      \&amp;&amp;
                      \&amp;&amp;
                      \&amp;{}^{\lambda}\swarrow&amp;
                      \\\
                      \\cdots &amp;\to&amp; 0 &amp;\stackrel{\partial}{\to}&amp;
