                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi n
                          %mi I
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  \\mathbf{H}(X,A)
                  \&amp;=
                  Ch(V_\bullet, \mathbf{B}^n I)
                  \\end{aligned}
          %p has
          %ul
            %li
              %p
                as objects chain morphisms
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo :
                      %msub
                        %mi V
                        %mo •
                      %mo →
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi n
                      %mi I
                    %annotation{:encoding => "application/x-tex"} c : V_\bullet \to \mathbf{B}^n I
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi ⋯
                            %mtd
