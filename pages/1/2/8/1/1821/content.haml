          %h2#idea Idea
          %p
            In the context of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homological+algebra"} homological algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi V
                    %mo •
                  %mo ∈
                  %msub
                    %mi Ch
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi 𝒜
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} V_\bullet \in Ch_\bullet(\mathcal{A})
            a
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
            %em
              chain
              %a.existingWikiWord{:href => "/nlab/show/homology+group"} homology group
            in degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            is akin to the
            = succeed "-th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
            of a topological space. It is defined to be the
            %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
            of the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/cycles"} cycles
            by the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/boundaries"} boundaries
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mo •
                  %annotation{:encoding => "application/x-tex"} V_\bullet
          %p
            %a.existingWikiWord{:href => "/nlab/show/duality"}> Dually
            , for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi V
                    %mo •
                  %mo ∈
                  %msup
                    %mi Ch
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi 𝒜
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} V^\bullet \in Ch^\bullet(\mathcal{A})
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cochain+complex"} cochain complex
            %em
              cochain
              %a.existingWikiWord{:href => "/nlab/show/cohomology+group"} cohomology group
            in degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            is the quotient of the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/cocycles"} cocycles
            by the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/coboundaries"} coboundaries
          %p
            Basic examples are the
            %a.existingWikiWord{:href => "/nlab/show/singular+homology"} singular homology
            and
            %a.existingWikiWord{:href => "/nlab/show/singular+cohomology"} singular cohomology
            of a topological space, which are the (co)chain (co)homology of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/singular+complex"} singular complex
          %p
            Chain homology and cochain cohomology constitute the basic invariants of (co)chain complexes. A
            %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
            is a
            %a.existingWikiWord{:href => "/nlab/show/chain+map"} chain map
            between chain complexes that induces isomorphisms on all chain homology groups, akin to a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
            %a.existingWikiWord{:href => "/nlab/show/category+of+chain+complexes"} category of chain complexes
            equipped with quasi-isomorphisms as
            %a.existingWikiWord{:href => "/nlab/show/weak+equivalences"} weak equivalences
            is a presentation for the
            %a.existingWikiWord{:href => "/nlab/show/stable+%28infinity%2C1%29-category"} stable (infinity,1)-category
            of chain complexes.
          %h2#definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathcal{A}
            be an
            %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian category
            such as that of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %a.existingWikiWord{:href => "/nlab/show/modules"} modules
            over a
            %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo =
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} R = \mathbb{Z}
            the
            %a.existingWikiWord{:href => "/nlab/show/integers"} integers
            this is the category
            %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo =
                  %mi k
                %annotation{:encoding => "application/x-tex"} R = k
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/field"} field
            %a.existingWikiWord{:href => "/nlab/show/Vect"} Vect
            of
            %a.existingWikiWord{:href => "/nlab/show/vector+spaces"} vector spaces
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          %p
            Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Ch
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi 𝒜
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Ch_\bullet(\mathcal{A})
            for the
            %a.existingWikiWord{:href => "/nlab/show/category+of+chain+complexes"} category of chain complexes
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ch
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi 𝒜
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Ch^\bullet(\mathcal{A})
            for the
            %a.existingWikiWord{:href => "/nlab/show/category+of+cochain+complexes"} category of cochain complexes
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
          %p
            We label
            %a.existingWikiWord{:href => "/nlab/show/differentials"} differentials
            in a chain complex as follows:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi V
                    %mo •
                  %mo =
                  %mo{:stretchy => "false"} [
                  %mi ⋯
                  %mo →
                  %msub
                    %mi V
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mo ∂
                        %mi n
                  %msub
                    %mi V
                    %mi n
                  %mo →
                  %mi ⋯
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  V_\bullet
                  \=
                  [
                  \\cdots \to V_{n+1} \stackrel{\partial_n}{\to} V_n \to \cdots
                  ]
          .num_defn
            %h6#definition_2 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mo •
                    %mo ∈
                    %msub
                      %mi Ch
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V_\bullet \in Ch_\bullet(\mathcal{A})
              a
              %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{Z}
              %strong chain homology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
