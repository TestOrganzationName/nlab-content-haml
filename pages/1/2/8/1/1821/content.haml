                  \\\
                  \&amp;=
                  (\cdots \to A_{n+1}  \to A_n \to A_{n-1} \to \cdots )
                  \\\
                  \&amp; =
                  (\cdots \to 0  \to I \to 0 \to \cdots )
                  \\end{aligned}
          %p
            be the
            %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
            with the tensor unit (the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/ground+field"} ground field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            and trivial elsewhere. Then
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
