                              %mi ⋯
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \\cdots &amp;\to&amp; V_{n+1} &amp;\stackrel{\partial}{\to}&amp;
                      V_{n}
                      \&amp;\stackrel{\partial}{\to}&amp; V_{n-1}
                      \&amp;\to&amp;
                      \\cdots
                      \\\
                      \&amp;&amp;  \downarrow^{c_{n+1}}
                      \&amp;&amp; \downarrow^{c_{n}}
                      \&amp;&amp; \downarrow^{c_{n-1}}
                      \\\
                      \\cdots &amp;\to&amp; 0 &amp;\stackrel{\partial}{\to}&amp;
                      I
                      \&amp;\stackrel{\partial}{\to}&amp; 0
                      \&amp;\to&amp;
                      \\cdots
                      }
                      \\,.
              %p
                These are in canonical bijection with the elements in the kernel of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mi n
                    %annotation{:encoding => "application/x-tex"} d_{n}
                of the dual cochain complex
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi V
                          %mo •
                        %mo =
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi V
                          %mo •
                        %mo ,
                        %mi I
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} V^\bullet = [V_\bullet,I]
            %li
              %p
                as morphism chain homotopies
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                      %mo :
                      %mi c
                      %mo →
                      %mi c
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} \lambda : c \to c'
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
