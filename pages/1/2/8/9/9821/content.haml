          %h2#direct_image_and_inverse_image_of_cycles Direct image and inverse image of cycles
          %p
            For
            %a.existingWikiWord{:href => "/nlab/show/proper+morphisms"} proper morphisms
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f : X \to Y
            %a.existingWikiWord{:href => "/nlab/show/direct+image"} direct image
            of a
            = succeed "-cycle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} [
                  %mi Z
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi deg
                    %mrow
                      %mi R
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi Z
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} (
                  %mi Z
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo .
                  %mo{:stretchy => "false"} [
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi Z
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} f_*([Z]) = \deg_{R(f(Z))}(R(Z)) . [f(Z)]
          %p
            when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi dim
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi Z
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi dim
                  %mo{:stretchy => "false"} (
                  %mi Z
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \dim(f(Z)) = \dim(Z)
            and 0 otherwise. Here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi Z
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f(Z)
            is considered as an integral subscheme of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            with the
            %a.existingWikiWord{:href => "/nlab/show/reduced+scheme"} reduced
            subscheme structure induced from
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo{:stretchy => "false"} (
                  %mi Z
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} R(Z)
            denotes the field of
            %a.existingWikiWord{:href => "/nlab/show/rational+functions"} rational functions
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Z
                %annotation{:encoding => "application/x-tex"} Z
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi deg
                %annotation{:encoding => "application/x-tex"} \deg
            denotes the degree of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/field+extension"} field extension
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mo *
                  %mo :
                  %msub
                    %mi Z
                    %mi k
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi Z
                    %mi k
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f_* : Z_k(X) \to Z_k(Y)
            for each
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          %p
            For
            %a.existingWikiWord{:href => "/nlab/show/flat+morphisms"} flat morphisms
            of
            %a.existingWikiWord{:href => "/nlab/show/relative+dimension"} relative dimension
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-cycle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Z
                  %mo ⊂
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Z \subset Y
            of dimension
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} [
                  %mi Z
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %msub
                        %mi Z
                        %mi α
                      %mo ⊂
                      %msup
                        %mi f
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi Z
                      %mo{:stretchy => "false"} )
                  %msub
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} length
                    %mrow
                      %msub
                        %mi O
                        %mrow
                          %mi X
                          %mo ,
                          %msub
                            %mi z
                            %mi α
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi O
                    %mrow
                      %msup
                        %mi f
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi Z
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %msub
                        %mi z
                        %mi α
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi Z
                    %mi α
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} f^*([Z]) = \sum_{Z_\alpha \subset f^{-1}(Z)} \length_{O_{X,z_\alpha}}(O_{f^{-1}(Z),z_\alpha}) [Z_\alpha]
          %p
            where the sum is taken over the
            %a.existingWikiWord{:href => "/nlab/show/irreducible+components"} irreducible components
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Z
                    %mi α
                %annotation{:encoding => "application/x-tex"} Z_\alpha
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Z
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f^{-1}(Z)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} length
                %annotation{:encoding => "application/x-tex"} \length
            denotes length of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/modules"} modules
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi z
                    %mi α
                %annotation{:encoding => "application/x-tex"} z_\alpha
            are the
            %a.existingWikiWord{:href => "/nlab/show/generic+points"} generic points
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Z
                      %mi α
                  %annotation{:encoding => "application/x-tex"} Z_\alpha
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
