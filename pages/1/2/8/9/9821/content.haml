                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              \-dimensional algebraic
              %a.existingWikiWord{:href => "/nlab/show/cycle"} cycle
            as an element of the
            %a.existingWikiWord{:href => "/nlab/show/free+abelian+group"} free abelian group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Z
                    %mi k
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Z_k(X)
            generated by the
            %a.existingWikiWord{:href => "/nlab/show/closed+subspace"} closed
            %a.existingWikiWord{:href => "/nlab/show/integral+scheme"} integral
            subschemes of
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %a.existingWikiWord{:href => "/nlab/show/codimension"} codimensional
            cycle is an element of the
            %a.existingWikiWord{:href => "/nlab/show/free+group"} free group
