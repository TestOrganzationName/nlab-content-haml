          %h2#weil_divisors_and_rational_functions Weil divisors and rational functions
          %p
            A
            %strong
              %a.existingWikiWord{:href => "/nlab/show/Weil+divisor"} Weil divisor
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a 1-codimensional cycle.
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/rational+function"} rational function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                  %mo ∈
                  %mi R
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} r \in R(X)
            on an
            %a.existingWikiWord{:href => "/nlab/show/integral+scheme"} integral scheme
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            corresponds via canonical isomorphisms
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Frac
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi O
                      %mrow
                        %mi X
                        %mo ,
                        %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} R(X) \to \Frac(O_{X,x})
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mi x
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi b
                      %mi x
                    %mo ∈
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Frac
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi O
                      %mrow
                        %mi X
                        %mo ,
                        %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} a_x/b_x \in \Frac(O_{X,x})
            %strong order of vanishing
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                %annotation{:encoding => "application/x-tex"} r
            at
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} ord
                    %mi x
                  %mo{:stretchy => "false"} (
                  %mi r
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} length
                    %mrow
                      %msub
                        %mi O
                        %mrow
                          %mi X
                          %mo ,
                          %mi x
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi O
                    %mrow
                      %mi X
                      %mo ,
                      %mi x
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi a
                    %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo −
                  %msub
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} length
                    %mrow
                      %msub
                        %mi O
                        %mrow
                          %mi X
                          %mo ,
                          %mi x
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi O
                    %mrow
                      %mi X
                      %mo ,
                      %mi x
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi b
                    %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \ord_x(r) = \length_{O_{X,x}}(O_{X,x}/(a_x)) - \length_{O_{X,x}}(O_{X,x}/(b_x))
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} length
                %annotation{:encoding => "application/x-tex"} \length
            denotes length of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/modules"} modules
          %p
            Then one defines the
            %strong
              %a.existingWikiWord{:href => "/nlab/show/Weil+divisor"} Weil divisor
              associated to the rational function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
            as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi div
                  %mo{:stretchy => "false"} (
                  %mi r
                  %mo{:stretchy => "false"} )
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi Z
                      %mo ⊂
                      %mi X
                  %msub
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} ord
                    %mi z
                  %mo{:stretchy => "false"} (
                  %mi r
                  %mo{:stretchy => "false"} )
                  %mo .
                  %mo{:stretchy => "false"} [
                  %mi Z
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} div(r) = \sum_{Z \subset X} \ord_z(r).[Z]
          %p
            where the sum goes over closed integral subschemes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Z
                %annotation{:encoding => "application/x-tex"} Z
            of codimension 1 and with
            %a.existingWikiWord{:href => "/nlab/show/generic+point"} generic point
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                    %mo ∈
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} z \in Z
