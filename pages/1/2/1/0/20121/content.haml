                  %annotation{:encoding => "application/x-tex"} V^G
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              under
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              equals the normalized
              %a.existingWikiWord{:href => "/nlab/show/sum"} sum
              of the character values over all group elements:
            #eq:SumOverAllCharacterValues.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi dim
                    %mrow
                      %mo (
                      %msup
                        %mi V
                        %mi G
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mn 1
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi G
                        %mo{:stretchy => "false"} |
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi g
                        %mo ∈
                        %mi G
                    %msub
                      %mi χ
                      %mi V
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    dim\left( V^G \right)
                    \\;=\;
                    \\frac{1}{{\vert G\vert}}
                    \\underset{g \in G}{\sum}
                    \\chi_V(g)
                    \\,.
            %p In particular
            %ol
              %li
                if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo =
                      %mi ρ
                      %mo ≠
                      %mstyle{:mathvariant => "bold"}
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} V = \rho \neq \mathbf{1}
                is a non-
                %a.existingWikiWord{:href => "/nlab/show/trivial+representation"} trivial
                %a.existingWikiWord{:href => "/nlab/show/irreducible+representation"} irreducible representation
                then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi g
                        %mo ∈
                        %mi G
                    %msub
                      %mi χ
                      %mi ρ
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{g \in G}{\sum}
                    \\chi_{\rho}(g)
                    \\;=\;
                    0
            %ol
              %li
                if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo =
                      %mstyle{:mathvariant => "bold"}
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} V = \mathbf{1}
                is the the
                %a.existingWikiWord{:href => "/nlab/show/trivial+representation"} trivial
                %a.existingWikiWord{:href => "/nlab/show/irreducible+representation"} irreducible representation
                then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi g
                        %mo ∈
                        %mi G
                    %msub
                      %mi χ
                      %mstyle{:mathvariant => "bold"}
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo |
                      %mi G
                      %mo |
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{g \in G}{\sum}
                    \\chi_{\mathbf{1}}(g)
                    \\;=\;
                    \\left\vert G\right\vert
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#tomDieck09"} tom Dieck 09 (2.1)
          .proof
            %h6#proof Proof
            %p
              The first statement is a special case of Prop.
              %a.maruku-ref{:href => "#SchurInnerProductInTermsOfCharacters"}
              by observing that the
              %a.existingWikiWord{:href => "/nlab/show/fixed+point+space"} fixed point space
              of a
              %a.existingWikiWord{:href => "/nlab/show/linear+representation"} linear representation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              is the space of
              %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
              from the
              %a.existingWikiWord{:href => "/nlab/show/trivial+representation"} trivial
              %a.existingWikiWord{:href => "/nlab/show/irrep"} irrep
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi dim
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi V
                      %mi G
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi dim
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                    %mi{:mathvariant => "normal"} Hom
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mstyle{:mathvariant => "bold"}
                      %mn 1
                    %mo ,
                    %mi V
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                  %annotation{:encoding => "application/x-tex"}
                    dim\big( V^G\big)
                    \\;=\;
                    dim\Big(
                    \\mathrm{Hom}\big( \mathbf{1}, V \big)
                    \\Big)
            %p
              and that the
              %a.existingWikiWord{:href => "/nlab/show/character+of+a+linear+representation"} character
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbf{1}
              is
              %a.existingWikiWord{:href => "/nlab/show/constant+function"} constant
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mo ∈
                      %mi k
                    %annotation{:encoding => "application/x-tex"} 1 \in k
            %p
              The second statement follows from this by
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Schur%27s+lemma"} Schur's lemma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mstyle{:mathvariant => "bold"}
                      %mn 1
                    %mo ,
                    %mi ρ
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \langle \mathbf{1}, \rho\rangle = 0
              if the
              %a.existingWikiWord{:href => "/nlab/show/irrep"} irrep
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                      %mo ≠
                      %mstyle{:mathvariant => "bold"}
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \rho \neq \mathbf{1}
            %p
              The last statement may similarly be seen as the complementary special case of
              %a.maruku-eqref{:href => "#eq:SumOverAllCharacterValues"} (2)
              obtained from
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mstyle{:mathvariant => "bold"}
                        %mn 1
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mn 1
                      %mo{:stretchy => "false"} ⟩
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} \langle \mathbf{1},\mathbf{1}\rangle =1
              %a.existingWikiWord{:href => "/nlab/show/character+of+a+linear+representation"} character
              of the
              %a.existingWikiWord{:href => "/nlab/show/trivial+representation"} trivial
              %a.existingWikiWord{:href => "/nlab/show/irrep"} irrep
              is
              %a.existingWikiWord{:href => "/nlab/show/constant+function"} constant
              on 1.
          %h3#schur_orthogonality Schur orthogonality
          %p
            See at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Schur+orthogonality+relations"} Schur orthogonality relations
          %h3#SpecialCharacterValues Special character values
          #CharactersAreCyclotomicIntegers.num_prop
            %h6#proposition_3 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/characters+are+cyclotomic+integers"}> characters are cyclotomic integers
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              be a
              %a.existingWikiWord{:href => "/nlab/show/finite-dimensional+vector+space"} finite-dimensional
              %a.existingWikiWord{:href => "/nlab/show/linear+representation"} linear representation
              over a
              %a.existingWikiWord{:href => "/nlab/show/ground+field"} ground field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %p
              Then the values of the
              %a.existingWikiWord{:href => "/nlab/show/character+of+a+representation"} character
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi χ
                      %mi V
                    %mo{:lspace => "verythinmathspace"} :
                    %mi G
                    %mo →
                    %mi k
                  %annotation{:encoding => "application/x-tex"} \chi_V \colon G \to k
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              are
              %a.existingWikiWord{:href => "/nlab/show/cyclotomic+integers"} cyclotomic integers
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/root+of+unity"} root of unity
          %p
            (see e.g.
            = succeed ")" do
              %a{:href => "#characters+are+cyclotomic+integers#Naik"} Naik
          %p In particular it follows that:
          .num_prop
            %h6#proposition_4 Proposition
            %p
              If the
              %a.existingWikiWord{:href => "/nlab/show/ground+field"} ground field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              in Prop.
              %a.maruku-ref{:href => "#CharactersAreCyclotomicIntegers"}
              has
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/characteristic+zero"} characteristic zero
              %a.existingWikiWord{:href => "/nlab/show/character+of+a+linear+representation"} character of a linear representation
              which takes values in the
              %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℚ
                    %mo ↪
                    %mi k
                  %annotation{:encoding => "application/x-tex"} \mathbb{Q} \hookrightarrow k
              in fact already takes values in the
              %a.existingWikiWord{:href => "/nlab/show/integers"} integers
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo ↪
                      %mi ℚ
                      %mo ↪
                      %mi k
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z} \hookrightarrow\mathbb{Q} \hookrightarrow k
          %p
            (see e.g.
            = succeed ")" do
              %a{:href => "#characters+are+cyclotomic+integers#Yang"} Yang
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/equivariant+K-theory"} equivariant K-theory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/fractional+D-brane"} fractional D-brane
          %h2#references References
          %p
            Most texts of
            %a.existingWikiWord{:href => "/nlab/show/representation+theory"} representation theory
            discuss characters of representations of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/finite+groups"} finite groups
            %a{:href => "representation+theory#References"} there
            for more.
          %p Monographs:
          %ul
            %li#EtingofEtAl11
              %a.existingWikiWord{:href => "/nlab/show/Pavel+Etingof"}> Pavel Etingof
              ,
              %a.existingWikiWord{:href => "/nlab/show/Dmitry+Vaintrob"} Dmitry Vaintrob
              et al., section 2.6 of:
              = succeed "," do
                %em Introduction to representation theory
              = succeed "," do
                %strong 59
              = succeed "," do
                %a{:href => "https://arxiv.org/abs/0901.0827"} arXiv:0901.0827
              = succeed "&rbrack;" do
                %a{:href => "https://bookstore.ams.org/stml-59"} ams:stml-59
          %p Lecture notes:
          %ul
            %li#tomDieck09
              %a.existingWikiWord{:href => "/nlab/show/Tammo+tom+Dieck"}> Tammo tom Dieck
              , chapter 2 of:
              %em Representation theory
              (2009) &amp;lbrack;
              %a{:href => "http://www.uni-math.gwdg.de/tammo/rep.pdf"}> pdf
              ,
              = succeed "&rbrack;" do
                %a.existingWikiWord{:href => "/nlab/files/tomDieckRepresentationTheory.pdf", :title => "pdf"} pdf
          %p
            On character rings of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/compact+Lie+groups"} compact Lie groups
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Graeme+Segal"}> Graeme Segal
                ,
                = succeed "," do
                  %em The representation ring of a compact Lie group
              %p
                January 1968, Volume 34, Issue 1, pp 113-128 (
                %a{:href => "http://archive.numdam.org/numdam-bin/fitem?id=PMIHES_1968__34__113_0"}> NUMDAM
                )
            %li
              %p
                Masaru Tackeuchi,
                = succeed "," do
                  %em A remark on the character ring of a compact Lie group
                = succeed ")" do
                  %a{:href => "http://projecteuclid.org/euclid.jmsj/1259849785"} Euclid
            %li
              %p
                Troels Roussauc Johansen,
                %em Character Theory for Finite Groups and Compact Lie Groups
                %a{:href => "http://www.math.upb.de/~johansen/character-theory.pdf"} pdf
          %p
            Discussion in the more general context of
            %a.existingWikiWord{:href => "/nlab/show/equivariant+cohomology"} equivariant
            %a.existingWikiWord{:href => "/nlab/show/complex+oriented+cohomology+theory"} complex oriented cohomology theory
            (
            %a.existingWikiWord{:href => "/nlab/show/transchromatic+character"}> transchromatic character
            ):
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Michael+Hopkins"}> Michael Hopkins
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Nicholas+Kuhn"} Nicholas Kuhn
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Douglas+Ravenel"} Douglas Ravenel
              = succeed "," do
                %em Generalized group characters and complex oriented cohomology theories
              = succeed "," do
                %a{:href => "http://www.ams.org/journals/jams/2000-13-03/S0894-0347-00-00332-5/"} publisher
              = succeed ")" do
                %a{:href => "http://www.math.rochester.edu/people/faculty/doug/mypapers/hkr.pdf"} pdf
          %p for review see
          %ul
            %li#Raksit15
              Arpon Raksit,
              = succeed "," do
                %em Characters in global equivariant homotopy theory
              %a{:href => "http://web.stanford.edu/~arpon/math/files/senior-thesis.pdf"} pdf
          %p
            Examples of
            %a.existingWikiWord{:href => "/nlab/show/characters+of+linear+representations"} characters of linear representations
            of
            %a.existingWikiWord{:href => "/nlab/show/finite+groups"} finite groups
            are discussed and listed at
          %ul
            %li#Montaldi08
              %a.existingWikiWord{:href => "/nlab/show/James+Montaldi"}> James Montaldi
              ,
              = succeed "," do
                %em
                  %a{:href => "http://www.maths.manchester.ac.uk/~jm/wiki/Representations/Representations"} representations
        .revisedby
