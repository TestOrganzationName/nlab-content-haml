          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi D
                    %mo{:stretchy => "false"} ˜
                  %mo{:lspace => "verythinmathspace"} :
                  %msubsup
                    %mi J
                    %mi Σ
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi F
                %annotation{:encoding => "application/x-tex"}
                  \\tilde D \colon J^\infty_\Sigma(E) \to F
          %p
            out of the
            %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
            via
            %a.existingWikiWord{:href => "/nlab/show/jet+prolongation"} jet prolongation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
