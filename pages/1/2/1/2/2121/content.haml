            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mover
                    %mo →
                    %mi fb
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} \Sigma
            is the bundle of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+variables"} dependent variables
            %a.existingWikiWord{:href => "/nlab/show/differential+operator"} differential operator
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
