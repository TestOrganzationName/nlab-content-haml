                  }
          %p
            For instance in
            %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
            the bundle in question is a
            %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
                      %mi fb
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} \Sigma
            %a.existingWikiWord{:href => "/nlab/show/partial+differential+equation"} partial differential equation
            is the
            %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+equation"} Euler-Lagrange equation
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mi EL
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \delta_{EL}\mathbf{L} = 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} \mathcal{E}
            inside the
            %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi J
                    %mi Σ
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} J^\infty_\Sigma(E)
            is called the
            %em
              %a.existingWikiWord{:href => "/nlab/show/shell"} shell
            of the field theory.
          %p
            In
            %a{:href => "#Marvan86"} Marvan 86
            it was observed that Vinogradov’s
            %a.existingWikiWord{:href => "/nlab/show/formally+integrable+PDE"} formally integrable diffieties
            are equivalently the
            %a.existingWikiWord{:href => "/nlab/show/coalgebra+over+a+comonad"} coalgebras
            over the
            %a.existingWikiWord{:href => "/nlab/show/jet+comonad"} jet comonad
            acting on
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/locally+pro-manifold"} locally pro-manifold
            %a.existingWikiWord{:href => "/nlab/show/bundles"} bundles
            (over a base space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            of
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/free+variables"} free variables
            %a.existingWikiWord{:href => "/nlab/show/synthetic+differential+geometry"} synthetic differential geometry
            of the
            %a.existingWikiWord{:href => "/nlab/show/Cahiers+topos"} Cahiers topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            (
            %a{:href => "#KhavkineSchreiber17"}> Khavkine-Schreiber 17
            ), where the
            %a.existingWikiWord{:href => "/nlab/show/jet+comonad"} jet comonad
            is realized as the comonad corresponding to
            %a.existingWikiWord{:href => "/nlab/show/base+change"} base change
            along the
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+shape"} de Rham shape
            projection
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi η
                          %mi Σ
                    %mi ℑ
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma \overset{\eta_\Sigma}{\longrightarrow} \Im \Sigma
            %a.existingWikiWord{:href => "/nlab/show/comonadic+descent"} comonadic descent
            this implies that over
            %a.existingWikiWord{:href => "/nlab/show/formally+smooth"} formally smooth
            base spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            %a.existingWikiWord{:href => "/nlab/show/formally+integrable+PDE"} formally integrable diffieties
            are equivalently the
            %a.existingWikiWord{:href => "/nlab/show/bundles"} bundles
            over the
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+shape"} de Rham shape
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℑ
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Im \Sigma
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi PDEs
                    %mi Σ
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi Diffeties
                    %mi Σ
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %msubsup
                    %mi J
                    %mi Σ
                    %mn ∞
                  %mi CoAlg
                  %mrow
                    %mo (
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi Σ
                    %mo )
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mi ℑ
                      %mo{:stretchy => "false"} (
                      %mi Σ
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  PDEs_\Sigma(\mathbf{H})
                  \\;=\;
                  Diffeties_\Sigma(\mathbf{H})
                  \\;\simeq\;
                  J^\infty_\Sigma CoAlg\left(\mathbf{H}_{/\Sigma} \right)
                  \\;\simeq\;
                  \\mathbf{H}_{/\Im(\Sigma)}
          %p
            (
            %a{:href => "#KhavkineSchreiber17"}> Khavkine-Schreiber 17, thorem 3.52, theorem 3.60
            )
          %p
            This makes manifest how
            %a.existingWikiWord{:href => "/nlab/show/diffieties"} diffieties
            are the analog in
            %a.existingWikiWord{:href => "/nlab/show/differential+geometry"} differential geometry
            of concepts in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+geometry"} algebraic geometry
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            a suitable
            %a.existingWikiWord{:href => "/nlab/show/scheme"} scheme
            then a
            %a.existingWikiWord{:href => "/nlab/show/quasicoherent+module"} quasicoherent module
            over its
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+shape"} de Rham shape
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℑ
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Im \Sigma
            (“
            %a.existingWikiWord{:href => "/nlab/show/crystal"}> crystal
            ”) is called a
            %em
              %a.existingWikiWord{:href => "/nlab/show/D-module"} D-module
            and represents an algebraic
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/linear+partial+differential+equation"} linear partial differential equation
            %a.existingWikiWord{:href => "/nlab/show/relative+scheme"} relative scheme
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℑ
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Im \Sigma
            is called a
            %em
              %a.existingWikiWord{:href => "/nlab/show/D-scheme"} D-scheme
            and represents a general algebraic
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/partial+differential+equation"} partial differential equation
            %em
              %a.existingWikiWord{:href => "/nlab/show/D-geometry"} D-geometry
            for more on this.
