                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/files/MarvanJetComonadPDE.pdf", :title => "pdf"} pdf
            %li#MarvanThesis
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michal+Marvan"}> Michal Marvan
                , thesis, 1989 (
