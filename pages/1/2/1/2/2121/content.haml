                  D \;\colon\; \Gamma_\Sigma(E) \longrightarrow \Gamma_\Sigma(F)
          %p
            on the
            %a.existingWikiWord{:href => "/nlab/show/space+of+smooth+sections"} space of smooth sections
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
