                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} j^\infty_\Sigma \colon \Gamma_\Sigma(E) \to \Gamma_\Sigma(J^\infty_\Sigma(E))
            as
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
