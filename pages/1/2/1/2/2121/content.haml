                  %mi E
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi Γ
                    %mi Σ
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi J
                    %mi Σ
                    %mn ∞
                  %mo{:stretchy => "false"} (
