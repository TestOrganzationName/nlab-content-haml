                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            with
            %a.existingWikiWord{:href => "/nlab/show/finite+%28%E2%88%9E%2C1%29-limits"} finite (∞,1)-limits
            is the
            %a.existingWikiWord{:href => "/nlab/show/free+construction"} free
            %a.existingWikiWord{:href => "/nlab/show/stable+%28%E2%88%9E%2C1%29-category"} stable (∞,1)-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Stab
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Stab(C)
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %a.existingWikiWord{:href => "/nlab/show/spectrum+objects"} spectrum objects
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo =
                %annotation{:encoding => "application/x-tex"} C =
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            the stabilization is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Stab
                  %mo{:stretchy => "false"} (
                  %mi Top
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi Spec
                %annotation{:encoding => "application/x-tex"} Stab(Top) \simeq Spec
