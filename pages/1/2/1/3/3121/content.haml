          %p
            Going back and forth this way, i.e. applying the corresponding
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-monad"} (∞,1)-monad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mn ∞
                  %mo ∘
                  %msup
                    %mi Σ
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} \Omega^\infty \circ \Sigma^\infty
            yields the assignment
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ↦
                  %msup
                    %mi Ω
                    %mn ∞
                  %msup
                    %mi Σ
                    %mn ∞
                  %mi X
                %annotation{:encoding => "application/x-tex"}
                  X \mapsto \Omega^\infty \Sigma^\infty X
          %p
            that may be thought of as the
            %strong stabilization of an object
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mn ∞
                  %msup
                    %mi Σ
                    %mn ∞
                  %mi X
                %annotation{:encoding => "application/x-tex"} \Omega^\infty \Sigma^\infty X
            may be thought of as the result as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            goes to infinity of the operation that forms from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            first the
            = succeed "-fold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/suspension+object"} suspension object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Σ
                    %mi n
                  %mi X
                %annotation{:encoding => "application/x-tex"} \Sigma^n X
            and then from that the
            = succeed "-fold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop space object
          %h2#definition Definition
          %h3#abstract_definition Abstract definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            with
            %a.existingWikiWord{:href => "/nlab/show/finite+%28%E2%88%9E%2C1%29-limit"} finite (∞,1)-limit
            and write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mo *
                  %mo :
                  %mo =
                  %msup
                    %mi C
                    %mrow
                      %mo *
                      %mo{:stretchy => "false"} /
                %annotation{:encoding => "application/x-tex"} C_* := C^{{*}/}
            for its
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/pointed+objects"} pointed objects
            %a.existingWikiWord{:href => "/nlab/show/undercategory"} undercategory
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            under the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
          %p
            On
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mo *
                %annotation{:encoding => "application/x-tex"} C_*
            there is the
            %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop space object
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-functor"} (infinity,1)-functor
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                    %mo :
                    %msub
                      %mi C
                      %mo *
                    %mo →
                    %msub
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \Omega : C_* \to C_*
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to the
            %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
            of the point inclusion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} {*} \to X
            along itself. Recall that if a
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop space object
            functor is an equivalence.
          %p
            The
            %em stabilization
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Stab
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Stab(C)
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-limit"} (∞,1)-limit
            (in the
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-categories"} (∞,1)-category of (∞,1)-categories
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Stab
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo =
                  %munder
                    %mi lim
                    %mo ←
                  %mrow
                    %mo (
                    %mi ⋯
                    %mo →
                    %msub
                      %mi C
                      %mo *
                    %mover
                      %mo →
                      %mi Ω
                    %msub
                      %mi C
                      %mo *
                    %mover
                      %mo →
                      %mi Ω
                    %msub
                      %mi C
                      %mo *
                    %mo )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Stab(C)
                  \=
                  \\underset{\leftarrow}{\lim}
                  \\left(
                  \\cdots \to C_* \stackrel{\Omega}{\to} C_* \stackrel{\Omega}{\to} C_*
                  \\right)
                  \\,.
          %p
            This is (
            %a{:href => "http://arxiv.org/abs/math/0608228"}> StabCat, proposition 8.14
            ).
          %p
            The canonical functor from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Stab
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Stab(C)
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mo *
                %annotation{:encoding => "application/x-tex"} C_*
            and then further, via the functor that forgets the basepoint, to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is therefore denoted
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mn ∞
                  %mo :
                  %mi Stab
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi C
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\Omega^\infty : Stab(C) \to C
                  \\,.
          %h3#construction_in_terms_of_spectrum_objects Construction in terms of spectrum objects
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi.mathscript 𝒮
                    %mi fin
                  %mo ⊆
                  %mi.mathscript 𝒮
                %annotation{:encoding => "application/x-tex"} \mathscr{S}^{fin} \subseteq \mathscr{S}
            be the full subcategory of spaces generated under finite colimits by the point (i.e. the finite CW-complexes, for concreteness) and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi.mathscript 𝒮
                    %mo *
                    %mi fin
                %annotation{:encoding => "application/x-tex"} \mathscr{S}^{fin}_*
            be the category of pointed objects in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi.mathscript 𝒮
                      %mi fin
                  %annotation{:encoding => "application/x-tex"} \mathscr{S}^{fin}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            with finite limits,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Stab
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Stab(C)
            may be constructed as the category of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/spectrum+object"} spectrum object
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %a.existingWikiWord{:href => "/nlab/show/n-reduced+%28%E2%88%9E%2C1%29-functor"} reduced
            %a.existingWikiWord{:href => "/nlab/show/excisive+%28%E2%88%9E%2C1%29-functor"} excisive
            functors from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi.mathscript 𝒮
                    %mo *
                    %mi fin
                %annotation{:encoding => "application/x-tex"} \mathscr{S}^{fin}_*
            to
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Stab
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi{:mathvariant => "normal"} Exc
                    %mo *
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi.mathscript 𝒮
                    %mo *
                    %mi{:mathvariant => "normal"} fin
                  %mo ,
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Stab(C) = \mathrm{Exc}_*(\mathscr{S}^{\mathrm{fin}}_*, C)
                  \\,.
          %p
            This is
            = succeed "." do
              %a{:href => "#HA"} Higher Algebra, Definition 1.4.2.8
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Stab
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mi Stab
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi C
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Stab(C) \cong Stab(C^{*/})
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is the same as stabilizing the category of pointed objects in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %h3#ConstructionInTermsOfStableModelCategories Construction in terms of stable model categories
          %p
            Given a presentation of an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            by a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/stable+model+category"} stable model category
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            is due to (
            %a{:href => "#Robalo12"}> Robalo 12, prop. 4.14
            ).
          %p
            For classical discussion see also
            %em
              %a.existingWikiWord{:href => "/nlab/show/spectrification"} spectrification
            and the
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Bousfield-Friedlander+model+structure"} Bousfield-Friedlander model structure
          %h2#properties Properties
          %ul
            %li
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              a
              %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-category"} presentable
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mn ∞
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Stab
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} \Omega^\infty \colon Stab(C) \to C
              has a
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Σ
                      %mn ∞
                    %mo :
                    %mi C
                    %mo →
                    %mi Stab
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Sigma^\infty : C \to Stab(C)
              (forming
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/suspension+spectra"} suspension spectra
          %p
            Prop 15.4 (2) of
            = succeed "." do
              %a{:href => "http://arxiv.org/abs/math/0608228"} StabCat
          %ul
            %li
              stabilization extends to a functor
              = succeed ".," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Cat
                        %mn ∞
                        %mi lex
                      %mo →
                      %msubsup
                        %mi Cat
                        %mn ∞
                        %mi ex
                    %annotation{:encoding => "application/x-tex"} Cat^{lex}_{\infty} \to Cat^{ex}_{\infty}
              = succeed "-categories" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              = succeed "-categories" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:lspace => "verythinmathspace"} :
                    %mi C
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} F\colon C\to D
              is the functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} Exc
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi.mathscript 𝒮
                      %mo *
                      %mi{:mathvariant => "normal"} fin
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi{:mathvariant => "normal"} Exc
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi.mathscript 𝒮
                      %mo *
                      %mi{:mathvariant => "normal"} fin
                    %mo ,
                    %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{Exc}_*(\mathscr{S}^{\mathrm{fin}}_*, C) \to \mathrm{Exc}_*(\mathscr{S}^{\mathrm{fin}}_*, D)
              given by post-composition with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              to be left exact in order to be well-defined! However, it turns out that stabilization can
              %em also
              be made functorial in another situation: that of reduced functors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:lspace => "verythinmathspace"} :
                    %mi C
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} F\colon C \to D
              between
              %a.existingWikiWord{:href => "/nlab/show/Goodwillie-differentiable+%28infinity%2C1%29-category"} differentiable
              = succeed "-categories" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              under the stabilization functor is called in this case the
              %em linearization
              (
              %a{:href => "#GC"}> (infinity,2)-Categories and the Goodwillie Calculus, Definition 5.1.5
              ) or the
              %em derivative
              (
              %a{:href => "#HA"}> Higher Algebra, Definition 6.2.1.1
              ) of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
              = succeed ")" do
                %a{:href => "#HA"} Higher Algebra, Corollary 6.2.1.24
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is strictly linked with the first approximation of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Goodwillie+calculus"} Goodwillie calculus
          %p
          .num_prop
            %h6 Proposition
            %p In the case of ordinary homotopy types (at least), the stabilization adjunction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Σ
                      %mn ∞
                    %mo ⊣
                    %msup
                      %mi Ω
                      %mn ∞
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi Grpd
                      %mn ∞
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo ⇄
                    %mi Spectra
                  %annotation{:encoding => "application/x-tex"}
                    \\Sigma^\infty \dashv \Omega^\infty
                    \\;\colon\;
                    Grpd_\infty^{\ast/}
                    \\rightleftarrows
                    Spectra
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/comonadic+adjunction"} comonadic adjunction
              on
              %a.existingWikiWord{:href => "/nlab/show/simply+connected+homotopy+type"} simply connected
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+types"} homotopy types
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/pointed+homotopy+types"} pointed
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Σ
                        %mn ∞
                      %msup
                        %mi Ω
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} \Sigma^\infty \Omega^\infty
              %a.existingWikiWord{:href => "/nlab/show/modales"} modales
              among
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+types"} stable homotopy types
          \&amp;lbrack;
          %a{:href => "#BlomquistHarper16"}> Blomquist &amp; Harper 2016 Thm. 1.8
          ;
          = succeed "&rbrack;" do
            %a{:href => "#HessKedziorek17"} Hess &amp; Kedziorek 2017 Thm. 3.11
          %p
            Here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Σ
                    %mn ∞
                  %msup
                    %mi Ω
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} \Sigma^\infty \Omega^\infty
            is the (pointed)
            %a.existingWikiWord{:href => "/nlab/show/exponential+modality"} exponential modality
            in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/linear+homotopy+type+theory"} linear homotopy type theory
            %a{:href => "!-modality#RealizationInLinearHomotopyTypeTheory"} there
            for more.
