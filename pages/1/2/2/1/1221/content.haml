          %h2#idea Idea
          %p
            A
            %em pseudo-abelian category
            \&amp;lbrack;
            %a{:href => "#Karoubi78"}> Karoubi (1978), Def. 6.7
            \&amp;rbrack; or
            %em Karoubian category
            is a
            %a.existingWikiWord{:href => "/nlab/show/pre-additive+category"} pre-additive category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            such that every
            %a.existingWikiWord{:href => "/nlab/show/idempotent"} idempotent
            morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo{:lspace => "verythinmathspace"} :
                  %mi A
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} p \colon A \to A
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            has a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cokernel"} cokernel
          %p
            This is stronger than
            %a.existingWikiWord{:href => "/nlab/show/pre-additive+category"} pre-additivity
            but weaker than
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelianness
            %em every
            morphism has a
            %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cokernel"} cokernel
          %h2#definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be a category and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo :
                  %mi X
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} p : X \to X
            an
            %a.existingWikiWord{:href => "/nlab/show/idempotent"} idempotent
            %a.existingWikiWord{:href => "/nlab/show/endomorphism"} endomorphism
            of an object
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            %strong admits an image
            if the functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ker
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi id
                    %mi X
                  %mo ,
                  %mi p
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Ker(id_X, p)
            is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/representable"} representable
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ker
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi id
                    %mi X
                  %mo ,
                  %mi p
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Ker(id_X, p)
            is the functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mi op
                  %mo →
                  %munder
                    %mi Set
                    %mo ̲
                %annotation{:encoding => "application/x-tex"} C^{op} \to \underline{Set}
            mapping
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                  %mo ↦
                  %mi Ker
                  %mo{:stretchy => "false"} (
                  %mi Hom
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ⇉
                  %mi Hom
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ;
                  %mspace{:width => "2em"}
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Y \mapsto Ker(Hom(Y, X) \rightrightarrows Hom(Y, X)); \qquad (\ast)
          %p
            in other words the image of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            is the
            %a.existingWikiWord{:href => "/nlab/show/equaliser"} difference kernel
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi id
                      %mi X
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (id_X, p)
          %p
            Now
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is called
            %strong Karoubian
            if every idempotent
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            admits an image. Since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo :
                  %mi X
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} p: X \to X
            is idempotent iff
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi id
                    %mi X
                  %mo −
                  %mi p
                %annotation{:encoding => "application/x-tex"} id_X - p
            is idempotent, this is the same as saying every idempotent has a kernel.
          %h2#properties Properties
          %h3#general General
          %p
            One can show that for any idempotent
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ker
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi id
                    %mi X
                  %mo ,
                  %mi p
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Ker(id_X, p)
            is representable if and only if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Coker
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi id
                    %mi X
                  %mo ,
                  %mi p
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Coker(id_X, p)
            is, and that in fact their representing objects are canonically isomorphic.
          %p
            Recall that one says
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            %strong
              %a.existingWikiWord{:href => "/nlab/show/split+idempotent"} splits
            if there exists an object
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f : X \to Y
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %mi Y
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} g : Y \to X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ∘
                  %mi g
                  %mo =
                  %msub
                    %mi id
                    %mi Y
                %annotation{:encoding => "application/x-tex"} f \circ g = id_Y
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ∘
                    %mi f
                    %mo =
                    %mi p
                  %annotation{:encoding => "application/x-tex"} g \circ f = p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            admits an image
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Φ
                    %mi Y
                %annotation{:encoding => "application/x-tex"} \Phi_Y
            for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            between the image of the functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\ast)
            and
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Hom
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi K
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Hom(Y, K)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi X
                  %mo →
                  %mi K
                %annotation{:encoding => "application/x-tex"} f : X \to K
            the morphism corresponding to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            via
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Φ
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \Phi_X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo :
                  %mi K
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} g : K \to X
            the morphism corresponding to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi id
                    %mi K
                  %mo ∈
                  %mi Hom
                  %mo{:stretchy => "false"} (
                  %mi K
                  %mo ,
                  %mi K
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} id_K \in Hom(K, K)
            via
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Φ
                      %mi K
                  %annotation{:encoding => "application/x-tex"} \Phi_K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            splits via a pair
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (f, g)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo :
                  %mi Y
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} g: Y \to X
            is a difference kernel of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi id
                      %mi X
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (id_X, p)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo =
                    %mi g
                    %mo ∘
                    %mi f
                    %mo ∘
                    %mi g
                    %mo =
                    %mi p
                    %mo ∘
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g = g \circ f \circ g = p \circ g
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %mo :
                  %mi Z
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} h: Z \to X
            satisfies
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo =
                    %mi p
                    %mo ∘
                    %mi h
                    %mo =
                    %mi g
                    %mo ∘
                    %mi f
                    %mo ∘
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h = p \circ h = g \circ f \circ h
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                %annotation{:encoding => "application/x-tex"} h
            clearly factors through
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            are monomorphisms.
          %h3#karoubi_envelope Karoubi envelope
          %p
            There is a
            %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} universal functor
            from the category of (say, small)
            %a.existingWikiWord{:href => "/nlab/show/preadditive+categories"} preadditive categories
            to the category of Karoubian categories, the
            = succeed ";" do
              %strong
                %a.existingWikiWord{:href => "/nlab/show/Karoubinization+functor"} Karoubinization functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is also called the
            %strong
              %a.existingWikiWord{:href => "/nlab/show/Karoubian+envelope"} Karoubian envelope
            or the
            %strong
              %a.existingWikiWord{:href => "/nlab/show/pseudo-abelian+completion"} pseudo-abelian completion
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %p
            In more detail, there exists a Karoubian category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi kar
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} kar(C)
            associated to any category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi φ
                    %mo :
                    %mi C
                    %mo →
                    %mi kar
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \varphi : C \to kar(C)
            %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal
            in the sense that for any Karoubian category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} C'
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mi Hom
                    %mo ̲
                  %mo{:stretchy => "false"} (
                  %mi kar
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi C
                  %mo ′
                  %mo{:stretchy => "false"} )
                  %mo →
                  %munder
                    %mi Hom
                    %mo ̲
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mi C
                  %mo ′
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \underline{Hom}(kar(C), C') \to \underline{Hom}(C, C')
          %p
            taking a functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi kar
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi C
                  %mo ′
                %annotation{:encoding => "application/x-tex"} F : kar(C) \to C'
            to the composite
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo ∘
                  %mi φ
                %annotation{:encoding => "application/x-tex"} F \circ \varphi
            is an
            %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence
            of categories.
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi kar
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} kar(C)
            is called the
            %strong
              %a.existingWikiWord{:href => "/nlab/show/Karoubi+envelope"} Karoubi envelope
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            (aka the
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Cauchy+completion"} Cauchy completion
            = succeed ")." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/idempotent-splitting+completion"} idempotent-splitting completion
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X, p)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            idempotent, and as morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo ,
                  %mi q
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X, p) \to (Y, q)
            the morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f : X \to Y
            that satisfy
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo =
                    %mi q
                    %mo ∘
                    %mi f
                    %mo ∘
                    %mi p
                  %annotation{:encoding => "application/x-tex"} f = q \circ f \circ p
          %h2#examples Examples
          %p
            The requirement that, say, a
            %a.existingWikiWord{:href => "/nlab/show/dg-category"} dg-category
            or a
            %a.existingWikiWord{:href => "/nlab/show/triangulated+category"} triangulated category
            be Karoubian is a natural requirement in a number of contexts.
          %p
            The Karoubian envelope is also used in the construction of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/category+of+pure+motives"} category of pure motives
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/K-theory"} K-theory
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Karoubi+envelope"} Karoubi envelope
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/semi-abelian+category"} semi-abelian category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/quasi-abelian+category"} quasi-abelian category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian category
          %h2#references References
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Alexandre+Grothendieck"}> Alexandre Grothendieck
                ,
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Jean-Louis+Verdier"} Jean-Louis Verdier
                = succeed "," do
                  %em Topos
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/SGA+4"} SGA 4
            %li#Karoubi78
              %p
                %a.existingWikiWord{:href => "/nlab/show/Max+Karoubi"}> Max Karoubi
                , Ch. I, Def. 6.7 of:
                = succeed "," do
                  %em K-Theory – An introduction
                = succeed "," do
                  %strong 226
                = succeed "," do
                  %a{:href => "https://webusers.imj-prg.fr/~max.karoubi/K.book/MK.book.pdf"} pdf
                = succeed "&rbrack;" do
                  %a{:href => "https://link.springer.com/book/10.1007%2F978-3-540-79890-3"} doi:10.1007%2F978-3-540-79890-3
              %blockquote
                %p
                  (in the context of
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"} topological K-theory
                  = succeed ")" do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/Karoubi+envelope"} Karoubi envelope
          %p The terminology “Karoubian category” is used for instance in:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bruno+Kahn"}> Bruno Kahn
                , Appendix A.1 of:
                = succeed "," do
                  %em Zeta and L-Functions of Varieties and Motives
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1017/9781108691536"} doi:10.1017/9781108691536
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Stacks+Project"}> Stacks Project
                ,
                = succeed "&lbrack;" do
                  %em Karoubian categories
                = succeed "&rbrack;" do
                  %a{:href => "https://stacks.math.columbia.edu/tag/09SF"} tag:09SF
