          %h2#idea Idea
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/set-level+foundations"} set-level foundations
            %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            of a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            for sameness: by
            %a.existingWikiWord{:href => "/nlab/show/equality"} equality
            or by
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            %a.existingWikiWord{:href => "/nlab/show/principle+of+equivalence"} principle of equivalence
            argues that isomorphism is the “correct” notion of “sameness” for objects of a category, but the notion of equality is still present to be ignored.
          %p
            Note that even in a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/skeletal+category"} skeletal category
            %em property
            of “being isomorphic” coincides with the property of “being equal”, one cannot collapse the notions of isomorphism and equality because an object can still be isomorphic to itself in more than one way. This distinction only disappears in a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/gaunt+category"} gaunt category
          %p
            By contrast, in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/higher+foundations"} higher foundations
            %em univalent
            or
            = succeed "." do
              %em saturated
            %a.existingWikiWord{:href => "/nlab/show/preordered+set"} preordered set
            (a.k.a. a
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/%280%2C1%29-category"} (0,1)-category
            %a.existingWikiWord{:href => "/nlab/show/partially+ordered+set"} partially ordered set
            (a.k.a. a skeletal or gaunt (0,1)-category).
          %p
            Since we are talking about
            %a.existingWikiWord{:href => "/nlab/show/1-categories"} 1-categories
            whose hom-types are
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/h-sets"} h-sets
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/1-type"} 1-type
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/precategory"} precategory
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/h-level"} h-level
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/strict+category"} strict category
          %h2#definition Definition
          %p
            We work in a
            %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            with some notion of
            %a.existingWikiWord{:href => "/nlab/show/identity+type"} identity type
            or
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/path+type"} path type
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo =
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a=b
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is a
            %a.existingWikiWord{:href => "/nlab/show/precategory"} precategory
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ,
                    %mi b
                    %mo :
                    %mi ob
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} a,b:ob(A)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ≅
                  %mi b
                %annotation{:encoding => "application/x-tex"} a\cong b
            for the type of isomorphisms from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
          %p
          .num_lemma
            %h6 Lemma
            %p There is a map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi idtoiso
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo =
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ≅
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} idtoiso : (a=b) \to (a \cong b)
            %p
          .proof
            %h6 Proof
            %p
              By induction on identity, we may assume
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
              are the same. But then we have
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mn 1
                        %mi a
                      %mo :
                      %msub
                        %mi hom
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi a
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} 1_a:hom_A(a,a)
          %p
          .num_defn
            %h6 Definition
            %p
              A
              %strong univalent category
              or
              %strong saturated category
              is a precategory which is
              = succeed "," do
                %em Rezk complete
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi idtoiso
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo =
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ≅
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} idtoiso : (a=b) \to (a \cong b)
            %p an equivalence of types.
          %h3#in_simplicial_type_theory In simplicial type theory
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+type+theory"} simplicial type theory
            = succeed "," do
              %strong Rezk complete category
            = succeed "," do
              %strong univalent category
            %strong saturated category
            is a
            %a.existingWikiWord{:href => "/nlab/show/complete+Segal+type"} complete Segal type
            in which all
            %a.existingWikiWord{:href => "/nlab/show/hom-types"} hom-types
            are
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/sets"} sets
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} isUniCat
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mi{:mathvariant => "normal"} isCompleteSegal
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi y
                      %mo :
                      %mi A
                  %mi{:mathvariant => "normal"} isSet
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi{:mathvariant => "normal"} hom
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{isUniCat}(A) \coloneqq \mathrm{isCompleteSegal}(A) \times \prod_{x:A} \prod_{y:A} \mathrm{isSet}(\mathrm{hom}_A(x, y))
          %h2#comparing_notions_of_category Comparing notions of category
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
          %ol
            %li
              Most naturally occurring precategories are in fact univalent categories, such as the category
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              and most categories of structured objects built from it such as
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Grp"} Grp
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ring"} Ring
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Vect"} Vect
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Mod"} Mod
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Met"} Met
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/StrCat"} StrCat
            %li
              Furthermore,
              %em every
              precategory is
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} weakly equivalent
              to a univalent category (its
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/Rezk+completion"} Rezk completion
            %li
              The theory of univalent categories is abstractly nicer than that of either precategories or strict categories. For instance, the statement “a fully faithful and essentially surjective functor is an equivalence” for strict categories is equivalent to the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
              %a.existingWikiWord{:href => "/nlab/show/split+essentially+surjective+functors"} split essentially surjective functors
              instead of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/essentially+surjective+functors"} essentially surjective functors
            %li
              Under the semantics of HoTT/UF in
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-toposes"} (infinity,1)-toposes
              %a.existingWikiWord{:href => "/nlab/show/stacks"} stacks
              of 1-categories. (See
              %a.existingWikiWord{:href => "/nlab/show/relation+between+type+theory+and+category+theory"} relation between type theory and category theory
              and
              = succeed ".)" do
                %a.existingWikiWord{:href => "/nlab/show/category+object+in+an+%28infinity%2C1%29-category"} category object in an (infinity,1)-category
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGpd"} ∞Gpd
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/complete+Segal+spaces"} complete Segal spaces
              %a.existingWikiWord{:href => "/nlab/show/Segal+categories"} Segal categories
              and precategories are interpreted by 1-truncated
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Segal+spaces"} Segal spaces
          %p
            For these reasons, some of the HoTT/UF literature (including the
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/HoTT+Book"} HoTT Book
          %p
            The situation in plain
            %a.existingWikiWord{:href => "/nlab/show/intensional+type+theory"} intensional type theory
            is less clear, since without the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/univalence+axiom"} univalence axiom
          %p
            (To be completely precise, the notion of “univalent category” can also be defined in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/set-level+foundations"} set-level foundations
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/gaunt+category"} gaunt category
            %a.existingWikiWord{:href => "/nlab/show/strict+category"} strict category
            is univalent if and only if it is gaunt.)
          %p On this page we will not use the plain term “category” at all, but speak only of “precategories”, “univalent categories”, and “strict categories”.
          %p
          .num_remark
            %h6 Remark
            %p Most nLab pages about category theory are, and should remain, written in a fairly foundation-agnostic way. If the reader is interpreting them in HoTT/UF, it is usually best to read “category” as meaning “univalent category” for the reasons above. However, in many cases it is also possible to read it as meaning “precategory” or “strict category”, as would be necessary if interpreting them in plain intensional type theory.
            %p
              It is not usually necessary for pages about ordinary category theory to remark on this issue at all. However, if there are subtleties regarding the choice of interpretation (e.g. if some construction, such as a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Kleisli+category"} Kleisli category
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/dagger+category"} dagger category
          %h2#examples Examples
          %p
            Note: All categories given can become univalent via the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Rezk+completion"} Rezk completion
          %ul
            %li
              %p
                As noted above, every
                %a.existingWikiWord{:href => "/nlab/show/gaunt+category"} gaunt category
                is a
                %a.existingWikiWord{:href => "/nlab/show/strict+category"} strict
                univalent category, or equivalently a
                %a.existingWikiWord{:href => "/nlab/show/skeletal+category"} skeletal
                univalent category.
            %li
              %p
                There is a precategory
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Set"} Set
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Set
                      %annotation{:encoding => "application/x-tex"} Set
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi hom
                          %mi Set
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo ,
                        %mi B
                        %mo{:stretchy => "false"} )
                        %mo ≡
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo →
                        %mi B
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} hom_{Set}(A,B)\equiv (A \to B)
                %a.existingWikiWord{:href => "/nlab/show/univalence+axiom"} univalence axiom
                implies that this is a univalent category. One can also show from this that any precategory of set-level structures such as groups, rings topological spaces, etc. is also univalent.
            %li
              %p
                For any
                %a.existingWikiWord{:href => "/nlab/show/1-type"} 1-type
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                as its type of objects and with
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi hom
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mo ≡
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo =
                        %mi y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} hom(x,y)\equiv(x=y)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                is a set we call this the
                %strong discrete category
                on
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                = succeed "." do
                  %strong (univalent) groupoid
            %li
              %p
                More generally, or any type
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                as its type of objects and with
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi hom
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mo ≡
                        %mo{:stretchy => "false"} ‖
                        %mi x
                        %mo =
                        %mi y
                        %msub
                          %mo{:stretchy => "false"} ‖
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} hom(x,y)\equiv \| x= y \|_0
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mi y
                      %mo =
                      %mi z
                      %msub
                        %mo{:stretchy => "false"} ‖
                        %mn 0
                      %mo →
                      %mo{:stretchy => "false"} ‖
                      %mi x
                      %mo =
                      %mi y
                      %msub
                        %mo{:stretchy => "false"} ‖
                        %mn 0
                      %mo →
                      %mo{:stretchy => "false"} ‖
                      %mi y
                      %mo =
                      %mi z
                      %msub
                        %mo{:stretchy => "false"} ‖
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} \|y=z\|_0 \to \|x=y\|_0 \to \|y=z\|_0
              %p
                is defined by induction on
                %a.existingWikiWord{:href => "/nlab/show/truncation"} truncation
                from concatenation of the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/identity+type"} identity type
                %strong fundamental pregroupoid
                of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                is a 1-type; its Rezk completion is the
                %strong fundamental (univalent) groupoid
                of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
            %li
              %p
                There is a precategory whose type of objects is the
                %a.existingWikiWord{:href => "/nlab/show/type+universe"} type universe
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒰
                    %annotation{:encoding => "application/x-tex"} \mathcal{U}
                and with
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi hom
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi Y
                        %mo{:stretchy => "false"} )
                        %mo ≡
                        %mo{:stretchy => "false"} ‖
                        %mi X
                        %mo →
                        %mi Y
                        %msub
                          %mo{:stretchy => "false"} ‖
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} hom(X,Y)\equiv \| X \to Y\|_0
                = succeed ";" do
                  %strong homotopy precategory of types
                %a.existingWikiWord{:href => "/nlab/show/Set"} Set
                as a sub-precategory).
          %h2#properties Properties
          %p
          .num_theorem
            %h6 Theorem
            %p
              Given two categories
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              is univalent, then the functor category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi B
                      %mi A
                  %annotation{:encoding => "application/x-tex"} B^A
              is univalent.
          %p
          .proof
            %h6 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} F:A \to B
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} G:A \to B
              be functors from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
