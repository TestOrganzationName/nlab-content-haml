                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
            %p
              Suppose that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo :
                    %mi F
                    %mo →
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \gamma:F \to G
              is a natural isomorphism. Then for any object
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo :
                      %mi Ob
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
