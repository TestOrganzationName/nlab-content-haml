                %a{:href => "#references"} References:
          %h2#idea Idea
          %p
            An
            %em observational monad
            is a
            %a.existingWikiWord{:href => "/nlab/show/monad"} monad
            where, intuitively, one can distinguish two monadic (for example probabilistic) values by means of taking repeated independent observations.
          %p
            It is of particular importance in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/categorical+probability"} categorical probability
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/iid+random+variables"} iid random variables
          %h2#definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            with
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/products"} products
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            be a symmetric
            %a.existingWikiWord{:href => "/nlab/show/monoidal+monad"} monoidal monad
            (or
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/commutative+monad"} commutative monad
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %p
            Denote also by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mi T
                %annotation{:encoding => "application/x-tex"} C_T
            its
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Kleisli+category"} Kleisli category
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/copy-discard+category"} copy-discard category
            %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo :
                  %mi C
                  %mo →
                  %msub
                    %mi C
                    %mi T
                  %mo ,
                  %mi R
                  %mo :
                  %msub
                    %mi C
                    %mi T
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} L:C\to C_T, R:C_T\to C
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo =
                    %mi R
                    %mo ∘
                    %mi L
                  %annotation{:encoding => "application/x-tex"} P=R\circ L
          %p
            Denote the
            %a.existingWikiWord{:href => "/nlab/show/comonad"} comonad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo ∘
                  %mi R
                %annotation{:encoding => "application/x-tex"} L\circ R
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mi T
                %annotation{:encoding => "application/x-tex"} C_T
            again by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mi T
                %annotation{:encoding => "application/x-tex"} C_T
            with a
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/thunk-force+category"} thunk-force structure
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ε
                    %mi X
                  %mo :
                  %mi P
                  %mi X
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} \varepsilon_X:P X\to X
            the components of the
            %a.existingWikiWord{:href => "/nlab/show/counit"} counit
            of the adjunction. (In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/categorical+probability"} categorical probability
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/sampling+map"} sampling map
          %p
            The monad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            is called
            %strong observational
            if and only if for every object
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mi T
                %annotation{:encoding => "application/x-tex"} C_T
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} {
                  %mi P
                  %mi X
                  %mover
                    %mo →
                    %mrow
                      %mspace{:width => "1em"}
                      %mi{:mathvariant => "normal"} copy
                      %mspace{:width => "1em"}
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mi X
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo ⊗
                      %mi n
                  %mover
                    %mo →
                    %mrow
                      %mspace{:width => "1em"}
                      %msup
                        %mi ε
                        %mrow
                          %mo ⊗
                          %mi n
                      %mspace{:width => "1em"}
                  %msup
                    %mi X
                    %mrow
                      %mo ⊗
                      %mi n
                  %mspace{:width => "thickmathspace"}
                  %mo ,
                  %mspace{:width => "thickmathspace"}
                  %mi n
                  %mo ∈
                  %mi ℕ
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} }
                %annotation{:encoding => "application/x-tex"}
                  \\Big\{ P X \xrightarrow{\quad\mathrm{copy}\quad} (P X)^{\otimes n} \xrightarrow{\quad\varepsilon^{\otimes n}\quad} X^{\otimes n}\;,\; n \in \mathbb{N} \Big\}
          %p
            is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/jointly+monic"} jointly monic
          %p
            The intuition is that one can distinguish two morphisms (for example, states) into
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mi X
                %annotation{:encoding => "application/x-tex"} P X
            by sampling independently as many times as needed.
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/Markov+category#representable_markov_categories"} representable Markov category
            whose
            %a.existingWikiWord{:href => "/nlab/show/probability+monad"} probability monad
            is observational is called an
            = succeed "." do
              %strong observationally representable Markov category
          %h2#properties Properties
          %ul
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/Giry+monad"} Giry monad
                is observational thanks to the
                %span.newWikiWord
                  pi-lambda theorem
                  %a{:href => "/nlab/new/pi-lambda+theorem"} ?
                or, equivalently, the
                = succeed "." do
                  %span.newWikiWord
                    monotone class theorem
                    %a{:href => "/nlab/new/monotone+class+theorem"} ?
                = succeed ")" do
                  %a{:href => "#det_submonad"} Moss-Perrone’22
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/Kleisli+category"} Kleisli category
                of an observational monad, with its canonical
                %a.existingWikiWord{:href => "/nlab/show/copy-discard+category"} copy-discard
                and
                %a.existingWikiWord{:href => "/nlab/show/thunk-force+category"} thunk-force
                structures, is such that every
                %a.existingWikiWord{:href => "/nlab/show/Markov+category#deterministic_morphisms"} deterministic morphism
                is thunkable (the converse is always true). (
                %a{:href => "#det_submonad"}> Moss-Perrone’22
                )
            %li
              %p
                Every observationally representable Markov category is necessarily
                = succeed "." do
                  %em almost-surely-compatibly representable
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi X
                      %mover
                        %mo →
                        %mspace{:width => "2em"}
                      %mi Y
                      %mspace{:width => "2em"}
                      %mo ↔
                      %mspace{:width => "2em"}
                      %msup
                        %mi f
                        %mo ♯
                      %mo :
                      %mi X
                      %mover
                        %mo →
                        %mrow
                          %mspace{:width => "thickmathspace"}
                          %mo{:stretchy => "false"} (
                          %mi det
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thickmathspace"}
                      %mi P
                      %mi Y
                    %annotation{:encoding => "application/x-tex"}
                      f:X\xrightarrow{\qquad} Y \qquad\leftrightarrow\qquad f^\sharp:X \xrightarrow{\;(det)\;} P Y
              %p
                we have that for every state (probability measure)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
                on
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ,
                      %mi g
                      %mo :
                      %mi X
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} f,g:X\to Y
                are
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
                %span.newWikiWord
                  almost surely equal
                  %a{:href => "/nlab/new/almost+surely+equal"} ?
                if and only if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mo ♯
                    %annotation{:encoding => "application/x-tex"} f^\sharp
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi g
                        %mo ♯
                    %annotation{:encoding => "application/x-tex"} g^\sharp
                are. (
                %a{:href => "#supports"}> FGLPS
                )
            %li
              %p
                Observationality is related to
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/de+Finetti%27s+theorem"} de Finetti's theorem
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/limit"} limit
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
                %a.existingWikiWord{:href => "/nlab/show/Kolmogorov+products"} Kolmogorov products
                exist. (
                %a{:href => "#det_submonad"}> Moss-Perrone’22
                )
