          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#definition"} Definition
              %li
                %a{:href => "#related_concepts"} Related concepts
              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            structure on the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %a.existingWikiWord{:href => "/nlab/show/Operad"} Operad
            of
            = succeed "-enriched" do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            %a.existingWikiWord{:href => "/nlab/show/symmetric+operads"} symmetric operads
            which generalizes the
            %a.existingWikiWord{:href => "/nlab/show/canonical+model+structure"} canonical model structure
            on
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
          %h2#definition Definition
          .num_defn
            %h6#definition_2 Definition
            %p
              Call a
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              of
              %a.existingWikiWord{:href => "/nlab/show/operads"} operads
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi P
                    %mo →
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} f : P \to Q
              a
              %strong
                %a.existingWikiWord{:href => "/nlab/show/weak+equivalence"} weak equivalence
              if
            %ol
              %li
                %p
                  its underlying
                  %a.existingWikiWord{:href => "/nlab/show/functor"} functor
                  of
                  %a.existingWikiWord{:href => "/nlab/show/categories"} categories
                  is an
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/essentially+surjective+functor"} essentially surjective functor
              %li
                %p
                  for every collection
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi c
                          %mn 1
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %msub
                          %mi c
                          %mi n
                        %mo ;
                        %mi c
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (c_1, \cdots, c_n; c)
                  of colours it induces an
                  %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi P
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi c
                          %mn 1
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %msub
                          %mi c
                          %mi n
                        %mo ;
                        %mi c
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi Q
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi c
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %mi f
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi c
                          %mi n
                        %mo{:stretchy => "false"} )
                        %mo ;
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        P(c_1, \cdots, c_n; c) \to Q(f(c_1), \cdots, f(c_n); f(c))
                %p
                  (the operadic analog of being
                  = succeed ")." do
                    %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+functor"} full and faithful
            %p
              Call a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi P
                    %mo →
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} f : P \to Q
              a
              %strong fibration
              if for every
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
              and a lift of its source object to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              there is an isomorphism in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              covering it under
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
            %p
              Call a morphism a
              %strong cofibration
              if it is an injection on objects (on colours)
          .num_theorem
            %h6#theorem Theorem
            %p
              This defines a
              %a.existingWikiWord{:href => "/nlab/show/cofibrantly+generated+model+category"} cofibrantly generated model category
              structure on
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Operad"} Operad
          %p
            This is due to (
            %a{:href => "#Weiss"}> Weiss 07
            ).
