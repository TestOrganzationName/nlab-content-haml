                      %mo :
                      %mi C
                      %mo →
                      %msub
                        %mi Span
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \eta_C: C \rightarrow Span_2(C)
                for the functor given by:
