          %h2#definition Definition
          %h3#in_set_theory In set theory
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/set+theory"} set theory
            %strong span
            or
            %strong correspondence
            between
            %a.existingWikiWord{:href => "/nlab/show/sets"} sets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            is a set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            with a
            %a.existingWikiWord{:href => "/nlab/show/function"} function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo :
                  %mi C
                  %mo →
                  %mi A
                  %mo ×
                  %mi B
                %annotation{:encoding => "application/x-tex"} R:C \to A \times B
            to the
            %a.existingWikiWord{:href => "/nlab/show/product+set"} product set
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ×
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A \times B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            itself is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/directed+pseudograph"} directed pseudograph
            %a.existingWikiWord{:href => "/nlab/show/categories"} categories
            in set theory.
          %h3#in_category_theory In category theory
          %p
            In any
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed "," do
              %strong span
            = succeed "," do
              %strong roof
            = succeed "," do
              %strong correspondence
            %a.existingWikiWord{:href => "/nlab/show/object"} object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            to an object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                %annotation{:encoding => "application/x-tex"} y
            is a
            %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi s
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mi f
                          %mo ↙
                        %mtd
                        %mtd
                          %msup
                            %mo ↘
                            %mi g
                      %mtr
                        %mtd
                          %mi x
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mi y
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; s
                  \\\
                  \&amp; {}^{f}\swarrow
                  \&amp;&amp; \searrow^{g}
                  \\\
                  x
                  \&amp;&amp;&amp;&amp;
                  y
                  }
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                %annotation{:encoding => "application/x-tex"} s
            is some other object of the category. (The word “correspondence” is also sometimes used for a
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/profunctor"} profunctor
          %p
            This
            %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
            is also called a ‘span’ because it looks like a little bridge; ‘roof’ is similar. The term ‘correspondence’ is prevalent in geometry and related areas; it comes about because a correspondence is a generalisation of a binary
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/relation"} relation
          %p
            Note that a span with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} f = 1
            is just a morphism from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} g = 1
            is a morphism from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                %annotation{:encoding => "application/x-tex"} y
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
          %p
            A span in the
            %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mi op
                %annotation{:encoding => "application/x-tex"} C^op
            is called a
            %a.existingWikiWord{:href => "/nlab/show/co-span"} co-span
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %p
            A span that has a
            %a.existingWikiWord{:href => "/nlab/show/cocone"} cocone
            is called a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/coquadrable+span"} coquadrable span
          %h3#in_dependent_type_theory In dependent type theory
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            = succeed "," do
              %em span
            = succeed "," do
              %em multivalued partial function
            = succeed ":" do
              %em correspondence
          %ul
            %li
              %p
                A
                %strong span
                between types
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
                is a type
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                with families of elements
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo :
                      %mi C
                      %mo ⊢
                      %mi g
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi A
                    %annotation{:encoding => "application/x-tex"} x:C \vdash g(x):A
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo :
                      %mi C
                      %mo ⊢
                      %mi h
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi B
                    %annotation{:encoding => "application/x-tex"} x:C \vdash h(x):B
            %li
              %p
                A
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/multivalued+partial+function"} multivalued partial function
                from type
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                to type
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
                is a type family
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                      %mo ⊢
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} x:A \vdash P(x)
                with a family of elements
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                      %mo ,
                      %mi p
                      %mo :
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ⊢
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi B
                    %annotation{:encoding => "application/x-tex"} x:A, p:P(x) \vdash f(x, p):B
            %li
              %p
                A
                %strong correspondence
                between types
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
                is a type family
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo :
                        %mi A
                        %mo ,
                        %mi y
                        %mo :
                        %mi B
                        %mo ⊢
                        %mi R
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} x:A, y:B \vdash R(x, y)
          %p
            However, from any one of the above structures, one could get the other two structures, provided one has
            %a.existingWikiWord{:href => "/nlab/show/identity+types"} identity types
            and
            %a.existingWikiWord{:href => "/nlab/show/dependent+pair+types"} dependent pair types
            in the dependent type theory. Given a type family
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi A
                    %mo ⊢
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x:A \vdash P(x)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
