          %h2#the_walking_span The walking span
          %p
            The
            %strong
              %a.existingWikiWord{:href => "/nlab/show/walking"} walking
              %a.existingWikiWord{:href => "/nlab/show/span"} span
            or
            %strong
              walking
              %a.existingWikiWord{:href => "/nlab/show/correspondence"} correspondence
            or
            %strong
              (2,2)-
              %a.existingWikiWord{:href => "/nlab/show/horn"} horn
              category
            is the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Λ
                    %mn 2
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \Lambda_2^2
            which consists of three objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo ,
                  %mn 2
                  %mo ∈
                  %msubsup
                    %mi Λ
                    %mn 2
                    %mn 2
                %annotation{:encoding => "application/x-tex"} 0, 1, 2 \in \Lambda_2^2
            and two morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi h
                    %mn 01
                  %mo :
                  %msub
                    %mi{:mathvariant => "normal"} hom
                    %mrow
                      %msubsup
                        %mi Λ
                        %mn 2
                        %mn 2
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} h_{01}:\mathrm{hom}_{\Lambda_2^2}(0, 1)
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi h
                      %mn 02
                    %mo :
                    %msub
                      %mi{:mathvariant => "normal"} hom
                      %mrow
                        %msubsup
                          %mi Λ
                          %mn 2
                          %mn 2
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} h_{02}:\mathrm{hom}_{\Lambda_2^2}(0, 2)
          %p
            The category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Λ
                    %mn 2
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \Lambda_2^2
            is also called the
            %strong (2,2)-horn preorder
            or the
            %strong (2,2)-horn poset
            because
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Λ
                    %mn 2
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \Lambda_2^2
            can be shown to be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/poset"} poset
          %p
            Every span in a category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is represented by a
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %msubsup
                    %mi Λ
                    %mn 2
                    %mn 2
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} F:\Lambda_2^2 \to C
            from the walking span to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %p
            In type theoretic approaches to synthetic
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %strong
              (2,2)-
              %a.existingWikiWord{:href => "/nlab/show/horn"} horn
              type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Λ
                    %mn 2
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \Lambda_2^2
            defined above plays the role of the walking span.
          %h2#properties Properties
          %h3#RelationToRelations Relation to relations
          %p
            Correspondences may be seen as generalizations of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/relations"} relations
            %a.existingWikiWord{:href => "/nlab/show/correspondence"} correspondence
            which is
            %a.existingWikiWord{:href => "/nlab/show/%28-1%29-truncated"} (-1)-truncated
            as a
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            into the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cartesian+product"} cartesian product
            %em
              %a.existingWikiWord{:href => "/nlab/show/relation"} relation
            and at
            %em
              %a.existingWikiWord{:href => "/nlab/show/Rel"} Rel
            for more on this.
          %h3#left_quotients Left quotients
          %p
            Following the notion of a left
            %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
            of two elements in a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            the notion of a
            %em left quotient
            of a span in a category.
          %p
            A
            %strong left quotient
            of a span
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %msub
                    %mi{:mathvariant => "normal"} hom
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f:\mathrm{hom}_A(x, y)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %mo :
                  %msub
                    %mi{:mathvariant => "normal"} hom
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi z
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} h:\mathrm{hom}_A(x, z)
            is a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo :
                  %msub
                    %mi{:mathvariant => "normal"} hom
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo ,
                  %mi z
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} g:\mathrm{hom}_A(y, z)
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                %annotation{:encoding => "application/x-tex"} h
            is the
            %a.existingWikiWord{:href => "/nlab/show/unique+composite"} unique composite
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ∘
                    %mi f
                    %mo =
                    %mi h
                  %annotation{:encoding => "application/x-tex"} g \circ f = h
          %p
            Given a morphism
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %msub
                      %mi{:mathvariant => "normal"} hom
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f:\mathrm{hom}_A(x, y)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi{:mathvariant => "normal"} id
                    %mi x
                  %mo ,
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathrm{id}_x, f)
            is always left divisible with left quotient
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
            %a.existingWikiWord{:href => "/nlab/show/retraction"} retraction
            is a left quotient of the span
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %msub
                      %mi{:mathvariant => "normal"} id
                      %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (f, \mathrm{id}_x)
          %h2#the_bicategory_of_spans The bicategory of spans
          %p
            If the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            has
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullbacks
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
