                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mi g
                %annotation{:encoding => "application/x-tex"} g \mapsto e^{-1/g}
            vanish at
            %a.existingWikiWord{:href => "/nlab/show/coupling+constant"} coupling constant
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo =
