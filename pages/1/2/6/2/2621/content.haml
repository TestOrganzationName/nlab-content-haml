                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %msup
                    %mi g
                    %mi n
                  %mo +
                  %mi 𝒪
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi e
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 2
                      %mi A
                      %mo{:stretchy => "false"} /
                      %mi g
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  Z(g)
                  \=
                  \\sum_n a_n g^n
                  +
                  e^{-A/g}
                  \\sum_n a_n^{(1)} g^n
                  +
                  \\mathcal{O}(e^{-2A/g})
                  \\,,
          %p
            where the first sum is the
            %a.existingWikiWord{:href => "/nlab/show/perturbation+series"} perturbation series
            itself and where the terms with a prefactor of the form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
