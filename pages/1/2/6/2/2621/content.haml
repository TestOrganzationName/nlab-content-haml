                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi z
                  %mo +
                  %mfrac
                    %mi d
                    %mi dz
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} V = (z + \frac{d}{dz})
            and choose
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                  %mo =
                  %mfrac
                    %mn 1
                    %msqrt
                      %mn 2
                %annotation{:encoding => "application/x-tex"} \lambda = \frac{1}{\sqrt{2}}
            so that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                  %mi V
                  %mo =
                  %mi p
                  %mo .
                %annotation{:encoding => "application/x-tex"} \lambda V = p.
            When
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            acts on a state
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ψ
                  %mo =
                  %msup
