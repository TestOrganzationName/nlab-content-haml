          %h2#details Details
          %h3#in_quantum_mechanics In quantum mechanics
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/quantum+states"} quantum states
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mi ψ
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo{:stretchy => "false"} ⟩
                    %mi I
                %annotation{:encoding => "application/x-tex"} \vert \psi(t)\rangle_I
            in the
            %a.existingWikiWord{:href => "/nlab/show/interaction+picture"} interaction picture
            of
            %a.existingWikiWord{:href => "/nlab/show/quantum+mechanics"} quantum mechanics
            are by definition (
            %a{:href => "Dirac+interaction+picture#eq:StateInTheInteractionPicture"}> this equation
            ) related to the asymptotic free states
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mi ψ
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} \vert\psi\rangle
            by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mi ψ
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo{:stretchy => "false"} ⟩
                    %mi I
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mi exp
                  %mrow
                    %mo (
                    %mrow
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi t
                          %mrow
                            %mi i
                            %mi ℏ
                      %msub
                        %mi H
                        %mi free
                    %mo )
                  %mi exp
                  %mrow
                    %mo (
                    %mrow
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mi t
                          %mrow
                            %mi i
                            %mi ℏ
                      %msub
                        %mi H
                        %mi free
                      %mo +
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mi t
                          %mrow
                            %mi i
                            %mi ℏ
                      %mi V
                    %mo )
                  %mo{:stretchy => "false"} |
                  %mi ψ
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"}
                  \\vert \psi(t)\rangle_I
                  \\;=\;
                  \\exp\left({\tfrac{- t}{i \hbar} H_{free}}\right)
                  \\exp\left({\tfrac{t}{i \hbar} H_{free} + \tfrac{t}{i \hbar} V} \right)
                  \\vert \psi \rangle
          %p and conversely
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mi ψ
                  %mo{:stretchy => "false"} ⟩
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %munder
                    %mrow
                      %mi exp
                      %mrow
                        %mo (
                        %mrow
                          %mstyle{:displaystyle => "false"}
                            %mfrac
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi t
                              %mrow
                                %mi i
                                %mi ℏ
                          %msub
                            %mi H
                            %mi free
                          %mo +
                          %mstyle{:displaystyle => "false"}
                            %mfrac
                              %mi t
                              %mrow
                                %mi i
                                %mi ℏ
                          %mi V
                        %mo )
                      %mi exp
                      %mrow
                        %mo (
                        %mrow
                          %mstyle{:displaystyle => "false"}
                            %mfrac
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                                %mi t
                              %mrow
                                %mi i
                                %mi ℏ
                          %msub
                            %mi H
                            %mi free
                        %mo )
                    %mo ⏟
                  %mo{:stretchy => "false"} |
                  %mi ψ
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo{:stretchy => "false"} ⟩
                    %mi I
                %annotation{:encoding => "application/x-tex"}
                  \\vert \psi \rangle
                  \\;=\;
                  \\underbrace{
                  \\exp\left({\tfrac{- t}{i \hbar} H_{free} + \tfrac{t}{i \hbar} V} \right)
                  \\exp\left({\tfrac{+ t}{i \hbar} H_{free}}\right)
                  }
                  \\vert \psi(t)\rangle_I
          %p
            the suitable
            %a.existingWikiWord{:href => "/nlab/show/limit+of+a+sequence"} limit
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo →
                  %mo ∓
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} t \to \mp \infty
            of the operator under the brace is called the
            %em Møller operator
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                  %mo ±
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %munder
                    %mi lim
                    %mrow
                      %mi t
                      %mo →
                      %mo ∓
                      %mn ∞
                  %mi exp
                  %mrow
                    %mo (
                    %mrow
                      %mstyle{:displaystyle => "false"}
                        %mfrac
