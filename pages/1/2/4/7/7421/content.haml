          %h1#volodin_space Volodin space
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#preliminaries"} Preliminaries
              %li
                %a{:href => "#volodin_spaces"} Volodin spaces
              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            %em Volodin spaces
            are the
            %a.existingWikiWord{:href => "/nlab/show/Vietoris+complex"} Vietoris complex
            analogues of the nerve of a family of subgroups discussed in the entry,
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/higher+generation+by+subgroups"} higher generation by subgroups
          %p
            They were essentially introduced by
            %a.existingWikiWord{:href => "/nlab/show/Volodin"} Volodin
            as part of his approach to higher
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+K-theory"} algebraic K-theory
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Suslin"} Suslin
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Quillen"} Quillen
          %h2#preliminaries Preliminaries
          %p
            Let
            %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_1.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            be a non-empty set, and denote by
            = succeed "," do
              %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_2.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E(X)
            %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
            having
            = succeed "," do
              %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_3.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo{:stretchy => "false"} (
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi p
                    %mo =
                    %msup
                      %mi X
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} E(X)_p = X^{p+1}
            = succeed "-simplex" do
              %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_4.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_5.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo +
                  %mn 1
                %annotation{:encoding => "application/x-tex"} p+1
            tuple,
            = succeed "," do
              %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_6.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi x
                      %mo ̲
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 0
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi x
                      %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \underline{x}= (x_0,\ldots, x_p)
            = succeed "," do
              %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_7.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mi i
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x_i \in X
          .maruku-equation
            %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_8.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi i
                  %mo{:stretchy => "false"} (
                  %munder
                    %mi x
                    %mo ̲
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi x
                    %mn 0
                  %mo ,
                  %mi …
                  %mo ,
                  %mover
                    %mrow
                      %msub
                        %mi x
                        %mi i
                    %mo{:stretchy => "false"} ^
                  %mo ,
                  %mi …
                  %msub
                    %mi x
                    %mi p
                  %mo{:stretchy => "false"} )
                  %mo ,
                %annotation{:encoding => "application/x-tex"} d_i(\underline{x}) = (x_0,\ldots, \hat{x_i}, \ldots x_p),
          %p
            so
            %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_9.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi i
                %annotation{:encoding => "application/x-tex"} d_i
            omits
            = succeed "," do
              %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_10.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mi i
                  %annotation{:encoding => "application/x-tex"} x_i
            %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_11.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi s
                    %mi j
                %annotation{:encoding => "application/x-tex"} s_j
            repeats
            = succeed "." do
              %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_12.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mi j
                  %annotation{:encoding => "application/x-tex"} x_j
          .un_lemma
            %h6#lemma Lemma
            %p
              The simplicial set,
              = succeed "," do
                %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_13.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} E(X)
          %p The proof is fairly easy to construct and is ‘well known’.
          %p
            The case we are really interested in is when we replace the general set,
            = succeed "," do
              %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_14.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "." do
              %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_15.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "," do
              %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_16.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_17.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            for it.) In this case, we have the simplicial set
            %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_18.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E(G)
            and the group,
            = succeed "," do
              %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_19.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_20.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E(G)
            by
          .maruku-equation
            %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_21.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo ⋅
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi g
                    %mn 0
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi g
                    %mi p
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi gg
                    %mn 0
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi gg
                    %mi p
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} g\cdot(g_0,\ldots , g_p) = (gg_0,\ldots, gg_p).
          %p
            (Here we have used a left action of
            = succeed "," do
              %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_22.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %p
            The quotient simplicial set of orbits, will be denoted
            = succeed "." do
              %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_23.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo \
                    %mi E
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G\backslash E(G)
            %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_24.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi g
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi g
                    %mi p
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [g_1,\ldots,g_p]
            for the orbit of the
            = succeed "-simplex" do
              %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_25.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed "." do
              %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_26.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %msub
                      %mi g
                      %mn 1
                    %mo ,
                    %msub
                      %mi g
                      %mn 1
                    %msub
                      %mi g
                      %mn 2
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi g
                      %mn 1
                    %msub
                      %mi g
                      %mn 2
                    %mi …
                    %msub
                      %mi g
                      %mi p
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi E
                    %mo{:stretchy => "false"} (
                    %mi G
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi p
                  %annotation{:encoding => "application/x-tex"} (1,g_1,g_1g_2,\ldots, g_1g_2\ldots g_p)\in E(G)_p
          %p
            It is ‘instructive’ to calculate the faces and degeneracy maps in this notation. We will only look at
            %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_27.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi g
                    %mn 1
                  %mo ,
                  %msub
                    %mi g
                    %mn 2
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [g_1,g_2]
            in detail. This element has representative
            = succeed "." do
              %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_28.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %msub
                      %mi g
                      %mn 1
                    %mo ,
                    %msub
                      %mi g
                      %mn 1
                    %msub
                      %mi g
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (1,g_1,g_1g_2)
          %ul
            %li
              %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_29.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %msub
                      %mi g
                      %mn 1
                    %mo ,
                    %msub
                      %mi g
                      %mn 1
                    %msub
                      %mi g
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 1
                    %mo ,
                    %msub
                      %mi g
                      %mn 1
                    %msub
                      %mi g
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %msub
                      %mi g
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} d_0(1,g_1,g_1g_2) = (g_1,g_1g_2) \equiv (1,g_2)
              , so
              = succeed ";" do
                %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_30.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mn 0
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi g
                        %mn 1
                      %mo ,
                      %msub
                        %mi g
                        %mn 2
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi g
                        %mn 2
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} d_0[g_1,g_2] = [g_2]
            %li
              %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_31.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %msub
                      %mi g
                      %mn 1
                    %mo ,
                    %msub
                      %mi g
                      %mn 1
                    %msub
                      %mi g
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %msub
                      %mi g
                      %mn 1
                    %msub
                      %mi g
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} d_1(1,g_1,g_1g_2) = (1,g_1g_2)
              , so
              = succeed ";" do
                %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_32.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mn 1
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi g
                        %mn 1
                      %mo ,
                      %msub
                        %mi g
                        %mn 2
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi g
                        %mn 1
                      %msub
                        %mi g
                        %mn 2
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} d_1[g_1,g_2] = [g_1g_2]
            %li
              %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_33.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %msub
                      %mi g
                      %mn 1
                    %mo ,
                    %msub
                      %mi g
                      %mn 1
                    %msub
                      %mi g
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %msub
                      %mi g
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} d_2(1,g_1,g_1g_2) = (1,g_1)
              ,
          %p
            so
            = succeed "." do
              %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_34.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mn 2
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi g
                      %mn 1
                    %mo ,
                    %msub
                      %mi g
                      %mn 2
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi g
                      %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} d_2[g_1,g_2] = [g_1]
          %p (That looks familiar!)
          %p For the degeneracies,
          %ul
            %li
              %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_35.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %msub
                      %mi g
                      %mn 1
                    %mo ,
                    %msub
                      %mi g
                      %mn 1
                    %msub
                      %mi g
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo ,
                    %msub
                      %mi g
                      %mn 1
                    %mo ,
                    %msub
                      %mi g
                      %mn 1
                    %msub
                      %mi g
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} s_0(1,g_1,g_1g_2) = (1,1,g_1,g_1g_2)
              , so
              = succeed ";" do
                %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_36.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi s
                        %mn 0
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi g
                        %mn 1
                      %mo ,
                      %msub
                        %mi g
                        %mn 2
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo ,
                      %msub
                        %mi g
                        %mn 1
                      %mo ,
                      %msub
                        %mi g
                        %mn 2
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} s_0 [g_1,g_2] =[1,g_1,g_2]
            %li
              %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_37.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %msub
                      %mi g
                      %mn 1
                    %mo ,
                    %msub
                      %mi g
                      %mn 1
                    %msub
                      %mi g
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %msub
                      %mi g
                      %mn 1
                    %mo ,
                    %msub
                      %mi g
                      %mn 1
                    %mo ,
                    %msub
                      %mi g
                      %mn 1
                    %msub
                      %mi g
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} s_1(1,g_1,g_1g_2) = (1,g_1,g_1,g_1g_2)
              , so
              %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_38.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mn 1
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi g
                      %mn 1
                    %mo ,
                    %msub
                      %mi g
                      %mn 2
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi g
                      %mn 1
                    %mo ,
                    %mn 1
                    %mo ,
                    %msub
                      %mi g
                      %mn 2
                    %mo{:stretchy => "false"} ]
                    %mo ;
                  %annotation{:encoding => "application/x-tex"} s_1 [g_1,g_2] =  [g_1,1,g_2] ;
          %p
            and similarly
            = succeed "." do
              %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_39.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mn 2
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi g
                      %mn 1
                    %mo ,
                    %msub
                      %mi g
                      %mn 2
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi g
                      %mn 1
                    %mo ,
                    %msub
                      %mi g
                      %mn 2
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} s_2 [g_1,g_2] =  [g_1,g_2,1]
          %p The general formulae are now easy to guess and to prove - so they will be left to you, and then the following should be obvious.
          .un_lemma
            %h6#lemma_2 Lemma
            %p There is a natural simplicial isomorphism,
            .maruku-equation
              %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_40.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo \
                    %mi E
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≅
                    %mi Ner
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi BG
                    %mo .
                  %annotation{:encoding => "application/x-tex"} G\backslash E(G)\xrightarrow{\cong}Ner(G[1])= BG.
          %p
            We thus have that
            %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_41.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo \
                  %mi E
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G\backslash E(G)
            is a
            %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
            for
            = succeed "." do
              %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_42.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %p
            This construction of
            %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_43.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E(G)
            is exactly that of the nerve of the
            %a.existingWikiWord{:href => "/nlab/show/action+groupoid"} action groupoid
            of the action of
            %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_44.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            on itself by left multiplication.
          %h2#volodin_spaces Volodin spaces
          %p
            We put ourselves in the context of a group,
            = succeed "," do
              %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_45.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "," do
              %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_46.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℋ
                  %annotation{:encoding => "application/x-tex"} \mathcal{H}
            %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_47.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            as in the context of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/higher+generation+by+subgroups"} higher generation by subgroups
            %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_48.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℋ
                  %mo =
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi H
                    %mi i
                  %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                  %mi i
                  %mo ∈
                  %mi I
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \mathcal{H}= \{H_i\mid i\in I\}
            for some indexing set,
            = succeed "." do
              %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_49.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
          .un_defn
            %p
              (cf. Suslin-Wodzicki, (ref. below) p. 65.) We denote by
              = succeed "," do
                %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_50.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo ,
                      %mi ℋ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} V(G,\mathcal{H})
              = succeed "," do
                %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_51.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo{:stretchy => "false"} (
                      %mi ℌ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} V(\mathfrak{H})
              %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_52.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E(G)
              formed by simplices,
              = succeed "," do
                %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_53.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi g
                        %mn 0
                      %mo ,
                      %mi …
                      %mo ,
                      %msub
                        %mi g
                        %mi p
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (g_0,\ldots,g_p)
              %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_54.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} i\in I
              such that, for all
              = succeed "," do
                %math#mathml_a810f23e4087494c570c67bf23cc26e9decf9da2_55.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo ≤
                      %mi j
                      %mo ,
                      %mi k
                      %mo ≤
                      %mi p
                    %annotation{:encoding => "application/x-tex"} 0\leq j,k\leq p
              = succeed "." do
