              %ul
                %li
                  %a{:href => "#chernsimons_theory"} Chern-Simons theory
              %li
                %a{:href => "#in_terms_of_lie_algebroids"}
                  In terms of
                  = succeed "-Lie" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn ∞
                        %annotation{:encoding => "application/x-tex"} \infty
              %li
                %a{:href => "#related_concepts"} Related concepts
              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            A
            %em Chern-Simons form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CS
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} CS(A)
            is a
            %a.existingWikiWord{:href => "/nlab/show/differential+form"} differential form
            naturally associated to a differential form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo ,
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A \in \Omega^1(P,\mathfrak{g})
            with values in a
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            %a.existingWikiWord{:href => "/nlab/show/curvature+characteristic+form"} curvature characteristic form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %msub
                    %mi F
                    %mi A
                  %mo ∧
                  %mi ⋯
                  %mo ∧
                  %msub
                    %mi F
                    %mi A
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} \langle F_A \wedge \cdots \wedge F_A \rangle
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mi ⋯
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} \langle \cdots \rangle
            an
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi dR
                  %mi CS
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} ⟨
                  %msub
                    %mi F
                    %mi A
                  %mo ∧
                  %mi ⋯
                  %mo ∧
                  %msub
                    %mi F
                    %mi A
                  %mo{:stretchy => "false"} ⟩
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  d_{dR} CS(A) = \langle F_A \wedge \cdots \wedge F_A \rangle
                  \\,,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mi A
                  %mo ∈
                  %msup
                    %mi Ω
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F_A \in \Omega^2(X,\mathfrak{g})
            is the
            %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
            2-form of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %p
            Therefore it is often also called a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/secondary+characteristic+form"} secondary characteristic form
          %p
            More generally, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ,
                  %mi A
                  %mo ′
                  %mo ∈
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo ,
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A,A' \in \Omega^1(P, \mathfrak{g})
            two
            = succeed "-valued" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi A
                    %mo{:stretchy => "false"} ^
                  %mo ∈
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo ×
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \hat A \in \Omega^1(P \times [0,1],\mathfrak{g})
            a “path of connections”, the Chern-Simons form relative to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ′
                %annotation{:encoding => "application/x-tex"} A'
            is a form that trivializes the
            %em difference
            between the two curvature characteristic forms
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi dR
                  %mi CS
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi A
                  %mo ′
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} ⟨
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi F
                    %mi A
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi k
                  %mo{:stretchy => "false"} ⟩
                  %mo −
                  %mo{:stretchy => "false"} ⟨
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi F
                    %mrow
                      %mi A
                      %mo ′
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi k
                  %mo{:stretchy => "false"} ⟩
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  d_{dR}CS(A,A') = \langle (F_A)^k \rangle - \langle (F_{A'})^k \rangle
                  \\,.
          %p
            Chern-Simons forms are of interest notably when the differential forms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ,
                  %mi A
                  %mo ′
                %annotation{:encoding => "application/x-tex"} A,A'
            are (local representatives of)
            %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connections
            on a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} P \to X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo ,
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A \in \Omega^1(P,\mathfrak{g})
            is an
            %a.existingWikiWord{:href => "/nlab/show/Ehresmann+connection"} Ehresmann connection
            1-form.
          %p
            Often the term
            %em Chern-Simons form
            is taken to refer to the case where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            is a
            %a.existingWikiWord{:href => "/nlab/show/semisimple+Lie+algebra"} semisimple Lie algebra
            with binary
            %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} \langle -, -\rangle
            (e.g. the
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Killing+form"} Killing form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CS
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} CS(A)
            is the 3-form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mi A
                  %mo ∧
                  %msub
                    %mi d
                    %mi dR
                  %mi A
                  %mo{:stretchy => "false"} ⟩
                  %mo +
                  %mi c
                  %mo{:stretchy => "false"} ⟨
                  %mi A
                  %mo ∧
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo ∧
                  %mi A
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ⟩
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\langle A \wedge d_{dR} A\rangle
                  +
                  c
                  \\langle
                  A \wedge [A \wedge A]
                  \\rangle
                  \\,.
          %p
            Even more specifically, often the term is understood to refer to the case where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                  %mo ⊂
                  %mi 𝔤𝔩
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathfrak{g} \subset \mathfrak{gl}(n)
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/matrix+Lie+algebra"} matrix Lie algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔬
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathfrak{o}(n)
            (for the
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/orthogonal+group"} orthogonal group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔲
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathfrak{u}(n)
            (for the
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/unitary+group"} unitary group
            = succeed "s:" do
              %a.existingWikiWord{:href => "/nlab/show/trace"} trace
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi ⋯
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mi tr
                    %mo{:stretchy => "false"} (
                    %mi ⋯
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \langle \cdots \rangle = tr(\cdots )
          %h2#Details Details
          %p
            It is sufficient to discuss properties of Chern-Simons forms for
            = succeed "-valued" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            = succeed "-bundle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %h3#PathsOfConnections Paths of connections
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
          .num_prop
            %h6#definition Definition
            %p
              A
              %strong smooth path
              of
              = succeed "-valued" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              is a smooth 1-form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ^
                    %mo ∈
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \hat A \in \Omega^1(U\times [0,1],\mathfrak{g})
            %p
              Call this path
              %strong pure shift
              if
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ι
                        %mrow
                          %msub
                            %mo ∂
                            %mi t
                      %mover
                        %mi A
                        %mo{:stretchy => "false"} ^
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \iota_{\partial_t} \hat A = 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo :
                    %mi U
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ↪
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} t : U \times [0,1] \to [0,1] \hookrightarrow \mathbb{R}
              is the canonical coordinate along the interval.
            %p
              We say this path goes from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 0
                    %mo :
                    %mo =
                    %msubsup
                      %mi ψ
                      %mn 0
                      %mo *
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} A_0 := \psi_0^* \hat A
              to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mn 1
                      %mo :
                      %mo =
                      %msubsup
                        %mi ψ
                        %mn 1
                        %mo *
                      %mover
                        %mi A
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} A_1 := \psi_1^* \hat A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ψ
                      %mi t
                    %mo :
                    %mi U
                    %mo ≃
                    %mi U
                    %mo ×
                    %mo *
                    %mover
                      %mo →
                      %mrow
                        %mi Id
                        %mo ×
                        %mi t
                    %mi U
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\psi_t :  U \simeq U \times * \stackrel{Id \times t}{\to} U \times [0,1]
            %p
              picks the copy of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              at parameter
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                    %annotation{:encoding => "application/x-tex"} t
          %p
            So a smooth path is a smooth 1-form on the cylinder
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ×
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} U \times [0,1]
            and it is
            %em pure shift
            if it has no “leg” along the
            = succeed "-direction." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [0,1]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ι
                    %mrow
                      %msub
                        %mo ∂
                        %mi t
                  %mover
                    %mi A
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \iota_{\partial_t} \hat A
            encodes infinitesimal gauge transformations, while
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∂
                    %mi t
                  %mover
                    %mi A
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \partial_t \hat A
            is the change by infinitesimal shifts minus infinitesimal gauge transformations of the connection.
          .num_defn
            %h6#definitionobservation Definition/Observation
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              be an
              %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              of arity
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            %p
              Consider the
              %a.existingWikiWord{:href => "/nlab/show/fiber+integration"} fiber integration
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi CS
                      %mi P
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mn 0
                    %mo ,
                    %msub
                      %mi A
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %msub
                      %mo ∫
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} ]
                    %mi P
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi F
                      %mover
                        %mi A
                        %mo{:stretchy => "false"} ^
                    %mo ∧
                    %mi ⋯
                    %mo ∧
                    %msub
                      %mi F
                      %mover
                        %mi A
                        %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    CS_P(A_0,A_1) :=
                    \\int_{[0,1]} P(F_{\hat A} \wedge \cdots \wedge F_{\hat A})
                    \\,.
            %p
              This defines a
              = succeed "-form" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mi n
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (2n-1)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi CS
                        %mi P
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi A
                        %mn 0
                      %mo ,
                      %msub
                        %mi A
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %msup
                        %mi Ω
                        %mrow
                          %mn 2
                          %mi n
                          %mo −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} CS_P(A_0,A_1) \in \Omega^{2n-1}(U)
            %p
              We have that the exterior differential of this form is the difference of the
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/curvature+characteristic+form"} curvature characteristic form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} A_0
              and
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} A_1
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi dR
                    %msub
                      %mi CS
                      %mi P
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mn 0
                    %mo ,
                    %msub
                      %mi A
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi P
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi F
                      %mrow
                        %msub
                          %mi A
                          %mn 1
                    %mo ∧
                    %mi ⋯
                    %mo ∧
                    %msub
                      %mi F
                      %mrow
                        %msub
                          %mi A
                          %mn 1
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mi P
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi F
                      %mrow
                        %msub
                          %mi A
                          %mn 0
                    %mo ∧
                    %mi ⋯
                    %mo ∧
                    %msub
                      %mi F
                      %mrow
                        %msub
                          %mi A
                          %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    d_{dR} CS_P(A_0,A_1)
                    \=
                    P(F_{A_1} \wedge \cdots \wedge F_{A_1})
                    \-
                    P(F_{A_0} \wedge \cdots \wedge F_{A_0})
          .proof
            %h6#proof Proof
            %p
              Write the fiber integration more explicitly as an
              %a.existingWikiWord{:href => "/nlab/show/integral"} integral
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi CS
                      %mi P
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mn 0
                    %mo ,
                    %msub
                      %mi A
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mo ∫
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} ]
                    %msubsup
                      %mi ψ
                      %mi t
                      %mo *
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mo ∂
                          %mi t
                    %mi P
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi F
                      %mover
                        %mi A
                        %mo{:stretchy => "false"} ^
                    %mo ∧
                    %mi ⋯
                    %mo ∧
                    %msub
                      %mi F
                      %mover
                        %mi A
                        %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} )
                    %mi d
                    %mi t
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    CS_P(A_0,A_1) =
                    \\int_{[0,1]}
                    \\psi_t^* \iota_{\partial_t} P(F_{\hat A} \wedge \cdots \wedge F_{\hat A})
                    d t
                    \\,.
            %p
              Then use that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi dR
                  %annotation{:encoding => "application/x-tex"} d_{dR}
              is linear and commutes with pullback, use
              %a.existingWikiWord{:href => "/nlab/show/Cartan%27s+magic+formula"} Cartan's magic formula
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi dR
                    %mo ∘
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mo ∂
                          %mi t
                    %mo +
                    %msub
                      %mi ι
                      %mo ∂
                    %mo ∘
                    %msub
                      %mi d
                      %mi dR
                    %mo =
                    %msub
                      %mi ℒ
                      %mrow
                        %msub
                          %mo ∂
                          %mi t
                  %annotation{:encoding => "application/x-tex"} d_{dR} \circ \iota_{\partial_t} + \iota_{\partial} \circ d_{dR} = \mathcal{L}_{\partial_t}
              in view of the fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi F
                      %mover
                        %mi A
                        %mo{:stretchy => "false"} ^
                    %mo ∧
                    %mi ⋯
                    %mo ∧
                    %msub
                      %mi F
                      %mover
                        %mi A
                        %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P(F_{\hat A} \wedge \cdots \wedge F_{\hat A})
              is a
              %a.existingWikiWord{:href => "/nlab/show/closed+form"} closed form
              and then finally apply the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Stokes+theorem"} Stokes theorem
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi d
                              %mi dR
                            %msubsup
                              %mo ∫
                              %mn 0
                              %mn 1
                            %msubsup
                              %mi ψ
                              %mi t
                              %mo *
                            %msub
                              %mi ι
                              %mrow
                                %msub
                                  %mo ∂
                                  %mi t
                            %mi P
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi F
                              %mover
                                %mi A
                                %mo{:stretchy => "false"} ^
                            %mo ∧
                            %mi ⋯
                            %mo ∧
                            %msub
                              %mi F
                              %mover
                                %mi A
                                %mo{:stretchy => "false"} ^
                            %mo{:stretchy => "false"} )
                            %mi d
                            %mi t
                          %mtd
                            %mo =
                            %msubsup
                              %mo ∫
                              %mn 0
                              %mn 1
                            %msub
                              %mi d
                              %mi dR
                            %msubsup
                              %mi ψ
                              %mi t
                              %mo *
                            %msub
                              %mi ι
                              %mrow
                                %msub
                                  %mo ∂
                                  %mi t
                            %mi P
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi F
                              %mover
                                %mi A
                                %mo{:stretchy => "false"} ^
                            %mo ∧
                            %mi ⋯
                            %mo ∧
                            %msub
                              %mi F
                              %mover
                                %mi A
                                %mo{:stretchy => "false"} ^
                            %mo{:stretchy => "false"} )
                            %mi d
                            %mi t
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msubsup
                              %mo ∫
                              %mn 0
                              %mn 1
                            %msubsup
                              %mi ψ
                              %mi t
                              %mo *
                            %msub
                              %mi d
                              %mi dR
                            %msub
                              %mi ι
                              %mrow
                                %msub
                                  %mo ∂
                                  %mi t
                            %mi P
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi F
                              %mover
                                %mi A
                                %mo{:stretchy => "false"} ^
                            %mo ∧
                            %mi ⋯
                            %mo ∧
                            %msub
                              %mi F
                              %mover
                                %mi A
                                %mo{:stretchy => "false"} ^
                            %mo{:stretchy => "false"} )
                            %mi d
