              %li
                %a{:href => "#InInfCSTheory"}
                  In
                  = succeed "-Chern-Weil" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn ∞
                        %annotation{:encoding => "application/x-tex"} \infty
              %ul
                %li
                  %a{:href => "#PrerequisitesHigher"} Prerequisites
                %li
                  %a{:href => "#HigherOrderChernSimonsForms"} Higher order Chern-Simons form
                %ul
                  %li
                    %a{:href => "#OrdinaryCSRevisited"} Ordinary Chern-Simons forms revisited
              %li
