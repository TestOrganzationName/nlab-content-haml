                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msubsup
                              %mo ∫
                              %mn 0
                              %mn 1
                            %msubsup
                              %mi ψ
                              %mi t
                              %mo *
                            %mfrac
                              %mi d
                              %mrow
                                %mi d
                                %mi t
                            %mi P
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi F
                              %mover
                                %mi A
                                %mo{:stretchy => "false"} ^
                            %mo ∧
                            %mi ⋯
                            %mo ∧
                            %msub
                              %mi F
                              %mover
                                %mi A
                                %mo{:stretchy => "false"} ^
                            %mo{:stretchy => "false"} )
                            %mi d
                            %mi t
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msubsup
                              %mo ∫
                              %mn 0
                              %mn 1
                            %mrow
                              %mo (
                              %mfrac
                                %mi d
                                %mrow
                                  %mi d
                                  %mi t
                              %mi P
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi F
                                %mover
                                  %mi A
                                  %mo{:stretchy => "false"} ^
                              %mo ∧
                              %mi ⋯
                              %mo ∧
                              %msub
                                %mi F
                                %mover
                                  %mi A
                                  %mo{:stretchy => "false"} ^
                              %mo{:stretchy => "false"} )
                              %mo )
                            %mo{:stretchy => "false"} (
                            %mi t
                            %mo{:stretchy => "false"} )
                            %mi d
                            %mi t
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msubsup
                              %mi ψ
                              %mn 1
                              %mo *
                            %mi P
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi F
                              %mover
                                %mi A
                                %mo{:stretchy => "false"} ^
                            %mo ∧
                            %mi ⋯
                            %mo ∧
                            %msub
                              %mi F
                              %mover
                                %mi A
                                %mo{:stretchy => "false"} ^
                            %mo{:stretchy => "false"} )
