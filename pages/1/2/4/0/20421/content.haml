              \-category
            (read “n-by-k category”) is an
            %a.existingWikiWord{:href => "/nlab/show/n-category"} n-category
            %a.existingWikiWord{:href => "/nlab/show/internalization"} internal
            to the
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
