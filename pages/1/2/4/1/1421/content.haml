          .un_remark
            %h6#remark Remark
            %p
              By the
              %a.existingWikiWord{:href => "/nlab/show/co-Yoneda+lemma"} co-Yoneda lemma
              we may express every
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %msub
                      %mi Sh
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \in Sh_{(\infty,1)}(C)
              as an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimit"} (∞,1)-colimit
              of
              %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representables
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ≃
                    %msub
                      %mrow
                        %munder
                          %mi lim
                          %mo →
                      %mi i
                    %msub
                      %mi U
                      %mi i
                    %mo =
                    %msub
                      %mrow
                        %munder
                          %mi lim
                          %mo →
                      %mi i
                    %mi Spec
                    %msub
                      %mi A
                      %mi i
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    X \simeq {\lim_\to}_i U_i = {\lim_\to}_i Spec A_i
                    \\,.
            %p We have then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi QC
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mrow
                        %munder
                          %mi lim
                          %mo ←
                      %mi i
                    %mi QC
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mrow
                        %munder
                          %mi lim
                          %mo ←
                      %mi i
                    %msub
                      %mi A
                      %mi i
                    %mi Mod
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    QC(X) \simeq {\lim_\leftarrow}_i QC(U_i) \simeq {\lim_\leftarrow}_i A_i Mod
                    \\,.
          %p
            This appears in
            = succeed "." do
              %a{:href => "#Ben-ZviFrancisNadler"} Ben-Zvi, Francis &amp; Nadler, section 3.1
          .un_prop
            %h6#proposition Proposition
            %p
              For all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi QC
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} QC(X)
            %ul
              %li
                %p
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/stable+%28%E2%88%9E%2C1%29-category"} stable (∞,1)-category
              %li
                %p
                  that has all
                  = succeed "s." do
                    %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimit"} (∞,1)-colimit
          %p
            (
            %a{:href => "#Ben-ZviFrancisNadler"}> Ben-Zvi, Francis &amp; Nadler, section 3.1
            ).
          .un_defn
            %h6#definition_4 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi T
                    %msub
                      %mi Alg
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} A \in T Alg_\infty
              \. An
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %strong perfect module
              if it lies in the smallest
              %a.existingWikiWord{:href => "/nlab/show/sub-%28%E2%88%9E%2C1%29-category"} sub-(∞,1)-category
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} A Mod
              containing
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and closed under finite
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimit"} (∞,1)-colimit
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/retract"} retract
            %p
              For a
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-stack"} ∞-stack
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %msub
                        %mi Sh
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn ∞
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} X \in Sh_{(\infty,1)}(C)
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Perf
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Perf(X)
              is the full sub-
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
              \-category of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi QC
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} QC(X)
              consisting of those modules that are prefect over every affine
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} U\to X
          %p
            This appears in
            = succeed "." do
              %a{:href => "#Ben-ZviFrancisNadler"} Ben-Zvi, Francis &amp; Nadler, definition 3.1
          .un_defn
            %h6#definition_5 Definition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-stack"} ∞-stack
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %msub
                      %mi Sh
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \in Sh_{(\infty,1)}(C)
              is called a
              %strong perfect stack
              if
            %ul
              %li
                %p
                  it has affine diagonal
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                          %mo →
                          %mi X
                          %mo ×
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X \to X \times X
              %li
                %p
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi QC
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} QC(X)
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/ind-object+in+an+%28infinity%2C1%29-category"} (∞,1)-category of ind-objects
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi QC
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} Ind
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} Perf
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        QC(X) \simeq \Ind \Perf(X)
                %p
                  of the full
                  %a.existingWikiWord{:href => "/nlab/show/sub-%28%E2%88%9E%2C1%29-category"} sub-(∞,1)-category
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Perf
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo ⊂
                        %mi QC
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Perf(X) \subset QC(X)
                  of perfect complexes of modules on
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
            %p
              A morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \rightarrow Y
              is said to be
              %strong perfect morphism
              if its fibers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %msub
                      %mo ×
                      %mi Y
                    %mi U
                  %annotation{:encoding => "application/x-tex"} X \times_Y U
              over affines
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} U \rightarrow Y
              are perfect.
          %h2#properties Properties
          %h3#equivalent_reformulations Equivalent reformulations
          .un_def
            %h6#definition_6 Definition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/stable+%28%E2%88%9E%2C1%29-category"} stable (∞,1)-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is
              %strong compactly generated
              if it has a
              %a.existingWikiWord{:href => "/nlab/show/small+set"} small set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi c
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{c_i\}_{i \in I}
              of
              %a.existingWikiWord{:href => "/nlab/show/compact+objects"} compact objects
              that are
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/generator"} generator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} N \in C
              we have that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mi i
                    %mo ,
                    %mi N
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(c_i, N)
              is equivalent to the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/zero+morphism"} zero morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              is the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/zero+object"} zero object
          .un_theorem
            %h6#proposition_2 Proposition
            %p
              For an
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-stack"} ∞-stack
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %msub
                      %mi Sh
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \in Sh_{(\infty,1)}(C)
              with affine diagonal, the following are equivalent:
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  is perfect
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi QC
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} QC(X)
                  is
                %ul
                  %li
                    %p compactly generated,
                  %li
                    %p
                      and its
                      %a.existingWikiWord{:href => "/nlab/show/compact+object"} compact
                      and
                      %a.existingWikiWord{:href => "/nlab/show/dualizable+object"} dualizable
                      objects coincide.
          %h3#geometric_function_theory
            Geometric
            = succeed "-function" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p The assigmnent
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi QC
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo ↦
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  QC \colon X \mapsto QC(X)
          %p
            of the
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,2)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} QC(X)
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/quasicoherent+%E2%88%9E-stack"} quasicoherent ∞-stack
            = succeed "-stacks" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            constitutes a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/geometric+%E2%88%9E-function+theory"} geometric ∞-function theory
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/integral+transforms+on+sheaves"} integral transforms on sheaves
          %p
            (
            %a{:href => "#Ben-ZviFrancisNadler"}> Ben-Zvi, Francis&amp; Nadler
            )
          %h2#examples Examples
          %p
            Perfect stacks cover a broad array of spaces of interest, with notable exceptions being the (
            %a.existingWikiWord{:href => "/nlab/show/constant+%E2%88%9E-stack"} constant ∞-stack
            on a)
            %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℬ
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathcal{B}G
            of a
            %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            such as the
            %a.existingWikiWord{:href => "/nlab/show/circle"} circle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mn 1
                  %mo ≃
                  %mi ℬ
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} S^1 \simeq \mathcal{B} \mathbb{Z}
            or the classifying spaces of most
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+group"} algebraic group
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/characteristic"} characteristic
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is perfect, then the
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/global+section"} global section
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                %annotation{:encoding => "application/x-tex"} \Gamma
            must preserve colimits, which fails when the global sections
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msub
                    %mi 𝒪
                    %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Gamma(X, \mathcal{O}_X)
            of the structure sheaf is ‘too large’, as in the previous cases.
          %p
            But the following are examples of perfect
            = succeed "-stacks" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %ul
            %li
              %p
                quasi-compact
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/derived+scheme"} derived scheme
            %li
              %p the total space of a quasi-projective morphism over a perfect base;
            %li
              %p
                a quasi-projective
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/derived+scheme"} derived scheme
            %li
              %p
                the quotient
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo{:stretchy => "false"} /
                      %mi G
                    %annotation{:encoding => "application/x-tex"} X/G
                of a quasi-projective
                %a.existingWikiWord{:href => "/nlab/show/derived+scheme"} derived scheme
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                by a linear action of an affine group (for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
                of
                %a.existingWikiWord{:href => "/nlab/show/characteristic"} characteristic
                0).
          %h2#references References
          %p
            The concept of a
            %em perfect stack
            in the context of
            %a.existingWikiWord{:href => "/nlab/show/dg-geometry"} dg-geometry
            is considered in
          %ul
            %li#Ben-ZviFrancisNadler
              %a.existingWikiWord{:href => "/nlab/show/David+Ben-Zvi"}> Ben-Zvi
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/John+Francis"} John Francis
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/David+Nadler"} David Nadler
              %em Integral transforms and Drinfeld centers in derived algebraic geometry
              (
              %a{:href => "http://arxiv.org/abs/0805.0157"}> arXiv
              )
