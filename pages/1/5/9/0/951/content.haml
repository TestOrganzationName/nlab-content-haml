                  %mo ,
                  %mi n
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{1, \ldots, n\}
            is used instead.)
          %h2#properties Properties
          %h3#OppositeCategory Opposite category
          .num_prop
            %h6#proposition Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi FinSet
                  %annotation{:encoding => "application/x-tex"} FinSet
              is
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
              to that of finite
              %a.existingWikiWord{:href => "/nlab/show/Boolean+algebras"} Boolean algebras
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi FinSet
                      %mi op
                    %mo ≃
                    %mi FinBool
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    FinSet^{op} \simeq FinBool
                    \\,.
            %p
              This equivalence is induced by the
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/power+set"} power set
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒫
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi FinSet
                      %mi op
                    %mover
                      %mo →
                      %mo ≃
                    %mi FinBool
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{P} \;\colon\; FinSet^{op} \stackrel{\simeq}{\to} FinBool
                    \\,.
          %p
            This is discussed for instance as (
            %a{:href => "#Awodey"}> Awodey, prop. 7.31
            ). For the generalization to all sets see at
            = succeed "." do
              %em
                %a{:href => "Set#OppositeCategory"} Set – Properties – Opposite category and Boolean algebras
            %em
              %a.existingWikiWord{:href => "/nlab/show/Stone+duality"} Stone duality
            for more on this.
          .num_remark
            %h6#remark Remark
            %p
              In constructive mathematics, for any flavor of
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒫
                  %annotation{:encoding => "application/x-tex"} \mathcal{P}
              defines an equivalence of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi FinSet
                  %annotation{:encoding => "application/x-tex"} FinSet
              with the opposite category of that of those
              %a.existingWikiWord{:href => "/nlab/show/complete+lattice"} complete
              %a.existingWikiWord{:href => "/nlab/show/atom"} atomic
              %a.existingWikiWord{:href => "/nlab/show/Heyting+algebras"} Heyting algebras
              whose set of atomic elements is finite (in the same sense as in the definition of
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi FinSet
                    %annotation{:encoding => "application/x-tex"} FinSet
              %a.existingWikiWord{:href => "/nlab/show/complete+lattice"} complete
              %a.existingWikiWord{:href => "/nlab/show/atom"} atomic
              %a.existingWikiWord{:href => "/nlab/show/Heyting+algebras"} Heyting algebras
              are Boolean.
          %h3#universal_properties Universal properties
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi FinSet
                %annotation{:encoding => "application/x-tex"} FinSet
            is the free category with finite coproducts on one object: that is, for any category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            with finite coproducts and any object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo ∈
                  %mi C
                %annotation{:encoding => "application/x-tex"} c \in C
            there is a functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi FinSet
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} F : FinSet \to C
            preserving finite coproducts with
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi c
                  %annotation{:encoding => "application/x-tex"} F(1) = c
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            is unique up to natural isomorphism.
          %p
            The first fact is closely connected to the fact that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi FinSet
                %annotation{:encoding => "application/x-tex"} FinSet
            is the
            %a.existingWikiWord{:href => "/nlab/show/vertical+categorification"} vertical categorification
            of the set of natural numbers
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \mathbb{N}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} \mathbb{N}
            is the
            %a.existingWikiWord{:href => "/nlab/show/free+monoid"} free monoid
            on one generator.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi FinSet
                %annotation{:encoding => "application/x-tex"} FinSet
            is also the free category with finite colimits on one object: that is, for any category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            with finite colimits and any object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo ∈
                  %mi C
                %annotation{:encoding => "application/x-tex"} c \in C
            there is a functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi FinSet
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} F : FinSet \to C
            preserving finite colimits with
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi c
                  %annotation{:encoding => "application/x-tex"} F(1) = c
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            is unique up to natural isomorphism.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi FinSet
                %annotation{:encoding => "application/x-tex"} FinSet
            is also the free
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
            on a commutative monoid object: that is, for any symmetric monoidal category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mo ⊗
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (C, \otimes)
            and any commutative monoid object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo ∈
                  %mi C
                %annotation{:encoding => "application/x-tex"} c \in C
            there is a symmetric monoidal functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi FinSet
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mo ⊗
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F : (FinSet,+) \to (C, \otimes)
            with
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi c
                  %annotation{:encoding => "application/x-tex"} F(1) = c
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            is unique up to monoidal natural isomorphism.
          %p
            The last fact is closely connected to this:
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi FinSet
                  %annotation{:encoding => "application/x-tex"} FinSet
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %annotation{:encoding => "application/x-tex"} +
            %a.existingWikiWord{:href => "/nlab/show/PROP"} PROP
            for commutative monoids. A proof is given in Lafont’s paper below. Moreover, the sub-prop generated by the unit of the monoid consists of the monics, while the free prop generated by the multiplication of the monoid are the epics.
          %p
            All these universal properties have useful duals.
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi FinSet
                    %mi op
                %annotation{:encoding => "application/x-tex"} FinSet^{op}
            is the free category with finite products on one object and also the free category with finite limits on one object; the symmetric monoidal category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi FinSet
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                %annotation{:encoding => "application/x-tex"} (FinSet, +)^{op}
            is equivalent to the PROP for cocommutative comonoids.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi FinSet
                %annotation{:encoding => "application/x-tex"} FinSet
            is also the free strict mononoidal category on a symmetric monoid object (see
            = succeed ")." do
              %a{:href => "#Grandis01"} Grandis 01
          %h3#equivalence_with_the_category_of_finite_topological_spaces
            Equivalence with the category of finite
            = succeed "-topological" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} T_1
          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/continuous+map"} continuous map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f \colon X \to Y
            between
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/specialisation+order"} specialisation order
            %a.existingWikiWord{:href => "/nlab/show/faithful+functor"} faithful functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spec
                %annotation{:encoding => "application/x-tex"} Spec
            from the category of
            %a.existingWikiWord{:href => "/nlab/show/Top"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} Top
                  %annotation{:encoding => "application/x-tex"} \mathrm{Top}
            of topological spaces to the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} PreOrd
                %annotation{:encoding => "application/x-tex"} \mathrm{PreOrd}
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/preordered+sets"} preordered sets
          %p
            In the other direction, to each
            %a.existingWikiWord{:href => "/nlab/show/preordered+set"} preordered set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mo ≤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X, \leq)
            we may associate a topological space whose
            %a.existingWikiWord{:href => "/nlab/show/elements"} elements
            are those of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/open+subsets"} open subsets
            are precisely the upward-closed sets with respect to the preordered set. This topology is called the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/specialization+topology"} specialization topology
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo{:lspace => "verythinmathspace"} :
                  %mi PreOrd
                  %mo →
                  %mi Top
                %annotation{:encoding => "application/x-tex"} i \colon  PreOrd \to Top
          %p
            which is a
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full embedding
            %a.existingWikiWord{:href => "/nlab/show/essential+image"} essential image
            of this functor is the category of
            %a.existingWikiWord{:href => "/nlab/show/Alexandroff+spaces"} Alexandroff spaces
            (spaces in which an arbitrary
            %a.existingWikiWord{:href => "/nlab/show/intersection"} intersection
            of open sets is open). Hence the category of preorders is equivalent to the category of Alexandroff spaces.
          %p
            There is an an
            %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjunction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo ⊣
                  %mi Spec
                %annotation{:encoding => "application/x-tex"} i \dashv Spec
            between the categories
            %a.existingWikiWord{:href => "/nlab/show/PreOrd"} PreOrd
            and
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            making
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi PreOrd
                %annotation{:encoding => "application/x-tex"} PreOrd
            a
            %a.existingWikiWord{:href => "/nlab/show/coreflective+subcategory"} coreflective subcategory
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} Top
            %a.existingWikiWord{:href => "/nlab/show/adjunction+counit"} adjunction counit
            evaluated at a space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo{:stretchy => "false"} (
                  %mi Spec
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi X
                  %mo ,
                %annotation{:encoding => "application/x-tex"} i(Spec(X)) \to X,
          %p
            is the
            %a.existingWikiWord{:href => "/nlab/show/identity+function"} identity function
            at the level of sets, and is
            %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous
            because any open
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is upward-closed with respect to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≤
                  %annotation{:encoding => "application/x-tex"} \leq
          %p
            This
            %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
            restricts to an
            %a.existingWikiWord{:href => "/nlab/show/adjoint+equivalence"} adjoint equivalence
            between the categories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} FinPreOrd
                %annotation{:encoding => "application/x-tex"} \mathrm{FinPreOrd}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} FinTop
                %annotation{:encoding => "application/x-tex"} \mathrm{FinTop}
            of finite preordered sets and finite topological spaces. The
            %a.existingWikiWord{:href => "/nlab/show/adjunction+unit"} unit
            and
            %a.existingWikiWord{:href => "/nlab/show/adjunction+counit"} counit
            are both
            %a.existingWikiWord{:href => "/nlab/show/identity+functions"} identity functions
            on
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/underlying+sets"} underlying sets
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/concrete+categories"} concrete categories
          %p
            Since the
            %a.existingWikiWord{:href => "/nlab/show/specialization+order"} specialization order
            of
            %a.existingWikiWord{:href => "/nlab/show/T_1-topological+space"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} T_1
              \-topological spaces
            is
            %a.existingWikiWord{:href => "/nlab/show/equality"} equality
            in
            = succeed "-spaces," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} T_1
            %a.existingWikiWord{:href => "/nlab/show/equality"} equality
            relation used to define the
            %a.existingWikiWord{:href => "/nlab/show/specialization+topology"} specialization topology
            of a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/set"} set
            %a.existingWikiWord{:href => "/nlab/show/adjoint+equivalence"} adjoint equivalence
            between the categories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} FinSet
                %annotation{:encoding => "application/x-tex"} \mathrm{FinSet}
            of
            %a.existingWikiWord{:href => "/nlab/show/finite+sets"} finite sets
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} Fin
                  %msub
                    %mi T
                    %mn 1
                  %mi{:mathvariant => "normal"} Sp
                %annotation{:encoding => "application/x-tex"} \mathrm{Fin}T_1\mathrm{Sp}
            of finite
            = succeed "-topological" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} T_1
          %h3#in_grpd In Grpd
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi FinSet
                %annotation{:encoding => "application/x-tex"} FinSet
            is a
            %a.existingWikiWord{:href => "/nlab/show/natural+numbers+object"} natural numbers object
            in the
            %a.existingWikiWord{:href => "/nlab/show/%282%2C1%29-topos"} (2,1)-topos
            %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
            of
            %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/functors"} functors
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mn 1
                    %mo +
                    %mi X
                  %annotation{:encoding => "application/x-tex"} F(X) \cong 1 + X
            %a.existingWikiWord{:href => "/nlab/show/free+object"} free
            %a.existingWikiWord{:href => "/nlab/show/monoid+object"} monoid object
            on one generator in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
            %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial
            %a.existingWikiWord{:href => "/nlab/show/rig+object"} rig object
            in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/category"} category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi FinSet
                %annotation{:encoding => "application/x-tex"} FinSet
            is a
            %a.existingWikiWord{:href => "/nlab/show/vertical+categorification"} vertical categorification
            of the
            %a.existingWikiWord{:href => "/nlab/show/poset"} poset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} \mathbb{N}
            of natural numbers.
          %p
            As a groupoid itself, the
            %a.existingWikiWord{:href => "/nlab/show/core"} core
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi FinSet
                %annotation{:encoding => "application/x-tex"} FinSet
            is (with the operation of
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/disjoint+union"} disjoint union
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
            on one object. (There is no way to generate non-invertible morphisms from this data.)
          %h3#in_topos_theory In topos theory
          %p
            The category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi FinSet
                %annotation{:encoding => "application/x-tex"} FinSet
            is an
            %a.existingWikiWord{:href => "/nlab/show/elementary+topos"} elementary topos
            and the inclusion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi FinSet
                  %mo ↪
                  %mi Set
                %annotation{:encoding => "application/x-tex"} FinSet \hookrightarrow Set
            is a
            %a.existingWikiWord{:href => "/nlab/show/logical+morphism"} logical morphism
            of toposes. (
            %a.existingWikiWord{:href => "/nlab/show/Elephant"}> Elephant, example 2.1.2
            ).
          %p
            Mathematics done within or about
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi FinSet
                %annotation{:encoding => "application/x-tex"} FinSet
            is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/finite+mathematics"} finite mathematics
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
            of sets on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} Fin
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} Set
                %annotation{:encoding => "application/x-tex"} \Fin\Set
            is a
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/symmetric+set"} symmetric set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} Fin
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} Set
                %annotation{:encoding => "application/x-tex"} \Fin\Set
            for this.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/copresheaf"} copresheaf
            category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi FinSet
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [FinSet,Set]
            is the
            %a.existingWikiWord{:href => "/nlab/show/classifying+topos"} classifying topos
            for the
            %em
              %a.existingWikiWord{:href => "/nlab/show/theory+of+objects"} theory of objects
            (the empty theory over the signature with one sort and no primitive symbols except equality). (
            %a.existingWikiWord{:href => "/nlab/show/Elephant"}> Elephant, D3.2
            ).
          %h3#subcategories_of_
            Subcategories of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi FinSet
                %annotation{:encoding => "application/x-tex"} FinSet
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/simplex+category"} simplex category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                %annotation{:encoding => "application/x-tex"} \Delta
            embeds into
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} Fin
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} Set
                %annotation{:encoding => "application/x-tex"} \Fin\Set
            as a category with the same objects but fewer morphisms. The category of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/cyclic+set"} cyclic set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                %annotation{:encoding => "application/x-tex"} \Delta
            by a group in a particularly nice way. Full classification of allowed
            %a.existingWikiWord{:href => "/nlab/show/skew-simplicial+sets"} skew-simplicial sets
            has been given by Krasauskas and independently by Loday and Fiedorowicz.
          %h3#as_a_lawvere_theory As a Lawvere theory
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/cartesian+monoidal+category"} cartesian monoidal category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi FinSet
                    %mo +
                %annotation{:encoding => "application/x-tex"} FinSet_+
            of nonempty finite sets is the multi-sorted
            %a.existingWikiWord{:href => "/nlab/show/Lawvere+theory"} Lawvere theory
            of unbiased
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/boolean+algebra"} boolean algebra
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lawvere+theory"} Lawvere theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi FinSet
                %annotation{:encoding => "application/x-tex"} FinSet
            has one more sort, corresponding to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} \emptyset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ∅
                %annotation{:encoding => "application/x-tex"} \emptyset
            is empty).
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/permutation+category"} permutation category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/braid+category"} braid category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/finite+homotopy+type"} finite homotopy type
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/FinRel"} FinRel
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/FinInj"} FinInj
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/axiom+of+finiteness"} axiom of finiteness
          %h2#references References
          %ul#Awodey
            %li
              %a.existingWikiWord{:href => "/nlab/show/Steve+Awodey"}> Steve Awodey
              ,
              %em
                %a{:href => "http://www.andrew.cmu.edu/course/80-413-713/"} Category Theory
                – lecture 7
              (
              %a{:href => "http://www.andrew.cmu.edu/course/80-413-713/notes/chap07.pdf"}> pdf
              )
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Yves+Lafont"}> Yves Lafont
                , Towards an algebraic theory of Boolean circuits, February 12, 2013. (
                %a{:href => "http://iml.univ-mrs.fr/~lafont/pub/circuits.pdf"}> pdf
                )
            %li#Grandis01
              %p
                %a.existingWikiWord{:href => "/nlab/show/Marco+Grandis"}> Marco Grandis
                ,
                = succeed "," do
                  %em Finite sets and symmetric simplicial sets
                = succeed ")" do
                  %a{:href => "http://www.tac.mta.ca/tac/volumes/8/n8/n8.pdf"} pdf
