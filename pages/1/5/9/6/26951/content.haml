          %h2#idea Idea
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/setoid"} setoid
            or
            %a.existingWikiWord{:href => "/nlab/show/Bishop+set"} Bishop set
            whose
            %a.existingWikiWord{:href => "/nlab/show/quotient+set"} quotient set
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/group"} group
            %a.existingWikiWord{:href => "/nlab/show/locally+thin+2-category"} locally thin
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/2-group"} 2-group
            %a.existingWikiWord{:href => "/nlab/show/2-categories"} 2-categories
            are
            %a.existingWikiWord{:href => "/nlab/show/locally+univalent+bicategory"} locally univalent
            by default, a
            %a.existingWikiWord{:href => "/nlab/show/locally+thin+2-category"} locally thin
            = succeed "-2-group." do
              %a.existingWikiWord{:href => "/nlab/show/pregroupoid"} pre
            %a.existingWikiWord{:href => "/nlab/show/monoidal+setoid"} monoidal setoid
            in which the monoidal product with any element has an
            %a.existingWikiWord{:href => "/nlab/show/inverse"} inverse
            up to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
          %p “Groupal setoid”, “groupal Bishop set”, and “Bishop group” are placeholder names for a concept which may or may not have another name in the mathematics literature.
          %h2#definition Definition
          %p
            Here we assume that setoids or Bishop sets are equipped with an
            %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
            (rather than a
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/pseudo-equivalence+relation"} pseudo-equivalence relation
            = succeed "," do
              %strong groupal setoid
            = succeed "," do
              %strong groupal Bishop set
            %strong Bishop group
            is a
            %a.existingWikiWord{:href => "/nlab/show/monoidal+setoid"} monoidal setoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mo ∼
                  %mo ,
                  %mi e
                  %mo ,
                  %mi m
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A, \sim, e, m)
            with a function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo :
                  %mi A
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} i:A \to A
            such that
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
                preserves the
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} a \in A
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                        %mo ∈
                        %mi A
                      %annotation{:encoding => "application/x-tex"} b \in A
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo ∼
                        %mi b
                      %annotation{:encoding => "application/x-tex"} a \sim b
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo ∼
                        %mi i
                        %mo{:stretchy => "false"} (
                        %mi b
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} i(a) \sim i(b)
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
                satisfies the left and right inverse laws up to the equivalence relation: for all elements
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo ∈
                        %mi A
                      %annotation{:encoding => "application/x-tex"} a \in A
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi i
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ∼
                      %mi e
                    %annotation{:encoding => "application/x-tex"} m(a, i(a)) \sim e
                and
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi m
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo ∼
                        %mi e
                      %annotation{:encoding => "application/x-tex"} m(i(a), a) \sim e
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is
            %strong
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian groupal
            or
            %strong
              %a.existingWikiWord{:href => "/nlab/show/symmetric+2-group"} symmetric groupal
            or
            %strong
              %a.existingWikiWord{:href => "/nlab/show/braided+2-group"} braided groupal
            if additionally for all elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ∈
                  %mi A
                %annotation{:encoding => "application/x-tex"} a \in A
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} b \in A
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo ∼
                    %mi m
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo ,
                    %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} m(a, b) \sim m(b, a)
          %h2#examples Examples
          %ul
            %li
              %p
                The set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℕ
                        %mi 𝟚
                    %annotation{:encoding => "application/x-tex"} \mathbb{N}^\mathbb{2}
                of functions from the
                %a.existingWikiWord{:href => "/nlab/show/boolean+domain"} boolean domain
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝟚
                    %annotation{:encoding => "application/x-tex"} \mathbb{2}
                to the
                %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} natural numbers
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} \mathbb{N}
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo ∼
                        %mi g
                        %mo ≔
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                        %mo +
                        %mi g
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo +
                        %mi g
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} f \sim g \coloneqq f(0) + g(1) = f(1) + g(0)
            %li
              %p
                Given any
                %a.existingWikiWord{:href => "/nlab/show/Archimedean+ordered+field"} Archimedean ordered field
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
                %a.existingWikiWord{:href => "/nlab/show/Cauchy+sequences"} Cauchy sequences
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
                is an abelian groupal setoid.
            %li
              %p
                Given any
                %a.existingWikiWord{:href => "/nlab/show/Archimedean+ordered+field"} Archimedean ordered field
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
