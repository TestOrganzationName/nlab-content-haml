                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} a \wedge b \coloneqq h(\min(\Re(a), \Re(b)))
          %p and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ∨
                  %mi b
                  %mo ≔
                  %mi h
                  %mo{:stretchy => "false"} (
                  %mi max
                  %mo{:stretchy => "false"} (
                  %mi ℜ
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi ℜ
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} a \vee b \coloneqq h(\max(\Re(a), \Re(b)))
          %h3#pseudometric_and_seminorm_structure Pseudometric and seminorm structure
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/distance"} distance
            function on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is given by the function
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo :
                    %mi A
                    %mo ×
                    %mi A
                    %mo →
                    %mi K
                  %annotation{:encoding => "application/x-tex"} \rho:A \times A \to K
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mi max
                  %mo{:stretchy => "false"} (
                  %mi ℜ
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi ℜ
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo −
                  %mi min
                  %mo{:stretchy => "false"} (
                  %mi ℜ
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi ℜ
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \rho(a, b) \coloneqq \max(\Re(a), \Re(b)) - \min(\Re(a), \Re(b))
          %p
            and the
            %a.existingWikiWord{:href => "/nlab/show/absolute+value"} absolute value
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is given by the function
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mo −
                    %mo{:stretchy => "false"} |
                    %mo :
                    %mi A
                    %mo ×
                    %mi A
                    %mo →
                    %mi K
                  %annotation{:encoding => "application/x-tex"} \vert-\vert:A \times A \to K
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mi a
                  %mo{:stretchy => "false"} |
                  %mo ≔
                  %mi ρ
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \vert a \vert \coloneqq \rho(a, 0)
          %p
            The distance function and absolute value are
            %a.existingWikiWord{:href => "/nlab/show/pseudometrics"} pseudometrics
            and multiplicative
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/seminorms"} seminorms
            %a.existingWikiWord{:href => "/nlab/show/Archimedean+ordered+field"} Archimedean ordered field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            embeds into the
            %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi min
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo ≤
                    %mi max
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \min(a, b) \leq \max(a, b)
          %h3#smooth_and_differentiable_function_structure Smooth and differentiable function structure
          %p
            Suppose that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            is an
            %a.existingWikiWord{:href => "/nlab/show/Archimedean+ordered+field"} Archimedean ordered field
            with lattice structure, and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is an
            %a.existingWikiWord{:href => "/nlab/show/Archimedean+ordered+local+ring"} Archimedean ordered
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Artinian+local+algebra"}
                Artinian local
                = succeed "-algebra" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi K
                      %annotation{:encoding => "application/x-tex"} K
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/differentiable+functions"} differentiable functions
            %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
            are each definable on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            using the algebraic, order, and metric structure on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
          %p
            The ring homomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %mo :
                  %mi K
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} h:K \to A
            preserves
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ∈
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            and a purely infinitesimal element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϵ
                  %mo ∈
                  %mi D
                %annotation{:encoding => "application/x-tex"} \epsilon \in D
            such that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ϵ
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \epsilon^{n + 1} = 0
            %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %msup
                      %mi C
                      %mi ω
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \in C^\omega(K)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi A
                  %mo :
                  %mi A
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} f_A:A \to A
            such that for all elements
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi K
                  %annotation{:encoding => "application/x-tex"} x \in K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi h
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi h
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f_A(h(x)) = h(f(x))
            and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi h
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mi ϵ
                  %mo{:stretchy => "false"} )
                  %mo =
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi i
                      %mo =
                      %mn 0
                    %mi n
                  %mfrac
                    %mn 1
                    %mrow
                      %mi i
                      %mo !
                  %mi h
                  %mrow
                    %mo (
                    %mfrac
                      %mrow
                        %msup
                          %mi d
                          %mi i
                        %mi f
                      %mrow
                        %mi d
                        %msup
                          %mi x
                          %mi i
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo )
                  %msup
                    %mi ϵ
                    %mi i
                %annotation{:encoding => "application/x-tex"} f_A(h(x) + \epsilon) = \sum_{i = 0}^{n} \frac{1}{i!} h\left(\frac{d^i f}{d x^i}(x)\right) \epsilon^i
          %p
            If we restrict to Archimedean ordered Artinian local
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            where every element of the nilradical
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            is a nilsquare element, where for all
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo ∈
                    %mi D
                  %annotation{:encoding => "application/x-tex"} \epsilon \in D
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ϵ
                      %mn 2
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \epsilon^2 = 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %mo :
                  %mi K
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} h:K \to A
            preserves
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/differentiable+functions"} differentiable functions
            %a.existingWikiWord{:href => "/nlab/show/differentiable+function"} differentiable function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi K
                  %mo →
                  %mi K
                %annotation{:encoding => "application/x-tex"} f:K \to K
            with given
            %a.existingWikiWord{:href => "/nlab/show/derivative"} derivative
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ′
                    %mo :
                    %mi K
                    %mo →
                    %mi K
                  %annotation{:encoding => "application/x-tex"} f':K \to K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi A
                  %mo :
                  %mi A
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} f_A:A \to A
            such that for all elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi K
                %annotation{:encoding => "application/x-tex"} x \in K
            and nilpotent elements
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo ∈
                    %mi D
                  %annotation{:encoding => "application/x-tex"} \epsilon \in D
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi h
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi h
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f_A(h(x)) = h(f(x))
            and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi h
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mi ϵ
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi h
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mi h
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ′
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mi ϵ
                %annotation{:encoding => "application/x-tex"} f_A(h(x) + \epsilon) = h(f(x)) + h(f'(x)) \epsilon
          %p
            In particular, every
            %a.existingWikiWord{:href => "/nlab/show/polynomial+function"} polynomial function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo :
                  %mi K
                  %mo →
                  %mi K
                %annotation{:encoding => "application/x-tex"} p:K \to K
            lifts to a polynomial function
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi A
                    %mo :
                    %mi A
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} p_A:A \to A
          %p
            Alternatively, one could use this property to define differentiable and smooth functions in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/exponential+function"} exponential function
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/natural+logarithm"} natural logarithm
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/sine+function"} sine function
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cosine+function"} cosine function
          %p
            One could also work with
            %a.existingWikiWord{:href => "/nlab/show/partial+functions"} partial functions
            instead. Given a predicate
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            on the real numbers
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            denote the set of all elements in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            for which
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            holds. A
            %a.existingWikiWord{:href => "/nlab/show/partial+function"} partial function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi ℝ
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} f:\mathbb{R} \to \mathbb{R}
            is equivalently a function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi I
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} f:I \to \mathbb{R}
            for any such predicate
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            and set
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
          %p
            A function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi I
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} f:I \to \mathbb{R}
            is
            %strong smooth at a subset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo ⊆
                  %mi I
                %annotation{:encoding => "application/x-tex"} S \subseteq I
            with injection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                  %mo :
                  %mi S
                  %mo ↪
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} j:S \hookrightarrow \mathbb{R}
            if it has a function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %msup
                        %mi d
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi f
                    %mrow
                      %mi d
                      %msup
                        %mi x
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo :
                  %mi ℕ
                  %mo ×
                  %mi S
                  %mo →
