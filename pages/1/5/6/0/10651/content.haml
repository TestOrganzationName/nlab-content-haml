                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\underset{i \geq 0}{\sum} (-1)^i \widehat{cycl}(R^i \pi_\ast(V))
                  + a(something)
                  \\simeq
                  \\widehat{tr}_\pi(\widehat{cycl}(V))
          %p
            where the hats denote the
            %a.existingWikiWord{:href => "/nlab/show/differential+cohomology"} differential cohomology
            refinement.
          %p
            See at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Becker-Gottlieb+transfer"} Becker-Gottlieb transfer
          %h3#RelationToComplexVolumes Relation to complex volumes and Bloch group
          %p
            There is some relation between the Borel regulators and
            %a.existingWikiWord{:href => "/nlab/show/complex+volumes"} complex volumes
            of
            %a.existingWikiWord{:href => "/nlab/show/hyperbolic+manifolds"} hyperbolic manifolds
            via maps out of the
            %a.existingWikiWord{:href => "/nlab/show/Bloch+group"} Bloch group
            (
            %a{:href => "#Suslin90"}> Suslin 90
            ,
            = succeed "," do
              %a{:href => "#NeumannYang97"} Neumann-Yang 97, p. 17
            = succeed "," do
              %a{:href => "#Zickert07"} Zickert 07, p. 3
            = succeed ")." do
              %a{:href => "#Zickert09"} Zickert 09
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            an
            %a.existingWikiWord{:href => "/nlab/show/algebraic+number+field"} algebraic number field
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi σ
                    %mn 1
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %msub
                    %mi σ
                    %mrow
                      %msub
                        %mi r
                        %mn 2
                  %mo{:lspace => "verythinmathspace"} :
                  %mi k
                  %mo →
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} \sigma_1, \cdots, \sigma_{r_2}\colon k \to \mathbb{C}
            its complex embeddings up to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/conjugation"} conjugation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi vol
                    %mi j
                  %mo ≔
                  %mi vol
                  %mo ∘
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi σ
                    %mi j
                  %mo{:stretchy => "false"} )
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi H
                    %mn 3
                  %mo{:stretchy => "false"} (
                  %mi PSL
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo ,
                  %mi k
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"}
                  vol_j \coloneqq vol \circ (\sigma_j)\colon H_3(PSL(2,k), \mathbb{Z})
                  \\to \mathbb{R}
          %p Then then map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi vol
                    %mn 1
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %msub
                    %mi vol
                    %mrow
                      %msub
                        %mi r
                        %mn 2
                  %mo{:stretchy => "false"} )
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi H
                    %mn 3
                  %mo{:stretchy => "false"} (
                  %mi PSL
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo ,
                  %mi k
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %msup
                    %mi ℝ
                    %mrow
                      %msub
                        %mi r
                        %mn 2
                %annotation{:encoding => "application/x-tex"}
                  (vol_1, \cdots, vol_{r_2}) \colon H_3(PSL(2,k),\mathbb{Z}) \longrightarrow \mathbb{R}^{r_2}
          %p
            is the Borel regulator (
            %a{:href => "#Neumann11"}> Neumann 11, p. 6
            ).
          %p
            For the moment, see at
            %em
              %a.existingWikiWord{:href => "/nlab/show/Bloch+group"} Bloch group
            for more details.
          %h2#related_concepts Related concepts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Beilinson+conjecture"} Beilinson conjecture
          %h2#references References
          %p The Borel regulator is due to
          %ul
            %li#Borel71
              %p
                %a.existingWikiWord{:href => "/nlab/show/Armand+Borel"}> Armand Borel
                ,
                = succeed "," do
                  %em
                    Cohomologie de
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi SL
                            %mi n
                        %annotation{:encoding => "application/x-tex"} SL_n
                    et valeurs de fonctions de zeta
            %li#Borel74
              %p
                %a.existingWikiWord{:href => "/nlab/show/Armand+Borel"}> Armand Borel
                ,
                = succeed "," do
                  %em Stable real cohomology of arithmetic groups
          %p
            The Beilinson regulator with values in
            %a.existingWikiWord{:href => "/nlab/show/Deligne+cohomology"} Deligne cohomology
            is due to
          %ul
            %li#Bloch78
              %p
                %a.existingWikiWord{:href => "/nlab/show/Spencer+Bloch"}> Spencer Bloch
                ,
                = succeed "," do
                  %em Applications of the dilogarithm function in algebraic K-theory and algebraic geometry
            %li#Bloch81
              %p
                %a.existingWikiWord{:href => "/nlab/show/Spencer+Bloch"}> Spencer Bloch
                ,
                = succeed "," do
                  %em The dilogarithm and extensions of Lie algebras
            %li#Beilinson85
              %p
                %a.existingWikiWord{:href => "/nlab/show/Alexander+Beilinson"} Alexander Beilinson
                = succeed "," do
                  %em Higher regulators and values of L-functions
                = succeed "," do
                  %a{:href => "http://www.mathnet.ru/php/archive.phtml?wshow=paper&jrnid=intd&paperid=73&option_lang=eng"} mathnet (Russian)
                = succeed ")" do
                  %a{:href => "http://dx.doi.org/10.1007%2FBF02105861"} DOI
            %li#Beilinson80
              %p
                %a.existingWikiWord{:href => "/nlab/show/Alexander+Beilinson"}> Alexander Beilinson
                ,
                = succeed "," do
                  %em Higher regulators of curves
                = succeed "." do
                  %a{:href => "http://www.mathnet.ru/php/archive.phtml?wshow=paper&jrnid=faa&paperid=1800&option_lang=eng"} mathnet (Russian)
            %li#Beilinson87
              %p
                %a.existingWikiWord{:href => "/nlab/show/Alexander+Beilinson"}> Alexander Beilinson
                ,
                = succeed "," do
                  %em Height pairing between algebraic cycles
                = succeed "," do
                  %em K-Theory, Arithmetic and Geometry
                = succeed "." do
                  %a{:href => "http://dx.doi.org/10.1007/BFb0078364"} DOI
          %p reviewed in
          %ul
            %li#Soule84
              %p
                %a.existingWikiWord{:href => "/nlab/show/Christophe+Soul%C3%A9"}> Christophe Soulé
                ,
                %em Régulateurs
                Séminaire Bourbaki, 27 (1984-1985), Exp. No. 644, 17 p. (
                %a{:href => "http://www.numdam.org/item?id=SB_1984-1985__27__237_0"}> Numdam
                )
            %li#EsnaultViehweg88
              %p
                %a.existingWikiWord{:href => "/nlab/show/H%C3%A9l%C3%A8ne+Esnault"}> Hélène Esnault
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Eckart+Viehweg"} Eckart Viehweg
                %em Deligne-Beilinson cohomology
                in Rapoport, Schappacher, Schneider (eds.)
                %em Beilinson’s Conjectures on Special Values of L-Functions
                \. Perspectives in Math. 4, Academic Press (1988) 43 - 91 (
                %a{:href => "http://www.uni-due.de/~mat903/preprints/ec/deligne_beilinson.pdf"}> pdf
                )
            %li#Goncharov04
              %p
                %a.existingWikiWord{:href => "/nlab/show/Alexander+Goncharov"}> Alexander Goncharov
                ,
                = succeed "," do
                  %em Regulators
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/math/0407308"} arXiv:0407308
          %p
            A discussion of the Beilinson regulator on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi K
                    %mn 2
                %annotation{:encoding => "application/x-tex"} K_2
            in terms of
            %a.existingWikiWord{:href => "/nlab/show/bundle+gerbes"} bundle gerbes
            is in
          %ul
            %li#Brylinski94
              %a.existingWikiWord{:href => "/nlab/show/Jean-Luc+Brylinski"}> Jean-Luc Brylinski
              ,
              = succeed "," do
                %em Holomorphic gerbes and the Beilinson regulator
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/files/Brylinski94.pdf", :title => "pdf"} pdf
          %p See also
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Christophe+Soul%C3%A9"}> Christophe Soulé
              ,
              = succeed "," do
                %em On higher p-adic regulators
              = succeed ")" do
                %a{:href => "http://link.springer.com/chapter/10.1007%2FBFb0089530"} publisher page
          %p
            The relation to
            %a.existingWikiWord{:href => "/nlab/show/Chern+characters"} Chern characters
            is made very explicit in
          %ul
            %li#Tamme12
              %a.existingWikiWord{:href => "/nlab/show/Georg+Tamme"}> Georg Tamme
              ,
              = succeed "," do
                %em Karoubi’s relative Chern character and Beilinson’s regulator
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/files/TammeRegulator.pdf", :title => "pdf"} pdf
          %p see also
          %ul
            %li#DeningerScholl
              %a.existingWikiWord{:href => "/nlab/show/Christopher+Deninger"}> Christopher Deninger
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Anthony+Scholl"} Anthony Scholl
              %em The Beilinson conjectures
              (
              %a{:href => "https://www.dpmms.cam.ac.uk/~ajs1005/preprints/d-s.pdf"}> pdf
              )
          %p
            The interpretation of these regulator Chern characters in
            %a.existingWikiWord{:href => "/nlab/show/differential+algebraic+K-theory"} differential algebraic K-theory
            is due to
          %ul
            %li#BunkeGepner13
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ulrich+Bunke"}> Ulrich Bunke
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/David+Gepner"} David Gepner
                %em Differential function spectra, the differential Becker-Gottlieb transfer, and applications to differential algebraic K-theory
                (
                %a{:href => "http://arxiv.org/abs/1306.0247"}> arXiv:1306.0247
                )
            %li#BunkeTamme12
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ulrich+Bunke"}> Ulrich Bunke
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Georg+Tamme"} Georg Tamme
                %em Regulators and cycle maps in higher-dimensional differential algebraic K-theory
                (
                %a{:href => "http://arxiv.org/abs/1209.6451"}> arXiv:1209.6451
                )
            %li#BunkeNikolausTamme15
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ulrich+Bunke"}> Ulrich Bunke
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Thomas+Nikolaus"} Thomas Nikolaus
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Georg+Tamme"} Georg Tamme
                %em The Beilinson regulator is a map of ring spectra
                (
                %a{:href => "http://arxiv.org/abs/1509.05667"}> arXivL1509.05667
                )
            %li#Bunke14
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ulrich+Bunke"}> Ulrich Bunke
                ,
                %em A regulator for smooth manifolds and an index theorem
                (
                %a{:href => "http://arxiv.org/abs/1407.1379"}> arXiv:1407.1379
                )
          %p based on
          %ul
            %li#BismutLott95
              %a.existingWikiWord{:href => "/nlab/show/Jean-Michel+Bismut"}> Jean-Michel Bismut
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/John+Lott"} John Lott
              %em Flat vector bundles, direct images and
              %p higher real analytic torsion_, J. Amer. Math. Soc. 8 (1995), no. 2, 291-363.
          %p See also
          %ul
            %li#Weibel84
              %p
                %a.existingWikiWord{:href => "/nlab/show/Charles+Weibel"}> Charles Weibel
                ,
                = succeed "," do
                  %em Algebraic K-theory and the Adams e-invariant
                = succeed "(Bielefeld," do
                  %em Algebraic K-theory, number theory, geometry and analysis
                %a{:href => "http://www.math.illinois.edu/K-theory/handbook/1-139-190.pdf"} pdf
            %li#Suslin84
              %p
                A.A. Suslin,
                = succeed "," do
                  %em On the K-theory of local fields
            %li
              %p
                Wikipedia,
                %em
                  %a{:href => "http://en.wikipedia.org/wiki/Beilinson_regulator"} Beilinson regulator
          %p
            For more references see also at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Beilinson+conjecture"} Beilinson conjecture
          %p
            Relation of the Borel regulator to the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Bloch+group"} Bloch group
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/Cheeger-Simons+class"} Cheeger-Simons class
            %a.existingWikiWord{:href => "/nlab/show/complex+volumes"} complex volumes
            of
            %a.existingWikiWord{:href => "/nlab/show/hyperbolic+manifolds"} hyperbolic manifolds
            is discussed in
          %ul
            %li#Suslin90
              %p
                %a.existingWikiWord{:href => "/nlab/show/Andrei+Suslin"}> Andrei Suslin
                \.
                = succeed "." do
                  %em
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi K
                            %mn 3
                        %annotation{:encoding => "application/x-tex"} K_3
                    of a field, and the Bloch group
            %li#NeumannYang97
              %p
                %a.existingWikiWord{:href => "/nlab/show/Walter+Neumann"}> Walter Neumann
                , Jun Yang,
                = succeed "," do
                  %em Bloch invariants of hyperbolic 3-manifolds
                = succeed "," do
                  %a{:href => "http://arxiv.org/abs/math/9712224"} arXiv:math/9712224
                = succeed ")" do
                  %a{:href => "http://projecteuclid.org/euclid.dmj/1077228942"} Euclid
            %li#Zickert07
              %p
                %a.existingWikiWord{:href => "/nlab/show/Christian+Zickert"}> Christian Zickert
                ,
                = succeed "," do
                  %em The volume and Chern-Simons invariant of a representation
                = succeed "," do
                  %a{:href => "http://arxiv.org/abs/0710.2049"} arXiv:0710.2049
                = succeed ")" do
                  %a{:href => "http://projecteuclid.org/euclid.dmj/1259332507"} Euclid
            %li#Zickert09
              %p
                %a.existingWikiWord{:href => "/nlab/show/Christian+Zickert"}> Christian Zickert
                ,
                %em The extended Bloch group and algebraic K-theory
                (
                %a{:href => "http://arxiv.org/abs/0910.4005"}> arXiv:0910.4005
                )
            %li#Neumann11
              %p
                %a.existingWikiWord{:href => "/nlab/show/Walter+Neumann"}> Walter Neumann
                ,
                = succeed "," do
                  %em Realizing arithmetic invariants of hyperbolic 3-manifolds
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/1108.0062"} arXiv:1108.0062
