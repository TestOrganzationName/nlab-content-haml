          %h2#idea Idea
          %p
            %em Monodromy
            is the name for the
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            of the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+group+%28of+an+%E2%88%9E-stack%29"} homotopy groups
            of a
            %a.existingWikiWord{:href => "/nlab/show/space"} space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            on
            %a.existingWikiWord{:href => "/nlab/show/fibers"} fibers
            of
            %a.existingWikiWord{:href => "/nlab/show/covering+spaces"} covering spaces
            or
            %a.existingWikiWord{:href => "/nlab/show/locally+constant+%E2%88%9E-stacks"} locally constant ∞-stacks
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %h2#InPointSetTopology In point-set topology
          %p
            We discuss monodromy of
            %a.existingWikiWord{:href => "/nlab/show/covering+spaces"} covering spaces
            in elementary
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/point-set+topology"} point-set topology
          %h3#definition Definition
          #CoveringSpaceMonodromy.num_defn
            %h6#definition_2 Definition
            %p
              %strong
                (monodromy of a
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/covering+space"} covering space
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
                      %mi p
                    %mi X
                  %annotation{:encoding => "application/x-tex"} E \overset{p}{\to} X
              a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/covering+space"} covering space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi_1(X)
              for the
              %a.existingWikiWord{:href => "/nlab/show/fundamental+groupoid"} fundamental groupoid
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p
              Define a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Fib
                      %mi E
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi Set
                  %annotation{:encoding => "application/x-tex"}
                    Fib_E
                    \\;\colon\;
                    \\Pi_1(X)
                    \\longrightarrow
                    Set
            %p
              to the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              of
              %a.existingWikiWord{:href => "/nlab/show/sets"} sets
              as follows:
            %ol
              %li
                %p
                  to a point
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi X
                      %annotation{:encoding => "application/x-tex"} x \in X
                  assign the
                  %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi p
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mo{:stretchy => "false"} (
                          %mo{:stretchy => "false"} {
                          %mi x
                          %mo{:stretchy => "false"} }
                          %mo{:stretchy => "false"} )
                          %mo ∈
                          %mi Set
                        %annotation{:encoding => "application/x-tex"} p^{-1}(\{x\}) \in Set
              %li
                %p
                  to the
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+class"} homotopy class
                  of a
                  %a.existingWikiWord{:href => "/nlab/show/path"} path
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi γ
                      %annotation{:encoding => "application/x-tex"} \gamma
                  connecting
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ≔
                        %mi γ
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} x \coloneqq \gamma(0)
                  with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi y
                        %mo ≔
                        %mi γ
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} y \coloneqq \gamma(1)
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  assign the function
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi p
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} {
                        %mi x
                        %mo{:stretchy => "false"} }
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %msup
                          %mi p
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} {
                        %mi y
                        %mo{:stretchy => "false"} }
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} p^{-1}(\{x\}) \longrightarrow p^{-1}(\{y\})
                  which takes
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi x
                          %mo{:stretchy => "false"} ^
                        %mo ∈
                        %msup
                          %mi p
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} {
                        %mi x
                        %mo{:stretchy => "false"} }
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \hat x \in p^{-1}(\{x\})
                  to the endpoint of a path
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi γ
                          %mo{:stretchy => "false"} ^
                      %annotation{:encoding => "application/x-tex"} \hat \gamma
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
                  which lifts
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi γ
                      %annotation{:encoding => "application/x-tex"} \gamma
                  through
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
                  with starting point
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi γ
                          %mo{:stretchy => "false"} ^
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mover
                          %mi x
                          %mo{:stretchy => "false"} ^
                      %annotation{:encoding => "application/x-tex"} \hat \gamma(0) = \hat x
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %msup
                                  %mi p
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mn 1
                                %mo{:stretchy => "false"} (
                                %mi x
                                %mo{:stretchy => "false"} )
                              %mtd
                                %mover
                                  %mo ⟶
                                  %mrow
                              %mtd
                                %msup
                                  %mi p
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mn 1
                                %mo{:stretchy => "false"} (
                                %mi y
                                %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} (
                                %mover
                                  %mi x
                                  %mo{:stretchy => "false"} ^
                                %mo =
                                %mover
                                  %mi γ
                                  %mo{:stretchy => "false"} ^
                                %mo{:stretchy => "false"} (
                                %mn 0
                                %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} )
                              %mtd
                                %mo ↦
                              %mtd
                                %mover
                                  %mi γ
                                  %mo{:stretchy => "false"} ^
                                %mo{:stretchy => "false"} (
                                %mn 1
                                %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        p^{-1}(x) &amp;\overset{}{\longrightarrow}&amp; p^{-1}(y)
                        \\\
                        (\hat x = \hat \gamma(0)) &amp;\mapsto&amp; \hat \gamma(1)
                        }
                        \\,.
            %p
              This construction is well defined for a given representative
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                  %annotation{:encoding => "application/x-tex"} \gamma
              due to the unique path-lifting property of covering spaces (
              %a{:href => "covering+space#CoveringSpacePathLifting"}> this lemma
              ) and it is independent of the choice of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                  %annotation{:encoding => "application/x-tex"} \gamma
              in the given homotopy class of paths due to the homotopy-lifting property (
              %a{:href => "covering+space#CoveringSpacesHomotopyLifting"}> this lemma
              ). Similarly, these two lifting properties give that this construction respects composition in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi_1(X)
              and hence is indeed a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/functor"} functor
          %p
            Hence this defines a “
            %a.existingWikiWord{:href => "/nlab/show/permutation+representation"} permutation
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/groupoid+representation"} groupoid representation
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi_1(X)
          .num_prop
            %h6#proposition Proposition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              between two
              %a.existingWikiWord{:href => "/nlab/show/covering+spaces"} covering spaces
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mi i
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi p
                            %mi i
                      %mi X
                    %annotation{:encoding => "application/x-tex"} E_i \overset{p_i}{\to} X
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi E
                      %mn 1
                    %mo →
                    %msub
                      %mi E
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} f \colon E_1 \to E_2
              which respects
              %a.existingWikiWord{:href => "/nlab/show/fibers"} fibers
              in that the
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi E
                              %mn 1
                          %mtd
                          %mtd
                            %mover
                              %mo ⟶
                              %mi f
                          %mtd
                          %mtd
                            %msub
                              %mi E
                              %mn 2
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi p
                                    %mn 1
                            %mo ↘
                          %mtd
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi p
                                    %mn 2
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    E_1 &amp;&amp; \overset{f}{\longrightarrow} &amp;&amp; E_2
                    \\\
                    \&amp; {}_{\mathllap{p_1}}\searrow &amp;&amp; \swarrow_{\mathrlap{p_2}}
                    \\\
                    \&amp;&amp; X
                    }
            %p
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"}> commutes
              , then the component functions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mi x
                        %mo{:stretchy => "false"} }
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi p
                      %mn 1
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msubsup
                      %mi p
                      %mn 2
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    f\vert_{\{x\}} \;\colon\; p_1^{-1}(\{x\}) \longrightarrow p_2^{-1}(\{x\})
            %p
              are compatible with the monodromy
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Fib
                      %mi E
                  %annotation{:encoding => "application/x-tex"} Fib_{E}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CoveringSpaceMonodromy"}
              %a.existingWikiWord{:href => "/nlab/show/path"} path
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                  %annotation{:encoding => "application/x-tex"} \gamma
              between points
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
              from def.
              %a.maruku-ref{:href => "#CoveringSpaceMonodromy"}
              in that the following
              %a.existingWikiWord{:href => "/nlab/show/diagrams"} diagrams
              of
              %a.existingWikiWord{:href => "/nlab/show/sets"} sets
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commute
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msubsup
                              %mi p
                              %mn 1
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mi f
                                %msub
                                  %mo{:stretchy => "false"} |
                                  %mrow
                                    %mo{:stretchy => "false"} {
                                    %mi x
                                    %mo{:stretchy => "false"} }
                          %mtd
                            %msubsup
                              %mi p
                              %mn 2
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi Fib
                                    %mrow
                                      %msub
                                        %mi E
                                        %mn 1
                                  %mo{:stretchy => "false"} (
                                  %mo{:stretchy => "false"} [
                                  %mi γ
                                  %mo{:stretchy => "false"} ]
                                  %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi Fib
                                    %mrow
                                      %msub
                                        %mi E
                                        %mn 2
                                  %mo{:stretchy => "false"} (
                                  %mo{:stretchy => "false"} [
                                  %mi γ
                                  %mo{:stretchy => "false"} ]
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msubsup
                              %mi p
                              %mn 1
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mi y
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %mi f
                                %msub
                                  %mo{:stretchy => "false"} |
                                  %mrow
                                    %mo{:stretchy => "false"} {
                                    %mi y
                                    %mo{:stretchy => "false"} }
                          %mtd
                            %msubsup
                              %mi p
                              %mn 2
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mi y
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    p_1^{-1}(x) &amp;\overset{f\vert_{\{x\}}}{\longrightarrow}&amp; p_2^{-1}(x)
                    \\\
                    {}^{\mathllap{Fib_{E_1}([\gamma])}}\downarrow
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{ Fib_{E_2}([\gamma]) }}
                    \\\
                    p_1^{-1}(y) &amp;\underset{f\vert_{\{y\}}}{\longrightarrow}&amp; p_2^{-1}(y)
                    }
                    \\,.
            %p
              This means that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              induces a
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
              between the monodromy functors of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
