            %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
            any object. Then the
            %a.existingWikiWord{:href => "/nlab/show/locally+constant+%E2%88%9E-stacks"} locally constant ∞-stacks
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            are represented by morphisms
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi LConst
                    %mi Core
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mi Grpd
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \to LConst Core(\infty Grpd)
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functors"} (∞,1)-functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Core
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mi Grpd
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Pi(X) \to Core(\infty Grpd)
            This morphism exhibits the
            %strong monodromy
            of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/locally+constant+%E2%88%9E-stack"} locally constant ∞-stack
          %p
            Specifically, the restriction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi Ω
                    %mi x
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mn ∞
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"} \mathbf{B}\Omega_x \Pi(X) \hookrightarrow \Pi(X) \to \infty Grpd
            to the
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi Ω
                    %mi x
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{B}\Omega_x \Pi(X)
            of the
            %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop space object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Ω
                    %mi x
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Omega_x \Pi(X)
            at a chosen baspoint
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mo *
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} x : {*} \to X
            is the
            %strong
              monodromy
              %a.existingWikiWord{:href => "/nlab/show/action"} action
            of loops based at
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi X
                %annotation{:encoding => "application/x-tex"} x \in X
            on the fiber of the locally constant
            = succeed "-stack" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
