          %h2#idea Idea
          %p
            Equivariant stable homotopy theory over some
            %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is the
            %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+theory"} stable homotopy theory
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/G-spectra"} G-spectra
            %a.existingWikiWord{:href => "/nlab/show/naive+G-spectra"} naive G-spectra
            which constitute the actual
            %a.existingWikiWord{:href => "/nlab/show/stabilization"} stabilization
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/equivariant+homotopy+theory"} equivariant homotopy theory
            = succeed "." do
              %em
                genuine
                = succeed "-spectra" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
            = succeed "-spectrum" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
            graded not by the group of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/integers"} integers
            %a.existingWikiWord{:href => "/nlab/show/representation+ring"} representation ring
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            (usually called
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/RO%28G%29-grading"} RO(G)-grading
          %p
            The concept of
            %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            in equivariant stable homotopy theory is
            = succeed ":" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/equivariant+cohomology"} equivariant cohomology
          %div
            %p
              %strong>
                %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
                in the presence of
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-action"} ∞-action
              \:
            %table
