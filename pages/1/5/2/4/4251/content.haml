                        %msub
                          %mi π
                          %mn 0
                        %mi Et
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\Pi_0(A) = \pi_0 Et(A)
                        \\,.
          .proof
            %h6#proof Proof
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/etale+space"} etale space
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi LConst
                      %mi S
                  %annotation{:encoding => "application/x-tex"} LConst_S
              is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi LConst
                        %mi S
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi X
                      %mo ×
                      %mi S
                    %annotation{:encoding => "application/x-tex"} E(LConst_S) = X \times S
              %a.existingWikiWord{:href => "/nlab/show/sheaves"} sheaves
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/etale+space"} etale space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mrow
                        %mi Sh
