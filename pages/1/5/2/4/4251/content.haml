            if the
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/global+section"} global section
            %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi LConst
                  %mo ⊣
                  %mi Γ
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi E
                  %mover
                    %mover
                      %mo →
                      %mi Γ
                    %mover
                      %mo ←
                      %mi LConst
                  %mi Set
                %annotation{:encoding => "application/x-tex"} (LConst \dashv \Gamma) : E \stackrel{\overset{LConst}{\leftarrow}}{\overset{\Gamma}{\to}} Set
            is in fact an
            %a.existingWikiWord{:href => "/nlab/show/essential+geometric+morphism"} essential geometric morphism
            in that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi LConst
