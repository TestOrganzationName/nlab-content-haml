                  %mo ∈
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            an
            %a.existingWikiWord{:href => "/nlab/show/%28n%2C1%29-topos"} (n,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            is a
            %a.existingWikiWord{:href => "/nlab/show/locally+n-connected+%28%E2%88%9E%2C1%29-topos"} locally n-connected (n,1)-topos
            if again the terminal geometric morphism is an essential geometric morphism in that the
            %a.existingWikiWord{:href => "/nlab/show/constant+stack"} constant n-stack
            functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi LConst
                %annotation{:encoding => "application/x-tex"} LConst
            has a
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Π
                    %mi n
                %annotation{:encoding => "application/x-tex"} \Pi_n
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Π
                    %mi n
                  %mo ⊣
                  %mi LConst
                  %mo ⊣
                  %mi Γ
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mover
                    %mover
                      %mover
                        %mo →
                        %mi Γ
                      %mover
                        %mo ←
                        %mi LConst
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi Π
                          %mi n
                  %mi n
                  %mi Grpd
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (\Pi_n \dashv LConst \dashv \Gamma)
                  \:
                  \\mathbf{H}
                  \\stackrel{\overset{\Pi_n}{\to}}{\stackrel{\overset{LConst}{\leftarrow}}{\overset{\Gamma}{\to}}}
                  n Grpd
                  \\,.
          %p
            Here we may take
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} n = \infty
            and say that an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            is
            %a.existingWikiWord{:href => "/nlab/show/locally+n-connected+%28%E2%88%9E%2C1%29-topos"} locally contractible
            if we have an
            %a.existingWikiWord{:href => "/nlab/show/essential+geometric+morphism"} essential geometric morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Π
                  %mo ⊣
                  %mi LConst
                  %mo ⊣
                  %mi Γ
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mover
                    %mover
                      %mover
                        %mo →
                        %mi Γ
                      %mover
                        %mo ←
                        %mi LConst
                    %mover
                      %mo →
                      %mi Π
                  %mn ∞
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"}
                  (\Pi \dashv LConst \dashv \Gamma)
                  \:
                  \\mathbf{H}
                  \\stackrel{\overset{\Pi}{\to}}{\stackrel{\overset{LConst}{\leftarrow}}{\overset{\Gamma}{\to}}}
                  \\infty Grpd
          %p
            to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                %annotation{:encoding => "application/x-tex"} \Pi
            the left
            %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functor"} adjoint (∞,1)-functor
            to the
            %a.existingWikiWord{:href => "/nlab/show/constant+%E2%88%9E-stack"} constant ∞-stack
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi LConst
                  %annotation{:encoding => "application/x-tex"} LConst
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
            any object, the
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Pi(X)
            deserves to be called the
            %strong
              %a.existingWikiWord{:href => "/nlab/show/fundamental+%E2%88%9E-groupoid+in+a+locally+%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} fundamental ∞-groupoid in a locally ∞-connected (∞,1)-topos
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            Its ordinary
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+group"} homotopy group
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            While an obvious slight generalization or refinement of what is considered in previous literature, it seems that the simple picture of a left
            %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functor"} adjoint (∞,1)-functor
            to the
            %a.existingWikiWord{:href => "/nlab/show/constant+%E2%88%9E-stack"} constant ∞-stack
            functor has not been made explicit in the existing literature (though possibly in the thesis by
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Richard+Williamson"} Richard Williamson
          %p
            However, up to some straightforward translations of concepts and notation, it turns out that essentially all aspects of this picture are present and well known – if somewhat implicitly – in existing literature. A detailed commented account of what is in the literature is in the following subsection and in particular in the section
            %a{:href => "#GeomExamples"} Examples
            below.
          %p
            There are essentially three different methods concretely constructing the abstractly defined
            = succeed "-functor" do
              %span.newWikiWord
                homotopy ∞-groupoid
                %a{:href => "/schreiber/new/homotopy+%E2%88%9E-groupoid"} ?
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi(-)
          %ol
            %li
              %p
                by constructing the left adjoint
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Π
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Pi(-)
                as the functor that takes an object to its
                %strong local contraction
                – this is described in the section
                %em
                  %a{:href => "#LocalContraction"}> In terms of local contractions
                  ;
            %li
              %p
                by using
                = succeed "/" do
                  %strong monodromy
                %a.existingWikiWord{:href => "/nlab/show/Galois+theory"} Galois theory
                of
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/locally+constant+%E2%88%9E-stack"} locally constant ∞-stack
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Π
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Pi()
                by
                %a.existingWikiWord{:href => "/nlab/show/Tannaka+duality"} Tannaka duality
                – this is described in the section
                = succeed ";" do
                  %a{:href => "Monodromy"} In terms of monodromy and Galois theory
            %li
              %p
                by constructing
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Π
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Pi(-)
                explicitly as a path
                = succeed "-groupoid" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
                %a.existingWikiWord{:href => "/nlab/show/interval+object"} interval object
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}
                – this is described in the section
                %em
                  %a{:href => "Paths"} In terms of concrete paths
                \.
          %h2#LocalContraction In terms of local contractions
          %p
            If the
            %a.existingWikiWord{:href => "/nlab/show/locally+contractible+%28%E2%88%9E%2C1%29-topos"} locally contractible (∞,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            has a
            %a.existingWikiWord{:href => "/nlab/show/site"} site
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo ≃
                  %msub
                    %mi Sh
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{H} \simeq Sh_{(\infty,1)}(C)
            such that the objects of the site are
            %strong geometrically contractible
            in that
            %em constant
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-presheaf"} (∞,1)-presheaves
            already satisfy
            %a.existingWikiWord{:href => "/nlab/show/descent"} descent
            over objects in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo →
                  %mn ∞
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"} \Pi : \mathbf{H} \to \infty Grpd
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi LConst
                %annotation{:encoding => "application/x-tex"} LConst
            may be constructed explicitly as follows.
          %p
            Following the discussion at
            %a.existingWikiWord{:href => "/nlab/show/models+for+%E2%88%9E-stack+%28%E2%88%9E%2C1%29-toposes"} models for ∞-stack (∞,1)-toposes
            there is a
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi sPSh
                  %mo{:stretchy => "false"} (
                  %mi C
                  %msubsup
                    %mo{:stretchy => "false"} )
                    %mi proj
                    %mi loc
                %annotation{:encoding => "application/x-tex"} sPSh(C)_{proj}^{loc}
            wich
            %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-category"} presents
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
          %p
            %strong Proposition
            The
            %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functor"} (∞,1)-adjunction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Π
                  %mo ⊣
                  %mi LConst
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msub
                    %mi Sh
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mo ←
                  %mn ∞
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"} (\Pi \dashv LConst) : Sh_{(\infty,1)}(C) \stackrel{\leftarrow}{\to} \infty Grpd
            is presented by an
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/SSet"} SSet
            %a.existingWikiWord{:href => "/nlab/show/enriched+category+theory"} enriched
            %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Π
                  %mo ⊣
                  %mi LConst
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi sPSh
                  %mo{:stretchy => "false"} (
                  %mi C
                  %msubsup
                    %mo{:stretchy => "false"} )
                    %mi proj
                    %mi loc
                  %mover
                    %mover
                      %mo ←
                      %mi LConst
                    %mover
                      %mo →
                      %mi Π
                  %msub
                    %mi sSet
                    %mi Quillen
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  (\Pi \dashv LConst) : sPSh(C)_{proj}^{loc}
                  \\stackrel{\overset{\Pi}{\to}}{\overset{LConst}{\leftarrow}}
                  sSet_{Quillen}
                  \\,,
          %p where
          %ul
            %li
              %p
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo ∈
                      %mi sSet
                    %annotation{:encoding => "application/x-tex"} S \in sSet
                the presheaf
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi LConst
                        %mi S
                    %annotation{:encoding => "application/x-tex"} LConst_S
                sends all
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo ↦
                        %mi S
                      %annotation{:encoding => "application/x-tex"} U \mapsto S
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                      %annotation{:encoding => "application/x-tex"} U
            %li
              %p
                the functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Π
                    %annotation{:encoding => "application/x-tex"} \Pi
                acts by
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Π
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo =
                        %msup
                          %mo ∫
                          %mrow
                            %mi U
                            %mo ∈
                            %mi C
                        %mi X
                        %mo =
                        %msub
                          %mi lim
                          %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} \Pi(X) = \int^{U \in C} X = \lim_\to X
          %p
            The total left
            %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived functor
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                %annotation{:encoding => "application/x-tex"} \Pi
            first takes an object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to a
            %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaf"} simplicial presheaf
            that is degreewise a
            %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
            of
            %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representables
            and then
            %em contracts
            all these representables to the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝕃
                  %mi Π
                  %mo :
                  %mi X
                  %mo ↦
                  %mi Q
                  %mi X
                  %mo =
                  %msup
                    %mo ∫
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo ∈
                      %mi Δ
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo ⋅
                  %mrow
                    %mo (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %msub
                          %mi i
                          %mi n
                    %msub
                      %mi U
                      %mi i
                    %mo )
                  %mo ↦
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %mi Q
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msup
                    %mo ∫
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo ∈
                      %mi Δ
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo ⋅
                  %mrow
                    %mo (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %msub
                          %mi i
                          %mi n
                    %mo *
                    %mo )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbb{L} \Pi :
                  X \mapsto
                  Q X = \int^{[n] \in \Delta} \Delta[n] \cdot
                  \\left( \coprod_{i_n} U_i \right)
                  \\mapsto
                  \\Pi(Q X) =
                  \\int^{[n] \in \Delta} \Delta[n] \cdot
                  \\left( \coprod_{i_n} * \right)
                  \\,.
          %p
            %strong Proof
          %p
            This is discussed at
            %a.existingWikiWord{:href => "/nlab/show/fundamental+%E2%88%9E-groupoid+of+a+locally+%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} fundamental ∞-groupoid of a locally ∞-connected (∞,1)-topos
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
          %h3#LocalContractionRef References
          %p
            Essentially the construction of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝕃
                  %mi Π
                %annotation{:encoding => "application/x-tex"} \mathbb{L} \Pi
            as above is an old construction in terms of – somewhat implicitly – the structure of a
            %a.existingWikiWord{:href => "/nlab/show/category+of+fibrant+objects"} category of fibrant objects
            on
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+object"} simplicial object
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/topos"} topos
          %p the discussion on page 18 of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Ieke+Moerdijk"}> Ieke Moerdijk
              ,
              %em Classifying Spaces and Classifying Topoi
              Lecture Notes in Mathematics 1616, Springer (1995) .
          %p which goes back to
          %ul
            %li
              Artin, Mazur,
              %em Etale Homotopy
              Springer Lecture Notes in Mathematics 100, Berlin (1969)
          %p goes as follows:
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo =
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E = Sh(C)
            be a
            %a.existingWikiWord{:href => "/nlab/show/locally+connected+topos"} locally connected topos
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Π
                    %mn 0
                  %mo ⊣
                  %mi LConst
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mo ←
                  %mi Set
                %annotation{:encoding => "application/x-tex"}
                  (\Pi_0 \dashv LConst) : Sh(C) \stackrel{\leftarrow}{\to} Set
          %p
            that here we think of as a
            %a.existingWikiWord{:href => "/nlab/show/petit+topos"} petit
            over-topos over a given object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            in some ambient
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/gros+topos"} gros topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo =
                  %mo *
                %annotation{:encoding => "application/x-tex"} X = *
            for the
            %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh(C)
          %p
            Assume that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            has
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/point+of+a+topos"} enough point
            = succeed "wise" do
              %a.existingWikiWord{:href => "/nlab/show/stalk"} stalk
            %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"} Kan-fibrant
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+object"} simplicial object
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            = succeed "-wise" do
              %a.existingWikiWord{:href => "/nlab/show/stalk"} stalk
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            form a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/category+of+fibrant+objects"} category of fibrant objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                  %mo ∈
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi Δ
                    %mi op
                  %mo ,
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} Y \in [\Delta^{op}, Sh(C)]
            equipped with an acyclic fibration
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} Y \to X
            to the
            %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo =
                  %mo *
                %annotation{:encoding => "application/x-tex"} X = *
            is a
            %a.existingWikiWord{:href => "/nlab/show/hypercover"} hypercover
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            The definition of the
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Pi(X)
            as defined in the above references (notice that only its homotopy groups are written down explicitly there, but it’s immediate to equivalently write it as we do now) is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo =
                  %munder
                    %mi lim
                    %mo →
                  %msub
                    %mi Π
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Y
                    %mo •
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\Pi(X) =
                  \\lim_\to \Pi_0( Y_\bullet)
                  \\,,
          %p where
          %ul
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
                is taken over the category of acyclic fibrations/hypercovers
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} Y \to X
            %li
              %p
                the connected components functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Π
                        %mn 0
                      %mo :
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} \Pi_0 : Sh(C) \to Set
                is applied degreewise to the simplicial sheaf
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                      %mo =
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Y
                        %mo •
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Y = (Y_\bullet)
                to produce a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
          %p
            In Artin-Mazur it is discussed that this prescription does produce the right homotopy groups for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            a
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            if one assumes that this space is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/locally+contractible+space"} locally contractible space
          %p
            If we therefore interpret this as saying that for the above prescription to yield the correct result we generally ought to assume that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Sh
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sh_{(\infty,1)}(C)
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/locally+contractible+%28%E2%88%9E%2C1%29-topos"} locally contractible (∞,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Pi(-)
            that we described above:
          %p
            In terms of the full
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            structure on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi sPSh
                  %mo{:stretchy => "false"} (
                  %mi C
                  %msubsup
                    %mo{:stretchy => "false"} )
                    %mi proj
                    %mi loc
                %annotation{:encoding => "application/x-tex"} sPSh(C)_{proj}^{loc}
            among all these hypercovers is one that is the cofibrant object
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                  %mo =
                  %mi Q
                  %mi X
                  %mo =
                  %msup
                    %mo ∫
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo ∈
                      %mi Δ
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo ⋅
                  %mrow
                    %mo (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %msub
                          %mi i
                          %mi n
                    %msub
                      %mi U
                      %mi i
                    %mo )
                %annotation{:encoding => "application/x-tex"}
                  Y = Q X = \int^{[n] \in \Delta} \Delta[n] \cdot
                  \\left(
                  \\coprod_{i_n} U_i
                  \\right)
          %p
            mentioned above, consisting degreewise of coproducts of representables with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \Pi_0(U_i) = *
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            admits a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            to be the
            %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
            of that good cover. (For more on this see
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+groupoid"} ∞-Lie groupoid
          %p There the Artin-Mazur-Moerdijk-prescription yields
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %mi Q
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi Π
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mi Q
                  %mi X
                  %msub
                    %mo{:stretchy => "false"} )
                    %mo •
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msup
                    %mo ∫
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo ∈
                      %mi Δ
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo ⋅
                  %msub
                    %mi Π
                    %mn 0
                  %mrow
                    %mo (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %msub
                          %mi i
                          %mi n
                    %msub
                      %mi U
                      %mrow
                        %msub
                          %mi i
                          %mi n
                    %mo )
                  %mo =
                  %msup
                    %mo ∫
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo ∈
                      %mi Δ
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo ⋅
                  %msub
                    %mi Π
                    %mn 0
                  %mrow
                    %mo (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %msub
                          %mi i
                          %mi n
                    %mo *
                    %mo )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\Pi(Q X) =
                  \\Pi_0((Q X)_\bullet)
                  \=
                  \\int^{[n] \in \Delta}
                  \\Delta[n] \cdot \Pi_0\left(
                  \\coprod_{i_n} U_{i_n}
                  \\right)
                  \=
                  \\int^{[n] \in \Delta}
                  \\Delta[n] \cdot \Pi_0\left(
                  \\coprod_{i_n} *
                  \\right)
                  \\,.
          %p This is indeed the action of the left Quillen functor from above.
          %p
            It is the
            %a.existingWikiWord{:href => "/nlab/show/nerve+theorem"} nerve theorem
            that asserts that for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            the
            %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
            of a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/paracompact+space"} paracompact space
          %p A closely related, implicitly slightly more general statement is in on p. 25 of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Daniel+Dugger"}> Daniel Dugger
              ,
              %em
                %a.existingWikiWord{:href => "/nlab/files/DuggerUniv.pdf", :title => "Universal homotopy theories"} Universal homotopy theories
          %p
            which describes this construction for the case
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo =
                  %msub
                    %mi Sh
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi Diff
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{H} = Sh_{(\infty,1)}(Diff)
            (the
            %a.existingWikiWord{:href => "/nlab/show/gros+topos"} gros topos
            of
            = succeed "-stacks" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Diff"} Diff
          %p
            With even more general sites allowed, but working only at the level of
            %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy categories
            the left adjoint
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                %annotation{:encoding => "application/x-tex"} \Pi
            and its construction is described in
            %a{:href => "http://math.berkeley.edu/~teleman/math/simpson.pdf#page=5"} Proposition 2.18
            of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Carlos+Simpson"}> Carlos Simpson
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Constantin+Teleman"} Constantin Teleman
              %em
                de Rham’s theorem for
                = succeed "-stacks" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
              (
              %a{:href => "http://math.berkeley.edu/~teleman/math/simpson.pdf"}> pdf
              )
          %p
            See also the discussion at
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/locally+contractible+%28%E2%88%9E%2C1%29-topos"} locally contractible (∞,1)-topos
          %h2#Monodromy In terms of monodromy and Galois theory
          %p
            Given an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo =
                  %msub
                    %mi Sh
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{H} = Sh_{(\infty,1)}(C)
            we define the
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/locally+constant+%E2%88%9E-stack"} locally constant ∞-stack
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
            to be
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn ∞
                  %mi CovBund
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msub
                    %mi LConst
                    %mrow
                      %mi Core
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mi Grpd
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\infty CovBund(X) := \mathbf{H}(X, LConst_{Core(\infty Grpd)})
                  \\,,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi LConst
                    %mrow
                      %mi Core
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mi Grpd
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} LConst_{Core(\infty Grpd)}
            is the
            %a.existingWikiWord{:href => "/nlab/show/constant+%E2%88%9E-stack"} constant ∞-stack
            on the
            %a.existingWikiWord{:href => "/nlab/show/core"} core
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            is a
            %a.existingWikiWord{:href => "/nlab/show/locally+contractible+%28%E2%88%9E%2C1%29-topos"} locally contractible (∞,1)-topos
            in that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi LConst
                %annotation{:encoding => "application/x-tex"} LConst
            has the left
            %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functor"} adjoint (∞,1)-functor
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi(-)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn ∞
                  %mi CovBund
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi Func
                  %mo{:stretchy => "false"} (
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mn ∞
                  %mi Grpd
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\infty CovBund(X) \simeq Func(\Pi(X), \infty Grpd)
          %p
            with
            = succeed "s/" do
              %a.existingWikiWord{:href => "/nlab/show/locally+constant+%E2%88%9E-stack"} locally constant ∞-stack
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/covering+space"} covering space
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Pi(X)
            to
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            on the other.
          %p
            Concrete realizations of this equivalence are discussed in the
            = succeed "-section" do
              %a{:href => "GeomExamples"} Examples
            %em
              %a.existingWikiWord{:href => "/nlab/show/reconstruction+theorem"} reconstruct
            in terms
            %a.existingWikiWord{:href => "/nlab/show/Tannaka+duality"} Tannaka duality
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Pi(X)
            from just knowing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn ∞
                  %mi CovBund
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \infty CovBund(X)
            in terms of the
            %a.existingWikiWord{:href => "/nlab/show/automorphism"} automorphism
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
            of a fiber functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mi x
                  %mo :
                  %mn ∞
                  %mi CovBund
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mn ∞
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"}
                  F_x :  \infty CovBund(X) \to \infty Grpd
          %p
            from
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "s/" do
              %a.existingWikiWord{:href => "/nlab/show/covering+space"} coverin bundle
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/locally+constant+%E2%88%9E-stack"} locally constant ∞-stack
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
          %p
            – these automorphism are called the
            %strong monodromy
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            We want to show that these automorphism
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop space object
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi(X)
            = succeed "-groups." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Aut
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi F
                    %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msubsup
                    %mi Ω
                    %mi x
                    %mi geom
                  %mi X
                  %mo =
                  %mo :
                  %msub
                    %mi Ω
                    %mi x
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Aut (F_x) = \Omega^{geom}_x X =: \Omega_x \Pi(X)
                  \\,.
          %p
            This is the reconstruction of the geometric homotopy
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-stack"} ∞-stack
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            from its
            %strong monodromy
            or
            = succeed "." do
              %strong
                %a.existingWikiWord{:href => "/nlab/show/Galois+theory"} Galois theory
          %p
            %strong Proof
          %p
            The underlying mechanism is just
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Tannaka+duality"} Tannaka duality
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Yoneda+lemma"} (∞,1)-Yoneda lemma
            applied a few times in a row:
          %p
            suppose we knew
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi(X)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CovBund
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mn ∞
                  %mi Func
                  %mo{:stretchy => "false"} (
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mn ∞
                  %mi Grpd
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  CovBund(X) \simeq \infty Func(\Pi(X), \infty Grpd)
                  \\,.
          %p
            Then for each point
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} x \in \Pi(X)
            given by a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo :
                  %mo *
                  %mo →
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} i : {*} \to \Pi(X)
            we get a fiber functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mi x
                  %mo :
                  %mo =
                  %mn ∞
                  %mi Func
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo ,
                  %mn ∞
                  %mi Grpd
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi Func
                  %mo{:stretchy => "false"} (
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mn ∞
                  %mi Grpd
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mn ∞
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"}
                  F_x := \infty Func(i, \infty Grpd) : Func(\Pi(X), \infty Grpd)
                  \\to \infty Grpd
          %p
            which takes a
            %a.existingWikiWord{:href => "/nlab/show/local+system"} local system
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                  %mo :
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mn ∞
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"} \rho : \Pi(X) \to \infty Grpd
            and evaluates it on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Yoneda+lemma"} (∞,1)-Yoneda lemma
            this means that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mi x
                %annotation{:encoding => "application/x-tex"} F_x
            is given by homming out of the local system
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Y
                    %mrow
                      %mi Π
                      %mo{:stretchy => "false"} (
                      %mi X
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi op
                  %mi x
                %annotation{:encoding => "application/x-tex"} Y_{\Pi(X)^{op}} x
            %a.existingWikiWord{:href => "/nlab/show/representable+functor"} represented by
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn ∞
                  %mi Func
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo ,
                  %mn ∞
                  %mi Grpd
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi Hom
                    %mrow
                      %msub
                        %mi PSh
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn ∞
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi Π
                      %mo{:stretchy => "false"} (
                      %mi X
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi op
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Y
                    %mrow
                      %mi Π
                      %mo{:stretchy => "false"} (
                      %mi X
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi op
                  %mo{:stretchy => "false"} )
                  %mi x
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\infty Func(i, \infty Grpd)
                  \\simeq
                  Hom_{PSh_{(\infty,1)}(\Pi(X)^{op})}(Y_{\Pi(X)^{op}}) x, -)
                  \\,.
          %p
            But this in turn means that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn ∞
                  %mi Func
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo ,
                  %mn ∞
                  %mi Grpd
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mn ∞
                  %mi Func
                  %mo{:stretchy => "false"} (
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mn ∞
                  %mi Grod
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mn ∞
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"} \infty Func(i,\infty Grpd) : \infty Func(\Pi(X),\infty Grod) \to \infty Grpd
            is itself a representable functor, in the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-presheaves"} (∞,1)-category of (∞,1)-presheaves
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi PSh
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi PSh
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PSh_{(\infty,1)}(PSh_{(\infty,1)}(\Pi(X)^{op})^{op})
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn ∞
                  %mi Func
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo ,
                  %mn ∞
                  %mi Grpd
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi Y
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi PSh
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn ∞
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi Π
                      %mo{:stretchy => "false"} (
                      %mi X
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi op
                      %mo{:stretchy => "false"} )
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi op
                  %msub
                    %mi Y
                    %mrow
                      %mi Π
                      %mo{:stretchy => "false"} (
                      %mi X
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi op
                  %mi x
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\infty Func(i, \infty Grpd)
                  \\simeq
                  Y_{(PSh_{(\infty,1)}(\Pi(X)^{op}))^{op}} Y_{\Pi(X)^{op}} x
                  \\,.
          %p
            This way we find, by applying the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Yoneda+lemma"} (∞,1)-Yoneda lemma
            two more times, that the automorphism
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
            of the fiber functor is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %msub
                            %mi Aut
                            %mrow
                              %msub
                                %mi PSh
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mn ∞
                                  %mo ,
                                  %mn 1
                                  %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} (
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi PSh
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mn ∞
                                  %mo ,
                                  %mn 1
                                  %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} (
                              %mi Π
                              %mo{:stretchy => "false"} (
                              %mi X
                              %msup
                                %mo{:stretchy => "false"} )
                                %mi op
                              %mo{:stretchy => "false"} )
                              %msup
                                %mo{:stretchy => "false"} )
                                %mi op
                              %mo{:stretchy => "false"} )
                          %mn ∞
                          %mi Func
                          %mo{:stretchy => "false"} (
                          %mi i
                          %mo ,
                          %mn ∞
                          %mi Grod
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo =
                          %msub
                            %mi Aut
                            %mrow
                              %msub
                                %mi PSh
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mn ∞
                                  %mo ,
                                  %mn 1
                                  %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} (
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi PSh
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mn ∞
                                  %mo ,
                                  %mn 1
                                  %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} (
                              %mi Π
                              %mo{:stretchy => "false"} (
                              %mi X
                              %msup
                                %mo{:stretchy => "false"} )
                                %mi op
                              %mo{:stretchy => "false"} )
                              %msup
                                %mo{:stretchy => "false"} )
                                %mi op
                              %mo{:stretchy => "false"} )
                          %msub
                            %mi Y
                            %mrow
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi PSh
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mn ∞
                                  %mo ,
                                  %mn 1
                                  %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} (
                              %mi Π
                              %mo{:stretchy => "false"} (
                              %mi X
                              %msup
                                %mo{:stretchy => "false"} )
                                %mi op
                              %mo{:stretchy => "false"} )
                              %msup
                                %mo{:stretchy => "false"} )
                                %mi op
                          %msub
                            %mi Y
                            %mrow
                              %mi Π
                              %mo{:stretchy => "false"} (
                              %mi X
                              %msup
                                %mo{:stretchy => "false"} )
                                %mi op
                          %mi x
                      %mtr
                        %mtd
                        %mtd
                          %mo ≃
                          %msub
                            %mi Aut
                            %mrow
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi PSh
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mn ∞
                                  %mo ,
                                  %mn 1
                                  %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} (
                              %mi Π
                              %mo{:stretchy => "false"} (
                              %mi X
                              %msup
                                %mo{:stretchy => "false"} )
                                %mi op
                              %mo{:stretchy => "false"} )
                              %msup
                                %mo{:stretchy => "false"} )
                                %mi op
                          %msub
                            %mi Y
                            %mrow
                              %mi Π
                              %mo{:stretchy => "false"} (
                              %mi X
                              %msup
                                %mo{:stretchy => "false"} )
                                %mi op
                          %mi x
                      %mtr
                        %mtd
                        %mtd
                          %mo ≃
                          %msub
                            %mi Aut
                            %mrow
                              %mi Π
                              %mo{:stretchy => "false"} (
                              %mi X
                              %msup
                                %mo{:stretchy => "false"} )
                                %mi op
                          %mi x
                      %mtr
                        %mtd
                        %mtd
                          %mo ≃
                          %msub
                            %mi Ω
                            %mi x
                          %mi Π
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %mo :
                          %msubsup
                            %mi Ω
                            %mi x
                            %mi geom
                          %mi X
                          %mspace{:width => "thinmathspace"}
                          %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  Aut_{PSh_{(\infty,1)}((PSh_{(\infty,1)}(\Pi(X)^{op}))^{op})}
                  \\infty Func(i, \infty Grod)
                  \&amp;
                  \=
                  Aut_{PSh_{(\infty,1)}((PSh_{(\infty,1)}(\Pi(X)^{op}))^{op})}
                  Y_{(PSh_{(\infty,1)}(\Pi(X)^{op}))^{op}} Y_{\Pi(X)^{op}} x
                  \\\
                  \&amp; \simeq
                  Aut_{(PSh_{(\infty,1)}(\Pi(X)^{op}))^{op}}
