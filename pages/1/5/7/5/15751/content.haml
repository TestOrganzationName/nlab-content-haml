            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/trace"} trace
          %h2#references References
          %ul
            %li
              %p
                D. A. Higgs, K. A. Rowe,
                %em Nuclearity in the category of complete semilattices
                , JPAA
                %strong 57
                no.1 (1989) pp.67-78.
            %li
              %p
                R. Rosebrugh, R. J. Wood,
                %em Constructive complete distributivity IV
                , App. Cat. Struc.
                %strong 2
                (1994) pp.119-144. (
                %a{:href => "http://www.mta.ca/~rrosebru/articles/ccd4.pdf"}> preprint
                )
            %li
              %p
                K. A. Rowe,
                %em Nuclearity
                , Canad.Math.Bull.
                %strong 31
                no.2 (1988) pp.227-235. (
                %a{:href => "http://cms.math.ca/cmb/v31/cmb1988v31.0227-0235.pdf"}> pdf
                )
            %li
              %p
                G. N. Raney,
                %em Tight Galois Connections and Complete Distributivity
                , Trans.Amer.Math.Soc
                %strong 97
                (1960) pp.418-426. (
                %a{:href => "http://www.ams.org/journals/tran/1960-097-03/S0002-9947-1960-0120171-3/S0002-9947-1960-0120171-3.pdf"}> pdf
                )
          %p
            For the generalization to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/linearly+distributive+categories"} linearly distributive categories
          %ul
            %li#CockettSeely99
              %a.existingWikiWord{:href => "/nlab/show/J.+R.+B.+Cockett"} J. R. B. Cockett
              and
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/R.+A.+G.+Seely"} R. A. G. Seely
