                          %mo ,
                          %mi T
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} t \in C^\infty(U,T)
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi g
                          %mn 1
                        %mover
                          %mo →
                          %mi t
                        %msub
                          %mi g
                          %mn 2
                      %annotation{:encoding => "application/x-tex"}
                        g_1 \stackrel{t}{\to} g_2
                %p
                  in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi C
                            %mn ∞
                          %mo{:stretchy => "false"} (
                          %mi U
                          %mo ,
                          %mi G
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} /
                          %mo{:stretchy => "false"} /
                          %msup
                            %mi C
                            %mn ∞
                          %mo{:stretchy => "false"} (
                          %mi U
                          %mo ,
                          %mi T
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} C^\infty(U,G)//C^\infty(U,T)
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi hofib
                          %mo{:stretchy => "false"} (
                          %mstyle{:mathvariant => "bold"}
                            %mi J
                          %mo{:stretchy => "false"} )
                          %mo ≃
                          %mi G
                          %mo{:stretchy => "false"} /
                          %mi T
                        %annotation{:encoding => "application/x-tex"} hofib(\mathbf{J}) \simeq G/T
              %li
                %p
                  The canonical map
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi hofib
                        %mo{:stretchy => "false"} (
                        %mstyle{:mathvariant => "bold"}
                          %mi J
                        %mo{:stretchy => "false"} )
                        %mo →
                        %msup
                          %mi Ω
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mi 𝔤
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} /
                        %mo{:stretchy => "false"} /
                        %mi T
                      %annotation{:encoding => "application/x-tex"} hofib(\mathbf{J}) \to \Omega^1(-,\mathfrak{g})//T
                  picks the top horizontal part of these commuting triangles hence equivalently sends
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                      %annotation{:encoding => "application/x-tex"} g
                  to
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi g
                            %mo *
                          %mi θ
                        %annotation{:encoding => "application/x-tex"} g^* \theta
          .num_remark
            %h6#remark_4 Remark
            %p
              There is yet one more fiber sequence of similar structure. If we let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mi G
                    %mo ≔
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi S
                      %mn 1
                    %mo ,
                    %mi G
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} L G \coloneqq [S^1, G]
              denote the free
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/loop+group"} loop group
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi G
                            %mo{:stretchy => "false"} /
                            %mi T
                          %mtd
                            %mo →
                          %mtd
                            %mi L
                            %mi G
                            %mo{:stretchy => "false"} /
                            %mi T
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi L
                            %mi G
                            %mo{:stretchy => "false"} /
                            %mi G
                          %mtd
                            %mo ≃
                            %mi Ω
                            %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    G/T &amp;\to&amp; L G / T
                    \\\
                    \&amp;&amp; \downarrow
                    \\\
                    \&amp;&amp; L G / G &amp; \simeq \Omega G
                    }
                    \\,.
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/geometric+quantization"} geometric quantization
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi T
                  %annotation{:encoding => "application/x-tex"} L G / T
              yields the
              %a.existingWikiWord{:href => "/nlab/show/positive+energy+representations"} positive energy representations
              of the
              %a.existingWikiWord{:href => "/nlab/show/loop+group"} loop group
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %msub
                        %mi G
                        %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} L G_\mathcal{C}
              %em
                %a{:href => "loop+group#Representations"} loop group – Properties – Representations
              for more on this.
          #Extended1dCSLagrangianFromLambda.num_prop
            %h6#proposition_5 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi λ
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                    %mo ∈
                    %msub
                      %mi Γ
                      %mi wt
                    %mo ↪
                    %msup
                      %mi 𝔤
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \langle \lambda ,- \rangle \in \Gamma_{wt} \hookrightarrow \mathfrak{g}^*
              is in the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/weight+lattice"} weight lattice
              %a.existingWikiWord{:href => "/nlab/show/moduli+stacks"} moduli stacks
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi λ
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi T
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi conn
                  %annotation{:encoding => "application/x-tex"}
                    \\langle \lambda, - \rangle
                    \\;\colon\;
                    \\Omega^1(-,\mathfrak{g})//T
                    \\to
                    \\mathbf{B}U(1)_{conn}
            %p
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              given over a test manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} U \in
              %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              by the
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi λ
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mo{:stretchy => "false"} ⟩
                      %mi U
                    %mspace{:width => "thickmathspace"}
                    %mo :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mi T
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\langle \lambda, - \rangle_U
                    \\;:\;
                    \\Omega^1(U,\mathfrak{g})//C^\infty(U,T) \to \Omega^1(U)//C^\infty(U,U(1))
            %p which is given on objects by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ↦
                    %mo{:stretchy => "false"} ⟨
                    %mi λ
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"}
                    A \mapsto \langle \lambda, A\rangle
            %p
              and which maps morphisms labeled by
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mi ξ
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi T
                    %annotation{:encoding => "application/x-tex"} \exp(\xi) \in T
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ξ
                    %mo ∈
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi 𝔱
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \xi \in C^\infty(-,\mathfrak{t})
              as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi ξ
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} ⟨
                    %mi λ
                    %mo ,
                    %mi ξ
                    %mo{:stretchy => "false"} ⟩
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\exp(\xi) \mapsto \exp( i \langle \lambda, \xi \rangle )
                    \\,.
          .proof
            %h6#proof_2 Proof
            %p
              That this construction defines a map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi T
                    %mo →
                    %mo *
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} *//T \to *//U(1)
              is the statement of prop.
              = succeed "." do
                %a.maruku-ref{:href => "#WeightsAndCharacters"}
            %p
              For this the key point is that since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo ≃
                    %msub
                      %mi G
                      %mi λ
                  %annotation{:encoding => "application/x-tex"} T \simeq G_\lambda
              stabilizes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi λ
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle \lambda , - \rangle
              under the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/coadjoint+action"} coadjoint action
              %a.existingWikiWord{:href => "/nlab/show/gauge+transformation"} gauge transformation
              law for points
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo{:lspace => "verythinmathspace"} :
                      %mi U
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %msub
                        %mi G
                        %mi conn
                    %annotation{:encoding => "application/x-tex"} A \colon U \to \mathbf{B}G_{conn}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ∈
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} g \in C^\infty(U,G)
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ↦
                    %msub
                      %mi Ad
                      %mi g
                    %mi A
                    %mo +
                    %msup
                      %mi g
                      %mo *
                    %mi θ
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    A \mapsto Ad_g A + g^* \theta
                    \\,,
            %p
              maps for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo =
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi ξ
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mi T
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} g = exp( \xi ) \in C^\infty(U,T) \hookrightarrow C^\infty(U,G)
              to the gauge transformation law in
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi conn
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}U(1)_{conn}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ⟨
                            %mi λ
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} ⟩
                          %mtd
                            %mo ↦
                            %mo{:stretchy => "false"} ⟨
                            %mi λ
                            %mo ,
                            %msub
                              %mi Ad
                              %mi g
                            %mi A
                            %mo{:stretchy => "false"} ⟩
                            %mo +
                            %mo{:stretchy => "false"} ⟨
                            %mi λ
                            %mo ,
                            %msup
                              %mi g
                              %mo *
                            %mi θ
                            %mo{:stretchy => "false"} ⟩
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} ⟨
                            %mi λ
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} ⟩
                            %mo +
                            %mi d
                            %mo{:stretchy => "false"} ⟨
                            %mi λ
                            %mo ,
                            %mi ξ
                            %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\langle \lambda, A \rangle
                    \&amp; \mapsto
                    \\langle \lambda, Ad_g A\rangle + \langle \lambda, g^* \theta\rangle
                    \\\
                    \&amp; = \langle \lambda, A \rangle + d  \langle\lambda, \xi \rangle
                    \\end{aligned}
          #ThePrequantumBundleFromCanonicalMaps.num_remark
            %h6#remark_5 Remark
            %p
              The composite of the canonical maps of prop.
              %a.maruku-ref{:href => "#ThetaAsHomotopyFiberOfJ"}
              and prop.
              %a.maruku-ref{:href => "#Extended1dCSLagrangianFromLambda"}
              modulates a canonical
              %a.existingWikiWord{:href => "/nlab/show/circle+bundle+with+connection"} circle bundle with connection
              on the
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/coset+space"} coset space
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/coadjoint+orbit"} coadjoint orbit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi λ
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi θ
                    %mo{:stretchy => "false"} ⟩
                    %mo{:lspace => "verythinmathspace"} :
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi T
                    %mover
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi θ
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi T
                    %mover
                      %mo →
                      %mrow
                        %mo{:stretchy => "false"} ⟨
                        %mi λ
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} ⟩
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi conn
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\langle \lambda, \mathbf{\theta}\rangle
                    \\colon
                    G/T
                    \\stackrel{\mathbf{\theta}}{\to}
                    \\Omega^1(-,\mathfrak{g})//T
                    \\stackrel{\langle \lambda, - \rangle}{\to}
                    \\mathbf{B}U(1)_{conn}
                    \\,.
          .num_prop
            %h6#proposition_6 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
              2-form of the circle bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi λ
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi θ
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle \lambda, \mathbf{\theta}\rangle
              from remark
              %a.maruku-ref{:href => "#ThePrequantumBundleFromCanonicalMaps"}
              is the
              %a.existingWikiWord{:href => "/nlab/show/symplectic+form"} symplectic form
              of prop.
              = succeed "." do
                %a.maruku-ref{:href => "#TheSymplecticFormOnTheCoset"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi λ
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi θ
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle \lambda, \mathbf{\theta}\rangle
              is a
              %a.existingWikiWord{:href => "/nlab/show/prequantization"} prequantization
              of the
              %a.existingWikiWord{:href => "/nlab/show/coadjoint+orbit"} coadjoint orbit
              = succeed "." do
