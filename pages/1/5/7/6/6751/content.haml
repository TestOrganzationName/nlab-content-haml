            %p
              An element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi λ
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                    %mo ∈
                    %msup
                      %mi 𝔤
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \langle\lambda,-\rangle \in \mathfrak{g}^*
              is called
              %em regular
              if its
              %a.existingWikiWord{:href => "/nlab/show/coadjoint+action"} coadjoint action
              %a.existingWikiWord{:href => "/nlab/show/stabilizer+subgroup"} stabilizer subgroup
              coincides with the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/maximal+torus"} maximal torus
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi G
                        %mi λ
                      %mo ≃
                      %mi T
                    %annotation{:encoding => "application/x-tex"} G_\lambda \simeq T
            %p
          .num_example
            %h6#example Example
            %p
              For generic values of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                    %annotation{:encoding => "application/x-tex"} \lambda
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi λ
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle \lambda, - \rangle
              it is regular (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#RegularElement"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔤
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}^*
              farthest from regularity is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \lambda = 0
              for which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mi λ
                    %mo =
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G_\lambda = G
              instead.
          %h3#the_symplectic_form The symplectic form
          %p
            We describe a canonical
            %a.existingWikiWord{:href => "/nlab/show/symplectic+form"} symplectic form
            on the
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/coadjoint+orbit"} coadjoint orbit
            %a.existingWikiWord{:href => "/nlab/show/coset+space"} coset space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒪
                    %mi λ
                  %mo ≃
                  %mi G
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi G
                    %mi λ
                %annotation{:encoding => "application/x-tex"} \mathcal{O}_\lambda \simeq G/G_\lambda
            (from Prop.
            = succeed ")." do
              %a.maruku-ref{:href => "#CoadjointOrbitsAsCosetSpaces"}
          %p
            Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi θ
                  %mo ∈
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo ,
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \theta \in \Omega^1(G, \mathfrak{g})
            for the
            %a.existingWikiWord{:href => "/nlab/show/Maurer-Cartan+form"} Maurer-Cartan form
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          #The2FormOnG.num_defn
            %h6#definition_2 Definition
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Θ
                      %mi λ
                    %mo ≔
                    %mo{:stretchy => "false"} ⟨
                    %mi λ
                    %mo ,
                    %mi θ
                    %mo{:stretchy => "false"} ⟩
                    %mo ∈
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Theta_\lambda \coloneqq \langle \lambda, \theta \rangle \in \Omega^1(G)
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/differential+1-form"} differential 1-form
              obtained by pairing the value of the
              %a.existingWikiWord{:href => "/nlab/show/Maurer-Cartan+form"} Maurer-Cartan form
              at each point with the fixed element
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                      %mo ∈
                      %msup
                        %mi 𝔤
                        %mo *
                    %annotation{:encoding => "application/x-tex"} \lambda \in \mathfrak{g}^*
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ν
                      %mi λ
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi{:mathvariant => "normal"} d
                      %mi dR
                    %msub
                      %mi Θ
                      %mi λ
                  %annotation{:encoding => "application/x-tex"}
                    \\nu_\lambda
                    \\;\coloneqq\;
                    \\mathrm{d}_{dR} \Theta_\lambda
            %p
              for its
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/de+Rham+differential"} de Rham differential
          #TheSymplecticFormOnTheCoset.num_prop
            %h6#proposition Proposition
            %p
              The 2-form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ν
                      %mi λ
                  %annotation{:encoding => "application/x-tex"} \nu_\lambda
              from def.
              %a.maruku-ref{:href => "#The2FormOnG"}
            %ol
              %li
                %p satisfies
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ν
                          %mi λ
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %mfrac
                          %mn 1
                          %mn 2
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟨
                        %mi λ
                        %mo ,
                        %mo{:stretchy => "false"} [
                        %mi θ
                        %mo ∧
                        %mi θ
                        %mo{:stretchy => "false"} ]
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        \\nu_\lambda
                        \\;=\;
                        \\frac{1}{2}
                        \\big\langle
                        \\lambda, [\theta\wedge \theta]
                        \\big\rangle
                        \\,,
              %li
                %p
                  descends to a closed
                  = succeed "-invariant" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/coset+space"} coset space
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ν
                          %mi λ
                        %mspace{:width => "thickmathspace"}
                        %mo ∈
                        %mspace{:width => "thickmathspace"}
                        %msubsup
                          %mi Ω
                          %mi cl
                          %mn 2
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo{:stretchy => "false"} /
                        %msub
                          %mi G
                          %mi λ
                        %msup
                          %mo{:stretchy => "false"} )
                          %mi G
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\nu_\lambda \;\in\; \Omega^2_{cl}(G/G_\lambda)^G
                        \\,.
              %li
                %p
                  which is non-degenerate and hence defines a
                  %a.existingWikiWord{:href => "/nlab/show/symplectic+form"} symplectic form
                  on
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                          %mo{:stretchy => "false"} /
                          %msub
                            %mi G
                            %mi λ
                        %annotation{:encoding => "application/x-tex"} G/G_\lambda
          %h3#the_prequantum_bundle The prequantum bundle
          %p
            We discuss the
            %a.existingWikiWord{:href => "/nlab/show/geometric+prequantization"} geometric prequantization
            of the
            %a.existingWikiWord{:href => "/nlab/show/symplectic+manifold"} symplectic manifold
            given by the
            %a.existingWikiWord{:href => "/nlab/show/coadjoint+orbit"} coadjoint orbit
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒪
                    %mi λ
                %annotation{:encoding => "application/x-tex"} \mathcal{O}_\lambda
            equipped with its
            %a.existingWikiWord{:href => "/nlab/show/symplectic+form"} symplectic form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ν
                    %mi λ
                %annotation{:encoding => "application/x-tex"} \nu_\lambda
            of def.
            = succeed "." do
              %a.maruku-ref{:href => "#TheSymplecticFormOnTheCoset"}
          %p
            Assume now that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/simply+connected+topological+space"} simply connected
          #WeightsAndCharacters.num_prop
            %h6#proposition_2 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/weight+lattice"} weight lattice
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mi wt
                    %mo ⊂
                    %msup
                      %mi 𝔱
                      %mo *
                    %mo ≃
                    %mi 𝔱
                  %annotation{:encoding => "application/x-tex"} \Gamma_{wt} \subset \mathfrak{t}^* \simeq \mathfrak{t}
              of the Lie group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              is
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
              to the group of
              %a.existingWikiWord{:href => "/nlab/show/group+characters"} group characters
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mi wt
                    %mover
                      %mo →
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mo ∼
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Hom
                      %mi LieGrp
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi T
                    %mo ,
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma_{wt}
                    \\xrightarrow{\;\; \sim \;\;}
                    Hom_{LieGrp}\big(T,U(1)\big)
                    \\,,
            %p
              where the identification takes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi α
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                    %mo ∈
                    %msup
                      %mi 𝔱
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \langle \alpha , -\rangle \in \mathfrak{t}^*
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ρ
                      %mi α
                    %mo{:lspace => "verythinmathspace"} :
                    %mi T
                    %mo →
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \rho_\alpha \colon T \to U(1)
              given on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo =
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi ξ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} t = \exp(\xi)
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ξ
                    %mo ∈
                    %mi 𝔱
                  %annotation{:encoding => "application/x-tex"} \xi \in \mathfrak{t}
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ρ
                      %mi α
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi ξ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ↦
                    %mspace{:width => "thickmathspace"}
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} ⟨
                    %mi α
                    %mo ,
                    %mi ξ
                    %mo{:stretchy => "false"} ⟩
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\rho_\alpha
                    \\;\colon\;
                    \\exp(\xi)
                    \\;\mapsto\;
                    \\exp(i \langle \alpha, \xi\rangle)
                    \\,.
          %p
          #IntegralityOfSymplecticForm.num_prop
            %h6 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/symplectic+form"} symplectic form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ν
                      %mi λ
                    %mo ∈
                    %msubsup
                      %mi Ω
                      %mi cl
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi T
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \nu_\lambda \in \Omega^2_{cl}(G/T)
              of prop.
              %a.maruku-ref{:href => "#TheSymplecticFormOnTheCoset"}
              is
              %a.existingWikiWord{:href => "/nlab/show/integral+form"} integral
              precisely if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi λ
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle \lambda, - \rangle
              is in the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/weight+lattice"} weight lattice
          %p
          .num_remark
            %h6 Remark
            %p
              Integrality of the symplectic form (via Prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#IntegralityOfSymplecticForm"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/geometric+quantization"} *Bohr–Sommerfeld condition*
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/prequantum+line+bundle"} prequantum line bundle
          %h3#the_hamiltonian_action__coadjoint_moment_map
            The Hamiltonian
            = succeed "-action" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %p
            The group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            canonically
            %a.existingWikiWord{:href => "/nlab/show/group+action"} acts
            on the
            %a.existingWikiWord{:href => "/nlab/show/coset+space"} coset space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi G
                    %mi λ
                %annotation{:encoding => "application/x-tex"} G/G_{\lambda}
            (by multiplication from the left). We discuss a lift of this action to a
            %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+action"} Hamiltonian action
            with respect to the
            %a.existingWikiWord{:href => "/nlab/show/symplectic+manifold"} symplectic manifold
            structure
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi T
                  %mo ,
                  %msub
                    %mi ν
                    %mi λ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (G/T, \nu_\lambda)
            of Prop.
            = succeed "," do
              %a.maruku-ref{:href => "#TheSymplecticFormOnTheCoset"}
            %a.existingWikiWord{:href => "/nlab/show/momentum+map"} momentum map
            exhibiting this Hamiltonian action.
          %h3#WilsonLoopsAnd1DCSSigmaModelWithTargetTheCoadjointOrbit
            Wilson loops and 1d Chern-Simons
            = succeed "-models" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
          %p
            %a{:href => "#DefinitionsAndConstructions"} Above
            we discussed how an
            %a.existingWikiWord{:href => "/nlab/show/irreducible+representation"} irreducible
            %a.existingWikiWord{:href => "/nlab/show/unitary+representation"} unitary representation
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is encoded by the
            %a.existingWikiWord{:href => "/nlab/show/prequantization"} prequantization
            of a
            %a.existingWikiWord{:href => "/nlab/show/coadjoint+orbit"} coadjoint orbit
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒪
                      %mi λ
                    %mo ,
                    %msub
                      %mi ν
                      %mi λ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{O}_\lambda, \nu_\lambda)
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/Wilson+loops"} Wilson loops
            %a.existingWikiWord{:href => "/nlab/show/holonomy"} holonomy
            of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/principal+connections"} principal connections
            in this representation as the
            %a.existingWikiWord{:href => "/nlab/show/path+integral"} path integral
            of a topological particle charged under this background field, whose
            %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            is that of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/1-dimensional+Chern-Simons+theory"} 1-dimensional Chern-Simons theory
          %p
            This was hinted at in
            = succeed "," do
              %a{:href => "#Witten89"} Witten 89, p. 22, 23
            = succeed "." do
              %a{:href => "#Beasley11"} Beasley 2011, section 4
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %msub
                    %mo{:stretchy => "false"} |
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                  %mo ∈
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mn 1
                  %mo ,
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
