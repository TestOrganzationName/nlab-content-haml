          %h2#DiracInduction Formulation in equivariant K-theory (Dirac induction)
          .num_prop
            %h6#proposition_7 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              a
              %a.existingWikiWord{:href => "/nlab/show/compact+Lie+group"} compact Lie group
              with
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝔤
                        %mo *
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}^\ast
              %a.existingWikiWord{:href => "/nlab/show/push-forward+in+generalized+cohomology"} push-forward
              in compactly supported
              %a.existingWikiWord{:href => "/nlab/show/twisted+K-theory"} twisted
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/equivariant+K-theory"} equivariant K-theory
              to the point (the
              = succeed "-equivariant" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/index"} index
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Dirac+induction"} Dirac induction
              %a.existingWikiWord{:href => "/nlab/show/Thom+isomorphism"} Thom isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ind
                      %mrow
                        %msup
                          %mi 𝔤
                          %mo *
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi K
                      %mi G
                      %mrow
                        %mi σ
                        %mo +
                        %mi dim
                        %mi G
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi 𝔤
                      %mo *
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi cpt
                    %mover
                      %mo →
                      %mo ≃
                    %msubsup
                      %mi K
                      %mi G
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Rep
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    ind_{\mathfrak{g}^\ast}
                    \\;\colon\;
                    K_G^{\sigma + dim G}(\mathfrak{g}^\ast)_{cpt}
                    \\stackrel{\simeq}{\to}
                    K_G^0(\ast) \simeq Rep(G)
                    \\,.
            %p
              Moreover, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝒪
                    %mo ↪
                    %msup
                      %mi 𝔤
                      %mo *
                  %annotation{:encoding => "application/x-tex"} i \colon \mathcal{O} \hookrightarrow \mathfrak{g}^\ast
              a regular
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/coadjoint+orbit"} coadjoint orbit
              %a.existingWikiWord{:href => "/nlab/show/push-forward+in+generalized+cohomology"} push-forward
              involves a
              %a.existingWikiWord{:href => "/nlab/show/twisted+K-theory"} twist
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Rep
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msubsup
                      %mi K
                      %mi G
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ←
                      %mrow
                        %msub
                          %mi ind
                          %mi 𝒪
                    %msubsup
                      %mi K
                      %mi G
                      %mrow
                        %mi σ
                        %mo{:stretchy => "false"} (
                        %mi 𝒪
                        %mo{:stretchy => "false"} )
                        %mo +
                        %mi dim
                        %mo{:stretchy => "false"} (
                        %mi 𝒪
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi 𝒪
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi i
                          %mo !
                    %msubsup
                      %mi K
                      %mi G
                      %mrow
                        %mi σ
                        %mo +
                        %mi dim
                        %mi G
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi 𝔤
                      %mo *
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi cpt
                  %annotation{:encoding => "application/x-tex"}
                    Rep(G) \simeq K_G^0(\ast)
                    \\stackrel{ind_{\mathcal{O}}}{\leftarrow}
                    K_G^{\sigma(\mathcal{O}) + dim(\mathcal{O})}(\mathcal{O})
                    \\stackrel{i_!}{\to}
                    K_G^{\sigma + dim G}(\mathfrak{g}^\ast)_{cpt}
            %p and
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi i
                          %mo !
                      %annotation{:encoding => "application/x-tex"} i_!
                  is surjective
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msub
                          %mi ind
                          %mi 𝒪
                        %mo =
                        %msub
                          %mi ind
                          %mrow
                            %msup
                              %mi 𝔤
                              %mo *
                        %mo ∘
                        %msub
                          %mi i
                          %mo !
                      %annotation{:encoding => "application/x-tex"} ind_{\mathcal{O}} = ind_{\mathfrak{g}^\ast} \circ i_!
                  \.
          %p
            This is (
            %a{:href => "#FHT"}> FHT II, (1.27), theorem 1.28
            ).
