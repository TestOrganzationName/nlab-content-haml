            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/coset+space"} coset space
            %a.existingWikiWord{:href => "/nlab/show/flag+manifolds"} flag manifolds
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %p Write
          %ol
            %li
