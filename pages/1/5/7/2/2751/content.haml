                      %mi g
                      %mrow
                        %mi i
                        %mi j
                    %mo :
                    %msub
                      %mi U
                      %mi i
                    %mo ∩
                    %msub
                      %mi U
                      %mi j
                    %mo →
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (g_{i j} : U_i \cap U_j \to G)
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo ,
                              %mi j
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                            %mtd
                              %mo ↗
                            %mtd
                            %mtd
                              %mo ↘
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo ,
                              %mi i
                              %mo{:stretchy => "false"} )
                            %mtd
                            %mtd
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo ,
                              %mi k
                              %mo{:stretchy => "false"} )
                      %mo )
                    %mo ↦
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mo •
                          %mtr
                            %mtd
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %msub
                                      %mi g
                                      %mrow
                                        %mi i
                                        %mi j
                                    %mo{:stretchy => "false"} (
                                    %mi x
                                    %mo{:stretchy => "false"} )
                              %mo ↗
                            %mtd
                            %mtd
                              %msup
                                %mo ↘
                                %mpadded{:width => "0"}
                                  %mrow
                                    %msub
                                      %mi g
                                      %mrow
                                        %mi j
                                        %mi k
                                    %mo{:stretchy => "false"} (
                                    %mi x
                                    %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %mo •
                            %mtd
                            %mtd
                              %mover
                                %mo →
                                %mrow
                                  %msub
                                    %mi g
                                    %mrow
                                      %mi i
                                      %mi k
                                  %mo{:stretchy => "false"} (
                                  %mi x
                                  %mo{:stretchy => "false"} )
                            %mtd
                            %mtd
                              %mo •
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    \\array{
                    \&amp;&amp; (x,j)
                    \\\
                    \&amp; \nearrow &amp;&amp; \searrow
                    \\\
                    (x,i) &amp;&amp;&amp;&amp; (x,k)
