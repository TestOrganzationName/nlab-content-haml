                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
          %h4#definition_of_covariant_derivative Definition of covariant derivative
          .num_lemma
            %h6#observation Observation
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                  %annotation{:encoding => "application/x-tex"} \nabla
              on the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
              with cocycle
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \nabla \sigma
              on the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} /
                      %mi G
                    %annotation{:encoding => "application/x-tex"} V//G
              %a.existingWikiWord{:href => "/nlab/show/groupoid+principal+bundle"} groupoid principal bundle
              that corresponds to a section
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
              by the above proposition.
          .num_defn
            %h6#definition_2 Definition
            %p
              The
              %strong covariant derivative
              of a section
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
              is the
              %em 1-form component
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi F
                      %mrow
                        %mo ∇
                        %mi σ
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} F_{\nabla \sigma}^1
              of the
              %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
              of this groupoid-bundle connection.
          %p
            This 1-form curvature is literally the measure for the
            %em non-flatness of the section
            \. Whereas the 2-form curvature is a measure for the non-flatness of the connection.
          %h4#equivalence_to_more_traditional_definitions Equivalence to more traditional definitions
          %p We unwind this definition and find the traditional formulation of covariant derivatives as traditionally stated in the literature.
          %p
            On a patch
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi U
                    %mi i
                  %mo ↪
                  %mi X
                %annotation{:encoding => "application/x-tex"} U_i \hookrightarrow X
            the connection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                %annotation{:encoding => "application/x-tex"} \nabla
            is given by a morphism of
            %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebras
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi U
                    %mi i
                  %mo{:stretchy => "false"} )
                  %mo ←
                  %mi W
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msub
                    %mi A
                    %mi i
                %annotation{:encoding => "application/x-tex"}
                  \\Omega^\bullet(U_i) \leftarrow W(\mathfrak{g}) : A_i
          %p
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} W(\mathfrak{g})
            the
            %a.existingWikiWord{:href => "/nlab/show/Weil+algebra"} Weil algebra
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
          %p
            The groupoid connection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                  %mi σ
                %annotation{:encoding => "application/x-tex"} \nabla \sigma
            on this patch is given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi U
                    %mi i
                  %mo{:stretchy => "false"} )
                  %mo ←
                  %mi W
                  %mo{:stretchy => "false"} (
                  %mi Lie
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} /
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo ∇
                  %msub
                    %mi σ
                    %mi i
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\Omega^\bullet(U_i) \leftarrow W(Lie(V//G)) : \nabla \sigma_i
                  \\,.
          %p In degree 0 this is an algebra homomorphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi U
                    %mi i
                  %mo{:stretchy => "false"} )
                  %mo ←
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msub
                    %mi σ
                    %mi i
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  C^\infty(U_i) \leftarrow C^\infty(V) : \sigma_i
                  \\,.
          %p
            This is the dual of the local section
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi σ
                    %mi i
                %annotation{:encoding => "application/x-tex"} \sigma_i
            itself. In the case that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            is a vector space with chosen basis
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi v
                      %mi k
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{v^k\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi σ
                    %mi i
                    %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\sigma_i^k)
            of the local section.
          %p Further, in degree 1 the connection is linear map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi U
                    %mi i
                  %mo{:stretchy => "false"} )
                  %mo ←
                  %msup
                    %mi 𝔤
                    %mo *
                  %mo :
                  %msub
                    %mi A
                    %mi i
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\Omega^1(U_i) \leftarrow \mathfrak{g}^* : A_i
                  \\,,
          %p which is the connection form itself, as well as a linear map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi U
                    %mi i
                  %mo{:stretchy => "false"} )
                  %mo ←
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msubsup
                    %mi F
                    %mrow
                      %mo ∇
                      %msub
                        %mi σ
                        %mi i
                    %mn 1
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\Omega^1(U_i) \leftarrow \Omega^1(V) : F^1_{\nabla \sigma_i}
                  \\,,
          %p which is the curvature 1-form. The respect of these maps for the differential says that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi F
                    %mrow
                      %mo ∇
                      %msub
                        %mi σ
                        %mi i
                    %mn 1
                  %mo =
                  %msub
                    %mi d
                    %mi dR
                  %msub
                    %mi σ
                    %mi i
                  %mo +
                  %mi ρ
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi σ
                    %mi i
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  F^1_{\nabla \sigma_i} = d_{dR} \sigma_i + \rho(A)(\sigma_i)
                  \\,.
          %p This is the familiar local formula for a covariant derivative as one finds it in the literature. We therefore write for short
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∇
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                  %msub
                    %mi σ
                    %mi i
                  %mo :
                  %mo =
                  %msubsup
                    %mi F
                    %mrow
                      %mo ∇
                      %msub
                        %mi sigma
                        %mi i
                    %mn 1
                %annotation{:encoding => "application/x-tex"}
                  \\nabla_{(-)} \sigma_i := F^1_{\nabla sigma_i}
          %p
            If we keep
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                %annotation{:encoding => "application/x-tex"} \nabla
            fixed and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi σ
                    %mi i
                %annotation{:encoding => "application/x-tex"} \sigma_i
            vary, then this may be thought of as a 1-form with values in
            %a.existingWikiWord{:href => "/nlab/show/endomorphism"} endomorphisms
            of the space of sections
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∇
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                  %mo :
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi P
                  %msub
                    %mo ×
                    %mi ρ
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi P
                  %msub
                    %mo ×
                    %mi ρ
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\nabla_{(-)} : \Gamma(P \times_\rho V) \to \Gamma(P \times_\rho V)
                  \\,.
          %p
            There is a
            %a.existingWikiWord{:href => "/nlab/show/Bianchi+identity"} Bianchi identity
            on every
            %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
            component, induced from the respect for differentials of the dg-algebra morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi U
                    %mi i
                  %mo{:stretchy => "false"} )
                  %mo ←
                  %mi W
                  %mo{:stretchy => "false"} (
                  %mi Lie
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} /
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msub
                    %mi F
                    %mo ∇
                %annotation{:encoding => "application/x-tex"} \Omega^\bullet(U_i) \leftarrow W(Lie(V//G)) : F_\nabla
            on shifted generators.
          %p
            From the discussion at
            %a{:href => "#ActionLieAlgebroidCohomology"} Action Lie algebroid cohomology
            above we read off the Bianchi identity for the 1-form curvature that we identified with the covariant derivative in the case of linear actions to be given in local coordinates (as above) by (suppressing the patch index
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                      %mi i
                  %annotation{:encoding => "application/x-tex"} {}_i
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi dR
                  %msub
                    %mo ∇
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                  %msup
                    %mi σ
                    %mi k
                  %mo =
                  %msub
                    %mi ρ
                    %mi a
                  %msup
                    %mrow
                    %mi k
                  %msub
                    %mrow
                    %mi k
                  %msubsup
                    %mi F
                    %mi A
                    %mi a
                  %mo ∧
                  %msup
                    %mi σ
                    %mi k
                  %mo −
                  %msub
                    %mi ρ
                    %mi a
                  %msup
                    %mrow
                    %mi k
                  %msub
                    %mrow
                    %mi l
                  %msup
                    %mi A
                    %mi a
                  %msub
                    %mi d
                    %mi dR
                  %msup
                    %mi σ
                    %mi k
                  %mo ,
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  d_{dR} \nabla_{(-)} \sigma^k = \rho_a{}^k{}_k F_A^a \wedge \sigma^k
                  \-
                  \\rho_a{}^k{}_l A^a d_{dR} \sigma^k
                  ,.
          %p More invariantly we may write this as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∇
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                  %msub
                    %mo ∇
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                  %mi σ
                  %mo =
                  %mi ρ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi F
                    %mi A
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi σ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\nabla_{(-)} \nabla_{(-)} \sigma = \rho(F_A)(\sigma)
          %p
            and this find the usual expression of the
            %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
            of a connection as the square of the covariant derivative.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/flat+section"} flat section
            %li
              %p
