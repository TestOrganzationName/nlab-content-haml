                    \\right)
                    \\mapsto
                    \\left(
                    \\array{
                    \&amp;&amp; \bullet
                    \\\
                    \&amp; {}^{\mathllap{g_{i j}(x)}}\nearrow &amp;&amp; \searrow^{\mathrlap{g_{j k}(x)}}
                    \\\
                    \\bullet &amp;&amp;\stackrel{g_{i k}(x)}{\to}&amp;&amp; \bullet
                    }
                    \\right)
                    \\,.
            %p
              A lift of this cocycle through
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi G
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} V//G \to \mathbf{B}G
              is in addition a collection of smooth functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi sigma
                      %mi i
                    %mo :
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi V
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{sigma_i : U_i \to V\}
              such that on all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
