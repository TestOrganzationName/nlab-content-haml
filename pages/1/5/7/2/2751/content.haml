                      %mi i
                    %mo ∩
                    %msub
                      %mi U
                      %mi j
                  %annotation{:encoding => "application/x-tex"} U_i \cap U_j
              the equation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi σ
                      %mi j
                    %mo =
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mrow
                        %mi i
                        %mi j
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi σ
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\sigma_j = \rho(g_{i j})(\sigma_i)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mi σ
                                %mi i
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
