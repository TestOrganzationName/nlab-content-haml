                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %msub
                      %mo ×
                      %mi ρ
                    %mi G
                  %annotation{:encoding => "application/x-tex"} P \times_\rho G
              with respect to the local trivialization encoded by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
