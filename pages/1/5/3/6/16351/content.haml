                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f(x) \in Y
              and consider a
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              which restricts to one of the
              %a.existingWikiWord{:href => "/nlab/show/coordinate+functions"} coordinate functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
