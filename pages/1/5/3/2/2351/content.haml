              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Cat
                    %annotation{:encoding => "application/x-tex"} Cat
              = succeed "-equivalences." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Cat
                    %annotation{:encoding => "application/x-tex"} Cat
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/framed+bicategory"} framed bicategory
          %h2#definition_of_cartesian_structure_and_basic_results Definition of cartesian structure and basic results
          %p
            A
            %strong cartesian structure
            on a bicategory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            consists of the following data:
          %ul
            %li
              %p
                2-functors
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⊗
                      %mo :
                      %mi B
                      %mo ×
                      %mi B
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} \otimes: B \times B \to B
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi I
                        %mo :
                        %mstyle{:mathvariant => "bold"}
                          %mn 1
                        %mo →
                        %mi B
                      %annotation{:encoding => "application/x-tex"} I: \mathbf{1} \to B
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbf{1}
                is the terminal 2-category;
            %li
              %p Map-valued transformations
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi δ
                      %mo :
                      %msub
                        %mn 1
                        %mi B
                      %mo →
                      %mo ⊗
                      %mi Δ
                      %mo ,
                      %mspace{:width => "2em"}
                      %mi π
                      %mo :
                      %mi Δ
                      %mo ⊗
                      %mo →
                      %msub
                        %mn 1
                        %mrow
                          %mi B
                          %mo ×
                          %mi B
                      %mo ,
                      %mspace{:width => "2em"}
                      %mi ε
                      %mo :
                      %msub
                        %mn 1
                        %mi B
                      %mo →
                      %mi I
                      %mo !
                    %annotation{:encoding => "application/x-tex"} \delta: 1_B \to \otimes \Delta, \qquad \pi: \Delta \otimes \to 1_{B \times B}, \qquad \varepsilon: 1_B \to I !
              %p
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                      %mo :
                      %mi B
                      %mo →
                      %mi B
                      %mo ×
                      %mi B
                    %annotation{:encoding => "application/x-tex"} \Delta: B \to B \times B
                is the diagonal 2-functor and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo !
                      %mo :
                      %mi B
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} !: B \to \mathbf{1}
                is the unique 2-functor;
            %li
              %p Invertible modifications
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
