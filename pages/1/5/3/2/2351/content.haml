            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo −
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{B}(i-, c)
            of what we shall call ([faute de mieux]) generalized coherent hyperdoctrines:
          .un_def
            %h6#definition Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              be a 2-category with 2-products. A
              %strong generalized coherent hyperdoctrine
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is a 2-functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo :
                    %msup
                      %mi C
                      %mi op
                    %mo →
                    %mi FPCat
                  %annotation{:encoding => "application/x-tex"} P: C^{op} \to FPCat
            %p
              to the 2-category of categories with finite products, such that for each 1-cell
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P(f)
              has a left adjoint.
          %p
            This is called a generalized coherent hyperdoctrine because it deals with a generalized form of coherent logic (involving finite “conjunctions”, i.e., local finite cartesian products and existential quantifiers
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∃
                      %mi f
                    %mo ⊣
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \exists_f \dashv P(f)
            = succeed ".)" do
              %a{:href => "#frobenius"} section to follow
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is actually a 2-category.
          %p
            If the symmetric monoidal bicategory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                %annotation{:encoding => "application/x-tex"} \mathbf{B}
            is
            %em compact
            (e.g., if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                %annotation{:encoding => "application/x-tex"} \mathbf{B}
            is of type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Rel
                    %mi C
                %annotation{:encoding => "application/x-tex"} Rel_C
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            a regular category, or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Span
                    %mi C
                %annotation{:encoding => "application/x-tex"} Span_C
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            a finitely complete category, or the bicategory of small categories and profunctors between them), then without loss of generality, we may restrict attention to the single hyperdoctrine
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo −
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi Map
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                  %mo →
                  %mi FPCat
                %annotation{:encoding => "application/x-tex"} \mathbf{B}(i-, 1): Map(\mathbf{B})^{op} \to FPCat
          %h2#frobenius Frobenius conditions
          %p
            A major class of examples of cartesian bicategories, including
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Rel
                  %annotation{:encoding => "application/x-tex"} Rel
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Span
                  %annotation{:encoding => "application/x-tex"} Span
          %ul
            %li
              %p Each object is self-dual (in the sense of compact closed bicategories),
            %li
              %p The bicategory of maps is locally groupoidal.
          %p
            These arise as follows. In any cartesian bicategory and for each object
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Frob
                    %mi b
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi δ
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi δ
                  %mi b
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo *
                  %mo →
                  %mo{:stretchy => "false"} (
                  %msub
                    %mn 1
                    %mi b
                  %mo ⊗
                  %mi δ
                  %msup
                    %mi b
                    %mo *
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi δ
                  %mi b
                  %mo ⊗
                  %msub
                    %mn 1
                    %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Frob_b: (\delta b)(\delta b)^\ast \to (1_b \otimes \delta b^\ast)(\delta b \otimes 1_b)
          %p
            mated to the coassociativity isomorphism for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                  %annotation{:encoding => "application/x-tex"} \delta
            %strong Frobenius condition
            holds if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Frob
                    %mi b
                %annotation{:encoding => "application/x-tex"} Frob_b
            is an isomorphism for each
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Frob
                    %mi b
                  %mo ′
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi δ
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi δ
                  %mi b
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo *
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi δ
                  %msup
                    %mi b
                    %mo *
                  %mo ⊗
                  %msub
                    %mn 1
                    %mi b
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %msub
                    %mn 1
                    %mi b
                  %mo ⊗
                  %mi δ
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Frob_{b}': (\delta b)(\delta b)^\ast \to (\delta b^\ast \otimes 1_b)(1_b \otimes \delta b)
          %p
            be an isomorphism for each
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
