                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi G
                  %mo −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C(F -, -) \simeq B(-, G -)
          %p
            in the 2-category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi s
