                              %mi I
                            %mtd
                              %munder
                                %mo →
                                %mrow
                                  %msub
                                    %mn 1
                                    %mi I
                            %mtd
                              %mi I
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \\otimes &amp; \overset{\delta \otimes}{\to} &amp; \otimes \Delta \otimes &amp; &amp; &amp; &amp; \Delta &amp; \overset{\Delta \delta}{\to} &amp; \Delta \otimes \Delta &amp; &amp; &amp; &amp; I &amp; \overset{\varepsilon I}{\to} &amp; I ! I\\
                      \\mathllap{1_{\otimes}} \downarrow &amp; \overset{s}{\Rightarrow} &amp; \downarrow \mathrlap{\otimes \pi} &amp; &amp; &amp; &amp; \mathllap{1_{\Delta}} \downarrow &amp; \overset{t}{\Leftarrow} &amp; \downarrow \mathrlap{\pi \Delta} &amp; &amp; &amp; &amp; \mathllap{1_{I}} \downarrow &amp; \overset{u}{\Rightarrow} &amp; \downarrow \mathrlap{I \cdot id}\\
                      \\otimes &amp; \underset{1_{\otimes}}{\to} &amp; \otimes &amp; &amp; &amp; &amp; \Delta &amp; \underset{1_{\Delta}}{\to} &amp; \Delta &amp; &amp; &amp; &amp; I &amp; \underset{1_I}{\to} &amp; I
                      }
              %p
                satisfying the triangulator coherence conditions.
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo □
                    %annotation{:encoding => "application/x-tex"} \Box
          %p The crucial observation is that, by proposition 1, this data restricts to give 2-adjunctions
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Map
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mi Δ
                  %mi Map
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi Map
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ⊣
                  %mo{:stretchy => "false"} (
                  %mi Map
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi Map
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mo ⊗
                  %mi Map
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (Map(B) \overset{\Delta}{\to} Map(B) \times Map(B)) \dashv (Map(B) \times Map(B) \overset{\otimes}{\to} Map(B))
          %p
            %br/
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Map
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mo !
                  %mstyle{:mathvariant => "bold"}
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ⊣
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mn 1
                  %mover
                    %mo →
                    %mi I
                  %mi Map
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (Map(B) \overset{!}{\to} \mathbf{1}) \dashv (\mathbf{1} \overset{I}{\to} Map(B))
          %p
            making the restriction of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊗
                %annotation{:encoding => "application/x-tex"} \otimes
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Map
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Map(B)
            a
            %em 2-product
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Map
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Map(B)
            with 2-terminal object
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Map
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Map(B)
            is property-like: is uniquely determined up to equivalence which is uniquely specified up to unique isomorphism.
          %p
            A little later we will argue that cartesian structure on the full bicategory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            is also property-like; the main thing is to see that the way in which
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊗
                %annotation{:encoding => "application/x-tex"} \otimes
            acts on 1-cells is essentially uniquely determined.
          %h3#symmetric_monoidal_structure_via_cartesian_structure Symmetric monoidal structure via cartesian structure
          %p
            We now argue that a cartesian bicategory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            carries a symmetric monoidal structure whose tensor product is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊗
                  %mo :
                  %mi B
                  %mo ×
                  %mi B
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} \otimes: B \times B \to B
          %p
            The proof is pretty easy to sketch, once the fact is admitted that the induced 2-product structure makes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Map
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Map(B)
            a symmetric monoidal bicategory. This fact about 2-products, while never in dispute, was given a complete proof only in the past few years by the late Max Kelly, and we freely take advantage of it below.
          %p
            First, given objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ,
                  %mi b
                  %mo ,
