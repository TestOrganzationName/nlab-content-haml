                                    %mo ⊗
                            %mtd
                              %mo ⊗
                            %mtd
                            %mtd
                            %mtd
                            %mtd
                              %mi Δ
                            %mtd
                              %munder
                                %mo →
                                %mrow
                                  %msub
                                    %mn 1
                                    %mi Δ
                            %mtd
                              %mi Δ
                            %mtd
                            %mtd
                            %mtd
