                  %mrow
                    %mi Map
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Map(\mathbf{B})
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mi f
                  %mo ,
                  %mi i
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi B
