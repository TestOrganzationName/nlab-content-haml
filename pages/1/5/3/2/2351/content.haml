            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mi f
                    %mo ⊣
                    %mi F
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} F f \dashv F f^*
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mi f
                    %mo ⊣
                    %mi G
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} G f \dashv G f^*
          %p
            A transformation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi θ
                  %mo :
                  %mi F
