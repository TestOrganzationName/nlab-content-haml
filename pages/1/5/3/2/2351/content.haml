                  %mi G
                  %mo :
                  %mi B
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} \theta: F \to G: B \to C
            is
            %strong map-valued
            if each 1-cell
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi θ
                  %mi b
                %annotation{:encoding => "application/x-tex"} \theta b
            is a map in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
