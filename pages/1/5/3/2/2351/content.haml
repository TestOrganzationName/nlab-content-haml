            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi θ
                  %mo :
                  %mi F
                  %mo →
                  %mi G
                %annotation{:encoding => "application/x-tex"} \theta: F \to G
