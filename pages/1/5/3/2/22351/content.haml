                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            modulo this
            = succeed "-action" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            exactly exhaust
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/mathematics"} mathematics
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/equivariant+differential+topology"} equivariant differential topology
            %a.existingWikiWord{:href => "/nlab/show/open+subset"} open sub
            %a.existingWikiWord{:href => "/nlab/show/G-spaces"} G-spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ⊂
                  %mi X
                %annotation{:encoding => "application/x-tex"} U \subset X
            of a given ambient
            %a.existingWikiWord{:href => "/nlab/show/topological+G-space"} topological G-space
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            Here by a
            %em slice theorem
            is traditionally meant a list of sufficient conditions which guarantee that suitable slices do exist in a given situation. This plays a central role for instance in the
            %a.existingWikiWord{:href => "/nlab/show/local+triviality"} local triviality
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/equivariant+bundles"} equivariant bundles
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/physics"} physics
            one typically considers this for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/gauge+group"} gauge group
            %em gauge slices
            and thinks of these as a choice of
            %em
              %a.existingWikiWord{:href => "/nlab/show/gauge+fixing"} gauge fixing
            (see there for more).
          %h2#slices_of_group_action Slices of group action
          %p
            There is the following
            %a.existingWikiWord{:href => "/nlab/show/general+abstract"} general abstract
            definition of slices via
            %a.existingWikiWord{:href => "/nlab/show/adjunctions"} adjunctions
            (which however seems not to be made explicit in existing literature):
          %p
          #HSlice.num_defn
            %h6 Definition
            %p
              %strong
                (
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
                \-slice)
              %br/
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo ⊂
                    %mi G
                  %annotation{:encoding => "application/x-tex"} H \subset G
              be a
              %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
              inclusion such that restricting given
              %a.existingWikiWord{:href => "/nlab/show/actions"} actions
              (
              %a.existingWikiWord{:href => "/nlab/show/internalization"} internal
              to a given ambient
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/category"} category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              has a
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %msub
                      %mo ×
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G \times_{H} (-)
              (e.g. for
              %a.existingWikiWord{:href => "/nlab/show/topological+G-spaces"} topological G-spaces
              the
              = succeed ")." do
                %a{:href => "topological+G-space#induced_action"} topological induced action
            %p
              Then an
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
                \-slice
              in a
              = succeed "-action" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              is an
              = succeed "-subaction" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mover
                      %mo ↪
                      %mi i
                    %mi U
                  %annotation{:encoding => "application/x-tex"} S \overset{i}{\hookrightarrow} U
              whose induction/restriction-
              %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
              is an
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %msub
                      %mo ×
                      %mi H
                    %mi S
                    %munderover
                      %mo ⟶
                      %mo ≃
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mover
                          %mi i
                          %mo{:stretchy => "false"} ˜
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                    %mi U
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    G \times_ H S
                    \\underoverset
                    {\simeq}
                    {
                    \\;\;
                    \\tilde i
                    \\;\;
                    }
                    {\longrightarrow}
                    U
                    \\,.
            %p
          %p Here are more traditional ways to say this:
          %p
          #SlicesDef.num_defn
            %h6 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
