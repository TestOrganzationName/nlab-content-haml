                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi H
                        %mo{:stretchy => "false"} ]
                        %mo ∈
                        %mi G
                        %mo{:stretchy => "false"} /
                        %mi H
                      %annotation{:encoding => "application/x-tex"} [H] \in G/H
                  in the
                  %a.existingWikiWord{:href => "/nlab/show/coset+space"} coset space
                  under a
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
