            = succeed ".)" do
              %a{:href => "#ZZ04"} Zambon &amp; Zhu, Lemma 3.11
          %h2#properties Properties
          %h3#existence_of_slices Existence of slices
          %p
            A
            %em slice theorem
            is a statement of sufficient conditions such that there is a slice through each point of a given
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/topological+G-space"} topological G-space
          %p
          #ExistenceOfSlicesInProperActionsOnLocallyCompactSpaces.num_prop
            %h6 Proposition
            %p
              %strong (existence of local slices for proper actions on locally compact spaces)
              %br/
              Let
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                  be the
                  %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological group
                  underlying a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  be a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/locally+compact+Hausdorff+space"} locally compact Hausdorff space
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                        %mo ×
                        %mi X
                        %mover
                          %mo →
                          %mi ρ
                        %mi X
                      %annotation{:encoding => "application/x-tex"} G \times X \overset{\rho}{\to} X
                  be a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/proper+action"} proper action
            %p
              Then for every point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              there exists a slice through
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#SlicesDef"}
          %p
            This is due to
            = succeed "," do
              %a{:href => "#Palais61"} Palais 61, Prop. 2.3.1
            = succeed "." do
              %a{:href => "#Karppinen16"} Karppinen 2016, Thm. 6.2.7
          %p
          #PalaisProofBeyondLocalCompactness.num_remark
            %h6 Remark
            %p
              The thrust of
              %a{:href => "#Palais61"} Palais 61
              is to state Prop.
              %a.maruku-ref{:href => "#ExistenceOfSlicesInProperActionsOnLocallyCompactSpaces"}
              without the assumption that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+space"} locally compact
              = succeed "\u201D" do
                %a.existingWikiWord{:href => "/nlab/show/proper+action"} proper action
              = succeed "\u201D," do
                %a{:href => "proper+action#PalaisProperness"} Palais proper action
              = succeed ")." do
                %a{:href => "#Palais61"} Palais 61, Def. 1.2.2
              = succeed "." do
                %a{:href => "#Karppinen16"} Karppinen 2016, Rem. 5.2.4
          %p
            When the group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is
            %a.existingWikiWord{:href => "/nlab/show/compact+Lie+group"} compact Lie
            then the condition on the
            = succeed "-space" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            may be relaxed:
          %p
          #ExistenceOfSlicesInCompactGroupActionsOnCompletelyRegularSpaces.num_prop
            %h6 Proposition
            %p
              %strong
                (existence of local slices for
                %a.existingWikiWord{:href => "/nlab/show/compact+topological+group"} compact group
                actions on
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/completely+regular+spaces"} completely regular spaces
              %br/
            %p Let
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                  be a
                  %a.existingWikiWord{:href => "/nlab/show/compact+Lie+group"} compact Lie group
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/completely+regular+topological+space"} completely regular topological space
            %p
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ×
                    %mi X
                    %mover
                      %mo →
                      %mi ρ
                    %mi X
                  %annotation{:encoding => "application/x-tex"} G \times X \overset{\rho}{\to} X
              any
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/group+action"} action
            %p
              Then for every point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              there exists a slice through
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#SlicesDef"}
          This is due to
          = succeed "," do
            %a{:href => "#Mostow57"} Mostow 1957, Thm. 2.1
          = succeed "." do
            %a{:href => "#Palais60b"} Palais 60b, Cor. 1.7.19
          = succeed "," do
            %a{:href => "#Palais61"} Palais 61, Prop. 2.3.1
          = succeed ")." do
            %a{:href => "#Karppinen16"} Karppinen 2016, Prop. 5.1.7
          %p
            For
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth
            %a.existingWikiWord{:href => "/nlab/show/G-manifolds"} G-manifolds
            the
            = succeed "-space" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            may be taken to be a
            %a.existingWikiWord{:href => "/nlab/show/linear+representation"} linear representation
            (e.g.
            = succeed ")." do
              %a{:href => "#tomDieck87"} tomDieck 87, Thm. 5.6
          %p
          #NeedForAssumptionOfLieGroup.num_remark
            %h6 Remark
            %p
              The assumption of a
              %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
              in Prop.
              %a.maruku-ref{:href => "#ExistenceOfSlicesInCompactGroupActionsOnCompletelyRegularSpaces"}
              seems to be necessary. A
              %a.existingWikiWord{:href => "/nlab/show/counterexample"} counterexample
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              just a
              %a.existingWikiWord{:href => "/nlab/show/compact+topological+group"} compact topological group
              may be extracted from
              = succeed "." do
                %a{:href => "#Williams63"} Williams 1963
          %h2#examples_and_applications Examples and applications
          %h3#general General
          %p
          #GSliceThroughGFixedPoint.num_remark
            %h6 Example
            %p
              %strong
                (
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                \-slice through
                = succeed "-fixed" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
              %br/
              If a point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              in a
              %a.existingWikiWord{:href => "/nlab/show/topological+G-space"} topological G-space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
              %a.existingWikiWord{:href => "/nlab/show/fixed+point"} fixed
              by all of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Stab
                        %mi G
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo =
                      %mspace{:width => "thinmathspace"}
                      %mi G
                    %annotation{:encoding => "application/x-tex"} Stab_G(x) \,=\, G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              itself is a
              = succeed "-slice" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              (Def.
              = succeed ")," do
                %a.maruku-ref{:href => "#SlicesDef"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %msub
                      %mo ×
                      %mi G
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo ≃
                    %mspace{:width => "thinmathspace"}
                    %mi X
                  %annotation{:encoding => "application/x-tex"} G \times_G X \,\simeq\, X
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %munder
                        %mo ⊂
                        %mi open
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X \underset{open}{\subset} X
          %p
          #SlicesThroughPointsInPuncturedOrthogonalRepresentation.num_remark
            %h6 Example
            %p
              %strong (slices through points in orthogonal representation)
              %br/
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              consider the defining
              %a.existingWikiWord{:href => "/nlab/show/group+action"} group action
              of the
              %a.existingWikiWord{:href => "/nlab/show/orthogonal+group"} orthogonal group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ≔
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G \coloneqq O(n+1)
              on the
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^{n+1}
            %p
              Then two cases of
              %a.existingWikiWord{:href => "/nlab/show/stabilizer+groups"} stabilizer groups
              appear:
            %ol
              %li
                %p
                  the origin
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 0
                        %mspace{:width => "thinmathspace"}
                        %mo ∈
                        %mspace{:width => "thinmathspace"}
                        %msup
                          %mi ℝ
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} 0 \,\in\, \mathbb{R}^{n+1}
                  is
                  %a.existingWikiWord{:href => "/nlab/show/fixed+point"} fixed
                  by all of
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi O
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo +
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} O(n+1)
                  = succeed "-slice" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi Stab
                            %mi G
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi O
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo +
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} Stab_G(0) = O(n+1)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^{n+1}
                  (by Ex.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#GSliceThroughGFixedPoint"}
                  %a.existingWikiWord{:href => "/nlab/show/open+ball"} open ball
                  around it;
              %li
                %p
                  for every other point
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %msup
                          %mi ℝ
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                        %mo ∖
                        %mo{:stretchy => "false"} {
                        %mn 0
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} x \in \mathbb{R}^{n+1} \setminus \{0\}
                  the
                  %a.existingWikiWord{:href => "/nlab/show/stabilizer+subgroup"} stabilizer subgroup
                  is
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi G
                          %mi x
                        %mo =
                        %mi O
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} G_x = O(n)
                  and the
                  %a.existingWikiWord{:href => "/nlab/show/coset+space"} coset space
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                        %mo{:stretchy => "false"} /
                        %msub
                          %mi G
                          %mi x
                        %mo =
                        %msup
                          %mi S
                          %mi n
                      %annotation{:encoding => "application/x-tex"} G/G_x = S^n
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/n-sphere"} n-sphere
                  (see
                  = succeed ")." do
                    %a{:href => "sphere#LabelCosetSpaceStructure"} there
            %p
              The ray
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi R
                      %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo ≔
                    %mspace{:width => "thinmathspace"}
                    %mo{:stretchy => "false"} {
                    %mi c
                    %mo ⋅
                    %mi x
                    %mo{:stretchy => "false"} |
                    %mi c
                    %mo ∈
                    %msub
                      %mi ℝ
                      %mrow
                        %mo &gt;
                        %mn 0
                    %mo{:stretchy => "false"} }
                    %mo ⊂
                    %msup
                      %mi ℝ
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo ∖
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} R_X \,\coloneqq\, \{c \cdot x \vert c \in \mathbb{R}_{\gt 0}\} \subset \mathbb{R}^{n+1} \setminus \{0\}
              has
              %a.existingWikiWord{:href => "/nlab/show/orbit"} orbit
              the
              %a.existingWikiWord{:href => "/nlab/show/complement"} complement
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo ∖
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{n+1} \setminus \{0\}
              and is thus an
              = succeed "-slice" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi O
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} O(n)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SlicesDef"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo ∖
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                    %mo ⟶
                    %msup
                      %mi S
                      %mi n
                    %mo =
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R}^{n+1}
                    \\setminus
                    \\{0\}
                    \\longrightarrow
                    S^n
                    \=
                    O(n+1)/O(n)
                    \\,.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi R
                      %mi x
                    %msub
                      %mo ×
                      %mrow
                        %mi O
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi ℝ
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo ∖
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    R_x \times_{O(n)} O(n+1)
                    \\;\simeq\;
                    \\mathbb{R}^{n+1} \setminus \{0\}
                    \\,.
            %p
          (also
          = succeed ")" do
            %a{:href => "#Karppinen16"} Karppinen 2016, Ex. 6.1.10
          %p
          .num_remark
            %h6 Example
            %p
              If
              %a.existingWikiWord{:href => "/nlab/show/time"} time
              evolution on some
              %a.existingWikiWord{:href => "/nlab/show/Lorentzian+manifold"} Lorentzian manifold
              is given as an
              = succeed "-action" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^1
              %a.existingWikiWord{:href => "/nlab/show/timelike"} timelike
              flow lines, then slices (“1-slices”) for this action are known as
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Cauchy+surfaces"} Cauchy surfaces
          %h3#PrincipalBundles Principal bundles
          %p
          #SlicesOfFreeActionsThroughEachPointImplyPrincipalQuotient.num_prop
            %h6 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/slice+theorem"} slice theorem
                implies that
                %a.existingWikiWord{:href => "/nlab/show/free+action"} free
                %a.existingWikiWord{:href => "/nlab/show/quotient+space"} quotient
                is
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
              %br/
              Consider a
              %a.existingWikiWord{:href => "/nlab/show/topological+G-space"} topological G-space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              such that
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/group+action"} action
                  by
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                  is
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/free+action"} free
              %li
                %p
                  there exist slices
                  %em through
                  each
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %mo ∈
                        %mi P
                      %annotation{:encoding => "application/x-tex"} p \in P
                  (Def.
                  = succeed ")." do
                    %a.maruku-ref{:href => "#SlicesDef"}
            %p
              Then the
              %a.existingWikiWord{:href => "/nlab/show/quotient+space"} quotient space
              %a.existingWikiWord{:href => "/nlab/show/coprojection"} coprojection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mover
                      %mo →
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mi q
                        %mspace{:width => "thickmathspace"}
                    %mi P
                    %mo{:stretchy => "false"} /
                    %mi G
                  %annotation{:encoding => "application/x-tex"} P \xrightarrow{\;q\;} P/G
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/locally+trivial+fiber+bundle"} locally trivial fiber bundle
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
          (
          %a{:href => "#Palais61"}> Palais 1961, p. 315, Sec. 4.1
          )
          .proof
            %h6 Proof
            %p
              We need to show that for each point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi P
                    %mo{:stretchy => "false"} /
                    %mi G
                  %annotation{:encoding => "application/x-tex"} x \in P/G
              there exists an
              %a.existingWikiWord{:href => "/nlab/show/open+neighbourhood"} open neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi U
                      %mi x
                    %mspace{:width => "thinmathspace"}
                    %mo ⊂
                    %mspace{:width => "thinmathspace"}
                    %mi P
                    %mo{:stretchy => "false"} /
                    %mi G
                  %annotation{:encoding => "application/x-tex"} x \,\in\, U_x \,\subset\, P/G
              such that its
              %a.existingWikiWord{:href => "/nlab/show/preimage"} preimage
              under the
              %a.existingWikiWord{:href => "/nlab/show/coprojection"} coprojection
              is
              %a.existingWikiWord{:href => "/nlab/show/equivariant+function"} equivariantly
              %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphic
              to its
              %a.existingWikiWord{:href => "/nlab/show/product+space"} product space
              with
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
            #eq:ConditionToBeShownInProofOfPrincipalityFromSliceTheorem.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ×
                    %msub
                      %mi U
                      %mi x
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi q
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi G
                    %mi Act
                    %mo{:stretchy => "false"} (
                    %mi TopSp
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    G \times U _x
                    \\;\simeq\;
                    q^{-1}(U_x)
                    \\;\;\;\;\;\;
                    \\in
                    \\;
                    G Act(TopSp)
                    \\,.
            %p
              Now, picking any
              %a.existingWikiWord{:href => "/nlab/show/preimage"} preimage
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi x
                        %mo{:stretchy => "false"} ^
                      %mspace{:width => "thinmathspace"}
                      %mo ∈
                      %mspace{:width => "thinmathspace"}
                      %msup
                        %mi q
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mo{:stretchy => "false"} {
                      %mi x
                      %mo{:stretchy => "false"} }
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mspace{:width => "thinmathspace"}
                      %mo ⊂
                      %mspace{:width => "thinmathspace"}
                      %mi P
                    %annotation{:encoding => "application/x-tex"} \hat x \,\in\, q^{-1}\big(\{x\}\big) \,\subset\, P
              = succeed "-slice" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi G
                        %mover
                          %mi x
                          %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} G_{\hat x}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mover
                        %mi x
                        %mo{:stretchy => "false"} ^
                    %mspace{:width => "thinmathspace"}
                    %mo ⊂
                    %mspace{:width => "thinmathspace"}
                    %mi P
                  %annotation{:encoding => "application/x-tex"} S_{\hat x} \,\subset\, P
              through an
              %a.existingWikiWord{:href => "/nlab/show/open+neighbourhood"} open neighbourhood
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi x
                        %mo{:stretchy => "false"} ^
                      %mo ∈
                      %msub
                        %mover
                          %mi U
                          %mo ^
                        %mover
                          %mi x
                          %mo{:stretchy => "false"} ^
                      %mspace{:width => "thinmathspace"}
                      %mo ⊂
                      %mspace{:width => "thinmathspace"}
                      %mi P
                    %annotation{:encoding => "application/x-tex"} \hat x \in \widehat{U}_{\hat x} \,\subset\, P
              = succeed "-action" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/free+action"} free
              %a.existingWikiWord{:href => "/nlab/show/stabilizer+subgroup"} stabilizer subgroup
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mover
                        %mi x
                        %mo{:stretchy => "false"} ^
                    %mspace{:width => "thinmathspace"}
                    %mo ≃
                    %mspace{:width => "thinmathspace"}
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} G_{\hat x} \,\simeq\, 1
              is necessarily the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/trivial+group"} trivial group
              %a.maruku-eqref{:href => "#eq:IsomorphismDefiningASlice"} (1)
              of the slice is:
            #eq:LocalTrivializationInProofOfPrincipalityFromSliceTheorem.maruku-equation
              %span.maruku-eq-number (3)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi G
                            %mo ×
                            %msub
                              %mi S
                              %mover
                                %mi x
                                %mo{:stretchy => "false"} ^
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mo ∼
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                          %mtd
                            %msub
                              %mover
                                %mi U
                                %mo ^
                              %mover
                                %mi x
                                %mo{:stretchy => "false"} ^
                          %mtd
                            %munder
                              %mo ⊂
                              %mi open
                            %mspace{:width => "thickmathspace"}
                            %mi P
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi g
                            %mo ,
                            %mi p
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %mi g
                            %mo ⋅
                            %mi p
                            %mpadded{:width => "0"}
                              %mrow
                                %mspace{:width => "thinmathspace"}
                                %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    G \times S_{\hat x}
                    \&amp;
                    \\xrightarrow{ \;\; \sim \;\; }
                    \&amp;
                    \\widehat{U}_{\hat x}
                    \&amp;
                    \\underset{open}{\subset}
                    \\;
                    P
                    \\\
                    (g, p)
                    \&amp;\mapsto&amp;
                    g \cdot p
                    \\mathrlap{\,.}
                    }
            %p Setting
            #eq:OpenChartInProofOfPrincipalityFromSliceTheorem.maruku-equation
              %span.maruku-eq-number (4)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mover
                        %mi U
                        %mo ^
                      %mover
                        %mi x
                        %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} /
                    %mi G
                    %mspace{:width => "thickmathspace"}
                    %mo ⊂
                    %mspace{:width => "thickmathspace"}
                    %mi P
                    %mo{:stretchy => "false"} /
                    %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    U_x
                    \\;\coloneqq\;
                    \\widehat{U}_{\hat x}/G
                    \\;\subset\;
                    P/G
                    \\,,
            %p observe that this implies:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi q
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mover
                        %mi U
                        %mo ^
                      %mover
                        %mi x
                        %mo{:stretchy => "false"} ^
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    q^{-1}(U_x)
                    \\;\simeq\;
                    \\widehat{U}_{\hat x}
                    \\,.
            %p and this implies the claim:
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi U
                          %mi x
                        %mspace{:width => "thinmathspace"}
                        %mo ⊂
                        %mspace{:width => "thinmathspace"}
                        %mi P
                        %mo{:stretchy => "false"} /
                        %mi G
                      %annotation{:encoding => "application/x-tex"} U_x \,\subset\, P/G
                  is an
                  %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
                %p
                  (since
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mover
                            %mi U
                            %mo ^
                          %mover
                            %mi x
                            %mo{:stretchy => "false"} ^
                        %mspace{:width => "thinmathspace"}
                        %mo ⊂
                        %mspace{:width => "thinmathspace"}
                        %mi P
                      %annotation{:encoding => "application/x-tex"} \widehat U_{\hat x} \,\subset\, P
                  is
                  %a.existingWikiWord{:href => "/nlab/show/open+subset"} open
                  and using the definition of the
                  = succeed ");" do
                    %a{:href => "quotient+space#QuotientTopologicalSpace"} quotient topology
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi U
                          %mi x
                      %annotation{:encoding => "application/x-tex"} U_x
                  satisfies the required condition
                  %a.maruku-eqref{:href => "#eq:ConditionToBeShownInProofOfPrincipalityFromSliceTheorem"} (2)
                %p
                  (since this is now the slice condition
                  = succeed ")," do
                    %a.maruku-eqref{:href => "#eq:LocalTrivializationInProofOfPrincipalityFromSliceTheorem"} (3)
            %p
              (In fact, the slice
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mi x
                  %annotation{:encoding => "application/x-tex"} S_x
              we used in this argument gives the function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                    %mover
                      %mo →
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mo ∼
                        %mspace{:width => "thickmathspace"}
                    %msub
                      %mi S
                      %mi x
                    %mover
                      %mo ↪
                      %mspace{:width => "thickmathspace"}
                    %mi P
                  %annotation{:encoding => "application/x-tex"}
                    U_x \xrightarrow{\;\sim\;} S_x \xhookrightarrow{\;} P
              which is the
              %a.existingWikiWord{:href => "/nlab/show/local+section"} local section
              that exhibits the
              = succeed ".)" do
                %a.existingWikiWord{:href => "/nlab/show/local+trivialization"} local trivialization
          %p
            As a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/corollary"} corollary
          %p
          #FreeAndProperLieGroupActionsOnLCHSpacesArePrincipal.num_prop
            %h6 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/free+action"} free
                and
                %a.existingWikiWord{:href => "/nlab/show/proper+action"} proper
                %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
                %a.existingWikiWord{:href => "/nlab/show/group+action"} actions
                on
                %a.existingWikiWord{:href => "/nlab/show/locally+compact+Hausdorff+spaces"} locally compact Hausdorff spaces
                are
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/locally+trivial+bundle"} locally trivial
              %br/
              Consider a
              %a.existingWikiWord{:href => "/nlab/show/topological+G-space"} topological G-space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              such that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                  carries the structure of a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi P
                      %annotation{:encoding => "application/x-tex"} P
                  is a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/locally+compact+Hausdorff+space"} locally compact Hausdorff space
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/group+action"} action
                  by
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                  is
                  %a.existingWikiWord{:href => "/nlab/show/free+action"} free
                  and
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/proper+action"} proper
            %p
              Then the
              %a.existingWikiWord{:href => "/nlab/show/quotient+space"} quotient space
              %a.existingWikiWord{:href => "/nlab/show/coprojection"} coprojection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mover
                      %mo →
                      %mi q
                    %mi P
                    %mo{:stretchy => "false"} /
                    %mi G
                  %annotation{:encoding => "application/x-tex"} P \xrightarrow{q} P/G
              is a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
          .proof
            %h6 Proof
            %p
              By Prop.
              %a.maruku-ref{:href => "#ExistenceOfSlicesInProperActionsOnLocallyCompactSpaces"}
              the assumptions imply that through each point there exists a slice, so that the claim follows by Prop.
              = succeed "." do
                %a.maruku-ref{:href => "#SlicesOfFreeActionsThroughEachPointImplyPrincipalQuotient"}
          %p
          .num_remark
            %h6 Remark
            %p
              Due to Prop.
              = succeed "," do
                %a.maruku-ref{:href => "#FreeAndProperLieGroupActionsOnLCHSpacesArePrincipal"}
              %em define
              a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
              to be a free and proper action on a locally compact Hausdorff space, without mentioning local trivializability (e.g.
              = succeed ")." do
                %a{:href => "https://www.jstor.org/stable/24896249"} Raeburn &amp; Williams 1991, Def. 2.1
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/topological+G-space"}> topological G-space
                ,
                %a.existingWikiWord{:href => "/nlab/show/G-manifold"} G-manifold
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/compact+Lie+group"} compact Lie group
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/equivariant+bundle"} equivariant bundle
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/equivariant+differential+topology"} equivariant differential topology
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/equivariant+Tietze+extension+theorem"} equivariant Tietze extension theorem
          %h2#references References
          %p Original discussion:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Andrew+Gleason"}> Andrew Gleason
                ,
                = succeed "," do
                  %em Spaces With a Compact Lie Group of Transformations
                %strong 1
                1 (1950) 35-4 &amp;lbrack;
                %a{:href => "https://www.jstor.org/stable/2032430"}> jstor:2032430
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.2307/2032430"} doi:10.2307/2032430
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Deane+Montgomery"}> Deane Montgomery
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Chung+Tao+Yang"} Chung Tao Yang
                = succeed "," do
                  %em The existence of a slice
                %strong 65
                (1957) 108-116 &amp;lbrack;
                %a{:href => "https://www.jstor.org/stable/1969667"}> jstor:1969667
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.2307/1969667"} doi:10.2307/1969667
            %li#Mostow57
              %p
                %a.existingWikiWord{:href => "/nlab/show/George+Mostow"}> George Mostow
                ,
                = succeed "," do
                  %em Equivariant embeddings in Euclidean space
