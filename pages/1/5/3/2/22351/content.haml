                                    %mo{:stretchy => "false"} ]
                                  %mtd
                                    %mo ↦
                                  %mtd
                                    %mi g
                                    %mo ⋅
                                    %mi s
                          %annotation{:encoding => "application/x-tex"}
                            \\array{
                            G \times_H S
                            \&amp;
                            \\overset
                            {\simeq}
                            {
                            \\longrightarrow
                            }
                            \&amp;
                            G \cdot S
                            \\\
