                  F = 0
                  \\,,
          %p
            saying that the
            %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
            gauge fields are precisely the
            %a.existingWikiWord{:href => "/nlab/show/flat+connections"} flat connections
            with vanishing
            %a.existingWikiWord{:href => "/nlab/show/flux+density"} flux density
