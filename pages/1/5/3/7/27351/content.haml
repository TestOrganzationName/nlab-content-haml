                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mn 2
                  %mi ϕ
                  %mo ⋅
                  %mi M
                  %mo ⋅
                  %mi ϕ
                  %mo +
                  %mi J
                  %mo ⋅
                  %mi ϕ
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                %annotation{:encoding => "application/x-tex"}
                  Z(J)
                  \\;\coloneqq\;
                  \\int \mathrm{d}^n \phi\;
                  \\exp\Big(
                  \- \tfrac{1}{2}
                  \\phi \cdot M \cdot \phi
