            is the
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+level"} Chern-Simons level
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
