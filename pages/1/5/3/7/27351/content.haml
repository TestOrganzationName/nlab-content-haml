                    %mover
                      %mi Σ
                      %mo ^
                    %mn 4
                %annotation{:encoding => "application/x-tex"} \widehat{\Sigma}^4
            (arising as the gluing of one choice of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Σ
                    %mn 4
                %annotation{:encoding => "application/x-tex"} \Sigma^4
            with the orientation reversal of any other along their common boundary
            = succeed ")" do
