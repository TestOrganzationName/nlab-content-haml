                    %mi F
                    %mo =
                    %mi{:mathvariant => "normal"} d
                    %mi A
                  %annotation{:encoding => "application/x-tex"} F = \mathrm{d}A
          %h2#properties Properties
          %h3#SpaceOfQuantumStates Space of quantum states
          %p
            For abelian Chern-Simons theory with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
