                  J \cdot \phi
                  \\Big)
          %p evaluates to
          #eq:EvaluationOfOrdinaryGaussianIntegral.maruku-equation
            %span.maruku-eq-number (10)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Z
                  %mo{:stretchy => "false"} (
                  %mi J
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mi Z
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
