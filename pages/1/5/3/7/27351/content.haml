                  %mo{:maxsize => "2.4em", :minsize => "2.4em"} (
                  %mi{:mathvariant => "normal"} i
                  %mstyle{:displaystyle => "false"}
                    %munder
                      %mo ∫
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msup
