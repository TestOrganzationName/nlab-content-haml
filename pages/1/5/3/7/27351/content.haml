            is a
            %a.existingWikiWord{:href => "/nlab/show/quadratic+form"} quadratic form
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
