            %a.existingWikiWord{:href => "/nlab/show/derivative"} derivative
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mi{:mathvariant => "normal"} d
                  %mi A
                %annotation{:encoding => "application/x-tex"} A \mathrm{d} A
            into a
            %a.existingWikiWord{:href => "/nlab/show/multiplication"} multiplication
            operation) with some care (such as with attention to
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/gauge+fixing"} gauge fixing
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:maxsize => "3em", :minsize => "3em"} ⟨
