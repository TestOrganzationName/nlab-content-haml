          %h2#idea Idea
          %p
            By
            %em abelian Chern-Simons theory
            one means
            %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
            with
            %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian
            %a.existingWikiWord{:href => "/nlab/show/gauge+group"} gauge group
            (typically the
            %a.existingWikiWord{:href => "/nlab/show/circle+group"} circle group
            or a
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/torus"} torus
            %a.existingWikiWord{:href => "/nlab/show/product+group"} product
            of copies of that).
          %p
            One major application of abelian Chern-Simons theory is as an
            %a.existingWikiWord{:href => "/nlab/show/effective+field+theory"} effective field theory
            of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/fractional+quantum+Hall+effect"} fractional quantum Hall effect
            = succeed "." do
              %a{:href => "#AbelianCSTheoryAsEffectiveQFTForFRactionalQuantumHall"} below
          %h2#definition Definition
          %h3#LagrangianDensityAndLevel The Lagrangian density and the Level
          %p
            For the time being we normalize
            %a.existingWikiWord{:href => "/nlab/show/connection"} connection
            %a.existingWikiWord{:href => "/nlab/show/differential+forms"} forms
            according to the common convention in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/theoretical+physics"} theoretical physics
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/field+strength"} field strength
            %a.existingWikiWord{:href => "/nlab/show/flux+density"} flux density
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mi A
                  %mo ≔
                  %mi{:mathvariant => "normal"} d
                  %mi A
                %annotation{:encoding => "application/x-tex"} F_A \coloneqq \mathrm{d}A
            is such that
          #eq:NormalizationPfFluxDensity.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mrow
                        %mn 2
                        %mi π
                  %msub
                    %mi F
                    %mi A
                  %mspace{:width => "thickmathspace"}
                  %mo ∈
                  %mspace{:width => "thickmathspace"}
                  %msubsup
                    %mi Ω
                    %mi int
                    %mn 2
                %annotation{:encoding => "application/x-tex"}
                  \\tfrac{1}{2\pi} F_A
                  \\;\in\;
                  \\Omega^2_{int}
          %p
            is an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/integral+form"} integral form
            %a.existingWikiWord{:href => "/nlab/show/integer"} integer
            %a{:href => "period#InDifferentialGeometry"} periods
            (cf.
            %em
              %a.existingWikiWord{:href => "/nlab/show/Dirac+charge+quantization"} Dirac charge quantization
            and
            = succeed ")." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/ordinary+differential+cohomology"} ordinary differential cohomology
          %p
            The (local)
            %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
            of abelian Chern-Simons theory is a multiple of the
            %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+form"} Chern-Simons form
            of the gauge field
          #eq:TheLagrangianDensity.maruku-equation
            %span.maruku-eq-number (2)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mi K
                      %mrow
                        %mn 4
                        %mi π
                  %mi A
                  %mo ∧
                  %mi{:mathvariant => "normal"} d
                  %mi A
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"}
                  L(A)
                  \\;\coloneqq\;
                  \\tfrac{K}{4\pi} A \wedge \mathrm{d} A
                  \\,
          %p
            for a numerical parameter
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Σ
                    %mn 3
                %annotation{:encoding => "application/x-tex"} \Sigma^3
            (a
            %a.existingWikiWord{:href => "/nlab/show/closed+manifold"} closed
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/3-manifold"} 3-manifold
            %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Σ
                    %mn 3
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mi K
                      %mrow
                        %mn 4
                        %mi π
                  %mstyle{:displaystyle => "false"}
                    %mrow
                      %msub
                        %mo ∫
                        %mrow
                          %msup
                            %mi Σ
                            %mn 3
                    %mi A
                    %mo ∧
                    %mi{:mathvariant => "normal"} d
                    %mi A
                %annotation{:encoding => "application/x-tex"}
                  S(\Sigma^3, A)
                  \\;\coloneqq\;
                  \\tfrac{K}{4\pi}
                  \\textstyle{\int_{\Sigma^3}}
                  A \wedge \mathrm{d}A
          %p
            has
            %a.existingWikiWord{:href => "/nlab/show/gauge+invariance"} gauge-invariant
            %a.existingWikiWord{:href => "/nlab/show/exponential"} exponential
          #eq:ExponentiatedActionFunctional.maruku-equation
            %span.maruku-eq-number (3)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                  %mi{:mathvariant => "normal"} i
                  %mi S
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mi exp
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                  %mi{:mathvariant => "normal"} i
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mi K
                      %mrow
                        %mn 4
                        %mi π
                  %mstyle{:displaystyle => "false"}
                    %mrow
                      %msub
                        %mo ∫
                        %mrow
                          %msup
                            %mi Σ
                            %mn 3
                    %mi A
                    %mo ∧
                    %mi{:mathvariant => "normal"} d
                    %mi A
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi{:mathvariant => "normal"} U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\exp\Big(
                  \\mathrm{i} S(A)
                  \\Big)
                  \\;=\;
                  \\exp\Big(
                  \\mathrm{i}
                  \\tfrac{K}{4\pi}
                  \\textstyle{\int_{\Sigma^3}}
                  A \wedge \mathrm{d}A
                  \\Big)
                  \\;\in\;
                  \\mathrm{U}(1)
                  \\,.
          %p
            A transparent way to understand this condition is to consider (in the style of the definition of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Cheeger-Simons+differential+characters"} Cheeger-Simons differential characters
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"} Witten
            %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
            %a.existingWikiWord{:href => "/nlab/show/4-manifold"} 4-manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Σ
                    %mn 4
                %annotation{:encoding => "application/x-tex"} \Sigma^4
            %a.existingWikiWord{:href => "/nlab/show/manifold+with+boundary"} with boundary
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Σ
                    %mn 3
                  %mo =
                  %mo ∂
                  %msup
                    %mi Σ
                    %mn 4
                %annotation{:encoding => "application/x-tex"} \Sigma^3 = \partial \Sigma^4
            and an extension of the
            = succeed "-connection" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{U}(1)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Σ
                      %mn 4
                  %annotation{:encoding => "application/x-tex"} \Sigma^4
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/field+strength"} field strength
            %a.existingWikiWord{:href => "/nlab/show/flux+density"} flux density
            still by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
          %p
            Then
            %a.existingWikiWord{:href => "/nlab/show/Stokes%27+theorem"} Stokes' theorem
            gives
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                  %mi{:mathvariant => "normal"} i
                  %mi S
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mi exp
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                  %mi{:mathvariant => "normal"} i
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mi K
                      %mrow
                        %mn 4
                        %mi π
                  %mstyle{:displaystyle => "false"}
                    %mrow
                      %msub
                        %mo ∫
                        %mrow
                          %msup
                            %mi Σ
                            %mn 4
                    %mi F
                    %mo ∧
                    %mi F
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi exp
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                    %mi K
                    %mi π
                    %mi{:mathvariant => "normal"} i
                    %mstyle{:displaystyle => "false"}
                      %mrow
                        %msub
                          %mo ∫
                          %mrow
                            %msup
                              %mi Σ
                              %mn 4
                      %mfrac
                        %mi F
                        %mrow
                          %mn 2
                          %mi π
                      %mo ∧
                      %mfrac
                        %mi F
                        %mrow
                          %mn 2
                          %mi π
                      %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\exp\Big(
                  \\mathrm{i} S(A)
                  \\Big)
                  \\;=\;
                  \\exp\Big(
                  \\mathrm{i}
                  \\tfrac{K}{4\pi}
                  \\textstyle{\int_{\Sigma^4}}
                  F \wedge F
                  \\Big)
                  \\;=\;
                  \\exp\Big(
                  K \pi \mathrm{i}
                  \\textstyle{\int_{\Sigma^4}}
                  \\frac{F}{2\pi} \wedge \frac{F}{2\pi}
                  \\Big)
                  \\,,
          %p
            which reveals that the expression is well-defined — in that it takes the same value for any other choice of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
