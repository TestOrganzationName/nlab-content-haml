                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mi lim
                      %mrow
                        %mi s
                        %mo →
                        %mn 0
                    %mi exp
                    %mo{:maxsize => "2.4em", :minsize => "2.4em"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mi{:mathvariant => "normal"} i
                        %mrow
                          %mn 4
                          %mi K
                    %mstyle{:displaystyle => "false"}
                      %munder
                        %mo ∬
                        %mrow
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi S
                            %mn 1
                          %msup
                            %mo{:stretchy => "false"} )
                            %mi n
                      %mspace{:width => "thinmathspace"}
                      %mi{:mathvariant => "normal"} d
                      %mi x
                      %mspace{:width => "thinmathspace"}
                      %mi{:mathvariant => "normal"} d
                      %mi y
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mi ϵ
                        %mrow
                          %mi μ
                          %mi ν
                          %mi ρ
                      %mfrac
                        %mrow
                          %msup
                            %mi x
                            %mi ρ
                          %mo −
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %msup
                            %mi y
                            %mi ρ
                          %mo +
                          %mi p
                          %msup
                            %mi n
                            %mi ρ
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mrow
                          %msup
                            %mrow
                              %mo |
                              %mi x
                              %mo −
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                              %mi y
                              %mo +
                              %mi s
                              %mi n
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                              %mo |
                            %mn 3
                      %mo{:maxsize => "2.4em", :minsize => "2.4em"} )
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\Bigg\langle
                  \\exp\bigg(
                  \\mathrm{i}
                  \\textstyle{\underset{{(S^1)^n}}{\int}}
                  \\gamma^\ast A
                  \\bigg)
                  \\Bigg\rangle
                  \\;\coloneqq\;
                  \\underset{
                  s \to 0
                  }{\lim}
                  \\exp\bigg(
                  \-\tfrac{\mathrm{i}}{4K}
                  \\textstyle{\underset{(S^1)^n}{\iint}}
                  \\,
                  \\mathrm{d} x
                  \\,
                  \\mathrm{d} y
                  \\,
                  \\epsilon_{\mu \nu \rho}
                  \\frac{
                  x^\rho
                  \-
                  \\big(y^\rho + p n^\rho\big)
                  }{
                  \\left\vert
                  x
                  \-
                  \\big(
                  y + s n
                  \\big)
                  \\right\vert^3
                  }
                  \\bigg)
                  \\,,
          %p
            where the
            %a.existingWikiWord{:href => "/nlab/show/limit+of+a+sequence"} limit
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mo →
                  %mn 0
                %annotation{:encoding => "application/x-tex"} s \to 0
            is over normal vector fields that keep the given
            %a.existingWikiWord{:href => "/nlab/show/direction+of+a+vector"} direction
            but shrink in
            %a.existingWikiWord{:href => "/nlab/show/length"} length
            (cf.
            = succeed ")." do
              %a{:href => "#GMR94"} GMR 1994 (1.5)
          %p
            This expression
            %a.maruku-eqref{:href => "#eq:AbelianCSWilsonLoopObservableRenormalized"} (13)
            is finally well-defined.
          %h4#the_knottheoretic_expression The knot-theoretic expression
          %p
            The shift along the framing vector in
            %a.maruku-eqref{:href => "#eq:AbelianCSWilsonLoopObservableRenormalized"} (13)
            does not change that part of the integral, with respect to the naive
            = succeed "," do
              %a.maruku-eqref{:href => "#eq:AbelianCSWilsonLoopObservableByNaivePathIntegral"} (12)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                %annotation{:encoding => "application/x-tex"} \sigma
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                  %mo ′
                %annotation{:encoding => "application/x-tex"} \sigma'
            run over distinct
            %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
            %a.maruku-eqref{:href => "#eq:ConnectedComponentsOfALink"} (7)
            of the link, hence that part now does give the sum of the
            %a.existingWikiWord{:href => "/nlab/show/linking+numbers"} linking numbers
            among the connected components of the the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/oriented+link"} oriented link
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                %annotation{:encoding => "application/x-tex"} \sigma
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                  %mo ′
                %annotation{:encoding => "application/x-tex"} \sigma'
            do run over the same connected component become the
            %a.existingWikiWord{:href => "/nlab/show/linking+number"} linking number
            of that component with its shift by the framing, which is its
            %em self-linking
            or
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/framing+number"} framing number
          %p
            The end result of this argument is hence, in the exponent, the sum of the
            %a.existingWikiWord{:href => "/nlab/show/framing+numbers"} framing numbers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi frm
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi γ
                    %mi i
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} frm(\gamma_i) \in \mathbb{Z}
            of each link component
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi γ
                    %mi i
                %annotation{:encoding => "application/x-tex"} \gamma_i
            %a.maruku-eqref{:href => "#eq:ConnectedComponentsOfALink"} (7)
            with the
            %a.existingWikiWord{:href => "/nlab/show/linking+numbers"} linking numbers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi lnk
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi γ
                    %mi i
                  %mo ,
                  %msub
                    %mi γ
                    %mi j
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} lnk(\gamma_i, \gamma_j) \in \mathbb{Z}
            all pairs of distinct link components, which is its
            %em
              %a.existingWikiWord{:href => "/nlab/show/writhe"} writhe
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi wrth
                  %mo{:stretchy => "false"} (
                  %mi γ
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} wrth(\gamma) \in \mathbb{Z}
            of the link:
          #eq:AbelianCSWilsonLoopsInTermsOfFramingAndLinkingNumbers.maruku-equation
            %span.maruku-eq-number (14)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:maxsize => "3em", :minsize => "3em"} ⟨
                  %mi exp
                  %mo{:maxsize => "2.4em", :minsize => "2.4em"} (
                  %mi{:mathvariant => "normal"} i
                  %mstyle{:displaystyle => "false"}
                    %munder
                      %mo ∫
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi S
                          %mn 1
                        %msup
                          %mo{:stretchy => "false"} )
                          %mi n
                    %msup
                      %mi γ
                      %mo *
                    %mi A
                    %mo{:maxsize => "2.4em", :minsize => "2.4em"} )
                    %mo{:maxsize => "3em", :minsize => "3em"} ⟩
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi exp
                    %mo{:maxsize => "2.4em", :minsize => "2.4em"} (
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mrow
                          %mi π
                          %mi{:mathvariant => "normal"} i
                        %mi K
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                    %munder
                      %munder
                        %mstyle{:displaystyle => "false"}
                          %mrow
                            %msub
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mi i
                          %mi frm
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi γ
                            %mi i
                          %mo{:stretchy => "false"} )
                          %mo +
                          %mstyle{:displaystyle => "false"}
                            %mrow
                              %msub
                                %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                                %mrow
                                  %mi i
                                  %mo ≠
                                  %mi j
                            %mi lnk
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi γ
                              %mi i
                            %mo ,
                            %msub
                              %mi γ
                              %mi j
                            %mo{:stretchy => "false"} )
                        %mo ⏟
                      %mrow
                        %mi wrth
                        %mo{:stretchy => "false"} (
                        %mi γ
                        %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                    %mo{:maxsize => "2.4em", :minsize => "2.4em"} )
                    %mpadded{:width => "0"}
                      %mrow
                        %mspace{:width => "thinmathspace"}
                        %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\Bigg\langle
                  \\exp\bigg(
                  \\mathrm{i}
                  \\textstyle{\underset{{(S^1)^n}}{\int}}
                  \\gamma^\ast A
                  \\bigg)
                  \\Bigg\rangle
                  \\;=\;
                  \\exp\bigg(
                  \\tfrac{\pi \mathrm{i}}{K}
                  \\Big(
                  \\underset{
                  wrth(\gamma)
                  }{
                  \\underbrace{
                  \\textstyle{\sum_{i}}
                  frm(\gamma_i)
                  +
                  \\textstyle{\sum_{i \neq j}}
                  lnk(\gamma_i, \gamma_j)
                  }
                  }
                  \\Big)
                  \\bigg)
                  \\mathrlap{\,.}
          %p
            (
            %a{:href => "#Witten89"}> Witten 1989 (2.31) ff
            , cf.
            = succeed "," do
              %a{:href => "#Kaul99"} Kaul 1999 (9)
            = succeed "," do
              %a{:href => "#GuadagniniThuillier08"} Guadagnini &amp; Thuillier 2008 (5.2)
            %a{:href => "#MezeiPufuWang17"} Mezei, Pufu &amp; Wang 2017 (5.1)
            = succeed ")" do
              %sup#fnref:1
                %a{:href => "#fn:1", :rel => "footnote"} 1
          %p
            Note though that none of the intermediate steps towards
            %a.maruku-eqref{:href => "#eq:AbelianCSWilsonLoopObservableRenormalized"} (13)
            was well-defined, so that this traditional argument — impactful as it historically was and “correct” as it may be in its conclusion
            %a.maruku-eqref{:href => "#eq:AbelianCSWilsonLoopsInTermsOfFramingAndLinkingNumbers"} (14)
            — is somewhat unsatisfactory as a derivation of quantum observables from input data.
          %p
            %br/
          %h3#AbelianCSTheoryAsEffectiveQFTForFRactionalQuantumHall Abelian Chern-Simons as effective QFT for FQH systems
          %p
            The following is a streamlined digest of the traditional argument and Ansatz &amp;lbrack;originally culminating in
            = succeed "," do
              %a{:href => "#Zee95"} Zee 1995
            = succeed "," do
              %a{:href => "#Wen95"} Wen 1995
            = succeed "," do
              %a{:href => "#Witten16"} Witten 2016 pp 30
            = succeed "&rbrack;" do
              %a{:href => "#Tong16"} Tong 2016 §5
            %a.existingWikiWord{:href => "/nlab/show/abelian+Chern-Simons+theory"} abelian Chern-Simons theory
            at
            %a.existingWikiWord{:href => "/nlab/show/level+%28Chern-Simons+theory%29"} level
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo ∈
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
            as an
            %a.existingWikiWord{:href => "/nlab/show/effective+field+theory"} effective field theory
            for
            %a.existingWikiWord{:href => "/nlab/show/fractional+quantum+Hall+systems"} fractional quantum Hall systems
            at filling fraction
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ν
                    %mo =
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mi k
                  %annotation{:encoding => "application/x-tex"} \nu = 1/2k
          %p
            %br/
          %h4#preliminaries Preliminaries
          %p
            Consider a
            %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            of
            %a.existingWikiWord{:href => "/nlab/show/dimension+of+a+manifold"} dimension
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo +
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 1 + 2
            %a.existingWikiWord{:href => "/nlab/show/worldvolume"} worldvolume
            of the conducting sheet that hosts the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/fractional+quantum+Hall+system"} fractional quantum Hall system
          %p
            On this spacetime, the electric
            %a.existingWikiWord{:href => "/nlab/show/current+density"} current density
            is a
            %a.existingWikiWord{:href => "/nlab/show/differential+2-form"} differential 2-form
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
          %p
            Note that the corresponding electric current
            %a.existingWikiWord{:href => "/nlab/show/vector+field"} vector field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi J
                    %mo{:stretchy => "false"} →
                %annotation{:encoding => "application/x-tex"} \vec J
            is characterized by its
            %a.existingWikiWord{:href => "/nlab/show/tensor+contraction"} contraction
            into the given
            %a.existingWikiWord{:href => "/nlab/show/volume+form"} volume form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi dvol
                %annotation{:encoding => "application/x-tex"} dvol
            being equal to the density 2-form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mi dvol
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mspace{:width => "thinmathspace"}
                  %mover
                    %mi J
                    %mo{:stretchy => "false"} →
                  %mo ,
                  %mi ⋯
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  J \;=\; dvol\big(\, \vec J, \cdots \big)
                  \\,,
          %p
            and that the conservation law for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi J
                      %mo{:stretchy => "false"} →
                  %annotation{:encoding => "application/x-tex"} \vec J
            %a.existingWikiWord{:href => "/nlab/show/divergence"} divergence
            is equivalent to the density 2-form being
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/closed+differential+form"} closed differential form
          #eq:CurrentConservationLaw.maruku-equation
            %span.maruku-eq-number (15)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi div
                  %mover
                    %mi J
                    %mo{:stretchy => "false"} →
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mn 0
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ⇔
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi{:mathvariant => "normal"} d
                  %mi J
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  div \vec J \;=\; 0
                  \\;\;\;\;\;\;
                  \\Leftrightarrow
                  \\;\;\;\;\;\;
                  \\mathrm{d} J \;=\; 0
                  \\,.
          %p
            We write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            for the
            %a.existingWikiWord{:href => "/nlab/show/vector+potential"} vector potential
            1-form on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            which encodes the
            %a.existingWikiWord{:href => "/nlab/show/background+field"} background
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/electromagnetic+field"} electromagnetic field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mspace{:width => "thinmathspace"}
                  %mo =
                  %mspace{:width => "thinmathspace"}
                  %mi{:mathvariant => "normal"} d
                  %mi A
                %annotation{:encoding => "application/x-tex"} F \,=\, \mathrm{d}A
            for its
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/field+strength"} field strength
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Faraday+tensor"} Faraday tensor
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/background+field"} background field
            %a.existingWikiWord{:href => "/nlab/show/Maxwell-Chern-Simons+theory"} Maxwell
            %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mi YM
                    %mspace{:width => "thinmathspace"}
                    %mo ≔
                    %mspace{:width => "thinmathspace"}
                    %mi F
                    %mo ∧
                    %mo ⋆
                    %mi F
                  %annotation{:encoding => "application/x-tex"} L_{YM} \,\coloneqq\, F \wedge \star F
          %p But we do (need to) consider the interaction term between the electromagnetic field and the electric current density, which is
          #eq:ElectricInteractionTerm.maruku-equation
            %span.maruku-eq-number (16)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mi int
                  %mspace{:width => "thinmathspace"}
                  %mo ≔
                  %mspace{:width => "thinmathspace"}
                  %mi A
                  %mo ∧
                  %mi J
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  L_{int} \,\coloneqq\, A \wedge J
                  \\,.
          %p
            Here we assume that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is globally defined, in fact we shall assume that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            has vanishing
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+cohomology"} de Rham cohomology
            in degree=2,
          #eq:AssumingdeRham2CohomologyVanishes.maruku-equation
            %span.maruku-eq-number (17)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi H
                    %mi dR
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  H^2_{dR}(\Sigma) \;=\; 0
                  \\,.
          %p
            This means we are focused on the local nature of fields, not on their global properties, as (for better or worse) usual for
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
          %p
            %br/
          %h4#the_ansatz The Ansatz
          %p
            %strong The auxiliary gauge potential.
            With the assumption
            %a.maruku-eqref{:href => "#eq:AssumingdeRham2CohomologyVanishes"} (17)
            also the conserved current density
            %a.maruku-eqref{:href => "#eq:CurrentConservationLaw"} (15)
            admits a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/coboundary"} coboundary
            %a.existingWikiWord{:href => "/nlab/show/differential+1-form"} differential 1-form
            to be denoted
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
          #eq:AuxiliaryGaugePotential.maruku-equation
            %span.maruku-eq-number (18)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                  %mspace{:width => "thinmathspace"}
                  %mo =
                  %mspace{:width => "thinmathspace"}
                  %mi{:mathvariant => "normal"} d
                  %mi a
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  J \,=\, \mathrm{d}a
                  \\,.
          %p
            The central Ansatz of the approach is to
            = succeed "." do
              %em think of this 1-form as an effective dynamical gauge field for the FQH dynamics
          %p
            %br/
          %p
            %strong The Lagrangian density.
            This in turn suggests that the effective
            %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
            should be the sum of
          %ol
            %li
              %p
                the interaction term
                %a.maruku-eqref{:href => "#eq:ElectricInteractionTerm"} (16)
                already mentioned, which thus specializes to
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mi int
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mi A
                      %mo ∧
                      %mi J
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mi A
                      %mo ∧
                      %mi{:mathvariant => "normal"} d
                      %mi a
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      L_{int} \;=\; A \wedge J \;=\; A \wedge \mathrm{d}a
                      \\,,
            %li
              %p
                a further interaction term for
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                      %annotation{:encoding => "application/x-tex"} a
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi j
                      %annotation{:encoding => "application/x-tex"} j
                %a.existingWikiWord{:href => "/nlab/show/quasi-particles"} quasi-particles
                (or quasi-holes)
              #eq:QuasiParticleCoupling.maruku-equation
                %span.maruku-eq-number (19)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mi quas
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mi a
                      %mo ∧
                      %mi j
                    %annotation{:encoding => "application/x-tex"}
                      L_{quas} \;=\; a \wedge j
            %li
              %p
                a kinetic term for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                    %annotation{:encoding => "application/x-tex"} a
                itself, where the only sensible choice is the
                %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons form
                at
                %a.existingWikiWord{:href => "/nlab/show/level+%28Chern-Simons+theory%29"} level
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo =
                      %mi K
                      %mo{:stretchy => "false"} /
                      %mn 2
                      %mo ∈
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} k = K/2 \in \mathbb{Z}/2
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mi CS
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mi K
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mn 1
                          %mn 2
                      %mi a
                      %mo ∧
                      %mi{:mathvariant => "normal"} d
                      %mi a
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      L_{CS} \;=\; K \tfrac{1}{2} a \wedge \mathrm{d}a
                      \\,.
          %p
            In total, the traditional Ansatz for the effective Lagrangian density for “single layer” FQH systems at filling fraction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mo{:stretchy => "false"} /
                  %mi K
                %annotation{:encoding => "application/x-tex"} 1/K
            is hence:
          #eq:TheEffectiveLagrangianDensity.maruku-equation
            %span.maruku-eq-number (20)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mspace{:width => "thinmathspace"}
                  %mo ≔
                  %mspace{:width => "thinmathspace"}
                  %mi K
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mn 2
                  %mspace{:width => "thinmathspace"}
                  %mi a
                  %mo ∧
                  %mi{:mathvariant => "normal"} d
                  %mi a
                  %mspace{:width => "thinmathspace"}
                  %mo −
                  %mspace{:width => "thinmathspace"}
                  %mi A
                  %mo ∧
                  %munder
                    %munder
                      %mrow
                        %mi{:mathvariant => "normal"} d
                        %mi a
                      %mo ⏟
                    %mi J
                  %mspace{:width => "thinmathspace"}
                  %mo −
                  %mspace{:width => "thinmathspace"}
                  %mi a
                  %mo ∧
                  %mi j
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  L
                  \\,\coloneqq\,
                  K \tfrac{1}{2}\, a\wedge \mathrm{d}a
                  \\,-\,
                  A \wedge
                  \\underset{J}{
                  \\underbrace{
                  \\mathrm{d}a
                  }
                  }
                  \\,-\,
                  a \wedge j
                  \\,.
          %p
            \&amp;lbrack;
            %a{:href => "#Wen95"}> Wen 1995 (2.11)
            , reviewed in
            = succeed "&rbrack;" do
              %a{:href => "#Wen07"} Wen 2007 (7.3.10)
          %p
            %br/
          %p
            %strong The equation of motion.
            The
            %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+equation"} Euler-Lagrange equation
            %a.existingWikiWord{:href => "/nlab/show/equation+of+motion"} of motion
            for the effective gauge field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            induced by
            %a.maruku-eqref{:href => "#eq:TheEffectiveLagrangianDensity"} (20)
            is simply
          #eq:EquationOfMotion.maruku-equation
            %span.maruku-eq-number (21)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi δ
                      %mi L
                    %mrow
                      %mi δ
                      %mi A
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mn 0
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ⇔
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi J
                  %mspace{:width => "thinmathspace"}
                  %mo =
                  %mspace{:width => "thinmathspace"}
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mi k
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                  %mi F
                  %mo +
                  %mi j
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\frac{\delta L}{\delta A}
                  \\;=\;
                  0
                  \\;\;\;\;\;\;\;\;\;\;
                  \\Leftrightarrow
                  \\;\;\;\;\;\;\;\;\;\;
                  J
                  \\,=\,
                  \\tfrac{1}{k}\Big(
                  F + j
                  \\Big)
                  \\,.
          %blockquote
            %p
              (This means in particular that if, on topologically non-trivial
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              to
              %a.existingWikiWord{:href => "/nlab/show/Dirac+charge+quantization"} Dirac charge quantization
              (as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is), then the ordinary electromagnetic field would have to be assumed to carry magnetic charge being a multiple of
              = succeed ".)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
          %p
            %br/
          %h4#reproducing_fqh_phenomena Reproducing FQH phenomena
          %p
            %strong Recovering the Hall conductivity.
            The first plausibility check on the effective model is to observe that its equation of motion
            %a.maruku-eqref{:href => "#eq:EquationOfMotion"} (21)
            implies the correct Hall conductivity relation for a
            %a.existingWikiWord{:href => "/nlab/show/fractional+quantum+Hall+system"} fractional quantum Hall system
            at filling fraction
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mi k
                  %annotation{:encoding => "application/x-tex"} 1/k
          %p
            Namely assuming that the electric field is oriented in the
            = succeed "-direction," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
            %a.existingWikiWord{:href => "/nlab/show/Faraday+tensor"} Faraday tensor
            is of the form (cf
            = succeed "):" do
              %a{:href => "Maxwell's+equations#InTermsOfFaradayTensor"} there
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi E
                    %mi y
                  %mi{:mathvariant => "normal"} d
                  %mi t
                  %mo ∧
                  %mi{:mathvariant => "normal"} d
                  %mi y
                  %mo +
                  %mi B
                  %mi{:mathvariant => "normal"} d
                  %mi x
                  %mo ∧
                  %mi{:mathvariant => "normal"} d
                  %mi y
                %annotation{:encoding => "application/x-tex"}
                  F
                  \\;=\;
                  E_y \mathrm{d}t \wedge \mathrm{d}y
                  +
                  B \mathrm{d}x\wedge \mathrm{d}y
          %p and assuming that the quasi-particles are stationary, so that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                  %mspace{:width => "thickmathspace"}
                  %mo ∝
                  %mspace{:width => "thickmathspace"}
                  %mi dvol
                  %mo{:stretchy => "false"} (
                  %msub
                    %mo ∂
                    %mn 0
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ∝
                  %mspace{:width => "thickmathspace"}
                  %mi{:mathvariant => "normal"} d
                  %mi x
                  %mo ∧
                  %mi{:mathvariant => "normal"} d
                  %mi y
                  %mpadded{:width => "0"}
                    %mrow
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                %annotation{:encoding => "application/x-tex"}
                  j
                  \\;\propto\;
                  dvol(\partial_0)
                  \\;\propto\;
                  \\mathrm{d}x \wedge \mathrm{d}y
                  \\mathrlap{\,,}
          %p
            the temporal component of the equation of motion
            %a.maruku-eqref{:href => "#eq:EquationOfMotion"} (21)
            becomes
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi J
                    %mi x
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mi k
                  %msub
                    %mi E
                    %mi y
                %annotation{:encoding => "application/x-tex"}
                  J_x \;=\; \tfrac{1}{k} E_y
          %p
            which is the correct form of the
            %em Hall field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mi y
                %annotation{:encoding => "application/x-tex"} E_y
            for given longitudinal current
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi J
                    %mi X
                %annotation{:encoding => "application/x-tex"} J_X
            at filling fraction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ν
                  %mo =
                  %mn 1
                  %mo{:stretchy => "false"} /
                  %mi k
                %annotation{:encoding => "application/x-tex"} \nu = 1/k
            – see
            = succeed "." do
              %a{:href => "quantum+Hall+effect#eq:HeightOfFractionalHallPlateaux"} there
          %blockquote
            %p
              (Following
              = succeed "," do
                %a{:href => "#Zee95"} Zee 1995 (4.5)
              = succeed "," do
                %a{:href => "#Witten16"} Witten 2016 §2.3
              = succeed "&rbrack;" do
                %a{:href => "#Tong16"} Tong 2016 p 161
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "\u201D" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                    %annotation{:encoding => "application/x-tex"} J
              = succeed "\u201D" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
          %p
            %br/
          %p
            %strong Recovering the fractional quasi-particles.
            Second, the spatial component of the equation of motion
            %a.maruku-eqref{:href => "#eq:EquationOfMotion"} (21)
            says that (1.) the magnetic flux quanta and (2.) the quasi-particles contribute their
            = succeed "th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi J
                    %mn 0
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mi K
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo +
                  %msub
                    %mi j
                    %mn 0
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  J_0 \;=\; \tfrac{1}{K}(B + j_0)
                  \\,.
          %p Here
          %ul
            %li
              %p
                statement (1) reflects exactly the composite fermion model, where at
                = succeed "th" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
                quanta of magnetic flux
            %li
              %p
                statement (2) is the desired property of quasi-particles to have
                = succeed "th" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
          %p
            %br/
          %p
            This largely concludes the traditional justification for the effective abelian Chern-Simons theory
            = succeed "." do
              %a.maruku-eqref{:href => "#eq:TheEffectiveLagrangianDensity"} (20)
          %p
            %br/
          %h4#HierarchicalKMatrixFormalism Hierarchical K-matrix formalism
          %p
            Following the hierarchical picture of
            %a.existingWikiWord{:href => "/nlab/show/FQH+systems"} FQH systems
            at non-unit filling fraction (due to
            %a{:href => "quantum+Hall+effect#Haldane83"} Haldane 1983
            and
            = succeed "," do
              %a{:href => "quantum+Hall+effect#Halperin1984"} Halperin 1984
            %a.existingWikiWord{:href => "/nlab/show/quasiparticles"} quasiparticles
            at unit filling fractions are imagined to support themselves a secondary FQH effect with secondary quasi-particles, and so on (a picture that faces various experimental challenges, cf.
            = succeed "," do
              %a{:href => "quantum+Hall+effect#Jain07"} Jain 2007 §12.1
            %a{:href => "quantum+Hall+effect#Jain14"} Jain 2014, esp. p 8
            and Rem.
            %a.maruku-ref{:href => "#PhenomenologyOfKMatrixFormalism"}
            below), authors consider abelian Chern Simons theory of multiple gauge fields that are hierarchically coupled to each other, called the “K-matrix formalism” (
            %a{:href => "#BlokWen90"}> Blok &amp; Wen 1990
            ,
            = succeed "," do
              %a{:href => "#WenZee92Classification"} Wen &amp; Zee 1992
            = succeed "," do
              %a{:href => "#Wen95"} Wen 1995 §2.1
            = succeed ")." do
              %a{:href => "#Wen07"} Wen 2007 §7.3.3
          %p
            The basic idea is to observe that the above step from (i) introducing a gauge potential
            %a.maruku-eqref{:href => "#eq:AuxiliaryGaugePotential"} (18)
            for the electron current density
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                %annotation{:encoding => "application/x-tex"} J
            to (ii) the effective Chern-Simons action
            %a.maruku-eqref{:href => "#eq:TheEffectiveLagrangianDensity"} (20)
            with quasi-particle current density
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                %annotation{:encoding => "application/x-tex"} j
            may be repeated by next introducing also a gauge potential for the quasi-particle current (cf.
            = succeed ")," do
              %a{:href => "#Wen07"} Wen 2007 (7.3.13)
          %p
            Concretely, postulating that the quasi-particle current
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                %annotation{:encoding => "application/x-tex"} j
            %a.maruku-eqref{:href => "#eq:QuasiParticleCoupling"} (19)
            is itself the field strength of a secondary auxiliary gauge field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi a
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} a^{(2)}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                  %mspace{:width => "thinmathspace"}
                  %mo =
                  %mspace{:width => "thinmathspace"}
                  %mi{:mathvariant => "normal"} d
                  %msup
                    %mi a
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  j \,=\, \mathrm{d} a^{(2)}
          %p
            (and renaming the previous auxiliary gauge field to
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi a
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo ≡
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a^{(1)} \equiv a
          %p
            and then adjoining for that secondary gauge field another Chern-Simons kinetic term, turns the effective Lagrangian density
            %a.maruku-eqref{:href => "#eq:TheEffectiveLagrangianDensity"} (20)
            into
          #eq:TheSecondaryEffectiveLagrangianDensity.maruku-equation
            %span.maruku-eq-number (22)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mrow
                      %mn 1
                      %mo ,
                      %mn 2
                  %mspace{:width => "thinmathspace"}
                  %mo ≔
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi K
                    %mn 1
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mn 2
                  %mspace{:width => "thinmathspace"}
                  %msup
                    %mi a
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo ∧
                  %mi{:mathvariant => "normal"} d
                  %msup
                    %mi a
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo −
                  %mspace{:width => "thinmathspace"}
                  %mi A
                  %mo ∧
                  %munder
                    %munder
                      %mrow
                        %mi{:mathvariant => "normal"} d
                        %msup
                          %mi a
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                      %mo ⏟
                    %mi J
                  %mspace{:width => "thinmathspace"}
                  %mo −
                  %mspace{:width => "thinmathspace"}
                  %msup
                    %mi a
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo ∧
                  %munder
                    %munder
                      %mrow
                        %mi{:mathvariant => "normal"} d
                        %msup
                          %mi a
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mn 2
                            %mo{:stretchy => "false"} )
                      %mo ⏟
                    %mi j
                  %mspace{:width => "thinmathspace"}
                  %mo +
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi K
                    %mn 2
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mn 2
                  %mspace{:width => "thinmathspace"}
                  %msup
                    %mi a
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                  %mo ∧
                  %mi{:mathvariant => "normal"} d
                  %msup
                    %mi a
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  L_{1,2}
                  \\,\coloneqq\,
                  K_1 \tfrac{1}{2}\, a^{(1)} \wedge \mathrm{d} a^{(1)}
                  \\,-\,
                  A \wedge
                  \\underset{J}{
                  \\underbrace{
                  \\mathrm{d} a^{(1)}
                  }
                  }
                  \\,-\,
                  a^{(1)}
                  \\wedge
                  \\underset{j}{
                  \\underbrace{
                  \\mathrm{d} a^{(2)}
                  }
                  }
                  \\,+\,
                  K_2 \tfrac{1}{2}\,
                  a^{(2)} \wedge \mathrm{d} a^{(2)}
                  \\,.
          %p
            (cf.
            = succeed "," do
              %a{:href => "#Wen95"} Wen 1995 (2.15)
            = succeed ")" do
              %a{:href => "#Wen07"} Wen 2007 (7.3.13)
          %p meant to be an effective theory at filling fraction
          #eq:SecondHierarchyFillingFraction.maruku-equation
            %span.maruku-eq-number (23)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ν
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mrow
                        %msub
                          %mi K
                          %mn 1
                        %mo −
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mn 1
                            %mrow
                              %msub
                                %mi K
                                %mn 2
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\nu
                  \\;=\;
                  \\tfrac
                  { 1 }
                  { K_1 - \tfrac{1}{K_2} }
                  \\,.
          %p
            (cf.
            = succeed "," do
              %a{:href => "#Wen95"} Wen 1995 (2.18)
            = succeed ")" do
              %a{:href => "#Wen07"} Wen 2007 (7.3.15)
          %p
            Now this secondary effective Lagrangian
            %a.maruku-eqref{:href => "#eq:TheSecondaryEffectiveLagrangianDensity"} (22)
            may be rewritten equivalently as (using
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Einstein+summation+convention"} Einstein summation convention
          #eq:SecondaryEffectiveLagrangianInKMatrixForm.maruku-equation
            %span.maruku-eq-number (24)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mrow
                      %mn 1
                      %mo ,
                      %mn 2
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi K
                    %mrow
                      %mi i
                      %mi j
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mn 2
                  %msup
                    %mi a
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo{:stretchy => "false"} )
                  %mo ∧
                  %mi{:mathvariant => "normal"} d
                  %msup
                    %mi a
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi j
                      %mo{:stretchy => "false"} )
                  %mo −
                  %msub
                    %mi Q
                    %mi i
                  %mspace{:width => "thinmathspace"}
                  %mi A
                  %mo ∧
                  %mi{:mathvariant => "normal"} d
                  %msup
                    %mi a
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  L_{1,2}
                  \\;=\;
                  K_{i j} \tfrac{1}{2} a^{(i)} \wedge \mathrm{d} a^{(j)}
                  \-
                  Q_i \, A \wedge \mathrm{d} a^{(i)}
          %p
            with the
            %em
              K-
              %a.existingWikiWord{:href => "/nlab/show/matrix"} matrix
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mrow
                    %mo [
                    %mrow
                      %mtable{:displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %msub
                              %mi K
                              %mn 1
                          %mtd
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mtr
                          %mtd
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                          %mtd
                            %msub
                              %mi K
                              %mn 2
                    %mo ]
                %annotation{:encoding => "application/x-tex"}
                  K
                  \\;\coloneqq\;
                  \\left[
                  \\begin{matrix}
                  K_1 &amp; -1
                  \\\
                  \-1 &amp; K_2
                  \\end{matrix}
                  \\right]
          %p
            and the
            %em charge vector
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mrow
                    %mo [
                    %mrow
                      %mtable{:displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mn 1
                        %mtr
                          %mtd
                            %mn 0
                    %mo ]
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Q
                  \\;\coloneqq\;
                  \\left[
                  \\begin{matrix}
                  1
                  \\\
                  0
                  \\end{matrix}
                  \\right]
                  \\,.
          %p
            (cf.
            = succeed "," do
              %a{:href => "#Wen95"} Wen 1995 (2.19)
            = succeed ")." do
              %a{:href => "#Wen07"} Wen 2007 (7.3.15)
          %p
            Observing that the
            %a.existingWikiWord{:href => "/nlab/show/inverse+matrix"} inverse
            K-matrix is
          #eq:InverseKMatrixAtSecondLayer.maruku-equation
            %span.maruku-eq-number (25)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi K
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mspace{:width => "thinmathspace"}
                  %mo =
                  %mspace{:width => "thinmathspace"}
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mrow
                        %msub
                          %mi K
                          %mn 1
                        %msub
                          %mi K
                          %mn 2
                        %mo −
                        %mn 1
                  %mrow
                    %mo [
                    %mrow
                      %mtable{:displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %msub
                              %mi K
                              %mn 2
                          %mtd
                            %mn 1
                        %mtr
                          %mtd
                            %mn 1
                          %mtd
                            %msub
                              %mi K
                              %mn 1
                    %mo ]
                %annotation{:encoding => "application/x-tex"}
                  K^{-1}
                  \\,=\,
                  \\tfrac{1}{K_1 K_2 - 1}
                  \\left[
                  \\begin{matrix}
                  K_2 &amp; 1
                  \\\
                  1 &amp; K_1
                  \\end{matrix}
                  \\right]
          %p
            the second-layer filling fraction
            %a.maruku-eqref{:href => "#eq:SecondHierarchyFillingFraction"} (23)
            is recognized as the top left entry of
            %a.maruku-eqref{:href => "#eq:InverseKMatrixAtSecondLayer"} (25)
            and hence re-expressed in terms of these matrix quantities as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ν
                  %mspace{:width => "thinmathspace"}
                  %mo =
                  %mspace{:width => "thinmathspace"}
                  %msup
                    %mi Q
                    %mi t
                  %mo ⋅
                  %msup
                    %mi K
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo ⋅
                  %mi Q
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\nu \,=\, Q^t \cdot K^{-1} \cdot Q
                  \\,.
          %p
            (cf.
            = succeed ")" do
              %a{:href => "#Wen07"} Wen 2007 (7.3.19)
          %p
          #PhenomenologyOfKMatrixFormalism.num_remark
