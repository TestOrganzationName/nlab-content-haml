            — if for
            %em
              %a.existingWikiWord{:href => "/nlab/show/closed+manifold"} closed
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
