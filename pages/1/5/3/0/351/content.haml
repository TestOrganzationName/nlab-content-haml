              = succeed ")" do
                %a{:href => "https://doi.org/10.1007/BFb0060443"} 10.1007/BFb0060443
          %ul#PareRoman
            %li
              %a.existingWikiWord{:href => "/nlab/show/Robert+Par%C3%A9"} Robert Paré
              and Leopoldo Román,
              %em Dinatural numbers
              (1998),
              %a{:href => "http://www.sciencedirect.com/science/article/pii/S0022404997000364"} JPAA
          %ul
            %li
              Guy McCusker, Alessio Santamaria,
              = succeed "," do
                %em A Calculus of Substitution for Dinatural Transformations, I
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/2007.07576"} arXiv:2007.07576
          %p Here is a blog post inspired by the above discussion that discusses these concepts in the context of the programming language Haskell:
          %ul
