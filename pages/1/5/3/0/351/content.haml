                %use{:x => "353.506194", "xlink:href" => "#t23ydE6ZhzRt2aIFed_rNfbATIU=-glyph5-2", :y => "126.011539"}
          %h3#special_cases Special cases
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            both factor through the projection
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi op
                    %mo ×
                    %mi C
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C^{op}\times C \to C
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi op
                  %annotation{:encoding => "application/x-tex"} C^{op}
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            factors through
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            while
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            factors through
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi op
                  %annotation{:encoding => "application/x-tex"} C^{op}
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is constant, the hexagon identity reduces to the “domain” version of extranaturality, involving a commutative square of the form
          #eq:domain.maruku-equation
            %span.maruku-eq-number (2)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi α
                    %mi c
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi α
                    %mrow
                      %mi c
                      %mo ′
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ′
                  %mo ,
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ′
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi G
                %annotation{:encoding => "application/x-tex"} \alpha_c F(f, c) = \alpha_{c'} F(c', f): F(c', c) \to G
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is constant with respect to the argument
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            is constant, it yields the “codomain” version with a commutative square of the form
          #eq:codomain.maruku-equation
            %span.maruku-eq-number (3)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mi f
                  %mo{:stretchy => "false"} )
                  %msub
                    %mi α
                    %mi c
                  %mo =
                  %mi G
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mi c
                  %mo ′
                  %mo{:stretchy => "false"} )
                  %msub
                    %mi α
                    %mrow
                      %mi c
                      %mo ′
                  %mo :
                  %mi F
                  %mo →
                  %mi G
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mi c
                  %mo ′
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G(c, f) \alpha_c = G(f, c')\alpha_{c'}: F \to G(c, c')
          %p
            when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            is constant with respect to the argument
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
          %h2#examples Examples
          %p
            Of course, all ordinary natural transformations, and also all
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/extranatural+transformations"} extranatural transformations
          %ul
            %li
              %p
                Perhaps the most well known example is the
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Church+numerals"} Church numerals
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi hom
                      %mo :
                      %msup
                        %mi C
                        %mi op
                      %mo ×
                      %mi C
                      %mo →
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} hom: C^{op}\times C\to Set
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi hom
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi α
                            %mi n
                      %mi hom
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \hom(x, x) \stackrel{\alpha_n}{\to} \hom(x, x)
              %p
                defined by the rule
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi α
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mo =
                        %msup
                          %mi f
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \alpha_n(f) = f^{(n)}
            %li
              %p
                Not every endo-dinatural-transformation of a hom-functor is of this form; several other examples are given in
                = succeed "." do
                  %a{:href => "#PareRoman"} Pare-Roman
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo =
                      %mi FinSet
                    %annotation{:encoding => "application/x-tex"} C=FinSet
                then the operation sending each endomorphism to its
                %a.existingWikiWord{:href => "/nlab/show/eventual+image"} eventual image
                is dinatural.
            %li
              %p
                The following example of a dinatural transformation from a covariant functor to a contravariant one is found in
                %a{:href => "#DubucStreet"} Dubuc-Street
                and attributed to
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Mac+Lane"} Mac Lane
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                be the category of
                %a.existingWikiWord{:href => "/nlab/show/inner+product+spaces"} inner product spaces
                and isometries, and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
                the category of
                %a.existingWikiWord{:href => "/nlab/show/vector+spaces"} vector spaces
                and linear transformations (all over a fixed
                = succeed ")." do
                  %a.existingWikiWord{:href => "/nlab/show/field"} field
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo :
                      %mi C
                      %mo →
                      %mi D
                    %annotation{:encoding => "application/x-tex"} F:C\to D
                be the forgetful functor and let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo :
                      %msup
                        %mi C
                        %mi op
                      %mo →
                      %mi D
                    %annotation{:encoding => "application/x-tex"} G:C^{op}\to D
                be the functor sending each inner product space to its dual. Define
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi α
                        %mi V
                      %mo :
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi G
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \alpha_V : F(V) \to G(V)
                to send
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                      %mo ∈
                      %mi V
                    %annotation{:encoding => "application/x-tex"} v\in V
                to the operation
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} ⟨
                        %mi v
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} ⟩
                      %annotation{:encoding => "application/x-tex"} \langle v,-\rangle
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                    %annotation{:encoding => "application/x-tex"} \alpha
                is dinatural.
          %p
            By a yoneda-like argument, dinatural transformations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo :
                  %mi F
                  %mover
                    %mo →
                    %mo •
                  %mi G
                %annotation{:encoding => "application/x-tex"} \alpha : F \xrightarrow{\bullet} G
            are in bijection with natural transformations
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mrow
                        %mi x
                        %mo ,
                        %mi y
                    %mo :
                    %mi hom
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi hom
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \eta_{x,y} : \hom(x, y) \to \hom(F(y,x), G(x,y))
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi η
                        %mrow
                          %mi x
                          %mo ,
                          %mi y
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi G
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi f
                      %mo{:stretchy => "false"} )
                      %msub
                        %mi α
                        %mi x
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi G
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
