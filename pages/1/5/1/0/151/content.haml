                  %a{:href => "https://doi.org/10.1017/CBO9780511525858"} doi:10.1017/CBO9780511525858
            %li#LawvereRosebrugh
              %p
                %a.existingWikiWord{:href => "/nlab/show/William+Lawvere"}> William Lawvere
                ,
