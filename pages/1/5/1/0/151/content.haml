                = succeed "&rbrack;" do
                  %a{:href => "https://link.springer.com/content/pdf/10.1007/978-94-009-8462-2_6.pdf"} pdf
            %li#PorstTholen91
              %p
                %a.existingWikiWord{:href => "/nlab/show/Hans-E.+Porst"}> Hans-E. Porst
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Walter+Tholen"} Walter Tholen
                %em Concrete Dualities
                in H. Herrlich,
                %a.existingWikiWord{:href => "/nlab/show/Hans-E.+Porst"} Hans-E. Porst
                (eds.)
                = succeed "," do
                  %em Category Theory at Work
                = succeed ")" do
                  %a{:href => "http://www.heldermann.de/R&E/RAE18/ctw07.pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Saunders+MacLane"}> Saunders MacLane
                , §II.1 of:
                = succeed "," do
                  %em
