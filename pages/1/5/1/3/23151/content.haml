                    %mstyle{:displaystyle => "false"}
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi s
                      %mo ∈
                      %mi S
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"}
                  PSh_{\sqcup}(\mathcal{C})
                  \\;\;
                  \\simeq
                  \\;\;
                  \\underset
                  { S \,\in\, Set }
                  { \textstyle{\int} }
                  \\;
                  \\underset{s \in S}{\textstyle{\prod}}
                  \\mathcal{C}
          %p
