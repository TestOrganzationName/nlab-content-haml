                    \\big)
                    \\;\;
                    \\simeq
                    \\;\;
                    Grpd_{skl}
                    \\,.
            %p
          %p
          #GActionsAndGOrbits.num_remark
            %h6 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/G-set"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                  \-sets
                are the
                %a.existingWikiWord{:href => "/nlab/show/free+coproduct+completion"} free coproduct completion
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/orbit+category"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
                    \-orbits
              %br/
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mi Grp
                    %mo{:stretchy => "false"} (
                    %mi Set
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G \,\in\, Grp(Set)
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete group
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/G-set"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                          %mi Set
                        %annotation{:encoding => "application/x-tex"} G Set
                  for its category of
                  %a.existingWikiWord{:href => "/nlab/show/group+actions"} group actions
                  on
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/sets"} sets
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                        %mi Orbt
                        %mover
                          %mo ↪
                          %mspace{:width => "thickmathspace"}
                        %mi G
                        %mi Set
                      %annotation{:encoding => "application/x-tex"} G Orbt \xhookrightarrow{\;} G Set
                  for its
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/orbit+category"} orbit category
                  %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
                  on the
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/transitive+actions"} transitive actions
                  %a.existingWikiWord{:href => "/nlab/show/coset+space"} sets of cosets
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                          %mo{:stretchy => "false"} /
                          %mi H
                        %annotation{:encoding => "application/x-tex"} G/H
                  %a.existingWikiWord{:href => "/nlab/show/subgroups"} subgroups
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi H
                          %mo ⊂
                          %mi G
                        %annotation{:encoding => "application/x-tex"} H \subset G
            %p
              Since every
              %a.existingWikiWord{:href => "/nlab/show/G-set"} G-set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              decomposes as a
              %a.existingWikiWord{:href => "/nlab/show/disjoint+union"} disjoint union
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/transitive+actions"} transitive actions
              %a.existingWikiWord{:href => "/nlab/show/orbits"} orbits
              of
              %a.existingWikiWord{:href => "/nlab/show/elements"} elements
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} G Set
              as the
              %a.existingWikiWord{:href => "/nlab/show/free+coproduct+completion"} free coproduct completion
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/orbit+category"} G Orbt
          %h3#coproduct_compeletion_of_extensive_categories Coproduct compeletion of extensive categories
          %p
