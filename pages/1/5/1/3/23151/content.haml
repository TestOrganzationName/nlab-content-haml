          %h2#properties Properties
          %p
            Fairly immediate from the explicit definition
            %a{:href => "#ViaIndexedSetsOfObjects"} above
            is:
          %p
          #CategoriesOfCoproductsOfConnectedObjects.num_prop
            %h6 Proposition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℬ
                  %annotation{:encoding => "application/x-tex"} \mathcal{B}
              with small-indexed
              %a.existingWikiWord{:href => "/nlab/show/coproducts"} coproducts
              is
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
              to a
              %a.existingWikiWord{:href => "/nlab/show/free+coproduct+completion"} free coproduct completion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi PSh
                      %mo ⊔
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PSh_{\sqcup}(\mathcal{C})
              for a
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              if
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                        %mover
                          %mo ↪
                          %mspace{:width => "thickmathspace"}
                        %mi ℬ
                      %annotation{:encoding => "application/x-tex"} \mathcal{C} \xhookrightarrow{\;} \mathcal{B}
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
                  of
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/connected+objects"} connected objects
                %p
                  i.e.
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mspace{:width => "thinmathspace"}
                        %mo ∈
                        %mspace{:width => "thinmathspace"}
                        %mi 𝒞
                        %mo ↪
                        %mi ℬ
                      %annotation{:encoding => "application/x-tex"} X \,\in\, \mathcal{C} \hookrightarrow \mathcal{B}
                  means that the
                  %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℬ
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thinmathspace"}
                        %mi ℬ
                        %mo →
                        %mi Set
                      %annotation{:encoding => "application/x-tex"} \mathcal{B}(X,-) \,\colon\, \mathcal{B} \to Set
                  %a.existingWikiWord{:href => "/nlab/show/preserved+colimit"} preserves
                  %a.existingWikiWord{:href => "/nlab/show/coproducts"} coproducts
                %p
                  (which when
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  is
                  %a.existingWikiWord{:href => "/nlab/show/extensive+category"} extensive
                  means equivalently that if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  is a coproduct, then one of the summands is
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial
                  = succeed ");" do
                    %a{:href => "InExtensiveCategoryCOnnectedObjectsArePrimitiveUnderCoproduct"} this Prop.
              %li
                %p
                  each object of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℬ
                      %annotation{:encoding => "application/x-tex"} \mathcal{B}
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
                  of objects in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                          %mo ↪
                          %mi ℬ
                        %annotation{:encoding => "application/x-tex"} \mathcal{C} \hookrightarrow \mathcal{B}
            %p
          (
          %a{:href => "#CarboniVitale98"}> Carboni &amp; Vitale 1998, Lem. 42
          )
          .proof
            %h6 Proof
            %p
              Since, by assumption, the objects of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℬ
                  %annotation{:encoding => "application/x-tex"} \mathcal{B}
              are already presented by
              %a.existingWikiWord{:href => "/nlab/show/indexed+sets"} indexed sets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi X
                      %mi s
                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mrow
                        %mi s
                        %mo ∈
                        %mi S
                  %annotation{:encoding => "application/x-tex"} \big(X_s\big)_{s \in S}
              of objects in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
