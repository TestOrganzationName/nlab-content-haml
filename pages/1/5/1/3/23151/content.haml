                                %mo ⟶
                                %mi ϕ
                            %mtd
                              %munder
                                %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                                %mrow
                                  %mi t
                                  %mo ∈
                                  %mi T
                              %msub
                                %mi Y
                                %mi t
                          %mtr
                            %mtd
                              %mo{:maxsize => "1.8em", :minsize => "1.8em"} ↓
                            %mtd
                            %mtd
                              %mo{:maxsize => "1.8em", :minsize => "1.8em"} ↓
                          %mtr
                            %mtd
                              %mi S
                            %mtd
                              %munder
                                %mo ⟶
                                %mi f
                            %mtd
                              %mi T
                              %mspace{:width => "thinmathspace"}
                              %mo ,
                      %mo }
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{X}\;\text{extensive}
                    \\;\;\;\;\;\;\;\;\;\;
                    \\vdash
                    \\;\;\;\;\;\;\;\;\;\;
                    PSh_{\sqcup}(\mathcal{C})
                    \\;\;
                    \\simeq
                    \\;\;
                    \\mathcal{C}_{Set}
                    \\;\;
                    \=
                    \\;\;
                    \\left\{
                    \\array{
                    \\underset{s \in S}{\coprod} X_s
                    \&amp;\overset{\phi}{\longrightarrow}&amp;
                    \\underset{t \in T}{\coprod} Y_t
                    \\\
                    \\Big\downarrow
                    \&amp;&amp;
                    \\Big\downarrow
                    \\\
                    S &amp;\underset{f}{\longrightarrow}&amp; T
                    \\,,
                    }
                    \\right\}
            %p
              where on the right we are indicating a generic
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              of such
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/bundles"} bundles
            %p
              Namely, since every
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              is the
              %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
              of
              %a.existingWikiWord{:href => "/nlab/show/singleton+sets"} singleton sets
              indexed by its
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/elements"} elements
              %a.existingWikiWord{:href => "/nlab/show/extensive+category"} extensive category
              that the coproduct functors are
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalences
              between (
              %a.existingWikiWord{:href => "/nlab/show/product+category"} products
              of)
              %a.existingWikiWord{:href => "/nlab/show/slice+categories"} slice categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi ι
                        %mo{:stretchy => "false"} (
                        %mi S
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi s
                        %mo ∈
                        %mi S
                    %msub
                      %mi 𝒞
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi ι
                        %mo{:stretchy => "false"} (
                        %mi s
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}_{/ \iota(S)}
                    \\;\;
                    \\simeq
                    \\;\;
                    \\underset{s \in S}{\prod}
                    \\mathcal{C}_{/\iota(s)}
            %p it follows that:
            %ol
              %li
                %p
                  every object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi X
                          %mi S
                      %annotation{:encoding => "application/x-tex"} X_S
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝒞
                          %mrow
                            %mi ι
                            %mo{:stretchy => "false"} (
                            %mi S
                            %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}_{\iota(S)}
                  is of the form shown in
                  %a.maruku-eqref{:href => "#eq:AsACategoryOfBundles"} (2)
                  hence determined by a family
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi X
                            %mi s
                          %msub
                            %mo{:stretchy => "false"} )
                            %mrow
                              %mi s
                              %mo ∈
                              %mi S
                        %annotation{:encoding => "application/x-tex"} (X_s)_{s \in S}
              %li
                %p
                  morphisms as shown in
                  %a.maruku-eqref{:href => "#eq:AsACategoryOfBundles"} (2)
                  are equivalently (by the
                  %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
                  of the
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %munder
                                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                                  %mrow
                                    %mi s
                                    %mo ∈
                                    %mi S
                                %msub
                                  %mi X
                                  %mi s
                              %mtd
                                %mover
                                  %mo ⟶
                                  %mi ϕ
                              %mtd
                                %munder
                                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                                  %mrow
                                    %mi s
                                    %mo ∈
                                    %mi S
                                %msub
                                  %mi Y
                                  %mrow
                                    %mi f
                                    %mo{:stretchy => "false"} (
                                    %mi s
                                    %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                                %mo{:maxsize => "1.8em", :minsize => "1.8em"} ↓
                              %mtd
                              %mtd
                                %mo{:maxsize => "1.8em", :minsize => "1.8em"} ↓
                            %mtr
                              %mtd
                                %mi S
                              %mtd
                                %munder
                                  %mo ⟶
                                  %mrow
                                    %mspace{:width => "thickmathspace"}
                                    %mspace{:width => "thickmathspace"}
                                    %mspace{:width => "thickmathspace"}
                                    %msub
                                      %mi id
                                      %mi S
                                    %mspace{:width => "thickmathspace"}
                                    %mspace{:width => "thickmathspace"}
                                    %mspace{:width => "thickmathspace"}
                              %mtd
                                %mi S
                                %mspace{:width => "thinmathspace"}
                                %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        \\underset{s \in S}{\coprod}
                        X_s
                        \&amp;\overset{\phi}{\longrightarrow}&amp;
                        \\underset{s \in S}{\coprod} Y_{f(s)}
                        \\\
                        \\Big\downarrow
                        \&amp;&amp;
                        \\Big\downarrow
                        \\\
                        S &amp;\underset{\;\;\; id_S \;\;\;}{\longrightarrow}&amp; S
                        \\,,
                        }
                %p
                  (where we used
                  %a.existingWikiWord{:href => "/nlab/show/universal+colimit"} pullback stability of coproducts
                  in an extensive category, see
                  = succeed "," do
                    %a{:href => "extensive+category#DisjointAndPullbackStableCoproducts"} there
                  = succeed ")" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi f
                            %mo *
                          %msub
                            %mi Y
                            %mi S
                          %mspace{:width => "thinmathspace"}
                          %mo ≃
                          %mspace{:width => "thinmathspace"}
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                            %mrow
                              %mi s
                              %mo ∈
                              %mi S
                          %msup
                            %mi f
                            %mo *
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi Y
                            %mi S
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi s
                          %mspace{:width => "thinmathspace"}
                          %mo ≃
                          %mspace{:width => "thinmathspace"}
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                            %mrow
                              %mi s
                              %mo ∈
                              %mi S
                          %msub
                            %mi Y
                            %mrow
                              %mi f
                              %mo{:stretchy => "false"} (
                              %mi s
                              %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} f^\ast Y_S \,\simeq\, \underset{s \in S}{\coprod} f^\ast(Y_S)_s \,\simeq\, \underset{s \in S}{\coprod} Y_{f(s)}
                %p
                  which by extensitivity are equivalently
                  = succeed "-indexed" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi S
                        %annotation{:encoding => "application/x-tex"} S
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi ϕ
                            %mi s
                          %mspace{:width => "thinmathspace"}
                          %mo{:lspace => "verythinmathspace"} :
                          %mspace{:width => "thinmathspace"}
                          %msub
                            %mi X
                            %mi s
                          %mo ⟶
                          %msub
                            %mi Y
                            %mrow
                              %mi f
                              %mo{:stretchy => "false"} (
                              %mi s
                              %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \phi_s\,\colon\, X_s \longrightarrow Y_{f(s)}
            %p
              This is again manifestly the explicit description of the free coproduct completion from
              = succeed "." do
                %a{:href => "#ViaIndexedSetsOfObjects"} above
            %p
              Conversely this gives a sense that if a category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is
              %em not
              extensive, so that the notion of
              %a.existingWikiWord{:href => "/nlab/show/bundles"} bundles
              with total spaces and fibers in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              does not make sense, its free coproduct completion may be understood as the closest stand-in for that category of
              = succeed "-bundles" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/free+cocompletion"}> free cocompletion
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/idempotent+completion"} idempotent completion
                %a.existingWikiWord{:href => "/nlab/show/Cauchy+completion"} Cauchy completion
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/free+cartesian+category"} free cartesian category
          %h2#references References
          %p Early discussion of the concept:
          %ul
            %li{:id => "Bénabou1985"}
              %a.existingWikiWord{:href => "/nlab/show/Jean+B%C3%A9nabou"}> Jean Bénabou
              , §3.3 in:
              = succeed "," do
                %em Fibered Categories and the Foundations of Naive Category Theory
              %strong 50
              1 (1985) 10-37 &amp;lbrack;
              %a{:href => "http://dx.doi.org/10.2307/2273784"}> doi:10.2307/2273784
              \&amp;rbrack;
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/accessible+category"} accessibility
            of free coproduct completions:
          %ul
            %li{:id => "MakkaiParé1989"}
              %a.existingWikiWord{:href => "/nlab/show/Michael+Makkai"}> Michael Makkai
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Robert+Par%C3%A9"} Robert Paré
              = succeed "," do
                %em Accessible categories: The foundations of categorical model theory
              = succeed "," do
                %strong 104
              = succeed "&rbrack;" do
                %a{:href => "https://bookstore.ams.org/conm-104"} ISBN:978-0-8218-7692-3
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/limits"} limits
            in free coproduct completions:
          %ul
            %li#HuTholen95
              %a.existingWikiWord{:href => "/nlab/show/Hongde+Hu"}> Hongde Hu
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Walter+Tholen"} Walter Tholen
              = succeed "," do
                %em Limits in free coproduct completions
              = succeed "," do
                %a{:href => "https://doi.org/10.1016/0022-4049(94)00153-7"} doi:10.1016/0022-4049(94)00153-7
              = succeed ")" do
                %a{:href => "https://core.ac.uk/download/pdf/82604415.pdf"} pdf
          %p
            In the context of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/regular+and+exact+completions"} regular and exact completions
          %ul
            %li#CarboniVitale98
              %a.existingWikiWord{:href => "/nlab/show/Aurelio+Carboni"}> Aurelio Carboni
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Enrico+Vitale"} Enrico Vitale
              = succeed "," do
                %em Regular and exact completions
              %strong 125
              1–3 (1998) 79-116 (
              %a{:href => "https://doi.org/10.1016/S0022-4049(96)00115-6"}> doi:10.1016/S0022-4049(96)00115-6
              )
          %p
            In the general context of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/extensive+categories"} extensive categories
          %ul
            %li#CarboniLackWalters93
              %a.existingWikiWord{:href => "/nlab/show/Aurelio+Carboni"}> Aurelio Carboni
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Stephen+Lack"} Stephen Lack
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Bob+Walters"} R. F. C. Walters
              = succeed "," do
                %em Introduction to extensive and distributive categories
              %strong 84
              (1993) pp. 145-158 &amp;lbrack;
              %a{:href => "https://doi.org/10.1016/0022-4049(93)90035-R"}> doi:10.1016/0022-4049(93)90035-R
              \&amp;rbrack;
          %p
            As
            %a.existingWikiWord{:href => "/nlab/show/categorical+semantics"} categorical semantics
            for
            %a.existingWikiWord{:href => "/nlab/show/dependent+linear+type+theories"} dependent linear type theories
            (in the context of
            %a.existingWikiWord{:href => "/nlab/show/quantum+programming+languages"} quantum programming languages
            with “
            %a.existingWikiWord{:href => "/nlab/show/dynamic+lifting"}> dynamic lifting
            ”, such as proto-
            %a.existingWikiWord{:href => "/nlab/show/Quipper"}> Quipper
            ), the free coproduct completion of
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric
            %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+categories"} closed monoidal categories
            is considered in
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Francisco+Rios"}> Francisco Rios
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Peter+Selinger"} Peter Selinger
                = succeed "," do
                  %em A Categorical Model for a Quantum Circuit Description Language
                %strong 266
                (2018) 164-178 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1706.02630"}> arXiv:1706.02630
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.4204/EPTCS.266.11"} doi:10.4204/EPTCS.266.11
            %li#FuKishidaSelinger20
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peng+Fu"}> Peng Fu
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Kohei+Kishida"} Kohei Kishida
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Peter+Selinger"} Peter Selinger
                = succeed "," do
                  %em Linear Dependent Type Theory for Quantum Programming Languages
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/2004.13472"} arXiv:2004.13472
                = succeed "," do
                  %a{:href => "https://dl.acm.org/doi/10.1145/3373718.3394765"} doi:10.1145/3373718.3394765
                = succeed "," do
                  %a{:href => "https://depend.cs.uni-saarland.de/lics-icalp/papers/B5.F"} pdf
                = succeed ")" do
                  %a{:href => "https://www.youtube.com/watch?v=GUT8j4V6Nzg"} video
          %p
            and its
            = succeed "." do
              %a{:href => "Quipper#ReferencesDependentLinearTypesAndCategoricalSemantics"} followups
          %p Algebras in the free coproduct completion are considered in:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Michael+Johnson"}> Michael Johnson
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/R.+F.+C.+Walters"} R. F. C. Walters
              = succeed "," do
                %em Algebra objects and algebra families for finite limit theories
              %strong 83
              3 (1992) 283-293 &amp;lbrack;
              %a{:href => "https://doi.org/10.1016/0022-4049(92)90047-J"}> doi:10.1016/0022-4049(92)90047-J
              \&amp;rbrack;
