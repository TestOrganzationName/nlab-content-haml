                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi PSh
                      %mo ⊔
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi Grpd
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi Obj
                        %mo =
                        %mo *
                        %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
