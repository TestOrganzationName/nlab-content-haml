          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ;
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %msup
                    %mi H
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ;
                  %msub
