                  %mi A
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  H(X;A) = H^0(X;A) \coloneqq \pi_0 \mathbf{H}(X,A)
                  \\,.
          %p
            The (∞,1)-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            is usually an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            = succeed "." do
              %a{:href => "#ToposTheory"} particularly well-behaved
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/stable+%28%E2%88%9E%2C1%29-categories"} stable (∞,1)-categories
          %p
            More generally, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
