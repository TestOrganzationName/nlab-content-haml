                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a{:href => "http://ncatlab.org/schreiber/show/path+%E2%88%9E-groupoid#GeomReal"} geometric realization
              at
              = succeed "." do
                %a.existingWikiWord{:href => "/schreiber/show/path+%E2%88%9E-groupoid"} path ∞-groupoid
            %p
