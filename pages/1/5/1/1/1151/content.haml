                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %msub
                    %mi π
                    %mn 0
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} (
                  %mi X
