          %p Most of this notation can also be used for limits of spans:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi L
                          %mo =
                          %munder
                            %mi lim
                            %mfrac{:linethickness => "0"}
                              %mrow
                                %mi g
                                %mo{:stretchy => "false"} (
                                %mi γ
                                %mo{:stretchy => "false"} )
                                %mo →
                                %mi c
                              %mrow
                                %mi γ
                                %mo ∈
                                %mi C
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi γ
                          %mo{:stretchy => "false"} )
                          %mo ,
                      %mtr
                        %mtd
                          %mi L
                          %mo ∈
                          %munder
                            %mi Lim
                            %mfrac{:linethickness => "0"}
                              %mrow
                                %mi g
                                %mo{:stretchy => "false"} (
                                %mi γ
                                %mo{:stretchy => "false"} )
                                %mo →
                                %mi c
                              %mrow
                                %mi γ
                                %mo ∈
                                %mi C
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi γ
                          %mo{:stretchy => "false"} )
                          %mo ,
                      %mtr
                        %mtd
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi γ
                          %mo{:stretchy => "false"} )
                          %munder
                            %mo →
                            %mfrac{:linethickness => "0"}
                              %mrow
                                %mi g
                                %mo{:stretchy => "false"} (
                                %mi γ
                                %mo{:stretchy => "false"} )
                                %mo →
                                %mi c
                              %mrow
                                %mi γ
                                %mo ∈
                                %mi C
                          %mi L
                %annotation{:encoding => "application/x-tex"}
                  \\array { L = \lim_{g(\gamma) \to c \atop \gamma \in C} f(\gamma) ,\\
                  L \in \underset{g(\gamma) \to c \atop \gamma \in C}{Lim} f(\gamma) ,\\
                  f(\gamma) \underset{g(\gamma) \to c \atop \gamma \in C}{\to} L }
          %p
            all mean that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            is a limit of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
