          %p
            Given a
            = succeed "-valued" do
              %a.existingWikiWord{:href => "/nlab/show/real+number"} real
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            defined on a real
            %a.existingWikiWord{:href => "/nlab/show/interval"} interval
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
