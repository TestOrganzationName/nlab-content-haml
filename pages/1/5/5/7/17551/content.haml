            %a{:href => "#LewisMaySteinberger86"}> Lewis-May-Steinberger 86, Cor. 9.9
            )
          %p We will also need this here:
          #FixedPointSpectrumOfSmashProduct.num_lemma
            %h6#lemma_3 Lemma
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              %a.existingWikiWord{:href => "/nlab/show/G-CW-complex"} G-CW-complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              a
              %a.existingWikiWord{:href => "/nlab/show/G-spectrum"} G-
              %a.existingWikiWord{:href => "/nlab/show/CW-spectrum"} CW-spectrum
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
