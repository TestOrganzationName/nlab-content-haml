                            %mo{:stretchy => "false"} (
                            %mo *
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo{:stretchy => "false"} )
                                %mo ∧
                                %msub
                                  %mi χ
                                  %mi V
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi Σ
                              %mi G
                              %mn ∞
                            %msup
                              %mi S
                              %mi V
                            %msubsup
                              %mo{:stretchy => "false"} )
                              %mi G
                              %mn 0
                            %mo{:stretchy => "false"} (
                            %mo *
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mi ⋯
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %msup
                                  %mo{:stretchy => "false"} )
                                  %mi N
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi epi
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                            %msup
                              %mrow
                              %mrow
                                %msub
                                  %mi p
                                  %mn 0
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi p
                                    %mi V
                        %mtr
                          %mtd
                            %mi A
                            %mo{:stretchy => "false"} (
                            %mi G
                            %mo{:stretchy => "false"} /
                            %mi N
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi Σ
                              %mrow
                                %mi G
                                %mo{:stretchy => "false"} /
                                %mi N
                              %mn ∞
                            %msup
                              %mi S
                              %mn 0
                            %msubsup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi G
                                %mo{:stretchy => "false"} /
                                %mi N
                              %mn 0
                            %mo{:stretchy => "false"} (
                            %mo *
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A(G)
                    \&amp;=&amp;
                    (\Sigma^\infty_G S^0)^0_{G}(\ast)
                    \&amp;\overset{ (-) \wedge \chi_V }{\longrightarrow}&amp;
                    (\Sigma^\infty_G S^V)^0_{G}(\ast)
                    \&amp;\to&amp; \cdots
                    \\\
                    {}^{(-)^N}\big\downarrow &amp;&amp; {}^{\mathllap{epi}}\big\downarrow{}^{p_0} &amp;
                    \\swarrow_{\mathrlap{p_V}}
                    \\\
                    A(G/N)
                    \&amp;=&amp;
                    (\Sigma^\infty_{G/N} S^0)^0_{G/N}(\ast)
                    }
            %p
              Since we know, as just argued, that the map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi N
                  %annotation{:encoding => "application/x-tex"} (-)^N
              on the left is a surjection, the
              %a.existingWikiWord{:href => "/nlab/show/commutative+diagram"} commutativity
              of this diagram implies that also the component projection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi V
                  %annotation{:encoding => "application/x-tex"} p_V
              is surjective. (Every element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi N
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} c \in A(G/N)
              has a lift to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi c
                        %mo ^
                      %mo ∈
                      %mi A
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \widehat c \in A(G)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi c
                      %mo ^
                    %mo ∧
                    %msub
                      %mi χ
                      %mi V
                  %annotation{:encoding => "application/x-tex"} \widehat c \wedge \chi_V
              is a pre-image of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              under
              = succeed ".)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mi V
                    %annotation{:encoding => "application/x-tex"} p_V
            %p
              This we may use to deduce the statement for the general case, where the codomain of
              %a.maruku-eqref{:href => "#eq:ProjectionFromEquivariantCohomotopyOfPpintInRODegreeToBurnside"} (9)
              is in degree
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
            %p
              By the assumption that the
              %a.existingWikiWord{:href => "/nlab/show/RO%28G%29-degree"} RO(G)-degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              has no non-trivial
              = succeed "-fixed" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                    %annotation{:encoding => "application/x-tex"} N
              %a.maruku-ref{:href => "#GeometricFixedPointCohomologtIsColimitOverSmashWithEulerClasses"}
              says that the
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimiting
              %a.existingWikiWord{:href => "/nlab/show/cocone"} cocone
              in which the map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi p
                      %mrow
                        %msubsup
                          %mi Σ
                          %mi G
                          %mi V
                        %msub
                          %mi 𝕊
                          %mi G
                      %mi N
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p_{ \Sigma^V_G \mathbb{S}_G }^N(\ast)
              appears, by Def.
              = succeed "," do
                %a.maruku-ref{:href => "#CanonicalComparisonMap"}
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
            #eq:ColimitingCoconeForComparisonAtNonTrivialROG.maruku-equation
              %span.maruku-eq-number (11)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi Σ
                              %mi G
                              %mn ∞
                            %msup
                              %mi S
                              %mi V
                            %msubsup
                              %mo{:stretchy => "false"} )
                              %mi G
                              %mn 0
                            %mo{:stretchy => "false"} (
                            %mo *
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mi ⋯
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi p
                                    %mi V
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi Σ
                              %mi G
                              %mn ∞
                            %msup
                              %mi S
                              %mn 0
                            %msubsup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi G
                                %mo{:stretchy => "false"} /
                                %mi N
                              %mn 0
                            %mo{:stretchy => "false"} (
                            %mo *
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp;
                    (\Sigma^\infty_G S^V)^0_{G}(\ast)
                    \&amp;\to&amp; \cdots
                    \\\
                    \&amp;
                    \\swarrow_{\mathrlap{p_V}}
                    \\\
                    (\Sigma^\infty_G S^0)^0_{G/N}(\ast)
                    }
            %p
              In particular the
              %a.existingWikiWord{:href => "/nlab/show/cocone"} cocone
              in
              %a.maruku-eqref{:href => "#eq:ColimitingCoconeForComparisonAtTrivialROG"} (10)
              restricts to a
              %a.existingWikiWord{:href => "/nlab/show/cocone"} cocone
              over this sub-diagram in
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:ColimitingCoconeForComparisonAtNonTrivialROG"} (11)
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              of the cocone in
              %a.maruku-eqref{:href => "#eq:ColimitingCoconeForComparisonAtNonTrivialROG"} (11)
              implies an
              %a.existingWikiWord{:href => "/nlab/show/endomorphism"} endomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              of the
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
              underlying the
              %a.existingWikiWord{:href => "/nlab/show/Burnside+ring"} Burnside ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Σ
                      %mi G
                      %mn ∞
                    %msup
                      %mi S
                      %mn 0
                    %msubsup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi G
                        %mo{:stretchy => "false"} /
                        %mi N
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\Sigma^\infty_G S^0)^0_{G/N}(\ast) = A(G/n)
              such that
            #eq:Factorization.maruku-equation
              %span.maruku-eq-number (12)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi V
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi ϕ
                    %mspace{:width => "thickmathspace"}
                    %mo ∘
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi p
                      %mrow
                        %msubsup
                          %mi Σ
                          %mi G
                          %mi V
                        %msub
                          %mi 𝕊
                          %mi G
                      %mi N
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    p_V
                    \\;=\;
                    \\phi \;\circ\; p_{ \Sigma^V_G \mathbb{S}_G }^N(\ast)
                    \\,.
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi V
                  %annotation{:encoding => "application/x-tex"} p_V
              is surjective, it is now sufficient to prove that this
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              is in fact an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            %p
              To see this, observe that, since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              is a
              %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite group
              by assumption, the
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
              underlying the
              %a.existingWikiWord{:href => "/nlab/show/Burnside+ring"} Burnside ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi N
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A(G/N)
              is a
              %a.existingWikiWord{:href => "/nlab/show/finitely+generated+module"} finitely generated
              %a.existingWikiWord{:href => "/nlab/show/free+abelian+group"} free abelian group
              (spanned by the cosets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi H
                  %annotation{:encoding => "application/x-tex"} (G/N)/H
              as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              ranges over the
              %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite set
              of
              %a.existingWikiWord{:href => "/nlab/show/conjugacy+classes"} conjugacy classes
              of
              %a.existingWikiWord{:href => "/nlab/show/subgroups"} subgroups
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi N
                  %annotation{:encoding => "application/x-tex"} G/N
              ). By the
              = succeed "," do
                %a{:href => "principal+ideal+domain#StructureTheoryOfModules"} structure theory of free abelian groups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              may be represented by a
              %a.existingWikiWord{:href => "/nlab/show/matrix"} matrix
              in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Smith+normal+form"} Smith normal form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              is an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/endomorphism"} endomorphism
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Smith+normal+form"} Smith normal form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo ∘
                    %msubsup
                      %mi p
                      %mrow
                        %msubsup
                          %mi Σ
                          %mi G
                          %mi V
                        %msub
                          %mi 𝕊
                          %mi G
                      %mi N
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \phi \circ p_{ \Sigma^V_G \mathbb{S}_G }^N(\ast)
              is surjective, by
              %a.maruku-eqref{:href => "#eq:Factorization"} (12)
              and the surjectivity of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi V
                  %annotation{:encoding => "application/x-tex"} p_V
              established before, this implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              is represented by a
              %a.existingWikiWord{:href => "/nlab/show/diagonal+matrix"} diagonal matrix
              all whose diagonal entries are non-vanishing and invertible, hence that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              is in fact an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            %p
              With this,
              %a.maruku-eqref{:href => "#eq:Factorization"} (12)
              says that with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi V
                  %annotation{:encoding => "application/x-tex"} p_V
              also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi p
                      %mrow
                        %msubsup
                          %mi Σ
                          %mi G
                          %mi V
                        %msub
                          %mi 𝕊
                          %mi G
                      %mi N
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p_{ \Sigma^V_G \mathbb{S}_G }^N(\ast)
              is surjective.
