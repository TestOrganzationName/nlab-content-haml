            )
          #SmashingWithTildeEOnspacesEquivalentToRestriction.num_cor
            %h6#corollary Corollary
            %p
              On
              %a.existingWikiWord{:href => "/nlab/show/hom-sets"} hom-sets
              of
              %a.existingWikiWord{:href => "/nlab/show/G-spaces"} G-spaces
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
