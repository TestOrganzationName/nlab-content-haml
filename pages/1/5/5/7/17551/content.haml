          %h2#idea Idea
          %p
            In the context of
            %a.existingWikiWord{:href => "/nlab/show/equivariant+stable+homotopy+theory"} equivariant stable homotopy theory
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            one distinguishes, for a
            %a.existingWikiWord{:href => "/nlab/show/G-spectrum"} G-spectrum
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %em
              %a.existingWikiWord{:href => "/nlab/show/fixed+point+spectrum"} fixed point spectrum
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi F
                    %mi G
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F^G(E)
            and its
            %em geometric fixed point spectrum
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Φ
                      %mi G
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Phi^G(E)
          %p
            Here the terminology “geometric” is in the sense of
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/point-set+topology"} point-set topology
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a (
            %a.existingWikiWord{:href => "/nlab/show/pointed+topological+space"}> pointed
            )
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            equipped with a
            %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            (a
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/topological+G-space"} topological G-space
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/equivariant+suspension+spectrum"} equivariant suspension spectrum
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Σ
                      %mi G
                      %mn ∞
                    %mi X
                    %mo ∈
                    %mi G
                    %mi Spectra
                  %annotation{:encoding => "application/x-tex"} \Sigma^\infty_G X \in G Spectra
            %em geometric fixed point spectrum
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Φ
                    %mi G
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi Σ
                    %mi G
                    %mn ∞
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Phi^G(\Sigma^\infty_G X)
            of the latter is equivalent to the plain
            %a.existingWikiWord{:href => "/nlab/show/suspension+spectrum"} suspension spectrum
            of the plain
            = succeed "-space" do
              %a.existingWikiWord{:href => "/nlab/show/fixed+point"} fixed point
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mi G
                  %annotation{:encoding => "application/x-tex"} X^G
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Φ
                    %mi G
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msubsup
                    %mi Σ
                    %mi G
                    %mn ∞
                  %mi X
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi Σ
                    %mn ∞
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msup
                    %mi X
                    %mi G
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\Phi^G\big(  \Sigma^\infty_G X \big)
                  \\;\simeq\;
                  \\Sigma^\infty\big( X^G \big)
                  \\,,
          %p
            see the characterization in Prop.
            = succeed "," do
              %a.maruku-ref{:href => "#AbstractCharacterizationOfGeometricFixedPointSpectra"}
          %p
            In general this is different from (not
            %a.existingWikiWord{:href => "/nlab/show/equivalence+in+an+%28infinity%2C1%29-category"} equivalent
            to) both of the following other notions of fixed point spectra:
          %ol
            %li
              %p
                the plain (really:
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theoretic
                %a.existingWikiWord{:href => "/nlab/show/fixed+point+spectrum"} fixed point spectrum
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi F
                          %mi G
                        %mo{:stretchy => "false"} (
                        %msubsup
                          %mi Σ
                          %mi G
                          %mn ∞
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} F^G(\Sigma^\infty_G X)
                %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived functor
                of forming topological fixed points
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ↦
                        %msup
                          %mi X
                          %mi G
                      %annotation{:encoding => "application/x-tex"} X \mapsto X^G
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/fibrant+resolution"} fibrant resolution
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/tom+Dieck+splitting+theorem"} tom Dieck splitting theorem
                %a.maruku-ref{:href => "#AsWedgeSummandInTomDieckSplitting"}
                below.
            %li
              %p
                the
                = succeed "\u2026" do
                  %span.newWikiWord
                    categorical fixed point spectrum
                    %a{:href => "/nlab/new/categorical+fixed+point+spectrum"} ?
          %h2#definition Definition
          %p
            A concrete definition of geometric fixed points of an equivariant spectrum is in (
            %a{:href => "#Schwede15"}> Schwede 15, 7.3
            ). A conceptual characterization in terms of
            %a.existingWikiWord{:href => "/nlab/show/localization+of+spectra"} localization of spectra
            is in (
            %a{:href => "#MathewNaumannNoel15"}> Mathew-Naumann-Noel 15, def. 6.12
            ).
          %h2#properties Properties
          %h3#ForEquivariantSuspensionSpectra For equivariant suspension spectra
          #AsWedgeSummandInTomDieckSplitting.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (as a
                %a.existingWikiWord{:href => "/nlab/show/wedge+sum"} wedge summand
                in the
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/tom+Dieck+splitting"} tom Dieck splitting
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              %a.existingWikiWord{:href => "/nlab/show/topological+G-space"} topological G-space
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Σ
                      %mi G
                      %mn ∞
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \Sigma^\infty_G X
              its
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/equivariant+suspension+spectrum"} equivariant suspension spectrum
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Φ
                      %mi G
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Σ
                      %mi G
                      %mn ∞
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi Σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi X
                      %mi G
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %msup
                      %mi F
                      %mi G
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Σ
                      %mi G
                      %mn ∞
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Phi^G(\Sigma^\infty_G X)
                    \\;\simeq\;
                    \\Sigma^\infty( X^G )
                    \\hookrightarrow
                    F^G(\Sigma^\infty_G X)
            %p
              which exhibits its geometric fixed point spectrum as precisely the first summand in the
              %a.existingWikiWord{:href => "/nlab/show/tom+Dieck+splitting"} tom Dieck splitting
              of the plain
              %a.existingWikiWord{:href => "/nlab/show/fixed+point+spectrum"} fixed point spectrum
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mi G
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Σ
                      %mi G
                      %mn ∞
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi Σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi X
                      %mi G
                    %mo{:stretchy => "false"} )
                    %mo ∨
                    %mrow
                      %mo (
                      %munder
                        %mo ∨
                        %mfrac{:linethickness => "0"}
                          %mrow
                            %mrow
                              %mo{:stretchy => "false"} [
                              %mi H
                              %mo ⊂
                              %mi G
                              %mo{:stretchy => "false"} ]
                          %mrow
                            %mrow
                              %mn 1
                              %mo ≠
                              %mi H
                              %mo ≠
                              %mi G
                      %msup
                        %mi Σ
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi W
                        %mi G
                      %mi H
                      %msub
                        %mo{:stretchy => "false"} )
                        %mo +
                      %msub
                        %mo ∧
                        %mrow
                          %msub
                            %mi W
                            %mi G
                          %mi H
                      %msup
                        %mi X
                        %mi H
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mo ∨
                    %msup
                      %mi Σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi E
                    %msub
                      %mi G
                      %mo +
                    %msub
                      %mo ∧
                      %mi G
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    F^G(\Sigma^\infty_G X)
                    \\simeq
                    \\Sigma^\infty( X^G )
                    \\vee
                    \\left(
                    \\underset{{[H\subset G]} \atop {1 \neq H \neq G}}{\vee}
                    \\Sigma^\infty( E (W_G H)_+ \wedge_{W_G H} X^H )
                    \\right)
                    \\vee
                    \\Sigma^\infty( E G_+ \wedge_{G} X )
                    \\,.
          %p
            (
            %a{:href => "#Schwede15"}> Schwede 15, Example 7.7
            )
          %p In fact:
          #AbstractCharacterizationOfGeometricFixedPointSpectra.num_prop
            %h6#proposition_2 Proposition
            %p The construction of geometric fixed point spectra is essentially uniquely characterized by the property
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Φ
                      %mi G
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msubsup
                      %mi Σ
                      %mi G
                      %mn ∞
                    %mi X
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi Σ
                      %mn ∞
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi X
                      %mi G
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Phi^G\big(  \Sigma^\infty_G X \big)
                    \\;\simeq\;
                    \\Sigma^\infty\big( X^G \big)
            %p
              and the property of being
              %a.existingWikiWord{:href => "/nlab/show/left+derived+functor"} left derived
              %a.existingWikiWord{:href => "/nlab/show/strong+monoidal+functor"} strong monoidal
              and preserving
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+colimits"} homotopy colimits
          %p
            (
            %a{:href => "#Schwede15"}> Schwede 15, remark 7.15
            ,
            = succeed ")" do
              %a{:href => "#Blumberg17"} Blumberg 17, around Def. 2.5.16
          %p More generally:
          #PartialGeometricFixedPoint.num_prop
            %h6#propositionremark Proposition/Remark
            %p
              %strong (partial geometric fixed point spectra)
            %p
              There is a “partial” geometric fixed point functor, which for a given
              %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo ⊂
                    %mi G
                  %annotation{:encoding => "application/x-tex"} H \subset G
              sends
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Φ
                      %mi H
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi G
                    %mi Spectra
                    %mo ⟶
                    %msub
                      %mi W
                      %mi G
                    %mi H
                    %mi Spectra
                  %annotation{:encoding => "application/x-tex"}
                    \\Phi^H \;\colon\; G Spectra \longrightarrow W_G H Spectra
            %p
              (for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi W
                      %mi G
                    %mo{:stretchy => "false"} /
                    %mi H
                  %annotation{:encoding => "application/x-tex"} W_G/H
              the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Weyl+group"} Weyl group
              %a.existingWikiWord{:href => "/nlab/show/quotient+group"} quotient group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi H
                  %annotation{:encoding => "application/x-tex"} G/H
              in the case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              is a
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/normal+subgroup"} normal subgroup
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/equivariant+suspension+spectrum"} equivariant suspension spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Σ
                      %mi G
                      %mn ∞
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \Sigma^\infty_G X
              the relation
            #eq:PartialGeometricFixedPointsOfEqui.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Φ
                      %mi H
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msubsup
                      %mi Σ
                      %mi G
                      %mn ∞
                    %mi X
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi Σ
                      %mrow
                        %msub
                          %mi W
                          %mi G
                        %mi H
                      %mn ∞
                    %msup
                      %mi X
                      %mi H
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\Phi^H \big(  \Sigma^\infty_G X \big)
                    \\;\simeq\;
                    \\Sigma^\infty_{W_G H} X^H
                    \\,,
            %p
              hence, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo =
                    %mi N
                    %mo ⊂
                    %mi G
                  %annotation{:encoding => "application/x-tex"} H = N \subset G
              already happens to be a
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/normal+subgroup"} normal subgroup
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Φ
                      %mi N
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msubsup
                      %mi Σ
                      %mi G
                      %mn ∞
                    %mi X
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi Σ
                      %mrow
                        %mi G
                        %mo{:stretchy => "false"} /
                        %mi N
                      %mn ∞
                    %msup
                      %mi X
                      %mi H
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Phi^N \big(  \Sigma^\infty_G X \big)
                    \\;\simeq\;
                    \\Sigma^\infty_{G/N} X^H
                    \\,.
          %p
            (
            %a{:href => "#LewisMaySteinberger86"}> Lewis-May-Steinberger 86, II.9, Def. 9.7, Cor. 9.9
            ,
            = succeed ")" do
              %a{:href => "#Lewis00"} Lewis 00, Scholium 10.2
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %h3#InTermsOfSmashingLocalization In terms of smashing localization
          %p
            We collect some facts from
            = succeed "." do
              %a{:href => "#LewisMaySteinberger86"} Lewis-May-Steinberger 86, section II.9
          %p
            Throughout, consider a
            %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            and a
            %a.existingWikiWord{:href => "/nlab/show/normal+subgroup"} normal subgroup
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo ⊂
                    %mi G
                  %annotation{:encoding => "application/x-tex"} N \subset G
          .num_defn
            %h6#definition_2 Definition
            %p We write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℱ
                    %mo{:stretchy => "false"} [
                    %mi N
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                    %mi N
                    %mi ⊄
                    %mi H
                    %mspace{:width => "thickmathspace"}
                    %mo ⊂
                    %mi G
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{F}[N]
                    \\;\coloneqq\;
                    \\big\{
                    N &amp;#8836; H\; \subset G
                    \\big\}
            %p
              for the set of
              %a.existingWikiWord{:href => "/nlab/show/subgroups"} subgroups
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              that do not contain
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                    %annotation{:encoding => "application/x-tex"} N
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℱ
                    %mo{:stretchy => "false"} [
                    %mi N
                    %msup
                      %mo{:stretchy => "false"} ]
                      %mo ′
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                    %mi N
                    %mo ⊂
                    %mi H
                    %mo ⊂
                    %mi G
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{F}[N]^'
                    \\;\coloneqq\;
                    \\big\{
                    N \subset H \subset G
                    \\big\}
            %p
              for the subset of
              %a.existingWikiWord{:href => "/nlab/show/subgroups"} subgroups
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              that do contain
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                    %annotation{:encoding => "application/x-tex"} N
          %p
            (
            %a{:href => "#LewisMaySteinberger86"}> LMS86, p. 107 &amp; bottom of p. 109
            )
          #tildeE.num_defn
            %h6#definition_3 Definition
            %p
              There is a
              %a.existingWikiWord{:href => "/nlab/show/pointed+topological+space"} pointed
              %a.existingWikiWord{:href => "/nlab/show/G-space"} G-space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi E
                      %mo ˜
                    %mi ℱ
                    %mo{:stretchy => "false"} [
                    %mi N
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi G
                    %mi Spaces
                  %annotation{:encoding => "application/x-tex"}
                    \\widetilde E \mathcal{F}[N]
                    \\;\in\;
                    G Spaces
            %p
              whose
              %a.existingWikiWord{:href => "/nlab/show/fixed+point+spaces"} fixed point spaces
              for
              %a.existingWikiWord{:href => "/nlab/show/subgroups"} subgroups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo ⊂
                    %mi G
                  %annotation{:encoding => "application/x-tex"} H \subset G
              are
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mover
                      %mi E
                      %mo ˜
                    %mi ℱ
                    %mo{:stretchy => "false"} [
                    %mi N
                    %mo{:stretchy => "false"} ]
                    %msup
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mi H
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo *
                            %mtd
                              %mo{:stretchy => "false"} |
                            %mtd
                              %mi H
                              %mo ∈
                              %mi ℱ
                              %mo{:stretchy => "false"} [
                              %mi N
                              %mo{:stretchy => "false"} ]
                              %mspace{:width => "thickmathspace"}
                              %mo ⇔
                              %mspace{:width => "thickmathspace"}
                              %mi N
                              %mi ⊄
                              %mi H
                          %mtr
                            %mtd
                              %msup
                                %mi S
                                %mn 0
                            %mtd
                              %mo{:stretchy => "false"} |
                            %mtd
                              %mi H
                              %mo ∈
                              %mi ℱ
                              %mo{:stretchy => "false"} [
                              %mi N
                              %msup
                                %mo{:stretchy => "false"} ]
                                %mo ′
                              %mspace{:width => "thickmathspace"}
                              %mo ⇔
                              %mspace{:width => "thickmathspace"}
                              %mi N
                              %mo ⊂
                              %mi H
                  %annotation{:encoding => "application/x-tex"}
                    \\big(
                    \\widetilde E \mathcal{F}[N]
                    \\big)^H
                    \\;\simeq\;
                    \\left\{
                    \\array{
                    \\ast
                    \&amp;\vert&amp;
                    H \in \mathcal{F}[N]
                    \\;\Leftrightarrow\;
                    N &amp;#8836; H
                    \\\
                    S^0
                    \&amp;\vert&amp;
                    H \in \mathcal{F}[N]^'
                    \\;\Leftrightarrow\;
                    N \subset H
                    }
                    \\right.
          %p
            (
            %a{:href => "#LewisMaySteinberger86"}> LMS86, beginning of II.9
            )
          #FPrimeEquivalences.num_defn
            %h6#definition_4 Definition
            %p
              We say that a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \to Y
              of
              %a.existingWikiWord{:href => "/nlab/show/G-spectra"} G-spectra
              is an
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi ℱ
                      %mo{:stretchy => "false"} [
                      %mi N
                      %msup
                        %mo{:stretchy => "false"} ]
                        %mo ′
                    %annotation{:encoding => "application/x-tex"} \mathcal{F}[N]^'
                \-equivalence
              if its
              %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi E
                      %mo{:stretchy => "false"} ˜
                    %mi ℱ
                    %mo{:stretchy => "false"} [
                    %mi N
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \tilde E \mathcal{F}[N]
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#tildeE"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∧
                    %msub
                      %mi id
                      %mrow
                        %mover
                          %mi E
                          %mo{:stretchy => "false"} ˜
                        %mi ℱ
                        %mo{:stretchy => "false"} [
                        %mi N
                        %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ∧
                    %mover
                      %mi E
                      %mo{:stretchy => "false"} ˜
                    %mi ℱ
                    %mo{:stretchy => "false"} [
                    %mi N
                    %mo{:stretchy => "false"} ]
                    %mo ⟶
                    %mi Y
                    %mo ∧
                    %mover
                      %mi E
                      %mo{:stretchy => "false"} ˜
                    %mi ℱ
                    %mo{:stretchy => "false"} [
                    %mi N
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    f \wedge id_{\tilde E \mathcal{F}[N]}
                    \\;\colon\;
                    X \wedge \tilde E \mathcal{F}[N]
                    \\longrightarrow
                    Y \wedge \tilde E \mathcal{F}[N]
            %p
              is an equivalence of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/G-spectra"} G-spectra
          %p
            %a{:href => "#LewisMaySteinberger86"} LMS 86, bottom of p. 107
          #FPrimeLocalizationIsSmashingLocalization.num_prop
            %h6#proposition_3 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/localization"} localization
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mi Spectra
                  %annotation{:encoding => "application/x-tex"} G Spectra
              at the
              = succeed "-equivalences" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℱ
                      %mo{:stretchy => "false"} [
                      %mi N
                      %mo{:stretchy => "false"} ]
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} \mathcal{F}[N]'
              = succeed ")" do
                %a.maruku-ref{:href => "#FPrimeEquivalences"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/smashing+localization"} smashing localization
              %a.existingWikiWord{:href => "/nlab/show/equivariant+suspension+spectrum"} equivariant suspension spectrum
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi E
                      %mo{:stretchy => "false"} ˜
                    %mi ℱ
                    %mo{:stretchy => "false"} [
                    %mi N
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \tilde E \mathcal{F}[N]
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#tildeE"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Σ
                      %mi G
                      %mn ∞
                    %mover
                      %mi E
                      %mo{:stretchy => "false"} ˜
                    %mi ℱ
                    %mo{:stretchy => "false"} [
                    %mi N
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi G
                    %mi Spectra
                  %annotation{:encoding => "application/x-tex"}
                    \\Sigma^\infty_G \tilde E \mathcal{F}[N]
                    \\;\in\;
                    G Spectra
            %p In particular, we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ho
                      %mrow
                        %mi G
                        %mi Spectra
                    %mrow
                      %mo (
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mi ℱ
                      %mo{:stretchy => "false"} [
                      %mi N
                      %mo{:stretchy => "false"} ]
                      %mo ∧
                      %mi X
                      %mo ,
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mi ℱ
                      %mo{:stretchy => "false"} [
                      %mi N
                      %mo{:stretchy => "false"} ]
                      %mo ∧
                      %mi Y
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Ho
                      %mrow
                        %mi G
                        %mi Spectra
                    %mrow
                      %mo (
                      %mi X
                      %mo ,
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mi ℱ
                      %mo{:stretchy => "false"} [
                      %mi N
                      %mo{:stretchy => "false"} ]
                      %mo ∧
                      %mi Y
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    Ho_{G Spectra}\left(
                    \\tilde E \mathcal{F}[N] \wedge X,
                    \\tilde E \mathcal{F}[N] \wedge Y
                    \\right)
                    \\;\simeq\;
                    Ho_{G Spectra}\left(
                    X,
                    \\tilde E \mathcal{F}[N] \wedge Y
                    \\right)
          %p
            (
            %a{:href => "#LewisMaySteinberger86"}> Lewis-May-Steinberger 86, Prop. II 9.1, 9.2 &amp; top of p. 109
            )
          #LocalizationBySmashingWithtildeEF.num_remark
            %h6#remark Remark
            %p Hence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi L
                      %mrow
                        %mi ℱ
                        %mo{:stretchy => "false"} [
                        %mi N
