                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Ho_{G Spaces)}
                    \\big(
                    X, \widetilde E \mathcal{F}[N] \wedge Y
                    \\big)
                    \&amp;
                    \\underoverset{\simeq}{
