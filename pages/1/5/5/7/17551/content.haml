            %h6#lemma_2 Lemma
            %p
              %strong (geometric fixed point spectra in terms of homotopy fix point spectra)
            %p
              The partial geometric fixed point functor (Prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#PartialGeometricFixedPoint"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Φ
                      %mi N
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi G
                    %mi Spectra
                    %mo ⟶
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi N
                    %mi Spectra
                  %annotation{:encoding => "application/x-tex"}
                    \\Phi^N
                    \\;\colon\;
                    G Spectra
                    \\longrightarrow
                    G/N Spectra
            %p
              is given on
              %a.existingWikiWord{:href => "/nlab/show/equivariant+suspension+spectra"} equivariant suspension spectra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Σ
                      %mi G
                      %mn ∞
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \Sigma^\infty_G X
              equivalently by first smashing with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi E
                      %mo{:stretchy => "false"} ˜
                    %mi ℱ
                    %mo{:stretchy => "false"} [
                    %mi N
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \tilde E \mathcal{F}[N]
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#tildeE"}
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/fixed+point+spectrum"} fixed point spectrum
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Φ
                      %mi N
