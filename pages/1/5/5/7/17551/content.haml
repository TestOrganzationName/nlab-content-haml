                              %mo ≃
                              %mrow
                                %msub
                                  %mi Ho
                                  %mrow
                                    %mi G
                                    %mi Spaces
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                                %msup
                                  %mi X
                                  %mi N
                                %mo ↪
