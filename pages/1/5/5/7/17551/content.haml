                      %mi ℱ
                      %mo ′
                      %mo{:stretchy => "false"} [
                      %mi N
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \mathcal{F}'[N]
              = succeed "." do
