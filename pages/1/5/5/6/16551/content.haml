              as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi ξ
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} ⟨
                    %mi λ
                    %mo ,
                    %mi ξ
                    %mo{:stretchy => "false"} ⟩
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\exp(\xi) \mapsto \exp( i \langle \lambda, \xi \rangle )
                    \\,.
          .proof
            %h6#proof_2 Proof
            %p
              That this construction defines a map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi T
                    %mo →
                    %mo *
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} *//T \to *//U(1)
              is the statement of prop.
              = succeed "." do
                %a.maruku-ref{:href => "#WeightsAndCharacters"}
            %p
              For this the key point is that since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo ≃
                    %msub
                      %mi G
                      %mi λ
                  %annotation{:encoding => "application/x-tex"} T \simeq G_\lambda
              stabilizes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi λ
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle \lambda , - \rangle
              under the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/coadjoint+action"} coadjoint action
              %a.existingWikiWord{:href => "/nlab/show/gauge+transformation"} gauge transformation
              law for points
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo :
                      %mi U
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %msub
                        %mi G
                        %mi conn
                    %annotation{:encoding => "application/x-tex"} A : U \to \mathbf{B}G_{conn}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ∈
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} g \in C^\infty(U,G)
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ↦
                    %msub
                      %mi Ad
                      %mi g
                    %mi A
                    %mo +
                    %msup
                      %mi g
                      %mo *
                    %mi θ
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    A \mapsto Ad_g A + g^* \theta
                    \\,,
            %p
              maps for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo =
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi ξ
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mi T
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} g = exp( \xi ) \in C^\infty(U,T) \hookrightarrow C^\infty(U,G)
              to the gauge transformation law in
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi conn
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}U(1)_{conn}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ⟨
                            %mi λ
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} ⟩
                          %mtd
                            %mo ↦
                            %mo{:stretchy => "false"} ⟨
                            %mi λ
                            %mo ,
                            %msub
                              %mi Ad
                              %mi g
                            %mi A
                            %mo{:stretchy => "false"} ⟩
                            %mo +
                            %mo{:stretchy => "false"} ⟨
                            %mi λ
                            %mo ,
                            %msup
                              %mi g
                              %mo *
                            %mi θ
                            %mo{:stretchy => "false"} ⟩
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} ⟨
                            %mi λ
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} ⟩
                            %mo +
                            %mi d
                            %mo{:stretchy => "false"} ⟨
                            %mi λ
                            %mo ,
                            %mi ξ
                            %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\langle \lambda, A \rangle
                    \&amp; \mapsto
                    \\langle \lambda, Ad_g A\rangle + \langle \lambda, g^* \theta\rangle
                    \\\
                    \&amp; = \langle \lambda, A \rangle + d  \langle\lambda, \xi \rangle
                    \\end{aligned}
          #ThePrequantumBundleFromCanonicalMaps.num_remark
            %h6#remark_3 Remark
            %p
              The composite of the canonical maps of prop.
              %a.maruku-ref{:href => "#ThetaAsHomotopyFiberOfJ"}
              and prop.
              %a.maruku-ref{:href => "#Extended1dCSLagrangianFromLambda"}
              modulates a canonical
              %a.existingWikiWord{:href => "/nlab/show/circle+bundle+with+connection"} circle bundle with connection
              on the
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/coset+space"} coset space
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/coadjoint+orbit"} coadjoint orbit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi λ
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi θ
                    %mo{:stretchy => "false"} ⟩
                    %mo :
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi T
                    %mover
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi θ
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi T
                    %mover
                      %mo →
                      %mrow
                        %mo{:stretchy => "false"} ⟨
                        %mi λ
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} ⟩
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi conn
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\langle \lambda, \mathbf{\theta}\rangle
                    \:
                    G/T
                    \\stackrel{\mathbf{\theta}}{\to}
                    \\Omega^1(-,\mathfrak{g})//T
                    \\stackrel{\langle \lambda, - \rangle}{\to}
                    \\mathbf{B}U(1)_{conn}
                    \\,.
          .num_prop
            %h6#proposition_8 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
              2-form of the circle bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi λ
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi θ
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle \lambda, \mathbf{\theta}\rangle
              from remark
              %a.maruku-ref{:href => "#ThePrequantumBundleFromCanonicalMaps"}
              is the
              %a.existingWikiWord{:href => "/nlab/show/symplectic+form"} symplectic form
              of prop.
              = succeed "." do
                %a.maruku-ref{:href => "#TheSymplecticFormOnTheCoset"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi λ
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi θ
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle \lambda, \mathbf{\theta}\rangle
              is a
              %a.existingWikiWord{:href => "/nlab/show/prequantization"} prequantization
              of the
              %a.existingWikiWord{:href => "/nlab/show/coadjoint+orbit"} coadjoint orbit
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi 𝒪
                        %mi λ
                      %mo ≃
                      %mi G
                      %mo{:stretchy => "false"} /
                      %mi T
                      %mo ,
                      %msub
                        %mi ν
                        %mi λ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\mathcal{O}_\lambda \simeq G/T, \nu_\lambda)
          .proof
            %h6#proof_3 Proof
            %p The curvature 2-form is modulated by the composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo :
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi T
                    %mover
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi θ
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi T
                    %mover
                      %mo →
                      %mrow
                        %mo{:stretchy => "false"} ⟨
                        %mi λ
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} ⟩
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi conn
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi F
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                    %msubsup
                      %mi Ω
                      %mi cl
                      %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\omega
                    \:
                    G/T
                    \\stackrel{\mathbf{\theta}}{\to}
                    \\Omega^1(-,\mathfrak{g})//T
                    \\stackrel{\langle \lambda, - \rangle}{\to}
                    \\mathbf{B}U(1)_{conn}
                    \\stackrel{F_{(-)}}{\to}
                    \\Omega^2_{cl}
                    \\,.
            %p
              Unwinding the above definitions and propositions, one finds that this is given over a test manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} U \in
              %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              by the map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ω
                      %mi U
                    %mo :
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi T
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msubsup
                      %mi Ω
                      %mi cl
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\omega_U : C^\infty(G/T) \to \Omega^2_{cl}(U)
            %p which sends
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi g
                    %mo{:stretchy => "false"} ]
                    %mo ↦
                    %mi d
                    %mo{:stretchy => "false"} ⟨
                    %mi λ
                    %mo ,
                    %msup
                      %mi g
                      %mo *
                    %mi θ
                    %mo{:stretchy => "false"} ⟩
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [g] \mapsto d \langle \lambda,  g^* \theta \rangle
                    \\,.
          %h5#GaugeAndGravityWilsonLoops Nonabelian charged particle trajectories – Wilson loops
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            be an
            %a.existingWikiWord{:href => "/nlab/show/orientation"} oriented
            %a.existingWikiWord{:href => "/nlab/show/closed+manifold"} closed
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            of
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            3 and let
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mspace{:width => "thickmathspace"}
