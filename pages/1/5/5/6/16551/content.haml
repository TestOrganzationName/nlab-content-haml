          %p
            Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi θ
                  %mo ∈
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo ,
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \theta \in \Omega^1(G, \mathfrak{g})
            for the
            %a.existingWikiWord{:href => "/nlab/show/Maurer-Cartan+form"} Maurer-Cartan form
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          #The2FormOnG.num_defn
            %h6#definition_3 Definition
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Θ
                      %mi λ
                    %mo :
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mi λ
                    %mo ,
                    %mi θ
                    %mo{:stretchy => "false"} ⟩
                    %mo ∈
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Theta_\lambda := \langle \lambda, \theta \rangle \in \Omega^1(G)
            %p
              for the 1-form obtained by pairing the value of the Maurer-Cartan form at each point with the gixed element
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                      %mo ∈
                      %msup
                        %mi 𝔤
                        %mo *
                    %annotation{:encoding => "application/x-tex"} \lambda \in \mathfrak{g}^*
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ν
                      %mi λ
                    %mo :
                    %mo =
                    %msub
                      %mi d
                      %mi dR
                    %msub
                      %mi Θ
                      %mi λ
                  %annotation{:encoding => "application/x-tex"}
                    \\nu_\lambda := d_{dR} \Theta_\lambda
            %p
              for its
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/de+Rham+differential"} de Rham differential
          #TheSymplecticFormOnTheCoset.num_prop
            %h6#proposition_2 Proposition
            %p
              The 2-form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ν
                      %mi λ
                  %annotation{:encoding => "application/x-tex"} \nu_\lambda
              from def.
              %a.maruku-ref{:href => "#The2FormOnG"}
            %ol
              %li
                %p satisfies
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ν
                          %mi λ
                        %mo =
                        %mfrac
                          %mn 1
                          %mn 2
                        %mo{:stretchy => "false"} ⟨
                        %mi λ
                        %mo ,
                        %mo{:stretchy => "false"} [
                        %mi θ
                        %mo ∧
                        %mi θ
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} ⟩
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\nu_\lambda = \frac{1}{2}\langle \lambda, [\theta\wedge \theta]\rangle
                        \\,.
              %li
                %p
                  it descends to a closed
                  = succeed "-invariant" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/coset+space"} coset space
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ν
                          %mi λ
                        %mo ∈
                        %msubsup
                          %mi Ω
                          %mi cl
                          %mn 2
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo{:stretchy => "false"} /
                        %msub
                          %mi G
                          %mi λ
                        %msup
                          %mo{:stretchy => "false"} )
                          %mi G
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\nu_\lambda \in \Omega^2_{cl}(G/G_\lambda)^G
                        \\,.
              %li
                %p
                  this is non-degenerate and hence defines a
                  %a.existingWikiWord{:href => "/nlab/show/symplectic+form"} symplectic form
                  on
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                          %mo{:stretchy => "false"} /
                          %msub
                            %mi G
                            %mi λ
                        %annotation{:encoding => "application/x-tex"} G/G_\lambda
          %h5#the_prequantum_bundle The prequantum bundle
          %p
            We discuss the
            %a.existingWikiWord{:href => "/nlab/show/geometric+prequantization"} geometric prequantization
            of the
            %a.existingWikiWord{:href => "/nlab/show/symplectic+manifold"} symplectic manifold
            given by the
            %a.existingWikiWord{:href => "/nlab/show/coadjoint+orbit"} coadjoint orbit
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒪
                    %mi λ
                %annotation{:encoding => "application/x-tex"} \mathcal{O}_\lambda
            equipped with its
            %a.existingWikiWord{:href => "/nlab/show/symplectic+form"} symplectic form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ν
                    %mi λ
                %annotation{:encoding => "application/x-tex"} \nu_\lambda
            of def.
            = succeed "." do
              %a.maruku-ref{:href => "#TheSymplecticFormOnTheCoset"}
          %p
            Assume now that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/simply+connected+topological+space"} simply connected
          #WeightsAndCharacters.num_prop
            %h6#proposition_3 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/weight+lattice"} weight lattice
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mi wt
                    %mo ⊂
                    %msup
                      %mi 𝔱
                      %mo *
                    %mo ≃
                    %mi 𝔱
                  %annotation{:encoding => "application/x-tex"} \Gamma_{wt} \subset \mathfrak{t}^* \simeq \mathfrak{t}
              of the Lie group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              is
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
              to the group of
              %a.existingWikiWord{:href => "/nlab/show/group+characters"} group characters
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mi wt
                    %mover
                      %mo →
                      %mo ≃
                    %msub
                      %mi Hom
                      %mi LieGrp
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma_{wt} \stackrel{\simeq}{\to} Hom_{LieGrp}(G,U(1))
            %p
              where the identification takes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi α
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                    %mo ∈
                    %msup
                      %mi 𝔱
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \langle \alpha , -\rangle \in \mathfrak{t}^*
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ρ
                      %mi α
                    %mo :
                    %mi T
                    %mo →
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \rho_\alpha : T \to U(1)
              given on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo =
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi ξ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} t = \exp(\xi)
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ξ
                    %mo ∈
                    %mi 𝔱
                  %annotation{:encoding => "application/x-tex"} \xi \in \mathfrak{t}
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ρ
                      %mi α
                    %mo :
