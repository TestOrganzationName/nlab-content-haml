                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi ι
                              %mi Σ
                            %mo ,
                            %msub
                              %mi ι
                              %mi X
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mo →
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mi Σ
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} ]
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ⇙
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %msup
                              %mi S
                              %mn 1
                            %mo ,
                            %mi Q
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mo →
                          %mtd
                            %mo{:stretchy => "false"} [
                            %msup
                              %mi S
                              %mn 1
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    [\iota_{\Sigma}, \iota_X]
                    \&amp;\to&amp;
                    [\Sigma, X]
                    \\\
                    \\downarrow &amp;\swArrow&amp; \downarrow
                    \\\
                    [S^1, Q]
                    \&amp;\to&amp;
                    [S^1, X]
                    }
                    \\,.
          %h5#TheAnomalyFreeOpenStringCouplingToTheChanPatonGaugeField The anomaly-free open string coupling to the Chan-Paton gauge field
          .num_prop
            %h6#proposition_14 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              with
              %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \partial \Sigma
              of
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              and for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo →
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi conn
                  %annotation{:encoding => "application/x-tex"} \nabla \;\colon \; X \to \mathbf{B}^n U(1)_{conn}
              a
              %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle n-bundle with connection
              on some
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
              %a.existingWikiWord{:href => "/nlab/show/transgression"} transgression
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                  %annotation{:encoding => "application/x-tex"} \nabla
              to the
              %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\Sigma, X]
              yields a
              %a.existingWikiWord{:href => "/nlab/show/section"} section
              of the
              %a.existingWikiWord{:href => "/nlab/show/complex+line+bundle"} complex line bundle
              %a.existingWikiWord{:href => "/nlab/show/associated+bundle"} associated
              to the pullback of the ordinary transgression over the mapping space out of the boundary: we have a diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mi Σ
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi exp
                                %mo{:stretchy => "false"} (
                                %mn 2
                                %mi π
                                %mi i
                                %msub
                                  %mo ∫
                                  %mi Σ
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi ℂ
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} /
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi conn
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} [
                                  %mo ∂
                                  %mi Σ
                                  %mo ,
                                  %mi X
                                  %mo{:stretchy => "false"} ]
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mrow
                                %msub
                                  %mpadded{:width => "0"}
                                    %mover
                                      %mi ρ
                                      %mo ¯
                                  %mi conn
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mo ∂
                            %mi Σ
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi exp
                                %mo{:stretchy => "false"} (
                                %mn 2
                                %mi π
                                %mi i
                                %msub
                                  %mo ∫
                                  %mrow
                                    %mo ∂
                                    %mi Σ
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi conn
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    [\Sigma, X]
                    \&amp;\stackrel{\exp(2 \pi i \int_{\Sigma})}{\to}&amp;
                    \\mathbb{C}//U(1)_{conn}
                    \\\
                    \\downarrow^{\mathrlap{[\partial \Sigma, X]}}
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{\overline{\rho}}_{conn}}
                    \\\
                    [\partial \Sigma, X]
                    \&amp;\stackrel{\exp(2 \pi i \int_{\partial \Sigma})}{\to}&amp;
                    \\mathbf{B} U(1)_{conn}
                    }
                    \\,.
          .num_remark
            %h6#remark_7 Remark
            %p
              This is the
              %em
                %a.existingWikiWord{:href => "/nlab/show/higher+parallel+transport"} higher parallel transport
              of the
              = succeed "-connection" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                  %annotation{:encoding => "application/x-tex"} \nabla
              over maps
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \Sigma \to X
          #TheTwistedHolonomyMapOnTwistedUnitaryBundles.num_prop
            %h6#proposition_15 Proposition
            %p
              The operation of forming the
              %a.existingWikiWord{:href => "/nlab/show/holonomy"} holonomy
              of a twisted unitary connection around a curve fits into a
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %msup
                              %mi S
                              %mn 1
                            %mo ,
                            %mo{:stretchy => "false"} (
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} (
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi conn
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi hol
                                  %mrow
                                    %msup
                                      %mi S
                                      %mn 1
                          %mtd
                            %mi ℂ
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} /
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi conn
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} [
                                  %msup
                                    %mi S
                                    %mn 1
                                  %mo ,
                                  %msub
                                    %mover
                                      %mstyle{:mathvariant => "bold"}
                                        %mi dd
                                      %mo ^
