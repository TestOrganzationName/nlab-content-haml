          .num_defn
            %h6#definition_7 Definition
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mi X
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Q
                    %mo ↪
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\iota_X
                    \\;\colon\;
                    Q \hookrightarrow X
            %p
              be an inclusion of
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
              or of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/orbifolds"} orbifolds
              %a.existingWikiWord{:href => "/nlab/show/D-brane"} D-brane
              %a.existingWikiWord{:href => "/nlab/show/worldvolume"} worldvolume
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
              inside an ambient
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p
              Then a
              %strong field configuration
              of a
              %em
                %a.existingWikiWord{:href => "/nlab/show/B-field"} B-field
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              together with a compatible rank-
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              %strong Chan-Paton gauge field
              on the
              %a.existingWikiWord{:href => "/nlab/show/D-brane"} D-brane
              is a map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi ι
                      %mi X
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi Fields
                  %annotation{:encoding => "application/x-tex"}
                    \\phi
                    \\;\colon\;
                    \\iota_X \to \mathbf{Fields}
            %p
              in the
              %a.existingWikiWord{:href => "/nlab/show/arrow+%28%E2%88%9E%2C1%29-topos"} arrow (∞,1)-topos
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mrow
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi Δ
                            %mn 1
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}^{(\Delta^1)}
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Q
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mo ∇
                                  %mi gauge
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} /
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mrow
                                %msub
                                  %mi ι
                                  %mi X
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msub
                              %mo ⇙
                              %mo ≃
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mover
                                      %mstyle{:mathvariant => "bold"}
                                        %mi dd
                                      %mo{:stretchy => "false"} ^
                                    %mi n
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mo ∇
                                  %mi B
                          %mtd
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mn 2
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi conn
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Q &amp;\stackrel{\nabla_{gauge}}{\to}&amp; (\mathbf{B}U(n)//\mathbf{B}U(1))
                    \\\
                    {}^{\iota_X}\downarrow &amp;\swArrow_{\simeq}&amp; \downarrow^{\mathrlap{\hat \mathbf{dd}_n}}
                    \\\
                    X &amp;\stackrel{\nabla_B}{\to}&amp; \mathbf{B}^2 U(1)_{conn}
                    }
          %p
            This identifies a
            %a.existingWikiWord{:href => "/nlab/show/twisted+bundle"} twisted bundle
            with connection on the D-brane whose twist is the class in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mn 3
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H^3(X, \mathbb{Z})
            of the bulk
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/B-field"} B-field
          %p
            This relation is the Kapustin-part of the
            %a.existingWikiWord{:href => "/nlab/show/Freed-Witten-Kapustin+anomaly"} Freed-Witten-Kapustin anomaly
            cancellation for the
            %a.existingWikiWord{:href => "/nlab/show/bosonic+string"} bosonic string
            or else for the
            %a.existingWikiWord{:href => "/nlab/show/type+II+string"} type II string
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Spin
                    %mi c
                %annotation{:encoding => "application/x-tex"} Spin^c
            D-branes. (
            %a{:href => "#FSS"}> FSS
            )
          .num_remark
            %h6#remark_5 Remark
            %p
              If we regard the
              %a.existingWikiWord{:href => "/nlab/show/B-field"} B-field
              as a
              %a.existingWikiWord{:href => "/nlab/show/background+field"} background field
              for the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Chan-Paton+gauge+field"} Chan-Paton gauge field
              %a.maruku-ref{:href => "#PullbackAlongGeneralizedLocalDiffeomorphisms"}
              determines along which maps of the B-field the Chan-Paton gauge field may be transformed.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Y
                          %mtd
                            %mover
                              %mo →
                              %mrow
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mrow
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} /
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi conn
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ↙
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mn 2
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi conn
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Y &amp;\stackrel{}{\to}&amp; X &amp;\stackrel{}{\to}&amp; (\mathbf{B}U(n)//\mathbf{B}U(1))_{conn}
                    \\\
                    \&amp; \searrow &amp; \downarrow &amp; \swarrow
                    \\\
                    \&amp;&amp;\mathbf{B}^2 U(1)_{conn}
                    }
                    \\,.
            %p On the local connection forms this acts as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ↦
                    %mi A
                    %mo +
                    %mi α
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    A \mapsto A + \alpha
                    \\,.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ↦
                    %mi B
                    %mo +
                    %mi d
                    %mi α
                  %annotation{:encoding => "application/x-tex"}
                    B \mapsto B + d \alpha
            %p This is the famous gauge transformation law known from the string theory literature.
          %h5#TheOpenStringSigmaModel The open string sigma-model
          .num_remark
            %h6#remark_6 Remark
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/D-brane"} D-brane
              inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi ι
                          %mi X
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Q \stackrel{\iota_X}{\to} X
              is the
              %a.existingWikiWord{:href => "/nlab/show/target+space"} target space
              for an
              %a.existingWikiWord{:href => "/nlab/show/open+string"} open string
              with
              %a.existingWikiWord{:href => "/nlab/show/worldsheet"} worldsheet
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∂
                      %mi Σ
                      %mover
                        %mo ↪
                        %mrow
                          %msub
                            %mi ι
                            %mi Σ
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \partial \Sigma \stackrel{\iota_\Sigma}{\hookrightarrow} \Sigma
              %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} field
              configuration of the open string
              %a.existingWikiWord{:href => "/nlab/show/sigma-model"} sigma-model
              is a map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi ι
                      %mi Σ
                    %mo →
                    %msub
                      %mi ι
                      %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\phi \;\colon\; \iota_\Sigma \to \iota_X
            %p
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mrow
                          %msup
                            %mi Δ
                            %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}^{\Delta^1}
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo ∂
                            %mi Σ
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi ϕ
                                  %mi bdr
                          %mtd
                            %mi Q
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi ι
                                    %mi Σ
                          %mtd
                            %mo ⇙
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi ι
                                    %mi X
                        %mtr
                          %mtd
                            %mi Σ
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi ϕ
                                  %mi bulk
                          %mtd
                            %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\partial \Sigma &amp;\stackrel{\phi_{bdr}}{\to}&amp; Q
                    \\\
                    \\downarrow^{\mathrlap{\iota_\Sigma}}
                    \&amp;\swArrow&amp;
                    \\downarrow^{\mathrlap{\iota_X}}
                    \\\
                    \\Sigma &amp;\stackrel{\phi_{bulk}}{\to}&amp; X
                    }
                    \\,.
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
              ordinary
              %a.existingWikiWord{:href => "/nlab/show/manifolds"} manifolds
              just says that a field configuration is a map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mi bulk
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Σ
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \phi_{bulk} \;\colon\; \Sigma \to X
              subject to the constraint that it takes the
              %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} Q
              %a.existingWikiWord{:href => "/nlab/show/trajectory"} trajectory
              of an
              %a.existingWikiWord{:href => "/nlab/show/open+string"} open string
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              whose endpoints are constrained to sit on the
              %a.existingWikiWord{:href => "/nlab/show/D-brane"} D-brane
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                      %mo ↪
                      %mi X
                    %annotation{:encoding => "application/x-tex"} Q \hookrightarrow X
            %p
              If however
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is more generally an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/orbifold"} orbifold
              %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
              filling the above diagram imposes this constraint only up to orbifold transformations, hence exhibits what in the physics literature are called “orbifold twisted sectors” of open string configurations.
          #TheTypeIIOpenStringSigmaModelModuliStackOfFields.num_prop
            %h6#proposition_13 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi ι
                      %mi Σ
                    %mo ,
                    %msub
                      %mi ι
                      %mi X
                    %mo{:stretchy => "false"} ]
