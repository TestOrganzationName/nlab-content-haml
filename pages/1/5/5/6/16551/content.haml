                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{B}det
                  \\;\colon\;
                  \\mathbf{B}U(n) \to \mathbf{B}U(1)
          %p
            Under
            %a.existingWikiWord{:href => "/nlab/show/geometric+realization+of+cohesive+infinity-groupoids"} geometric realization of cohesive infinity-groupoids
            this is the universal
            %a.existingWikiWord{:href => "/nlab/show/first+Chern+class"} first Chern class
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
