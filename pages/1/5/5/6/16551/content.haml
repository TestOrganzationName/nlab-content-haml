                          %mo ,
                          %mi 𝔤
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} /
                          %mo{:stretchy => "false"} /
                          %mi T
                      %mtr
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi C
                        %mtd
                          %msub
                            %mo ⇙
                            %mi g
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mstyle{:mathvariant => "bold"}
                                %mi J
                      %mtr
                        %mtd
                          %mi Σ
                        %mtd
