                                  %mo{:stretchy => "false"} ]
                          %mtd
                            %msub
                              %mo ⇙
                              %mo ≃
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mover
                                      %mi ρ
                                      %mo ¯
                                    %mi conn
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %msup
                              %mi S
                              %mn 1
                            %mo ,
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mn 2
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi conn
                            %mo{:stretchy => "false"} ]
                          %mtd
