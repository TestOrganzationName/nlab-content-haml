          %p
            Similarly, in
            %a.existingWikiWord{:href => "/nlab/show/codimension"} codimension
            1 let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
