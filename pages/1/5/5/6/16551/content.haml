                    %mi ℂ
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}//U(1)
            %a.existingWikiWord{:href => "/nlab/show/action+functionals"} action functionals
            coming from the bulk field and the boundary field
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} [
                          %msub
                            %mi ι
                            %mi Σ
                          %mo ,
                          %msub
                            %mi ι
                            %mi X
                          %mo{:stretchy => "false"} ]
                        %mtd
                          %mo →
                        %mtd
                          %mo{:stretchy => "false"} [
                          %mi Σ
                          %mo ,
                          %mi X
                          %mo{:stretchy => "false"} ]
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mi exp
                              %mo{:stretchy => "false"} (
                              %mn 2
                              %mi π
                              %mi i
                              %msub
                                %mo ∫
                                %mi Σ
                              %mo{:stretchy => "false"} [
                              %mi Σ
                              %mo ,
                              %msub
                                %mo ∇
                                %mi B
                              %mo{:stretchy => "false"} ]
                              %mo{:stretchy => "false"} )
                        %mtd
                          %mi ℂ
                          %mo{:stretchy => "false"} /
                          %mo{:stretchy => "false"} /
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %msub
