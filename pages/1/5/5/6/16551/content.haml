                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    (\mathbf{B}U(n))//(\mathbf{B}U(1))_{conn}
                    \&amp;\stackrel{\widehat \mathbf{dd}_n}{\to}&amp;
                    \\mathbf{B}^2 U(1)_{conn}
                    \\\
