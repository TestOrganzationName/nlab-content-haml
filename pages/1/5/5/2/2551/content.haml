          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#definition"} Definition
              %li
                %a{:href => "#examples"} Examples
              %li
                %a{:href => "#references"} References
          %h2#definition Definition
          %p
            In general, given a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            and a
            %a.existingWikiWord{:href => "/nlab/show/class"} class
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                %annotation{:encoding => "application/x-tex"} W
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            %em
              %a.existingWikiWord{:href => "/nlab/show/localization"} localization
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi W
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}[W^{-1}]
            %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective subcategory
            of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
            %a.existingWikiWord{:href => "/nlab/show/local+objects"} local objects
            (the
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/reflective+localization"} reflective localization
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/higher+category"} higher category
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/localization+of+an+%28%E2%88%9E%2C1%29-category"} localization of an (∞,1)-category
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            has
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/finite+products"} finite products
            %a.existingWikiWord{:href => "/nlab/show/object"} object
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔸
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathbb{A} \in \mathcal{C}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mo ≔
                  %msub
                    %mi W
                    %mi 𝔸
                %annotation{:encoding => "application/x-tex"} W \coloneqq W_{\mathbb{A}}
            to be the class of morphisms of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ×
                  %mo{:stretchy => "false"} (
                  %mi 𝔸
                  %mover
                    %mo →
                    %mrow
                      %mo ∃
                      %mo !
                  %mo *
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi X
                  %mo ×
                  %mi 𝔸
                  %mover
                    %mo ⟶
                    %mrow
                      %msub
                        %mi p
                        %mn 1
                  %mi X
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  X \times (\mathbb{A} \overset{\exists!}{\to} \ast)
                  \\;\;\colon\;\;
                  X \times \mathbb{A}
                  \\overset{p_1}{\longrightarrow}
                  X
                  \\,,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is any
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/object"} object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                %annotation{:encoding => "application/x-tex"} \ast
            is the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:lspace => "verythinmathspace"} :
                  %mi 𝒞
                  %mo ×
                  %mi 𝒞
                  %mo →
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} (-) \times (-) \colon \mathcal{C} \times \mathcal{C} \to \mathcal{C}
            denotes the
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/reflective+localization"} reflective localization
            at such a class of morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi W
                    %mi 𝔸
                %annotation{:encoding => "application/x-tex"} W_{\mathbb{A}}
            is often referred to as
            %em
              homotopy localization at the object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔸
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}
            or similar.
          %p
            The idea is that if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔸
                %annotation{:encoding => "application/x-tex"} \mathbb{A}
            is, or is regarded as, an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/interval+object"} interval object
            %a.existingWikiWord{:href => "/nlab/show/left+homotopies"} left homotopies
            between morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X \to Y
            are, or would be, given by morphisms out of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi 𝔸
                  %annotation{:encoding => "application/x-tex"} X \times \mathbb{A}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ×
                  %mi 𝔸
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} X \times \mathbb{A} \to X
            to be equivalences means forcing all morphisms to be
            %em
              %a.existingWikiWord{:href => "/nlab/show/homotopy+invariance"} homotopy invariant
            with respect to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔸
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}
          %p
            Typically this is considered in the case that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            is a
            %a.existingWikiWord{:href => "/nlab/show/locally+presentable+category"} locally presentable category
            with a
            %a.existingWikiWord{:href => "/nlab/show/small+set"} small set
            of
            %a.existingWikiWord{:href => "/nlab/show/generators+and+relations"} generating objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi G
                    %mi i
                %annotation{:encoding => "application/x-tex"} G_i
            such that it becomes sufficient to enforce the localization only on the resulting
            %a.existingWikiWord{:href => "/nlab/show/small+set"} small set
            of
            %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            of the form
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mi i
                    %mo ×
                    %mo{:stretchy => "false"} (
                    %mi 𝔸
                    %mo →
                    %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G_i \times (\mathbb{A} \to \ast)
          %h2#examples Examples
          %ul
            %li
              %p
                The localization of the
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-sheaves"} (∞,1)-category of (∞,1)-sheaves
                on the
                %a.existingWikiWord{:href => "/nlab/show/Nisnevich+site"} Nisnevich site
                at the
                %a.existingWikiWord{:href => "/nlab/show/affine+line"} affine line
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝔸
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
                is known as
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/A1-homotopy+theory"} A1-homotopy theory
            %li
              %p
                The localization of
                %a.existingWikiWord{:href => "/nlab/show/smooth+%E2%88%9E-groupoids"} smooth ∞-groupoids
                at the
                %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^1
                is equivalently (
                %a.existingWikiWord{:href => "/nlab/show/geometrically+discrete+%E2%88%9E-groupoids"}> geometrically discrete
                )
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoids"} ∞-groupoids
              %p
                After realizing
                %a.existingWikiWord{:href => "/nlab/show/smooth+%E2%88%9E-groupoids"} smooth ∞-groupoids
                as the
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-sheaves"} (∞,1)-sheaves
                over
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Smooth
                        %mn ∞
                        %mi Grpd
                        %mo ≃
                        %msub
                          %mi Sh
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %mi CartSp
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Smooth\infty Grpd \simeq Sh_{\infty}(CartSp)
                = succeed "." do
                  %a.maruku-ref{:href => "#HomotopyLocalizationOverSiteOfAns"}
          #HomotopyLocalizationOverSiteOfAns.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/homotopy+localization"} homotopy localization
                at
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝔸
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
                over the
                %a.existingWikiWord{:href => "/nlab/show/site"} site
                of
                = succeed "s)" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi 𝔸
                          %mi n
                      %annotation{:encoding => "application/x-tex"} \mathbb{A}^n
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be any
              %a.existingWikiWord{:href => "/nlab/show/site"} site
              (
              %a{:href => "geometry+of+physics+--+categories+and+toposes#Coverage"}> this Def.
              ), and write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ,
                    %msub
                      %mi sSet
                      %mi Qu
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo ,
                        %mi loc
                  %annotation{:encoding => "application/x-tex"} [\mathcal{C}^{op}, sSet_{Qu}]_{proj, loc}
              for its local projective
              %a.existingWikiWord{:href => "/nlab/show/model+category+of+simplicial+presheaves"} model category of simplicial presheaves
              (
              %a{:href => "geometry+of+physics+--+categories+and+toposes#TopologicalLocalization"}> this Prop.
              ).
            %p
              Assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              contains an
              %a.existingWikiWord{:href => "/nlab/show/object"} object
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔸
                      %mo ∈
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathbb{A} \in \mathcal{C}
              %a.existingWikiWord{:href => "/nlab/show/finite+product"} finite product
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝔸
                        %mi n
                      %mo ≔
                      %munder
                        %munder
                          %mrow
                            %mi 𝔸
                            %mo ×
                            %mi ⋯
                            %mo ×
                            %mi 𝔸
                          %mo ⏟
                        %mrow
                          %mi n
                          %mspace{:width => "thickmathspace"}
                          %mtext factors
                    %annotation{:encoding => "application/x-tex"} \mathbb{A}^n \coloneqq \underset{n \; \text{factors}}{\underbrace{\mathbb{A} \times \cdots \times \mathbb{A}}}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is also the
              %a.existingWikiWord{:href => "/nlab/show/syntactic+category"} syntactic category
              of
              = succeed ".)" do
                %a.existingWikiWord{:href => "/nlab/show/Lawvere+theory"} Lawvere theory
            %p
              Consider the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝔸
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
              %a.existingWikiWord{:href => "/nlab/show/homotopy+localization"} homotopy localization
              (
              %a{:href => "geometry+of+physics+--+categories+and+toposes#HomotopyLocalizationOfCombinatorialModelCategories"}> this Def.
              ) of the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-sheaf+%28%E2%88%9E%2C1%29-topos"} (∞,1)-sheaf (∞,1)-topos
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              (
              %a{:href => "geometry+of+physics+--+categories+and+toposes#TopologicalLocalization"}> this Prop.
              )
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Sh
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi 𝔸
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ↪
                        %mrow
                          %mphantom
                            %mi AA
                          %mi ι
                          %mphantom
                            %mi AA
                      %mover
                        %mo ⟵
                        %mrow
                          %msub
                            %mi L
                            %mi 𝔸
                    %msub
                      %mi Sh
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi CombModCat
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Sh_\infty(\mathcal{C})_{\mathbb{A}}
                    \\underoverset
                    {\underset{\phantom{AA}\iota\phantom{AA}}{\hookrightarrow}}
                    {\overset{L_{\mathbb{A}}}{\longleftarrow}}
                    {\bot}
                    Sh_\infty(\mathcal{C})
                    \\;\;
                    \\in
                    Ho(CombModCat)
            %p
              hence the
              %a.existingWikiWord{:href => "/nlab/show/left+Bousfield+localization"} left Bousfield localization
              of
              %a.existingWikiWord{:href => "/nlab/show/model+categories"} model categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ,
                    %msub
                      %mi sSet
                      %mi Qu
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo ,
                        %mi loc
                        %mo ,
                        %mi 𝔸
                    %munderover
                      %mrow
                        %mphantom
                          %mrow
                            %msub
                              %mrow
                              %mi Qu
                        %msub
                          %mo ⊥
                          %mi Qu
                      %munder
                        %mo ⟶
                        %mrow
                          %mphantom
                            %mi AA
                          %mi id
                          %mphantom
                            %mi AA
                      %mover
                        %mo ⟵
                        %mi id
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ,
                    %msub
                      %mi sSet
                      %mi Qu
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo ,
                        %mi loc
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mi CombModCat
                  %annotation{:encoding => "application/x-tex"}
                    [\mathcal{C}^{op}, sSet_{Qu}]_{proj,loc,\mathbb{A}}
                    \\underoverset
                    {\underset{\phantom{AA}id\phantom{AA}}{\longrightarrow}}
                    {\overset{id}{\longleftarrow}}
                    {\phantom{{}_{Qu}}\bot_{Qu}}
                    [\mathcal{C}^{op}, sSet_{Qu}]_{proj,loc}
                    \\;\;
                    \\in
                    CombModCat
            %p at the set of morphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                    %msup
                      %mi 𝔸
                      %mi n
                    %mo ×
                    %mi 𝔸
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi p
                          %mn 1
                    %msup
                      %mi 𝔸
                      %mi n
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                  %annotation{:encoding => "application/x-tex"}
                    S
                    \\;\coloneqq\;
                    \\big\{
                    \\mathbb{A}^n \times \mathbb{A}
                    \\overset{p_1}{\longrightarrow}
                    \\mathbb{A}^n
                    \\big\}
            %p
              (according to
              = succeed ")." do
                %a{:href => "geometry+of+physics+--+categories+and+toposes#ExistenceOfLeftBousfieldLocalization"} this Prop.
            %p
              Then this is
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalent
              (
              %a{:href => "geometry+of+physics+--+categories+and+toposes#HoCombModCat"}> this Def.
              ) to
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
              (
              %a{:href => "geometry+of+physics+--+categories+and+toposes#InfinityGroupoid"}> this Example
              ),
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                    %mi Grpd
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Sh
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi 𝔸
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ↪
                        %mrow
                          %mphantom
                            %mi AA
                          %mi ι
                          %mphantom
                            %mi AA
                      %mover
                        %mo ⟵
                        %mrow
                          %msub
                            %mi L
                            %mi 𝔸
                    %msub
                      %mi Sh
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi CombModCat
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\infty Grpd
                    \\;\simeq\;
                    Sh_\infty(\mathcal{C})_{\mathbb{A}}
                    \\underoverset
                    {\underset{\phantom{AA}\iota\phantom{AA}}{\hookrightarrow}}
                    {\overset{L_{\mathbb{A}}}{\longleftarrow}}
                    {\bot}
                    Sh_\infty(\mathcal{C})
                    \\;\;
                    \\in
                    Ho(CombModCat)
            %p
              in that the (
              %a.existingWikiWord{:href => "/nlab/show/constant+functor"} constant functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊣
                  %annotation{:encoding => "application/x-tex"} \dashv
              = succeed ")-" do
                %a.existingWikiWord{:href => "/nlab/show/limit"} limit
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
              (
              %a{:href => "geometry+of+physics+--+categories+and+toposes#Limits"}> this Def.
              )
            #eq:QuillenEquivalenceInABousfLocalization.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ,
                    %msub
                      %mi sSet
                      %mi Qu
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi inj
                        %mo ,
                        %mi loc
                        %mo ,
                        %mi 𝔸
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ⟶
                        %munder
                          %mi lim
                          %mo ⟵
                      %mover
                        %mo ⟵
                        %mrow
                          %mphantom
                            %mi AA
                          %mi const
                          %mphantom
                            %mi AA
                    %msub
                      %mi sSet
                      %mi Qu
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mi CombModCat
                  %annotation{:encoding => "application/x-tex"}
                    [\mathcal{C}^{op}, sSet_{Qu}]_{inj, loc, \mathbb{A}}
                    \\underoverset
                    {\underset{ \underset{\longleftarrow}{\lim} }{\longrightarrow}}
                    {\overset{ \phantom{AA}const\phantom{AA} }{\longleftarrow}}
                    {\bot}
                    sSet_{Qu}
                    \\;\;\;\;
                    \\in
                    CombModCat
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
              (
              %a{:href => "geometry+of+physics+--+homotopy+types#QuillenEquivalence"}> this Def.
              ).
          .proof
            %h6#proof Proof
            %p
              First to see that
              %a.maruku-eqref{:href => "#eq:QuillenEquivalenceInABousfLocalization"} (1)
              is a
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
              %a.existingWikiWord{:href => "/nlab/show/simplicial+Quillen+adjunction"} simplicial Quillen adjunction
              before localization
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ,
                    %msub
                      %mi sSet
                      %mi Qu
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi inj
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ⟶
                        %munder
                          %mi lim
                          %mo ⟵
                      %mover
                        %mo ⟵
                        %mrow
                          %mphantom
                            %mi AA
                          %mi const
                          %mphantom
                            %mi AA
                    %msub
                      %mi sSet
                      %mi Qu
                  %annotation{:encoding => "application/x-tex"}
                    [\mathcal{C}^{op}, sSet_{Qu}]_{inj}
                    \\underoverset
                    {\underset{ \underset{\longleftarrow}{\lim} }{\longrightarrow}}
                    {\overset{ \phantom{AA}const\phantom{AA} }{\longleftarrow}}
                    {\bot}
                    sSet_{Qu}
            %p
              (by
              = succeed ")" do
                %a{:href => "geometry+of+physics+--+categories+and+toposes#HomotopyLimitOfSimplicialSets"} this Example
              %a.existingWikiWord{:href => "/nlab/show/model+categories"} model categories
              here are
              %a.existingWikiWord{:href => "/nlab/show/left+proper+model+category"} left proper
              %a.existingWikiWord{:href => "/nlab/show/simplicial+model+categories"} simplicial model categories
              (by
              %a{:href => "geometry+of+physics+--+categories+and+toposes#SimplicialPresheavesIsProperCombinatorialSimplicial"} this Prop.
              and
              = succeed ")," do
                %a{:href => "geometry+of+physics+--+categories+and+toposes#ExistenceOfLeftBousfieldLocalization"} this Prop.
              %a.existingWikiWord{:href => "/nlab/show/left+Bousfield+localization"} left Bousfield localization
              does not change the class of
              %a.existingWikiWord{:href => "/nlab/show/cofibrations"} cofibrations
              (
              %a{:href => "geometry+of+physics+--+categories+and+toposes#BousfieldLocalizationOfModelCategories"}> this Def.
              ) it is sufficient to show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi lim
                      %mo ⟵
                  %annotation{:encoding => "application/x-tex"} \underset{\longleftarrow}{\lim}
              preserves
              %a.existingWikiWord{:href => "/nlab/show/fibrant+objects"} fibrant objects
              (by
              = succeed ")." do
                %a{:href => "geometry+of+physics+--+categories+and+toposes#RecognitionOfSimplicialQuillenAdjunction"} this Prop.
            %p
              But by assumption
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              has a
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                      %mo =
                      %msup
                        %mi 𝔸
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} \ast = \mathbb{A}^0
              %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝒞
                        %mi op
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}^{op}
              %a.existingWikiWord{:href => "/nlab/show/limit"} limit
              operation is given just by evaluation on that object:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi lim
                      %mo ⟵
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi 𝔸
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{\longleftarrow}{\lim}
                    \\mathbf{X}
                    \\;=\;
                    \\mathbf{X}(\mathbb{A}^0)
                    \\,.
            %p
              Hence it is sufficient to see that an injectively fibrant simplicial presheaf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \mathbf{X}
              is objectwise a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
              = succeed "." do
                %a{:href => "geometry+of+physics+--+categories+and+toposes#ModelCategoriesOfSimplicialPresheaves"} this Prop.
            %p
              To check that
              %a.maruku-eqref{:href => "#eq:QuillenEquivalenceInABousfLocalization"} (1)
              is actually a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
              %a.existingWikiWord{:href => "/nlab/show/derived+adjunction+unit"} derived adjunction unit
              and
              %a.existingWikiWord{:href => "/nlab/show/derived+adjunction+counit"} derived adjunction counit
              are
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/weak+equivalences"} weak equivalences
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} X \in sSet
              any simplicial set (necessarily cofibrant), the
              %a.existingWikiWord{:href => "/nlab/show/derived+adjunction+unit"} derived adjunction unit
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi id
                          %mi X
                    %mi const
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi 𝔸
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %mi const
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi j
                          %mi X
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi 𝔸
                          %mn 0
                        %mo{:stretchy => "false"} )
                    %mi const
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi 𝔸
                      %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    X
                    \\overset{id_X}{\longrightarrow}
                    const(X)(\mathbb{A}^0)
                    \\overset{ const(j_X)(\mathbb{A}^0) }{\longrightarrow}
                    const(P X)(\mathbb{A}^0)
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi j
                          %mi X
                    %mi P
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X \overset{j_X}{\longrightarrow} P X
              is a
              %a.existingWikiWord{:href => "/nlab/show/fibrant+replacement"} fibrant replacement
              (
              %a{:href => "geometry+of+physics+--+categories+and+toposes#FibrantCofibrantReplacementFunctorToHomotopyCategory"}> this Def.
              ). But
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi const
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi 𝔸
                      %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} const(-)(\mathbb{A}^0)
              is clearly the
              %a.existingWikiWord{:href => "/nlab/show/identity+functor"} identity functor
              and the plain adjunction unit is the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/identity+morphism"} identity morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi j
                      %mi X
                  %annotation{:encoding => "application/x-tex"} j_X
              itself, which is indeed a weak equivalence.
            %p
              For the other case, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ,
                    %msub
                      %mi sSet
                      %mi Qu
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi inj
                        %mo ,
                        %mi loc
                        %mo ,
                        %msup
                          %mi 𝔸
                          %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbf{X} \in [\mathcal{C}^{op}, sSet_{Qu}]_{inj, loc, \mathbb{A}^1}
              be fibrant. This means (by
              = succeed ")" do
                %a{:href => "geometry+of+physics+--+categories+and+toposes#ExistenceOfLeftBousfieldLocalization"} this Prop.
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \mathbf{X}
              is fibrant in the injective
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
              as well as in the local model structure, and is a derived-
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msup
                      %mi 𝔸
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
              \-
              %a.existingWikiWord{:href => "/nlab/show/local+object"} local object
              (
              %a{:href => "geometry+of+physics+--+categories+and+toposes#DerivedLocalObjects"}> this Def.
              ), in that the
              %a.existingWikiWord{:href => "/nlab/show/derived+hom-functor"} derived hom-functor
              out of any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔸
                      %mi n
                    %mo ×
                    %msup
                      %mi 𝔸
                      %mn 1
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi p
                          %mn 1
                    %msup
                      %mi 𝔸
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}^n \times \mathbb{A}^1 \overset{p_1}{\longrightarrow} \mathbb{A}^n
              into
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \mathbf{X}
              is a
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi p
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi ℝ
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi 𝔸
                      %mi n
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %mi W
                    %mi ℝ
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi 𝔸
                      %mi n
                    %mo ×
                    %msup
                      %mi 𝔸
                      %mn 1
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R}Hom( p_1 )
                    \\;\colon\;
                    \\mathbb{R}Hom( \mathbb{A}^n , \mathbf{X})
                    \\overset{\in W}{\longrightarrow}
                    \\mathbb{R}Hom( \mathbb{A}^n \times \mathbb{A}^1 , \mathbf{X})
            %p
              But since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \mathbf{X}
              is fibrant, this derived hom is equivalent to the ordinary
              %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
              (
              %a{:href => "geometry+of+physics+--+categories+and+toposes#HomsOutOfCofibrantIntoFibrantComputeHomotopyCategory"}> this Lemma
              ), and hence with the
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
              (
              %a{:href => "geometry+of+physics+--+categories+and+toposes#YonedaLemma"}> this Prop.
              ) we have that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi p
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi 𝔸
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %mi W
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi 𝔸
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{X}(p_1)
                    \\;\colon\;
                    \\mathbf{X}(\mathbb{A}^n)
                    \\overset{\in W}{\longrightarrow}
                    \\mathbf{X}(\mathbb{A}^{n+1})
            %p
              is a weak equivalence, for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %a.existingWikiWord{:href => "/nlab/show/induction"} induction
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              this means that in fact
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi 𝔸
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %mi W
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi 𝔸
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{X}(\mathbb{A}^0)
                    \\overset{\in W}{\longrightarrow}
                    \\mathbf{X}(\mathbb{A}^n)
            %p
              is a weak equivalence for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %a.existingWikiWord{:href => "/nlab/show/adjunction+counit"} adjunction counit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi const
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi 𝔸
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %mi W
                      %mi ϵ
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                  %annotation{:encoding => "application/x-tex"}
                    const (\mathbf{X}(\mathbb{A}^0))
                    \\underoverset{\in W}{\epsilon}{\longrightarrow}
                    \\mathbf{X}
            %p
              which is hence also a weak equivalence. Hence for the
              %a.existingWikiWord{:href => "/nlab/show/derived+adjunction+counit"} derived adjunction counit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi const
                    %mo{:stretchy => "false"} (
                    %mi Q
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi 𝔸
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %mi const
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi p
                          %mstyle{:mathvariant => "bold"}
                            %mi X
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi 𝔸
                          %mn 0
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                    %mi const
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi 𝔸
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %mi W
                      %mi ϵ
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                  %annotation{:encoding => "application/x-tex"}
                    const (Q \mathbf{X})(\mathbb{A}^0)
                    \\overset{const(p_{\mathbf{X}}(\mathbb{A}^0))}{\longrightarrow}
                    const (\mathbf{X}(\mathbb{A}^0))
                    \\underoverset{\in W}{\epsilon}{\longrightarrow}
                    \\mathbf{X}
            %p
              to be a weak equivalence, it is now sufficient to see that the value of a
              %a.existingWikiWord{:href => "/nlab/show/cofibrant+replacement"} cofibrant replacement
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mstyle{:mathvariant => "bold"}
                        %mi X
                  %annotation{:encoding => "application/x-tex"} p_{\mathbf{X}}
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔸
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}^0
              is a weak equivalence. But by definition of the weak equivalences of simplicial presheaves these are objectwise weak equivalences.
