                      %msub
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mrow
                          %mi s
                          %mo{:lspace => "verythinmathspace"} :
                          %mi S
                    %annotation{:encoding => "application/x-tex"} \big(\left\vert s \right\rangle\big)_{s \colon S}
                and consider the linear map
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi V
                                  %mspace{:width => "thickmathspace"}
                                  %mo{:lspace => "verythinmathspace"} :
                                  %mspace{:width => "thickmathspace"}
                                  %mspace{:width => "thickmathspace"}
                              %mi.mathscript ℋ
                            %mtd
                              %mo ⟶
                            %mtd
                              %mi.mathscript ℋ
                              %mo ⊗
                              %mi.mathscript ℬ
                          %mtr
                            %mtd
                              %mrow
                                %mo |
                                %mi ψ
                                %mo ⟩
                            %mtd
                              %mo ↦
                            %mtd
                              %munder
                                %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                                %mi s
                              %mspace{:width => "thinmathspace"}
                              %msub
                                %mi E
                                %mi s
                              %mrow
                                %mo |
                                %mi ψ
                                %mo ⟩
                              %mo ⊗
                              %mrow
                                %mo |
                                %mi s
                                %mo ⟩
                              %mpadded{:width => "0"}
                                %mrow
                                  %mspace{:width => "thinmathspace"}
                                  %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \\mathllap{
                      V
                      \\;\colon\;\;
                      }
                      \\mathscr{H}
                      \&amp;\longrightarrow&amp;
                      \\mathscr{H}
                      \\otimes
                      \\mathscr{B}
                      \\\
                      \\left\vert \psi \right\rangle
                      \&amp;\mapsto&amp;
                      \\underset{s}{\sum}
                      \\,
                      E_s
                      \\left\vert
                      \\psi
                      \\right\rangle
                      \\otimes
                      \\left\vert s \right\rangle
                      \\mathrlap{\,.}
                      }
              %p
                Observe that this is a
                %a.existingWikiWord{:href => "/nlab/show/linear+isometry"} linear isometry
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mtable{:columnalign => "left left", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mrow
                              %mo ⟨
                              %mi ψ
                              %mo |
                            %msup
                              %mi V
                              %mo †
                            %mi V
                            %mrow
                              %mo |
                              %mi ψ
                              %mo ⟩
                        %mtr
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi s
                                %mo ,
                                %mi s
                                %mo ′
                            %mrow
                              %mo ⟨
                              %mi ψ
                              %mo |
                            %msubsup
                              %mi E
