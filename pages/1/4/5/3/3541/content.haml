                  %mo ⟶
                  %msub
                    %mi.mathscript ℋ
                    %mn 2
                %annotation{:encoding => "application/x-tex"} U \,\colon\, \mathscr{H}_1 \longrightarrow \mathscr{H}_2
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ch
                %annotation{:encoding => "application/x-tex"} ch
            is given by
            %a.existingWikiWord{:href => "/nlab/show/conjugation"} conjugation
            with this operator:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ch
                  %mo{:stretchy => "false"} (
                  %mi ρ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
