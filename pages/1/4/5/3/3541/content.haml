                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\mathscr{H}_1
                  \\otimes
                  \\mathscr{H}_1^\ast
                  \&amp;
                  \\longrightarrow
                  \&amp;
                  \\mathscr{H}_2
                  \\otimes
                  \\mathscr{H}_2^\ast
                  \\\
                  \\rho
                  \&amp;\mapsto&amp;
                  ch(\rho)
                  }
          %p
            is unitary iff there exists a
            %a.existingWikiWord{:href => "/nlab/show/unitary+operator"} unitary operator
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
