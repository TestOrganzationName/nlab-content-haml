                    %annotation{:encoding => "application/x-tex"}
                      s \,\colon\, S
                      \\;\;\;
                      \\vdash
                      \\;\;\;
                      E_s
                      \\;\colon\;
                      \\mathscr{H}
                      \\longrightarrow
                      \\mathscr{H}
                      \\,,\;\;\;\;
                      \\text{with}
                      \\;\;\;\;
                      \\underset{s}{\sum}
                      E_s^\dagger \cdot E_s \,=\, Id
                      \\mathrlap{\,,}
              %p such that
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi chan
                      %mo{:stretchy => "false"} (
                      %mi ρ
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mi s
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mi E
                        %mi s
                      %mo ⋅
                      %mi ρ
                      %mo ⋅
                      %msubsup
                        %mi E
                        %mi s
                        %mo †
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      chan(\rho)
                      \\;=\;
                      \\underset{s}{\sum}
