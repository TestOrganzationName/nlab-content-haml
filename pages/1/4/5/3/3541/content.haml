                    ),
                %li
                  %p
                    and acting on the given
                    %a.existingWikiWord{:href => "/nlab/show/mixed+state"} mixed state
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
