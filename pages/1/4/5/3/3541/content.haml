          %h3#QuantumMeasurementAndPOVM Quantum measurement channels
          %p Consider
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi.mathscript ℋ
