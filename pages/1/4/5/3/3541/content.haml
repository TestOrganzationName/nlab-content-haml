                  %msub
                    %mi P
                    %mi w
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi{:mathvariant => "normal"} id
                    %mi.mathscript ℋ
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\underset{w}{\sum} P_w
                  \\;=\;
                  \\mathrm{id}_{\mathscr{H}}
                  \\,,
          %p
            whence one also refers to the
            %a.existingWikiWord{:href => "/nlab/show/tuple"} tuple
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi w
                  %mo ↦
                  %msub
                    %mi P
                    %mi w
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} ( w \mapsto P_w )
            aas
            %em
              %a.existingWikiWord{:href => "/nlab/show/projection+valued+measure"} projection valued measure
            (here: on the
            %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite set
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
          %p
            If now
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                %annotation{:encoding => "application/x-tex"} W
            is a
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/quantum+measurement"} quantum measurement
            %a.existingWikiWord{:href => "/nlab/show/linear+basis"} basis
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi.mathscript ℋ
                  %annotation{:encoding => "application/x-tex"} \mathscr{H}
            %a.existingWikiWord{:href => "/nlab/show/quantum+state+collapse"} collapse postulate
            of
            %a.existingWikiWord{:href => "/nlab/show/quantum+mechanics"} quantum mechanics
            says that after measuring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi w
                  %mspace{:width => "thinmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thinmathspace"}
                  %mi W
                %annotation{:encoding => "application/x-tex"} w \,\colon\, W
            for a quantum system previously in
            %a.existingWikiWord{:href => "/nlab/show/pure+state"} pure state
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo |
                      %mi ψ
                      %mo ⟩
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mi.mathscript ℋ
                  %annotation{:encoding => "application/x-tex"} \left\vert \psi \right\rangle\,\colon\, \mathscr{H}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo |
                    %mi ψ
                    %mo ⟩
                  %mspace{:width => "thickmathspace"}
                  %mo ↦
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi P
                    %mi w
                  %mrow
                    %mo |
                    %mi ψ
                    %mo ⟩
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\left\vert \psi \right\rangle
                  \\;\mapsto \;
                  P_w \left\vert \psi \right\rangle
                  \\,,
          %p
            hence any
            %a.existingWikiWord{:href => "/nlab/show/mixed+state"} mixed state
            (
            %a.existingWikiWord{:href => "/nlab/show/density+matrix"}> density matrix
            ) will have evolved according to
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                  %mspace{:width => "thickmathspace"}
                  %mo ↦
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi P
                    %mi w
                  %mo ⋅
                  %mi ρ
                  %mo ⋅
                  %msub
                    %mi P
                    %mi w
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\rho \;\mapsto\; P_w \cdot \rho \cdot P_w
                  \\,.
          %p
            But if one now in addition considers classical
            %a.existingWikiWord{:href => "/nlab/show/probability+theory"} probabilistic
            uncertainty* as to which measurement result
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi w
                %annotation{:encoding => "application/x-tex"} w
            was actually found (say due to ignorance of the experimentor or imperfection of the measurement device) then all of the resulting pure states
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi P
                    %mi w
                  %mrow
                    %mo |
                    %mi ψ
                    %mo ⟩
                %annotation{:encoding => "application/x-tex"} P_w \left\vert \psi \right\rangle
            above are equivally likely and as such constitute the
            %a.existingWikiWord{:href => "/nlab/show/mixed+state"} mixed state
            which is represented by the
            %a.existingWikiWord{:href => "/nlab/show/density+matrix"} density matrix
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo |
                    %mi ψ
                    %mo ⟩
                  %mrow
                    %mo ⟨
                    %mi ψ
                    %mo |
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ↦
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi w
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi P
                    %mi w
                  %mrow
                    %mo |
                    %mi ψ
                    %mo ⟩
                  %mrow
                    %mo ⟨
                    %mi ψ
                    %mo |
                  %msub
                    %mi P
                    %mi w
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\left\vert \psi \right\rangle
                  \\left\langle \psi \right\vert
                  \\;\;\mapsto\;\;
                  \\underset{w}{\sum}
                  \\,
                  P_w \left\vert \psi \right\rangle
                  \\left\langle \psi \right\vert P_w
                  \\,.
          %p
            In general, if the initial state was
            %a.existingWikiWord{:href => "/nlab/show/mixed+state"} mixed
            to start with, then the stochastic quantum measurement process will be represented by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi.mathscript ℋ
                          %mo ⊗
                          %msup
                            %mi.mathscript ℋ
                            %mo *
                        %mtd
                          %mover
                            %mo ⟶
                            %mrow
                              %msub
                                %mi meas
                                %mi W
                        %mtd
                          %mi.mathscript ℋ
                          %mo ⊗
                          %msup
                            %mi.mathscript ℋ
                            %mo *
                      %mtr
                        %mtd
                          %mi ρ
                        %mtd
                          %mo ↦
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mpadded{:lspace => "-50%width", :width => "0"}
                            %mrow
                              %munder
                                %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                                %mi w
                              %mspace{:width => "thinmathspace"}
                              %msub
                                %mi P
                                %mi w
                              %mo ⋅
                              %mi ρ
                              %mo ⋅
                              %msub
                                %mi P
                                %mi w
                              %mpadded{:width => "0"}
                                %mrow
                                  %mspace{:width => "thinmathspace"}
                                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\mathscr{H}
                  \\otimes
                  \\mathscr{H}^\ast
                  \&amp;\overset{meas_W}{\longrightarrow}&amp;
                  \\mathscr{H}
                  \\otimes
                  \\mathscr{H}^\ast
                  \\\
                  \\rho
                  \&amp;\mapsto&amp;
                  \\;\;\;\;\;
                  \\mathclap{
                  \\underset{w}{\sum}
                  \\,
                  P_w \cdot \rho \cdot P_w
                  \\mathrlap{\,.}
                  }
                  }
          %p
            This is a quantum channel, and quantum channels of this form are called
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/quantum+measurement+channels"} quantum measurement channels
          %div
            %h3#environmental_representation_of_measurement_channels Environmental representation of measurement channels
            %p
              By the general theorem about
              %a{:href => "quantum+channel#QuantumChannelsAndDecoherence"} environmental representations
              of quantum channels, every
              %a.existingWikiWord{:href => "/nlab/show/quantum+channel"} quantum channel
              on a
              %a.existingWikiWord{:href => "/nlab/show/quantum+system"} quantum system
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi.mathscript ℋ
                  %annotation{:encoding => "application/x-tex"} \mathscr{H}
              may be decomposed as
            %ol
              %li
                %p
                  coupling of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi.mathscript ℋ
                      %annotation{:encoding => "application/x-tex"} \mathscr{H}
                  to an environment/bath system
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi.mathscript ℬ
                        %annotation{:encoding => "application/x-tex"} \mathscr{B}
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/unitary+quantum+channel"} unitary evolution
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/composite+system"} composite system
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi.mathscript ℋ
                          %mo ⊗
                          %mi.mathscript ℬ
                        %annotation{:encoding => "application/x-tex"} \mathscr{H} \otimes \mathscr{B}
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/averaging+quantum+channel"} averaging
                  the result over the environment states.
            %p
              The way this works specifically for
              %a.existingWikiWord{:href => "/nlab/show/quantum+measurement+channels"} quantum measurement channels
              has precursor discussion
              %a{:href => "quantum+measurement#vonNeumann32"} von Neumann 1932 §VI.3
              and received much attention in discussion of
              %em
                %a.existingWikiWord{:href => "/nlab/show/quantum+decoherence"} quantum decoherence
              following
              %a{:href => "quantum+decoherence#Zurek81"} Zurek 1981
              and
              %a{:href => "quantum+decoherence#JoosZeh85"} Joos &amp; Zeh 1985
              (independently and apparently unkowingly of the general discussion of
              %a{:href => "quantum+channel#QuantumChannelsAndDecoherence"} environmental representations
              in
              = succeed ")." do
                %a{:href => "quantum+channel#Lindblad75"} Lindblad 1975
            %p Concretely,
            %blockquote
              %p
                (we shall restrict attention to
                %a.existingWikiWord{:href => "/nlab/show/finite-dimensional+Hilbert+spaces"} finite-dimensional Hilbert spaces
                not to get distracted by technicalities that are irrelevant to the point we are after)
            %p
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo |
                      %msub
                        %mi b
                        %mi{:mathvariant => "normal"} ini
                      %mo ⟩
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mi.mathscript ℬ
                  %annotation{:encoding => "application/x-tex"} \left\vert b_{\mathrm{ini}} \right\rangle \,\colon\, \mathscr{B}
              (we use
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/bra-ket+notation"} bra-ket notation
              %a.existingWikiWord{:href => "/nlab/show/quantum+system"} quantum system
              then any notion of this device measuring the given
              %a.existingWikiWord{:href => "/nlab/show/quantum+system"} quantum system
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi.mathscript ℋ
                  %annotation{:encoding => "application/x-tex"} \mathscr{H}
              (in its measurement basis
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi.mathscript ℋ
                      %mo ≃
                      %munder
                        %mo ⊕
                        %mi W
                      %mi ℂ
                    %annotation{:encoding => "application/x-tex"} \mathscr{H} \simeq \underset{W}{\oplus}\mathbb{C}
              %a.existingWikiWord{:href => "/nlab/show/unitary+quantum+channel"} unitary quantum evolution
              should be reflected in a
              %a.existingWikiWord{:href => "/nlab/show/unitary+operator"} unitary operator
              under
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                  %annotation{:encoding => "application/x-tex"} [
              = succeed "," do
                %a{:href => "quantum+decoherence#Zurek81"} Zurek 1981 (1.1)
              = succeed "," do
                %a{:href => "quantum+decoherence#JoosZeh85"} Joos &amp; Zeh 1985 (1.1.)
              = succeed "," do
                %a{:href => "quantum+measurement#vonNeumann32"} von Neumann 1932 §VI.3
              %a{:href => "quantum+decoherence#Schlosshauer07"} Schlosshauer 2007 (2.51)
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} ]
            %ol
              %li
                %p
                  the system
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi.mathscript ℋ
                      %annotation{:encoding => "application/x-tex"} \mathscr{H}
                  remains invariant
                  %em if
                  it is purely in any eigenstate
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo |
                          %mi w
                          %mo ⟩
                      %annotation{:encoding => "application/x-tex"} \left\vert w \right\rangle
                  of the measurement basis,
              %li
                %p
                  while in this case the measuring system evolves to a corresponding “pointer state”
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mrow
                            %mo |
                            %msub
                              %mi b
                              %mi w
                            %mo ⟩
                        %annotation{:encoding => "application/x-tex"} \left\vert b_w \right\rangle
            #eq:UnitaryMeasurementProcess.maruku-equation
              %span.maruku-eq-number (7)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                            %mpadded{:lspace => "-50%width", :width => "0"}
                              %mstyle{:mathcolor => "green"}
                                %mrow
                                  %mtable
                                    %mtr
                                      %mtd
                                        %mtext unitary
                                    %mtr
                                      %mtd
                                        %mtext measurement interaction
                          %mtd
                        %mtr
                          %mtd
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %msub
                                  %mi U
                                  %mi W
                                %mspace{:width => "thickmathspace"}
                                %mo{:lspace => "verythinmathspace"} :
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                            %mi.mathscript ℋ
                            %mo ⊗
                            %mi.mathscript ℬ
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi.mathscript ℋ
                            %mo ⊗
                            %mi.mathscript ℬ
                        %mtr
                          %mtd
                            %mrow
                              %mo |
                              %mi w
                              %mo ,
                              %msub
                                %mi b
                                %mi ini
                              %mo ⟩
                          %mtd
                            %mo ↦
                          %mtd
                            %mrow
                              %mo |
                              %mi w
                              %mo ,
                              %msub
                                %mi b
                                %mi w
                              %mo ⟩
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;\mathclap{
                    \\color{green}
                    \\array{
                    \\text{unitary}
                    \\\
                    \\text{measurement interaction}
                    }
                    }&amp;
                    \\\
                    \\mathllap{
                    U_W
                    \\;\colon\;\;
                    }
                    \\mathscr{H} \otimes \mathscr{B}
                    \&amp;\longrightarrow&amp;
                    \\mathscr{H} \otimes \mathscr{B}
                    \\\
                    \\left\vert w, b_{ini} \right\rangle
                    \&amp;\mapsto&amp;
                    \\left\vert w, b_w \right\rangle
                    }
            %p
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi b
                      %mi{:mathvariant => "normal"} ini
                  %annotation{:encoding => "application/x-tex"} b_{\mathrm{ini}}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi b
                      %mi w
                  %annotation{:encoding => "application/x-tex"} b_w
              distinct elements of an (in practice: approximately-)
              %a.existingWikiWord{:href => "/nlab/show/orthonormal+basis"} orthonormal basis
              for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi.mathscript ℬ
                    %annotation{:encoding => "application/x-tex"} \mathscr{B}
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:UnitaryMeasurementProcess"} (7)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo |
                      %mi w
                      %mo ,
                      %msub
                        %mi b
                        %mi w
                      %mo ⟩
                    %mo ↦
                    %mrow
                      %mo |
                      %mi w
                      %mo ,
                      %msub
                        %mi b
                        %mi{:mathvariant => "normal"} ini
                      %mo ⟩
                  %annotation{:encoding => "application/x-tex"} \left\vert w, b_{w}\right\rangle \mapsto \left\vert w, b_{\mathrm{ini}}\right\rangle
              and is the
              %a.existingWikiWord{:href => "/nlab/show/identity+map"} identity
              on all remaining basis elements.)
            %p
              But then the composition of the corresponding
              %a.existingWikiWord{:href => "/nlab/show/unitary+quantum+channel"} unitary quantum channel
              with the
              %a.existingWikiWord{:href => "/nlab/show/averaging+quantum+channel"} averaging channel
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi.mathscript ℬ
                  %annotation{:encoding => "application/x-tex"} \mathscr{B}
              is indeed equal to the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
              %a.existingWikiWord{:href => "/nlab/show/measurement+quantum+channel"} measurement quantum channel
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi.mathscript ℋ
                  %annotation{:encoding => "application/x-tex"} \mathscr{H}
              (cf. eg.
              = succeed "," do
                %a{:href => "quantum+decoherence#Schlosshauer07"} Schlosshauer 2007 (2.117)
              = succeed ")," do
                %a{:href => "quantum+decoherence#Zeh70"} Zeh 1970 (7)
            %div{:style => "margin: -20px 0px 20px 10px"}
              %img{:src => "/nlab/files/EnvRepOfQuantumMeasurementChannel-230924b.jpg", :width => "940px"}/
          %h3#noise_channels Noise channels
          %p
            Examples of
            %a.existingWikiWord{:href => "/nlab/show/quantum+noise"} quantum noise
            channels:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/bit+flip+channel"} bit flip channel
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/extremal+quantum+channel"} extremal quantum channel
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/quantum+information+theory+via+dagger-compact+categories"} quantum information theory via dagger-compact categories
          %div
            %p
              %strong
                %a.existingWikiWord{:href => "/nlab/show/quantum+probability+theory"} quantum probability theory
                –
                %a.existingWikiWord{:href => "/nlab/show/observables"} observables
                and
                %a.existingWikiWord{:href => "/nlab/show/states"} states
            %ul
              %li
                %p
                  %strong
                    %a.existingWikiWord{:href => "/nlab/show/states"} states
                %ul
                  %li
                    %p
                      %a.existingWikiWord{:href => "/nlab/show/classical+state"} classical state
                  %li
                    %p
                      %a.existingWikiWord{:href => "/nlab/show/quantum+state"} quantum state
                    %ul
                      %li
                        %p
                          %a.existingWikiWord{:href => "/nlab/show/space+of+states+%28in+geometric+quantization%29"} space of states (in geometric quantization)
                      %li
                        %p
