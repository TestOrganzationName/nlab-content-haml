              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %msup
                              %mi trace
                              %mi.mathscript ℬ
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                            %mi U
