                %li
                  %p
                    on a
                    %a.existingWikiWord{:href => "/nlab/show/compound+system"} compound system
                    with some
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi.mathscript ℬ
