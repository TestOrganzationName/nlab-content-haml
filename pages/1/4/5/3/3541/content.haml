                  \\,\equiv\,
                  \\underset{w \colon W}{\oplus} \mathscr{H}_w
          %p
            a
            %a.existingWikiWord{:href => "/nlab/show/Hilbert+space"} Hilbert space
            exhibited as the
            %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
            of subspaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi.mathscript ℋ
                    %mi w
                %annotation{:encoding => "application/x-tex"} \mathscr{H}_w
            %a.existingWikiWord{:href => "/nlab/show/indexed+set"} indexed
            by a
            %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite set
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mi FinSet
                  %annotation{:encoding => "application/x-tex"} W \,\colon\, FinSet
