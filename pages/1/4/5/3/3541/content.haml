                  %mi U
                  %mo ⋅
                  %mi ρ
                  %mo ⋅
                  %msup
                    %mi U
                    %mo †
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  ch(\rho) \;=\; U \cdot \rho \cdot U^\dagger
                  \\,.
          %h3#mixed_unitary_quantum_channels Mixed unitary quantum channels
          %p
            More generally, a
            %em
              %a.existingWikiWord{:href => "/nlab/show/mixed+unitary+quantum+channel"} mixed unitary quantum channel
            is given by an
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %a.existingWikiWord{:href => "/nlab/show/indexed+set"} indexed set
            of
            %a.existingWikiWord{:href => "/nlab/show/unitary+operators"} unitary operators
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
