          %h3#in_simplicial_type_theory In simplicial type theory
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+type+theory"} simplicial type theory
            %strong precategory
            is a
            %a.existingWikiWord{:href => "/nlab/show/Segal+type"} Segal type
            in which all
            %a.existingWikiWord{:href => "/nlab/show/hom-types"} hom-types
            are
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/sets"} sets
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} isPrecat
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ≔
