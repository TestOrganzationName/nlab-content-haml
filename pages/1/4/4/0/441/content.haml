                              %mn 0
                            %mtd
                            %mtd
                              %mo →
                            %mtd
                            %mtd
                              %mn 2
                      %mo }
                  %annotation{:encoding => "application/x-tex"}
                    \\Delta^2 =
                    \\left\{
                    \\array{
                    \&amp;&amp; 1
                    \\\
                    \&amp; \nearrow &amp;\Downarrow&amp; \searrow
                    \\\
                    0 &amp;&amp;\to&amp;&amp; 2
                    }
                    \\right\}
            %p
              with
              %a.existingWikiWord{:href => "/nlab/show/boundary+of+a+simplex"} boundary
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
