          %h2#lifting_against_horn_inclusion Lifting against horn inclusion
          %p
          #KanFibration.num_defn
            %h6 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"}> Kan fibration
                )
              %br/
              A
              %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"} Kan fibration
              is a
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              of
              %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
              which has the
              %a.existingWikiWord{:href => "/nlab/show/right+lifting+property"} right lifting property
              with respect to all horn inclusions
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Λ
                        %mi k
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo ↪
                      %msup
                        %mi Δ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \Lambda^k[n] \hookrightarrow \Delta^n
            %p
          %p
          #KanComplex.num_defn
            %h6 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Kan+complex"}> Kan complex
                )
              %br/
              A
              %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
              is a simplicial set in which “
              %em> all horns have fillers
              ”: a simplicial set for which the morphism to the point is a Kan fibration (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#KanFibration"}
          %p
          #QuasiCategory.num_defn
            %h6 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/quasi-category"}> quasi-category
                )
              %br/
              A
              %a.existingWikiWord{:href => "/nlab/show/quasi-category"} quasi-category
              is a
              %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
              in which
              = succeed "," do
                %em
                  all
                  %a{:href => "#InnerHorns"} inner horns
                  have fillers
              %a.existingWikiWord{:href => "/nlab/show/point"} point
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/inner+fibration"} inner fibration
          %h2#related_concepts Related concepts
          %ul
