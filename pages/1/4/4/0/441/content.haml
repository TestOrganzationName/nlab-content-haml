                    }
                    \\right\}
                    \\,.
            %p The two outer horns look like
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Λ
                      %mn 0
                      %mn 2
                    %mo =
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mn 1
                          %mtr
                            %mtd
                            %mtd
                              %mo ↗
                            %mtd
                            %mtd
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                            %mtd
                              %mo →
                            %mtd
                            %mtd
                              %mn 2
                      %mo }
                  %annotation{:encoding => "application/x-tex"}
                    \\Lambda^2_0 =
                    \\left\{
                    \\array{
                    \&amp;&amp; 1
                    \\\
                    \&amp; \nearrow &amp;&amp;
                    \\\
                    0 &amp;&amp;\to&amp;&amp; 2
                    }
                    \\right\}
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Λ
                      %mn 2
