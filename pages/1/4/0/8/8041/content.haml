                  %mo{:stretchy => "false"} (
                  %mi a
                  %msub
                    %mo =
                    %mi A
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo =
                    %mi B
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo =
                    %mi B
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
