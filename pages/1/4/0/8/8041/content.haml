          %h2#definition Definition
          %h3#in_set_theory In set theory
          %p
            Given
            %a.existingWikiWord{:href => "/nlab/show/sets"} sets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            and a
            %a.existingWikiWord{:href => "/nlab/show/function"} function
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f\colon A \to B
            %strong inverse function
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            (if it exists) is the function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:lspace => "verythinmathspace"} :
                  %mi B
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} f^{-1}\colon B \to A
            such that both
            %a.existingWikiWord{:href => "/nlab/show/composition"} composite functions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ∘
                  %msup
                    %mi f
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} f \circ f^{-1}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo ∘
                  %mi f
                %annotation{:encoding => "application/x-tex"} f^{-1} \circ f
            are
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/identity+functions"} identity functions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            has an inverse function if and only if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
          %p
            Inverse functions are
            %a.existingWikiWord{:href => "/nlab/show/inverse+morphisms"} inverse morphisms
            in the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            of sets.
          %p
            More generally, in any
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/concrete+category"} concrete category
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            is given by the inverse of the corresponding function between
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/underlying+sets"} underlying sets
          %h3#in_type_theory In type theory
          %p
