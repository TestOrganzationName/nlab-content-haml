          %p
          #ReflectorPreservesFiniteProductsOnFreeCoproductCompletion.num_lemma
            %h6 Lemma
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/free+coproduct+completions"} free coproduct completions
              of the
              = succeed "-categories" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (2,1)
              %a.maruku-eqref{:href => "#eq:TheAbstractAdjunctionOfSites"} (4)
              have
              %a.existingWikiWord{:href => "/nlab/show/finite+products"} finite products
              and the unique coproduct-preserving extension of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \tau_0
              to these preserves finite products.
          .proof
            %h6 Proof
            %p
              The category on the right is equivalently the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/orbit+category"} orbit category
              (by Lem.
              = succeed ")" do
                %a.maruku-ref{:href => "#GOrbitsAs0TruncatedObjectsInSliceOverGOrbiSingularity"}
              %a.existingWikiWord{:href => "/nlab/show/free+coproduct+completion"} free coproduct completion
              is (using here our assumption that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              is a
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete group
              %a.existingWikiWord{:href => "/nlab/show/G-set"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                \-sets
              (as in
              = succeed ")." do
                %a{:href => "orbit+category#GActionsAndGOrbits"} this remark
            %p
              Similarly, the free coproduct completion of the category on the left is readily seen to be that of all 1-truncated in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                      %msub
                        %mi Grpd
                        %mrow
                          %mo{:stretchy => "false"} /
                          %mi B
                          %mi G
                    %annotation{:encoding => "application/x-tex"} \infty Grpd_{/B G}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \tau_0
              to these is just the 0-truncation functor in this slice
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-topos"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
                \-topos
              and as such preserves finite products (by
              = succeed "," do
                %a{:href => "n-truncated+object+of+an+infinity1-category#nTruncationInToposPreservesFiniteProducts"} this Prop.
              = succeed ")." do
                %a{:href => "adjoint+quadruple#nTruncationsOfFullSubcategoriesOfInfinityToposes"} this Exp.
          %p In conclusion:
          %p
          #GOrbitsAreReflectiveInSliceOverGOrbiSingularity.num_prop
            %h6 Proposition
            %p
              %strong
                (
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                \-orbits are reflective in slice over
                = succeed "-orbi-singularity)" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
              %br/
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
