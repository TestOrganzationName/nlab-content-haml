          #ProofOfTheCohesiveAdjointQuadruple.proof
            %h6 Proof
            %p
              The general fact that
              %a.existingWikiWord{:href => "/nlab/show/slice+of+presheaves+is+presheaves+on+slice"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
                \-slices of
                = succeed "-presheaves" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
                = succeed "-presheaves" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
                = succeed "-slice" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
              (by
              %a{:href => "slice+of+presheaves+is+presheaves+on+slice#EquivalenceOfInfinityCategories"} this Prop.
              or
              = succeed ")" do
                %a{:href => "slice+infinity1-topos#SheavesOnBigSite"} this Prop.
              %a.existingWikiWord{:href => "/nlab/show/fixed+loci"} fixed loci
              is an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28infinity%2C1%29-categories"} equivalence of (infinity,1)-categories
              as follows:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Glo
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mo ≺
                        %mi G
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi PSh
                      %mn ∞
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi Sngrlt
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mo ≺
                        %mi G
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi PSh
                      %mn ∞
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi Sngrlt
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mo ≺
                        %mi G
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (Glo \mathbf{H})_{/\prec G}
                    \\;\coloneqq\;
                    PSh_\infty
                    \\big(
                    Sngrlt
                    ,\,
                    \\mathbf{H}
                    \\big)_{/\prec G}
                    \\;\;
                    \\simeq
                    \\;\;
                    PSh_\infty
                    \\big(
                    Sngrlt_{/\prec G}
                    ,\,
                    \\mathbf{H}
                    \\big)
                    \\,.
            %p
              With this, the statement follows – via
              %a{:href => "adjoint+quadruple#KanExtensionOfFiniteProductPreservingReflectionIsCohesiveAdjointQuadruple"} this Prop.
              – by
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-Kan+extension"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
                \-Kan extension
              of the adjoint pair from Prop.
              = succeed "." do
                %a.maruku-ref{:href => "#GOrbitsAreReflectiveInSliceOverGOrbiSingularity"}
          %h2#related_concepts Related concepts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/singular+cohesion"} singular cohesion
          %h2#references References
          %p The observation is due to:
          %ul
            %li#Rezk14
              %a.existingWikiWord{:href => "/nlab/show/Charles+Rezk"}> Charles Rezk
              ,
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Global+Homotopy+Theory+and+Cohesion"} Global Homotopy Theory and Cohesion
              = succeed "," do
                %a{:href => "http://www.math.uiuc.edu/~rezk/global-cohesion.pdf"} pdf
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/files/Rezk14.pdf", :title => "pdf"} pdf
          %p
            where further properties of this cohesive situation are proven, revolving around further characterization of the full inclusion of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/orbispaces"} orbispaces
          %p
            Some of the above notation (e.g. for “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mo ≺
                  %mspace{:width => "negativethinmathspace"}
                  %mspace{:width => "negativethinmathspace"}
                  %mi G
                %annotation{:encoding => "application/x-tex"} \prec\!\! G
            ”) follows:
          %ul
            %li#SatiSchreiber20
              %a.existingWikiWord{:href => "/nlab/show/Hisham+Sati"}> Hisham Sati
              ,
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/schreiber/show/Proper+Orbifold+Cohomology"} Proper Orbifold Cohomology
              = succeed "&rbrack;" do
                %a{:href => "https://arxiv.org/abs/2008.01101"} arXiv:2008.01101
          %p
            which expands on application of the above singular cohesion – in the special case of
            %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/smooth+infinity-groupoid"} smooth cohesion
            – to differential-geometric
            %a.existingWikiWord{:href => "/nlab/show/orbifolds"} orbifolds
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/orbifold+cohomology"} orbifold cohomology
          %p Diagrams and discussion as presented above are taken from:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Hisham+Sati"}> Hisham Sati
              ,
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/schreiber/show/Equivariant+principal+infinity-bundles"}
                    Equivariant principal
                    = succeed "-bundles" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mn ∞
                          %annotation{:encoding => "application/x-tex"} \infty
              = succeed "&rbrack;" do
                %a{:href => "https://arxiv.org/abs/2112.13654"} arXiv:2112.13654
