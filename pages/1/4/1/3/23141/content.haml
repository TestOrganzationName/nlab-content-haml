                    Grpd^{fin}_{1, \geq 1}
                    \&amp;\xhookrightarrow{\;}&amp;
                    Grp_\infty
                    \\\
                    \\prec\!\!G
                    \&amp;\mapsto&amp;
                    B G
                    }
