            %p
          .proof
            %h6 Proof
            %p
              By the immediate combination of Lem.
              %a.maruku-ref{:href => "#TruncatedObjectsInSliceOverGOrbiSingularity"}
              with Lem.
              %a.maruku-ref{:href => "#GOrbitsAs0TruncatedObjectsInSliceOverGOrbiSingularity"}
              and Lem.
              = succeed "." do
                %a.maruku-ref{:href => "#ReflectorPreservesFiniteProductsOnFreeCoproductCompletion"}
          %h3#TheCohesionOfHomotopyTheories The adjoint quadruple between homotopy theories
          %p
          #SliceOfGlobalHOverGOrbiSingularityIsCohesiveOverGH.num_prop
            %h6 Proposition
            %p
              %strong
                (slice of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Glo
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Glo(\mathbf{H})
                over
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ≺
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \prec\!\!G
                is cohesive over
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                      %annotation{:encoding => "application/x-tex"} G\mathbf{H}
              %br/
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              any
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-topos"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
                \-topos
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mspace{:width => "thinmathspace"}
                      %mo ∈
                      %mspace{:width => "thinmathspace"}
                      %mi Grp
                      %mo{:stretchy => "false"} (
                      %mi FinSet
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} G \,\in\, Grp(FinSet)
              %a.existingWikiWord{:href => "/nlab/show/slice+%28infinity%2C1%29-category"} slice
              of the
              %a.existingWikiWord{:href => "/nlab/show/global+equivariant+homotopy+theory"} global equivariant homotopy theory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Glo
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Glo(\mathbf{H})
              %a.maruku-eqref{:href => "#eq:GlobalEquivariantInfinityTopos"} (2)
              over the
              = succeed "-orbi-singularity" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≺
                    %mspace{:width => "negativethinmathspace"}
                    %mspace{:width => "negativethinmathspace"}
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \prec\!\!G
              %a.maruku-eqref{:href => "#eq:TheCategoryOfOrbiSingularities"} (1)
              is
              %a.existingWikiWord{:href => "/nlab/show/cohesive+%28infinity%2C1%29-topos"} cohesive
              %a.existingWikiWord{:href => "/nlab/show/base+%28infinity%2C1%29-topos"} over
              the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/equivariant+homotopy+theory"} equivariant homotopy theory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} G\mathbf{H}
              %a.maruku-eqref{:href => "#eq:GEquivariantInfinityTopos"} (3)
              in that there exists an
