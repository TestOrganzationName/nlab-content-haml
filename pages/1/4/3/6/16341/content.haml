          %h2#idea Idea
          %p
            Generalizing the classical notion of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
            %em monoid
            (or
            = succeed ")" do
              %em monoid object
            %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mo ⊗
                    %mo ,
                    %mi I
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (C,\otimes,I)
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            with the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cartesian+product"} cartesian product
          %p
            By the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/microcosm+principle"} microcosm principle
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            itself must be a “categorified monoid” in some way. The natural requirement is that it be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/multicategory"} multicategory
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/group+object"} group object
            %a.existingWikiWord{:href => "/nlab/show/cartesian+monoidal+category"} cartesian monoidal category
            (or a
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/cartesian+multicategory"} cartesian multicategory
          %h2#definition Definition
          %p
            Namely, a
            %strong
              monoid in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            is an object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            equipped with a multiplication
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                  %mo :
                  %mi M
                  %mo ⊗
                  %mi M
                  %mo →
                  %mi M
                %annotation{:encoding => "application/x-tex"} \mu: M \otimes M \to M
            and a unit
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                  %mo :
                  %mi I
                  %mo →
                  %mi M
                %annotation{:encoding => "application/x-tex"} \eta: I \to M
            satisfying the
            = succeed ":" do
              %strong associative law
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
