                        %mtd
                          %mi M
                          %mo ⊗
                          %mo{:stretchy => "false"} (
                          %mi M
                          %mo ⊗
                          %mi M
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo ⟶
                            %mrow
                              %mn 1
                              %mo ⊗
                              %mi μ
                        %mtd
                          %mi M
                          %mo ⊗
                          %mi M
                      %mtr
