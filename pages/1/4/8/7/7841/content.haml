                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi W
                        %mrow
                          %msup
                            %mi p
                            %mn ∞
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi 𝔽
                        %mrow
                          %msup
                            %mi p
                            %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} W_{p^\infty}(\mathbb{F}_{p^n})
                is the unique
                %a.existingWikiWord{:href => "/nlab/show/unramified+extension"} unramified extension
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℤ
                        %mi p
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}_p
                of degree
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
          %h3#lubintate_ring Lubin-Tate ring
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/Lubin-Tate+ring"} Lubin-Tate ring
            in
            %a.existingWikiWord{:href => "/nlab/show/Lubin-Tate+theory"} Lubin-Tate theory
            is a
            %a.existingWikiWord{:href => "/nlab/show/power+series"} power series
            ring over a
            %a.existingWikiWord{:href => "/nlab/show/Witt+ring"} Witt ring
            and this way Witt rings govern much of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/chromatic+homotopy+theory"} chromatic homotopy theory
          %p
            As an Abelian group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} W(A)
            is isomorphic to the group of curves in the one-dimensional
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/multiplicative+group"} multiplicative formal group
            = succeed ")" do
              %a{:href => "#eom"} eom
