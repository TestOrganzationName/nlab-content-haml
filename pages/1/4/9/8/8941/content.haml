          %title YetterDrinfeld modules
          %h1#yetterdrinfeld_modules Yetter–Drinfeld modules
          .maruku_toc
            %ul
              %li
                %a{:href => "#definition"} Definition
              %ul
                %li
                  %a{:href => "#compatibility_for_leftright_yd_modules"} Compatibility for left-right YD Modules
                %li
                  %a{:href => "#compatibility_for_leftleft_yd_modules"} Compatibility for left-left YD Modules
                %li
                  %a{:href => "#compatibility_for_rightleft_yd_modules"} Compatibility for right-left YD Modules
                %li
                  %a{:href => "#compatibility_for_rightright_yd_modules"} Compatibility for right-right YD Modules
              %li
                %a{:href => "#the_category_of_yetterdrinfeld_modules"} The category of Yetter–Drinfeld modules
              %li
                %a{:href => "#yetterdrinfeld_module_algebras"} Yetter-Drinfeld module algebras
              %li
                %a{:href => "#anti_yetterdrinfeld_modules"} Anti Yetter–Drinfeld modules
              %li
                %a{:href => "#nichols_algebras"} Nichols algebras
              %li
                %a{:href => "#literature"} Literature
              %ul
                %li
                  %a{:href => "#yd_modules_over_hopfbialgebras"} YD modules over Hopf/bi-algebras
                %li
                  %a{:href => "#yd_modules_over_hopfbialgebroids"} YD modules over Hopf/bi-algebroids
          %h2#definition Definition
          %p
            A
            %strong Yetter–Drinfeld module
            over a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %a.existingWikiWord{:href => "/nlab/show/bialgebra"} bialgebra
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ,
                    %mi Δ
                    %mo ,
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B=(B,\Delta,\epsilon)
            %a.existingWikiWord{:href => "/nlab/show/Sweedler+notation"} Sweedler notation
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %msub
                      %mi b
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo ⊗
                    %msub
                      %mi b
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Delta(b) = \sum b_{(1)}\otimes b_{(2)}
            = succeed "-module" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "-module" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            %a.existingWikiWord{:href => "/nlab/show/comodule"} comodule
            with certain compatibility – also called Yetter-Drinfeld condition – between the
            = succeed "-action" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            = succeed "-coaction." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
          .un_defn
            %h6#compatibility_for_leftright_yd_modules Compatibility for left-right YD Modules
            %p
              The compatibility for a left
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mo ⊗
                      %mi M
                      %mo →
                      %mi M
                    %annotation{:encoding => "application/x-tex"} B\otimes M\to M
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo ⊗
                      %mi m
                      %mo ↦
                      %mi b
                      %mo ▸
                      %mi m
                    %annotation{:encoding => "application/x-tex"} b\otimes m\mapsto b\blacktriangleright m
              = succeed "-comodule" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                      %mo :
                      %mi M
                      %mo →
                      %mi M
                      %mo ⊗
                      %mi B
                    %annotation{:encoding => "application/x-tex"} \rho:M\to M\otimes B
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                      %mo{:stretchy => "false"} (
                      %mi m
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %msub
                        %mi m
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mn 0
                          %mo{:stretchy => "false"} ]
                      %mo ⊗
                      %msub
                        %mi m
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mn 1
                          %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \rho(m) = \sum m_{[0]}\otimes m_{[1]}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi b
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo ▸
                    %msub
                      %mi m
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %msub
                      %mi b
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi m
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                    %mo =
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi b
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo{:stretchy => "false"} )
                    %mo ▸
                    %mi m
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo{:stretchy => "false"} ]
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi b
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo{:stretchy => "false"} )
                    %mo ▸
                    %mi m
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                    %msub
                      %mi b
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\sum (b_{(1)}\blacktriangleright m_{[0]})\otimes b_{(2)} m_{[1]}
                    \= \sum (b_{(2)}\blacktriangleright m)_{[0]}
                    \\otimes (b_{(2)}\blacktriangleright m)_{[1]} b_{(1)}
            %p
              or equivalently, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              is a Hopf algebra with invertible antipode
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              (or instead just with the
              %a.existingWikiWord{:href => "/nlab/show/skew-antipode"} skew-antipode
              denoted
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} S^{-1}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi b
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo{:stretchy => "false"} )
                    %mo ▸
                    %msub
                      %mi m
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %msub
                      %mi b
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 3
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi m
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                    %msup
                      %mi S
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi b
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo ▸
                    %mi m
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo{:stretchy => "false"} ]
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo ▸
                    %mi m
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\sum (b_{(2)}\blacktriangleright m_{[0]})\otimes b_{(3)} m_{[1]} S^{-1}(b_{(1)})
                    \= \sum (b\blacktriangleright m)_{[0]}
                    \\otimes (b\blacktriangleright m)_{[1]}
          .un_defn
            %h6#compatibility_for_leftleft_yd_modules Compatibility for left-left YD Modules
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi b
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi m
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                        %mo{:stretchy => "false"} ]
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi b
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo{:stretchy => "false"} )
                    %mo ▸
                    %msub
                      %mi m
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi b
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo ▸
                    %mi m
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                        %mo{:stretchy => "false"} ]
                    %msub
                      %mi b
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi b
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo ▸
                    %mi m
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    b_{(1)} m_{[-1]}\otimes (b_{(2)}\blacktriangleright m_{[0]})
                    \=
                    (b_{(1)}\blacktriangleright m)_{[-1]} b_{(2)}  \otimes
                    (b_{(1)}\blacktriangleright m)_{[0]}
          .un_defn
            %h6#compatibility_for_rightleft_yd_modules Compatibility for right-left YD Modules
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi m
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                        %mo{:stretchy => "false"} ]
                    %msub
                      %mi b
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi m
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo{:stretchy => "false"} ]
                    %mo ◂
                    %msub
                      %mi b
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi b
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi m
                    %mo ◂
                    %msub
                      %mi b
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                        %mo{:stretchy => "false"} ]
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %mi m
                    %mo ◂
                    %msub
                      %mi b
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    m_{[-1]}b_{(1)}\otimes (m_{[0]}\blacktriangleleft b_{(2)})
                    \=
                    b_{(2)} (m\blacktriangleleft b_{(1)})_{[-1]}  \otimes (m\blacktriangleleft b_{(1)})_{[0]}
          .un_defn
            %h6#compatibility_for_rightright_yd_modules Compatibility for right-right YD Modules
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi m
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo{:stretchy => "false"} ]
                    %mo ◂
                    %msub
                      %mi b
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo ⊗
                    %msub
                      %mi m
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                    %msub
                      %mi b
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi m
                    %mo ◂
                    %msub
                      %mi b
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo{:stretchy => "false"} ]
                    %mo ⊗
                    %msub
                      %mi b
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi m
                    %mo ◂
                    %msub
                      %mi b
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    m_{[0]}\blacktriangleleft b_{(1)}\otimes m_{[1]} b_{(2)}
                    \=
                    (m\blacktriangleleft b_{(2)})_{[0]}\otimes
                    b_{(1)} (m\blacktriangleleft b_{(2)})_{[1]}
          %h2#the_category_of_yetterdrinfeld_modules The category of Yetter–Drinfeld modules
          %p
            Morphisms of YD
            = succeed "-modules" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            = succeed "-modules" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            = succeed "-comodules." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            %em category of left-right YD modules
            over a bialgebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            is denoted by
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                      %mi B
                    %msup
                      %mi 𝒴𝒟
                      %mi B
                  %annotation{:encoding => "application/x-tex"} {}_B \mathcal{Y D}^B
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mrow
                    %mi B
                  %msup
                    %mi 𝒴𝒟
                    %mi B
                %annotation{:encoding => "application/x-tex"} {}_B \mathcal{Y D}^B
            is a monoidal category: if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                %annotation{:encoding => "application/x-tex"} W
            are left-right YD modules,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo ⊗
                  %mi W
                %annotation{:encoding => "application/x-tex"} V\otimes W
            is the tensor product of underlying vector spaces equipped with left
            = succeed "-action" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                  %mo ▸
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo ⊗
                  %mi w
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi b
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo ▸
                  %mi v
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi b
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                  %mo ▸
                  %mi w
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  b\blacktriangleright (v\otimes w) = (b_{(1)}\blacktriangleright v)\otimes (b_{(2)}\blacktriangleright w)
          %p
            and right
            = succeed "-coaction" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                  %mo ⊗
                  %mi w
                  %mo ↦
                  %msub
                    %mi v
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo{:stretchy => "false"} ]
                  %mo ⊗
                  %msub
                    %mi w
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo{:stretchy => "false"} ]
                  %mo ⊗
                  %msub
                    %mi w
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                  %msub
                    %mi v
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  v\otimes w\mapsto v_{[0]}\otimes w_{[0]}\otimes w_{[1]}v_{[1]}
          %p
            Note the order within the rightmost tensor factor! One checks directly that this tensor product indeed satisfies the Yetter-Drinfeld condition. Radford and Towber prefer slightly different monoidal structure: in above formulas use the opposite product and coopposite coproduct on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
          %p
            Monoidal category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mrow
                    %mi B
                  %msup
                    %mi 𝒴𝒟
                    %mi B
                %annotation{:encoding => "application/x-tex"} {}_B \mathcal{Y D}^B
            is equipped with “pre-braiding” morphisms
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi R
                    %mrow
                      %mi V
                      %mo ,
                      %mi W
                  %mo :
                  %mi V
                  %mo ⊗
                  %mi W
                  %mo →
                  %mi W
                  %mo ⊗
                  %mi V
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mspace{:width => "thinmathspace"}
                  %mspace{:width => "thinmathspace"}
                  %mspace{:width => "thinmathspace"}
                  %mspace{:width => "thinmathspace"}
                  %mspace{:width => "thinmathspace"}
                  %mspace{:width => "thinmathspace"}
                  %mspace{:width => "thinmathspace"}
                  %mi v
                  %mo ⊗
                  %mi w
                  %mo ↦
                  %msub
                    %mi w
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo{:stretchy => "false"} ]
                  %mo ⊗
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi w
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                  %mo ▸
                  %mi v
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  R_{V,W}: V\otimes W\to W\otimes V,\,\,\,\,\,\,\,\,
                  v\otimes w\mapsto w_{[0]} \otimes (w_{[1]}\blacktriangleright v).
          %p
            In Radford-Towber convention the pre-braiding is
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ⊗
                    %mi w
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi v
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                    %mo ▸
                    %mi w
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %msub
                      %mi v
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} v\otimes w\mapsto (v_{[1]}\blacktriangleright w)\otimes v_{[0]}
            %a.existingWikiWord{:href => "/nlab/show/braided+monoidal+category"} braiding
            except for invertibility of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi R
                    %mrow
                      %mi V
                      %mo ,
                      %mi W
                %annotation{:encoding => "application/x-tex"} R_{V,W}
            which is fullfilled for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo ,
                  %mi W
                %annotation{:encoding => "application/x-tex"} V,W
            iff
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            is a Hopf algebra.
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi R
                    %mrow
                      %mi V
                      %mo ,
                      %mi W
                %annotation{:encoding => "application/x-tex"} R_{V,W}
            is always fullfilled if both
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                %annotation{:encoding => "application/x-tex"} W
            are finite dimensional. In particular,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi R
                    %mrow
                      %mi V
                      %mo ,
                      %mi V
                %annotation{:encoding => "application/x-tex"} R_{V,V}
            satisfies the Yang-Baxter equation. If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is a commutative algebra in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mrow
                    %mi B
                  %msup
                    %mi 𝒴𝒟
                    %mi B
                %annotation{:encoding => "application/x-tex"} {}_B\mathcal{Y D}^B
            then the
            %a.existingWikiWord{:href => "/nlab/show/smash+product+algebra"} smash product algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ♯
                  %mi B
                %annotation{:encoding => "application/x-tex"} A\sharp B
            is an associative
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/bialgebroid"} bialgebroid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            along
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ↪
                    %mi A
                  %annotation{:encoding => "application/x-tex"} k\hookrightarrow A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo =
                  %mi H
                %annotation{:encoding => "application/x-tex"} B=H
            is a Hopf algebra with bijective antipode then this bialgebroid is in fact a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Hopf+algebroid"} Hopf algebroid
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo =
                  %mi H
                %annotation{:encoding => "application/x-tex"} B=H
            is a finite-dimensional
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Hopf+algebra"} Hopf algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mrow
                    %mi H
                  %msup
                    %mi 𝒴𝒟
                    %mi H
                %annotation{:encoding => "application/x-tex"} {}_H \mathcal{Y D}^H
            is equivalent to the category of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mrow
                    %mrow
                      %mi D
                      %mo{:stretchy => "false"} (
                      %mi H
                      %mo{:stretchy => "false"} )
                  %mi ℳ
                %annotation{:encoding => "application/x-tex"} {}_{D(H)}\mathcal{M}
            of left
            = succeed "-modules," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D(H)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mi H
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} D(H)
            is the
            %a.existingWikiWord{:href => "/nlab/show/Drinfeld+double"} Drinfeld double
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mrow
                    %mi H
                  %mi ℋ
                %annotation{:encoding => "application/x-tex"} {}_H\mathcal{H}
            of left
            = succeed "-modules." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
          %p
            The commutative algebras in the center of a monoidal category, play role in the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/dynamical+extension+of+a+monoidal+category"} dynamical extension of a monoidal category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mrow
                    %mi H
                  %msup
                    %mi 𝒴𝒟
                    %mi H
                %annotation{:encoding => "application/x-tex"} {}_H\mathcal{Y D}^H
            provide such examples. An important example, is the dual
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mo *
                %annotation{:encoding => "application/x-tex"} H^*
            when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            is finite-dimensional. The smash product algebra is in that case the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Heisenberg+double"} Heisenberg double
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            is a counital 2-cocycle for a bialgebra
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mi F
                %annotation{:encoding => "application/x-tex"} H^F
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            is also a bialgebra and there is a monoidal equivalence
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                      %mi H
                    %mi ℳ
                    %mo ≅
                    %msub
                      %mrow
                      %mrow
                        %msup
                          %mi H
                          %mi F
                    %mi ℳ
                  %annotation{:encoding => "application/x-tex"} {}_H\mathcal{M}\cong {}_{H^F}\mathcal{M}
            %a{:href => "#Škoda-Stojić2023"} Škoda-Stojić2023
            it is shown how this monoidal equivalence lifts to a braided monoidal equivalence between the categories of Yetter-Drinfeld modules
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                      %mi H
                    %msup
                      %mi ℳ
                      %mi H
                    %mo ≅
                    %msub
                      %mrow
                      %mrow
                        %msup
                          %mi H
                          %mi F
                    %msup
                      %mi ℳ
                      %mrow
                        %msup
                          %mi H
                          %mi F
                  %annotation{:encoding => "application/x-tex"} {}_H\mathcal{M}^H\cong {}_{H^F}\mathcal{M}^{H^F}
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Zoran+%C5%A0koda"}> Zoran Škoda
              , Martina Stojić,
              = succeed "," do
                %em Comment on “Twisted bialgebroids versus bialgebroids from Drinfeld twist”
              %a{:href => "https://arxiv.org/abs/2308.05083"} arXiv:2308.05083
          %h2#yetterdrinfeld_module_algebras Yetter-Drinfeld module algebras
          %p
            A
            %strong left-right Yetter-Drinfeld module algebra
            is a monoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi μ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A,\mu)
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                      %mi B
                    %msup
                      %mi 𝒴𝒟
                      %mi B
                  %annotation{:encoding => "application/x-tex"} {}_B\mathcal{Y D}^B
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo :
                    %mi a
                    %mo ⊗
                    %mi c
                    %mo ↦
                    %mi a
                    %mo ⋅
                    %mi c
                  %annotation{:encoding => "application/x-tex"} \mu:a\otimes c\mapsto a\cdot c
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                  %mo :
                  %mi A
                  %mo ⊗
                  %mi A
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} \mu:A\otimes A\to A
            is a morphism in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                      %mi B
                    %msup
                      %mi 𝒴𝒟
                      %mi B
                  %annotation{:encoding => "application/x-tex"} {}_B\mathcal{Y D}^B
          %p
            Requirement that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                %annotation{:encoding => "application/x-tex"} \mu
            is a map of
            = succeed "-modules" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ,
                  %mi c
                  %mo ∈
                  %mi A
                %annotation{:encoding => "application/x-tex"} a,c\in A
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                  %mo ▸
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ⋅
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi b
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo ▸
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo ⋅
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi b
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                  %mo ▸
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  b\blacktriangleright (a\cdot c) = (b_{(1)}\blacktriangleright a)\cdot (b_{(2)}\blacktriangleright c),
          %p
            which, together with compatibility of unit
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ▸
                    %mn 1
                    %mo =
                    %mi ϵ
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} b\blacktriangleright 1 = \epsilon(b) 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is a left
            = succeed "-module" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                %annotation{:encoding => "application/x-tex"} \mu
            is a map of
            = succeed "-comodules" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                  %mo ∘
                  %mi μ
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi μ
                  %mo ⊗
                  %mi id
                  %mo{:stretchy => "false"} )
                  %msub
                    %mi ρ
                    %mrow
                      %mi A
                      %mo ⊗
                      %mi A
                %annotation{:encoding => "application/x-tex"} \rho\circ\mu = (\mu\otimes id)\rho_{A\otimes A}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ⋅
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi μ
                  %mo ⊗
                  %mi id
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi a
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo{:stretchy => "false"} ]
                  %mo ⊗
                  %msub
                    %mi c
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo{:stretchy => "false"} ]
                  %mo ⊗
                  %msub
                    %mi c
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                  %msub
                    %mi a
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi a
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo{:stretchy => "false"} ]
                  %mo ⋅
                  %msub
                    %mi c
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo{:stretchy => "false"} ]
                  %mo ⊗
                  %msub
                    %mi c
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                  %msub
                    %mi a
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\rho(a\cdot c)
                  \= (\mu\otimes id)(a_{[0]}\otimes c_{[0]}\otimes c_{[1]} a_{[1]})
                  \= a_{[0]}\cdot c_{[0]}\otimes c_{[1]} a_{[1]},
          %p
            that is (along with the counit condition),
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is right
            = succeed "-comodule" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi B
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} op
                  %annotation{:encoding => "application/x-tex"} B^\op
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is
            %strong braided-commutative
            if
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                  %mo ∘
                  %msub
                    %mi R
                    %mrow
                      %mi A
                      %mo ,
                      %mi A
                  %mo =
                  %mi μ
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mu\circ R_{A,A} = \mu.
          %p
            In explicit terms, for all
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ,
                    %mi c
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} a,c\in A
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi c
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo{:stretchy => "false"} ]
                  %mo ⋅
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                  %mo ▸
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi a
                  %mo ⋅
                  %mi c
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  c_{[0]}\cdot (c_{[1]}\blacktriangleright a) = a\cdot c.
