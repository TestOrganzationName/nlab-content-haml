        #revision
          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/fibered+category"} fibered category
            = succeed "," do
              %math#mathml_12cffe469aa70af393c3594fc5f85ceeeee1ebf2_1.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mo =
                    %msub
                      %mi π
                      %mi F
                    %mo :
                    %mi F
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} \pi=\pi_F: F\to C
            %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/group"} group
            %math#mathml_12cffe469aa70af393c3594fc5f85ceeeee1ebf2_2.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi G
                    %mo{:stretchy => "false"} ^
                  %mo :
                  %msup
                    %mi C
                    %mi{:mathvariant => "normal"} op
                  %mo →
                  %mi{:mathvariant => "normal"} Grp
                %annotation{:encoding => "application/x-tex"} \hat{G}:C^{\mathrm{op}}\to\mathrm{Grp}
            (possibly
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representable
            %math#mathml_12cffe469aa70af393c3594fc5f85ceeeee1ebf2_3.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            in
            = succeed "," do
              %math#mathml_12cffe469aa70af393c3594fc5f85ceeeee1ebf2_4.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            %math#mathml_12cffe469aa70af393c3594fc5f85ceeeee1ebf2_5.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi ν
                    %mo{:stretchy => "false"} ^
                  %mo :
                  %mover
                    %mi G
                    %mo{:stretchy => "false"} ^
                  %mo ×
                  %msub
                    %mi h
                    %mi X
                  %mo →
                  %msub
                    %mi h
                    %mi X
                %annotation{:encoding => "application/x-tex"} \hat\nu: \hat{G}\times h_X\to h_X
            (generalizing the action
            %math#mathml_12cffe469aa70af393c3594fc5f85ceeeee1ebf2_6.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo ×
                  %mi X
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} G\times X\to X
            in the representable case), one says that the object
            %math#mathml_12cffe469aa70af393c3594fc5f85ceeeee1ebf2_7.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                %annotation{:encoding => "application/x-tex"} \rho
            in the fiber
            %math#mathml_12cffe469aa70af393c3594fc5f85ceeeee1ebf2_8.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mi X
                  %mo =
                  %msup
                    %mi π
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi{:mathvariant => "normal"} id
                    %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F_X = \pi^{-1}(\mathrm{id}_X)
            is
            %strong
              %math#mathml_12cffe469aa70af393c3594fc5f85ceeeee1ebf2_9.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat{G}
              \-equivariant
            if
            %math#mathml_12cffe469aa70af393c3594fc5f85ceeeee1ebf2_10.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi G
                    %mo{:stretchy => "false"} ^
                  %mo ∘
                  %mi π
                %annotation{:encoding => "application/x-tex"} \hat{G}\circ\pi
            is equipped with an action on
            = succeed "," do
              %math#mathml_12cffe469aa70af393c3594fc5f85ceeeee1ebf2_11.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi h
                      %mi ρ
                  %annotation{:encoding => "application/x-tex"} h_\rho
            %math#mathml_12cffe469aa70af393c3594fc5f85ceeeee1ebf2_12.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi G
                    %mo{:stretchy => "false"} ^
                  %mo ∘
                  %mi π
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %msub
                    %mi h
                    %mi ρ
                  %mo :
                  %msup
                    %mi F
                    %mi{:mathvariant => "normal"} op
                  %mo →
                  %mi{:mathvariant => "normal"} Set
                %annotation{:encoding => "application/x-tex"} \sigma:(\hat{G}\circ\pi)\times h_\rho : F^{\mathrm{op}}\to\mathrm{Set}
            such that for any
            = succeed "," do
              %math#mathml_12cffe469aa70af393c3594fc5f85ceeeee1ebf2_13.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ξ
                    %mo ∈
                    %mi F
                  %annotation{:encoding => "application/x-tex"} \xi\in F
            %math#mathml_12cffe469aa70af393c3594fc5f85ceeeee1ebf2_14.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi σ
                    %mi ξ
                  %mo :
                  %mover
                    %mi G
                    %mo{:stretchy => "false"} ^
                  %mo{:stretchy => "false"} (
                  %mi π
                  %mo{:stretchy => "false"} (
                  %mi ξ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %msub
                    %mi{:mathvariant => "normal"} Hom
                    %mi F
                  %mo{:stretchy => "false"} (
                  %mi ξ
                  %mo ,
                  %mi ρ
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi{:mathvariant => "normal"} Hom
                    %mi F
                  %mo{:stretchy => "false"} (
                  %mi ξ
                  %mo ,
                  %mi ρ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \sigma_\xi:\hat{G}(\pi(\xi))\times\mathrm{Hom}_F(\xi,\rho)\to\mathrm{Hom}_F(\xi,\rho)
            satisfies the action axiom of a group
            %math#mathml_12cffe469aa70af393c3594fc5f85ceeeee1ebf2_15.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi G
                    %mo{:stretchy => "false"} ^
                  %mo{:stretchy => "false"} (
                  %mi π
                  %mo{:stretchy => "false"} (
                  %mi ξ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \hat{G}(\pi(\xi))
            on a set
            = succeed "," do
              %math#mathml_12cffe469aa70af393c3594fc5f85ceeeee1ebf2_16.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} Hom
                      %mi F
                    %mo{:stretchy => "false"} (
                    %mi ξ
                    %mo ,
                    %mi ρ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{Hom}_F(\xi,\rho)
            = succeed "." do
              %math#mathml_12cffe469aa70af393c3594fc5f85ceeeee1ebf2_17.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mo{:stretchy => "false"} (
                    %mi σ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mover
                      %mi ν
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \pi(\sigma)=\hat\nu
            = succeed "-equivariant" do
              %math#mathml_12cffe469aa70af393c3594fc5f85ceeeee1ebf2_18.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi G
