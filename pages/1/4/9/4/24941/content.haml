                    %mi X
                    %mi i
                  %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} R[X \setminus \{X_i\}]
            be the polynomial
            %a.existingWikiWord{:href => "/nlab/show/subring"} subring
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} R[X]
            whose indeterminates do not include
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi i
                  %annotation{:encoding => "application/x-tex"} X_i
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo :
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ∖
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi X
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} ]
                    %mo ↪
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} m:R[X \setminus \{X_i\}] \hookrightarrow R[X]
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} Fin
                  %mo{:stretchy => "false"} (
                  %mi n
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo *
                %annotation{:encoding => "application/x-tex"} \mathrm{Fin}(n)^*
            be the
            %a.existingWikiWord{:href => "/nlab/show/free+monoid"} free monoid
            on the set of natural numbers less than
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/free+monoid"} free monoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} Fin
                  %mo{:stretchy => "false"} (
                  %mi n
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo *
                %annotation{:encoding => "application/x-tex"} \mathrm{Fin}(n)^*
            has a length function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} len
                  %mo :
                  %mi{:mathvariant => "normal"} Fin
                  %mo{:stretchy => "false"} (
                  %mi n
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo *
                  %mo →
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} \mathrm{len}:\mathrm{Fin}(n)^* \to \mathbb{N}
            which returns the number of elements in a list
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi{:mathvariant => "normal"} Fin
                    %mo{:stretchy => "false"} (
                    %mi n
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"} a \in \mathrm{Fin}(n)^*
          %ul
            %li
              Monoidal unit preservation:
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} len
                    %mo{:stretchy => "false"} (
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \mathrm{len}(\epsilon) = 0
            %li
              Monoidal product preservation:
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} len
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi{:mathvariant => "normal"} len
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi{:mathvariant => "normal"} len
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{len}(a b) = \mathrm{len}(a) + \mathrm{len}(b)
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi{:mathvariant => "normal"} Fin
                    %mo{:stretchy => "false"} (
                    %mi n
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"} a \in \mathrm{Fin}(n)^*
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %mi{:mathvariant => "normal"} Fin
                    %mo{:stretchy => "false"} (
                    %mi n
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"} b \in \mathrm{Fin}(n)^*
            %li
              Generators have length 1:
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} len
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathrm{len}(i) = 1
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mi{:mathvariant => "normal"} Fin
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} i \in \mathrm{Fin}(n)
          %h4#with_partial_derivatives With partial derivatives
          %p
            The
            %strong formal partial derivative
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mo ∂
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mo ∂
                      %msub
                        %mi X
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                  %mo :
                  %mi{:mathvariant => "normal"} Fin
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi R
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi R
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \frac{\partial(-)}{\partial X_{(-)}}:\mathrm{Fin}(n) \times R[X] \to R[X]
            is inductively defined by
          %ul
            %li
              Constants relative to the indeterminant go to zero:
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                        %mo ∂
                        %mi h
                        %mo{:stretchy => "false"} (
                        %mi r
                        %mo{:stretchy => "false"} )
                      %mrow
                        %mo ∂
                        %msub
                          %mi X
                          %mi i
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \frac{\partial h(r)}{\partial X_i} = 0
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mi{:mathvariant => "normal"} Fin
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} i \in \mathrm{Fin}(n)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo ∈
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ∖
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi X
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} r \in R[X \setminus \{X_i\}]
            %li
              Indeterminates go to one:
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                        %mo ∂
                        %msub
                          %mi X
                          %mi i
                      %mrow
                        %mo ∂
                        %msub
                          %mi X
                          %mi i
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \frac{\partial X_i}{\partial X_i} = 1
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mi{:mathvariant => "normal"} Fin
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} i \in \mathrm{Fin}(n)
            %li
              Addition preservation:
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                        %mo ∂
                        %mo{:stretchy => "false"} (
                        %mi P
                        %mo +
                        %mi Q
                        %mo{:stretchy => "false"} )
                      %mrow
                        %mo ∂
                        %msub
                          %mi X
                          %mi i
                    %mo =
                    %mfrac
                      %mrow
                        %mo ∂
                        %mi P
                      %mrow
                        %mo ∂
                        %msub
                          %mi X
                          %mi i
                    %mo +
                    %mfrac
                      %mrow
                        %mo ∂
                        %mi Q
                      %mrow
                        %mo ∂
                        %msub
                          %mi X
                          %mi i
                  %annotation{:encoding => "application/x-tex"} \frac{\partial (P + Q)}{\partial X_i} = \frac{\partial P}{\partial X_i} + \frac{\partial Q}{\partial X_i}
              for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ∈
                      %mi{:mathvariant => "normal"} Fin
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} i \in \mathrm{Fin}(n)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ∈
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} P \in R[X]
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                      %mo ∈
                      %mi R
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} Q \in R[X]
            %li
              Leibniz rule:
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                        %mo ∂
                        %mo{:stretchy => "false"} (
                        %mi P
                        %mo ⋅
                        %mi Q
                        %mo{:stretchy => "false"} )
                      %mrow
                        %mo ∂
                        %msub
                          %mi X
                          %mi i
                    %mo =
                    %mfrac
                      %mrow
                        %mo ∂
                        %mi P
                      %mrow
                        %mo ∂
                        %msub
                          %mi X
                          %mi i
                    %mo ⋅
                    %mi Q
                    %mo +
                    %mi P
                    %mo ⋅
                    %mfrac
                      %mrow
                        %mo ∂
                        %mi Q
                      %mrow
                        %mo ∂
                        %msub
                          %mi X
                          %mi i
                  %annotation{:encoding => "application/x-tex"} \frac{\partial (P \cdot Q)}{\partial X_i} = \frac{\partial P}{\partial X_i} \cdot Q + P \cdot \frac{\partial Q}{\partial X_i}
              for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ∈
                      %mi{:mathvariant => "normal"} Fin
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} i \in \mathrm{Fin}(n)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ∈
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} P \in R[X]
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                      %mo ∈
                      %mi R
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} Q \in R[X]
          %p
            By the universal property of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} R[X]
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ∈
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} P \in R[X]
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mo :
                  %mi{:mathvariant => "normal"} Fin
                  %mo{:stretchy => "false"} (
                  %mi n
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo *
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi R
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} d:\mathrm{Fin}(n)^* \to (R[X] \to R[X])
            be the
            %a.existingWikiWord{:href => "/nlab/show/monoid+homomorphism"} monoid homomorphism
            which takes a list
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ∈
                  %mi{:mathvariant => "normal"} Fin
                  %mo{:stretchy => "false"} (
                  %mi n
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo *
                %annotation{:encoding => "application/x-tex"} a \in \mathrm{Fin}(n)^*
            of natural numbers less than
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mfrac
                    %mrow
                      %msup
                        %mo ∂
                        %mrow
                          %mi{:mathvariant => "normal"} len
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mo ∂
                      %msub
                        %mi X
                        %mrow
                          %msub
                            %mi a
                            %mn 0
                      %mo ∂
                      %msub
                        %mi X
                        %mrow
                          %msub
                            %mi a
                            %mn 1
                      %mo ∂
                      %msub
                        %mi X
                        %mrow
                          %msub
                            %mi a
                            %mn 2
                      %mi …
                  %mo ≔
                  %mfrac
                    %mrow
                      %mo ∂
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mo ∂
                      %msub
                        %mi X
                        %mrow
                          %msub
                            %mi a
                            %mn 0
                  %mo ∘
                  %mfrac
                    %mrow
                      %mo ∂
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mo ∂
                      %msub
                        %mi X
                        %mrow
                          %msub
                            %mi a
                            %mn 1
                  %mo ∘
                  %mfrac
                    %mrow
                      %mo ∂
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mo ∂
                      %msub
                        %mi X
                        %mrow
                          %msub
                            %mi a
                            %mn 2
                  %mo ∘
                  %mi …
                %annotation{:encoding => "application/x-tex"} d(a) \coloneqq \frac{\partial^{\mathrm{len}(a)} (-)}{\partial X_{a_0} \partial X_{a_1} \partial X_{a_2} \ldots} \coloneqq \frac{\partial (-)}{\partial X_{a_0}} \circ \frac{\partial (-)}{\partial X_{a_1}} \circ \frac{\partial (-)}{\partial X_{a_2}} \circ \ldots
          %p
            in the
            %a.existingWikiWord{:href => "/nlab/show/function+set"} function set
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} R[X] \to R[X]
          %ul
            %li
              Monoidal unit preservation:
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi{:mathvariant => "normal"} id
                      %mrow
                        %mi R
                        %mo{:stretchy => "false"} [
                        %mi X
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} d(\epsilon) = \mathrm{id}_{R[X]}
            %li
              Monoidal product preservation:
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} d(a b) = d(a) \circ d(b)
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi{:mathvariant => "normal"} Fin
                    %mo{:stretchy => "false"} (
                    %mi n
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"} a \in \mathrm{Fin}(n)^*
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %mi{:mathvariant => "normal"} Fin
                    %mo{:stretchy => "false"} (
                    %mi n
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"} b \in \mathrm{Fin}(n)^*
            %li
              Generators to partial derivatives:
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mfrac
                      %mrow
                        %mo ∂
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %mrow
                        %mo ∂
                        %msub
                          %mi X
                          %mi i
                  %annotation{:encoding => "application/x-tex"} d(i) = \frac{\partial (-)}{\partial X_i}
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mi{:mathvariant => "normal"} Fin
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} i \in \mathrm{Fin}(n)
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            has
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/characteristic+zero"} characteristic zero
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ∈
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mi x
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} P \in R[x]
            %strong degree
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            is the maximum length of all lists
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ∈
                  %mi{:mathvariant => "normal"} Fin
                  %mo{:stretchy => "false"} (
                  %mi n
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo *
                %annotation{:encoding => "application/x-tex"} a \in \mathrm{Fin}(n)^*
            of natural numbers less than
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            such that the evaluation of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} d(a)
            at
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            is non-zero
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} deg
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %munder
                    %mi max
                    %mrow
                      %mi a
                      %mo ∈
                      %mi{:mathvariant => "normal"} Fin
                      %mo{:stretchy => "false"} (
                      %mi n
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                      %mo ,
                      %mi d
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mo{:stretchy => "false"} )
                      %mo ≠
                      %mn 0
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} len
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{deg}(P) \coloneqq \max_{a \in \mathrm{Fin}(n)^*, d(a)(P) \neq 0}(\mathrm{len}(a))
          %p The degree of the zero polynomial is undefined, since any composition of partial derivatives evaluated at the zero polynomial is never non-zero.
          %p
            The above definition involving formal partial derivatives works for commutative rings
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            with
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/characteristic+zero"} characteristic zero
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            has
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/positive+characteristic"} positive characteristic
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed "-th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mi i
                %annotation{:encoding => "application/x-tex"} X_i
            for natural number less than
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mi{:mathvariant => "normal"} Fin
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} i \in \mathrm{Fin}(n)
          %h4#with_partial_left_shifts With partial left shifts
          %p
            The
            %strong formal partial left shift operator
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi s
                    %mrow
                      %mo ∂
                      %mi L
                  %mo :
                  %mi{:mathvariant => "normal"} Fin
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi R
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi R
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} s_{\partial L}:\mathrm{Fin}(n) \times R[X] \to R[X]
            is inductively defined by
          %ul
            %li
              Constants relative to the indeterminant go to zero:
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mrow
                        %mo ∂
                        %mi L
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo ,
                    %mi r
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} s_{\partial L}(i, r) = 0
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mi{:mathvariant => "normal"} Fin
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} i \in \mathrm{Fin}(n)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo ∈
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ∖
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi X
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} r \in R[X \setminus \{X_i\}]
            %li
              Indeterminates go to one:
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mrow
                        %mo ∂
                        %mi L
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo ,
                    %msub
                      %mi X
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} s_{\partial L}(i, X_i) = 1
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mi{:mathvariant => "normal"} Fin
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} i \in \mathrm{Fin}(n)
            %li
              Addition preservation:
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mrow
                        %mo ∂
                        %mi L
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo ,
                    %mi P
                    %mo +
                    %mi Q
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi s
                      %mrow
                        %mo ∂
                        %mi L
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo ,
                    %mi P
                    %mo{:stretchy => "false"} )
                    %mo +
                    %msub
                      %mi s
                      %mrow
                        %mo ∂
                        %mi L
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo ,
                    %mi Q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} s_{\partial L}(i, P + Q) = s_{\partial L}(i, P) + s_{\partial L}(i, Q)
              for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ∈
                      %mi{:mathvariant => "normal"} Fin
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} i \in \mathrm{Fin}(n)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ∈
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} P \in R[X]
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                      %mo ∈
                      %mi R
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} Q \in R[X]
            %li
              Left shift product rule:
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mrow
                        %mo ∂
                        %mi L
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo ,
                    %mi P
                    %mo ⋅
                    %mi Q
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi s
                      %mrow
                        %mo ∂
                        %mi L
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo ,
                    %mi P
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mi Q
                    %mo +
                    %mi P
                    %mo ⋅
                    %msub
                      %mi s
                      %mrow
                        %mo ∂
                        %mi L
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo ,
                    %mi Q
                    %mo{:stretchy => "false"} )
                    %mo −
                    %msub
                      %mi X
                      %mi i
                    %mo ⋅
                    %msub
                      %mi s
                      %mrow
                        %mo ∂
                        %mi L
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo ,
                    %mi P
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %msub
                      %mi s
                      %mrow
                        %mo ∂
                        %mi L
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo ,
                    %mi Q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} s_{\partial L}(i, P \cdot Q) = s_{\partial L}(i, P) \cdot Q + P \cdot s_{\partial L}(i, Q) - X_i \cdot s_{\partial L}(i, P) \cdot s_{\partial L}(i, Q)
              for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ∈
                      %mi{:mathvariant => "normal"} Fin
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} i \in \mathrm{Fin}(n)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∈
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mi x
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} p \in R[x]
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                      %mo ∈
                      %mi R
                      %mo{:stretchy => "false"} [
                      %mi x
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} q \in R[x]
          %p
            By the universal property of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} R[X]
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ∈
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} P \in R[X]
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo :
                  %mi{:mathvariant => "normal"} Fin
                  %mo{:stretchy => "false"} (
                  %mi n
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo *
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi R
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} S:\mathrm{Fin}(n)^* \to (R[X] \to R[X])
            be the
            %a.existingWikiWord{:href => "/nlab/show/monoid+homomorphism"} monoid homomorphism
            which takes a list
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ∈
                  %mi{:mathvariant => "normal"} Fin
                  %mo{:stretchy => "false"} (
                  %mi n
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo *
                %annotation{:encoding => "application/x-tex"} a\in \mathrm{Fin}(n)^*
            of natural numbers less than
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %msub
                    %mi s
                    %mrow
                      %mo ∂
                      %mi L
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi a
                    %mn 0
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo ∘
                  %msub
                    %mi s
                    %mrow
                      %mo ∂
                      %mi L
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi a
                    %mn 1
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo ∘
                  %msub
                    %mi s
                    %mrow
                      %mo ∂
                      %mi L
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi a
                    %mn 2
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo ∘
                  %mi …
                %annotation{:encoding => "application/x-tex"} S(a) \coloneqq s_{\partial L}(a_0, -) \circ s_{\partial L}(a_1, -) \circ s_{\partial L}(a_2, -) \circ \ldots
          %p
            in the
            %a.existingWikiWord{:href => "/nlab/show/function+set"} function set
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} R[X] \to R[X]
          %ul
            %li
              Monoidal unit preservation:
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi{:mathvariant => "normal"} id
                      %mrow
                        %mi R
                        %mo{:stretchy => "false"} [
                        %mi X
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} S(\epsilon) = \mathrm{id}_{R[X]}
            %li
              Monoidal product preservation:
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S(a b) = S(a) \circ S(b)
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi{:mathvariant => "normal"} Fin
                    %mo{:stretchy => "false"} (
                    %mi n
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"} a \in \mathrm{Fin}(n)^*
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %mi{:mathvariant => "normal"} Fin
                    %mo{:stretchy => "false"} (
                    %mi n
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"} b \in \mathrm{Fin}(n)^*
            %li
              Generators to partial left shifts
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi s
                      %mrow
                        %mo ∂
                        %mi L
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S(i) = s_{\partial L}(i, -)
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mi{:mathvariant => "normal"} Fin
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} i \in \mathrm{Fin}(n)
          %p
            Given a non-zero polynomial
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ∈
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mi x
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} P \in R[x]
            %strong degree
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            is the maximum length of all lists
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ∈
                  %mi{:mathvariant => "normal"} Fin
                  %mo{:stretchy => "false"} (
                  %mi n
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo *
                %annotation{:encoding => "application/x-tex"} a \in \mathrm{Fin}(n)^*
            of natural numbers less than
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            such that the evaluation of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} S(a)
            at
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            is non-zero
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} deg
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %munder
                    %mi max
                    %mrow
                      %mi a
                      %mo ∈
                      %mi{:mathvariant => "normal"} Fin
                      %mo{:stretchy => "false"} (
                      %mi n
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                      %mo ,
                      %mi S
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mo{:stretchy => "false"} )
                      %mo ≠
                      %mn 0
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} len
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{deg}(P) \coloneqq \max_{a \in \mathrm{Fin}(n)^*, S(a)(P) \neq 0}(\mathrm{len}(a))
          %p The degree of the zero polynomial is undefined, since any composition of partial derivatives evaluated at the zero polynomial is never non-zero.
          %h2#homogeneous_polynomials Homogeneous polynomials
          %p …
          %p
            Given a polynomial
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo ∈
                  %mi R
                  %mo{:stretchy => "false"} [
                  %mi x
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} p \in R[x]
            in one indeterminate, it is said to be an
            %strong homogeneous polynomial
            of degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi d
                      %mi p
                    %mrow
                      %mi d
                      %mi x
                  %mo .
                  %mi x
                  %mo =
                  %mi n
                  %mo .
                  %mi p
                %annotation{:encoding => "application/x-tex"} \frac{d p}{d x}.x = n.p
            (see the
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/homogeneous+polynomial"} Euler identity
          %p
            Given a polynomial
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo ∈
                  %mi R
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} p \in R[X]
            in a finite number of indeterminates, it is said to be an homogeneous polynomial of degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            if
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo ∈
                        %mi{:mathvariant => "normal"} Fin
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                    %mfrac
                      %mrow
                        %mo ∂
                        %mi p
                      %mrow
                        %mo ∂
                        %msub
                          %mi X
                          %mi i
                    %mo .
                    %msub
                      %mi X
                      %mi i
                    %mo =
                    %mi n
                    %mo .
                    %mi p
                  %annotation{:encoding => "application/x-tex"} \underset{i \in \mathrm{Fin}(n)}{\sum} \frac{\partial p}{\partial X_i}.X_i = n.p
          %p
            One could also define a polynomial
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo ∈
                  %mi R
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} p \in R[X]
            to be homogeneous of degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            with respect to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo ∈
                  %mi{:mathvariant => "normal"} Fin
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} i \in \mathrm{Fin}(n)
            if
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                        %mo ∂
                        %mi p
                      %mrow
                        %mo ∂
                        %msub
                          %mi X
                          %mi i
                    %mo .
                    %msub
                      %mi X
                      %mi i
                    %mo =
                    %mi n
                    %mo .
                    %mi p
                  %annotation{:encoding => "application/x-tex"} \frac{\partial p}{\partial X_i}.X_i = n.p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            can be written under the form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo =
                  %msubsup
                    %mi X
                    %mi i
                    %mi n
                  %mo .
                  %mi q
                %annotation{:encoding => "application/x-tex"} p=X_i^{n}.q
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                  %mo ∈
                  %mi R
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} q \in R[X]
            is such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                        %mo ∂
                        %mi p
                      %mrow
                        %mo ∂
                        %msub
                          %mi X
                          %mi i
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \frac{\partial p}{\partial X_i} = 0
          %h2#in_constructive_mathematics  In constructive mathematics
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive mathematics
            %a.existingWikiWord{:href => "/nlab/show/excluded+middle"} excluded middle
            does not hold, the above definition is correct only if the ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            has
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/decidable+equality"} decidable equality
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            and thus the polynomial ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} R[X]
            is a set with a
            %a.existingWikiWord{:href => "/nlab/show/tight+apartness+relation"} tight apartness relation
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo #
                  %annotation{:encoding => "application/x-tex"} \#
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo ≠
                  %mn 0
                %annotation{:encoding => "application/x-tex"} p \neq 0
            with instances of “apart from zero”
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo #
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} p \# 0
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/classical+mathematics"} classical mathematics
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            has a
            %a.existingWikiWord{:href => "/nlab/show/tight+apartness+relation"} tight apartness relation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ≠
                  %mi y
                %annotation{:encoding => "application/x-tex"} x \neq y
            given by the
            %a.existingWikiWord{:href => "/nlab/show/denial+negation"} denial negation
            of
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/equality"} equality
            %a.existingWikiWord{:href => "/nlab/show/Dedekind+real+numbers"} Dedekind real numbers
            is only defined on polynomials with at least one coefficient whose
            %a.existingWikiWord{:href => "/nlab/show/absolute+value"} absolute value
            is greater than zero.
