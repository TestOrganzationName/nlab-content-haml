                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %msub
                      %mi s
                      %mi L
                    %mo{:stretchy => "false"} (
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} s_L(p \cdot q) = s_L(p) \cdot q + p \cdot s_L(q) - x \cdot s_L(p) \cdot s_L(q)
              for all
