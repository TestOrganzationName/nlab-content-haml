                        %msup
                          %mi x
                          %mn 0
                    %mo =
                    %msub
                      %mi{:mathvariant => "normal"} id
                      %mrow
                        %mi R
                        %mo{:stretchy => "false"} [
                        %mi X
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \frac{d^{0} (-)}{d x^{0}} = \mathrm{id}_{R[X]}
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                        %msup
                          %mi d
                          %mrow
                            %mi s
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %mrow
                        %mi d
                        %msup
                          %mi x
                          %mrow
                            %mi s
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                    %mo =
                    %mfrac
                      %mrow
                        %mi d
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %mrow
                        %mi d
                        %mi x
                    %mo ∘
                    %mfrac
                      %mrow
                        %msup
                          %mi d
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %mrow
                        %mi d
                        %msup
                          %mi x
                          %mi n
                  %annotation{:encoding => "application/x-tex"} \frac{d^{s(n)} (-)}{d x^{s(n)}} = \frac{d (-)}{d x} \circ \frac{d^{n} (-)}{d x^{n}}
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            has
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/characteristic+zero"} characteristic zero
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∈
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mi x
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} p \in R[x]
            %strong degree
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            is the maximum
            %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            where the
            = succeed "-th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/derivative"} derivative
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            is non-zero:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} deg
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %munder
                    %mi max
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                      %mo ,
                      %mfrac
                        %mrow
                          %msup
                            %mi d
                            %mi n
                          %mi p
                        %mrow
                          %mi d
                          %msup
                            %mi x
                            %mi n
                      %mo ≠
                      %mn 0
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{deg}(p) \coloneqq \max_{n \in \mathbb{N}, \frac{d^{n} p}{d x^{n}} \neq 0}(n)
          %p The degree of the zero polynomial is undefined, since the formal derivative of the zero polynomial is never non-zero.
          %p
            The above definition involving formal derivatives works for commutative rings
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            with
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/characteristic+zero"} characteristic zero
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            has
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/positive+characteristic"} positive characteristic
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            is zero. Instead, we have to use something more general, the left shift.
          %h4#using_left_shifts Using left shifts
          %p
            For every polynomial
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∈
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mi x
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} p \in R[x]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            could be represented as the sum of a constant polynomial
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi c
                    %mi p
                %annotation{:encoding => "application/x-tex"} c_p
            and the product of the indeterminate
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            and a polynomial
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi s
                    %mi L
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} s_L(p)
            called the
            %strong left shift
            of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo =
                    %msub
                      %mi c
                      %mi p
                    %mo +
                    %mi x
                    %mo ⋅
                    %msub
                      %mi s
                      %mi L
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p = c_p + x \cdot s_L(p)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo =
                  %msub
                    %mi c
                    %mi p
                %annotation{:encoding => "application/x-tex"} p = c_p
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo =
                    %msub
                      %mi c
                      %mi q
                  %annotation{:encoding => "application/x-tex"} q = c_q
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mrow
                        %mi p
                        %mo ⋅
                        %mi q
                    %mo =
                    %msub
                      %mi c
                      %mi p
                    %mo ⋅
                    %msub
                      %mi c
                      %mi q
                  %annotation{:encoding => "application/x-tex"} c_{p \cdot q} = c_p \cdot c_q
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo =
                  %msub
                    %mi c
                    %mi p
                  %mo +
                  %mi x
                  %mo ⋅
                  %msub
                    %mi s
                    %mi L
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} p = c_p + x \cdot s_L(p)
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo =
                    %msub
                      %mi c
                      %mi q
                    %mo +
                    %mi x
                    %mo ⋅
                    %msub
                      %mi s
                      %mi L
                    %mo{:stretchy => "false"} (
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} q = c_q + x \cdot s_L(q)
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo =
                  %mi x
                  %mo ⋅
                  %msub
                    %mi s
                    %mi L
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo +
                  %msub
                    %mi c
                    %mi p
                  %mo ,
                  %mi q
                  %mo =
                  %mi x
                  %mo ⋅
                  %msub
                    %mi s
                    %mi L
                  %mo{:stretchy => "false"} (
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mo +
                  %msub
                    %mi c
                    %mi q
                %annotation{:encoding => "application/x-tex"} p = x \cdot s_L(p) + c_p, q = x \cdot s_L(q) + c_q
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo ⋅
                  %mi q
                  %mo =
                  %mi x
                  %mo ⋅
                  %msub
                    %mi s
                    %mi L
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo ⋅
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mo +
                  %msub
                    %mi c
                    %mrow
                      %mi p
                      %mo ⋅
                      %mi q
                  %mo =
                  %mi x
                  %msub
                    %mi s
                    %mi L
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo ⋅
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mo +
                  %msub
                    %mi c
                    %mi p
                  %mo ⋅
                  %msub
                    %mi c
                    %mi q
                %annotation{:encoding => "application/x-tex"} p \cdot q = x \cdot s_L(p \cdot q) + c_{p \cdot q} = x s_L(p \cdot q) + c_{p} \cdot c_{q}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo ⋅
                  %mi q
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ⋅
                  %msub
                    %mi s
                    %mi L
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo +
                  %msub
                    %mi c
                    %mi p
                  %mo{:stretchy => "false"} )
                  %mo ⋅
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ⋅
                  %msub
                    %mi s
                    %mi L
                  %mo{:stretchy => "false"} (
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mo +
                  %msub
                    %mi c
                    %mi q
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msup
                    %mi x
                    %mn 2
                  %mo ⋅
                  %msub
                    %mi s
                    %mi L
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo ⋅
                  %msub
                    %mi s
                    %mi L
                  %mo{:stretchy => "false"} (
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mi x
                  %mo ⋅
                  %msub
                    %mi s
                    %mi L
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo ⋅
                  %msub
                    %mi c
                    %mi q
                  %mo +
                  %mi x
                  %mo ⋅
                  %msub
                    %mi s
                    %mi L
                  %mo{:stretchy => "false"} (
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mo ⋅
                  %msub
                    %mi c
                    %mi p
                  %mo +
                  %msub
                    %mi c
                    %mi p
                  %mo ⋅
                  %msub
                    %mi c
                    %mi q
                %annotation{:encoding => "application/x-tex"} p \cdot q = (x \cdot s_L(p) + c_p) \cdot (x \cdot  s_L(q) + c_q) = x^2 \cdot s_L(p) \cdot s_L(q) + x \cdot s_L(p) \cdot c_q + x \cdot s_L(q) \cdot c_p + c_p \cdot c_q
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ⋅
                  %msub
                    %mi s
                    %mi L
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo ⋅
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msup
                    %mi x
                    %mn 2
                  %mo ⋅
                  %msub
                    %mi s
                    %mi L
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo ⋅
                  %msub
                    %mi s
                    %mi L
                  %mo{:stretchy => "false"} (
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mi x
                  %mo ⋅
                  %msub
                    %mi s
                    %mi L
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo ⋅
                  %msub
                    %mi c
                    %mi q
                  %mo +
                  %mi x
                  %mo ⋅
                  %msub
                    %mi s
                    %mi L
                  %mo{:stretchy => "false"} (
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mo ⋅
                  %msub
                    %mi c
                    %mi p
                %annotation{:encoding => "application/x-tex"} x \cdot s_L(p \cdot q) = x^2 \cdot s_L(p) \cdot s_L(q) + x \cdot s_L(p) \cdot c_q + x \cdot s_L(q) \cdot c_p
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi s
                    %mi L
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo ⋅
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi x
                  %mo ⋅
                  %msub
                    %mi s
                    %mi L
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo ⋅
                  %msub
                    %mi s
                    %mi L
                  %mo{:stretchy => "false"} (
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mo +
                  %msub
                    %mi s
                    %mi L
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo ⋅
                  %msub
                    %mi c
                    %mi q
                  %mo +
                  %msub
                    %mi s
                    %mi L
                  %mo{:stretchy => "false"} (
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mo ⋅
                  %msub
                    %mi c
                    %mi p
                %annotation{:encoding => "application/x-tex"} s_L(p \cdot q) = x \cdot s_L(p) \cdot s_L(q) + s_L(p) \cdot c_q + s_L(q) \cdot c_p
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo −
                  %mi x
                  %mo ⋅
                  %msub
                    %mi s
                    %mi L
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi c
                    %mi p
                  %mo ,
                  %mi q
                  %mo −
                  %mi x
                  %mo ⋅
                  %msub
                    %mi s
                    %mi L
                  %mo{:stretchy => "false"} (
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi c
                    %mi q
                %annotation{:encoding => "application/x-tex"} p - x \cdot s_L(p) = c_p, q - x \cdot s_L(q) = c_q
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi s
                    %mi L
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo ⋅
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi x
                  %mo ⋅
                  %msub
                    %mi s
                    %mi L
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo ⋅
                  %msub
                    %mi s
                    %mi L
                  %mo{:stretchy => "false"} (
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mo +
                  %msub
                    %mi s
                    %mi L
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo ⋅
                  %mo{:stretchy => "false"} (
                  %mi q
                  %mo −
                  %mi x
                  %mo ⋅
                  %msub
                    %mi s
                    %mi L
                  %mo{:stretchy => "false"} (
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo +
                  %msub
                    %mi s
                    %mi L
                  %mo{:stretchy => "false"} (
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mo ⋅
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo −
                  %mi x
                  %mo ⋅
                  %msub
                    %mi s
                    %mi L
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi s
                    %mi L
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo ⋅
                  %mi q
                  %mo +
                  %msub
                    %mi s
                    %mi L
                  %mo{:stretchy => "false"} (
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mo ⋅
                  %mi p
                  %mo −
                  %mi x
                  %mo ⋅
                  %msub
                    %mi s
                    %mi L
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo ⋅
                  %msub
                    %mi s
                    %mi L
                  %mo{:stretchy => "false"} (
                  %mi q
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} s_L(p \cdot q) = x \cdot s_L(p) \cdot s_L(q) + s_L(p) \cdot (q - x \cdot s_L(q)) + s_L(q) \cdot (p - x \cdot  s_L(p)) = s_L(p) \cdot q + s_L(q) \cdot p - x \cdot s_L(p) \cdot s_L(q)
          %p
            Thus, we have the formula for the left shift of the product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo ⋅
                  %mi q
                %annotation{:encoding => "application/x-tex"} p \cdot q
            for any two polynomials
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo ∈
                  %mi R
                  %mo{:stretchy => "false"} [
                  %mi x
                  %mo{:stretchy => "false"} ]
