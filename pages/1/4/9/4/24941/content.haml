                  %mo →
                  %mi R
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \frac{d^{(-)} (-)}{d x^{(-)}}:\mathbb{N} \to (R[X] \to R[X])
            be the function which takes a natural number
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ∈
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            to the
            = succeed "-th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/function+set"} function set
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} [
