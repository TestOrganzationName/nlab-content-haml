                        %mtd
                          %msub
                            %mi d
                            %mn 0
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                          %msub
                            %mi d
                            %mn 0
                      %mtr
                        %mtd
                          %msub
                            %mi C
                            %mn 0
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mi F
                                %mn 0
                        %mtd
                          %msub
                            %mi B
                            %mn 0
                %annotation{:encoding => "application/x-tex"}
                  \\begin{matrix}
                  C_1 &amp;\stackrel{F_1}\to&amp; B_1\\
                  d_0\downarrow &amp;&amp; \downarrow d_0\\
                  C_0 &amp;\stackrel{F_0}\to&amp; B_0
                  \\end{matrix}
          %p is cartesian.
          %h2#discussion_via_category_of_elements Discussion via category of elements
          %p
            Given a discrete fibration
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi C
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} F: C \to B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi F
                    %mo *
                  %mo :
                  %msup
                    %mi B
                    %mi op
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} F^*: B^{op} \to Set
            as follows:
          %ul
            %li
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              an object of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F^*(x)
              be the set of objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi x
                    %annotation{:encoding => "application/x-tex"} F(y) = x
            %li
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %mi x
                    %mo →
                    %mi y
                  %annotation{:encoding => "application/x-tex"} g: x \to y
              a morphism of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msup
                      %mi F
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi F
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F^*(g): F^*(y) \to F^*(x)
              be the function that maps each element of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F^*(y)
              to the unique
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              determined by the definition of discrete fibration above.
          %p
            There is a size issue here, is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi F
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F^*(x)
            in fact
            = succeed "?" do
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small
            %strong small fibres
            if so; else we must pass to a larger
            %a.existingWikiWord{:href => "/nlab/show/universe"} universe
            when we define
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
          %p
            Conversely, give a functor
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mo *
                    %mo :
                    %msup
                      %mi B
                      %mi op
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} F^*: B^{op} \to Set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and a discrete fibration
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi C
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} F: C \to B
            as follows:
          %ul
            %li
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              be the
              %a.existingWikiWord{:href => "/nlab/show/category+of+elements"} category of elements
              of the functor
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi F
                        %mo *
                    %annotation{:encoding => "application/x-tex"} F^*
              %ul
                %li
                  an object of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  is a pair consisting of an object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                      %annotation{:encoding => "application/x-tex"} B
                  and an element of
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi F
                            %mo *
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} F^*(x)
                %li
                  a morphism from
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi a
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (x,a)
                  to
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo ,
                        %mi b
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (y,b)
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  is a morphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mo :
                        %mi x
                        %mo →
                        %mi y
                      %annotation{:encoding => "application/x-tex"} g: x \to y
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                      %annotation{:encoding => "application/x-tex"} B
                  such that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi F
                          %mo *
                        %mo{:stretchy => "false"} (
                        %mi g
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} F^*(g)
                  maps
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                      %annotation{:encoding => "application/x-tex"} b
                  to
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi a
                        %annotation{:encoding => "application/x-tex"} a
            %li
              The functor from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              is the obvious
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
          %p
            If you start from
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mo *
                  %annotation{:encoding => "application/x-tex"} F^*
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mo *
                  %annotation{:encoding => "application/x-tex"} F^*
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mo *
                  %annotation{:encoding => "application/x-tex"} F^*
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mo *
                  %annotation{:encoding => "application/x-tex"} F^*
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo ′
                %annotation{:encoding => "application/x-tex"} C'
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} F'
            %a.existingWikiWord{:href => "/nlab/show/isomorphism+of+categories"} isomorphism of categories
            between
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} C'
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo ′
                %annotation{:encoding => "application/x-tex"} F'
            are equal.
          %p
            Under this equivalence, the
            %a.existingWikiWord{:href => "/nlab/show/representable+presheaf"} representable presheaf
            on an object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            corresponds to the canonical functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo{:stretchy => "false"} /
                  %mi X
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} B/X \to B
            from the
            %a.existingWikiWord{:href => "/nlab/show/slice+category"} slice category
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %h2#invariance_under_equivalence Invariance under equivalence
          %p
            Note that the definition of fibration refers to
            %a.existingWikiWord{:href => "/nlab/show/equality"} equality
            of morphisms without previously assuming that the sources match, while the construction of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi F
                    %mo *
                %annotation{:encoding => "application/x-tex"} F^*
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            refers to equality of objects. This is also why we get
            %a.existingWikiWord{:href => "/nlab/show/equality"} equality
            of
            %a.existingWikiWord{:href => "/nlab/show/functors"} functors
            and
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            of
            %a.existingWikiWord{:href => "/nlab/show/categories"} categories
            in the immediately preceding paragraph. So the only thing on this page which respects the
            %a.existingWikiWord{:href => "/nlab/show/principle+of+equivalence"} principle of equivalence
            is the idea of a functor to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
          %h2#model_structure_for_discrete_fibrations Model structure for discrete fibrations
          %p
          .num_theorem
            %h6 Theorem
            %p
              (
              %a{:href => "#MoserSarazola"}> Moser–Sarazola
              , Theorem 2.18.) Suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is a category. The
              %a.existingWikiWord{:href => "/nlab/show/slice+category"} slice category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cat
                    %mo{:stretchy => "false"} /
                    %mi C
                  %annotation{:encoding => "application/x-tex"} Cat/C
              admits a
              %a.existingWikiWord{:href => "/nlab/show/combinatorial+model+structure"} combinatorial model structure
              with the following properties.
            %ul
              %li
                Cofibrations are
                %a.existingWikiWord{:href => "/nlab/show/functors"} functors
                that are injective on objects.
              %li
                Trivial fibrations are equivalences that are
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/isofibrations"} isofibrations
              %li
                Fibrant objects are discrete fibrations
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi P
                        %mo →
                        %mi C
                      %annotation{:encoding => "application/x-tex"} P\to C
              %li Weak equivalences are given by morphisms whose fibrant replacement is a trivial fibration, i.e., an isomorphism.
              %li
                Fibrant replacement is induced by the
                %a.existingWikiWord{:href => "/nlab/show/weak+factorization+system"} weak factorization system
                cofibrantly generated by the morphisms
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 1
                        %mo{:lspace => "verythinmathspace"} :
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo{:stretchy => "false"} ]
                        %mo →
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} 1\colon[0]\to[1]
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %msub
                        %mo ⊔
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mn 0
                          %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [1]\sqcup_{[0]}[1]\to[1]
                mapping to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                in an arbitrary way.
            %p
          %p
          .num_theorem
            %h6 Theorem
            %p
              (
              %a{:href => "#MoserSarazola"}> Moser–Sarazola
              , Theorem 3.9.) Suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is a category. There is a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cat
                    %mo{:stretchy => "false"} /
                    %mi C
                    %mo ⇄
                    %mi Fun
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} )
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} Cat/C \rightleftarrows Fun(C^{op},Set),
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cat
                    %mo{:stretchy => "false"} /
                    %mi C
                  %annotation{:encoding => "application/x-tex"} Cat/C
              is equipped with a model structure for discrete fibrations,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Fun
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Fun(C^{op},Set)
              is equipped with the
              %a.existingWikiWord{:href => "/nlab/show/projective+model+structure"} projective model structure
              (weak equivalences are isomorphisms; cofibrations and fibrations are all maps), the right adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Fun
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Cat
                    %mo{:stretchy => "false"} /
                    %mi C
                  %annotation{:encoding => "application/x-tex"} Fun(C^{op},Set)\to Cat/C
              is given by the
              %a.existingWikiWord{:href => "/nlab/show/category+of+elements"} category of elements
              construction, and the left adjoint adds formal strict base changes to a fibration in order to a get a strict presheaf of sets.
          %h2#further_properties Further properties
          %ul
            %li
              %p
                Just as general
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Grothendieck+fibration"} fibrations
                %a.existingWikiWord{:href => "/nlab/show/pullbacks"} pullbacks
                in
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
            %li
              %p
                Discrete (op)fibrations are the right class of the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/comprehensive+factorisation+system"} comprehensive factorisation system
          %h2#generalization_for_spans_internal_to_a_category Generalization for spans internal to a category
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            be a cartesian category. A span of
            %a.existingWikiWord{:href => "/nlab/show/internal+categories"} internal categories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mover
                    %mo ←
                    %mi p
                  %mi C
                  %mover
                    %mo →
                    %mi q
                  %mi B
                %annotation{:encoding => "application/x-tex"} A\stackrel{p}\leftarrow C\stackrel{q}\to B
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cat
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Cat(E)
            is called a
            %strong
              discrete fibration from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            if in the diagram
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %msub
                            %mi A
                            %mn 0
                        %mtd
                          %mo ←
                        %mtd
                          %msub
                            %mi C
                            %mi l
                        %mtd
                        %mtd
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                          %msub
                            %mi i
                            %mi l
                        %mtd
                        %mtd
                      %mtr
                        %mtd
                          %mi A
                        %mtd
                          %mover
                            %mo ←
                            %mi p
                        %mtd
                          %mi C
                        %mtd
                          %mover
                            %mo ←
                            %mrow
                              %msub
                                %mi i
                                %mi r
                        %mtd
                          %msub
                            %mi C
                            %mi r
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi q
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi B
                        %mtd
                          %mo ←
                        %mtd
                          %msub
                            %mi B
                            %mn 0
                %annotation{:encoding => "application/x-tex"}
                  \\begin{matrix}
                  A_0 &amp; \leftarrow &amp; C_l &amp;&amp; \\
                  \\downarrow &amp;&amp;\downarrow i_l &amp;&amp;\\
                  A &amp;\stackrel{p}\leftarrow &amp; C &amp;\stackrel{i_r}\leftarrow &amp; C_r\\
                  \&amp;&amp;q \downarrow &amp;&amp; \downarrow \\
                  \&amp;&amp; B &amp;\leftarrow &amp; B_0
                  \\end{matrix}
          %p in which the two squares are the cartesian satisfies the following 3 properties:
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ∘
                      %msub
                        %mi i
                        %mi r
                      %mo :
                      %msub
                        %mi C
                        %mi r
                      %mo →
                      %mi A
                    %annotation{:encoding => "application/x-tex"} p\circ i_r : C_r\to A
                is a discrete fibration
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                      %mo ∘
                      %msub
                        %mi i
                        %mi l
                      %mo :
                      %msub
                        %mi C
                        %mi l
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} q\circ i_l: C_l\to B
                is a discrete opfibration
            %li
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                be defined as the pullback
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:displaystyle => "false", :rowspacing => "0.5ex"}
                          %mtr
                            %mtd
                              %mi X
                            %mtd
                              %mo →
                            %mtd
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi C
                                %mi r
                              %msub
                                %mo{:stretchy => "false"} )
                                %mn 1
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi C
                                %mi l
                              %msub
                                %mo{:stretchy => "false"} )
                                %mn 1
                            %mtd
                              %mo →
                            %mtd
                              %msub
                                %mi C
                                %mn 0
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{matrix}
                      X &amp; \to &amp; (C_r)_1 \\
                      \\downarrow &amp;&amp;\downarrow \\
                      (C_l)_1 &amp;\to &amp; C_0
                      \\end{matrix}
              %p
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                      %mo :
                      %mi X
                      %mo ↪
                      %msub
                        %mi C
                        %mn 1
                      %msub
                        %mo ×
                        %mrow
                          %msub
                            %mi C
                            %mn 0
                      %msub
                        %mi C
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} j:X\hookrightarrow C_1\times_{C_0} C_1
                the canonical inclusion. Then the morphism
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi c
                        %mo ∘
                        %mi j
                        %mo :
                        %mi X
                        %mo →
                        %msub
                          %mi C
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} c\circ j : X\to C_1
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo :
                      %msub
                        %mi C
                        %mn 1
                      %msub
                        %mo ×
                        %mrow
                          %msub
                            %mi C
                            %mn 0
                      %msub
                        %mi C
                        %mn 1
                      %mo →
                      %msub
                        %mi C
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} c: C_1\times_{C_0} C_1\to C_1
                is the composition morphism of internal category
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
          %p
            %strong Example.
            Given internal functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo :
                  %mi A
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} a : A\to D
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                  %mo :
                  %mi B
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} b : B\to D
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ←
                  %mi a
                  %mo{:stretchy => "false"} ↓
                  %mi b
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} A\leftarrow a\downarrow b\rightarrow B
            is a discrete fibration from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/fibration+fibered+in+groupoids"} fibration fibered in groupoids
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Grothendieck+fibration"}> Grothendieck fibration
                ,
                %a.existingWikiWord{:href => "/nlab/show/Grothendieck+construction"} Grothendieck construction
          %h2#references References
          %p Review:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Angelo+Vistoli"}> Angelo Vistoli
              , §3.4 in:
              = succeed "," do
                %em Grothendieck topologies, fibered categories and descent theory
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Fundamental+algebraic+geometry+--+Grothendieck%27s+FGA+explained"} Fundamental algebraic geometry – Grothendieck's FGA explained
              = succeed "," do
                %strong 123
              = succeed "," do
                %a{:href => "https://bookstore.ams.org/surv-123-s"} ISBN:978-0-8218-4245-4
              = succeed "&rbrack;" do
                %a{:href => "http://arxiv.org/abs/math/0412512"} math.AG/0412512
          %p Model structure:
          %ul
            %li#MoserSarazola
              %a.existingWikiWord{:href => "/nlab/show/Lyne+Moser"}> Lyne Moser
              , Maru Sarazola,
              = succeed "," do
                %em A model structure for Grothendieck fibrations
              = succeed "." do
                %a{:href => "https://arxiv.org/abs/2306.11076"} arXiv:2306.11076
          %p See also:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Emily+Riehl"} Emily Riehl
              and
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Fosco+Loregian"} Fosco Loregian
              = succeed "," do
                %em Categorical notions of fibration
              %strong 38
              4 (2020) 496-514 &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/1806.06129"}> arXiv:1806.06129
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1016/j.exmath.2019.02.004"} doi:10.1016/j.exmath.2019.02.004
          %p
            A joint generalisation of the notions of discrete fibrations and
            %a.existingWikiWord{:href => "/nlab/show/discrete+opfibrations"} discrete opfibrations
            are studied in the following paper under the name
            = succeed "," do
              %em unique factorization liftings
