                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi T
                      %mi L
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi L
                        %mo ≤
                        %mi N
                        %mo ∈
                        %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \{T_L\}_{L\leq N \in \mathbb{N}}
              a finite set of affine maps such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi L
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %msub
                      %mi W
                      %mi L
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} ⟩
                    %mo +
                    %msub
                      %mi b
                      %mi L
                  %annotation{:encoding => "application/x-tex"} T_L(x) = \langle W_L,x\rangle + b_L
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi W
                      %mi L
