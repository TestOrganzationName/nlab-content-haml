                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(x) = (T_L\circ g \circ T_{L-1}\circ g \circ \dots \circ T_1)(x)
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
