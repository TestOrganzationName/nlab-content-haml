            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} m=1
            = succeed "\u2018s" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
            = succeed "\u2019s)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                  %annotation{:encoding => "application/x-tex"} \theta
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi θ
                %annotation{:encoding => "application/x-tex"} \theta
            fixes some function
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi θ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi K
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} f_\theta\colon K\to \mathbb{R}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                  %annotation{:encoding => "application/x-tex"} \theta
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi ℝ
                  %annotation{:encoding => "application/x-tex"} {\mathbb{R}}^{\mathbb{R}}
            = succeed "," do
              %strong universal approximation theorem
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi ℝ
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} f\colon{\mathbb{R}}\to{\mathbb{R}}
            well (i.e. up to smaller and smaller numerical error), meaning such the resulting distribution may assign non-zero value to any such function. Indeed, as established in the mid 90’s, considering a sequence of networks with a wider and wider hidden layer, and placing more and more sharp Gaussians over their weights, by the
            %a.existingWikiWord{:href => "/nlab/show/central+limit+theorem"} central limit theorem
            CLT, results in a probability distribution over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mi ℝ
                %annotation{:encoding => "application/x-tex"} {\mathbb{R}}^{\mathbb{R}}
            that typically is a Gaussian process GP. These GP’s are called
            = succeed "," do
              %strong neural network Gaussian processes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} [
                  %mi f
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %msup
                    %mi e
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi S
                      %mo{:stretchy => "false"} [
                      %mi f
                      %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} P[f]=e^{-S[f]}
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo{:stretchy => "false"} [
                  %mi f
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %mo ∫
                  %msub
                    %mi ρ
                    %mi f
                %annotation{:encoding => "application/x-tex"} S[f] = \int \rho_f
            where
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ρ
                      %mi f
                    %mo ∝
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mi dx
                    %mi dy
                  %annotation{:encoding => "application/x-tex"} \rho_f \propto f(x)f(y) dx dy
          %h3#neural_network_field_theory Neural Network Field Theory
          %p
            Non-Gaussian non-zero cumulant effects emerge from either not taking the infinite width limit, or alternatively also from violating CLT’s assumptions. The latter can practically be done by making the random sampling of certain parameters (certain
            = succeed "-components)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                  %annotation{:encoding => "application/x-tex"} \theta
          %p
            Correlation functions (w.r.t. input
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            and outputs
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
