                        %mo{:stretchy => "false"} (
                        %mi id
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi id
                        %mo{:stretchy => "false"} )
                    %mi 𝟙
                    %mo ⊕
                    %mi 𝟙
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    I_\bullet =
                    [
                    \\cdots \to 0 \to 0 \to \mathbb{1} \stackrel{(id,-id)}{\to}
                    \\mathbb{1} \oplus \mathbb{1}
                    ]
                    \\,.
          %p
            This is the standard
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/interval+in+chain+complexes"} interval in chain complexes
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
          #AsALeftHomotopy.num_prop
            %h6#proposition Proposition
            %p
              A chain homotopy
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                    %mo :
                    %mi f
                    %mo ⇒
                    %mi g
                  %annotation{:encoding => "application/x-tex"} \psi : f \Rightarrow g
              is equivalently a
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi C
                              %mo •
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %msub
                              %mi I
                              %mo •
                            %mo ⊗
                            %msub
                              %mi C
                              %mo •
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi f
                                %mo ,
                                %mi g
                                %mo ,
                                %mi ψ
                                %mo{:stretchy => "false"} )
                          %mtd
                            %msub
                              %mi D
                              %mo •
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↑
                          %mtd
                            %msub
                              %mo ↗
                              %mpadded{:width => "0"}
                                %mi g
                        %mtr
                          %mtd
                            %msub
                              %mi C
                              %mo •
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    C_\bullet
                    \\\
                    \\downarrow &amp; \searrow^{\mathrlap{f}}
                    \\\
                    I_\bullet\otimes C_\bullet
                    \&amp;\stackrel{(f,g,\psi)}{\to}&amp;
                    D_\bullet
                    \\\
                    \\uparrow &amp; \nearrow_{\mathrlap{g}}
                    \\\
                    C_\bullet
                    }
            %p
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Ch
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi 𝒜
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Ch_\bullet(\mathcal{A})
              %a.existingWikiWord{:href => "/nlab/show/left+homotopy"} left homotopy
              with respect to the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/interval+object+in+chain+complexes"} interval object in chain complexes
          .proof
            %h6#proof Proof
            %p
              For notational simplicity we discuss this in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                    %mo =
                  %annotation{:encoding => "application/x-tex"} \mathcal{A} =
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
            %p
              Observe that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} (
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} N_\bullet(\mathbb{Z}(\Delta[1]))
              is the chain complex
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ⋯
                    %mo →
                    %mn 0
                    %mo →
                    %mn 0
                    %mo →
                    %mi ℤ
                    %mover
                      %mo →
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi id
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi id
                        %mo{:stretchy => "false"} )
                    %mi ℤ
                    %mo ⊕
                    %mi ℤ
                    %mo →
                    %mn 0
                    %mo →
                    %mn 0
                    %mo →
                    %mi ⋯
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (  \cdots  \to 0   \to 0 \to \mathbb{Z} \stackrel{(id,-id)}{\to}  \mathbb{Z} \oplus \mathbb{Z} \to 0 \to 0 \to \cdots)
            %p
              where the term
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo ⊕
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z} \oplus \mathbb{Z}
              is in degree 0: this is the
              %a.existingWikiWord{:href => "/nlab/show/free+abelian+group"} free abelian group
              on the set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{0,1\}
              of 0-simplices in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \Delta[1]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              is the free abelian group on the single non-degenerate edge in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \Delta[1]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \Delta[1]
              are degenerate and hence do not contribute to the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/normalized+chain+complex"} normalized chain complex
              %a.existingWikiWord{:href => "/nlab/show/differential"} differential
              sends
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ∈
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} 1 \in \mathbb{Z}
              to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi ℤ
                      %mo ⊕
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} (1,-1) \in \mathbb{Z} \oplus \mathbb{Z}
              %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
              and the other is the 1-boundary of the single nontrivial edge.
            %p
              It follows that the
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+chain+complexes"} tensor product of chain complexes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi I
                      %mo •
                    %mo ⊗
                    %msub
                      %mi C
                      %mo •
                  %annotation{:encoding => "application/x-tex"} I_\bullet \otimes C_\bullet
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo →
                    %msub
                      %mi C
                      %mn 2
                    %mo ⊕
                    %msub
                      %mi C
                      %mn 2
                    %mo ⊕
                    %msub
                      %mi C
                      %mn 1
                    %mo →
                    %msub
                      %mi C
                      %mn 1
                    %mo ⊕
                    %msub
                      %mi C
                      %mn 1
                    %mo ⊕
                    %msub
                      %mi C
                      %mn 0
                    %mo →
                    %msub
                      %mi C
                      %mn 0
                    %mo ⊕
                    %msub
                      %mi C
                      %mn 0
                    %mo ⊕
                    %msub
                      %mi C
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo →
                    %mi ⋯
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots
                    \\to
                    C_2 \oplus C_{2} \oplus C_1
                    \\to C_1 \oplus C_{1} \oplus C_0 \to  C_0 \oplus C_0 \oplus C_{-1} \to \cdots
                    \\,.
            %p
              Therefore a chain map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi g
                    %mo ,
                    %mi ψ
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msub
                      %mi C
                      %mo •
                    %mo ⊗
                    %msub
                      %mi I
                      %mo •
                    %mo →
                    %msub
                      %mi D
                      %mo •
                  %annotation{:encoding => "application/x-tex"} (f,g,\psi) :  C_\bullet \otimes I_\bullet \to D_\bullet
              that restricted to the two copies of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mo •
                  %annotation{:encoding => "application/x-tex"} C_\bullet
              is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi C
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mo ⊕
                            %msub
                              %mi C
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mo ⊕
                            %msub
                              %mi C
                              %mi n
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi f
                                  %mrow
                                    %mi n
                                    %mo +
                                    %mn 1
                                %mo ,
                                %msub
                                  %mi g
                                  %mrow
                                    %mi n
                                    %mo +
                                    %mn 1
                                %mo ,
                                %msub
                                  %mi ψ
                                  %mi n
                                %mo{:stretchy => "false"} )
                          %mtd
                            %msub
                              %mi D
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msup
                                    %mo ∂
                                    %mi D
                        %mtr
                          %mtd
                            %msub
                              %mi C
                              %mi n
                            %mo ⊕
                            %msub
                              %mi C
                              %mi n
                            %mo ⊕
                            %msub
                              %mi C
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi f
                                  %mi n
                                %mo ,
                                %msub
                                  %mi g
                                  %mi n
                                %mo ,
                                %msub
                                  %mi ψ
                                  %mrow
                                    %mi n
                                    %mo −
                                    %mn 1
                                %mo{:stretchy => "false"} )
                          %mtd
                            %msub
                              %mi D
                              %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    C_{n+1}\oplus C_{n+1} \oplus C_{n}
                    \&amp;\stackrel{(f_{n+1},g_{n+1}, \psi_n)}{\to}&amp; D_{n+1}
                    \\\
                    {}^{\mathllap{}}\downarrow &amp;&amp; \downarrow^{\mathrlap{\partial^D}}
                    \\\
                    C_{n} \oplus C_{n} \oplus C_{n-1} &amp;\stackrel{(f_n,g_n,\psi_{n-1})}{\to}
                    \&amp;
                    D_n
                    }
                    \\,.
            %p
              On the elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %mn 0
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (1,0,0)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (0,1,0)
              in the top left this reduces to the chain map condition for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (0,0,1)
              this is the equation for the chain homotopy
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi n
                    %mo −
                    %msub
                      %mi g
                      %mi n
                    %mo −
                    %msub
                      %mi ψ
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %msub
                      %mi d
                      %mi C
                    %mo =
                    %msub
                      %mi d
                      %mi D
                    %msub
                      %mi ψ
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f_n - g_n - \psi_{n-1} d_C = d_D \psi_{n}
                    \\,.
          %h3#homotopy_equivalence Homotopy equivalence
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mo •
                  %mo ,
                  %msub
                    %mi D
                    %mo •
                  %mo ∈
                  %msub
                    %mi Ch
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi 𝒜
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C_\bullet, D_\bullet \in Ch_\bullet(\mathcal{A})
            be two chain complexes.
          .num_defn
            %h6#definition_4 Definition
            %p
              Define the
              %a.existingWikiWord{:href => "/nlab/show/relation"} relation
              %em chain homotopic
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mo •
                    %mo ,
                    %msub
                      %mi D
                      %mo •
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom(C_\bullet, D_\bullet)
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ∼
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo ⇔
                    %mo ∃
                    %mo{:stretchy => "false"} (
                    %mi ψ
                    %mo :
                    %mi f
                    %mo ⇒
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (f \sim g)
                    \\Leftrightarrow
                    \\exists (\psi : f \Rightarrow g)
                    \\,.
          .num_prop
            %h6#proposition_2 Proposition
            %p
              Chain homotopy is an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Hom
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi C
                        %mo •
                      %mo ,
                      %msub
                        %mi D
                        %mo •
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Hom(C_\bullet,D_\bullet)
          .num_prop
            %h6#proposition_3 Proposition
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mo •
                    %mo ,
                    %msub
                      %mi D
                      %mo •
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo ∼
                  %annotation{:encoding => "application/x-tex"} Hom(C_\bullet,D_\bullet)_{\sim}
              for the
              %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
              of the
              %a.existingWikiWord{:href => "/nlab/show/hom+set"} hom set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mo •
                    %mo ,
                    %msub
                      %mi D
                      %mo •
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom(C_\bullet,D_\bullet)
              by chain homotopy.
          .num_prop
            %h6#proposition_4 Proposition
            %p
              This quotient is compatible with
              %a.existingWikiWord{:href => "/nlab/show/composition"} composition
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/chain+maps"} chain maps
          %p
            Accordingly the following
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            exists:
          .num_defn
            %h6#definition_5 Definition
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒦
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{K}(\mathcal{A})
              for the category whose
              %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              are those of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Ch
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi 𝒜
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Ch_\bullet(\mathcal{A})
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              are chain homotopy classes of chain maps:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mrow
                        %mi 𝒦
                        %mo{:stretchy => "false"} (
                        %mi 𝒜
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mo •
                    %mo ,
                    %msub
                      %mi D
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msub
                      %mi Hom
                      %mrow
                        %msub
                          %mi Ch
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi 𝒜
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mo •
                    %mo ,
                    %msub
                      %mi D
                      %mo •
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo ∼
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{\mathcal{K}(\mathcal{A})}(C_\bullet, D_\bullet)
                    \\coloneqq
                    Hom_{Ch_\bullet(\mathcal{A})}(C_\bullet, D_\bullet)_\sim
                    \\,.
            %p
              This is usually called the
              %strong
                %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+chain+complexes"} homotopy category of chain complexes
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} \mathcal{A}
          .num_remark
            %h6#remark_2 Remark
            %p
              Beware, as discussed there, that another category that would deserve to carry this name instead is called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/derived+category"} derived category
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} \mathcal{A}
              %a.existingWikiWord{:href => "/nlab/show/domain"} domain
              of the two chain maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              is refined along a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
