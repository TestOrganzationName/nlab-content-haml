                %annotation{:encoding => "application/x-tex"}
                  \\array {
                  T' \\
                  n \downarrow \downarrow n' &amp; \searrow^{m'_i} \\
                  T                          &amp; \underset{m_i}\rightarrow &amp; S_i
                  } \;\;\; \stackrel{U}\mapsto \;\;\; \array {
                  U(T') \\
                  U(n) \downarrow \downarrow U(n') &amp; \searrow^{g'}                         &amp;                                  &amp; \searrow^{U(m'_i)} \\
                  U(T)                             &amp; = &amp; X                                &amp; \underset{f_i}\rightarrow &amp; U(S_i) \\
                  \&amp;                                       &amp; \underset{U(m_i)}\longrightarrow
                  }
          %p
            It follows by a clever argument that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:lspace => "verythinmathspace"} :
                  %mi C
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} U\colon C \to D
            must be
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/faithful+functor"} faithful
            = succeed "." do
              %a{:href => "http://katmat.math.uni-bremen.de/acc", :title => "Abstract and Concrete Categories"} ACC
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            can be left out. Thus we may think of objects of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            as objects of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            equipped with
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/extra+structure"} extra structure
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            equipped with the
            %strong initial structure
            or
            %strong
              %a.existingWikiWord{:href => "/nlab/show/weak+structure"} weak structure
            determined by the requirement that the homomorphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi i
                %annotation{:encoding => "application/x-tex"} f_i
            be structure-preserving maps.
          %p
            The dual concept could be called a
            = succeed "." do
              %em cotopological category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:lspace => "verythinmathspace"} :
                  %mi C
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} U\colon C \to D
            is topological if and only if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi U
                    %mi op
                  %mo{:lspace => "verythinmathspace"} :
                  %msup
                    %mi C
                    %mi op
                  %mo →
                  %msup
                    %mi D
                    %mi op
                %annotation{:encoding => "application/x-tex"} U^op\colon C^op \to D^op
            is. This is a
            %a.existingWikiWord{:href => "/nlab/show/categorification"} categorification
            of the theorem that any complete
            %a.existingWikiWord{:href => "/nlab/show/semilattice"} semilattice
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/complete+lattice"} complete lattice
            %strong final
            (not usually called
            = succeed ")" do
              %em terminal
            %strong
              %a.existingWikiWord{:href => "/nlab/show/strong+structure"} strong
            structures, each determined by a family of homomorphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi i
                  %mo{:lspace => "verythinmathspace"} :
                  %mi U
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi S
                    %mi i
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} f_i\colon U(S_i) \to X
            (a
            = succeed "-structured" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            %a.existingWikiWord{:href => "/nlab/show/sink"} sink
            to
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            Both of these results (faithfulness and self-duality) depend on the fact that we have allowed the family
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi S
                    %mi i
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{S_i\}
            to be potentially
            = succeed "." do
              %em large
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is a large category with all (small) products, then the functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo →
                  %mn 1
                %annotation{:encoding => "application/x-tex"} C \to 1
            to the
            %a.existingWikiWord{:href => "/nlab/show/terminal+category"} terminal category
            satisfies the above lifting property for small families
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi S
                      %mi i
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{S_i\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            also has all small coproducts) nor need it be faithful.
          %p
            It also follows that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            is a
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+fibration"} Grothendieck fibration
            and opfibration.
          %h3#amnestic_version Amnestic version
          %p
            Since initial lifts have a universal property, they are unique up to unique isomorphism. However, it is traditional in some literature to ask that they be literally unique (this is done for instance in
            = succeed ")." do
              %a{:href => "http://katmat.math.uni-bremen.de/acc", :title => "Abstract and Concrete Categories"} ACC
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            should be an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/amnestic+functor"} amnestic functor
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/nPOV"} nPOV
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/principle+of+equivalence"} principle of equivalence
          %p
            Thus, although it occurs in the literature, here we will consider it purely optional. (It is possible that some results recorded here about topological categories will depend on this assumption, but only results not respecting the
            %a.existingWikiWord{:href => "/nlab/show/principle+of+equivalence"} principle of equivalence
            could be affected.)
          %h3#weak_version Weak version
          %p
            On the other hand, the default definition above does already refer to equality of objects in the condition
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U(T)=X
            %em already
            violates the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/principle+of+equivalence"} principle of equivalence
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+fibration"} Grothendieck fibration
            does. But (also as for Grothendieck fibrations) this other use of equality of objects is really more of a “typing judgment”, which can be made precise by working with
            %a.existingWikiWord{:href => "/nlab/show/displayed+categories"} displayed categories
            instead. (In the context of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
            = succeed "\u201D.)" do
              %a.existingWikiWord{:href => "/nlab/show/internal+category+in+homotopy+type+theory"} univalence
          %p
            However, if we want to, we can also formulate a “fully isomorphism-invariant” version of the definition, corresponding to the weakened bicategorical notion of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Street+fibration"} Street fibration
          %ul
            %li
              %p
                a space
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                      %annotation{:encoding => "application/x-tex"} T
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mo{:lspace => "verythinmathspace"} :
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mi T
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} g\colon U(T) \to X
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi m
                        %mi i
                      %mo{:lspace => "verythinmathspace"} :
                      %mi T
                      %mo →
                      %msub
                        %mi S
                        %mi i
                    %annotation{:encoding => "application/x-tex"} m_i\colon T \to S_i
                such that each
                %a.existingWikiWord{:href => "/nlab/show/composite"} composite
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo ;
                      %msub
                        %mi f
                        %mi i
                    %annotation{:encoding => "application/x-tex"} g ; f_i
                equals
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi m
                        %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U(m_i)
                and,
            %li
              %p
                given any space
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                        %mo ′
                      %annotation{:encoding => "application/x-tex"} T'
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mo ′
                        %mo{:lspace => "verythinmathspace"} :
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mi T
                        %mo ′
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} g'\colon U(T') \to X
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi m
                        %msub
                          %mo ′
                          %mi i
                        %mo{:lspace => "verythinmathspace"} :
                        %mi T
                        %mo ′
                        %mo →
                        %msub
                          %mi S
                          %mi i
                      %annotation{:encoding => "application/x-tex"} m'_i\colon T' \to S_i
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo ′
                      %mo ;
                      %msub
                        %mi f
                        %mi i
                    %annotation{:encoding => "application/x-tex"} g' ; f_i
                equals
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mi m
                        %msub
