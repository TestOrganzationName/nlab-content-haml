            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mi i
                %annotation{:encoding => "application/x-tex"} S_i
            and homomorphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi i
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo →
                  %mi U
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi S
                    %mi i
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f_i\colon X \to U(S_i)
            (that is, a “
