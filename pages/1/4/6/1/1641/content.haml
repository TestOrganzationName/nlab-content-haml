                        %mi m
                        %msub
                          %mo ′
                          %mi i
                        %mo{:lspace => "verythinmathspace"} :
                        %mi T
                        %mo ′
                        %mo →
                        %msub
                          %mi S
                          %mi i
                      %annotation{:encoding => "application/x-tex"} m'_i\colon T' \to S_i
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo ′
                      %mo ;
                      %msub
                        %mi f
                        %mi i
                    %annotation{:encoding => "application/x-tex"} g' ; f_i
                equals
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mi m
                        %msub
                          %mo ′
                          %mi i
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} U(m'_i)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo{:lspace => "verythinmathspace"} :
                      %mi T
                      %mo ′
                      %mo →
                      %mi T
                    %annotation{:encoding => "application/x-tex"} n\colon T' \to T
                such that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi g
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} U(n) = g'
                and
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
