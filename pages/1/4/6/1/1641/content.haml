          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Ji%C5%99%C3%AD+Ad%C3%A1mek"}> Jiří Adámek
              , Horst Herrlich, &amp; George E. Strecker; 1990; Abstract and Concrete Categories; originally published John Wiley &amp; Sons ISBN 0-471-60922-6;
              %a{:href => "http://katmat.math.uni-bremen.de/acc", :title => "Abstract and Concrete Categories"} free on-line edition
              (4.2MB PDF).
          %ul#Preuss
            %li
              Gerhard Preuss; 2002;
              = succeed ";" do
                %em Foundations of Topology: An Approach to Convenient Topology
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Richard+Garner"}> Richard Garner
                ,
                = succeed "," do
                  %em Topological functors as total categories
                %a{:href => "http://www.tac.mta.ca/tac/volumes/29/15/29-15abs.html"} TAC
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Eduardo+J.+Dubuc"}> Eduardo J. Dubuc
                , Luis Español,
                %em Topological functors as familiarly fibrations
              %p
                %a{:href => "https://arxiv.org/abs/math/0611701"} arXiv
                (2006)
            %li
              %p
                J. Martin Harvey,
                = succeed "," do
                  %em Topological functors from factorization
