                          %mi i
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} U(m'_i)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo{:lspace => "verythinmathspace"} :
                      %mi T
                      %mo ′
                      %mo →
                      %mi T
                    %annotation{:encoding => "application/x-tex"} n\colon T' \to T
                such that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                      %mo ;
                      %mi g
                      %mo =
                      %mi g
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} U(n) ; g = g'
                and
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo ;
