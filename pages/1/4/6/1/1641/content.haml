                        %mi n
                        %mo ;
                        %msub
                          %mi m
                          %mi i
                        %mo =
                        %mi m
                        %msub
                          %mo ′
                          %mi i
                      %annotation{:encoding => "application/x-tex"} n ; m_i = m'_i
          %p Here are some illustrative commutative diagrams (if you can read them):
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi T
                          %mo ′
                      %mtr
                        %mtd
                          %mi n
