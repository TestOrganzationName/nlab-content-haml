                  %a{:href => "https://arxiv.org/abs/1703.02470"} arXiv:1703.02470
                = succeed ")" do
                  %a{:href => "https://www.springer.com/gp/book/9783319648125"} doi:10.1007/978-3-319-64813-2
          %h3#exotica_leptoquarks_bosons_etc
            Exotica: Leptoquarks,
            = succeed "-bosons," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Z
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} Z'
          %p Topological defects can play considerable role to constrain the non-SUSY and SUSY GUTs:
          %ul
            %li
              Joydeep Chakrabortty, Rinku Maji, Sunando Kumar Patra, Tripurari Srivastava, Subhendra Mohanty,
              %em Roadmap of left-right models based on GUTs
              (
              %a{:href => "https://arxiv.org/abs/1711.11391"}> arXiv:1711.11391
              , Phys.Rev. D97 (2018) no.9, 095010.)
          %p
            Relation to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Z%27-bosons"} Z'-bosons
          %ul
            %li#Sahoo06
              S. Sahoo,
              = succeed "," do
                %em
                  The prediction of mass of
                  = succeed "-boson" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Z
                          %mo ′
                        %annotation{:encoding => "application/x-tex"} Z'
                  = succeed "-based" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi SO
                          %mo{:stretchy => "false"} (
                          %mn 10
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} SO(10)
              = succeed ")" do
                %a{:href => "http://arxiv.iacs.res.in:8080/jspui/bitstream/10821/6019/1/The%20Prediction%20of%20Mass%20of%20Z%27-Boson_By%20S%20Sahoo.pdf"} pdf
          %p
            Relation to
            %a.existingWikiWord{:href => "/nlab/show/leptoquarks"} leptoquarks
            and
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/flavour+anomalies"} flavour anomalies
          %ul
            %li#MurayamaYanagida92
              %p
                H. Murayama, T. Yanagida,
                = succeed "," do
                  %em
                    A viable
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi SU
                          %mo{:stretchy => "false"} (
                          %mn 5
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} SU(5)
                    GUT with light leptoquark bosons
                = succeed "," do
                  %a{:href => "inspirehep.net/record/315898"} arXiv:315898
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1142/S0217732392000070"} doi:10.1142/S0217732392000070
            %li#BDFKFS18
              %p
                Damir Bečirević, Ilja Doršner, Svjetlana Fajfer, Nejc Košnik, Darius A. Faroughy, Olcyr Sumensari,
                = succeed "," do
                  %em
                    Scalar leptoquarks from GUT to accommodate the
                    = succeed "-physics" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi B
                          %annotation{:encoding => "application/x-tex"} B
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1806.05689"} arXiv:1806.05689
            %li#AMM19
              %p
                Ufuk Aydemir, Tanumoy Mandal, Subhadip Mitra,
                %em A single TeV-scale scalar leptoquark in SO(10) grand unification and B-decay anomalies
                (
                %a{:href => "https://arxiv.org/abs/1902.08108"}> arXiv:1902.08108
                )
            %li#HeekTeresi18
              %p
                Julian Heeck, Daniele Teresi,
                = succeed "," do
                  %em Pati-Salam explanations of the B-meson anomalies
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1808.07492"} arXiv:1808.07492
            %li#HeekTeresi19
              %p
                Julian Heeck, Daniele Teresi,
                %em Pati-Salam and lepton universality in B decays
                (
                %a{:href => "https://arxiv.org/abs/1905.05211"}> arXiv:1905.05211
                )
            %li#Malinsky19
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michal+Malinsk%C3%BD"}> Michal Malinský
                ,
                %em
                  Lepton non-universality in
                  = succeed "-decays" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi B
                        %annotation{:encoding => "application/x-tex"} B
                (
                %a{:href => "https://arxiv.org/abs/1906.09174"}> arXiv:1906.09174
                )
            %li
              %p
                Shyam Balaji, Michael A. Schmidt,
                %em
                  A unified
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi SU
                        %mo{:stretchy => "false"} (
                        %mn 4
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} SU(4)
                  theory for the
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi R
                          %mi D
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mo *
                            %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} R_D^{(\ast)}
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi R
                          %mi K
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mo *
                            %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} R_K^{(\ast)}
                  anomalies
                (
                %a{:href => "https://arxiv.org/abs/1911.08873"}> arXiv:1911.08873
                )
          %p
            Modeled
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/intersecting+D-brane+model"} on branes
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Javier+Fuentes-Martin"}> Javier Fuentes-Martin
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Gino+Isidori"} Gino Isidori
              %p
                %em> Flavor Non-universal Pati-Salam Unification and Neutrino Masses
                , Physics Letters B Volume 820, 10 September 2021, 136484 (
                %a{:href => "https://arxiv.org/abs/2012.10492"}> arXiv:2012.10492
                ,
                = succeed ")" do
                  %a{:href => "https://www.youtube.com/watch?v=ko4R8S8XYV4&t=2s"} talk recording
