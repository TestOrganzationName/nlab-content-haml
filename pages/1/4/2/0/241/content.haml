                  %a{:href => "#as_lex_reflections_of_categories_of_presheaves"} As lex reflections of categories of presheaves
                %li
                  %a{:href => "#AsLocalicGroupoids"} As localic groupoids
                %li
                  %a{:href => "#internal_logic"} Internal logic
                %li
                  %a{:href => "#2monadicity_over_locally_presentable_categories"} 2-monadicity over locally presentable categories
                %li
