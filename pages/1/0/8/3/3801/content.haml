                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://arxiv.org/abs/math/0602210"} math.AT/0602210
              %blockquote
                %p
                  (and generalizing from
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
