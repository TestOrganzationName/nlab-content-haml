                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P_X(A,B)
            for the
            %a.existingWikiWord{:href => "/nlab/show/path+space"} path space
            of paths in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            that start in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ⊂
                  %mi X
                %annotation{:encoding => "application/x-tex"} A \subset X
            and end in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} B \subset X
          .num_theorem
            %h6#theorem_3 Theorem
            %p
              The tuple
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mi M
                    %mo ,
                    %mi ℚ
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi P
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi ℚ
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi A
                        %mo ,
                        %mi B
                        %mo ∈
                        %mi ℬ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (H_\bullet(L M, \mathbb{Q}), \{H_\bullet(P_X(A,B), \mathbb{Q})\}_{A,B \in \mathcal{B}})
              carries the structure of a
              = succeed "-dimensional" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                    %annotation{:encoding => "application/x-tex"} d
              %a.existingWikiWord{:href => "/nlab/show/HCFT"} HCFT
              with
              %em positive boundary
              and set of
              %a.existingWikiWord{:href => "/nlab/show/branes"} branes
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℬ
                    %annotation{:encoding => "application/x-tex"} \mathcal{B}
          %p
            For
            %a.existingWikiWord{:href => "/nlab/show/closed+strings"} closed strings
            this is discussed by
            = succeed "," do
              %a{:href => "#CohenGodin03"} Cohen &amp; Godin 2003
            = succeed "." do
              %a{:href => "#Tamanoi07"} Tamanoi 2007
            %a.existingWikiWord{:href => "/nlab/show/open+strings"} open strings
            on a single space-filling
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/brane"} brane
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℬ
