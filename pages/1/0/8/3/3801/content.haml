            = succeed "." do
              %a{:href => "#Kupers11"} Kupers 2011
          .num_remark
            %h6#remark Remark
            %p
              These constructions work by regarding the
              %a.existingWikiWord{:href => "/nlab/show/mapping+spaces"} mapping spaces
              from 2-dimensional
              %a.existingWikiWord{:href => "/nlab/show/cobordisms"} cobordisms
              with maps to the base space as
              %a.existingWikiWord{:href => "/nlab/show/correspondences"} correspondences
              and then applying pull-push (pullback followed by
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/push-forward+in+generalized+cohomology"} push-forward in cohomology
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Umkehr+maps"} Umkehr maps
              %a.existingWikiWord{:href => "/nlab/show/quantization"} quantization
              process of the form
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/path+integral+as+a+pull-push+transform"}> path integral as a pull-push transform
                  \/
                  %a.existingWikiWord{:href => "/nlab/show/motivic+quantization"} motivic quantization
          %p
          #OpenStringProductOn0BraneIsPontrjaginProduct.num_remark
            %h6 Example
            %p
              %strong (open string product on 0-brane is Pontrjagin product)
              %br/
              For the case of a single brane being a 0-brane, hence a point
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mi x
                      %mo{:stretchy => "false"} }
                      %mo ↪
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \{x\} \hookrightarrow X
            %ol
              %li
                %p
                  the open string configuration spaces is the
                  %a.existingWikiWord{:href => "/nlab/show/based+loop+space"} based loop space
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi P
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ,
                          %mi x
                          %mo{:stretchy => "false"} )
                          %mo =
                          %msub
                            %mi Ω
                            %mi x
                          %mi X
                        %annotation{:encoding => "application/x-tex"} P(x,x)  = \Omega_x X
              %li
                %p
                  whence the homology is the
                  %a.existingWikiWord{:href => "/nlab/show/homology+of+loop+spaces"} homology of loop spaces
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi H
                            %mo •
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi Ω
                            %mi x
                          %mi X
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} H_\bullet(\Omega_x X)
              %li
                %p
                  the open string product coincides with the
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Pontrjagin+product"} Pontrjagin product
                #eq:PontrjaginProduct.maruku-equation
                  %span.maruku-eq-number (1)
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi conc
                          %mi x
                        %msub
                          %mo{:stretchy => "false"} )
                          %mo *
                        %mo{:lspace => "verythinmathspace"} :
                        %msub
                          %mi H
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi Ω
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo ⊗
                        %msub
                          %mi H
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi Ω
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %msub
                          %mi H
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi Ω
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mpadded{:width => "0"}
                          %mrow
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        (conc_x)_\ast
                        \\colon
                        H_\bullet(\Omega X) \otimes H_\bullet(\Omega X)
                        \\longrightarrow
                        H_\bullet(\Omega X)
                        \\mathrlap{\,,}
                %p given simply by pushforward in homology along the loop concatenation map
                #eq:BasedLoopConcatenationMap.maruku-equation
                  %span.maruku-eq-number (2)
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi conc
                          %mi x
                        %mo{:lspace => "verythinmathspace"} :
                        %msub
                          %mi Ω
                          %mi x
                        %mi X
                        %mo ×
                        %msub
                          %mi Ω
                          %mi x
                        %mi X
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} longrightarrpw
                        %msub
                          %mi Ω
                          %mi x
                        %mi X
                        %mpadded{:width => "0"}
                          %mrow
                            %mspace{:width => "thinmathspace"}
                            %mo .
                      %annotation{:encoding => "application/x-tex"}
                        conc_x
                        \\colon
                        \\Omega_x X \times \Omega_x X
                        \\longrightarrpw
                        \\Omega_x X
                        \\mathrlap{\,.}
            %p
          (
          %a{:href => "#Sullivan05SFT"}> Sullivan 2005 SFT, Ex. 3
          )
          .proof
            %h6 Proof
            %p
              The first two statements are immediate from the definitions. The third statement is a special case of the explicit formula for the open string product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mrow
                        %mi a
                        %mo ,
                        %mi b
                        %mo ,
                        %mi c
                  %annotation{:encoding => "application/x-tex"} \mu_{a,b,c}
              (here:
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi μ
                        %mrow
                          %mi x
                          %mo ,
                          %mi x
                          %mo ,
                          %mi x
                    %annotation{:encoding => "application/x-tex"} \mu_{x,x,x}
              %a{:href => "#Kupers11"} Kupers 2011
              = succeed ":" do
                %a{:href => "/nlab/files/Kupers-StringTopology.pdf#page=143"} p. 137
            %p
              In our case of a 0-brane, the map denoted “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msup
                      %mi M
                      %mi i
                  %annotation{:encoding => "application/x-tex"} M^i
              ” there (on the previous
              = succeed ")," do
                %a{:href => "/nlab/files/Kupers-StringTopology.pdf#page=142"} p. 136
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              = succeed "\u201D" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi M
                        %mi j
                    %annotation{:encoding => "application/x-tex"} M^j
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi conc
                      %mi x
                  %annotation{:encoding => "application/x-tex"} conc_x
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:BasedLoopConcatenationMap"} (2)
              %a.existingWikiWord{:href => "/nlab/show/Pontrjagin+product"} Pontrjagin product
              = succeed ":" do
                %a.maruku-eqref{:href => "#eq:PontrjaginProduct"} (1)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi μ
                              %mrow
                                %mi x
                                %mo ,
                                %mi x
                                %mo ,
                                %mi x
                          %mtd
                            %mo ≔
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi M
                              %mi j
                            %msub
                              %mo{:stretchy => "false"} )
                              %mo *
                            %mo ∘
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi M
                              %mi i
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo !
                        %mtr
                          %mtd
                          %mtd
                            %mo ≡
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi conc
                              %mi x
                            %msub
                              %mo{:stretchy => "false"} )
                              %mo *
                            %mo ∘
                            %mo{:stretchy => "false"} (
                            %mi id
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo !
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi conc
                              %mi x
                            %msub
                              %mo{:stretchy => "false"} )
                              %mo *
                            %mpadded{:width => "0"}
                              %mrow
                                %mspace{:width => "thinmathspace"}
                                %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\mu_{x,x,x}
                    \&amp; \coloneqq (M^j)_\ast \circ (M^i)^!
                    \\\
                    \&amp; \equiv (conc_x)_\ast \circ (id)^!
                    \\\
                    \&amp; \simeq (conc_x)_\ast
                    \\mathrlap{\,.}
                    \\end{aligned}
            %p
