                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℬ
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi A
                  %mo ,
                  %mi B
                  %mo ,
                  %mi ⋯
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \mathcal{B} = \{A, B , \cdots\}
            a collection of oriented compact submanifolds write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi P
                    %mi X
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
