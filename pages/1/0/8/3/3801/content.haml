          %h2#idea Idea
          %p
            In
            %strong string topology
            one studies the
            = succeed "-structure" do
              %a.existingWikiWord{:href => "/nlab/show/BV-algebra"} BV-algebra
            %a.existingWikiWord{:href => "/nlab/show/ordinary+homology"} ordinary homology
            of the
            %a.existingWikiWord{:href => "/nlab/show/free+loop+space"} free loop space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                %annotation{:encoding => "application/x-tex"} X^{S^1}
            of an
            %a.existingWikiWord{:href => "/nlab/show/oriented"} oriented
            %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "-structure" do
              %a.existingWikiWord{:href => "/nlab/show/framed+little+2-disk+operad"} framed little 2-disk algebra
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Hochschild+cohomology"} Hochschild cohomology
          %p
            The study of
            %em string topology
            was initated by
            %a.existingWikiWord{:href => "/nlab/show/Moira+Chas"} Moira Chas
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Dennis+Sullivan"} Dennis Sullivan
          %h2#the_string_operations The string operations
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            be a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mi X
                %annotation{:encoding => "application/x-tex"} L X
            for its
            %a.existingWikiWord{:href => "/nlab/show/free+loop+space"} free loop space
            (for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            regarded as a
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H_\bullet(L X)
            for the
            %a.existingWikiWord{:href => "/nlab/show/ordinary+homology"} ordinary homology
            of this space (with coefficients in the
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/integer"} integer
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
          %h3#the_string_product The string product
          .num_defn
            %h6#definition Definition
            %p
              The
              %strong string product
              is a morphism of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %msub
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mi H
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi dim
                        %mi X
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (-)\cdot(-)
                    \\;\colon\;
                    H_\bullet(L X) \otimes H_\bullet(L X)
                    \\longrightarrow
                    H_{\bullet - dim X}(L X)
            %p
              (where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi dim
                    %mi X
                  %annotation{:encoding => "application/x-tex"} dim X
              is the
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              of
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ev
                      %mo *
                    %mo{:lspace => "verythinmathspace"} :
                    %mi L
                    %mi X
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} ev_* \colon L X \to X
              for the
              %a.existingWikiWord{:href => "/nlab/show/evaluation+map"} evaluation map
              at the basepoint of the loops.
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi α
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %msub
                      %mi H
                      %mi i
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} [\alpha] \in H_i(L X)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi β
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %msub
                      %mi H
                      %mi j
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} [\beta] \in H_j(L X)
              we can find representatives
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                  %annotation{:encoding => "application/x-tex"} \beta
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ev
                    %mo{:stretchy => "false"} (
                    %mi α
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ev(\alpha)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ev
                    %mo{:stretchy => "false"} (
                    %mi β
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ev(\beta)
              intersect
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/transversal+map"} transversally
              = succeed "-chain" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo +
                      %mi j
                      %mo{:stretchy => "false"} )
                      %mo −
                      %mi dim
                      %mi X
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %annotation{:encoding => "application/x-tex"} \big((i+j)-dim X\big)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo ⋅
                    %mi β
                  %annotation{:encoding => "application/x-tex"} \alpha \cdot \beta
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ev
                    %mo{:stretchy => "false"} (
                    %mi α
                    %mo ⋅
                    %mi β
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ev(\alpha \cdot \beta)
              is the chain given by that intersection: above
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi ev
                    %mo{:stretchy => "false"} (
                    %mi α
                    %mo ⋅
                    %mi β
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x \in ev(\alpha \cdot \beta)
              this is the loop obtained by concatenating
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi α
                      %mi x
                  %annotation{:encoding => "application/x-tex"} \alpha_x
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi β
                      %mi x
                  %annotation{:encoding => "application/x-tex"} \beta_x
              at their common basepoint. The
              %em string product
              is then defined using such representatives by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi α
                    %mo{:stretchy => "false"} ]
                    %mo ⋅
                    %mo{:stretchy => "false"} [
                    %mi β
                    %mo{:stretchy => "false"} ]
                    %mo ≔
                    %mo{:stretchy => "false"} [
                    %mi α
                    %mo ⋅
                    %mi β
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [\alpha] \cdot [\beta]
                    \\coloneqq
                    [\alpha \cdot \beta]
                    \\,.
          .num_theorem
            %h6#theorem Theorem
            %p
              The string product is
              %a.existingWikiWord{:href => "/nlab/show/associativity"} associative
              and graded-commutative.
          %p
            This is due to
            = succeed "." do
              %a{:href => "#ChasSullivan"} Chas &amp; Sullivan
            = succeed ":" do
              %a{:href => "#CohenJones"} Cohen &amp; Jones
          %p Let
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mn 1
                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                  %msup
                    %mi S
                    %mn 1
                  %mo →
                  %mn 8
                  %mo ←
                  %msup
                    %mi S
                    %mn 1
                %annotation{:encoding => "application/x-tex"}
                  S^1 \coprod S^1 \to 8 \leftarrow S^1
          %p
            be the
            %a.existingWikiWord{:href => "/nlab/show/cospan"} cospan
            that exhibts the inner and the outer circle of the figure “8” topological space. By forming
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/hom+space"} hom space
            %a.existingWikiWord{:href => "/nlab/show/span"} span
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mi X
                            %mn 8
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi in
                          %mo ↙
                        %mtd
                        %mtd
                          %msup
                            %mo ↘
                            %mpadded{:width => "0"}
                              %mi out
                      %mtr
                        %mtd
                          %mi L
                          %mi X
                          %mo ×
                          %mi L
                          %mi X
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mi L
                          %mi X
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; X^8
                  \\\
                  \&amp; {}^{\mathllap{in}}\swarrow &amp;&amp; \searrow^{\mathrlap{out}}
                  \\\
                  L X \times L X &amp;&amp;&amp;&amp; L X
                  }
                  \\,.
          %p
            Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi in
                    %mo !
                %annotation{:encoding => "application/x-tex"} in^!
            for the “pullback” in
            %a.existingWikiWord{:href => "/nlab/show/ordinary+homology"} ordinary homology
            along
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi in
                %annotation{:encoding => "application/x-tex"} in
            (the dual
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/fiber+integration"} fiber integration
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi out
                    %mo *
                %annotation{:encoding => "application/x-tex"} out_*
            for the ordinary pushforward.
          .num_theorem
            %h6#theorem_2 Theorem
            %p The string product is the pull-push operation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi out
                      %mo *
                    %mo ∘
                    %msup
                      %mi in
                      %mo !
                    %mo :
                    %msub
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mi X
                    %mo ×
                    %mi L
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %msub
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi dim
                        %mi X
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    out_* \circ in^! : H_\bullet(L X \times L X)
                    \\simeq H_\bullet(L X) \otimes H_\bullet(L X)
                    \\to
                    H_{\bullet - dim X}(L X)
                    \\,.
          %p
            This is due to
            = succeed "." do
              %a{:href => "#CohenJones"} Cohen &amp; Jones
          %h3#the_bvoperator The BV-operator
          .num_defn
            %h6#definition_2 Definition
            %p
              Define a morphism of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo :
                    %msub
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Delta : H_\bullet(L X) \to H_{\bullet + 1}(L X)
            %p as follows. Consider first the rotation map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo :
                    %msup
                      %mi S
                      %mn 1
                    %mo ×
                    %mi L
                    %mi X
                    %mo →
                    %mi L
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\rho : S^1 \times L X \to L X
            %p
              that sends
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi θ
                      %mo ,
                      %mi γ
                      %mo{:stretchy => "false"} )
                      %mo ↦
                      %mo{:stretchy => "false"} (
                      %mi t
                      %mo ↦
                      %mi γ
                      %mo{:stretchy => "false"} (
                      %mi θ
                      %mo +
                      %mi t
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\theta, \gamma) \mapsto (t \mapsto \gamma(\theta + t))
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi a
                    %mo ↦
                    %msub
                      %mi ρ
                      %mo *
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi S
                      %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ×
                    %mi a
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\Delta \colon a \mapsto \rho_* \big([S^1] \times a\big)
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi S
                      %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %msub
                      %mi H
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} [S^1] \in H_1(S^1)
              is the
              %a.existingWikiWord{:href => "/nlab/show/fundamental+class"} fundamental class
              of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/circle"} circle
          %p
            This is called the
            %strong BV-operator
            for string topology.
          .num_prop
            %h6#proposition Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Goldman+bracket"} Goldman bracket
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H_0(L X)
              is equivalent to the string product applied to the image of the BV-operator
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi γ
                      %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi γ
                      %mn 2
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} }
                    %mo =
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi Γ
                      %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ⋅
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi Γ
                      %mn 2
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\{[\gamma_1], [\gamma_2]\}
                    \=
                    \\Delta[\Gamma_1] \cdot \Delta[\Gamma_2]
                    \\,.
          %p
            This is due to
            = succeed "." do
              %a{:href => "#ChasSullivan"} Chas &amp; Sullivan
          %h2#properties Properties
          %h3#InTermsOfTQFTs As a TQFT
          %p
            The structures studied in the
            %em string topology
            of a
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            may be understood as being essentially the data of a 2-dimensional
            %a.existingWikiWord{:href => "/nlab/show/topological+field+theory"} topological field theory
            %a.existingWikiWord{:href => "/nlab/show/sigma+model"} sigma model
            with
            %a.existingWikiWord{:href => "/nlab/show/target+space"} target space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/HQFT"} HQFT
            (with due care on some technical subtleties).
          %p
            The idea is that the
            %a.existingWikiWord{:href => "/nlab/show/configuration+space"} configuration space
            of a closed or open
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/string"} string
            %a.existingWikiWord{:href => "/nlab/show/sigma-model"} sigma-model
            propagating on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is the
            %a.existingWikiWord{:href => "/nlab/show/loop+space"} loop space
            or path space of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/state"} state
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H_\bullet(L X)
            is an approximation. The string topology operations are then the
            = succeed "-representation" do
              %a.existingWikiWord{:href => "/nlab/show/cobordism"} cobordism
            %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
            in the
            %a.existingWikiWord{:href => "/nlab/show/category+of+chain+complexes"} category of chain complexes
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Bord
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi Ch
                    %mo •
                %annotation{:encoding => "application/x-tex"}
                  H_\bullet(Bord_2) \to Ch_\bullet
          %p
            given by the
            %a.existingWikiWord{:href => "/nlab/show/FQFT"} FQFT
            corresponding to the
            = succeed "-modelon" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"} \,,
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            be an
            %a.existingWikiWord{:href => "/nlab/show/orientation"} oriented
            %a.existingWikiWord{:href => "/nlab/show/compact+space"} compact
