          %h2#idea Idea
          %p
            In the context of
            %a.existingWikiWord{:href => "/nlab/show/factorization+systems"} factorization systems
            such as they appear notably in
            %a.existingWikiWord{:href => "/nlab/show/enriched+model+category"} enriched model category
            one frequently needs to handle iterated
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/lifting+problems"} lifting problems
            = succeed ")" do
              %a{:href => "#JoyalTierney"} Joyal–Tierney, 06
          %p
            A central point of it is to have the statement of prop.
            %a.maruku-ref{:href => "#IteratedLifting"}
            below be easily expressible in terms of “division on both sides”-operations.
          %h2#TheCalculus The calculus
          %h3#lifting Lifting
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} \mathcal{E}
            be a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            (
            %a.existingWikiWord{:href => "/nlab/show/locally+small+category"}> locally small
            ).
          .num_defn
            %h6#notation Notation
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ,
                      %mi g
                      %mo ∈
                      %mi Mor
                      %mo{:stretchy => "false"} (
                      %mi ℰ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f, g \in Mor(\mathcal{E})
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thinmathspace"}
                    %mi ⧄
                    %mspace{:width => "thinmathspace"}
                    %mi g
                  %annotation{:encoding => "application/x-tex"}
                    f \,&amp;solb;\, g
            %p
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              has the
              %a.existingWikiWord{:href => "/nlab/show/left+lifting+property"} left lifting property
              against
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              has the
              %a.existingWikiWord{:href => "/nlab/show/right+lifting+property"} right lifting property
              against
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ∈
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} S \in \mathcal{E}
              an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/object"} object
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thinmathspace"}
                    %mi ⧄
                    %mspace{:width => "thinmathspace"}
                    %mi S
                  %annotation{:encoding => "application/x-tex"}
                    f \,&amp;solb;\, S
            %p
              to indicate that for the morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f : X \to Y
              the induced
              %a.existingWikiWord{:href => "/nlab/show/hom+set"} hom set
              morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi ℰ
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ℰ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{E}(f, S) : \mathcal{E}(Y,S) \to \mathcal{E}(X,S)
            %p is surjective, dually for
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mspace{:width => "thinmathspace"}
                    %mi ⧄
                    %mspace{:width => "thinmathspace"}
                    %mi f
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S \,&amp;solb;\, f
                    \\,.
            %p
              In the case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              has a
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} *
              we have equivalently
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thinmathspace"}
                    %mi ⧄
                    %mspace{:width => "thinmathspace"}
                    %mi S
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ⇔
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi f
                    %mspace{:width => "thinmathspace"}
                    %mi ⧄
                    %mspace{:width => "thinmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo →
                    %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    f \,&amp;solb;\, S
                    \\;\;\Leftrightarrow\;\;
                    f \,&amp;solb;\, (S \to *)
            %p
              and if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              has an
              %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} \emptyset
              we have equivalently
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mspace{:width => "thinmathspace"}
                    %mi ⧄
                    %mspace{:width => "thinmathspace"}
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ⇔
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi ∅
                    %mo →
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi ⧄
                    %mspace{:width => "thinmathspace"}
                    %mi f
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S \,&amp;solb;\, f
                    \\;\;\Leftrightarrow \;\;
                    (\emptyset \to S) \,&amp;solb;\, f
                    \\,.
            %p
              Accordingly, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo ⊂
                    %mi Mor
                    %mo{:stretchy => "false"} (
                    %mi ℰ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Q \subset Mor(\mathcal{E})
              write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mrow
                      %mi ⧄
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} {}^{&amp;solb;}Q
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Q
                      %mi ⧄
                  %annotation{:encoding => "application/x-tex"} Q^{&amp;solb;}
              for the class of morphisms with left or right lifting property against all elements of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} Q
          .num_prop
            %h6#proposition Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ⊣
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi ℰ
                    %mo →
                    %mi ℱ
                  %annotation{:encoding => "application/x-tex"} (L \dashv R) : \mathcal{E} \to \mathcal{F}
              is a pair of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thinmathspace"}
                    %mi ⧄
                    %mspace{:width => "thinmathspace"}
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ⇔
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi ⧄
                    %mspace{:width => "thinmathspace"}
                    %mi g
                  %annotation{:encoding => "application/x-tex"}
                    f \,&amp;solb;\, R(g)
                    \\;\;
                    \\Leftrightarrow
                    \\;\;
                    L(f) \,&amp;solb;\, g
          .num_defn
            %h6#definition Definition
            %p
              A pair of classes of morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (L,R)
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              is a
              %em
                %a.existingWikiWord{:href => "/nlab/show/weak+factorization+system"} weak factorization system
              precisely if
            %ol
              %li
                %p
                  every morphism in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℰ
                      %annotation{:encoding => "application/x-tex"} \mathcal{E}
                  factors as the
                  %a.existingWikiWord{:href => "/nlab/show/composition"} composition
                  of a morphism in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                      %annotation{:encoding => "application/x-tex"} L
                  followed by a morphism in
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi R
                        %annotation{:encoding => "application/x-tex"} R
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                        %mo =
                        %msup
                          %mi L
                          %mi ⧄
                      %annotation{:encoding => "application/x-tex"} R = L^{&amp;solb;}
                  and
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi L
                          %mo =
                          %msup
                            %mrow
                            %mi ⧄
                          %mi R
                        %annotation{:encoding => "application/x-tex"} L = {}^{&amp;solb;} R
          %h3#tensoring Tensoring
          %p
            Let
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℰ
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}_1
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℰ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}_2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℰ
                    %mn 3
                %annotation{:encoding => "application/x-tex"} \mathcal{E}_3
            be three categories.
          #Divisibility.num_defn
            %h6#definition_2 Definition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊗
                    %mo :
                    %msub
                      %mi ℰ
                      %mn 1
                    %mo ×
                    %msub
                      %mi ℰ
                      %mn 2
                    %mo →
                    %msub
                      %mi ℰ
                      %mn 3
                  %annotation{:encoding => "application/x-tex"}
                    \\otimes : \mathcal{E}_1 \times \mathcal{E}_2 \to \mathcal{E}_3
            %ol
              %li
                %p
                  is called
                  %em divisible on the left
                  if for every
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ∈
                        %msub
                          %mi ℰ
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} A \in \mathcal{E}_1
                  the functor
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ⊗
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} A \otimes (-)
                  has a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo \
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo :
                        %msub
                          %mi ℰ
                          %mn 3
                        %mo →
                        %msub
                          %mi ℰ
                          %mn 2
                        %mspace{:width => "thinmathspace"}
                        %mo ;
                      %annotation{:encoding => "application/x-tex"}
                        A \backslash (-) : \mathcal{E}_3 \to \mathcal{E}_2
                        \\,;
              %li
                %p
                  is called
                  %em divisible on the right
                  if for every
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ∈
                        %msub
                          %mi ℰ
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} A \in \mathcal{E}_2
                  the functor
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo ⊗
                        %mi A
                      %annotation{:encoding => "application/x-tex"} (-) \otimes A
                  has a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} /
                        %mi A
                        %mo :
                        %msub
                          %mi ℰ
                          %mn 3
                        %mo →
                        %msub
                          %mi ℰ
                          %mn 1
                        %mspace{:width => "thinmathspace"}
                        %mo ;
                      %annotation{:encoding => "application/x-tex"}
                        (-)/ A : \mathcal{E}_3 \to \mathcal{E}_1
                        \\,;
          .num_prop
            %h6#proposition_2 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊗
                  %annotation{:encoding => "application/x-tex"} \otimes
              is divisble on both sides, then there are
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphisms"} natural isomorphisms
              between the collections of morphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊗
                    %mi B
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    A \otimes B \to X
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo →
                    %mi A
                    %mo \
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    B \to A\backslash X
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi B
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    A \to X / B
                    \\,.
          .num_prop
            %h6#proposition_3 Proposition
            %p
              For every
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ∈
                      %mi Mor
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi ℰ
                        %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f \in Mor(\mathcal{E}_1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ∈
                    %mi Mor
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ℰ
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} g \in Mor(\mathcal{E}_2)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %msub
                      %mi ℰ
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} X \in \mathcal{E}_3
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thinmathspace"}
                    %mi ⧄
                    %mspace{:width => "thinmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ⇔
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi g
                    %mspace{:width => "thinmathspace"}
                    %mi ⧄
                    %mspace{:width => "thinmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo \
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f \,&amp;solb;\, (X/g)
                    \\;\;
                    \\Leftrightarrow
                    \\;\;
                    g \,&amp;solb;\, (f \backslash X)
                    \\,.
          .num_example
            %h6#example Example
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              is a
              %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
              %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
              functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊗
                    %mo :
                    %mi ℰ
                    %mo ×
                    %mi ℰ
                    %mo →
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \otimes : \mathcal{E} \times \mathcal{E} \to \mathcal{E}
              is divisible on both sides, the two divisions coincide and are given by the
              %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mo :
                    %msup
                      %mi ℰ
                      %mi op
                    %mo ×
                    %mi ℰ
                    %mo →
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} [-,-] : \mathcal{E}^{op} \times \mathcal{E} \to \mathcal{E}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi A
                    %mo ≃
                    %mo{:stretchy => "false"} [
                    %mi A
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mo ≃
                    %mi A
                    %mo \
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    X/A \simeq [A,X] \simeq A\backslash X
                    \\,.
          %h3#pushouttensoring Pushout-tensoring
          %p
            Let now
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℰ
                    %mn 3
                %annotation{:encoding => "application/x-tex"} \mathcal{E}_3
            have
            %a.existingWikiWord{:href => "/nlab/show/finite+limits"} finite
            %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
            and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊗
                  %mo :
                  %msub
                    %mi ℰ
                    %mn 1
                  %mo ×
                  %msub
                    %mi ℰ
                    %mn 2
                  %mo →
                  %msub
                    %mi ℰ
                    %mn 3
                %annotation{:encoding => "application/x-tex"} \otimes : \mathcal{E}_1 \times \mathcal{E}_2 \to \mathcal{E}_3
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
          .num_defn
            %h6#definition_3 Definition
            %p
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f : A \to B
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℰ
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}_1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} g : X \to Y
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℰ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}_2
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊗
                    %mi Y
                    %mover
                      %mo ⨿
                      %mrow
                        %mi A
                        %mo ⊗
                        %mi X
                    %mi B
                    %mo ⊗
                    %mi X
                    %mo ⟶
                    %mi B
                    %mo ⊗
                    %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    A \otimes Y
                    \\overset
                    {A \otimes X}
                    {\amalg}
                    B \otimes X
                    \\longrightarrow
                    B \otimes Y
            %p
              for the induced
              %em
                %a.existingWikiWord{:href => "/nlab/show/pushout-product"} pushout-product
              morphism, the canonical morphism out of the
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
              induced from the commutativity of the diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                            %mo ⊗
                            %mi X
                          %mtd
                            %mo →
                          %mtd
                            %mi B
                            %mo ⊗
                            %mi X
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi A
                            %mo ⊗
                            %mi Y
                          %mtd
                            %mo →
                          %mtd
                            %mi B
                            %mo ⊗
                            %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A \otimes X &amp;\to&amp; B \otimes X
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    A \otimes Y &amp;\to&amp; B \otimes Y
                    }
                    \\,.
          .num_prop
            %h6#proposition_4 Proposition
            %p The pushout-product extends to a functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mo ⊗
                      %mo{:stretchy => "false"} ¯
                    %mo :
                    %msubsup
                      %mi ℰ
                      %mn 1
                      %mi I
                    %mo ×
                    %msubsup
                      %mi ℰ
                      %mn 2
                      %mi I
                    %mo →
                    %msubsup
                      %mi ℰ
                      %mn 3
                      %mi I
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\bar \otimes : \mathcal{E}_1^I \times \mathcal{E}_2^I \to \mathcal{E}_3^I
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi I
                  %annotation{:encoding => "application/x-tex"} C^I
              denotes the
              %a.existingWikiWord{:href => "/nlab/show/arrow+category"} arrow category
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
          .num_prop
            %h6#proposition_5 Proposition
            %p
              If in the above situation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℰ
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}_1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℰ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}_2
              have
              %a.existingWikiWord{:href => "/nlab/show/finite+limits"} finite limits
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊗
                  %annotation{:encoding => "application/x-tex"} \otimes
              is divisble on both sides, def.
              = succeed "," do
                %a.maruku-ref{:href => "#Divisibility"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mo ⊗
                      %mo{:stretchy => "false"} ¯
                  %annotation{:encoding => "application/x-tex"} \bar{\otimes}
              is divisible on both sides:
            %ol
              %li
                %p
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo :
                        %mi A
                        %mo →
                        %mi B
                      %annotation{:encoding => "application/x-tex"} f : A \to B
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ℰ
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} \mathcal{E}_1
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mo :
                        %mi X
                        %mo →
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} g : X \to Y
                  in
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi ℰ
                            %mn 3
                        %annotation{:encoding => "application/x-tex"} \mathcal{E}_3
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mover
                          %mo \
                          %mo{:stretchy => "false"} ¯
                        %mi g
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi B
                        %mo \
                        %mi X
                        %mo →
                        %mi B
                        %mo \
                        %mi Y
                        %msub
                          %mo ×
                          %mrow
                            %mi A
                            %mo \
                            %mi Y
                        %mi A
                        %mo \
                        %mi X
                        %mspace{:width => "thinmathspace"}
                        %mo ;
                      %annotation{:encoding => "application/x-tex"}
                        f \bar \backslash g
                        \\;\colon\;
                        B \backslash X \to B \backslash Y \times_{A \backslash Y} A \backslash X
                        \\,;
              %li
                %p
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo :
                        %mi S
                        %mo →
                        %mi T
                      %annotation{:encoding => "application/x-tex"} f : S \to T
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ℰ
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} \mathcal{E}_2
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mo :
                        %mi X
                        %mo →
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} g : X \to Y
                  in
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi ℰ
                            %mn 3
                        %annotation{:encoding => "application/x-tex"} \mathcal{E}_3
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mover
                          %mo{:stretchy => "false"} /
                          %mo{:stretchy => "false"} ¯
                        %mi f
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi X
                        %mo{:stretchy => "false"} /
                        %mi T
                        %mo →
                        %mi Y
                        %mo{:stretchy => "false"} /
                        %mi T
                        %msub
                          %mo ×
                          %mrow
                            %mi Y
                            %mo{:stretchy => "false"} /
                            %mi S
                        %mi X
                        %mo{:stretchy => "false"} /
                        %mi S
                        %mspace{:width => "thinmathspace"}
                        %mo ;
                      %annotation{:encoding => "application/x-tex"}
                        g \bar / f
                        \\;\colon\;
                        X / T \to Y / T \times_{Y / S} X / S
                        \\,;
          %p
            A key statement now is the following, characterizing the
            %a.existingWikiWord{:href => "/nlab/show/right+lifting+property"} right lifting property
            again
            %a.existingWikiWord{:href => "/nlab/show/pushout+product"} pushout product
            morphisms:
          #IteratedLifting.num_prop
            %h6#proposition_6 Proposition
            %p
              In the above situation, let
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℰ
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}_1
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℰ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℰ
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}_3
              have all
              %a.existingWikiWord{:href => "/nlab/show/finite+limit"} finite
              %a.existingWikiWord{:href => "/nlab/show/limits"} limits
              and
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                      %mo ∈
                      %mi Mor
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi ℰ
                        %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} u \in Mor(\mathcal{E}_1)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                      %mo ∈
                      %mi Mor
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi ℰ
                        %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} v \in Mor(\mathcal{E}_2)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %mi Mor
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ℰ
                      %mn 3
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \in Mor(\mathcal{E}_3)
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mover
                      %mo ⊗
                      %mo{:stretchy => "false"} ¯
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi ⧄
                    %mspace{:width => "thinmathspace"}
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ⇔
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi u
                    %mspace{:width => "thinmathspace"}
                    %mi ⧄
                    %mspace{:width => "thinmathspace"}
                    %mi f
                    %mover
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} ¯
                    %mi v
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ⇔
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi v
                    %mspace{:width => "thinmathspace"}
                    %mi ⧄
                    %mspace{:width => "thinmathspace"}
                    %mi u
                    %mover
                      %mo \
                      %mo{:stretchy => "false"} ¯
                    %mi f
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (u \bar \otimes v) \,&amp;solb;\, f
                    \\;\;
                    \\Leftrightarrow
                    \\;\;
                    u \,&amp;solb;\, f \bar /v
                    \\;\;
                    \\Leftrightarrow
                    \\;\;
                    v \,&amp;solb;\, u \bar \backslash f
                    \\,.
          %h2#applications Applications
          %h3#reedy_theory Reedy theory
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} \mathcal{E}
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                %annotation{:encoding => "application/x-tex"} \Delta
            for the
            %a.existingWikiWord{:href => "/nlab/show/simplex+category"} simplex category
            and
            %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
            for the category of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
            %a.existingWikiWord{:href => "/nlab/show/Reedy+model+structure"} Reedy model structure
            on the
            %a.existingWikiWord{:href => "/nlab/show/presheaf+category"} presheaf category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi Δ
                    %mi op
                  %mo ,
                  %mi ℰ
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [\Delta^{op}, \mathcal{E}]
            the following constructions are central.
          .num_defn
            %h6#definition_4 Definition
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo □
                    %mo :
                    %mi sSet
                    %mo ×
                    %mi ℰ
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Δ
                      %mi op
                    %mo ,
                    %mi ℰ
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\Box : sSet \times \mathcal{E} \to [\Delta^{op}, \mathcal{E}]
            %p for the functor given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo □
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi n
                    %mo ↦
                    %msub
                      %mi S
                      %mi n
                    %mo ⋅
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (S \Box X) : n \mapsto S_n \cdot X
                    \\,.
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊗
                    %mo :
                    %mo{:stretchy => "false"} [
                    %mi Δ
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Δ
                      %mi op
                    %mo ,
                    %mi ℰ
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"}
                    \\otimes : [\Delta, Set] \times [\Delta^{op}, \mathcal{E}] \to\mathcal{E}
            %p
              for the functor given by the
              %a.existingWikiWord{:href => "/nlab/show/coend"} coend
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊗
                    %mi X
                    %mo =
                    %msup
                      %mo ∫
                      %mrow
                        %mi n
                        %mo ∈
                        %mi Δ
                    %msub
                      %mi S
                      %mi n
                    %mo ⋅
                    %msub
                      %mi X
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S \otimes X = \int^{n \in \Delta} S_n \cdot X_n
                    \\,.
          %p
            (Here on the right we have the canonical
            %a.existingWikiWord{:href => "/nlab/show/tensoring"} tensoring
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} \mathcal{E}
            over
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mi n
                    %mo ⋅
                    %mi X
                    %mo ≃
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mi s
                        %mo ∈
                        %msub
                          %mi S
                          %mi n
                    %mi X
                  %annotation{:encoding => "application/x-tex"} S_n \cdot X \simeq \coprod_{s \in S_n} X
          .num_prop
            %h6#proposition_7 Proposition
            %p
              The functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo □
                  %annotation{:encoding => "application/x-tex"} \Box
              is divisible on both sides.
            %p
              Let
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi Δ
                        %mi op
                      %mo ,
                      %mi sSet
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} X \in [\Delta^{op}, sSet]
            %ul
              %li
                %p
                  the object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ∂
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} ]
                        %mo \
                        %mi X
                      %annotation{:encoding => "application/x-tex"} \partial \Delta[n] \backslash X
                  is the
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Reedy+model+structure"} matching object
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  at stage
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
              %li
                %p
                  the morphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo ∂
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} ]
                        %mo ↪
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} )
                        %mo \
                        %mi X
                      %annotation{:encoding => "application/x-tex"} (\partial \Delta[n] \hookrightarrow \Delta[n]) \backslash X
                  is the canonical morphism from
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi X
                          %mi n
                      %annotation{:encoding => "application/x-tex"} X_n
                  into the
                  = succeed "-matching" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f : X \to Y
              be a morphism in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi Δ
                        %mi op
                      %mo ,
                      %mi sSet
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [\Delta^{op}, sSet]
            %ul
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/Reedy+model+structure"} relative matching morphism
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  at stage
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                  is
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo ∂
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} ]
                        %mo ↪
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} )
