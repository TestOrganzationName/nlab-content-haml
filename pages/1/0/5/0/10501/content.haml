                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X, O_X)
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/ringed+space"} ringed space
            %a.existingWikiWord{:href => "/nlab/show/modules"} modules
            over a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msub
                    %mi O
                    %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X, O_X)
            by studying the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Mod
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi O
                    %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Mod(O_X)
            of
            %a.existingWikiWord{:href => "/nlab/show/sheaf+of+modules"} sheaves of modules
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi O
                      %mi X
                  %annotation{:encoding => "application/x-tex"} O_X
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+model+category"} symmetric monoidal
            %a.existingWikiWord{:href => "/nlab/show/cofibrantly+generated+model+category"} cofibrantly generated
            %a.existingWikiWord{:href => "/nlab/show/model+structure"} model structure
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi O
                      %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Mod(O_X)
            %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
            with respect to this model structure, i.e. the
            %a.existingWikiWord{:href => "/nlab/show/derived+category"} derived category
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi O
                      %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Mod(O_X)
            %a.existingWikiWord{:href => "/nlab/show/triangulated+category"} triangulated category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mi Mod
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi O
                    %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} D(Mod(O_X))
            associated to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi O
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D(Mod(O_X))
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Bondal"} Bondal
            %a.existingWikiWord{:href => "/nlab/show/Orlov"} Orlov
            and others. The triangulated category of perfect complexes is a very significant construction in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/noncommutative+algebraic+geometry"} noncommutative algebraic geometry
          %h2#definitions Definitions
          %h3#derived_category_of_quasicoherent_sheaves Derived category of quasi-coherent sheaves
          %p
            Recall that one has the
            %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full
            %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian
            %a.existingWikiWord{:href => "/nlab/show/subcategory"} subcategory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi QCoh
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi O
                    %mi X
                  %mo{:stretchy => "false"} )
                  %mo ⊂
                  %mi Mod
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi O
                    %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} QCoh(O_X) \subset Mod(O_X)
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quasi-coherent+sheaves"} quasi-coherent sheaves
            %a.existingWikiWord{:href => "/nlab/show/modules"} modules
            over a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi QCoh
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi O
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi O
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D(QCoh(O_X)) \subset D(Mod(O_X))
          %h3#derived_category_of_coherent_sheaves Derived category of coherent sheaves
          %p
            When
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/noetherian+scheme"} noetherian scheme
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Coh
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi O
                    %mi X
                  %mo{:stretchy => "false"} )
                  %mo ⊂
                  %mi QCoh
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi O
                    %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Coh(O_X) \subset QCoh(O_X)
            of
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/coherent+sheaves"} coherent sheaves
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/finitely+generated+modules"} finitely generated modules
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi Coh
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi O
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi QCoh
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi O
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D(Coh(O_X)) \subset D(QCoh(O_X))
          %h3#bounded_derived_category_of_coherent_sheaves Bounded derived category of coherent sheaves
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            be a
            %a.existingWikiWord{:href => "/nlab/show/noetherian+scheme"} noetherian scheme
            and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi D
                    %mi b
                  %mo{:stretchy => "false"} (
                  %mi Coh
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi O
                    %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} D^b(Coh(O_X))
            denote the
            %a.existingWikiWord{:href => "/nlab/show/bounded+derived+category"} bounded derived category
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Coh
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi O
                      %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Coh(O_X)
          .num_prop
            %h6#proposition Proposition
            %p
              The canonical
              %a.existingWikiWord{:href => "/nlab/show/fully+faithful"} fully faithful
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mi b
                    %mo{:stretchy => "false"} (
                    %mi Coh
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi O
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi O
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D^b(Coh(O_X)) \hookrightarrow D(Mod(O_X))
            %p
              identifies
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mi b
                    %mo{:stretchy => "false"} (
                    %mi Coh
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi O
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D^b(Coh(O_X))
              with the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi O
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D(Mod(O_X))
              of
              %a.existingWikiWord{:href => "/nlab/show/bounded+complexes"} bounded complexes
              whose
              %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
              objects are
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/coherent+sheaves"} coherent sheaves
          %p
            See
            = succeed "." do
              %a{:href => "#SGA6"} (SGA 6, Exp. II, Corollaire 2.2.2.1)
          %h3#triangulated_category_of_perfect_complexes Triangulated category of perfect complexes
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            be a
            %a.existingWikiWord{:href => "/nlab/show/ringed+space"} ringed space
            and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Pf
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ⊂
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mi Mod
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi O
                    %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Pf(X) \subset D(Mod(O_X))
            denote the
            %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
            of
            %a.existingWikiWord{:href => "/nlab/show/perfect+complexes"} perfect complexes
            of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi O
                      %mi X
                  %annotation{:encoding => "application/x-tex"} O_X
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/modules"} modules
            %a.existingWikiWord{:href => "/nlab/show/triangulated+subcategory"} triangulated subcategory
            that is contained in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mi coh
                    %mo{:stretchy => "false"} (
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi O
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi O
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D_{coh}(Mod(O_X)) \subset D(Mod(O_X))
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/coherent+cohomology"} coherent cohomology
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/derived+tensor+product"} derived tensor product
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/derived+inverse+image"} derived inverse image
            %a.existingWikiWord{:href => "/nlab/show/derived+direct+image"} derived direct image
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/proper+morphisms"} proper morphisms
          .num_prop
            %h6#proposition_2 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/smooth+scheme"} smooth scheme
              %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Pf
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ∼
                    %msup
                      %mi D
                      %mi b
                    %mo{:stretchy => "false"} (
                    %mi Coh
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi O
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Pf(X) \stackrel{\sim}{\to} D^b(Coh(O_X))
            %p
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/triangulated+categories"} triangulated categories
          %p
            This follows from the previous proposition combined with
            = succeed "." do
              %a{:href => "#SGA6"} (SGA 6, Exp. I, Exemples 5.11)
          %h2#derived_equivalence Derived equivalence
          %p
            The bounded derived category of coherent sheaves
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi D
                    %mi b
                  %mo{:stretchy => "false"} (
                  %mi Coh
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi O
                    %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} D^b(Coh(O_X))
            is usually called simply the
            %strong
              derived category of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            and denoted
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D(X)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "," do
              %span.newWikiWord
                Mukai
                %a{:href => "/nlab/new/Mukai"} ?
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/Bondal"} Bondal
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Orlov"} Orlov
          %p
            There are several geometrically interesting examples of non-isomorphic
            %a.existingWikiWord{:href => "/nlab/show/varieties"} varieties
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            with
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D(X) \simeq D(Y)
            %a.existingWikiWord{:href => "/nlab/show/abelian+variety"} abelian variety
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is equivalent to the derived category of its dual
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat{X}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            are
            = succeed "." do
              %strong derived equivalent
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Bondal-Orlov+reconstruction+theorem"} Bondal-Orlov reconstruction theorem
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ↦
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X \mapsto D(X)
            seems to lose just enough information so that derived equivalence becomes a geometrically interesting invariant.
          %h3#fouriermukai_functors Fourier-Mukai functors
          .num_thm
            %h6#theorem_
              Theorem (
              %a.existingWikiWord{:href => "/nlab/show/Orlov"}> Orlov
              )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              be smooth projective
              %a.existingWikiWord{:href => "/nlab/show/varieties"} varieties
              over a
              %a.existingWikiWord{:href => "/nlab/show/field"} field
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F : D(X) \to D(Y)
              be a
              %a.existingWikiWord{:href => "/nlab/show/triangulated+functor"} triangulated
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ∈
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E \in D(X \times Y)
              which is unique up to isomorphism and is such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is isomorphic to the
              %a.existingWikiWord{:href => "/nlab/show/Fourier-Mukai+transform"} Fourier-Mukai transform
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ↦
                    %msub
                      %mi Rq
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Lp
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} )
                    %msup
                      %mo ⊗
                      %mi L
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F \mapsto Rq_*(Lp^*(F) \otimes^L E))
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi X
                    %mo ×
                    %mi Y
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} p : X \times Y \to X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo :
                    %mi X
                    %mo ×
                    %mi Y
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} q : X \times Y \to Y
              are the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/projections"} projections
          %p
            See
            %a.existingWikiWord{:href => "/nlab/show/Fourier-Mukai+functor"} Fourier-Mukai functor
            for details.
          %h3#derived_invariants Derived invariants
          %p
            Let us say that a functor on the category of smooth projective
            %a.existingWikiWord{:href => "/nlab/show/varieties"} varieties
            is a
            %strong derived invariant
            if it maps derived equivalent varieties to isomorphic objects.
          %ul
            %li
              %p
                The
                %span.newWikiWord
                  canonical ring
                  %a{:href => "/nlab/new/canonical+ring"} ?
                is a derived invariant
                = succeed "." do
                  %a{:href => "#OrlovSurvey"} (Orlov 2003)
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Orlov"} Orlov
                has proved that for
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/abelian+varieties"} abelian varieties
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ↦
                      %mi X
                      %mo ×
                      %mover
                        %mi X
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} X \mapsto X \times \hat{X}
                is a derived invariant
                = succeed "." do
                  %a{:href => "#OrlovSurvey"} (Orlov 2003)
            %li
              %p
                %span.newWikiWord
                  Rouquier
                  %a{:href => "/nlab/new/Rouquier"} ?
                has proved that the functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ↦
                      %msup
                        %mi Pic
                        %mn 0
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo ⋊
                      %msup
                        %mi Aut
                        %mn 0
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} X \mapsto Pic^0(X) \rtimes Aut^0(X)
                valued in
                %a.existingWikiWord{:href => "/nlab/show/algebraic+groups"} algebraic groups
                is a derived invariant
                = succeed "." do
                  %a{:href => "#Rouquier2010"} (Rouquier 2010)
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Orlov"} Orlov
                has proved that the derived category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} D(X)
                determines the rational
                %a.existingWikiWord{:href => "/nlab/show/Chow+motive"} Chow motive
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} M(X)
                up to
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Tate+twists"} Tate twists
                %a.existingWikiWord{:href => "/nlab/show/Fourier-Mukai+functor"} corresponding
                object
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                        %mo ∈
                        %mi D
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ×
                        %mi Y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} E \in D(X \times Y)
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Chow+motive"} Chow motive
                %a.existingWikiWord{:href => "/nlab/show/Weil+cohomology+theory"} Weil cohomology theory
                (e.g.
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/etale+cohomology"} etale cohomology
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Betti+cohomology"} Betti cohomology
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/de+Rham+cohomology"} de Rham cohomology
                = succeed "." do
                  %a{:href => "#Orlov2005"} (Orlov, 2005)
            %li
              %p
                The derived category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} D(X)
                determines the
                %a.existingWikiWord{:href => "/nlab/show/noncommutative+Chow+motive"} noncommutative Chow motive
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi NM
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} NM(X)
                up to isomorphism. In particular, it follows that all
                = succeed "," do
                  %span.newWikiWord
                    additive invariants
                    %a{:href => "/nlab/new/additive+invariants"} ?
                %a.existingWikiWord{:href => "/nlab/show/K-theory"} K-theory
                or
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Hochschild+homology"} Hochschild homology
                = succeed "." do
                  %a{:href => "#Yusufzai"} (Yusufzai)
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/abelian+sheaf+cohomology"} abelian sheaf cohomology
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/derived+category+of+coherent+sheaves"} derived category of coherent sheaves
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/perfect+complex"} perfect complex
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/deformation+theory+of+sheaves"} deformation theory of sheaves
          %h2#references References
          %ul#SGA6
            %li
              %a.existingWikiWord{:href => "/nlab/show/SGA+6"} SGA 6
          %p
            For the
            %a.existingWikiWord{:href => "/nlab/show/model+structure"} model structure
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi O
                      %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Mod(O_X)
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+chain+complexes"} model structure on chain complexes
            and in particular
          %ul#CisinskiDeglise
            %li
              %a.existingWikiWord{:href => "/nlab/show/Denis-Charles+Cisinski"}> Denis-Charles Cisinski
              , F. Déglise,
              = succeed "," do
                %em Local and stable homologial algebra in Grothendieck abelian categories
              = succeed ")" do
                %a{:href => "http://www.intlpress.com/HHA/v11/n1/a11/"} url
          %h3#derived_categories_of_quasicoherent_sheaves Derived categories of quasi-coherent sheaves
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/R.+Thomason"}> R. Thomason
                , T. Trobaugh.
                = succeed "." do
                  %em Higher algebraic K-theory of schemes and of derived categories
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Amnon+Neeman"}> Amnon Neeman
                ,
                = succeed "," do
                  %em The Grothendieck duality theorem via Bousfield’s techniques and Brown representability
                = succeed "." do
                  %a{:href => "http://dx.doi.org/10.1090/S0894-0347-96-00174-9"} doi
          %h3#bounded_derived_category_of_coherent_sheaves_2 Bounded derived category of coherent sheaves
          %p
            For a summary of the results of
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/Bondal"} Bondal
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Orlov"} Orlov
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Aleksei+Bondal"}> Aleksei Bondal
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Dmitri+Orlov"} Dmitri Orlov
              = succeed "," do
                %em Derived categories of coherent sheaves
              = succeed "." do
                %a{:href => "http://arxiv.org/abs/math/0206295"} arXiv
          %p For a detailed survey, see
          %ul#OrlovSurvey
            %li
              %a.existingWikiWord{:href => "/nlab/show/Dmitri+Orlov"}> Dmitri Orlov
              ,
              = succeed "," do
                %em Derived categories of coherent sheaves and equivalences between them
              = succeed "." do
                %a{:href => "http://www.mi.ras.ru/~orlov/papers/Uspekhi2003.pdf"} translation
          %p On the relationship between derived categories and Chow motives, see
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Dmitri+Orlov"}> Dmitri Orlov
              ,
              = succeed "." do
                %em Derived categories of coherent sheaves and motives
              %p
                %a{:href => "http://arxiv.org/abs/math/0512620"} math.AG/0512620
          %p
            For some discussion of the above result and the relationship between derived categories and
            %span.newWikiWord
              additive invariants
              %a{:href => "/nlab/new/additive+invariants"} ?
            see
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Adeel+Khan+Yusufzai"}> Adeel Khan Yusufzai
              ,
              = succeed "," do
                %em Perfect correspondences and Chow motives
              = succeed "." do
                %a{:href => "http://arxiv.org/abs/1310.0249"} arXiv
          %p
            For the derived invariance of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Pic
                      %mn 0
                    %mo ⋊
                    %msup
                      %mi Aut
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} Pic^0 \rtimes Aut^0
          %ul
            %li
              %span.newWikiWord>
                Rouquier
                %a{:href => "/nlab/new/Rouquier"} ?
              ,
              = succeed "," do
                %em Automorphismes, graduations et categories triangulees
              = succeed "." do
                %a{:href => "http://arxiv.org/abs/1008.1971"} arXiv
          %h3#triangulated_category_of_perfect_complexes_2 Triangulated category of perfect complexes
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Luc+Illusie"}> Luc Illusie
                \.
                = succeed "," do
                  %em Le complexe cotangent I et II
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Andre+Hirschowitz"}> Andre Hirschowitz
                ,
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Carlos+Simpson"} Carlos Simpson
                = succeed "," do
                  %em Descente pour les n-champs
                %a{:href => "http://arxiv.org/abs/math/9807049"} arXiv:math/9807049
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Stacks+Project"}> Stacks Project
                ,
                %a{:href => "http://stacks.math.columbia.edu/tag/08CL"} tag 08CL
