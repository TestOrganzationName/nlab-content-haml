                    %mrow
                      %mi h
                      %mo{:stretchy => "false"} (
                      %mi π
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi h
                  %mo ′
                  %mo ∘
                  %msup
                    %mi h
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  J_{h(\pi(z A))}(h'\circ h^{-1})) = A^{-1} J_{h(\pi(z))}(h'\circ h^{-1}))
          %p
            and on intersection of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ,
                  %mi h
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (U,h)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (V,g)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi J
                    %mrow
                      %mi h
                      %mo{:stretchy => "false"} (
                      %mi π
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi h
                  %mo ′
                  %mo ∘
                  %msup
                    %mi h
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi J
                    %mrow
                      %mi g
                      %mo{:stretchy => "false"} (
                      %mi π
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi h
                  %mo ′
                  %mo ∘
                  %msup
                    %mi g
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} )
                  %msub
                    %mi J
                    %mrow
                      %mi h
                      %mo{:stretchy => "false"} (
                      %mi π
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo ∘
                  %msup
                    %mi h
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  J_{h(\pi(z))}(h'\circ h^{-1})) = J_{g(\pi(z))}(h'\circ g^{-1})J_{h(\pi(z))}(g\circ h^{-1})
          %p
            Then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ϕ
                    %mi h
                %annotation{:encoding => "application/x-tex"} \phi_h
            is onto and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi ϕ
                    %mi h
                  %mo ∘
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi ϕ
                    %mi g
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo ,
                  %mi A
                  %msub
                    %mi J
                    %mrow
                      %mi h
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo ∘
                  %msup
                    %mi h
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  (\phi_h \circ (\phi_g)^{-1})(p,A) = (p, A J_{h(p)}(g\circ h^{-1})
          %p
            what shows that the transition functions are smooth (where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi GL
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} GL_n(k)
            has the standard differential structure).
          %h3#InDifferentialCohesion In differential cohesion
          %p
            In a context of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/differential+cohesion"} differential cohesion
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/higher+order+frame+bundle"} higher order frame bundle
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
            is the
            %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            (
            %a.existingWikiWord{:href => "/nlab/show/principal+infinity-bundle"}> principal infinity-bundle
            ) to which the
            %a.existingWikiWord{:href => "/nlab/show/infinitesimal+disk+bundle"} infinitesimal disk bundle
            is the canonically
            %a.existingWikiWord{:href => "/nlab/show/associated+bundle"} associated bundle
            (
            %a.existingWikiWord{:href => "/nlab/show/associated+infinity-bundle"}> associated infinity-bundle
            )
          %p
            See at
            = succeed "." do
              %em
                %a{:href => "differential+cohesion#GLnTangentBundles"} differential cohesion – Frame bundles
          %h2#properties Properties
          %h3#TheCanonical1Form The canonical differential 1-form
          %p
            The frame bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Fr
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Fr(X)
            carries a canonical
            %a.existingWikiWord{:href => "/nlab/show/differential+1-form"} differential 1-form
            with values in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo ∈
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi Fr
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msup
                    %mi ℝ
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\alpha \in \Omega^1(Fr(X), \mathbb{R}^n)
          %p
            This is defined as follows. Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo ∈
                  %mi Fr
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} p \in Fr(X)
            be a point in the frame bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi π
                  %mo{:lspace => "verythinmathspace"} :
                  %mi Fr
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} \pi \colon Fr(X)\to X
            over some point
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi T
                      %mi x
                    %mo ≃
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} p \colon T_x \simeq \mathbb{R}^n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                  %mo ∈
                  %msub
                    %mi T
                    %mi p
                  %mi Fr
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} v \in T_p Fr(X)
            a
            %a.existingWikiWord{:href => "/nlab/show/tangent+vector"} tangent vector
            to the frame bundle, its projection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mo *
                  %mi v
                  %mo ∈
                  %msub
                    %mi T
                    %mi x
                  %mi X
                %annotation{:encoding => "application/x-tex"} \pi_\ast v \in T_x X
            is a
            %a.existingWikiWord{:href => "/nlab/show/tangent+vector"} tangent vector
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                %annotation{:encoding => "application/x-tex"} v
            is the image of this
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi_\ast(v)
            under the isomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mi p
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi π
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\alpha(v) \coloneqq p(\pi_\ast(v))
                  \\,.
          %p
            (
            %a{:href => "#Sternberg64"}> Sternberg 64, section VII, (2.2)
            )
          %h3#relation_to_structures
            Relation to
            = succeed "-structures" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %p
            A choice sub-bundle of a frame bundle which is a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
