                          %mtd
                            %mi V
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} /
                            %mi G
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi p
                                    %mi ρ
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo ⟶
                              %mi g
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    P\times_G V &amp;\longrightarrow&amp; V//G
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{p_\rho}}
                    \\\
                    X &amp;\stackrel{g}{\longrightarrow}&amp; \mathbf{B}G
                    }
                    \\,.
          .proof
            %h6#proof_5 Proof
            %p
              By the discussion at
              %em
                %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+principal+bundles"} geometry of physics – principal bundles
              in the section
              = succeed "," do
                %em
                  %a{:href => "geometry%20of%20physics%20--%20principal%20bundles#PrincipalBundlesViaSmoothGroupoids"} Smooth principal bundles via smooth groupoids
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              of smooth groupoids is presented by a morphism of pre-smooth groupoids after choosing an
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U_i \to X\}
              over wich
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              trivialize and choosing a trivialization, by the
              %a.existingWikiWord{:href => "/nlab/show/zig-zag"} zig-zag
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} {
                            %msub
                              %mi U
                              %mi i
                            %mo{:stretchy => "false"} }
                            %msub
                              %mo{:stretchy => "false"} )
                              %mo •
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi g
                                  %mo •
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                            %msub
                              %mo{:stretchy => "false"} )
                              %mo •
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mo ≃
                                    %mi lwe
                        %mtr
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    C(\{U_i\})_\bullet &amp;\stackrel{g_\bullet}{\longrightarrow}&amp; (\mathbf{B}G)_\bullet
                    \\\
                    \\downarrow^{\mathrlap{\simeq_{lwe}}}
                    \\\
                    X
                    }
            %p
              where the top morphism is the
              %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech cocycle
              of the given local trivialization regarded as a morphism out of the
              %a.existingWikiWord{:href => "/nlab/show/Cech+groupoid"} Cech groupoid
              of the given cover.
            %p
              Moreover, by prop.
              %a.maruku-ref{:href => "#MapFromActionGroupoidOnSetBackToBG"}
              the morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi p
                      %mi ρ
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                  %annotation{:encoding => "application/x-tex"} (p_\rho)_\bullet
              is a global fibration of pre-smooth groupoids, hence, by the discussion at
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+smooth+homotopy+types"} geometry of physics – smooth homotopy types
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi p
                      %mi ρ
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                  %annotation{:encoding => "application/x-tex"} (p_\rho)_\bullet
              along this
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mo •
                  %annotation{:encoding => "application/x-tex"} g_\bullet
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} {
                            %msub
                              %mi U
                              %mi i
                            %mo{:stretchy => "false"} }
                            %msub
                              %mo{:stretchy => "false"} )
                              %mo •
                            %munder
                              %mo ×
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mstyle{:mathvariant => "bold"}
                                  %mi B
                                %mi G
                                %msub
                                  %mo{:stretchy => "false"} )
                                  %mo •
                            %mo{:stretchy => "false"} (
                            %mi V
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} /
                            %mi G
                            %msub
                              %mo{:stretchy => "false"} )
                              %mo •
                          %mtd
                            %mo ⟶
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi V
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} /
                            %mi G
                            %msub
                              %mo{:stretchy => "false"} )
                              %mo •
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi p
                                    %mi ρ
                                  %msub
                                    %mo{:stretchy => "false"} )
                                    %mo •
                        %mtr
                          %mtd
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} {
                            %msub
                              %mi U
                              %mi i
                            %mo{:stretchy => "false"} }
                            %msub
                              %mo{:stretchy => "false"} )
                              %mo •
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi g
                                  %mo •
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                            %msub
                              %mo{:stretchy => "false"} )
                              %mo •
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mo ≃
                                    %mi lwe
                        %mtr
                          %mtd
                            %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    C(\{U_i\})_\bullet \underset{(\mathbf{B}G)_\bullet}{\times} (V//G)_\bullet &amp;\longrightarrow&amp; (V//G)_\bullet
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{(p_\rho)_\bullet}}
                    \\\
                    C(\{U_i\})_\bullet &amp;\stackrel{g_\bullet}{\longrightarrow}&amp;
                    (\mathbf{B}G)_\bullet
                    \\\
                    \\downarrow^{\mathrlap{\simeq_{lwe}}}
                    \\\
                    X
                    }
                    \\,.
            %p
              This pullback is computed componentwise. Hence it is the pre-smooth groupoid whose morphisms are pairs consisting of a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi i
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x,i)\to (x,j)
              in the Cech groupoid as well as a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mover
                      %mo →
                      %mi g
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} s \stackrel{g}{\to} \rho(s)(g)
              in the action groupoid, such that the group label
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              of the latter equals the cocycle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mrow
                        %mi i
                        %mi j
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} g_{i j}(x)
              of the cocycle on the former. Schematically:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                    %munder
                      %mo ×
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                        %msub
                          %mo{:stretchy => "false"} )
                          %mo •
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi G
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                    %mo =
                    %mrow
                      %mo {
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi i
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi s
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo ⟶
                        %mrow
                          %msub
                            %mi g
                            %mrow
                              %mi i
                              %mi j
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi j
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi ρ
                      %mo{:stretchy => "false"} (
                      %mi s
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    C(\{U_i\})_\bullet \underset{(\mathbf{B}G)_\bullet}{\times} (V//G)_\bullet
                    \=
                    \\left\{
                    ((x,i),s) \stackrel{g_{i j}(x)}{\longrightarrow} ((x,j),\rho(s)(g))
                    \\right\}
                    \\,.
            %p
              This means that the pullback groupoid has at most one morphism between every ordered pair of objects. Accordingly this groupoid is
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+groupoids"} equivalence of groupoids
              equivalent to the
              %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
              of its space of objects by the
              %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
              induced by its morphisms:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo ≃
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                        %mi i
                      %msub
                        %mi U
                        %mi i
                      %mo ×
                      %mi V
                      %mo )
                    %msub
                      %mo{:stretchy => "false"} /
                      %mo ∼
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots \simeq
                    \\left(
                    \\underset{i}{\coprod} U_i \times V
                    \\right)/_\sim
                    \\,.
            %p
              This is a traditional description of the
              %a.existingWikiWord{:href => "/nlab/show/associated+bundle"} associated bundle
              in question.
          %h4#invariants_and_sections Invariants and sections
          %p
            One advantage of the perspective on representations via action groupoids is that it gives a good formulation of the
            %a.existingWikiWord{:href => "/nlab/show/invariants"} invariants
            and the
            %a.existingWikiWord{:href => "/nlab/show/coinvariants"} coinvariants
            of actions. The invariants are the
            %em
              %a.existingWikiWord{:href => "/nlab/show/sections"} sections
            of the action groupoid projection, while the coivariants in fact are the action groupoid itself.
          .num_prop
            %h6#proposition_9 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
              a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              on some set
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %a.existingWikiWord{:href => "/nlab/show/invariants"} invariants
              of that action is equivalent to the groupoid of
              %a.existingWikiWord{:href => "/nlab/show/sections"} sections
              of the
              %a.existingWikiWord{:href => "/nlab/show/action+groupoid"} action groupoid
              projection of prop.
              = succeed "," do
                %a.maruku-ref{:href => "#MapFromActionGroupoidOnSetBackToBG"}
              = succeed "." do
                %a.maruku-ref{:href => "#EquivalenceOfPermutationRepresentationsWithActionGroupodsInSlice"}
          .proof
            %h6#proof_6 Proof
            %p
              The sections in question are diagrams in
              %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                          %mtd
                          %mtd
                            %mover
                              %mo ⟶
                              %mi σ
                          %mtd
                          %mtd
                            %mi S
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} /
                            %mi G
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi id
                            %mo ↘
                          %mtd
                            %msub
                              %mo ⇙
                              %mpadded{:width => "0"}
                                %mo ≃
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi p
                                    %mi ϕ
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbf{B}G &amp;&amp; \stackrel{\sigma}{\longrightarrow} &amp;&amp; S//G
                    \\\
                    \&amp; {}_{\mathllap{id}}\searrow
                    \&amp;\swArrow_{\mathrlap{\simeq}}&amp;
                    \\swarrow_{\mathrlap{p_\phi}}
                    \\\
                    \&amp;&amp; \mathbf{B}G
                    }
                    \\,,
            %p
              hence the groupoid which they form is equivalently the
              %a.existingWikiWord{:href => "/nlab/show/hom-groupoid"} hom-groupoid
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Grpd
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi id
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                    %mo ,
                    %msub
                      %mi p
                      %mi ρ
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"}
                    Grpd_{/\mathbf{B}G}(id_{\mathbf{B}G}, p_\rho)
                    \\in Grpd
            %p
              in the
              %a.existingWikiWord{:href => "/nlab/show/slice+%28infinity%2C1%29-category"} slice
              of
              %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}G
              = succeed "," do
                %a.maruku-ref{:href => "#IntertwinersOfPermutationActionAsSliceHoms"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi p
                      %mi ρ
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                  %annotation{:encoding => "application/x-tex"} (p_\rho)_\bullet
              of prop.
              = succeed "," do
                %a.maruku-ref{:href => "#MapFromActionGroupoidOnSetBackToBG"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                            %msub
                              %mo{:stretchy => "false"} )
                              %mo •
                          %mtd
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi σ
                                  %mo •
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi S
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} /
                            %mi G
                            %msub
                              %mo{:stretchy => "false"} )
                              %mo •
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi id
                                    %mo •
                            %mo ↘
                          %mtd
                            %mo =
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi p
                                    %mi ϕ
                                  %msub
                                    %mo{:stretchy => "false"} )
                                    %mo •
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                            %msub
                              %mo{:stretchy => "false"} )
                              %mo •
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    (\mathbf{B}G)_\bullet &amp;&amp; \stackrel{\sigma_\bullet}{\longrightarrow} &amp;&amp; (S//G)_\bullet
                    \\\
                    \&amp; {}_{\mathllap{id_\bullet}}\searrow &amp;=&amp; \swarrow_{\mathrlap{(p_\phi)_\bullet}}
                    \\\
                    \&amp;&amp; (\mathbf{B}G)_\bullet
                    }
                    \\,.
            %p
              These
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
              now are manifestly functors that are the identiy on the group labels of the morphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi σ
                      %mo •
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo *
                          %mtr
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mi g
                          %mtr
                            %mtd
                              %mo *
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ↦
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi σ
                              %mo{:stretchy => "false"} (
                              %mo *
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mi g
                          %mtr
                            %mtd
                              %mi σ
                              %mo{:stretchy => "false"} (
                              %mo *
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo =
                              %mi ρ
                              %mo{:stretchy => "false"} (
                              %mi σ
                              %mo{:stretchy => "false"} (
                              %mo *
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} (
                              %mi g
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\sigma_\bullet
                    \\;\colon\;
                    \\left(
                    \\array{
                    \\ast
                    \\\
                    \\downarrow^{\mathrlap{g}}
                    \\\
                    \\ast
                    }
                    \\right)
                    \\;\;
                    \\mapsto
                    \\;\;
                    \\left(
                    \\array{
                    \\sigma(\ast)
                    \\\
                    \\downarrow^{\mathrlap{g}}
                    \\\
                    \\sigma(\ast) &amp; = \rho(\sigma(\ast)(g))
                    }
                    \\right)
                    \\,.
            %p
              This shows that they pick precisely those elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi S
                  %annotation{:encoding => "application/x-tex"} \sigma(\ast) \in S
              which are fixed by the
              = succeed "-action" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                    %annotation{:encoding => "application/x-tex"} \rho
            %p
              Moreover, since these functors are identity on the group labels, there are no non-trivial
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphisms"} natural isomorphisms
              between them, and hence the groupoid of sections is indeed a set, the set of invariant elements.
          %p More generally, we may consider sections of these groupoid projections after pulling them back along some cocycle:
          .num_prop
            %h6#proposition_10 Proposition
            %p
              Given an
              %a.existingWikiWord{:href => "/nlab/show/associated+bundle"} associated bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %msub
                      %mo ×
                      %mi G
                    %mi V
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} P \times_G V\to X
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/modulating+morphism"} modulated
              = succeed "," do
                %a.maruku-ref{:href => "#Associated1BundleAsPullbackOfActionGroupoid"}
              %a.existingWikiWord{:href => "/nlab/show/smooth+groupoids"} smooth groupoids
              of the form
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo ⟶
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                    %annotation{:encoding => "application/x-tex"} g \colon X \longrightarrow \mathbf{B}G
              %a.existingWikiWord{:href => "/nlab/show/sections"} sections
              is equivalently the groupoid of diagrams
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                          %mtd
                            %mover
                              %mo ⟶
                              %mi σ
                          %mtd
                          %mtd
                            %mi S
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} /
                            %mi G
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi g
                            %mo ↘
                          %mtd
                            %msub
                              %mo ⇙
                              %mpadded{:width => "0"}
                                %mo ≃
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi p
                                    %mi ϕ
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;&amp; \stackrel{\sigma}{\longrightarrow} &amp;&amp; S//G
                    \\\
                    \&amp; {}_{\mathllap{g}}\searrow
                    \&amp;\swArrow_{\mathrlap{\simeq}}&amp; \swarrow_{\mathrlap{p_\phi}}
                    \\\
                    \&amp;&amp; \mathbf{B}G
                    }
                    \\,,
            %p
              hence the groupoid of sections is equivalently the slice
              %a.existingWikiWord{:href => "/nlab/show/hom-groupoid"} hom-groupoid
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi P
                    %msub
                      %mo ×
                      %mi G
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi Grpd
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo ,
                    %msub
                      %mi p
                      %mi ρ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma_X(P\times_G V)
                    \\simeq
                    Grpd_{/\mathbf{B}G}(g, p_\rho)
                    \\,.
          .proof
            %h6#proof_7 Proof
            %p
              By the defining
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              of the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
              in prop.
              = succeed "." do
                %a.maruku-ref{:href => "#Associated1BundleAsPullbackOfActionGroupoid"}
          .num_remark
            %h6#remark_2 Remark
            %p
              Taken together this means that
              %a.existingWikiWord{:href => "/nlab/show/invariants"} invariants
              of group actions are equivalently the sections of the corresponding
              %a.existingWikiWord{:href => "/nlab/show/universal+principal+bundle"} universal
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/associated+bundle"} associated bundle
          %h4#stabilizer_groups Stabilizer groups
          %p
            Given an ordinary
            %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            and an
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} colob
                  %mi G
                  %mo ×
                  %mi V
                  %mo ⟶
                  %mi V
                %annotation{:encoding => "application/x-tex"} \rho \colob G \times V \longrightarrow V
            of the group on some
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi V
                %annotation{:encoding => "application/x-tex"} x \in V
            any element, the
            %a.existingWikiWord{:href => "/nlab/show/stabilizer+group"} stabilizer group
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Stab
                    %mi x
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %mi G
                %annotation{:encoding => "application/x-tex"}
                  Stab_x(V) \hookrightarrow G
          %p
            is the
            %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            consisting of those group elements under whose action the element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                %annotation{:encoding => "application/x-tex"} v
            does not change (is “stable”):
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Stab
                    %mi G
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mrow
                    %mo {
                    %mi g
                    %mo ∈
                    %mi G
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} |
                    %mspace{:width => "thickmathspace"}
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi v
                    %mo }
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Stab_G(x)
                  \=
                  \\left\{
                  g \in G
                  \\;|\;
                  \\rho(g)(v) = v
                  \\right\}
                  \\,.
          %p We observe that this has the following intrinsic reformulation. Write again
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi V
                        %mtd
                          %mover
                            %mo ⟶
                            %mi i
                        %mtd
                          %mi V
                          %mo{:stretchy => "false"} /
                          %mo{:stretchy => "false"} /
                          %mi G
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %msub
                                  %mi p
                                  %mi ρ
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  V &amp;\stackrel{i}{\longrightarrow}&amp; V//G
                  \\\
                  \&amp;&amp; \downarrow^{\mathrlap{p_\rho}}
                  \\\
                  \&amp;&amp; \mathbf{B}G
                  }
          %p
            for the
            %a.existingWikiWord{:href => "/nlab/show/action+groupoid"} action groupoid
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequence"} homotopy fiber sequence
            that corresponds to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                %annotation{:encoding => "application/x-tex"} \rho
            via prop.
            = succeed "." do
              %a.maruku-ref{:href => "#EquivalenceOfPermutationRepresentationsWithActionGroupodsInSlice"}
          #OrdinaryStabilizer.num_prop
            %h6#proposition_11 Proposition
            %p
              The stabilizer group of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              under
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              acting on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              is equivalently the
              %a.existingWikiWord{:href => "/nlab/show/looping"} looping
              of the
              %a.existingWikiWord{:href => "/nlab/show/action+groupoid"} action groupoid
              at the point
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} i(x)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Stab
                      %mi G
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi Ω
                      %mrow
                        %mi i
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Stab_G(x)
                    \\simeq
                    \\Omega_{i(x)} (V//G)
          .proof
            %h6#proof_8 Proof
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi G
                  %annotation{:encoding => "application/x-tex"} V//G
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/1-groupoid"} 1-groupoid
              %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop space object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ω
                      %mrow
                        %mi i
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega_{i(x)} (V//G)
              is simply the
              %a.existingWikiWord{:href => "/nlab/show/automorphism+group"} automorphism group
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              regarded as an object in the action groupoid, hence the group of
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi G
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                  %annotation{:encoding => "application/x-tex"} (V//G)_\bullet
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              %a.maruku-ref{:href => "#Action1Groupoid"}
              shows that these morphisms are precisely those labeled by elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ∈
                    %mi G
                  %annotation{:encoding => "application/x-tex"} g \in G
              for which
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi x
                    %annotation{:encoding => "application/x-tex"} \rho(g)(x) = x
          %h4#representations_of_1groups
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} \infty
            \-Representations of 1-groups
          %p
            The
            %a{:href => "#1RepresentationsOf1Groups"} above
            perspective on ordinary representations of ordinary groups on sets via their
            %a.existingWikiWord{:href => "/nlab/show/action+groupoid"} action groupoid
            projection has the advantage that it immediately generalizes to a definition where 1-groups act on more general
            %a.existingWikiWord{:href => "/nlab/show/homotopy+types"} homotopy types
            up to
            %a.existingWikiWord{:href => "/nlab/show/coherence"} coherent
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
            %em
              %a.existingWikiWord{:href => "/nlab/show/infinity-representations"} infinity-representations
            or
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/infinity-actions"} infinity-actions
          .num_defn
            %h6#definition_4 Definition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              and a
              %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi V
                        %mo •
                    %annotation{:encoding => "application/x-tex"} V_\bullet
              %em
                %a.existingWikiWord{:href => "/nlab/show/infinity-representation"} infinity-representation
              or
              %em
                %a.existingWikiWord{:href => "/nlab/show/infinity-action"} infinity-action
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              is another
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} /
                      %mi G
                      %msub
                        %mo{:stretchy => "false"} )
                        %mo •
                    %annotation{:encoding => "application/x-tex"} (V//G)_\bullet
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi p
                      %mi ρ
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi G
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                    %mo ⟶
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                  %annotation{:encoding => "application/x-tex"} (p_\rho) \colon (V//G)_\bullet \longrightarrow N(\mathbf{B}G)_\bullet
              to the
              %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %msub
                        %mi G
                        %mo •
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\mathbf{B}G_\bullet)
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
              of that map is
              %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weakly homotopy equivalent
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi V
                        %mo •
                    %annotation{:encoding => "application/x-tex"} V_\bullet
          %h5#examples_of_representations
            Examples of
            = succeed "-Representations" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            Given an
            %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi A
                  %msub
                    %mo{:stretchy => "false"} )
                    %mo •
                %annotation{:encoding => "application/x-tex"} (\mathbf{B}^n A)_\bullet
            for the
            %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
            which is the image under the
            %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan correspondence
            of the
            %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
            that is concentrated on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            in degree
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p
            Then for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete group
            %a.existingWikiWord{:href => "/nlab/show/mapping+complex"} mapping complex
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo ,
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi A
                  %mo{:stretchy => "false"} ]
                  %mo ∈
                  %mi KanCplx
                %annotation{:encoding => "application/x-tex"}
                  [\mathbf{B}G,\mathbf{B}^n A] \in KanCplx
          %p
            is the
            %a.existingWikiWord{:href => "/nlab/show/infinity-groupoid"} infinity-groupoid
            whose
            %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            are the degree-
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/group+cohomology"} group cocycles
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            with
            %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            (regarded as a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/module"} module
            with trivial
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/action"} action
            %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            are the
            %a.existingWikiWord{:href => "/nlab/show/coboundaries"} coboundaries
            between these cocycles, and whose higher morphisms are higher order coboundaries-of-coboundaries.
          %p
            Being a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
            %a.existingWikiWord{:href => "/nlab/show/automorphism+infinity-group"} automorphism infinity-group
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G
            %a.existingWikiWord{:href => "/nlab/show/automorphism+2-group"} automorphism 2-group
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %em pointed
            automorphisms is is the 1-group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Aut
                    %mi Grp
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Aut_{Grp}(G)
            of invertible group homomorphisms of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %h3#semantic_layer Semantic Layer
          %p
            We now consider any
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            and formulate the group actions and their associated bundles in
            %a.existingWikiWord{:href => "/nlab/show/general+abstract"} general abstractly
            here.
          %p
            By the discussion at
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+groups"} geometry of physics – groups
            %a.existingWikiWord{:href => "/nlab/show/group+objects+in+an+%28%E2%88%9E%2C1%29-category"} group objects in an (∞,1)-category
            are equivalently pointed connected objects which we write
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} (\ast\to\mathbf{B}G)\in \mathbf{H}^{\ast/}
            %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop space object
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo ≃
                  %mi Ω
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"}
                  G \simeq \Omega \mathbf{B}G
          %p formed at the given base point.
          %h4#actions_2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} \infty
            \-Actions
          %p
            In view of this, the characterization of ordinary group action according to prop.
            %a.maruku-ref{:href => "#EquivalenceOfPermutationRepresentationsWithActionGroupodsInSlice"}
            has an immediate generalization to
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groups"} ∞-groups
            in any
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
          #InfinityAction.num_defn
            %h6#definition_5 Definition
            %p
              Given an
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} G \in \mathbf{H}
              and any object
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo ∈
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} V \in \mathbf{H}
              %em
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-action"} ∞-action
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              is a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequence"} homotopy fiber sequence
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi V
                          %mtd
                            %mo →
                          %mtd
                            %mi V
                            %mo ⫽
                            %mi G
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi p
                                    %mi ρ
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    V &amp;\to&amp; V\sslash G
                    \\\
                    \&amp;&amp; \downarrow^{\mathrlap{p_\rho}}
                    \\\
                    \&amp;&amp; \mathbf{B}G
                    }
                    \\,.
            %p
              The object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo{:stretchy => "false"} /
                    %mi G
                  %annotation{:encoding => "application/x-tex"} V/G
              defined thereby we call the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+quotient"} homotopy quotient
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              via this action.
          %h4#associated_bundles_2
            Associated
            = succeed "-bundles" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/associated+infinity-bundle"} associated infinity-bundle
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi E
                        %mtd
                          %mo →
                        %mtd
                          %mi V
                          %mo ⫽
                          %mi G
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %mi pb
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mover
                            %mi X
                            %mo{:stretchy => "false"} ˜
                        %mtd
                          %mo →
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                      %mtr
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mo ≃
                      %mtr
                        %mtd
                          %mi X
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  E &amp;\to&amp; V\sslash G
                  \\\
                  \\downarrow &amp;pb&amp; \downarrow
                  \\\
                  \\tilde X &amp;\to&amp; \mathbf{B}G
                  \\\
                  \\downarrow^{\mathrlap{\simeq}}
                  \\\
                  X
                  }
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/section"} section
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                        %mtd
                          %mover
                            %mo →
                            %mi σ
                        %mtd
                        %mtd
                          %mi V
                          %mo ⫽
                          %mi G
                      %mtr
                        %mtd
                        %mtd
                          %mo ↘
                        %mtd
                          %msub
                            %mo ⇙
                            %mo ≃
                        %mtd
                          %mo ↙
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X &amp;&amp;\stackrel{\sigma}{\to}&amp;&amp; V \sslash G
                  \\\
                  \&amp; \searrow &amp;\swArrow_{\simeq}&amp; \swarrow
                  \\\
                  \&amp;&amp; \mathbf{B}G
                  }
          %h4#stabilizer_groups_2
            Stabilizer
            = succeed "-Groups" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            We had seen above in prop.
            %a.maruku-ref{:href => "#OrdinaryStabilizer"}
            that the traditional concept of stabilizer groups of group actions is equivalent to groups of loops in the
            %a.existingWikiWord{:href => "/nlab/show/action+groupoid"} action groupoid
            of the given action. This equivalent reformulation has an immediate generalization to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-actions"} ∞-actions
            = succeed "." do
              %a.maruku-ref{:href => "#InfinityAction"}
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} G\in \mathbf{H}
            an object equipped with
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
            structure, hence with a
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            = succeed "G," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                %annotation{:encoding => "application/x-tex"} \rho
            an
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-action"} ∞-action
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            on some
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequence"} homotopy fiber sequence
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi V
                        %mtd
                          %mover
                            %mo ⟶
                            %mi i
                        %mtd
                          %mi V
                          %mo{:stretchy => "false"} /
                          %mi G
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %msub
                                  %mi p
                                  %mi ρ
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  V &amp;\stackrel{i}{\longrightarrow}&amp; V/G
                  \\\
                  \&amp;&amp; \downarrow^{\mathrlap{p_\rho}}
                  \\\
                  \&amp;&amp; \mathbf{B}G
                  }
                  \\,.
          #StabilizerInInfinityTopos.num_defn
            %h6#definition_6 Definition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/global+element"} global element
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo{:lspace => "verythinmathspace"} :
                    %mo *
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    x \colon \ast \to X
            %p
              then the
              %strong
                stabilizer
                = succeed "-group" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Stab
                      %mi ρ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Stab_\rho(x)
              of the
              = succeed "-action" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              is the
              %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop space object
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Stab
                      %mi ρ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msub
                      %mi Ω
                      %mrow
                        %mi i
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Stab_\rho(x) \coloneqq \Omega_{i(x)} (X/G)
                    \\,.
          .num_defn
            %h6#remark_3 Remark
            %p
              Equivalently, def.
              = succeed "," do
                %a.maruku-ref{:href => "#StabilizerInInfinityTopos"}
              %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop space object
              of the
              %a.existingWikiWord{:href => "/nlab/show/1-image"} 1-image
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi Stab
                      %mi ρ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}Stab_\rho(x)
              of the morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mover
                      %mo →
                      %mi x
                    %mi X
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\ast \stackrel{x}{\to} X \to X/G
                    \\,.
            %p
              As such the
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              of the stabilizer
              = succeed "-group" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/1-epimorphism"} 1-epimorphism
              %a.existingWikiWord{:href => "/nlab/show/1-monomorphism"} 1-monomorphism
              factorization
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi Stab
                      %mi ρ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \ast \to \mathbf{B}Stab_\rho(x) \hookrightarrow X/G
              which combines with the homotopy fiber sequence of prop.
              %a.maruku-ref{:href => "#InfinityAction"}
              to a diagram of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %mover
                              %mo ⟶
                              %mi x
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                            %mi X
                            %mo{:stretchy => "false"} /
                            %mi G
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi epi
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mo ↗
                              %mpadded{:width => "0"}
                                %mi mono
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %msub
                              %mi Stab
                              %mi ρ
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %msub
                              %mi Stab
                              %mi ρ
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\ast &amp;\stackrel{x}{\longrightarrow}&amp; X &amp;\stackrel{}{\longrightarrow}&amp; X/G
                    \\\
                    \\downarrow^{\mathrlap{epi}} &amp;&amp; &amp; \nearrow_{\mathrlap{mono}} &amp; \downarrow
                    \\\
                    \\mathbf{B} Stab_\rho(x)
                    \&amp;=&amp;
                    \\mathbf{B} Stab_\rho(x)
                    \&amp;\longrightarrow&amp;
                    \\mathbf{B}G
                    }
                    \\,.
            %p
              In particular there is hence a canonical homomorphism of
              = succeed "-groups" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Stab
                      %mi ρ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Stab_\rho(x) \longrightarrow G
                    \\,.
            %p
              However, in contrast to the classical situation, this morphism is not in general a monomorphism anymore, hence the stabilizer
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Stab
                      %mi ρ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Stab_\rho(x)
              is not a
              = succeed "-group" do
                %em sub
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              in general.
