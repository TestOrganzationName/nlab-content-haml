                    %mo ,
                    %msub
                      %mi S
                      %mn 2
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [S_1,S_2]
              are in
              %a.existingWikiWord{:href => "/nlab/show/natural+bijection"} natural bijection
              with functions
