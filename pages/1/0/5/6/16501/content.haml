                      %mo •
                  %annotation{:encoding => "application/x-tex"}
                    (p_\rho)_\bullet \;\colon\; (S//G)_\bullet \longrightarrow (\mathbf{B}G)_\bullet
            %p which, in the above presentation, forgets the labels of the objects and is the identity on the labels of the morphisms.
            %p
              This morphism is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isofibration"} isofibration
          #IntertwinersOfPermutationActionAsSliceHoms.num_prop
            %h6#proposition_2 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete group
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/actions"} actions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ρ
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \rho_1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ρ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \rho_2
              on sets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} S_1
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi S
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} S_2
              %a.existingWikiWord{:href => "/nlab/show/natural+equivalence"} natural equivalence
              between the set of action
              %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
              (“
              %a.existingWikiWord{:href => "/nlab/show/intertwiners"}> intertwiners
              ”)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ρ
                        %mn 1
                      %mo →
                      %msub
                        %mi ρ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \rho_1 \to \rho_2
              %a.existingWikiWord{:href => "/nlab/show/hom+groupoid"} hom groupoid
              of the
              %a.existingWikiWord{:href => "/nlab/show/slice+%28infinity%2C1%29-category"} slice
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Grpd
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                  %annotation{:encoding => "application/x-tex"} Grpd_{/\mathbf{B}G}
              between their
              %a.existingWikiWord{:href => "/nlab/show/action+groupoids"} action groupoids
              regarded in the slice via the maps from prop.
              %a.maruku-ref{:href => "#MapFromActionGroupoidOnSetBackToBG"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mi Act
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ρ
                      %mn 1
                    %mo ,
                    %msub
                      %mi ρ
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi Grpd
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi p
                      %mrow
                        %msub
                          %mi ρ
                          %mn 1
                    %mo ,
                    %msub
                      %mi p
                      %mrow
                        %msub
                          %mi ρ
                          %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    G Act(\rho_1,\rho_2)
                    \\simeq
                    Grpd_{/\mathbf{B}G}(p_{\rho_1}, p_{\rho_2})
                    \\,.
          .proof
            %h6#proof Proof
            %p
              One quick way to see this is to use, via the discussion at
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/slice+%28infinity%2C1%29-category"} slice (infinity,1)-category
              %a.existingWikiWord{:href => "/nlab/show/hom-groupoid"} hom-groupoid
              in the slice is given by the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
              of unsliced hom-groupoids
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi Grpd
                              %mrow
                                %mo{:stretchy => "false"} /
                                %mstyle{:mathvariant => "bold"}
                                  %mi B
                                %mi G
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi p
                              %mrow
                                %msub
                                  %mi ρ
                                  %mn 1
                            %mo ,
                            %msub
                              %mi p
                              %mrow
                                %msub
                                  %mi ρ
                                  %mn 2
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi Grpd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi S
                              %mn 1
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} /
                            %mi G
                            %mo ,
                            %msub
                              %mi S
                              %mn 2
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} /
                            %mi G
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi pb
                            %mo{:stretchy => "false"} )
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi Grpd
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi S
                                    %mn 1
                                  %mo{:stretchy => "false"} /
                                  %mo{:stretchy => "false"} /
                                  %mi G
                                  %mo ,
                                  %msub
                                    %mi p
                                    %mrow
                                      %msub
                                        %mi ρ
                                        %mn 2
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                            %mi Grpd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi S
                              %mn 1
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} /
                            %mi G
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Grpd_{/\mathbf{B}G}(p_{\rho_1}, p_{\rho_2})
                    \&amp;\longrightarrow&amp;
                    Grpd(S_1//G, S_2//G)
                    \\\
                    \\downarrow &amp;(pb)&amp; \downarrow^{\mathrlap{Grpd(S_1//G,p_{\rho_2})}}
                    \\\
                    \\ast &amp;\stackrel{}{\longrightarrow}&amp; Grpd(S_1//G, \mathbf{B}G)
                    }
                    \\,.
            %p
              Now since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi p
                      %mrow
                        %msub
                          %mi ρ
                          %mn 2
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                  %annotation{:encoding => "application/x-tex"} (p_{\rho_2})_\bullet
              is an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/isofibration"} isofibration
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Grpd
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi S
                        %mn 1
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} /
                      %mi G
                      %msub
                        %mo{:stretchy => "false"} )
                        %mo •
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi p
                        %mrow
                          %msub
                            %mi ρ
                            %mn 2
                      %msub
                        %mo{:stretchy => "false"} )
                        %mo •
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Grpd((S_1//G)_\bullet, (p_{\rho_2})_\bullet)
              %a.existingWikiWord{:href => "/nlab/show/hom-set"} hom-set
              in the 1-categorical slice. This consists of functors
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mo •
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mn 1
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi G
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mn 1
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi G
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                  %annotation{:encoding => "application/x-tex"}
                    \\phi_\bullet \colon (S_1//G)_\bullet \longrightarrow (S_1//G)_\bullet
            %p
              which strictly preserves the
              = succeed "-labels" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mo •
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi s
                          %mtr
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mi g
                          %mtr
                            %mtd
                              %mi ρ
                              %mo{:stretchy => "false"} (
                              %mi s
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} (
                              %mi g
                              %mo{:stretchy => "false"} )
                      %mo )
                    %mo ↦
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi ϕ
                              %mo{:stretchy => "false"} (
                              %mi s
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mi g
                          %mtr
                            %mtd
                              %mi ϕ
                              %mo{:stretchy => "false"} (
                              %mi ρ
                              %mo{:stretchy => "false"} (
                              %mi s
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} (
                              %mi g
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo =
                              %mi ρ
                              %mo{:stretchy => "false"} (
                              %mi ϕ
                              %mo{:stretchy => "false"} (
                              %mi s
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} (
                              %mi g
                              %mo{:stretchy => "false"} )
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\phi_\bullet
                    \\;\colon\;
                    \\left(
                    \\array{
                    s
                    \\\
                    \\downarrow^{\mathrlap{g}}
                    \\\
                    \\rho(s)(g)
                    }
                    \\right)
                    \\mapsto
                    \\left(
                    \\array{
                    \\phi(s)
                    \\\
                    \\downarrow^{\mathrlap{g}}
                    \\\
                    \\phi(\rho(s)(g)) &amp; = \rho(\phi(s))(g)
                    }
                    \\right)
                    \\,.
          .num_prop
            %h6#proposition_3 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
              of the morphism in prop.
              %a.maruku-ref{:href => "#MapFromActionGroupoidOnSetBackToBG"}
              is
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+groupoids"} equivalent
              to the set
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequence"} homotopy fiber sequence
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi S
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi S
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} /
                            %mi G
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi p
                                    %mi ρ
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    S &amp;\longrightarrow&amp; S//G
                    \\\
                    \&amp;&amp; \downarrow^{\mathrlap{p_\rho}}
                    \\\
                    \&amp;&amp; \mathbf{B}G
                    }
                    \\,.
          .proof
            %h6#proof_2 Proof
            %p
              In the presentation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi G
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                  %annotation{:encoding => "application/x-tex"} (S//G)_\bullet
              of def.
              = succeed "," do
                %a.maruku-ref{:href => "#Action1Groupoid"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi ρ
                  %annotation{:encoding => "application/x-tex"} p_\rho
              is an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/isofibration"} isofibration
              = succeed "." do
                %a.maruku-ref{:href => "#MapFromActionGroupoidOnSetBackToBG"}
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fibers"} homotopy fibers
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi ρ
                  %annotation{:encoding => "application/x-tex"} p_\rho
              are equivalent to the ordinary fibers of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi p
                      %mi ρ
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                  %annotation{:encoding => "application/x-tex"} (p_\rho)_\bullet
              computed in the 1-category of 1-groupoids. Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi p
                      %mi ρ
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                  %annotation{:encoding => "application/x-tex"} (p_\rho)_\bullet
              is the identity on the labels of the morphisms in this presentation, this ordinary fiber is precisely the sub-groupoid of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi G
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                  %annotation{:encoding => "application/x-tex"} (S//G)_\bullet
              consisting of only the identity morphismss, hence is the set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              regarded as a groupoid.
          %p Conversely, the following construction extract a group action from a homotopy fiber sequence of groupoids of this form.
          #ActionMapFromFiberSequenceSetToGroupoidToBG.num_defn
            %h6#definition_2 Definition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequence"} homotopy fiber sequence
              of
              %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi S
                          %mtd
                            %mover
                              %mo ⟶
                              %mi i
                          %mtd
                            %mi E
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi p
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    S &amp;\stackrel{i}{\longrightarrow}&amp; E
                    \\\
                    \&amp;&amp; \downarrow^{\mathrlap{p}}
                    \\\
                    \&amp;&amp; \mathbf{B}G
                    }
            %p
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+groupoids"} equivalent
              to a
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              on this set as follows.
            %p
              Consider the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+product"} homotopy fiber product
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %munder
                      %mo ×
                      %mi E
                    %mi S
                    %mover
                      %munder
                        %mo ⟶
                        %mrow
                      %mover
                        %mo ⟶
                        %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"}
                    S \underset{E}{\times} S
                    \\stackrel{\overset{}{\longrightarrow}}{\underset{}{\longrightarrow}}
                    S
            %p
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              with itself. By the
              %a.existingWikiWord{:href => "/nlab/show/pasting+law"} pasting law
              applied to the total homotopy pullback diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi S
                            %munder
                              %mo ×
                              %mi E
                            %mi S
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi S
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi i
                        %mtr
                          %mtd
                            %mi S
                          %mtd
                            %mover
                              %mo ⟶
                              %mi i
                          %mtd
                            %mi E
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi p
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %mo ⟶
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi S
                            %mo ×
                            %mi G
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi p
                                  %mn 1
                          %mtd
                            %mi S
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi G
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %mo ⟶
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    S \underset{E}{\times} S &amp;\longrightarrow&amp; S
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{i}}
                    \\\
                    S &amp;\stackrel{i}{\longrightarrow}&amp; E
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{p}}
                    \\\
                    \\ast &amp;\longrightarrow&amp; \mathbf{B}G
                    }
                    \\;\;\;\;
                    \\simeq
                    \\;\;\;\;
                    \\array{
                    S\times G &amp;\stackrel{p_1}{\longrightarrow}&amp; S
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    G &amp;\stackrel{}{\longrightarrow}&amp; \ast
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    \\ast &amp;\longrightarrow&amp; \mathbf{B}G
                    }
            %p
              there is a canonical
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+groupoids"} equivalence of groupoids
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %munder
                      %mo ×
                      %mi E
                    %mi S
                    %mo ≃
                    %mi S
                    %mo ×
                    %mi G
                  %annotation{:encoding => "application/x-tex"}
                    S \underset{E}{\times} S \simeq S \times G
            %p
              such that one of the two canonical maps from the fiber product to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
