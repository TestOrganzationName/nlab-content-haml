                        %mtext coev
                        %mi B
                      %mo ⊗
                      %msub
                        %mtext id
                        %mrow
                          %msup
                            %mi A
                            %mo *
                  %msup
                    %mi B
                    %mo *
                  %mo ⊗
                  %mi B
                  %mo ⊗
                  %msup
                    %mi A
                    %mo *
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mtext id
                        %mrow
                          %msup
                            %mi B
                            %mo *
                      %mo ⊗
                      %mi f
                      %mo ⊗
                      %msub
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} id
                        %mrow
                          %msup
                            %mi A
                            %mo *
                  %msup
                    %mi B
                    %mo *
                  %mo ⊗
                  %mi A
                  %mo ⊗
                  %msup
                    %mi A
                    %mo *
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mtext id
                        %mrow
                          %msup
                            %mi B
                            %mo *
                      %mo ⊗
                      %msub
                        %mtext ev
                        %mi A
                  %msup
                    %mi B
                    %mo *
                %annotation{:encoding => "application/x-tex"} f^*:A^*\xrightarrow{\text{coev}_B\otimes \text{id}_{A^*}} B^*\otimes B\otimes A^*\xrightarrow{\text{id}_{B^*}\otimes f\otimes \id_{A^*}} B^*\otimes A\otimes A^* \xrightarrow{\text{id}_{B^*}\otimes \text{ev}_A} B^*
          %p This formula is clearer when written graphically:
          %p
            %img{:src => "/nlab/files/duals-graphical.png", :width => "150px"}/
          %p
            Additionally, this definition does not assert that the right dual of an object is isomorphic to its left dual: this need not be the case in general, though it is true in a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/braided+monoidal+category"} braided monoidal category
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
            (this last fact can be considered an algebraic form of the “Whitney trick” for knots; see this
            = succeed ")." do
              %a{:href => "http://mathoverflow.net/questions/162677/why-is-a-braided-left-autonomous-category-also-right-autonomous/162693#162693"} MO discussion
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/semisimple+category"} semisimple category
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/compact+closed+category"} compact closed
          %p In practice, algebraic geometers are the most frequent users of the term ‘rigid’, and they focus on the symmetric monoidal case, so they ignore the difference between right and left duals.
