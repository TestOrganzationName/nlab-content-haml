          %p
            where the left domain is from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℳ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi ℤ
                    %mi η
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{M}(\mathbb{Z}_\eta)
            and the two other domains are from
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℳ
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{M}(\mathbb{Z})
          %p
            The gives a category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi An
                    %mover
                      %mrow
                        %mi ℳ
                        %mo{:stretchy => "false"} (
                        %mi ℤ
                        %mo{:stretchy => "false"} )
                      %mo ¯
                    %mrow
                      %mo †
                      %mo ,
                      %mi s
                %annotation{:encoding => "application/x-tex"} An^{\dagger,s}_\overline{\mathcal{M}(\mathbb{Z})}
            of Arakelov-type varieties.
          %h2#adelic_description_of_principal_bundles_on_
            Adelic description of principal
            = succeed "-bundles" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} GL
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \GL_n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mrow
                      %mi ℳ
                      %mo{:stretchy => "false"} (
                      %mi ℤ
                      %mo{:stretchy => "false"} )
                    %mo ¯
                %annotation{:encoding => "application/x-tex"} \overline{\mathcal{M}(\mathbb{Z})}
          %p The main motivation for compactifying global analytic spaces using the ring categories approach is to get a geometric interpretation of the standard adelic quotient
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} GL
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi ℚ
                  %mo{:stretchy => "false"} )
                  %mo \
                  %msub
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} GL
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi 𝔸
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mi K
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\GL_n(\mathbb{Q})\backslash\GL_n(\mathbb{A})/K,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            is the maximal compact subgroup of the adelic group, as a moduli space of bundles.
          %p
            An
            = succeed "-rig" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝟙
                    %mrow
                      %mo ⊕
                      %mi n
                %annotation{:encoding => "application/x-tex"} \mathbb{1}^{\oplus n}
            for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} N
                  %annotation{:encoding => "application/x-tex"} n\in \N
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝟙
                      %mrow
                        %mo ⊕
                        %mn 0
                    %mo :
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \mathbb{1}^{\oplus 0}:=0
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} GL
                    %mi n
                %annotation{:encoding => "application/x-tex"} \GL_n
            be the functor on rig categories that sends
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi 𝒜
                  %mo ,
                  %mo ⊕
                  %mo ,
                  %mo ⊗
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathcal{A},\oplus,\otimes)
            to
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} GL
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi 𝒜
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %msub
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Isom
                    %mi 𝒜
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi 𝟙
                    %mrow
                      %mo ⊕
                      %mi n
                  %mo ,
                  %msup
                    %mi 𝟙
                    %mrow
                      %mo ⊕
                      %mi n
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} \GL_n(\mathcal{A}):=\Isom_\mathcal{A}(\mathbb{1}^{\oplus n},\mathbb{1}^{\oplus n}).
          %p
            A principal
            = succeed "-bundle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} GL
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \GL_n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} F\to X
            that is isomorphic, locally on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} GL
                      %mi n
