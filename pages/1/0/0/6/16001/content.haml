            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %msub
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} GL
                    %mi n
                %annotation{:encoding => "application/x-tex"} B\GL_n
            by sheafifying the nerve of the groupoid
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %msub
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} GL
                      %mi n
                  %annotation{:encoding => "application/x-tex"} B\GL_n
          %p
            We denote
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Bun
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mo ⋅
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %msub
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Hom
                    %mi St
                  %mo{:stretchy => "false"} (
                  %mo ⋅
                  %mo ,
                  %mi B
                  %msub
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} GL
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Bun_n(\cdot):=\Hom_{St}(\cdot,B\GL_n)
            the
            = succeed "-stack" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-bundles" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
