                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \phi:\mathcal{D}(\mathcal{A},d_\mathcal{A})\to \mathcal{M}(\mathcal{A},d_\mathcal{A}(0,-))
          %p of the structural sheaf we just defined on the space of metrics.
          %h2#functorial_approach_derived_stacks_over_metrized_ringed_categories Functorial approach: derived stacks over metrized ringed categories
          %p
            One may define a natural class of ind-metrized ring categories by the following process: first, one defines the category of metrized power series ring categories over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            in the usual way, using the
            = succeed "-norm" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi L
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} L^2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℤ
                    %mi η
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}_\eta
            as valuation ring categories of power series ring categories over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi fX
                %annotation{:encoding => "application/x-tex"} fX
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi fX
                    %mo ,
                    %mi g
                    %mo ∈
                    %mi{:mathvariant => "normal"} End
                    %mo{:stretchy => "false"} (
                    %mi 𝟙
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} fX,g\in \mathrm{End}(\mathbb{1})
          %p One then gets inspiration from Dubuc’s work on synthetic analytic geometry and Lurie’s work on general pre-geometries to define general analytic ring categories as arbitrary colimits (in the category of ind-metrized ring categories) of rational domain algebra categories, or maybe, as functors of functions that commute with products and standard pullbacks along rational domain embeddings. One may then define a Grothendieck topology on analytic ring categories and use it to define sheaves (functors of points) that will extend (in a sense to be explained) global analytic spaces (in the sense of the paper cited down this page) to a wider class of spaces.
          %p
            In this new category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} An
                      %mrow
                        %msub
                          %mi 𝔽
                          %mrow
                            %mo{:stretchy => "false"} {
                            %mo ±
                            %mn 1
                            %mo{:stretchy => "false"} }
                      %mo †
                  %annotation{:encoding => "application/x-tex"} \An^\dagger_{\mathbb{F}_{\{\pm 1\}}}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mrow
                      %mi ℳ
                      %mo{:stretchy => "false"} (
                      %mi ℤ
                      %mo{:stretchy => "false"} )
                    %mo ¯
                  %mo :
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mo{:stretchy => "false"} |
                  %mn 2
                  %mo{:stretchy => "false"} |
                  %mo ≥
                  %mn 3
                  %mo{:stretchy => "false"} /
                  %mn 2
                  %mo{:stretchy => "false"} }
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mn 2
                      %mo ≥
                      %mo{:stretchy => "false"} |
                      %mn 2
                      %mo{:stretchy => "false"} |
                      %mo ≥
                      %mn 3
                      %mo{:stretchy => "false"} /
                      %mn 2
                      %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} {
                  %mn 2
                  %mo ≥
                  %mo{:stretchy => "false"} |
                  %mn 2
                  %mo{:stretchy => "false"} |
                  %mo{:stretchy => "false"} }
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
