                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{M}(\mathcal{A},d_\mathcal{A}(0,-))
            as the direct image along
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo :
                  %mi 𝒟
                  %mo{:stretchy => "false"} (
                  %mi 𝒜
                  %mo ,
                  %msub
                    %mi d
                    %mi 𝒜
                  %mo{:stretchy => "false"} )
