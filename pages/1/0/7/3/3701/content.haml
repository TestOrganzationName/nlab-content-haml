                        %mn 1
                        %mo ,
                        %mi …
                        %mo ,
                        %mi n
                        %mo −
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} i = 1, \ldots, n - 1
            %p
              As a technicality, if
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
