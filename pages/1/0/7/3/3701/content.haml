                    %mo ≤
                    %mi d
                  %annotation{:encoding => "application/x-tex"} b \leq d
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo ⋐
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
