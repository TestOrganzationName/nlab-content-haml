                          %mo +
                    %annotation{:encoding => "application/x-tex"} b_i \lt b_{i+}
                for
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
