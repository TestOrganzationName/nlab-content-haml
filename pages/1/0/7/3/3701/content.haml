                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (a, b) \subseteq (c, d)
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo ≤
                  %mi a
