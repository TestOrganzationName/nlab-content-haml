                    %annotation{:encoding => "application/x-tex"} b
              if we have:
            %ul
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi a
                      %mo =
                      %msub
                        %mi a
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} a = a_1
                ,
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                        %mo =
                        %msub
                          %mi b
                          %mi n
                      %annotation{:encoding => "application/x-tex"} b = b_n
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
