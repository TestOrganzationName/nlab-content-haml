                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [a,b]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            any upper real and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                %annotation{:encoding => "application/x-tex"} b
            any lower real. But note that we do not say ‘extended’ here; we need to find some rational number (analogous to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                %annotation{:encoding => "application/x-tex"} -1
            in the proof above) smaller than
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            and some rational number (analogous to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                %annotation{:encoding => "application/x-tex"} 2
            above) larger than
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
            %em bounded
            closed intervals.
          %p
            Another generalization is
            = succeed ":" do
              %span.newWikiWord
                Cousin's Theorem
                %a{:href => "/nlab/new/Cousin%27s+lemma"} ?
          #Cousin.num_theorem
            %h6#theorem_2 Theorem
            %p
              %strong (Cousin's)
            %p
              Given any open cover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              of the unit interval, there is a partition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo =
                    %msub
                      %mi a
                      %mn 0
                    %mo ≤
                    %msub
                      %mi a
                      %mn 1
                    %mo ≤
                    %mi ⋯
                    %mo ≤
                    %msub
                      %mi a
                      %mi n
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 0 = a_0 \leq a_1 \leq \cdots \leq a_n = 1
              such that each subinterval
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi a
                      %mi i
                    %mo ,
                    %msub
                      %mi a
                      %mrow
                        %mi i
                        %mo +
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [a_i, a_{i+}]
              is covered by a single member
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              (in that
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn ∞
                      %mo ,
                      %msub
                        %mi a
                        %mi i
                      %mo{:stretchy => "false"} )
                      %mo ∪
                      %mi U
                      %mo ∪
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi a
                        %mrow
                          %mi i
                          %mo +
                      %mo ,
                      %mn ∞
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} (-\infty,a_i) \cup U \cup (a_{i+},\infty) = \mathbb{R}
          .proof
            %h6#proof_3 Proof
            %p
              As in the previous proof, construct a zigzag
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ζ
                  %annotation{:encoding => "application/x-tex"} \zeta
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} -1
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
              with zigs from
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              = succeed "," do
                %a.maruku-ref{:href => "#zigzaglemma"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} a_0
              be
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} a_1
              be the smallest left endpoint of a zig from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ζ
                  %annotation{:encoding => "application/x-tex"} \zeta
              satisfying
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo &lt;
                      %msub
                        %mi a
                        %mn 1
                      %mo &lt;
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 0 \lt a_1 \lt 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} a_2
              be smallest left endpoint satisfying
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi a
                        %mn 1
                      %mo &lt;
                      %msub
                        %mi a
                        %mn 2
                      %mo &lt;
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} a_1 \lt a_2 \lt 1
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi a
                        %mi n
                      %mo ≔
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} a_n \coloneqq 1
          %p
            A corollary of this theorem, when the open cover is given by a function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi δ
                  %mo{:lspace => "verythinmathspace"} :
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mn ∞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \delta\colon [0,1] \to (0,\infty)
            (so that
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo ≔
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi x
                    %mo −
                    %mi δ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi x
                    %mo +
                    %mi δ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} |
                    %mspace{:width => "thickmathspace"}
                    %mi x
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                  %annotation{:encoding => "application/x-tex"} \mathcal{C} \coloneqq \big\{\big(x - \delta(x), x + \delta(x)\big) \;|\; x \in [0,1]\big\}
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Henstock%E2%80%93Kurzweil+integral"} Henstock–Kurzweil integral
            %a.existingWikiWord{:href => "/nlab/show/Lebesgue+measure"} Lebesgue measure
            (see below).
          %h2#a_result_on_measure A result on measure
          %p
            The set of
            %a.existingWikiWord{:href => "/nlab/show/computable+real+numbers"} computable real numbers
            has
            %a.existingWikiWord{:href => "/nlab/show/null+set"} measure zero
            in the sense that, given any
            %a.existingWikiWord{:href => "/nlab/show/positive+number"} positive number
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                  %annotation{:encoding => "application/x-tex"} \epsilon
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℐ
                %annotation{:encoding => "application/x-tex"} \mathcal{I}
            of open intervals (even with rational endpoints), such that every computable real number belongs to at least one member of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℐ
                  %annotation{:encoding => "application/x-tex"} \mathcal{I}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℐ
                %annotation{:encoding => "application/x-tex"} \mathcal{I}
            is less than
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                  %annotation{:encoding => "application/x-tex"} \epsilon
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/Turing+machines"} Turing machines
            %a.existingWikiWord{:href => "/nlab/show/Lebesgue+measure"} Lebesgue measure
            in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Russian+constructivism"} Russian constructivism
          %p
            From a localic perspective, however, while
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℐ
                %annotation{:encoding => "application/x-tex"} \mathcal{I}
            might cover all the
            %em points
            of the real line, it cannot cover all of the pointless parts (which need not be empty). Indeed, we have this result ruling out such shenanigans:
          #not-null.num_prop
            %h6#proposition Proposition
            %p
              Given any open interval
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} I = (a,b)
              with rational endpoints and any collection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒥
                  %annotation{:encoding => "application/x-tex"} \mathcal{J}
              of such intervals, if
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mo ⊆
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋃
                      %mi 𝒥
                    %annotation{:encoding => "application/x-tex"} I \subseteq \bigcup \mathcal{J}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mo &lt;
                      %mi b
                      %mo −
                      %mi a
                    %annotation{:encoding => "application/x-tex"} L \lt b - a
              %span.newWikiWord
                finite
                %a{:href => "/nlab/new/finite+subset"} ?
              (in the strictest sense) subcollection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi K
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi K
                      %mi n
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{K_1, \ldots, K_n\}
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒥
                  %annotation{:encoding => "application/x-tex"} \mathcal{J}
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo ≤
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
