                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒰
                    %annotation{:encoding => "application/x-tex"} \mathcal{U}
          .proof
            %h6#proof Proof
            %p
              If
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ≥
                      %mi b
                    %annotation{:encoding => "application/x-tex"} a \geq b
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo &lt;
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a \lt b
              and prove the lemma by induction on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n = 1
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo &lt;
                      %mi b
                    %annotation{:encoding => "application/x-tex"} a \lt b
            %p
              Now assume (as an inductive hypothesis) that the lemma holds for zigzags of length
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              for some
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ≥
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} k \geq 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo +
                  %annotation{:encoding => "application/x-tex"} k+
              consists of a zig
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %msub
                      %mi b
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (a,b_1)
              from some open in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒰
                    %annotation{:encoding => "application/x-tex"} \mathcal{U}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi b
                        %mn 1
                      %mo &gt;
                      %msub
                        %mi a
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} b_1 \gt a_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} a_2
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
              with zigs from
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒰
                    %annotation{:encoding => "application/x-tex"} \mathcal{U}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              with an orderly zigzag of length
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi l
                    %mo ≤
                    %mi k
                  %annotation{:encoding => "application/x-tex"} l \leq k
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} a_2
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo =
                    %msub
                      %mi b
                      %mrow
                        %mi l
                        %mo +
                  %annotation{:encoding => "application/x-tex"} b = b_{l+}
              with zigs from
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒰
                    %annotation{:encoding => "application/x-tex"} \mathcal{U}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi l
                    %mo +
                    %mo ≤
                    %mi k
                    %mo +
                  %annotation{:encoding => "application/x-tex"} l+ \leq k+
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
              with zigs from
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒰
                    %annotation{:encoding => "application/x-tex"} \mathcal{U}
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo &lt;
                    %msub
                      %mi a
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} a \lt a_2
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi b
                        %mn 1
                      %mo &lt;
                      %msub
                        %mi b
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} b_1 \lt b_2
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo &lt;
                      %msub
                        %mi a
                        %mn 2
                      %mo &lt;
                      %msub
                        %mi b
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} a \lt a_2 \lt b_1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi l
                    %mo +
                  %annotation{:encoding => "application/x-tex"} l+
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
              is orderly.
            %p
              Next suppose that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo &lt;
                    %msub
                      %mi a
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} a \lt a_2
              but
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi b
                        %mn 1
                      %mo ≥
                      %msub
                        %mi b
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} b_1 \geq b_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ≥
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} i \geq 2
              such that
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi b
                        %mn 1
                      %mo ≥
                      %msub
                        %mi b
                        %mi i
                    %annotation{:encoding => "application/x-tex"} b_1 \geq b_i
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo =
                      %mi l
                      %mo +
                    %annotation{:encoding => "application/x-tex"} i = l+
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                    %annotation{:encoding => "application/x-tex"} b
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %msub
                      %mi b
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (a,b_1)
              was, since
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi b
                        %mn 1
                      %mo ≥
                      %msub
                        %mi b
                        %mi i
                      %mo =
                      %mi b
                    %annotation{:encoding => "application/x-tex"} b_1 \geq b_i = b
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ≤
                    %mi l
                  %annotation{:encoding => "application/x-tex"} i \leq l
              instead, then take the orderly zigzag from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mrow
                        %mi i
                        %mo +
                  %annotation{:encoding => "application/x-tex"} a_{i+}
              to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                    %annotation{:encoding => "application/x-tex"} b
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %msub
                        %mi b
                        %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (a,b_i)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi l
                    %mo −
                    %mi i
                    %mo +
                    %mn 2
                    %mo ≤
                    %mi k
                  %annotation{:encoding => "application/x-tex"} l - i + 2 \leq k
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                    %annotation{:encoding => "application/x-tex"} b
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo &lt;
                      %msub
                        %mi a
                        %mn 2
                      %mo &lt;
                      %msub
                        %mi a
                        %mrow
                          %mi i
                          %mo +
                    %annotation{:encoding => "application/x-tex"} a \lt a_2 \lt a_{i+}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒰
                  %annotation{:encoding => "application/x-tex"} \mathcal{U}
              since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %msub
                      %mi b
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (a,b_i)
              is contained in the same open as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %msub
                      %mi b
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (a,b_1)
              was (since
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi b
                        %mn 1
                      %mo ≥
                      %msub
                        %mi b
                        %mi i
                    %annotation{:encoding => "application/x-tex"} b_1 \geq b_i
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
              with zigs from
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒰
                    %annotation{:encoding => "application/x-tex"} \mathcal{U}
            %p
              Finally, suppose that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ≥
                      %msub
                        %mi a
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} a \geq a_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ≥
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} i \geq 2
              such that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ≥
                      %msub
                        %mi a
                        %mi i
                    %annotation{:encoding => "application/x-tex"} a \geq a_i
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mi i
                  %annotation{:encoding => "application/x-tex"} a_i
              to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                    %annotation{:encoding => "application/x-tex"} b
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mi i
                  %annotation{:encoding => "application/x-tex"} a_i
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              to get a zigzag from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                    %annotation{:encoding => "application/x-tex"} b
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ≤
                      %mi l
                    %annotation{:encoding => "application/x-tex"} i \leq l
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo &lt;
                      %msub
                        %mi a
                        %mrow
                          %mi i
                          %mo +
                      %mo &lt;
                      %msub
                        %mi b
                        %mi i
                    %annotation{:encoding => "application/x-tex"} a \lt a_{i+} \lt b_i
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo =
                      %mi l
                      %mo +
                    %annotation{:encoding => "application/x-tex"} i = l+
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo &lt;
                      %mi b
                      %mo =
                      %msub
                        %mi b
                        %mi i
                    %annotation{:encoding => "application/x-tex"} a \lt b = b_i
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %msub
                      %mi b
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (a,b_i)
              belongs to the same open as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mi i
                    %mo ,
                    %msub
                      %mi b
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (a_i,b_i)
              did (since
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ≥
                      %msub
                        %mi a
                        %mi i
                    %annotation{:encoding => "application/x-tex"} a \geq a_i
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi l
                    %mo −
                    %mi i
                    %mo +
                    %mn 2
                    %mo ≤
                    %mi k
                  %annotation{:encoding => "application/x-tex"} l - i + 2 \leq k
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
              still has zigs from
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒰
                    %annotation{:encoding => "application/x-tex"} \mathcal{U}
            %p
              In any case, we have a zigzag of length at most
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo +
                  %annotation{:encoding => "application/x-tex"} k+
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
              with zigs from
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒰
                    %annotation{:encoding => "application/x-tex"} \mathcal{U}
          %p This lemma is used in the proofs of the infinite distributivity law and some results related to measure.
          %h2#the_frame_of_opens The frame of opens
          %p
            The opens form a
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/subobject"} sub
            %a.existingWikiWord{:href => "/nlab/show/poset"} poset
            of the
            %a.existingWikiWord{:href => "/nlab/show/power+set"} power set
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒫
                    %mo{:stretchy => "false"} (
                    %mi ℚ
                    %mo ×
                    %mi ℚ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{P}(\mathbb{Q} \times \mathbb{Q})
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/frame"} frame
            %em not
            a subframe of the power set, since the
            %a.existingWikiWord{:href => "/nlab/show/joins"} joins
            are different. It
            %em is
            a sub-
            %a.existingWikiWord{:href => "/nlab/show/inflattice"} inflattice
            of the power set, although this seems to be a red herring at least for infinitary
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/meets"} meets
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/top+element"} top
            open, denoted
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            %a.existingWikiWord{:href => "/nlab/show/meet"} meet
            in the poset of opens, denoted
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ∩
                    %mi H
                  %annotation{:encoding => "application/x-tex"} G \cap H
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/logical+conjunction"} conjunction
            %a.existingWikiWord{:href => "/nlab/show/intersection"} intersection
            as
            %a.existingWikiWord{:href => "/nlab/show/subsets"} subsets
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℚ
                    %mo ×
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Q} \times \mathbb{Q}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo ∩
                  %mi H
                %annotation{:encoding => "application/x-tex"} G \cap H
            are opens and to prove that these are the desired meets. Intuitively, this all works because an open interval will be contained in the intersection of a family of open sets if and only if it is contained in each individual open set.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/bottom+element"} bottom
            open, denoted
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} \empty
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≥
                  %annotation{:encoding => "application/x-tex"} \geq
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo ⊆
                  %mi ∅
                %annotation{:encoding => "application/x-tex"} (a,b) \subseteq \empty
            iff
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ≥
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a \geq b
            %a.existingWikiWord{:href => "/nlab/show/empty+subset"} empty subset
            of the real line;
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (a,b)
            is empty if and only if
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ≥
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a \geq b
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ∅
                %annotation{:encoding => "application/x-tex"} \empty
            is
            %em not
            the empty subset of
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℚ
                    %mo ×
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Q} \times \mathbb{Q}
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/relation+theory"} algebra of relations
          %p
            Given two opens
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            %a.existingWikiWord{:href => "/nlab/show/join"} join
            in the poset of opens, denoted
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ∪
                    %mi H
                  %annotation{:encoding => "application/x-tex"} G \cup H
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo ⊆
                  %mi G
                  %mo ∪
                  %mi H
                %annotation{:encoding => "application/x-tex"} (a,b) \subseteq G \cup H
            if, whenever
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo &lt;
                  %msub
                    %mi a
                    %mn 1
                %annotation{:encoding => "application/x-tex"} a \lt a_1
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi b
                      %mi n
                    %mo &lt;
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b_n \lt b
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mn 1
                %annotation{:encoding => "application/x-tex"} a_1
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi b
                    %mi n
                %annotation{:encoding => "application/x-tex"} b_n
            with zigs from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            are both contained. Conversely, any open in which
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            are contained must contain this open
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ∪
                    %mi H
                  %annotation{:encoding => "application/x-tex"} G \cup H
          %p
            More generally, given any collection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒰
                %annotation{:encoding => "application/x-tex"} \mathcal{U}
            (or family
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi G
                      %mi k
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi k
                  %annotation{:encoding => "application/x-tex"} (G_k)_k
            %a.existingWikiWord{:href => "/nlab/show/join"} join
            in the poset of opens, denoted
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋃
                  %mi 𝒰
                %annotation{:encoding => "application/x-tex"} \bigcup \mathcal{U}
            (or
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋃
                      %mi k
                    %msub
                      %mi G
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \bigcup_k G_k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo ⊆
                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋃
                  %mi 𝒰
                %annotation{:encoding => "application/x-tex"} (a,b) \subseteq \bigcup \mathcal{U}
            if and only if, whenever
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo &lt;
                  %msub
                    %mi a
                    %mn 1
                %annotation{:encoding => "application/x-tex"} a \lt a_1
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi b
                      %mi n
                    %mo &lt;
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b_n \lt b
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mn 1
                %annotation{:encoding => "application/x-tex"} a_1
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi b
                    %mi n
                %annotation{:encoding => "application/x-tex"} b_n
            with zigs from
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒰
                  %annotation{:encoding => "application/x-tex"} \mathcal{U}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ≥
                  %mi b
                %annotation{:encoding => "application/x-tex"} a \geq b
            counts even when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒰
                %annotation{:encoding => "application/x-tex"} \mathcal{U}
            is empty, using zigzags of length
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mi k
                  %annotation{:encoding => "application/x-tex"} G_k
          %p
            Finally, we must check the distributive law
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ∩
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋃
                      %mi k
                    %msub
                      %mi H
                      %mi k
                    %mo ⊆
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋃
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ∩
                    %msub
                      %mi H
                      %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G \cap \bigcup_k H_k \subseteq \bigcup_k (G \cap H_k)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ∼
                  %mi b
                %annotation{:encoding => "application/x-tex"} a \sim b
            directly through
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mn 1
                  %mo ∼
                  %msub
                    %mi b
                    %mi n
                %annotation{:encoding => "application/x-tex"} a_1 \sim b_n
            through a zigzag of
            = succeed "s" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mn 1
                    %mo ,
                    %msub
                      %mi b
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ⋐
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (a_1,b_n) \Subset (a,b)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mn 1
                  %mo ∼
                  %msub
                    %mi b
                    %mi n
                %annotation{:encoding => "application/x-tex"} a_1 \sim b_n
            through a zigzag in which each zig is related both through
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            and through some
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            = succeed "s," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            %a.maruku-ref{:href => "#zigzaglemma"}
            to get an orderly zigzag of
            = succeed "s," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            as well, by property (2). Therefore, we may interpret each zig using
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo ∩
                  %msub
                    %mi H
                    %mi k
                %annotation{:encoding => "application/x-tex"} G \cap H_k
            for some
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          %p
            This frame of opens, interpreted as a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/locale"} locale
            = succeed "." do
              %strong the locale of real numbers
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
          %h2#open_intervals_as_opens Open intervals as opens
          %p
            Given rational numbers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (a,b)
            may itself be interpreted as an open in the real line, also denoted
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (a,b)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mo ⊆
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (c,d) \subseteq (a,b)
            hold if every rational number strictly between
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                %annotation{:encoding => "application/x-tex"} d
            (in that order) is also strictly between
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                %annotation{:encoding => "application/x-tex"} b
            (in that order). In other words, we interpret ‘
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mo ⊆
                %annotation{:encoding => "application/x-tex"} {\subseteq}
            ’ literally as comparing subsets of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Q}
            = succeed "\u2019;" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo ⊆
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (c,d) \subseteq (a,b)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mo ⊆
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (c,d) \subseteq (a,b)
            (in the set-theoretic sense) if and only if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi e
                  %mo ,
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo ⊆
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (e,f) \subseteq (a,b)
            whenever
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo ⊆
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (e,f) \subseteq (c,d)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi ∅
                %annotation{:encoding => "application/x-tex"} (a,b) = \empty
            whenever
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ≥
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a \geq b
          %p
            We can actually generalize this somewhat. Given any set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            of rational numbers and any set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            of rational numbers, we may define the open
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi inf
                  %mi U
                  %mo ,
                  %mi sup
                  %mi L
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\inf U, \sup L)
            as follows: let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo ⊆
                  %mo{:stretchy => "false"} (
                  %mi inf
                  %mi U
                  %mo ,
                  %mi sup
                  %mi L
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (a,b) \subseteq (\inf U, \sup L)
            hold if every rational number strictly between
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                %annotation{:encoding => "application/x-tex"} b
            (in that order) is greater than some element of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            and less than some element of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
            %a.existingWikiWord{:href => "/nlab/show/infimum"} infimum
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            and the
            %a.existingWikiWord{:href => "/nlab/show/supremum"} supremum
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            exist in the usual sense as rational numbers, then this agrees with the previous paragraph. If instead
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            is the set of all rational numbers, then we write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} -\infty
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi inf
                  %mi U
                %annotation{:encoding => "application/x-tex"} \inf U
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} \infty
            for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sup
                    %mi L
                  %annotation{:encoding => "application/x-tex"} \sup L
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi inf
                  %mi U
                %annotation{:encoding => "application/x-tex"} \inf U
            as an
            %a.existingWikiWord{:href => "/nlab/show/extended+real+number"} extended
            %a.existingWikiWord{:href => "/nlab/show/upper+real+number"} upper real
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi sup
                  %mi L
                %annotation{:encoding => "application/x-tex"} \sup L
            as an extended
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/lower+real+number"} lower real
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} -\infty
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn ∞
                    %mo ,
                    %mn ∞
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} (-\infty,\infty) = \mathbb{R}
          %p
            Since we will refer to them below, we will state for the record the complete definitions of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn ∞
                  %mo ,
                  %mi a
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (-\infty,a)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mn ∞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (a,\infty)
            for a rational number
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo ⊆
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn ∞
                  %mo ,
                  %mi a
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (b,c) \subseteq (-\infty,a)
            iff every rational number strictly between
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                %annotation{:encoding => "application/x-tex"} b
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
            is less than
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                  %mo ≥
                  %mi c
                %annotation{:encoding => "application/x-tex"} b \geq c
            or
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ≤
                    %mi a
                  %annotation{:encoding => "application/x-tex"} c \leq a
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo ⊆
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mn ∞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (b,c) \subseteq (a,\infty)
            iff every rational number strictly between
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                %annotation{:encoding => "application/x-tex"} b
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
            is greater than
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                  %mo ≥
                  %mi c
                %annotation{:encoding => "application/x-tex"} b \geq c
            or
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ≥
                    %mi a
                  %annotation{:encoding => "application/x-tex"} b \geq a
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo ⊆
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn ∞
                  %mo ,
                  %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (b,c) \subseteq (-\infty,0)
            if
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} c = 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo ⊆
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mn ∞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (b,c) \subseteq (1, \infty)
            if
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} b = 1
          %h2#open_sets_closed_sets_and_points Open sets, closed sets, and points
          %p
            We think of each open as defining an
            %a.existingWikiWord{:href => "/nlab/show/open+subspace"} open subset
            of the real line, but we can equally well think of it as defining a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/closed+subspace"} closed subset
            = succeed "ary" do
              %a.existingWikiWord{:href => "/nlab/show/complement"} complement
            %a.existingWikiWord{:href => "/nlab/show/point"} points
            of the real line.
          %p
            Recall that a
            %a.existingWikiWord{:href => "/nlab/show/real+number"} real number
            may be defined as a pair
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo ,
                  %mi U
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (L,U)
            of
            %a.existingWikiWord{:href => "/nlab/show/inhabited+set"} inhabited
            %a.existingWikiWord{:href => "/nlab/show/subsets"} subsets
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℚ
                %annotation{:encoding => "application/x-tex"} \mathbb{Q}
            satisfying the following properties:
          %ol
            %li
              If
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mi L
                    %annotation{:encoding => "application/x-tex"} a \in L
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo &lt;
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a \lt b
              for some
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo ∈
                      %mi L
                    %annotation{:encoding => "application/x-tex"} b \in L
            %li
              If
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo ∈
                      %mi U
                    %annotation{:encoding => "application/x-tex"} b \in U
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo &lt;
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a \lt b
              for some
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mi U
                    %annotation{:encoding => "application/x-tex"} a \in U
            %li
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi L
                  %annotation{:encoding => "application/x-tex"} a \in L
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo ∈
                      %mi U
                    %annotation{:encoding => "application/x-tex"} b \in U
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo &lt;
                      %mi b
                    %annotation{:encoding => "application/x-tex"} a \lt b
            %li
              If
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo &lt;
                      %mi b
                    %annotation{:encoding => "application/x-tex"} a \lt b
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi L
                  %annotation{:encoding => "application/x-tex"} a \in L
              or
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo ∈
                      %mi U
                    %annotation{:encoding => "application/x-tex"} b \in U
          %p
            We define a
            %strong point
            of the real line to be a real number in this sense. Given such a point
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo ,
                  %mi U
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} x = (L,U)
            and a rational number
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo &lt;
                  %mi x
                %annotation{:encoding => "application/x-tex"} a \lt x
            to mean that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ∈
                  %mi L
                %annotation{:encoding => "application/x-tex"} a \in L
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo &gt;
                  %mi x
                %annotation{:encoding => "application/x-tex"} a \gt x
            to mean that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi U
                  %annotation{:encoding => "application/x-tex"} a \in U
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            directly, we may call
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            the
            %strong lower set
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            the
            = succeed "." do
              %strong upper set
          %p
            Given a point
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            and an open
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            %strong belongs
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
