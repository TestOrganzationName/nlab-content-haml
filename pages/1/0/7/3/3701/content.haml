                      %mi n
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} len
                    %msub
                      %mi K
                      %mi i
                    %mo .
                  %annotation{:encoding => "application/x-tex"} L \leq \sum_{i=1}^n \len K_i .
          %p
            In other words, any cover of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            by intervals must have a total length (defined as the
            %a.existingWikiWord{:href => "/nlab/show/supremum"} supremum
            of the lengths of finite subcollections) at least the length of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
          .proof
            %h6#proof_4 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo ⋐
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (c,d) \Subset (a,b)
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo −
                    %mi c
                    %mo ≥
                    %mi L
                  %annotation{:encoding => "application/x-tex"} d - c \geq L
              (say with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo +
                    %mi b
                    %mo −
                    %mi L
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} c \coloneqq (a + b - L)/2
              and
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo ≔
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo +
                      %mi b
                      %mo +
                      %mi L
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} d \coloneqq (a + b + L)/2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              with zigs from
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒥
                    %annotation{:encoding => "application/x-tex"} \mathcal{J}
              = succeed "," do
                %a.maruku-ref{:href => "#zigzaglemma"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒥
                    %annotation{:encoding => "application/x-tex"} \mathcal{J}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi K
                        %mn 1
                      %mo ,
                      %mi …
                      %mo ,
                      %msub
                        %mi K
                        %mi n
                    %annotation{:encoding => "application/x-tex"} K_1, \ldots, K_n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo =
                        %mn 1
                      %mi n
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} len
                    %msub
                      %mi K
                      %mi i
                    %mo ≥
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo =
                        %mn 1
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi b
                      %mi i
                    %mo −
                    %msub
                      %mi a
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo =
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo =
                        %mn 1
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi b
                      %mi i
                    %mo −
                    %msub
                      %mi a
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi b
                      %mi n
                    %mo −
                    %msub
                      %mi a
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ≥
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo =
                        %mn 1
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mrow
                        %mi i
                        %mo +
                    %mo −
                    %msub
                      %mi a
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi b
                      %mi n
                    %mo −
                    %msub
                      %mi a
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi b
                      %mi n
                    %mo −
                    %msub
                      %mi a
                      %mn 1
                    %mo =
                    %mi d
                    %mo −
                    %mi c
                    %mo ≥
                    %mi L
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} \sum_{i=1}^n \len K_i \geq \sum_{i=1}^n (b_i - a_i) = \sum_{i=1}^{n-1} (b_i - a_i) + (b_n - a_n) \geq \sum_{i=1}^{n-1} (a_{i+} - a_i) + (b_n - a_n) = b_n - a_1 = d - c \geq L ,
            %p
              or
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo ≥
                    %mi L
                  %annotation{:encoding => "application/x-tex"} 0 \geq L
              if
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} n = 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mi i
                  %annotation{:encoding => "application/x-tex"} a_i
              and largest
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi b
                      %mi i
                  %annotation{:encoding => "application/x-tex"} b_i
              that appears in a given interval, and the argument still works (possibly even with some overlap now).
          %p This result can be strengthened to intervals without necessarily rational endpoints, by using the rational intervals that they contain, but this is not the most general statement either, and I think that what we really need to do is to develop a theory of measures of open subspaces (or perhaps even more general subspaces) and state a result about that.
          %h2#as_a_classifying_locale As a classifying locale
          %p
            The locale of real numbers is the
            %a.existingWikiWord{:href => "/nlab/show/classifying+locale"} classifying locale
            of the
            %a.existingWikiWord{:href => "/nlab/show/geometric+theory"} geometric theory
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Dedekind+real+numbers"} Dedekind real numbers
          %h2#defining_functions_in_the_locale_of_real_numbers Defining functions in the locale of real numbers
          %p
            There are two general ways to define functions on the locale of real numbers, via the
            %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
            and via the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Dedekind+real+numbers"} Dedekind real numbers
          %h3#using_the_rational_numbers Using the rational numbers
          %p
            The first approach uses existing functions already defined on the
            %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Q}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi ℚ
                    %mo →
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} f:\mathbb{Q} \to \mathbb{Q}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            to a continuous map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi f
                    %mo ˜
                  %mo :
                  %mi ℝ
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \widetilde{f}:\mathbb{R} \to \mathbb{R}
            on the locale of real numbers.
          %h3#using_the_dedekind_real_numbers Using the Dedekind real numbers
          %p
            The other approach is via using existing functions defined on the
            %a.existingWikiWord{:href => "/nlab/show/Dedekind+real+numbers"} Dedekind real numbers
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ↦
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} x \mapsto f(x)
            on the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Dedekind+real+numbers"} Dedekind real numbers
            %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi{:mathvariant => "normal"} Set
                  %mo →
                  %mi{:mathvariant => "normal"} Sh
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi ℝ
                    %mi D
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F:\mathrm{Set} \to \mathrm{Sh}(\mathbb{R}_D)
            from
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            to the
            %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} Sh
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ℝ
                      %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{Sh}(\mathbb{R}_D)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %msub
                      %mi ℝ
                      %mi D
                  %annotation{:encoding => "application/x-tex"} x \in \mathbb{R}_D
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi F
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi F
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(F^*(x)) = F^*(f(x))
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ↦
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} x \mapsto f(x)
            lifts to a function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ↦
                  %mover
                    %mi f
                    %mo ˜
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} x \mapsto \widetilde{f}(x)
            on the locale of real numbers.
          %p
            This allows us to first define real-valued functions normally on the set of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Dedekind+real+numbers"} Dedekind real numbers
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/exponential+function"} exponential function
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/sine"} sine
            %a.existingWikiWord{:href => "/nlab/show/cosine"} cosine
            which can't be directly defined using functions on the rational numbers.
          %h3#arithmetic Arithmetic
          %p
            Significantly, since the
            %a.existingWikiWord{:href => "/nlab/show/field"} field
            operations on the discrete locale of
            %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
            are all locally uniformly continuous on the
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Q}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℝ
                      %mi D
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}_D
            %a.existingWikiWord{:href => "/nlab/show/arithmetic"} arithmetic
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
          %h2#references References
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Simon+Henry"}> Simon Henry
                ,
                = succeed "," do
                  %em Localic Metric spaces and the localic Gelfand duality
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1411.0898"} arXiv:1411.0898
            %li
              %p
                Guillaume Raynaud,
                %em Fibred Contextual Quantum Physics
                (
                %a{:href => "https://etheses.bham.ac.uk/id/eprint/1685/"}> etheses:1685
                ,
                = succeed ")" do
                  %a{:href => "https://etheses.bham.ac.uk//id/eprint/1685/1/Raynaud14PhD.pdf"} pdf
          %p
            The locale of real numbers as the
            %a.existingWikiWord{:href => "/nlab/show/classifying+locale"} classifying locale
            of the
            %a.existingWikiWord{:href => "/nlab/show/geometric+theory"} geometric theory
            of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/two-sided+Dedekind+cuts"} two-sided Dedekind cuts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Ingo+Blechschmidt"}> Ingo Blechschmidt
              , section 2.2 of:
              = succeed "," do
                %em Generalized spaces for constructive algebra
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/2012.13850"} arXiv:2012.13850
          %p An (impredicative) construction of the locale of real numbers can be found in section 5.3 of:
          %ul
            %li
              Graham Manuell,
              = succeed "," do
                %em Uniform locales and their constructive aspects
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/2106.00678"} arXiv:2106.00678
          %p
            On lifting functions from the
            %a.existingWikiWord{:href => "/nlab/show/Dedekind+real+numbers"} Dedekind real numbers
            to the locale of real numbers, see:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Madeleine+Birchfield"}> Madeleine Birchfield
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Simon+Henry"} Simon Henry
                %em The field structure on the locale of real numbers
                (2022) &amp;lbrack;
                %a{:href => "https://mathoverflow.net/q/434706/381"}> MO:q/434706
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Valery+Isaev"}> Valery Isaev
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Simon+Henry"} Simon Henry
                %em Localic maps given by series
                (
                %a{:href => "https://mathoverflow.net/q/426682/"}> MathOverflow
                )
