                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            %a.existingWikiWord{:href => "/nlab/show/equivalence+relations"} equivalence relations
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi π
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} \pi \colon X \to Y
            is taken to the equivalence relation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mi π
                %annotation{:encoding => "application/x-tex"} E_{\pi}
            gotten by pulling back the
            %a.existingWikiWord{:href => "/nlab/show/diagonal"} diagonal
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            is taken to the function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi E
                %annotation{:encoding => "application/x-tex"} f_E
            which
            %a.existingWikiWord{:href => "/nlab/show/projection"} projects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            onto the set of
            = succeed "-classes." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            with the category of
            %a.existingWikiWord{:href => "/nlab/show/definable+sets"} definable sets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Def
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{Def}(T)
            of a
            %a.existingWikiWord{:href => "/nlab/show/first-order+theory"} first-order theory
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            is a definable equivalence relation, there may not be a corresponding definable
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi E
                  %annotation{:encoding => "application/x-tex"} f_E
            %a.existingWikiWord{:href => "/nlab/show/internal+congruences"} internal congruences
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Def
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{Def}(T)
            are not generally effective.
          %h2#definition Definition
          %p We say that:
          %ol
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
                has
                %strong uniform elimination of imaginaries
                if the above correspondence does hold, that is, if internal congruences in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Def
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{Def}(T)
                are effective.
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
                has
                %strong elimination of imaginaries
                if for every definable set
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo =
                        %mo{:stretchy => "false"} {
                        %mi m
                        %mo ∈
                        %mi 𝕄
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} |
                        %mi φ
                        %mo{:stretchy => "false"} (
                        %mi m
                        %mo ,
                        %mi b
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} X = \{m \in \mathbb{M} \operatorname{ | } \varphi(m,b)\}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ψ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \psi(x,y)
                and a tuple
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                    %annotation{:encoding => "application/x-tex"} c
                with the same sort as
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                    %annotation{:encoding => "application/x-tex"} y
                such that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                    %annotation{:encoding => "application/x-tex"} c
                uniquely satisfies
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo =
                      %mo{:stretchy => "false"} {
                      %mi m
                      %mo ∈
                      %mi M
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} |
                      %mi ψ
                      %mo{:stretchy => "false"} (
                      %mi m
                      %mo ,
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} }
                      %mo .
                    %annotation{:encoding => "application/x-tex"} X = \{m \in M \operatorname{ | } \psi(m,c)\}.
          %p
            Inside a saturated model
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕄
                    %mo ⊧
                    %mi T
                  %annotation{:encoding => "application/x-tex"} \mathbb{M} \models T
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
            such that for all
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo ∈
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Aut
                    %mo{:stretchy => "false"} (
                    %mi 𝕄
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sigma \in \operatorname{Aut}(\mathbb{M})
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi X
                %annotation{:encoding => "application/x-tex"} \sigma(X) = X
            setwise if and only if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi c
                %annotation{:encoding => "application/x-tex"} \sigma(c) = c
            pointwise. This is sometimes called the
            = succeed "." do
              %strong coding of definable sets
          %p
            Poizat noticed that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            having elimination of imaginaries allows one to develop a classical Galois theory classifying definably-closed extensions of small parameter sets in terms of the closed subgroups of a profinite automorphism group in any sufficiently saturated model of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
          %p
            The
            %em imaginary elements
            of a theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            are precisely
            = succeed "-classes," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            is a
            = succeed "-definable" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
          %h2#the__construction
            The
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} eq
                %annotation{:encoding => "application/x-tex"} (-)^{\operatorname{eq}}
            construction
          %p
            In the process of inventing
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/stability+theory"} stability theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            in a theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi T
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} eq
                %annotation{:encoding => "application/x-tex"} T^{\operatorname{eq}}
            which eliminated all the imaginaries of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            a new sort (
            %a.existingWikiWord{:href => "/nlab/show/type"} type
            in type theory) for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo{:stretchy => "false"} /
                  %mi E
                %annotation{:encoding => "application/x-tex"} X/E
            and a projection map
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ↠
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi E
                  %annotation{:encoding => "application/x-tex"} X \twoheadrightarrow X/E
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi T
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} eq
                %annotation{:encoding => "application/x-tex"} T^{\operatorname{eq}}
            satisfies the following universal property: any theory which interprets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            and eliminates imaginaries must uniquely interpret
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi T
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} eq
                %annotation{:encoding => "application/x-tex"} T^{\operatorname{eq}}
            as theories under
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            (in the
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
          %p
            Makkai realized not long after that the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} eq
                %annotation{:encoding => "application/x-tex"} (-)^{\operatorname{eq}}
            construction corresponded to the
            %a.existingWikiWord{:href => "/nlab/show/pretopos+completion"} pretopos completion
            of the
            %a.existingWikiWord{:href => "/nlab/show/syntactic+category"} syntactic category
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
          %p (Indeed, pretoposes are just toposes that might be missing some power objects. According to the next section, inside a Boolean pretopos these power objects will still be there, just generally only formally.)
          %h2#relation_to_indrepresentable_power_objects Relation to ind-representable power objects
          %p If a first-order theory eliminates imaginaries, it interprets infinitely many constants. This is because it interprets at least two constants: a code for the diagonal relation and its complement. Taking binary sequences of these two constants in higher and higher Cartesian products of the model with itself produces infinitely many constants.
          %p
            In particular, when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            eliminates imaginaries, its
            %a.existingWikiWord{:href => "/nlab/show/syntactic+category"} syntactic category
            has finite
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/coproducts"} coproducts
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \mathbf{2}
            exists, and all definable subsets have definable classifying maps.
          %p
            The following characterization is due to Moshe Kamensky, and can be found
            = succeed "." do
              %a{:href => "https://arxiv.org/abs/1012.3185"} here
          .num_prop
            %h6#proposition Proposition
            %p
              Let (T) be a first-order theory which interprets two constants. Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              eliminates imaginaries if and only if for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Def
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{Def}(T)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Z
                    %mo ↦
                    %msub
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} Hom
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi Def
                        %mo{:stretchy => "false"} (
                        %mi T
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi Z
                    %mo ×
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Z \mapsto \operatorname{Hom}_{\mathbf{Def}(T)}(Z \times X, Y)
              is ind-representable.
          .proof
            %h6#proof Proof
            %p
              Suppose first that the presheaves
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Y
                      %mi X
                    %mover
                      %mo =
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} df
                    %mi Z
                    %mo ↦
                    %msub
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} Hom
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi Def
                        %mo{:stretchy => "false"} (
                        %mi T
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi Z
                    %mo ×
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Y^X \overset{\operatorname{df}}{=}Z \mapsto \operatorname{Hom}_{\mathbf{Def}(T)}(Z \times X,Y)
              are ind-representable. Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %munder
                        %mo ⇉
                        %mi t
                      %mi s
                    %mi X
                  %annotation{:encoding => "application/x-tex"} E \overset{s}{\underset{t}{\rightrightarrows}} X
              be a definable equivalence relation on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mi E
                    %mo :
                    %mi X
                    %mo ×
                    %mi X
                    %mo →
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} \phi_E : X \times X \to 2
              classify
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mover
                        %mo ↪
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi s
                          %mo ,
                          %mi t
                          %mo{:stretchy => "false"} )
                      %mi X
                      %mo ×
                      %mi X
                    %annotation{:encoding => "application/x-tex"} E \overset{(s,t)}{\hookrightarrow} X \times X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi y
                    %mo :
                    %mstyle{:mathvariant => "bold"}
                      %mi Def
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mover
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi Def
                        %mo{:stretchy => "false"} (
                        %mi T
                        %mo{:stretchy => "false"} )
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \mathbf{y} : \mathbf{Def}(T) \hookrightarrow \widehat{\mathbf{Def}(T)}
              be the Yoneda embedding. Then
