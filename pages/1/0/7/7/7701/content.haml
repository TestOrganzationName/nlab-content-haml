                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \operatorname{Pt}(1, Y^X) \to \mathbf{Def}(T)
              by sending
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi Z
                    %mo ×
                    %mi X
                    %mo →
                    %mi Y
                    %mo ↦
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} f : Z \times X \to Y \mapsto Z
              creates colimits, in particular finite coproducts, which by assumption exist in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Def
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{Def}(T)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Pt
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %msup
                      %mi Y
                      %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \operatorname{Pt}(1, Y^X)
              is filtered, and since for any presheaf
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ≃
                    %munder
                      %mi lim
                      %mo ⟶
                    %mrow
                      %mo (
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} Pt
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo ,
                      %mi P
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo →
                        %mi p
                      %mstyle{:mathvariant => "bold"}
                        %mi Def
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo ↪
                        %mstyle{:mathvariant => "bold"}
                          %mi y
                      %mover
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi Def
                          %mo{:stretchy => "false"} (
                          %mi T
                          %mo{:stretchy => "false"} )
                        %mo ^
                      %mo )
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} P \simeq \underset{\longrightarrow}{\lim}\left(\operatorname{Pt}(1,P) \overset{p}{\to} \mathbf{Def}(T) \overset{\mathbf{y}}{\hookrightarrow} \widehat{\mathbf{Def}(T)}\right),
            %p
              so
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Y
                      %mi X
                  %annotation{:encoding => "application/x-tex"} Y^X
              is ind-representable.
          .num_remark
            %h6#remark Remark
            %p In the above proof, complementation is required to characterize compactness as “every covering of a definable set by an infinite family of definable sets is finitely supported.” The same proof works if we replace inner homs with power objects.
          %h2#imaginaries_and_automorphisms Imaginaries and automorphisms
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                  %mo ⊧
                  %mi T
                %annotation{:encoding => "application/x-tex"} M \models T
            be a model. If a formula
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi φ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi x
                    %mn 1
                  %mo ,
                  %msub
                    %mi x
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \varphi(x_1, x_2)
            is a
            = succeed "-definable" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            (i.e. an
            %a.existingWikiWord{:href => "/nlab/show/internal+congruence"} internal congruence
            in
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Def
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{Def}(T)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                %annotation{:encoding => "application/x-tex"} \sigma
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            must preserve and reflect
            = succeed "-equivalence," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                %annotation{:encoding => "application/x-tex"} \sigma
            extends along
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ↠
                  %mi X
                  %mo{:stretchy => "false"} /
                  %mi E
                %annotation{:encoding => "application/x-tex"} X \twoheadrightarrow X/E
            to a permutation on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi E
                  %annotation{:encoding => "application/x-tex"} X/E
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝕄
                %annotation{:encoding => "application/x-tex"} \mathbb{M}
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            to a monster model
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝕄
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} eq
                %annotation{:encoding => "application/x-tex"} \mathbb{M}^{\operatorname{eq}}
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi T
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} eq
                %annotation{:encoding => "application/x-tex"} T^{\operatorname{eq}}
            will have the same automorphism group as
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕄
                  %annotation{:encoding => "application/x-tex"} \mathbb{M}
          %p
            To make things concrete, let’s consider the structure
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathbb{Z}, +)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
          %p
            However, we can tell that this structure has many imaginaries by its rigidity: the above automorphism is the only nontrivial one. This is because any such automorphism of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi ℤ
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathbb{Z},+)
            must also act on the internal congruences
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mi n
                %annotation{:encoding => "application/x-tex"} E_n
            which say
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %msub
                    %mo ∼
                    %mrow
                      %msub
                        %mi E
                        %mi n
                  %mi y
                  %mo ⇔
                  %mi x
                  %mo ≡
                  %mi y
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} mod
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo ⇔
                  %mo{:stretchy => "false"} (
                  %mo ∃
                  %mi ℓ
                  %mo{:stretchy => "false"} )
                  %mrow
                    %mo [
                    %mi x
                    %mo −
                    %mi y
                    %mo =
                    %mi ℓ
                    %mo +
                    %mi …
                    %mtext (n times)
                    %mi …
                    %mo +
                    %mi ℓ
                    %mo ]
                  %mo ,
                %annotation{:encoding => "application/x-tex"} x \sim_{E_n} y \iff x \equiv y (\operatorname{mod} n) \iff (\exists \ell)\left[x - y = \ell + \dots \text{ (n times) } \dots + \ell\right],
          %p
            that is, must extend along the abelian group epimorphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                  %mo ↠
                  %mi ℤ
                  %mo{:stretchy => "false"} /
                  %mi n
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z} \twoheadrightarrow \mathbb{Z}/n\mathbb{Z}
            for each
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo ↦
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi k
                %annotation{:encoding => "application/x-tex"} k \mapsto -k
            is the only one that works.
          %p
            (It’s essentially for this reason that the automorphism group of the
            %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Grp
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi Set
                %annotation{:encoding => "application/x-tex"} \mathbf{Grp} \to \mathbf{Set}
            is also
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2 \mathbb{Z}
          %h2#related_entries Related entries
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/pretopos+completion"} pretopos completion
            %li
              %p
