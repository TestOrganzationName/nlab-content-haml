          %h2#references References
          %ul
            %li
              %p
                Bruno Poizat,
                = succeed "," do
                  %em Une théorie de Galois imaginaire
                %strong 48
                (1984), no.4, 1151-1170,
                = succeed "," do
                  %a{:href => "http://www.ams.org/mathscinet-getitem?mr=727805"} MR85e:03083
                %a{:href => "http://dx.doi.org/10.2307/2273680"} doi
            %li
              %p
                wikipedia
                %a{:href => "http://en.wikipedia.org/wiki/Imaginary_element"} imaginary element
            %li
              %p
                Anand Pillay,
                = succeed "," do
                  %em Some remarks on definable equivalence relations in O-minimal structures
                %strong 51
                (1986), 709-714,
                = succeed "," do
                  %a{:href => "http://www.ams.org/mathscinet-getitem?mr=853850"} MR87h:03046
                %a{:href => "http://dx.doi.org/10.2307/2274024"} doi
            %li
              %p
                Jan Holly,
                = succeed "," do
                  %em Definable operations on sets and elimination of imaginaries
                %strong 117
                (1993), no. 4, 1149–1157,
                = succeed "," do
                  %a{:href => "http://www.ams.org/mathscinet-getitem?mr=1116261"} MR93e:03052
                = succeed "," do
                  %a{:href => "http://dx.doi.org/10.2307/2159546"} doi
                %a{:href => "http://www.ams.org/journals/proc/1993-117-04/S0002-9939-1993-1116261-6/S0002-9939-1993-1116261-6.pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ehud+Hrushovski"}> Ehud Hrushovski
                ,
                = succeed "," do
                  %em Groupoids, imaginaries and internal covers
                = succeed ";" do
                  %a{:href => "http://arxiv.org/abs/math/0603413"} arxiv/math.LO/0603413
                = succeed "," do
                  %em On finite imaginaries
                %a{:href => "http://arxiv.org/abs/0902.0842"} arxiv/0902.0842
            %li
              %p
                D. Haskell, E. Hrushovski, H.D.Macpherson,
                = succeed "," do
                  %em Definable sets in algebraically closed valued fields: elimination of imaginaries
                %strong 597
                (2006)
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Saharon+Shelah"}> Saharon Shelah
                ,
