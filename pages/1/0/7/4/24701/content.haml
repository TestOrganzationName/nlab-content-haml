                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo =
                        %mrow
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo{:stretchy => "false"} )
                      %msub
                        %mi c
                        %mn 0
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi x
                          %mo :
                          %mi ℕ
                      %mi c
                      %mo{:stretchy => "false"} (
                      %mi s
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo =
                        %mrow
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mi s
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                      %msub
                        %mi c
                        %mi s
