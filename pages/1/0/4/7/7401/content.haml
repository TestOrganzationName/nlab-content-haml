                  any object in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi t
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                        %mo{:stretchy => "false"} /
                        %mi s
                      %annotation{:encoding => "application/x-tex"} t_{n-1}/s
                  it factors essentially uniquely as
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi d
