                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo −
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Latch_n(X_{\leq (n-1)}) \to X_n \to Match_n(X_{\leq (n-1)})
            %p
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi G
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi 𝒞
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [G_n(S), \mathcal{C}]
            %p
              Accordingly, given morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mrow
                        %mo ≤
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo −
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo :
                    %msub
                      %mi X
                      %mrow
                        %mo ≤
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo −
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi Y
                      %mrow
                        %mo ≤
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo −
                        %mn 1
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f_{\leq (n-1)} : X_{\leq (n-1)} \to Y_{\leq (n-1)}
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mi n
                      %mo :
                      %msub
                        %mi X
                        %mi n
                      %mo →
                      %msub
                        %mi Y
                        %mi n
                    %annotation{:encoding => "application/x-tex"} f_n : X_n \to Y_n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mrow
                        %mo ≤
                        %mi n
                    %mo :
                    %msub
                      %mi X
                      %mrow
                        %mo ≤
                        %mi n
                    %mo →
                    %msub
                      %mi Y
