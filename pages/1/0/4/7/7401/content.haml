                        %mo ≤
                        %mi n
                  %annotation{:encoding => "application/x-tex"} f_{\leq n} : X_{\leq n} \to Y_{\leq n}
              are in bijection with choices of vertical morphisms in commuting diagrams
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi Latch
                              %mi n
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi X
                              %mrow
                                %mo ≤
                                %mo{:stretchy => "false"} (
                                %mi n
                                %mo −
                                %mn 1
                                %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi Latch
                                  %mi n
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi f
                                  %mrow
                                    %mo ≤
                                    %mo{:stretchy => "false"} (
                                    %mi n
                                    %mo −
                                    %mn 1
                                    %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} )
                          %mtd
                            %msub
                              %mi Latch
                              %mi n
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Y
                              %mrow
                                %mo ≤
                                %mo{:stretchy => "false"} (
                                %mi n
                                %mo −
                                %mn 1
                                %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msub
                              %mi X
                              %mi n
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi f
                                  %mi n
                          %mtd
                            %msub
                              %mi Y
                              %mi n
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msub
                              %mi Match
                              %mi n
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi X
                              %mrow
                                %mo ≤
                                %mo{:stretchy => "false"} (
                                %mi n
                                %mo −
                                %mn 1
                                %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi Match
                                  %mi n
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi f
                                  %mrow
                                    %mo ≤
                                    %mo{:stretchy => "false"} (
                                    %mi n
                                    %mo −
                                    %mn 1
                                    %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} )
                          %mtd
                            %msub
                              %mi Match
                              %mi n
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Y
                              %mrow
                                %mo ≤
                                %mo{:stretchy => "false"} (
                                %mi n
                                %mo −
                                %mn 1
                                %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Latch_n(X_{\leq (n-1)}) &amp;\stackrel{Latch_n(f_{\leq (n-1)})}{\to}&amp; Latch_n(Y_{\leq (n-1)})
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    X_n &amp;\stackrel{f_n}{\to}&amp; Y_n
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    Match_n(X_{\leq (n-1)})
                    \&amp;\stackrel{Match_n(f_{\leq (n-1)})}{\to}&amp;
                    Match_n(Y_{\leq (n-1)})
                    }
                    \\,.
          .proof
            %h6#proof_7 Proof
            %p
              If the object exists, then the morphisms do, by the above definitions/discussion. Conversely, given these morphisms, we take
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mrow
                        %mo ≤
                        %mi n
                    %mo :
                    %mi S
                    %mo →
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} X_{\leq n} : S \to \mathcal{C}
              to be given by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mrow
                        %mo ≤
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo −
                        %mn 1
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X_{\leq (n-1)}
              on morphism of degree
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ≤
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \leq (n-1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi n
                  %annotation{:encoding => "application/x-tex"} X_n
              on morphisms between objects of degree
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Latch
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi X
                      %mi n
                  %annotation{:encoding => "application/x-tex"} Latch_n(X) \to X_n
              and by the cone-components of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mi n
                      %mo →
                      %msub
                        %mi Match
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} X_n \to Match_n(X)
          %h2#proof_of_the_model_category_axioms Proof of the model category axioms
          %p
            We discuss that for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            a Berger-Moerdijk-
            %a.existingWikiWord{:href => "/nlab/show/generalized+Reedy+category"} generalized Reedy category
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cofibrantly+generated+model+category"} cofibrantly generated model category
            %a.maruku-ref{:href => "#ReedyModelStructure"}
            indeed defines a
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            structure on the
            %a.existingWikiWord{:href => "/nlab/show/functor+category"} functor category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi S
                    %mo ,
                    %mi 𝒞
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [S,\mathcal{C}]
          .num_theorem
            %h6#theorem Theorem
            %p
              Def.
              %a.maruku-ref{:href => "#ReedyModelStructure"}
              indeed defines a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/model+category"} model structure
          .proof
            %h6#proof_8 Proof
            %p
              It is clear that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi S
                    %mo ,
                    %mi 𝒞
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [S,\mathcal{C}]
              has all limits and colimits (as for any
              %a.existingWikiWord{:href => "/nlab/show/category+of+presheaves"} category of presheaves
              they are computed objectwise in
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/two-out-of-three"} two-out-of-three
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              do. Also, all three classes of morphisms are closed under
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/retracts"} retracts
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}
            %p
              It remains to show that the relevant lifting and factorization properties hold. This we discuss in a list of lemmas below in
              %em
                %a{:href => "#Lifting"} Lifting
              and
              = succeed "." do
                %em
                  %a{:href => "#Factorization"} Factorization
          %h3#Lifting Lifting
          %p
            We work with the “global” latching objects from
            = succeed "." do
              %a{:href => "#GlobalLatchingObjects"} above
          .num_remark
            %h6#remark_4 Remark
            %p
              A morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f : X \to Y
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi S
                    %mo ,
                    %mi 𝒞
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi gReedy
                  %annotation{:encoding => "application/x-tex"} [S, \mathcal{C}]_{gReedy}
              is a Reedy cofibration precisely if for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              the global relative latching morphism, def.
              %a.maruku-ref{:href => "#GlobalLatching"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi n
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %msub
                          %mi Latch
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi Latch
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi Y
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    X_n \coprod_{Latch_n(X)} Latch_n(Y) \to Y_n
            %p
              is a cofibration in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi G
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi 𝒞
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mrow
                          %mi proj
                          %mo{:stretchy => "false"} /
                          %mi inj
                    %annotation{:encoding => "application/x-tex"} [G_n(S), \mathcal{C}]_{proj/inj}
          .proof
            %h6#proof_9 Proof
            %p
              The pushout in the presheaf category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi G
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi 𝒞
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [G_n(S), \mathcal{C}]
              is computed objectwise, so that the component of the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo ∈
                    %mi S
                  %annotation{:encoding => "application/x-tex"} s \in S
              is the relative latching morphism at
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                    %annotation{:encoding => "application/x-tex"} s
              = succeed "." do
                %a.maruku-ref{:href => "#GlobalLatchingContainsLocalLatchings"}
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G_n(S)
              is equivalent to the disjoint union
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi r
                        %mo{:stretchy => "false"} ]
                        %mo ∈
                        %msub
                          %mi π
                          %mn 0
                        %msub
                          %mi G
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi S
                        %mo{:stretchy => "false"} )
                    %mi B
                    %msub
                      %mi Aut
                      %mi S
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \coprod_{[r] \in \pi_0 G_n(S)} B Aut_S(s)
              of the automorphism groupoids of one representative in each isomorphism class. A morphism in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi G
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi 𝒞
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo{:stretchy => "false"} /
                        %mi inj
                  %annotation{:encoding => "application/x-tex"} [G_n(S), \mathcal{C}]_{proj/inj}
              is a cofibration precisely if its restriction to all of the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi B
                    %msub
                      %mi Aut
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi 𝒞
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo{:stretchy => "false"} /
                        %mi inj
                  %annotation{:encoding => "application/x-tex"} [B Aut_{\mathcal{C}}(s), \mathcal{C}]_{proj/inj}
              is.
          #LiftingLemma.num_lemma
            %h6#lemma_5 Lemma
            %p
              In the generalized Reedy structure, def.
              = succeed "," do
                %a.maruku-ref{:href => "#ReedyModelStructure"}
            %ul
              %li
                %p
                  Acyclic Reedy cofibrations
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  such that for all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
                  the morphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Latch
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Latch_n(f)
                  is an objectwise acyclic cofibration have the
                  %a.existingWikiWord{:href => "/nlab/show/left+lifting+property"} left lifting property
                  against fibrations;
              %li
                %p
                  Reedy cofibration have the left lifting property against acyclic Reedy fibrations
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                      %annotation{:encoding => "application/x-tex"} g
                  with the special property that all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Latch
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi g
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Latch_n(g)
                  are objectwise acyclic fibrations.
          %p
            This is (
            %a{:href => "#BergerMoerdijk"}> Ber-Moer, lemma 5.2, lemma 5.4
            ).
          .proof
            %h6#proof_10 Proof
            %p
              We show the first clause. The second is dual. So let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f : X \to Y
              be an acyclic cofibration with the above extra property, and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %mi Y
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} g : Y \to X
              be a fibration. We will exhibit a lift in any commuting diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo →
                              %mrow
                          %mtd
                            %mi Y
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                        %mtr
                          %mtd
                            %mi B
                          %mtd
                            %mover
                              %mo →
                              %mrow
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A &amp;\stackrel{}{\to}&amp; Y
                    \\\
                    \\downarrow^{\mathrlap{}} &amp;&amp; \downarrow^{\mathrlap{}}
                    \\\
                    B &amp;\stackrel{}{\to}&amp; X
                    }
            %p
              by stepwise constructing lifts in the skeletal filtration, lemma
              = succeed "." do
                %a.maruku-ref{:href => "#coSkeletonTower"}
            %p
              At
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} n = 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} L_0(X) = \emptyset
              for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 0
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %msub
                          %mi L
                          %mn 0
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi L
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi B
                      %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    A_0 \coprod_{L_0(A)} L_0(B) \to B_0
            %p
              is a cofibration in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi G
                      %mn 0
                    %mo ,
                    %mi 𝒞
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo{:stretchy => "false"} /
                        %mi inj
                  %annotation{:encoding => "application/x-tex"} [G_0, \mathcal{C}]_{proj/inj}
              by assumption, means that in fact
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn 0
                    %mo :
                    %msub
                      %mi A
                      %mn 0
                    %mo →
                    %msub
                      %mi B
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} f_0 : A_0 \to B_0
              is an acyclic cofibration here. Similarly
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Y
                      %mn 0
                    %mo →
                    %msub
                      %mi X
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} Y_0 \to X_0
              is a fibration there. But
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi S
                      %mrow
                        %mo ≤
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} G_0(S) = S_{\leq 0}
              and so the restriction of the lifting problem along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi t
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} t_0
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi A
                              %mn 0
                          %mtd
                            %mover
                              %mo →
                              %mrow
                          %mtd
                            %msub
                              %mi Y
                              %mn 0
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                        %mtr
                          %mtd
                            %msub
                              %mi B
                              %mn 0
                          %mtd
                            %mover
                              %mo →
                              %mrow
                          %mtd
                            %msub
                              %mi X
                              %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A_0 &amp;\stackrel{}{\to}&amp; Y_0
                    \\\
                    \\downarrow^{\mathrlap{}} &amp;&amp; \downarrow^{\mathrlap{}}
                    \\\
                    B_0 &amp;\stackrel{}{\to}&amp; X_0
                    }
            %p
              is a lifting problem in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi G
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi 𝒞
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo{:stretchy => "false"} /
                        %mi inj
                  %annotation{:encoding => "application/x-tex"} [G_0(S), \mathcal{C}]_{proj/inj}
              of an acyclic cofibration against a fibration, and hence has a filler
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi γ
                      %mn 0
                    %mo :
                    %msub
                      %mi B
                      %mn 0
                    %mo →
                    %msub
                      %mi Y
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \gamma_0 : B_0 \to Y_0
              there.
            %p
              Now assume that a filler
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi γ
                      %mrow
                        %mo ≤
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo −
                        %mn 1
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \gamma_{\leq (n-1)}
              in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi A
                              %mrow
                                %mo ≤
                                %mo{:stretchy => "false"} (
                                %mi n
                                %mo −
                                %mn 1
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                          %mtd
                            %msub
                              %mi Y
                              %mrow
                                %mo ≤
                                %mo{:stretchy => "false"} (
                                %mi n
                                %mo −
                                %mn 1
                                %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                        %mtr
                          %mtd
                            %msub
                              %mi B
                              %mrow
                                %mo ≤
                                %mo{:stretchy => "false"} (
                                %mi n
                                %mo −
                                %mn 1
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                          %mtd
                            %msub
                              %mi X
                              %mrow
                                %mo ≤
                                %mo{:stretchy => "false"} (
                                %mi n
                                %mo −
                                %mn 1
                                %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A_{\leq (n-1)} &amp;\stackrel{}{\to}&amp; Y_{\leq (n-1)}
                    \\\
                    \\downarrow^{\mathrlap{}} &amp;&amp; \downarrow^{\mathrlap{}}
                    \\\
                    B_{\leq (n-1)} &amp;\stackrel{}{\to}&amp; X_{\leq (n-1)}
                    }
            %p
              has been found. By lemma
              %a.maruku-ref{:href => "#LatchingIsSkeleton"}
              this induces maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Latch
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi Latch
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Latch_n(B) \to Latch_n (Y)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Match
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi Match
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Match_n(B) \to Match_n(Y)
              from which we can build the commuting diagram
            #eq:MainLiftingDiagram.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi A
                              %mi n
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                              %mrow
                                %msub
                                  %mi Latch
                                  %mi n
                                %mi A
                            %msub
                              %mi Latch
                              %mi n
                            %mi B
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi Y
                              %mi n
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi v
                                    %mi n
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi w
                                    %mi n
                        %mtr
                          %mtd
                            %msub
                              %mi B
                              %mi n
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi X
                              %mi n
                            %msub
                              %mo ×
                              %mrow
                                %msub
                                  %mi Match
                                  %mi n
                                %mi X
                            %msub
                              %mi Match
                              %mi n
                            %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A_n \coprod_{Latch_n A} Latch_n B
                    \&amp;\to&amp;
                    Y_n
                    \\\
                    \\downarrow^{\mathrlap{v_n}} &amp;&amp; \downarrow^{\mathrlap{w_n}}
                    \\\
                    B_n &amp;\to&amp; X_n \times_{Match_n X} Match_n Y
                    }
            %p
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi G
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi 𝒞
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [G_n(S), \mathcal{C}]
            %p Here for instance the top horizontal morphism comes from the commutativity of the square
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi Latch
                              %mi n
                            %mi A
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi Latch
                              %mi n
                            %mi B
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi Latch
                              %mi n
                            %mi Y
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msub
                              %mi A
                              %mi n
                          %mtd
                            %mo →
                          %mtd
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi Y
                              %mi n
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Latch_n A &amp;\to&amp; Latch_n B &amp;\to&amp; Latch_n Y
                    \\\
                    \\downarrow &amp;&amp; &amp;&amp; \downarrow
                    \\\
                    A_n &amp;\to&amp; &amp;\to&amp; Y_n
                    }
            %p
              by naturality of the
              = succeed "-counit." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi sk
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                      %mo ⊣
                      %msubsup
                        %mi t
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                        %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (sk_{n-1} \dashv t_{n-1}^*)
            %p
              We observe now that finding a lift in
              %a.maruku-eqref{:href => "#eq:MainLiftingDiagram"} (1)
              will complete the induction step. To see this in more detail, notice that in the top left the lift
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi A
                              %mi n
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                              %mrow
                                %msub
                                  %mi Latch
                                  %mi n
                                %mi A
                            %msub
                              %mi Latch
                              %mi n
                            %mi B
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi Y
                              %mi n
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msub
                              %mo ↗
                              %mrow
                                %msub
                                  %mi γ
                                  %mi n
                          %mtd
                        %mtr
                          %mtd
                            %msub
                              %mi B
                              %mi n
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A_n \coprod_{Latch_n A} Latch_n B
                    \&amp;\to&amp;
                    Y_n
                    \\\
                    \\downarrow &amp;\nearrow_{\gamma_n}&amp;
                    \\\
                    B_n
                    }
            %p is
            %ul
              %li
                %p a lift in
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %msub
                                  %mi A
                                  %mi n
                              %mtd
                                %mo →
                              %mtd
                                %msub
                                  %mi Y
                                  %mi n
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} ↓
                              %mtd
                                %msub
                                  %mo ↗
                                  %mpadded{:width => "0"}
                                    %mrow
                                      %msub
                                        %mi γ
                                        %mi n
                            %mtr
                              %mtd
