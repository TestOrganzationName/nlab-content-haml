                    i_s : S^+(s) \hookrightarrow t_{n-1}/ s
            %p
              into the
              %a.existingWikiWord{:href => "/nlab/show/comma+category"} comma category
              is a
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/cofinal+functor"} cofinal functor
            %ul
              %li
                %p
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mo →
                        %mi s
