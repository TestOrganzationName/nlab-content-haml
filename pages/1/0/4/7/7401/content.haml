                  at
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi s
                        %annotation{:encoding => "application/x-tex"} s
          %p
            See
            %em
              %a.existingWikiWord{:href => "/nlab/show/Joyal-Tierney+calculus"} Joyal-Tierney calculus
            for more on these kinds of objects and morphisms.
          .num_remark
            %h6#remark Remark
            %p
              In the above situation, the
              %a.existingWikiWord{:href => "/nlab/show/automorphism"} automorphism
              group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Aut
                      %mi S
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Aut_S(s)
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                  %annotation{:encoding => "application/x-tex"} s
              canonically acts on all objects that appear, and all morphisms that appear respect this action.
            %p
              Equivalently this means that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                  %annotation{:encoding => "application/x-tex"} s
              the above objects and morphisms take place in the presheaf category
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi B
                      %mi Aut
                      %mo{:stretchy => "false"} (
                      %mi s
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi 𝒞
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [B Aut(s), \mathcal{C}]
          .proof
            %h6#proof Proof
            %p
              Since limits and colimits in
              %a.existingWikiWord{:href => "/nlab/show/presheaf+categories"} presheaf categories
              are computed objectwise.
          %p
            Choose now once and for all on all on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mrow
                      %mi s
                      %mo ∈
                      %mi S
                  %mi B
                  %mi Aut
                  %mo{:stretchy => "false"} (
                  %mi s
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi 𝒞
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [\coprod_{s \in S} B Aut(s), \mathcal{C}]
            either the projective or the injective
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+functors"} model structure on functors
            (if they exist). We will use the subscript “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %msub
                    %mrow
                    %mrow
                      %mi proj
                      %mo{:stretchy => "false"} /
                      %mi inj
                %annotation{:encoding => "application/x-tex"} {}_{proj/inj}
            ”, as in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mi s
                        %mo ∈
                        %mi S
                    %mi B
                    %mi Aut
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi 𝒞
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo{:stretchy => "false"} /
                        %mi inj
                  %annotation{:encoding => "application/x-tex"} [\coprod_{s \in S} B Aut(s), \mathcal{C}]_{proj/inj}
          #ReedyModelStructure.num_defn
            %h6#definition_3 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              be a (Berger-Moerdijk)-
              %a.existingWikiWord{:href => "/nlab/show/generalized+Reedy+category"}> generalized Reedy category
              \.
            %p
              And
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              such that the
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+functors"} model structure on functors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mi s
                        %mo ∈
                        %mi S
                    %mi B
                    %mi Aut
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi 𝒞
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo{:stretchy => "false"} /
                        %mi inj
                  %annotation{:encoding => "application/x-tex"} [\coprod_{s \in S} B Aut(s), \mathcal{C}]_{proj/inj}
              exists (sufficient for the projective structure is that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is a
              %a.existingWikiWord{:href => "/nlab/show/cofibrantly+generated+model+category"} cofibrantly generated model category
              and sufficient for the injective structure is that it is a
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/combinatorial+model+category"} combinatorial model category
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi S
                    %mo ,
                    %mi 𝒞
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [S, \mathcal{C}]
              for the
              %a.existingWikiWord{:href => "/nlab/show/category+of+presheaves"} category of presheaves
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi op
                  %annotation{:encoding => "application/x-tex"} S^{op}
              with values in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %p
              Call a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f : X \to Y
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi S
                    %mo ,
                    %mi 𝒞
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [S, \mathcal{C}]
            %ul
              %li
                %p
                  a
                  %strong Reedy cofibration
                  if for each
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi s
                        %mo ∈
                        %mi S
                      %annotation{:encoding => "application/x-tex"} s \in S
                  the relative latching map
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi X
                          %mi s
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                          %mrow
                            %msub
                              %mi L
                              %mi s
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                        %msub
                          %mi L
                          %mi s
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo{:stretchy => "false"} )
                        %mo →
                        %msub
                          %mi Y
                          %mi s
                      %annotation{:encoding => "application/x-tex"}
                        X_s \coprod_{L_s(X)} L_s(Y) \to Y_s
                %p
                  is a cofibration in
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi B
                          %mi Aut
                          %mo{:stretchy => "false"} (
                          %mi s
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mi 𝒞
                          %msub
                            %mo{:stretchy => "false"} ]
                            %mrow
                              %mi proj
                              %mo{:stretchy => "false"} /
                              %mi inj
                        %annotation{:encoding => "application/x-tex"} [B Aut(s), \mathcal{C}]_{proj/inj}
              %li
                %p
                  a
                  %strong Reedy fibration
                  if for each
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi s
                        %mo ∈
                        %mi S
                      %annotation{:encoding => "application/x-tex"} s \in S
                  the relative matching map
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi X
                          %mi s
                        %mo →
                        %msub
                          %mi M
                          %mi s
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                          %mrow
                            %msub
                              %mi M
                              %mi s
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo{:stretchy => "false"} )
                        %msub
                          %mi Y
                          %mi s
                      %annotation{:encoding => "application/x-tex"}
                        X_s \to M_s(X) \prod_{M_s(Y)} Y_s
                %p
                  is a fibration in
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi B
                          %mi Aut
                          %mo{:stretchy => "false"} (
                          %mi s
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mi 𝒞
                          %msub
                            %mo{:stretchy => "false"} ]
                            %mrow
                              %mi proj
                              %mo{:stretchy => "false"} /
                              %mi inj
                        %annotation{:encoding => "application/x-tex"} [B Aut(s), \mathcal{C}]_{proj/inj}
              %li
                %p
                  a
                  %strong Reedy weak equivalence
                  if for each
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi s
                        %mo ∈
                        %mi S
                      %annotation{:encoding => "application/x-tex"} s \in S
                  the morphism
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi f
                          %mi s
                        %mo :
                        %msub
                          %mi X
                          %mi s
                        %mo →
                        %msub
                          %mi Y
                          %mi s
                      %annotation{:encoding => "application/x-tex"}
                        f_s : X_s \to Y_s
                %p
                  is a weak equivalence in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
          %h3#GlobalLatchingObjects Degreewise latching and matching objects
          %p
            We discuss here an alternative way of speaking about the latching and matching objects, one where all indices at a given
            %em degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ∈
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            are collected.
          %p
            Recall from def.
            %a.maruku-ref{:href => "#FirstNotation"}
            that for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mo ∈
                  %mi S
                %annotation{:encoding => "application/x-tex"} s \in S
            we write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mo +
                  %mo{:stretchy => "false"} (
                  %mi s
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} S^+(s)
            for the category of non-invertible degree-increasing morphisms into
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                  %annotation{:encoding => "application/x-tex"} s
          #SecondNotation.num_defn
            %h6#definition_4 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              write
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mo +
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                        %mo =
                        %msub
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                          %mfrac{:linethickness => "0"}
                            %mrow
                              %mi s
                              %mo ∈
                              %mi S
                            %mrow
                              %mi d
                              %mo{:stretchy => "false"} (
                              %mi s
                              %mo{:stretchy => "false"} )
                              %mo =
                              %mi n
                        %msup
                          %mi S
                          %mo +
                        %mo{:stretchy => "false"} (
                        %mi s
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} S^+(n) = \coprod_{s \in S \atop d(s) = n} S^+(s)
                  ;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi d
                          %mi n
                        %mo :
                        %msup
                          %mi S
                          %mo +
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi S
                      %annotation{:encoding => "application/x-tex"} d_ n : S^+((n)) \to S
                  for the restriction of the
                  %a.existingWikiWord{:href => "/nlab/show/domain+opfibration"} domain opfibration
                  to objects that are non-invertible morphisms in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mo +
                      %annotation{:encoding => "application/x-tex"} S^+
                  with codomain in degree
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
