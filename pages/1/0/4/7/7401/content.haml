              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} v_n(s)
              finally sits in the diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi Latch
                              %mi n
                            %mo{:stretchy => "false"} (
                            %mi A
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi s
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi A
                              %mi s
                          %mtd
