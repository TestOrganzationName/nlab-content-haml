          #coSkeletonTower.num_lemma
            %h6#lemma_2 Lemma
            %p The tower of inclusions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mn 0
                    %mo ↪
                    %msub
                      %mi S
                      %mrow
                        %mo ≤
                        %mn 1
                    %mo ↪
                    %mi ⋯
                    %mo ↪
                    %msub
                      %mi S
                      %mrow
                        %mo ≤
                        %mi n
                        %mo −
                        %mn 1
                    %mover
                      %mo ↪
                      %mrow
                        %msub
                          %mi q
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                    %msub
                      %mi S
                      %mrow
                        %mo ≤
                        %mi n
                    %mo ↪
                    %mi ⋯
                  %annotation{:encoding => "application/x-tex"}
                    S_{0} \hookrightarrow S_{\leq 1} \hookrightarrow \cdots \hookrightarrow S_{\leq n-1}
                    \\stackrel{q_{n-1}}{\hookrightarrow} S_{\leq n} \hookrightarrow \cdots
            %p
              induces towers of
              %a.existingWikiWord{:href => "/nlab/show/natural+transformations"} natural transformations
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ∅
                    %mo →
                    %msub
                      %mi sk
                      %mn 0
                    %mi X
                    %mo →
                    %msub
                      %mi sk
                      %mn 1
                    %mi X
                    %mo →
                    %msub
                      %mi sk
                      %mn 2
                    %mi X
                    %mo →
                    %mi ⋯
                    %mo →
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\emptyset \to sk_0 X \to sk_1 X \to sk_2 X \to \cdots \to X
                    \\,,
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi ⋯
                    %mo →
                    %msub
                      %mi cosk
                      %mn 2
                    %mi X
                    %mo →
                    %msub
                      %mi cosk
                      %mn 1
                    %mi X
                    %mo →
                    %msub
                      %mi cosk
                      %mn 0
                    %mi X
                    %mo →
                    %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    X \to \cdots \to cosk_2 X \to cosk_1 X \to cosk_0 X \to *
                    \\,,
            %p
              that exhibit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              as the
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              of its skeleton tower and as the
              %a.existingWikiWord{:href => "/nlab/show/limit"} limit
              of its coskeleton tower.
          %p
            This is (
            %a{:href => "#BergerMoerdijk"}> Ber-Moer, lemma 6.3
            ).
          .proof
            %h6#proof_5 Proof
            %p
              The morphisms in the tower come from the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} adjunction units and counits
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi sk
                      %mi n
                    %mi X
                    %mo →
                    %msub
                      %mi sk
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    sk_n X \to sk_{n+1} X
            %p is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi t
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo !
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi q
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo !
                    %msubsup
                      %mi q
                      %mi n
                      %mo *
                    %msubsup
                      %mi t
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                      %mo *
                    %mi X
                    %mo →
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi t
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo !
                    %msubsup
                      %mi t
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                      %mo *
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (t_{n+1})_! (q_n)_! q_n^* t_{n+1}^*X \to  (t_{n+1})_! t_{n+1}^* X
                    \\,.
            %p
              Therefore a
              %a.existingWikiWord{:href => "/nlab/show/cocone"} cocone
              under this morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi sk
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mi X
                          %mtd
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi sk
                              %mi n
                            %mi X
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                          %mtd
                            %mo ↙
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    sk_{n-1} X &amp;&amp;\to&amp; sk_n X
                    \\\
                    \&amp; \searrow &amp;&amp; \swarrow
                    \\\
                    \&amp;&amp; Y
                    }
            %p is equivalently a diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi q
                              %mi n
                            %msub
                              %mo{:stretchy => "false"} )
                              %mo !
                            %msubsup
                              %mi q
                              %mi n
                              %mo *
                            %msub
                              %mi t
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mi X
                          %mtd
                          %mtd
                            %mo →
                          %mtd
                            %msubsup
                              %mi t
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                              %mo *
                            %mi X
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                          %mtd
                            %mo ↙
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msubsup
                              %mi t
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                              %mo *
                            %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    (q_{n})_! q_{n}^* t_{n+1} X &amp;&amp;\to&amp; t_{n+1}^* X
                    \\\
                    \&amp; \searrow &amp;&amp; \swarrow
                    \\\
                    \&amp;&amp; t_{n+1}^* Y
                    }
                    \\,,
            %p
              which in turn is equivalently just a morphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi t
                        %mi n
                        %mo *
                      %mi X
                      %mo →
                      %msubsup
                        %mi t
                        %mi n
                        %mo *
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} t_n^* X \to t_n^* Y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              equipped for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              with a morphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi t
                        %mi n
                        %mo *
                      %mi X
                      %mo →
                      %msubsup
                        %mi t
                        %mi n
                        %mo *
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} t_n^* X \to t_n^* Y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              itself is the
              %a.existingWikiWord{:href => "/nlab/show/initial+object"} inital
              such object.
          #IdempotenceOfCoSkeleta.num_lemma
            %h6#lemma_3 Lemma
            %p
              For every
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %mi S
                    %mo ,
                    %mi 𝒞
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} X \in [S, \mathcal{C}]
              and for all pairs
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ,
                    %mi l
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} k,l \in \mathbb{N}
              with
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ≤
                      %mi l
                    %annotation{:encoding => "application/x-tex"} k \leq l
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphisms"} natural isomorphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi sk
                      %mi k
                    %msub
                      %mi sk
                      %mi l
                    %mo ≃
                    %msub
                      %mi sk
                      %mi l
                    %msub
                      %mi sk
                      %mi k
                    %mo ≃
                    %msub
                      %mi sk
                      %mi k
                  %annotation{:encoding => "application/x-tex"}
                    sk_k sk_l \simeq sk_l sk_k \simeq sk_k
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi cosk
                      %mi k
                    %msub
                      %mi cosk
                      %mi l
                    %mo ≃
                    %msub
                      %mi cosk
                      %mi l
                    %msub
                      %mi cosk
                      %mi k
                    %mo ≃
                    %msub
                      %mi cosk
                      %mi k
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    cosk_k cosk_l \simeq cosk_l cosk_k \simeq cosk_k
                    \\,.
          .proof
            %h6#proof_6 Proof
            %p
              With the above notation we have
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi t
                        %mi k
                      %mo =
                      %msub
                        %mi t
                        %mi l
                      %mo ∘
                      %msub
                        %mi q
                        %mi k
                    %annotation{:encoding => "application/x-tex"} t_k = t_l \circ q_k
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi sk
                      %mi k
                    %msub
                      %mi sk
                      %mi l
                    %mi X
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi t
                      %mi l
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo !
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi q
                      %mi k
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo !
                    %msubsup
                      %mi q
                      %mi k
                      %mo *
                    %msubsup
                      %mi t
                      %mi l
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi t
                      %mi l
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo !
                    %msubsup
                      %mi t
                      %mi l
                      %mo *
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    sk_k sk_l X
                    \\simeq
                    (t_l)_! (q_k)_! q_k^* t_l^* (t_l)_! t_l^* X
                    \\,.
            %p
              Since the left adjoints here are
              %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+functors"} full and faithful functors
              we have
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi t
                      %mi l
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi t
                      %mi l
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo !
                    %mo ≃
                    %mi id
                  %annotation{:encoding => "application/x-tex"} t_l^* (t_l)_! \simeq id
              and hence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi t
                      %mi l
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo !
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi q
                      %mi k
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo !
                    %msubsup
                      %mi q
                      %mi k
                      %mo *
                    %msubsup
                      %mi t
                      %mi l
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi t
                      %mi l
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo !
                    %msubsup
                      %mi t
                      %mi l
                      %mo *
                    %mi X
                    %mo ≃
                    %msub
                      %mi sk
                      %mi k
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots \simeq
                    (t_l)_! (q_k)_! q_k^* t_l^* (t_l)_! t_l^* X
                    \\simeq
                    sk_k X
                    \\,.
            %p Similarly for all the other cases.
          %p The following is a useful tool for inductively creating objects by adding higher degree components.
          #SkeletalExtension.num_lemma
            %h6#lemma_4 Lemma
            %p Given
            %ul
              %li
                %p
                  an object
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi X
                            %mrow
                              %mo ≤
                              %mo{:stretchy => "false"} (
                              %mi n
                              %mo −
                              %mn 1
                              %mo{:stretchy => "false"} )
                          %mo ∈
                          %mo{:stretchy => "false"} [
                          %msub
                            %mi S
                            %mrow
                              %mo ≤
                              %mo{:stretchy => "false"} (
                              %mi n
                              %mo −
                              %mn 1
                              %mo{:stretchy => "false"} )
                          %mo ,
                          %mi 𝒞
                          %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"} X_{\leq (n-1)} \in [S_{\leq (n-1)}, \mathcal{C}]
              %li
                %p
                  and an object
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi X
                            %mi n
                          %mo ∈
                          %mo{:stretchy => "false"} [
                          %msub
                            %mi G
                            %mi n
                          %mo{:stretchy => "false"} (
                          %mi S
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mi 𝒞
                          %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"} X_n \in [G_n(S), \mathcal{C}]
            %p
              the choices of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mrow
                        %mo ≤
                        %mi n
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi S
                      %mrow
                        %mo ≤
