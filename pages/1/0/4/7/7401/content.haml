          #ExtraPropertyOfAcyclicCofibrations.num_lemma
            %h6#lemma_7 Lemma
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
