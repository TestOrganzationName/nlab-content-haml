                        %mi n
                        %mo −
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo ,
                    %mi 𝒞
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} X_{\leq n} \in [S_{\leq (n-1)}, \mathcal{C}]
              such that
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi X
                          %mrow
                            %mo ≤
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo −
                            %mn 1
                            %mo{:stretchy => "false"} )
                        %mo =
                        %msubsup
                          %mi t
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                          %mo *
                        %msub
                          %mi X
                          %mrow
                            %mo ≤
                            %mi n
                      %annotation{:encoding => "application/x-tex"} X_{\leq (n-1)} = t^*_{n-1} X_{\leq n}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msub
                          %mi X
                          %mi n
                        %mo =
                        %msubsup
                          %mi j
                          %mi n
                          %mo *
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X_n = j_n^* X
                  ;
            %p are in bijection with choices of morphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Latch
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mrow
                        %mo ≤
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo −
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi X
                      %mi n
                    %mo →
                    %msub
                      %mi Match
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mrow
