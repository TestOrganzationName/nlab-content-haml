                                %mo ≃
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ≃
                          %mtd
                            %msub
                              %mo ↗
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi v
                                    %mi n
                                  %mo{:stretchy => "false"} (
                                  %mi s
                                  %mo{:stretchy => "false"} )
                        %mtr
