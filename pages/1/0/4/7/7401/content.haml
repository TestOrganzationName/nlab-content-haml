                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
          %p
            This is (
            %a{:href => "#BergerMoerdijk"}> Ber-Moer, lemma 5.4
            ).
          .proof
            %h6#proof_13 Proof
            %p
              (Essentially the dual proof to that above. Except for one slight difference in the last part. Here – and only here – do we need the last clause in the definition of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/generalized+Reedy+category"} generalized Reedy category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mo −
                  %annotation{:encoding => "application/x-tex"} S_-
              as epimorphisms.)
          %p We can finally conclude:
          .num_prop
            %h6#proposition_3 Proposition
            %p
              In the generalized Reedy model structure, def.
              = succeed "," do
                %a.maruku-ref{:href => "#ReedyModelStructure"}
            %ul
              %li
                %p
                  acyclic cofibrations have the
                  %a.existingWikiWord{:href => "/nlab/show/left+lifting+property"} left lifting property
                  against fibrations;
              %li
                %p
                  cofibrations have the
                  %a.existingWikiWord{:href => "/nlab/show/left+lifting+property"} left lifting property
                  against acyclic fibrations.
          .proof
            %h6#proof_14 Proof
            %p
              By lemma
              %a.maruku-ref{:href => "#ExtraPropertyOfAcyclicCofibrations"}
              every acyclic Reedy cofibration induces a weak equivalence under
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Latch
                        %mi n
                    %annotation{:encoding => "application/x-tex"} Latch_n
              %a.maruku-ref{:href => "#LiftingLemma"}
              this implies the left lifting property against Reedy fibrations. Dually for the second statement.
          %h3#Factorization Factorization
          %p
            We demonstrate the factorization axiom in the Reedy model structure, def.
            = succeed "." do
              %a.maruku-ref{:href => "#ReedyModelStructure"}
          #AcyclicCoFibrationsByLatchingMatching.num_lemma
            %h6#lemma_9 Lemma
            %p
              A morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f : X \to Y
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi S
                    %mo ,
                    %mi 𝒞
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [S, \mathcal{C}]
              is both a cofibration and a weak equivalence according to def.
              %a.maruku-ref{:href => "#ReedyModelStructure"}
              precisely if the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed ")" do
                %a.maruku-ref{:href => "#GlobalLatching"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi n
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %msub
                          %mi Latch
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi Latch
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi Y
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    X_n \coprod_{Latch_n(X)} Latch_n(Y) \to Y_n
            %p
              is an acyclic cofibration in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi G
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi 𝒞
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo{:stretchy => "false"} /
                        %mi inj
                  %annotation{:encoding => "application/x-tex"} [G_n(S), \mathcal{C}]_{proj/inj}
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            %p
              Dually, a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f : X \to Y
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi S
                    %mo ,
                    %mi 𝒞
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [S, \mathcal{C}]
              is both a fibration and a weak equivalence according to def.
              %a.maruku-ref{:href => "#ReedyModelStructure"}
              precisely if the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed ")" do
                %a.maruku-ref{:href => "#GlobalLatching"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi n
                    %mo →
                    %msub
                      %mi Y
                      %mi n
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %msub
                          %mi Match
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi Match
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    X_n \to Y_n \prod_{Match_n(X)} Match_n(Y)
            %p
              is an acyclic fibration in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi G
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi 𝒞
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo{:stretchy => "false"} /
                        %mi inj
                  %annotation{:encoding => "application/x-tex"} [G_n(S), \mathcal{C}]_{proj/inj}
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
          %p
            This is (
            %a{:href => "#BergerMoerdijk"}> Ber-Moer, prop. 5.6
            ).
          .proof
            %h6#proof_15 Proof
            %p
              By definition, the morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi n
                    %mo :
                    %msub
                      %mi X
                      %mi n
                    %mo →
                    %msub
                      %mi Y
                      %mi n
                  %annotation{:encoding => "application/x-tex"} f_n : X_n \to Y_n
              factor as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi n
                    %mo :
                    %msub
                      %mi X
                      %mi n
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi u
                          %mi n
                    %msub
                      %mi X
                      %mi n
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %msub
                          %mi Latch
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi Latch
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi v
                          %mi n
                    %msub
                      %mi Y
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f_n :
                    X_n
                    \\stackrel{u_n}{\to}
                    X_n
                    \\coprod_{Latch_n(X)} Latch_n (Y)
                    \\stackrel{v_n}{\to}
                    Y_n
                    \\,.
            %p
              If now
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is an acyclic Reedy cofibration, then by lemma
              %a.maruku-ref{:href => "#ExtraPropertyOfAcyclicCofibrations"}
              the morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Latch
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi Latch
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Latch_n(X) \to Latch_n(Y)
              is over each object an acyclic cofibration in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              and then so is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi u
                      %mi n
                  %annotation{:encoding => "application/x-tex"} u_n
              above, being the pushout of this morphism. It follows by
              %a.existingWikiWord{:href => "/nlab/show/two-out-of-three"} two-out-of-three
              that also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mi n
                  %annotation{:encoding => "application/x-tex"} v_n
              is a weak equivalence for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            %p
              Conversely, assume that all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mi n
                  %annotation{:encoding => "application/x-tex"} v_n
              here are weak equivalences. We show by induction on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              that then also the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi u
                      %mi n
                  %annotation{:encoding => "application/x-tex"} u_n
              are weak equivalences, and hence that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is a Reedy weak equivalence.
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} n = 0
              we have
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi u
                        %mn 0
                      %mo =
                      %mi id
                    %annotation{:encoding => "application/x-tex"} u_0 = id
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi u
                      %mi k
                  %annotation{:encoding => "application/x-tex"} u_k
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo &lt;
                    %mi n
                  %annotation{:encoding => "application/x-tex"} k \lt n
              are weak equivalences. Then the assumptions of lemma
              %a.maruku-ref{:href => "#ExtraPropertyOfAcyclicCofibrations"}
              are again satisfied, and it follows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Latch
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msub
                      %mi Latch
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi Latch
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Latch_n(f) : Latch_n(X) \to Latch_n(Y)
              is over each object an acyclic cofibration. Accordingly, so is
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi u
                        %mi n
                    %annotation{:encoding => "application/x-tex"} u_n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi u
                      %mi n
                  %annotation{:encoding => "application/x-tex"} u_n
              are, in particular, weak equivalences.
            %p The argument for fibrations is dual to this.
          .num_prop
            %h6#proposition_4 Proposition
            %p
              Every morphism in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi S
                    %mo ,
                    %mi 𝒞
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [S, \mathcal{C}]
              factors as an acyclic Reedy cofibration (according to def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ReedyModelStructure"}
          %p
            This is (
            %a{:href => "#BergerMoerdijk"}> Ber-Moer, page 18
            ).
          .proof
            %h6#proof_16 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f : X \to Y
              be any morphism in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi S
                      %mo ,
                      %mi 𝒞
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [S, \mathcal{C}]
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi t
                        %mi n
                        %mo *
                      %mo :
                      %mo{:stretchy => "false"} [
                      %mi S
                      %mo ,
                      %mi 𝒞
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi S
                        %mrow
                          %mo ≤
                          %mi n
                      %mo ,
                      %mi 𝒞
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} t_n^* : [S, \mathcal{C}] \to [S_{\leq n}, \mathcal{C}]
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} n = 0
              we have
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mrow
                        %mo ≤
                        %mn 0
                    %mo =
                    %msub
                      %mi G
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S_{\leq 0} = G_0(S)
              and we factor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} f_0
              in the model structure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi G
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi 𝒞
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo{:stretchy => "false"} /
                        %mi inj
                  %annotation{:encoding => "application/x-tex"} [G_0(S), \mathcal{C}]_{proj/inj}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn 0
                    %mo :
                    %msub
                      %mi X
                      %mn 0
                    %mover
                      %mo →
                      %mo ≃
                    %msub
                      %mi A
                      %mn 0
                    %mo →
                    %msub
                      %mi Y
                      %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f_0 : X_0 \stackrel{\simeq}{\to} A_0 \to Y_0
                    \\,.
            %p
              Now assume for some
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              that a factorization of
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mrow
                        %mo ≤
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo −
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo :
                    %msub
                      %mi X
                      %mrow
                        %mo ≤
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo −
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≃
                    %msub
                      %mi A
                      %mrow
                        %mo ≤
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo −
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi Y
                      %mrow
                        %mo ≤
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo −
                        %mn 1
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    f_{\leq (n-1)}
                    \:
                    X_{\leq (n-1)}
                    \\stackrel{\simeq}{\to}
