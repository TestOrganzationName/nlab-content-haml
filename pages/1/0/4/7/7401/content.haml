                              %mi s
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Latch_n(A)_s
                    \&amp;\to&amp;
                    A_s &amp;\underoverset{\simeq}{f_s}{\to}&amp; B_s
                    \\\
