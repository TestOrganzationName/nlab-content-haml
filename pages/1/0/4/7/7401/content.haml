                      %mi dom
                      %mi n
                    %msub
                      %mi i
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi k
                  %annotation{:encoding => "application/x-tex"} (dom_n i_n)_k
              is a
              %a.existingWikiWord{:href => "/nlab/show/faithful+functor"} faithful functor
              between groupoids,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
