                    \\downarrow^{\mathrlap{\simeq}}  &amp; \nearrow_{\mathrlap{v_n(s)}}
                    \\\
                    Latch_n(B)_s &amp;\to&amp; (A_s \coprod_{Latch_n(A)_s} Latch_n(B)_s)
                    }
            %p
              and so is a weak equivalence by
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/two-out-of-three"} two-out-of-three
          #LatchingIntertwiner.num_lemma
            %h6#lemma_6 Lemma
            %p
              Suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo :
                    %mi R
                    %mo →
                    %mi S
                  %annotation{:encoding => "application/x-tex"} \phi : R \to S
              is a morphism of
              %a.existingWikiWord{:href => "/nlab/show/generalized+Reedy+categories"} generalized Reedy categories
              such that the induced square (see prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#DiagramOfRestrictions"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi R
                              %mo +
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} (
                            %mi k
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msubsup
                                  %mi cod
                                  %mi k
                                  %mi R
                          %mtd
                            %msub
                              %mi G
                              %mi k
                            %mo{:stretchy => "false"} (
                            %mi R
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msubsup
                                    %mi ϕ
                                    %mi k
                                    %mo +
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi ϕ
                                    %mi k
                        %mtr
                          %mtd
                            %msup
                              %mi S
                              %mo +
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} (
                            %mi k
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msubsup
                                  %mi cod
                                  %mi k
                                  %mi S
                          %mtd
                            %msub
                              %mi G
                              %mi k
                            %mo{:stretchy => "false"} (
                            %mi S
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    R^+((k)) &amp;\stackrel{cod_k^R}{\to}&amp; G_k(R)
                    \\\
                    \\downarrow^{\mathrlap{\phi_k^+}} &amp;&amp; \downarrow^{\mathrlap{\phi_k}}
                    \\\
                    S^+((k)) &amp;\stackrel{cod_k^S}{\to}&amp; G_k(S)
                    }
            %p
              is a pullback (in the 1-category
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mo{:stretchy => "false"} [
                      %mi S
                      %mo ,
                      %mi 𝒞
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} X \in [S, \mathcal{C}]
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Latch
                      %mi k
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ϕ
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≃
                    %msubsup
                      %mi ϕ
                      %mi k
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Latch
                      %mi k
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    Latch_k(\phi^*(X)) \stackrel{\simeq}{\to} \phi_k^*(Latch_k X)
                    \\,,
            %p
              Given a Reedy category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              satisfying this condition include
            %ol
              %li
