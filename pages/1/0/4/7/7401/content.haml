                            %msub
                              %mi Latch
                              %mi n
                            %mo{:stretchy => "false"} (
                            %mi B
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi s
                          %mtd
                            %mo →
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi A
                              %mi s
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                              %mrow
                                %msub
                                  %mi Latch
                                  %mi n
                                %mo{:stretchy => "false"} (
                                %mi A
                                %msub
                                  %mo{:stretchy => "false"} )
                                  %mi s
                            %msub
                              %mi Latch
                              %mi n
                            %mo{:stretchy => "false"} (
