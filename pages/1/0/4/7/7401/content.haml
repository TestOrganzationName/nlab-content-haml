                    Y_{\leq (n-1)}
            %p has been found. This induces the commutative diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi Latch
                              %mi n
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi Latch
                              %mi n
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi Latch
                              %mi n
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msub
                              %mi X
                              %mi n
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi Y
                              %mi n
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msub
                              %mi Match
                              %mi n
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi Match
                              %mi n
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi Match
                              %mi n
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Latch_n(X) &amp;\to &amp; Latch_n(A) &amp;\to&amp; Latch_n(Y)
                    \\\
                    \\downarrow &amp;&amp; &amp;&amp; \downarrow
                    \\\
                    X_n &amp;&amp; &amp;&amp; Y_n
                    \\\
                    \\downarrow &amp;&amp; &amp;&amp; \downarrow
                    \\\
                    Match_n(X) &amp;\to &amp; Match_n(A) &amp;\to&amp; Match_n(Y)
                    }
                    \\,.
            %p This diagram in turn induces a morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi n
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %msub
                          %mi Latch
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi Latch
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi Y
                      %mi n
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %msub
                          %mi Match
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi Match
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    X_n \coprod_{Latch_n(X)} Latch_n(A)
                    \\to
                    Y_n \prod_{Match_n(Y)} Match_n(A)
            %p
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi G
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi 𝒞
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [G_n(S), \mathcal{C}]
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi n
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %msub
                          %mi Latch
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi Latch
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≃
                    %msub
                      %mi A
                      %mi n
                    %mo →
                    %msub
                      %mi Y
                      %mi n
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %msub
                          %mi Match
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi Match
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    X_n \coprod_{Latch_n(X)} Latch_n(A)
                    \\stackrel{\simeq}{\to}
                    A_n
                    \\to
                    Y_n \prod_{Match_n(Y)} Match_n(A)
            %p
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi G
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi 𝒞
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mrow
                          %mi proj
                          %mo{:stretchy => "false"} /
                          %mi inj
                    %annotation{:encoding => "application/x-tex"} [G_n(S), \mathcal{C}]_{proj/inj}
            %p
              By lemma
              = succeed "," do
                %a.maruku-ref{:href => "#SkeletalExtension"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mrow
                        %mo ≤
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo −
                        %mn 1
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A_{\leq (n-1)}
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mrow
                          %mo ≤
                          %mi n
                    %annotation{:encoding => "application/x-tex"} A_{\leq n}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi n
                  %annotation{:encoding => "application/x-tex"} f_n
              and the “middle component” says that this consistently extends the previously obtained factorization of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mrow
                          %mo ≤
                          %mi n
                    %annotation{:encoding => "application/x-tex"} f_{\leq n}
              = succeed ")" do
                %a.maruku-ref{:href => "#AcyclicCoFibrationsByLatchingMatching"}
          %h2#properties Properties
          %h3#HomotopySkeletalFiltration Homotopy skeletal filtration and coskeleton tower
          %p
            We discuss conditions on an object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            such that the skeletal/coskeletal towers discussed
            %a{:href => "#SkeletaAndCoskeleta"} above
            are “homotopy good” in that they exhibit
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            not just as the colimit/limit over the tower, but as the
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+colimit"} homotopy colimit
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+limit"} homotopy limit
          #QuillenPropertyOfCoSkeleta.num_lemma
            %h6#lemma_10 Lemma
            %p
              For all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            %ol
              %li
                %p The left Kan extension
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi t
                          %mi n
                        %msub
                          %mo{:stretchy => "false"} )
                          %mo !
                        %mo :
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi S
                          %mrow
                            %mo ≤
                            %mi n
                        %mo ,
                        %mi 𝒞
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mi gReedy
                        %mo →
                        %mo{:stretchy => "false"} [
                        %mi S
                        %mo ,
                        %mi 𝒞
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mi gReedy
                      %annotation{:encoding => "application/x-tex"}
                        (t_n)_! : [S_{\leq n}, \mathcal{C}]_{gReedy} \to [S,\mathcal{C}]_{gReedy}
                %p
                  is a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/left+Quillen+functor"} left Quillen functor
              %li
                %p The right Kan extension
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi t
                          %mi n
                        %msub
                          %mo{:stretchy => "false"} )
                          %mo *
                        %mo :
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi S
                          %mrow
                            %mo ≤
                            %mi n
                        %mo ,
                        %mi 𝒞
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mi gReedy
                        %mo →
                        %mo{:stretchy => "false"} [
                        %mi S
                        %mo ,
                        %mi 𝒞
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mi gReedy
                      %annotation{:encoding => "application/x-tex"}
                        (t_n)_* : [S_{\leq n}, \mathcal{C}]_{gReedy} \to [S,\mathcal{C}]_{gReedy}
                %p
                  is a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/right+Quillen+functor"} right Quillen functor
              %li
                %p The restriction functor
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi t
                          %mi n
                        %msup
                          %mo{:stretchy => "false"} )
                          %mo *
                        %mo :
                        %mo{:stretchy => "false"} [
                        %mi S
                        %mo ,
                        %mi 𝒞
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mi gReedy
                        %mo →
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi S
                          %mrow
                            %mo ≤
                            %mi n
                        %mo ,
                        %mi 𝒞
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mi gReedy
                      %annotation{:encoding => "application/x-tex"}
                        (t_n)^* : [S, \mathcal{C}]_{gReedy} \to [S_{\leq n},\mathcal{C}]_{gReedy}
                %p is both a left and a right Quillen functor.
          %p
            This is (
            %a{:href => "#BergerMoerdijk"}> Ber-Moer, lemma 6.4
            ).
          #ReedyCoFibrantImpliesCoFibrantTowers.num_prop
            %h6#proposition_5 Proposition
            %ol
              %li
                %p
                  If
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ∈
                        %mo{:stretchy => "false"} [
                        %mi S
                        %mo ,
                        %mi 𝒞
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} X \in [S, \mathcal{C}]
                  is Reedy cofibrant according to def.
                  = succeed "," do
                    %a.maruku-ref{:href => "#ReedyModelStructure"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi sk
                          %mi n
                        %mi X
                      %annotation{:encoding => "application/x-tex"} sk_n X
                  are Reedy cofibrant and the canonical morphisms
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi sk
                          %mi k
                        %mi X
                        %mo →
                        %msub
                          %mi sk
                          %mi l
                        %mi X
                      %annotation{:encoding => "application/x-tex"} sk_k X \to sk_l X
                  are Reedy cofibrations.
              %li
                %p
                  If
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ∈
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} X \in \mathcal{C}
                  is Reedy fibrant according to def.
                  %a.maruku-ref{:href => "#ReedyModelStructure"}
                  then all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi cosk
                          %mi n
                        %mi X
                      %annotation{:encoding => "application/x-tex"} cosk_n X
                  are Reedy fibrant and the canonical morphisms
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi cosk
                          %mi l
                        %mi X
                        %mo →
                        %msub
                          %mi cosk
                          %mi k
                        %mi X
                      %annotation{:encoding => "application/x-tex"} cosk_l X \to cosk_k X
                  are Reedy fibrations.
          %p
            This is (
            %a{:href => "#BergerMoerdijk"}> Ber-Moer, prop. 6.5
            ).
          .proof
            %h6#proof_17 Proof
            %p We discuss the skeleta. The case of coskeleta is dual.
            %p
              By lemma
              %a.maruku-ref{:href => "#IdempotenceOfCoSkeleta"}
              it is sufficient to consider the case
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi sk
                        %mi n
                      %mi X
                      %mo →
                      %msub
                        %mi sk
                        %mn ∞
                      %mi X
                      %mo =
                      %mi X
                    %annotation{:encoding => "application/x-tex"} sk_n X \to sk_\infty X = X
            %p
              To check that this is a Reedy cofibration if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is Reedy cofibrant, consider the diagram that induces the relative latching object for this morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi Latch
                              %mi k
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi sk
                              %mi n
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi Latch
                              %mi k
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msub
                              %mi sk
                              %mi n
                            %mo{:stretchy => "false"} (
                            %mi X
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi k
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi X
                              %mi k
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Latch_k(sk_n X) &amp;\to&amp; Latch_k (X)
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    sk_n(X)_k &amp;\to&amp; X_k
                    }
                    \\,.
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ≤
                      %mi n
                    %annotation{:encoding => "application/x-tex"} k \leq n
              %a.maruku-ref{:href => "#LatchingIsSkeleton"}
              the top morphism is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi sk
                      %mrow
                        %mi k
                        %mo −
                        %mn 1
                    %msub
                      %mi sk
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi k
                    %mo →
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi sk
                      %mrow
                        %mi k
                        %mo −
                        %mn 1
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi k
                  %annotation{:encoding => "application/x-tex"}
                    (sk_{k-1} sk_n(X))_k \to (sk_{k-1} X)_k
            %p
              and this is an iso by lemma
              = succeed "." do
                %a.maruku-ref{:href => "#IdempotenceOfCoSkeleta"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi t
                      %mi k
                      %mo *
                    %msub
                      %mi sk
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi k
                    %mo →
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi t
                      %mi k
                      %mo *
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi k
                  %annotation{:encoding => "application/x-tex"} (t_k^* sk_{n}(X))_k \to (t_k^* X)_k
              which is isomorphic to the identity by the kind of argument in lemma
              = succeed "." do
                %a.maruku-ref{:href => "#IdempotenceOfCoSkeleta"}
            %p Therefore also the relative latching morphism is an isomorphism in this case (use that pushouts of isos are isos and use 2-out-of-3 for isos), hence in particular a cofibration.
            %p
              Similarly, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo &gt;
                    %mi n
                  %annotation{:encoding => "application/x-tex"} k \gt n
              the left vertical map is an isomorphism, so that the relative latching morphism in this case is
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Latch
                        %mi k
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo →
                      %msub
                        %mi X
                        %mi k
                    %annotation{:encoding => "application/x-tex"} Latch_k(X) \to X_k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is Reedy cofibrant.
            %p
              Finally, that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi sk
                      %mi n
                    %mi X
                  %annotation{:encoding => "application/x-tex"} sk_n X
              is cofibrant follows directly from lemma
              = succeed "." do
                %a.maruku-ref{:href => "#QuillenPropertyOfCoSkeleta"}
          %h3#relation_to_other_model_structures Relation to other model structures
          %p (…)
          %h2#example Example
          %ul
            %li
              %p
                Every ordinary
                %a.existingWikiWord{:href => "/nlab/show/Reedy+category"} Reedy category
                is a generalized Reedy category, and in this case the above model structure reduces to the traditional
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Reedy+model+structure"} Reedy model structure
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/model+structure+for+dendroidal+complete+Segal+spaces"} model structure for dendroidal complete Segal spaces
                is a
                %a.existingWikiWord{:href => "/nlab/show/Bousfield+localization+of+model+categories"} left Bousfield localization
                of the generalized Reedy model structure over the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/tree+category"} tree category
          %h2#related_concepts Related concepts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Joyal-Tierney+calculus"} Joyal-Tierney calculus
          %h2#references References
          %ul#BergerMoerdijk
            %li
              %a.existingWikiWord{:href => "/nlab/show/Clemens+Berger"} Clemens Berger
              and
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ieke+Moerdijk"} Ieke Moerdijk
              = succeed "," do
                %em On an extension of the notion of Reedy category
              = succeed ")" do
                %a{:href => "http://arxiv.org/abs/0809.3341"} arXiv:0809.3341
