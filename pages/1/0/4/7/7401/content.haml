                          %mi n
                        %mo ∘
                        %msub
                          %mi i
                          %mi n
                        %mo :
                        %msup
                          %mi S
                          %mo +
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                        %mo →
