                          %mi Y
                          %mi s
                      %annotation{:encoding => "application/x-tex"} X_s \to Match_s(X) \prod_{Match_s(Y)} Y_s
                %p
                  for the dual universal morphism, called the
                  %strong relative matching map
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
