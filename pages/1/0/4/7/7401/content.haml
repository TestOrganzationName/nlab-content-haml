                        %mo ↪
                        %mi S
                      %annotation{:encoding => "application/x-tex"} \phi \colon S_{\leq n} \hookrightarrow S
                  \.
          %p
            This is (
            %a{:href => "#BergerMoerdijk"}> Ber-Moer, lemma 4.4
            ).
          .proof
            %h6#proof_11 Proof
            %p The pullback square is part of the diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi R
                          %mtd
                            %mover
                              %mo ←
