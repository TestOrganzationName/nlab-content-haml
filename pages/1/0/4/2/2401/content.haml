                %annotation{:encoding => "application/x-tex"} M \in Sch/\mathbb{C}
            equipped with a morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
