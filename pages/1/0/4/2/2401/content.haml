                    %mi op
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} F:(Sch/\mathbb{C})^{op} \to Set
            on complex
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/scheme"} scheme
            %a.existingWikiWord{:href => "/nlab/show/scheme"} scheme
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
