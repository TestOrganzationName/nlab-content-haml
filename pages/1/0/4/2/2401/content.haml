          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                %annotation{:encoding => "application/x-tex"} h
            denotes the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
          %p
            a)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi Spec
                  %mo{:stretchy => "false"} (
                  %mi ℂ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo →
