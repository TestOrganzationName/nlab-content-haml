                    %mi h
                    %mi M
                  %mo{:stretchy => "false"} (
                  %mi Spec
                  %mi ℂ
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %mi Spec
                  %mi ℂ
                  %mo ,
                  %mi M
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F(Spec(\mathbb{C})) \to h_M(Spec \mathbb{C}) = hom(Spec \mathbb{C}, M)
            is a
            %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
          %p
            b) given
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                  %mo ′
                %annotation{:encoding => "application/x-tex"} M'
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Ψ
                    %mrow
                      %mi M
                      %mo ′
                  %mo :
                  %mi F
                  %mo →
                  %msub
                    %mi h
                    %mrow
                      %mi M
                      %mo ′
                %annotation{:encoding => "application/x-tex"} \Psi_{M'} : F \to h_{M'}
            then there exists unique
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                  %mo →
                  %mi M
                  %mo ′
                %annotation{:encoding => "application/x-tex"} M \to M'
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
