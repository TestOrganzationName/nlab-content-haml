              %line{:fill => "none", :stroke => "#000000", "stroke-width" => "2", :x1 => "-9.5", :x2 => "-9.5", :y1 => "12", :y2 => "102"}
              %text{"font-family" => "Helvetica", "font-size" => "12", :transform => "matrix(1 0 0 1 -0.5 30)"} A
              %text{"font-family" => "Helvetica", "font-size" => "12", :transform => "matrix(1 0 0 1 -0.5 93)"} B
