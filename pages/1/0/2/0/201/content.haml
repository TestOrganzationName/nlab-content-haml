                  %h2#applications Applications
                  %ul
                    %li
                      %a.existingWikiWord{:href => "/nlab/show/applications+of+%28higher%29+category+theory"} applications of (higher) category theory
                  %div
                    %p
                      %a{:href => "/nlab/edit/category+theory+-+contents"} Edit this sidebar
          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#properties"} Properties
              %ul
                %li
                  %a{:href => "#free_abelian_groups"} Free abelian groups
                %li
                  %a{:href => "#DirectSumEtc"} Direct sum, direct product and tensor product
                %li
                  %a{:href => "#MonoidalAndBipermutativeStructure"} Symmetric monoidal and bimonoidal structure
                %li
