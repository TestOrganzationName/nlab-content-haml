                          %mo ,
                          %mn 0
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \mathcal{N}= (2,0)
                    theory
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1805.07241"} arXiv:1805.07241
            %p following
            %ul
              %li
                %a.existingWikiWord{:href => "/nlab/show/Tatiana+Ivanova"}> Tatiana Ivanova
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Olaf+Lechtenfeld"} Olaf Lechtenfeld
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Alexander+Popov"} Alexander Popov
                = succeed "," do
                  %em Non-Abelian sigma models from Yang-Mills theory compactified on a circle
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1803.07322"} arXiv:1803.07322
            %p See also:
            %ul
              %li
                Y. H. Ahn, Sin Kyu Kang, Hyun Min Lee,
                %em Towards a Model of Quarks and Leptons
                (
                %a{:href => "https://arxiv.org/abs/2112.13392"}> arXiv:2112.13392
                )
