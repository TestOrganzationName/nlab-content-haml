                    %mn 2
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ∈
                  %msup
                    %mi Ω
                    %mn 8
                %annotation{:encoding => "application/x-tex"}
                  I_8(R)
                  \\;\coloneqq\;
                  \\tfrac{1}{48}
                  \\Big(
                  p_2(R) \;-\; \big( \tfrac{1}{2} p_1(R)\big)^2
                  \\Big)
                  \\;\;
                  \\in
                  \\Omega^8
          %p
            (a
            %a.existingWikiWord{:href => "/nlab/show/differential+form"} differential form
            built from the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Riemann+curvature"} Riemann curvature
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Pontryagin+classes"} Pontryagin classes
            = succeed ")" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/I8"} I8
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℓ
                      %mn 6
                  %annotation{:encoding => "application/x-tex"} \ell^6
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℓ
                %annotation{:encoding => "application/x-tex"} \ell
            is the
            %a.existingWikiWord{:href => "/nlab/show/Planck+length"} Planck length
            in 11d (
            %a{:href => "#SoueresTsimpis17"}> Souères-Tsimpis 17, Section 4
            ).
          %p
            At this order, the
            %a.existingWikiWord{:href => "/nlab/show/equation+of+motion"} equation of motion
            for the
            %a.existingWikiWord{:href => "/nlab/show/supergravity+C-field"} supergravity C-field
            %a.existingWikiWord{:href => "/nlab/show/flux"} flux
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi G
                    %mn 4
                %annotation{:encoding => "application/x-tex"} G_4
            and its dual
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi G
                    %mn 7
                %annotation{:encoding => "application/x-tex"} G_7
            is (
            %a{:href => "#SoueresTsimpis17"}> Souères-Tsimpis 17, (4.3)
            )
          #eq:11dSugraBIAtOrder6.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %msub
                    %mi G
                    %mn 7
                  %mo{:stretchy => "false"} (
                  %mi ℓ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mo −
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mn 2
                  %msub
                    %mi G
                    %mn 4
                  %mo{:stretchy => "false"} (
                  %mi ℓ
                  %mo{:stretchy => "false"} )
                  %mo ∧
                  %msub
                    %mi G
                    %mn 4
                  %mo{:stretchy => "false"} (
                  %mi ℓ
                  %mo{:stretchy => "false"} )
                  %mo +
                  %msup
                    %mi ℓ
                    %mn 6
                  %msub
                    %mi I
                    %mn 8
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
