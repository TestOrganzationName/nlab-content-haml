                %annotation{:encoding => "application/x-tex"} \mathcal{O}(\ell^3)
            should be the further modification of
            %a.maruku-eqref{:href => "#eq:11dSugraBIAtOrder6"} (2)
            to (cf.
            = succeed "):" do
              %a{:href => "#Tsimpis04"} Tsimpis 2004, p. 8
          #eq:11dSugraBIAtOrder6.maruku-equation
            %span.maruku-eq-number (2)
