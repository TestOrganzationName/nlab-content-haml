                  \\;=\;
                  \-\tfrac{1}{2}
                  G_4(\ell) \wedge G_4(\ell)
                  +
                  \\ell^6 I_8(R)
                  \\,,
          %p
            where the flux forms themselves appear in their higher order corrected form as
            %a.existingWikiWord{:href => "/nlab/show/power+series"} power series
            in the
            %a.existingWikiWord{:href => "/nlab/show/Planck+length"} Planck length
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi G
                    %mn 4
