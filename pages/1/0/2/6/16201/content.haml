                    %mn 7
                  %mo +
                  %msup
                    %mi ℓ
                    %mn 6
                  %msubsup
                    %mi G
                    %mn 7
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo +
                  %mi ⋯
                %annotation{:encoding => "application/x-tex"}
                  G_7(\ell)
                  \\;=\;
                  G_7 + \ell^6 G_7^{(1)} + \cdots
          %p
            (
            %a{:href => "#SoueresTsimpis17"}> Souères-Tsimpis 17, (4.4)
            )
          %p
            Beware that this is not the lowest order
            = succeed ":" do
