                  %mi ℓ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi G
                    %mn 4
                  %mo +
                  %msup
                    %mi ℓ
                    %mn 6
                  %msubsup
                    %mi G
                    %mn 4
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo +
                  %mi ⋯
                %annotation{:encoding => "application/x-tex"}
                  G_4(\ell)
                  \\;=\;
                  G_4 + \ell^6 G_4^{(1)} + \cdots
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi G
                    %mn 7
