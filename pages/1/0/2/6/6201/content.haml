                            %mi b
                            %mi n
                          %mi ℝ
                          %mo{:stretchy => "false"} )
                        %mtd
                        %mtd
                        %mtd
                          %mi curvature
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  C^\infty(U)\otimes \Omega^\bullet(\Delta^k)
                  \&amp;\leftarrow&amp;
                  CE(b^{n-1}\mathbb{R})
                  \&amp;&amp;&amp;
                  underlying\;cocycle
                  \\\
                  \\uparrow &amp;&amp; \uparrow
                  \\\
                  \\Omega^\bullet(U) \otimes \Omega^\bullet(\Delta^k)
                  \&amp;\leftarrow&amp;
                  W(b^{n-1}\mathbb{R})
                  \&amp;&amp;&amp;
                  connection
                  \\\
                  \\uparrow &amp;&amp; \uparrow
                  \\\
                  \\Omega^\bullet(U)\otimes C^\infty(\Delta^k) &amp;\leftarrow&amp; CE(b^n \mathbb{R})
                  \&amp;&amp;&amp;
                  curvature
                  }
          %p where the restriction to the top morphism is the underlying cocycle and the restriction to the bottom morphism the curvature form.
          %p
            The generalization to such diagram cocycles from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi b
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} b^{n-1}\mathbb{R}
            to general
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebra"} ∞-Lie algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            we discuss below in
            = succeed "." do
              %a{:href => "#InfinityLieAlgebraConnection"} ∞-Lie algebra valued connections
          %h4#over_unoriented_base_objects Over unoriented base objects
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/higher+parallel+transport"} higher holonomy
            of a circle
            = succeed "-bundle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/oriented"} oriented
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
          %p
            See
            %a.existingWikiWord{:href => "/nlab/show/orientifold"} orientifold
            for more.
          %h3#StrucChernWeil
            Chern-Weil homomorphism and
            = succeed "-connections" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            We discuss the
            %a{:href => "http://nlab.mathforge.org/nlab/show/cohesive+(infinity%2C1)-topos#ChernWeilTheory"} general abstract notion of Chern-Weil homomorphism and ∞-connections
            realized in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Smooth
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} Smooth \infty Grpd
          %p
            Recall that for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %mi Smooth
                  %mn ∞
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"} A \in Smooth \infty Grpd
            a smooth
            = succeed "-groupoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo =
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} A = \mathbf{B}G
            of an
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            we have abstractly that
          %ul
            %li
              %p
                a
                %a.existingWikiWord{:href => "/nlab/show/characteristic+class"} characteristic class
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                with coefficients in the
                %a{:href => "#CircleLienGroup"} circle Lie n-group
                is represented by a morphism
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi c
                      %mo :
                      %mi A
                      %mo →
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi n
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo ;
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbf{c} : A \to \mathbf{B}^n U(1)
                      \\,;
            %li
              %p
                the (unrefined)
                %a.existingWikiWord{:href => "/nlab/show/Chern-Weil+homomorphism"} Chern-Weil homomorphism
                induced from this is the differential characteristic class given by the composite
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %msub
                          %mstyle{:mathvariant => "bold"}
                            %mi c
                          %mi dR
                      %mo :
                      %mi A
                      %mover
                        %mo →
                        %mstyle{:mathvariant => "bold"}
                          %mi c
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi n
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo →
                        %mi curv
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mo ♭
                        %mi dR
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"}
