                            %mn 1
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; U_1
                    \\\
                    \&amp; {}^{\mathrlap{f}}\nearrow &amp;&amp; \searrow
                    \\\
                    U_0 &amp;&amp;\to&amp;&amp; *
                    \\\
                    \&amp; {}_{\mathllap{const_{e,e}}}\searrow &amp;&amp; \swarrow_{\mathrlap{const_{e,e}}}
                    \\\
                    \&amp;&amp;
                    U(1) \times U(1)
                    }
            %p which asserts that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ω
                      %mrow
                        %msub
                          %mi U
                          %mn 0
                        %mover
                          %mo →
                          %mi f
                        %msub
                          %mi U
                          %mn 1
                        %mover
                          %mo →
                          %mi e
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi ω
                      %mrow
                        %msub
                          %mi U
                          %mn 0
                        %mo →
                        %mo *
                        %mover
                          %mo →
                          %mi e
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
