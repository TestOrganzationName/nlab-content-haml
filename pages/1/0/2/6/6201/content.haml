                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [C(\{U_i\}), \mathbf{B}_{diff}U(1)]
              coboundant to one with vanishing
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
