                              %mn 1
                              %mo{:stretchy => "false"} )
                              %msub
                                %mo{:stretchy => "false"} )
                                %mi dR
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      Smooth \infty Grpd(X,A)_{conn}
                      \&amp;\stackrel{\hat {\mathbf{c}}}{\to}&amp;
                      Smooth\infty Grpd(X, \mathbf{B}^n U(1))_{diff}
                      \\\
                      \\downarrow &amp;&amp; \downarrow
                      \\\
                      Smooth \infty Grpd(X,A)
                      \&amp;\stackrel{{\mathbf{c}_{dR}}}{\to}&amp;
                      Smooth \infty Grpd(X,\mathbf{B}^{n+1}U(1))_{dR}
                      }
                      \\,.
          %p
            %a{:href => "#CurvatureCharacteristicOnCircleNGroup"} Above
            we have discussed a presentation of the universal curvature class
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi ℝ
                  %mo →
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mo ♭
                    %mi dR
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbf{B}^n \mathbb{R} \to \mathbf{\flat}_{dR} \mathbf{B}^{n+1}\mathbb{R}
            by a span
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi n
