                        %mi dR
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mi ℝ
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %msubsup
                        %mi H
                        %mi dR
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      H^1_{Smooth}(X,G)
                      \:=
                      \\pi_0 Smooth\infty Grpd(X, \mathbf{B}G)
                      \\stackrel{\pi_0({(\mathbf{c}_{dR})_*})}{\to}
                      \\pi_0 Smooth\infty Grpd(X, \mathbf{\flat}_{dR} \mathbf{B}^{n+1} \mathbb{R})
                      \\simeq
                      H_{dR}^{n+1}(X)
              %p induced by this.
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/connection+on+an+%E2%88%9E-bundle"} ∞-connections
                with coefficients in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                are the
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Smooth
                      %mn ∞
                      %mi Grpd
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi A
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi conn
                    %annotation{:encoding => "application/x-tex"} Smooth \infty Grpd(X,A)_{conn}
                that universally lifts these differential classs in de Rham cohomology to full
                = succeed "," do
                  %a{:href => "#StrucDifferentialCohomology"} differential cohomology
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi Smooth
                              %mn ∞
                              %mi Grpd
                              %mo{:stretchy => "false"} (
                              %mi X
                              %mo ,
                              %mi A
                              %msub
                                %mo{:stretchy => "false"} )
                                %mi conn
                            %mtd
                              %mover
                                %mo →
                                %mover
                                  %mstyle{:mathvariant => "bold"}
                                    %mi c
                                  %mo{:stretchy => "false"} ^
                            %mtd
                              %mi Smooth
                              %mn ∞
                              %mi Grpd
                              %mo{:stretchy => "false"} (
                              %mi X
                              %mo ,
                              %msup
                                %mstyle{:mathvariant => "bold"}
                                  %mi B
                                %mi n
                              %mi U
                              %mo{:stretchy => "false"} (
                              %mn 1
                              %mo{:stretchy => "false"} )
                              %msub
                                %mo{:stretchy => "false"} )
