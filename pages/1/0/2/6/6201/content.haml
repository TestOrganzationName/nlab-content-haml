                  \&amp; \searrow &amp; \downarrow &amp;&amp; \downarrow
                  \\\
                  \&amp;&amp; \mathbf{\flat}_{dR}\mathbf{B}^{n+1}U(1)_{smp}
                  \&amp;\stackrel{\int_{\Delta^\bullet}}{\to^\simeq}&amp;
                  \\mathbf{\flat}_{dR}\mathbf{B}^{n+1}U(1)_{chn}
                  \&amp;&amp;&amp;
                  curvature
                  }
                  \\,.
          %p
            In summary this gives us the following alternative perspective on connections on
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}^{n-1}U(1)
            = succeed "s:" do
              %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
            = succeed "-quotient" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}^n \mathbb{Z}
            = succeed "-coskeleton" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n+1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %mi k
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (U,[k])
            is the set of diagrams of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msup
                            %mi C
                            %mn ∞
                          %mo{:stretchy => "false"} (
                          %mi U
                          %mo{:stretchy => "false"} )
                          %mo ⊗
                          %msup
                            %mi Ω
                            %mo •
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi Δ
                            %mi k
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ←
                        %mtd
                          %mi CE
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi b
                            %mrow
                              %mi n
                              %mo −
                              %mn 1
                          %mi ℝ
                          %mo{:stretchy => "false"} )
                        %mtd
                        %mtd
                        %mtd
                          %mi underlying
                          %mspace{:width => "thickmathspace"}
                          %mi cocycle
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↑
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↑
                      %mtr
                        %mtd
                          %msup
                            %mi Ω
                            %mo •
                          %mo{:stretchy => "false"} (
                          %mi U
                          %mo{:stretchy => "false"} )
                          %mo ⊗
                          %msup
                            %mi Ω
                            %mo •
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi Δ
                            %mi k
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ←
                        %mtd
                          %mi W
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi b
                            %mrow
                              %mi n
                              %mo −
                              %mn 1
                          %mi ℝ
                          %mo{:stretchy => "false"} )
                        %mtd
                        %mtd
                        %mtd
                          %mi connection
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↑
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↑
                      %mtr
                        %mtd
                          %msup
                            %mi Ω
                            %mo •
                          %mo{:stretchy => "false"} (
                          %mi U
                          %mo{:stretchy => "false"} )
                          %mo ⊗
                          %msup
                            %mi C
                            %mn ∞
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi Δ
                            %mi k
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ←
                        %mtd
                          %mi CE
                          %mo{:stretchy => "false"} (
