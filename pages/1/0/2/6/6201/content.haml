              such that the canonical projection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi 𝔤
                      %mo •
                      %mo *
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ⊕
                    %msubsup
                      %mi 𝔤
                      %mo •
                      %mo *
                    %mo{:stretchy => "false"} [
                    %mn 2
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %msubsup
                      %mi 𝔤
                      %mo •
                      %mo *
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}_\bullet^*[1] \oplus \mathfrak{g}_\bullet^*[2] \to \mathfrak{g}_\bullet^*[1]
              extends to a
              %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
              homomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo ←
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    CE(\mathfrak{g}) \leftarrow W(\mathfrak{g})
                    \\,.
          .num_defn
            %h6#definition_19 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                    %mo ∈
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g} \in L_\infty
              define the
              %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaf"} simplicial presheaf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi diff
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi CartSp
                      %mi smooth
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \exp(\mathfrak{g})_{diff} \in [CartSp_{smooth}^{op}, sSet]
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi diff
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mi k
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msubsup
                                %mi Ω
                                %mrow
                                  %mi si
                                  %mo ,
                                  %mi vert
                                %mo •
                              %mo{:stretchy => "false"} (
                              %mi U
                              %mo ×
                              %msup
                                %mi Δ
                                %mi k
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo ←
                            %mtd
                              %mi CE
                              %mo{:stretchy => "false"} (
                              %mi 𝔤
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↑
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} ↑
                          %mtr
                            %mtd
                              %msup
                                %mi Ω
                                %mo •
