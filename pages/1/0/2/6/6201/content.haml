                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Q(U)
              to its set of objects, hence is the
              %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ↦
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mi A
                                %mn 0
                              %mo =
                              %mn 0
                          %mtr
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mi g
                          %mtr
                            %mtd
                              %msup
                                %mi g
