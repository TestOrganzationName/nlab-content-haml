                    \\,.
            %p
              The right hand is the
              = succeed "-groupoid" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech
              %a.existingWikiWord{:href => "/nlab/show/hypercohomology"} hypercohomology
              of the truncated complex of sheaves of differential forms. A cocycle is given by a collection
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mi i
                    %mo ,
                    %msub
                      %mi B
                      %mrow
                        %mi i
                        %mi j
                    %mo ,
                    %msub
                      %mi A
                      %mrow
                        %mi i
                        %mi j
                        %mi k
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi Z
                      %mrow
                        %msub
                          %mi i
                          %mn 1
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %msub
                          %mi i
                          %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (C_i, B_{i j}, A_{i j k}, \cdots  , Z_{i_1, \cdots, i_n})
            %p
              of differential forms, with
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi C
                        %mi i
                      %mo ∈
                      %msubsup
                        %mi Ω
                        %mi cl
                        %mi n
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi U
                        %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C_i \in \Omega^n_{cl}(U_i)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
