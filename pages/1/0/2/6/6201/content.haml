                  %annotation{:encoding => "application/x-tex"} \mathbf{B}^n \mathbb{R}_{diff,smp} \in [CartSp_{smooth}^{op}, sSet]
              be the
              %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaf"} simplicial presheaf
