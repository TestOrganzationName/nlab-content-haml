                          %mo →
                          %mi e
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\omega_{U_0 \stackrel{f}{\to} U_1 \stackrel{e}{\to} U(1)}
                    \=
                    \\omega_{U_0 \to * \stackrel{e}{\to} U(1)}
                    \-
                    f^* \omega_{U_1 \to * \stackrel{e}{\to} U(1)}
                    \\,.
            %p
              Moreover we claim that such cocycles with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi λ
                      %mi U
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \lambda_U = 0
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ω
                      %mrow
                        %msub
                          %mi U
                          %mn 0
                        %mo →
                        %msub
                          %mi U
                          %mn 1
                        %mover
                          %mo →
                          %mi e
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \omega_{U_0 \to U_1 \stackrel{e}{\to} U(1)}
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 0
                    %mover
                      %mo →
                      %mi f
                    %msub
                      %mi U
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} U_0 \stackrel{f}{\to} U_1
              have no nontrivial morphisms between them, which means that these do constitute unique representatives of their cohomology classes. This is because such a morphism would be given by a collection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi κ
                      %mi U
                    %mo ∈
                    %msubsup
                      %mi Ω
                      %mi cl
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \kappa_U \in \Omega^1_{cl}(U)
              of closed 1-forms for each
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ∈
                      %mi CartSp
                    %annotation{:encoding => "application/x-tex"} U \in CartSp
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 0
                    %mover
                      %mo →
                      %mi f
                    %msub
                      %mi U
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} U_0 \stackrel{f}{\to} U_1
              we’d have
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi κ
                        %mrow
                          %msub
                            %mi U
                            %mn 0
                      %mo =
                      %msup
                        %mi f
                        %mo *
