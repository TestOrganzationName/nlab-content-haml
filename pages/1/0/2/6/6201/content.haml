                    %annotation{:encoding => "application/x-tex"} [CartSp^{op}, sSet]_{proj,loc}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Smooth
                    %mn ∞
                    %mi Grpd
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mo ♭
                      %mi dR
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} [
                    %msup
