                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_0 sPSh(\int^{[k]} \Delta[k]\cdot C(\{U^k_i\}), \mathbf{B}^n A) \to H^n(G,A)
                    \\,.
            %p It remains to show that the set on the left is the differentiable Lie group cohomology.
            %p
              For that observe that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}^n A
              is in the image of the
              %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan correspondence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ξ
                    %mo :
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %msub
                      %mi Ch
                      %mo •
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %mi sAb
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo →
                      %mi U
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \Xi : [CartSp^{op}, Ch_\bullet] \to [CartSp^{op}, sAb] \stackrel{U}{\to} [CartSp^{op}, sSet]
              of the chain-complex valued presheaf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mi A
                    %msub
                      %mo ⊗
                      %mi ℤ
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} A[n] = A \otimes_\mathbb{Z} \mathbb{Z}[n]
              to reduce the computation of this simplicial hom-complex to that of a cochain complex:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
