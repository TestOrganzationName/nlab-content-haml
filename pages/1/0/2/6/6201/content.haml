                    \\Pi(X) \simeq Sing X
            %p
              is equivalent to the standard
              %a.existingWikiWord{:href => "/nlab/show/fundamental+%E2%88%9E-groupoid"} fundamental ∞-groupoid
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          .proof
            %h6#proof_2 Proof
            %p
              By a
              %a{:href => "#UnderlyingETopologicalInftyGroupoids"} proposition above
              the functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                  %annotation{:encoding => "application/x-tex"} \Pi
              factors as
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Π
                      %mi X
                      %mo ≃
                      %msub
                        %mi Π
                        %mi ETop
                      %msub
                        %mi i
                        %mo !
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \Pi X \simeq \Pi_{ETop} i_! X
              %a{:href => "#UnderlyingSimplicialTopologicalSpace"} above proposition
              this is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mi Etop
                  %annotation{:encoding => "application/x-tex"} \Pi_{Etop}
              applied to the underlying
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+topological+space"} simplicial topological space
              %a{:href => "#http://ncatlab.org/nlab/show/Euclidean-topological+infinity-groupoid#GeometricHomotopy"} corresponding proposition
              discussed at
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/ETop%E2%88%9EGrpd"} ETop∞Grpd
          .num_prop
            %h6#corollary_2 Corollary
            %p
              The
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo :
                    %mi{:mathvariant => "normal"} Smooth
                    %mn ∞
                    %mi{:mathvariant => "normal"} Grpd
                    %mo →
                    %mn ∞
                    %mi{:mathvariant => "normal"} Grpd
                  %annotation{:encoding => "application/x-tex"} \Pi : \mathrm{Smooth}\infty\mathrm{Grpd} \to \infty \mathrm{Grpd}
              preserves
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi{:mathvariant => "normal"} CartSp
                      %mi{:mathvariant => "normal"} smooth
                      %mi{:mathvariant => "normal"} op
                    %mo ,
                    %mi{:mathvariant => "normal"} sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi{:mathvariant => "normal"} proj
                  %annotation{:encoding => "application/x-tex"} [\mathrm{CartSp}_{\mathrm{smooth}}^{\mathrm{op}}, \mathrm{sSet}]_{\mathrm{proj}}
              by morphisms of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mover
                      %mi W
                      %mo{:stretchy => "false"} ¯
                    %mi G
                  %annotation{:encoding => "application/x-tex"} X \to \bar W G
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              fibrant and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              a simplicial group in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/SmoothMfd"} SmoothMfd
          .proof
            %h6#proof_3 Proof
            %p By the above the functor factors as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mi{:mathvariant => "normal"} Smooth
                    %mo ≃
                    %msub
                      %mi Π
                      %mi{:mathvariant => "normal"} ETop
                    %mo ∘
                    %msub
                      %mi i
                      %mo !
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Pi_{\mathrm{Smooth}} \simeq \Pi_{\mathrm{ETop}} \circ i_!
                    \\,.
            %p
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mo !
                  %annotation{:encoding => "application/x-tex"} i_!
              assigns the underlying topological spaces. If we can show that this preserves the homotopy fibers in question, then the claim follows with the analogous discussion at
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/ETop%E2%88%9EGrpd"} ETop∞Grpd
            %p We find this as in the proof of the latter proposition, by considering the pasting diagram of pullbacks of simplicial presheaves
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi P
                            %mo ′
                          %mtd
                            %mo →
                          %mtd
                            %mi P
                          %mtd
                            %mo →
                          %mtd
                            %mi W
                            %mi G
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi Q
                            %mi X
                          %mtd
                            %mo →
                          %mtd
                            %mi X
                          %mtd
                            %mo →
                          %mtd
                            %mover
                              %mi W
                              %mo{:stretchy => "false"} ¯
                            %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    P' &amp;\to&amp; P &amp;\to&amp; W G
                    \\\
                    \\downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow
                    \\\
                    Q X &amp;\to&amp; X &amp;\to&amp; \bar W G
                    }
                    \\,.
            %p
              Since the component maps of the right vertical morphisms are surjective, the degreewise pullbacks in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} SmoothMfd
                  %annotation{:encoding => "application/x-tex"} \mathrm{SmoothMfd}
              that define
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} P'
              are all along
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/transversal+map"} transversal map
              %a.existingWikiWord{:href => "/nlab/show/TopMfd"} TopMfd
              are the pullbacks of the underlying topological manifolds. Therefore the degreewise forgetful functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} SmoothMfd
                    %mo →
                    %mi{:mathvariant => "normal"} TopMfd
                  %annotation{:encoding => "application/x-tex"} \mathrm{SmoothMfd} \to \mathrm{TopMfd}
              presents
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mo !
                  %annotation{:encoding => "application/x-tex"} i_!
              on the outer diagram and sends this homotopy pullback to a homotopy pullback.
          %h3#paths_and_geometric_postnikov_towers Paths and geometric Postnikov towers
          %h3#PresentationOfPathGroupoid Paths and geometric Postnikov towers
          %p
            We discuss the notion of
            %em
              %a{:href => "http://ncatlab.org/nlab/show/cohesive+%28infinity,1%29-topos+--+structures#Paths"} geometric path ∞-groupoids
            realized in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Smooth
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} Smooth\infty Grpd
          .num_defn
            %h6#definition Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} X \in
              %a.existingWikiWord{:href => "/nlab/show/SmthMfd"} SmthMfd
              write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Sing
                    %mi X
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{Sing} X  \in [CartSp^{op}, sSet]
            %p
              for the simplicial presheaf that sends a test space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} U \in
              %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              to the
              %a.existingWikiWord{:href => "/nlab/show/singular+simplicial+complex"} singular simplicial complex
              of smooth simplices smoothly parameterized over
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Sing
                    %mi X
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %msub
                      %mi Hom
                      %mi SmthMfd
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %msup
                      %mi Δ
                      %mi k
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{Sing} X : (U,k)
                    \\mapsto Hom_{SmthMfd}(U \times \Delta^k, X)
                    \\,.
          .num_prop
            %h6#proposition_2 Proposition
            %p
              The object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Sing
                    %mi X
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbf{Sing} X \in [CartSp^{op}, sSet]
              presents the abstractly defined
              %a.existingWikiWord{:href => "/nlab/show/fundamental+%E2%88%9E-groupoid+in+a+locally+%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} fundamental ∞-groupoid in a locally ∞-connected (∞,1)-topos
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Π
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{\Pi}(X)
          .proof
            %h6#proof_4 Proof
            %p
              Using the
              %a.existingWikiWord{:href => "/nlab/show/Steenrod-Wockel+approximation+theorem"} Steenrod-Wockel approximation theorem
              this comes down to the same argument as for
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/Euclidean+topological+%E2%88%9E-groupoid"} Euclidean topological ∞-groupoid
              %em
                %a{:href => "http://ncatlab.org/nlab/show/Euclidean-topological+infinity-groupoid#PresentationOfPathGroupoid"} Presentation of the path ∞-groupoid
              there.
          %h3#StrucConcreteObjects
            Concrete objects – diffeological
            = succeed "-groupoids" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p This section is at
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/concrete+smooth+infinity-groupoid"}> concrete smooth infinity-groupoid
              \.
          %h3#StrucGeometry Geometry and structure sheaves
          %p (…)
          %h3#StrucInfinGroups
            Cohesive
            = succeed "-groups" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            We discuss
            %a{:href => "http://nlab.mathforge.org/nlab/show/cohesive%20(infinity,1)-topos#InfinGroups"} cohesive ∞-groups
            in
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Smooth
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} Smooth \infty Grpd
            = succeed "-groups." do
