            %p
              Similarly, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo :
                    %mi K
                    %mo →
                    %mi U
                  %annotation{:encoding => "application/x-tex"} h : K \to U
              any morphism in
              %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                      %mi smooth
                  %annotation{:encoding => "application/x-tex"} {}_{smooth}
              the
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} naturality
              condition for a morphism of
              %a.existingWikiWord{:href => "/nlab/show/presheaves"} presheaves
              follows from the fact that the composites of
              %a.existingWikiWord{:href => "/nlab/show/bundle"} bundle
              morphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi K
                            %mo ×
                            %msup
                              %mi Δ
                              %mi n
                          %mtd
                            %mover
                              %mo →
