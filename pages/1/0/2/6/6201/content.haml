                      %mi B
                    %msub
                      %mi G
                      %mi c
                  %annotation{:encoding => "application/x-tex"} \mathbf{\flat}\mathbf{B}G_{c} \to \mathbf{B}G_{c}
              which is a fibration in
              = succeed "." do
