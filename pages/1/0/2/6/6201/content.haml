                  %semantics
                    %mrow
                      %msub
                        %mi κ
                        %mi U
                    %annotation{:encoding => "application/x-tex"} \kappa_U
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              such that this is not satisfied. For instance simply take
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi U
                      %mo →
                      %mo *
                    %annotation{:encoding => "application/x-tex"} f : U \to *
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi κ
