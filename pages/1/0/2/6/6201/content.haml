                    %mo{:stretchy => "false"} (
                    %msub
                      %mi G
                      %mi disc
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mstyle{:mathvariant => "bold"}
                      %mo ♭
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    diag N B (G_{disc})_\bullet
                    \\stackrel{\simeq}{\to}
                    \\bar W (G_{disc})
                    \\simeq
                    \\mathbf{\flat}\mathbf{B}G
                    \\,.
            %p Now observe that the morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi diag
                    %mo{:stretchy => "false"} (
                    %mi N
                    %msubsup
                      %mi Ω
                      %mi flat
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %msub
                      %mi 𝔤
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi G
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi diag
                    %mi N
                    %mo *
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi G
                      %mi disc
                  %annotation{:encoding => "application/x-tex"}
                    diag (N  \Omega^1_{flat}(-,\mathfrak{g}_\bullet)
                    \//
                    G_\bullet
                    )
                    \\to
                    diag N *// G_{disc}
            %p is a global fibration. This is in fact true for every morphism of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi diag
                    %mi N
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mo •
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi G
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi diag
                    %mo *
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi G
                      %mo •
                  %annotation{:encoding => "application/x-tex"}
                    diag N (S_\bullet//G_\bullet) \to diag *//G_\bullet
            %p
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mo •
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi G
                      %mo •
                    %mo →
                    %mo *
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi G
                      %mo •
                  %annotation{:encoding => "application/x-tex"} S_\bullet//G_\bullet \to *//G_\bullet
              a simlicial
              %a.existingWikiWord{:href => "/nlab/show/action+groupoid"} action groupoid
              projection with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              a simplicial group acting on a
              %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi diag
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi G
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi k
                    %mo =
                    %msub
                      %mi S
                      %mi k
                    %mo ×
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi G
                      %mi k
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mo ×
                          %mi k
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (diag N (S//G))_k
                    \=
                    S_k \times (G_k)^{\times_k}
                    \\,.
            %p
              On the second factor the horn filling condition is simply that of the identity map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi diag
                    %mi N
                    %mi B
                    %mi G
                    %mo →
                    %mi diag
                    %mi N
                    %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} diag N B G \to diag N B G
              which is evidently solvable, whereas on the first factor it amounts to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo →
                    %mo *
                  %annotation{:encoding => "application/x-tex"} S \to *
              being a Kan fibration, hence to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              being Kan fibrant.
            %p
              But the simplicial presheaf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi flat
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %msub
                      %mi 𝔤
                      %mo •
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega^1_{flat}(-,\mathfrak{g}_\bullet)
              is indeed Kan fibrant: for a given
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                    %mi CartSp
                  %annotation{:encoding => "application/x-tex"} U \in CartSp
              we may use
              %a.existingWikiWord{:href => "/nlab/show/parallel+transport"} parallel transport
              to (non-canonically) identify
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi flat
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %msub
                      %mi 𝔤
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi SmoothMfd
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %msub
                      %mi G
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^1_{flat}(U, \mathfrak{g}_k)
                    \\simeq
                    SmoothMfd_*(U, G_k)
                    \\,,
            %p
              where on the right we have
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              to the neutral element. But since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mo •
                  %annotation{:encoding => "application/x-tex"} G_\bullet
              is Kan fibrant and has smooth global fillers (by the discussion at
              %a.existingWikiWord{:href => "/nlab/show/simplicial+group"} simplicial group
              one can give algebraic formulas for the fillers, which translate into smooth manps) als
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi SmoothMfd
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %msub
                      %mi G
                      %mo •
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SmoothMfd_*(U,G_\bullet)
              is Kan fibrant.
            %p
              In summary this means that the defining
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mo ♭
                      %mi dR
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo :
                    %mo =
                    %mstyle{:mathvariant => "bold"}
                      %mo ♭
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %msub
                      %mo ×
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                    %mo *
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{\flat}_{dR} \mathbf{B}G
                    \:=
                    \\mathbf{\flat} \mathbf{B}G \times_{\mathbf{B}G} *
            %p
              is presented by the ordinary
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              of
              %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaves"} simplicial presheaves
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi diag
                    %mi N
                    %msubsup
                      %mi Ω
                      %mi flat
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %msub
                      %mi 𝔤
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi diag
                    %mi N
                    %mi B
                    %msub
                      %mi G
                      %mo •
                    %mo *
                    %mo =
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %msub
                      %mi 𝔤
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    diag N \Omega^1_{flat}(-,\mathfrak{g}_\bullet)
                    \\times
                    diag N B G_\bullet *
                    \=
                    \\Omega^1(-, \mathfrak{g}_\bullet)
                    \\,.
          .num_prop
            %h6#proposition_33 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              a simplicial Lie group the
              %a{:href => "http://ncatlab.org/nlab/show/cohesive+%28infinity%2C1%29-topos+--+structures#CurvatureCharacteristics"} canonical differential form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                    %mo :
                    %mi G
                    %mo →
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mo ♭
                      %mi dR
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"}
                    \\theta : G \to \mathbf{\flat}_{dR} \mathbf{B}G
            %p
              is presented in terms of the above presentation for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mo ♭
                      %mi dR
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{\flat}_{dR} \mathbf{B}G
              by the morphisms of simplicial presheaves
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi θ
                      %mi k
                    %mo :
                    %msub
                      %mi G
                      %mi k
                    %mo →
                    %msubsup
                      %mi Ω
                      %mi flat
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %msub
                      %mi 𝔤
                      %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\theta_k
                    \:
                    G_k
                    \\to
                    \\Omega^1_{flat}(-, \mathfrak{g}_k)
            %p
              which is the presheaf-incarnation of the Maurer-Cartan form of the ordinary Lie group
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi G
                        %mi k
                    %annotation{:encoding => "application/x-tex"} G_k
          .proof
            %h6#proof_35 Proof
            %p
              Continuing with the strategy of the previous proof we find a resolution of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mo ♭
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} * \to \mathbf{\flat} \mathbf{B}G
              by applying the construction of
              %em
                %a{:href => "#CanonicalFormOnLieGroup"} The canonical form on a Lie group
              degreewise and then applying
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi diag
                      %mi N
                    %annotation{:encoding => "application/x-tex"} diag N
            %p The defining homotopy pullback
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi G
                          %mtd
                            %mover
                              %mo →
                              %mrow
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mo ♭
                              %mi dR
                          %mtd
                            %mo →
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mo ♭
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    G &amp;\stackrel{}{\to}&amp; *
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    \\mathbf{\flat}_{dR}
                    \&amp;\to&amp;
                    \\mathbf{\flat} \mathbf{B}G
                    }
            %p
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                  %annotation{:encoding => "application/x-tex"} \theta
              is this way presented by the ordinary pullback
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi G
                              %mo •
                          %mtd
                            %mover
                              %mo →
                              %mrow
                          %mtd
                            %mi diag
                            %mi N
                            %mrow
                              %mo (
                              %msubsup
                                %mi Ω
                                %mi flat
                                %mn 1
                              %mo{:stretchy => "false"} (
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo ,
                              %msub
                                %mi 𝔤
                                %mo •
                              %mo{:stretchy => "false"} )
                              %msub
                                %mo{:stretchy => "false"} )
                                %mi triv
                              %mo{:stretchy => "false"} /
                              %mo{:stretchy => "false"} /
                              %msub
                                %mi G
                                %mo •
                              %mo )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msubsup
                              %mi Ω
                              %mi flat
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo ,
                            %msub
                              %mi 𝔤
                              %mo •
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mi diag
                            %mi N
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi Ω
                              %mi flat
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo ,
                            %msub
                              %mi 𝔤
                              %mo •
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} /
                            %msub
                              %mi G
                              %mo •
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    G_\bullet &amp;\stackrel{}{\to}&amp;
                    diag N \left( \Omega^1_{flat}(-, \mathfrak{g}_\bullet))_{triv} // G_\bullet \right)
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    \\Omega^1_{flat}(-, \mathfrak{g}_\bullet)
                    \&amp;\to &amp;
                    diag N (\Omega^1_{flat}(-,\mathfrak{g}_\bullet)//G_\bullet)
                    }
            %p
              of simplicial presheaves, where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi flat
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %msub
                      %mi 𝔤
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega^1_{flat}(-,\mathfrak{g}_\k)
              is the set of flat
              = succeed "-valued" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              equipped with a gauge transformation
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mover
                        %mo →
                        %mi g
                      %mi A
                    %annotation{:encoding => "application/x-tex"} 0 \stackrel{g}{\to} A
              %a.existingWikiWord{:href => "/nlab/show/resolution"} resolution
              of the point inclusion. The pullback is degreewise that from the case of ordinary Lie groups and thus the result follows.
          %p
            We can now give a simplicial description of the canonical curvature form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi θ
                  %mo :
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mo ♭
                    %mi dR
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \theta : \mathbf{B}^n U(1) \to \mathbf{\flat}_{dR} \mathbf{B}^{n+1} U(1)
            that
            %a{:href => "#CurvatureCharacteristicOnCircleNGroup"} above
            we obtained by a chain complex model:
          .num_example
            %h6#example Example
            %p
              The canonical form on the
              %a.existingWikiWord{:href => "/nlab/show/circle+Lie+n-group"} circle Lie n-group
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                    %mo :
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mo ♭
                      %mi dR
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\theta : \mathbf{B}^{n-1}U(1)
                    \\to
                    \\mathbf{\flat}_{dR} \mathbf{B}^n U(1)
            %p is presented by the simplicial map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ξ
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Ξ
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Ω
                      %mi cl
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Xi( U(1)[n-1] )
                    \\to
                    \\Xi( \Omega^1_{cl}(-)[n-1] )
            %p
              which is simply the Maurer-Cartan form on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(1)
              in degree
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            %p
              The equivalence to the model we obtained before is given by noticing the equivalence in
              %a.existingWikiWord{:href => "/nlab/show/hypercohomology"} hypercohomology
              of chain complexes of abelian sheaves
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi cl
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi d
                          %mi dR
                    %mi ⋯
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi d
                          %mi dR
                    %msubsup
                      %mi Ω
                      %mi cl
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^1_{cl}(-)[n]
                    \\simeq
                    (\Omega^1(-) \stackrel{d_{dR}}{\to}
                    \\cdots
                    \\stackrel{d_{dR}}{\to}
                    \\Omega^n_{cl}(-)
                    )
            %p
              on
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
          %h3#FlatEhresmannConnections Flat Ehresmann connections
          %p
            We discuss the realization of the general abstract concept of
            %a{:href => "cohesive+%28infinity%2C1%29-topos+--+structures#FlatEhresmannConnections"} flat Ehresmann infinity-connections
            realized in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Smooth
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} Smooth\infty Grpd
            %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            this reproduces the traditional notion of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Ehresmann+connection"} Ehresmann connection
          %p (…)
          %h3#StrucDifferentialCohomology Differential cohomology
          %p
            We discuss the
            %a{:href => "http://nlab.mathforge.org/nlab/show/cohesive+(infinity%2C1)-topos#DifferentialCohomology"} intrinsic differential cohomology
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Smooth
                  %mn ∞
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"} Smooth \infty Grpd
          %p
            We first expose the simple special case of ordinary
            %a.existingWikiWord{:href => "/nlab/show/principal+U%281%29-bundle"} principal U(1)-bundle
            with
            %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connection
            in more detail. Then we turn to the general case.
          %h4#circle_0_and_circle_1bundle_with_connection Circle 0- and circle 1-bundle with connection
          %h5#CircleBundlesConnection Circle bundles with connection
          %p
            Before discussing
            = succeed "," do
              %a{:href => "#DeligneCohomologyTheorem"} the full theorem
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} n=1
            in some detail, which is about ordinary
            %a.existingWikiWord{:href => "/nlab/show/principal+U%281%29-bundles"} principal U(1)-bundles
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} with connection
          %p
            This contains in it already all the relevant structure of the general case, but the low categorical degree is more transparently written out and will allow us to pause to highlight some maybe noteworthy aspects of the situation, such as the phenomenon of
            %em pseudo-connections
            = succeed "." do
              %a{:href => "#CircleBunlePseudoConnection"} below
          %p
            In terms of the
            %a{:href => "#DoldKan"} Dold-Kan correspondence
            the object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{B}U(1) \in \mathbf{H}
            is modeled in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi CartSp
                    %mi op
                  %mo ,
                  %mi sSet
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [CartSp^{op}, sSet]
            by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi Ξ
                  %mo{:stretchy => "false"} (
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mn 0
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{B}U(1)
                  \=
                  \\Xi(\;
                  C^\infty(-,U(1)) \to 0
                  \\;)
                  \\,.
          %p
            Accordingly we have for the double
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            the model
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 2
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi Ξ
                  %mo{:stretchy => "false"} (
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mn 0
                  %mo →
                  %mn 0
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{B}^2 U(1)
                  \=
                  \\Xi(
                  \\;
                  C^\infty(-,U(1)) \to 0  \to 0
                  \\;)
          %p
            and for the
            %a.existingWikiWord{:href => "/nlab/show/universal+principal+%E2%88%9E-bundle"} universal principal 2-bundle
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi E
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi Ξ
                  %mo{:stretchy => "false"} (
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mi Id
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mn 0
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{E}\mathbf{B}U(1)
                  \=
                  \\Xi(
                  \\;
                  C^\infty(-,U(1)) \stackrel{Id}{\to} C^\infty(-, U(1)) \to 0
                  \\;
                  )
                  \\,.
          %p In this notation we have also the constant presheaf
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mo ♭
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 2
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi Ξ
                  %mo{:stretchy => "false"} (
                  %mspace{:width => "thickmathspace"}
                  %mi const
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mn 0
                  %mo →
                  %mn 0
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{\flat} \mathbf{B}^2 U(1)
                  \=
                  \\Xi(
                  \\;
                  const U(1) \to 0 \to 0
                  \\;
                  )
                  \\,.
          %p Above we already found the model
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mo ♭
                    %mi dR
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 2
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi Ξ
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo →
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi d
                        %mi dR
                  %msubsup
                    %mi Ω
                    %mi cl
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{\flat}_{dR} \mathbf{B}^2 U(1)
                  \=
                  \\Xi(0 \to \Omega^1(-) \stackrel{d_{dR}}{\to} \Omega^2_{cl}(-))
                  \\,.
          %p
            In order to compute the differential cohomology
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mi diff
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{H}_{diff}(-,\mathbf{B}U(1))
            by an ordinary pullback in
            %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
            we also want to resolve the curvature characteristic morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mo ♭
                    %mi dR
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 2
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{B}U(1) \to \mathbf{\flat}_{dR} \mathbf{B}^2 U(1)
            by a fibration. We claim that this may be obtained by choosing the resolution
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo ←
                    %mo ≃
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi diff
                      %mo ,
                      %mi chn
                %annotation{:encoding => "application/x-tex"} \mathbf{B}U(1) \stackrel{\simeq}{\leftarrow} \mathbf{B} U(1)_{diff,chn}
            given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi diff
                  %mo :
                  %mo =
                  %mi Ξ
                  %mo{:stretchy => "false"} (
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
