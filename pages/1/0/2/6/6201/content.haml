                              %mo{:stretchy => "false"} (
                              %mi 𝔤
                              %mo{:stretchy => "false"} )
                      %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\exp(\mathfrak{g})_{diff}
                    \:
                    (U, [k])
                    \\mapsto
                    \\left\{
                    \\array{
                    \\Omega^\bullet_{si,vert}(U \times \Delta^k)
                    \&amp;\leftarrow&amp; CE(\mathfrak{g})
                    \\\
                    \\uparrow &amp;&amp; \uparrow
                    \\\
                    \\Omega^\bullet(U \times \Delta^k)
                    \&amp;\leftarrow&amp;
                    W(\mathfrak{g})
                    }
                    \\right\}
                    \\,,
            %p
              where on the left we have the set of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
              %a.existingWikiWord{:href => "/nlab/show/dgAlg"} dgAlg
              as indicated, with the vertical morphisms being the canonical projections.
          .num_prop
            %h6#observation_6 Observation
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                    %mo =
                    %msup
                      %mi b
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g} = b^{n-1}\mathbb{R}
              the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/line+Lie+n-algebra"} line Lie n-algebra
              = succeed "." do
                %a{:href => "#DiffSmpForLineLienAlgebra"} previous definition
          .num_prop
            %h6#proposition_38 Proposition
            %p The canonical projection
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi diff
                    %mo →
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\exp(\mathfrak{g})_{diff} \to \exp(\mathfrak{g})
            %p
              is an acyclic fibration in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msubsup
                        %mi CartSp
                        %mi smooth
                        %mi op
                      %mo ,
                      %mi sSet
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi proj
                    %annotation{:encoding => "application/x-tex"} [CartSp_{smooth}^{op}, sSet]_{proj}
            %p
              Moreover, for every
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %mi 𝔤
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi diff
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi exp
                                %mo{:stretchy => "false"} (
                                %mi μ
                                %msub
                                  %mo{:stretchy => "false"} )
                                  %mi diff
                          %mtd
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi b
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mi ℝ
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi diff
                          %mtd
                            %mo =
                          %mtd
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mi n
                            %msub
                              %mi ℝ
                              %mrow
                                %mi diff
                                %mo ,
                                %mi smp
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ≃
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ≃
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ≃
                        %mtr
                          %mtd
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %mi 𝔤
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi exp
                                %mo{:stretchy => "false"} (
                                %mi μ
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi b
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mi ℝ
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                          %mtd
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mi n
                            %msub
                              %mi ℝ
                              %mi smp
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\exp(\mathfrak{g})_{diff}
                    \&amp;\stackrel{\exp(\mu)_{diff}}{\to}&amp;
                    \\exp(b^{n-1}\mathbb{R})_{diff} &amp;=&amp;
                    \\mathbf{B}^n \mathbb{R}_{diff,smp}
                    \\\
                    \\downarrow^{\mathrlap{\simeq}} &amp;&amp; \downarrow^{\mathrlap{\simeq}} &amp;&amp; \downarrow^{\mathrlap{\simeq}}
                    \\\
                    \\exp(\mathfrak{g})
                    \&amp;\stackrel{\exp(\mu)}{\to}&amp;
                    \\exp(b^{n-1}\mathbb{R})
                    \&amp;=&amp;
                    \\mathbf{B}^n \mathbb{R}_{smp}
                    }
            %p
              for some morphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mi μ
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi diff
                    %annotation{:encoding => "application/x-tex"} exp(\mu)_{diff}
          .proof
            %h6#proof_40 Proof
            %p
              Both claims follow from the
              %a.existingWikiWord{:href => "/nlab/show/free+functor"} free property
              of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Weil+algebra"} Weil algebra
            %p
              For the first, we need to show that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} U \in
              %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              we have lifts in all diagrams of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo ∂
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mi k
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mo →
                          %mtd
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %mi 𝔤
                            %msub
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi diff
                                %mo ,
                                %mi smp
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mi k
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mo →
                          %mtd
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %mi 𝔤
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\partial \Delta[k] &amp;\to&amp; \exp(\mathfrak{g})_{diff,smp}(U)
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    \\Delta[k] &amp;\to&amp; \exp(\mathfrak{g})(U)
                    }
                    \\,.
            %p
              The bottom morphism is a collection of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/differential+form"} differential form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ×
                    %msup
                      %mi Δ
                      %mi k
                  %annotation{:encoding => "application/x-tex"} U \times \Delta^k
              (with sitting instants), satisfying a flatness condition for their
              = succeed "-differentials." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mrow
                          %msup
                            %mi Δ
                            %mi k
                    %annotation{:encoding => "application/x-tex"} d_{\Delta^k}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ×
                    %mo ∂
                    %msup
                      %mi Δ
                      %mi k
                  %annotation{:encoding => "application/x-tex"} U \times \partial \Delta^k
              with no flatness constraint except that those with no component along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              coincide with the restriction of those of the bottom morphism to the boundary
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∂
                      %msup
                        %mi Δ
                        %mi k
                    %annotation{:encoding => "application/x-tex"} \partial \Delta^k
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
            %p
              For the second claim, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi μ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(CE(\mu))
              be the underlying morphism on chain complexes of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi μ
                    %annotation{:encoding => "application/x-tex"} \mu
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi μ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi W
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi b
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F U (CE(\mu)) : W(b^{n-1}) \to W(\mathfrak{g})
              fitting into the
              %a.existingWikiWord{:href => "/nlab/show/commutative+diagram"} commutative diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi CE
                            %mo{:stretchy => "false"} (
                            %mi 𝔤
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ←
                              %mrow
                                %mi CE
                                %mo{:stretchy => "false"} (
                                %mi μ
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi CE
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi b
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mi ℝ
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↑
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↑
                        %mtr
                          %mtd
                            %mi W
                            %mo{:stretchy => "false"} (
                            %mi 𝔤
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ←
                              %mrow
                          %mtd
                            %mi W
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi b
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mi ℝ
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    CE(\mathfrak{g}) &amp;\stackrel{CE(\mu)}{\leftarrow}&amp; CE(b^{n-1}\mathbb{R})
                    \\\
                    \\uparrow &amp;&amp; \uparrow
                    \\\
                    W(\mathfrak{g})
                    \&amp;\stackrel{}{\leftarrow}&amp;
                    W(b^{n-1}\mathbb{R})
                    }
                    \\,.
            %p
              %a.existingWikiWord{:href => "/nlab/show/pasting"}> Pasting
              \-precomposition with this diagram yields a morhism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi μ
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi diff
                  %annotation{:encoding => "application/x-tex"} \exp(\mu)_{diff}
              as desired.
          .num_defn
            %h6#definition_20 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ∈
                    %mi Smooth
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} G \in Smooth \infty Grpd
              be an
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} n-group
              given by
              %a{:href => "#LieIntegration"} Lie integration
              of an
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra"} L-∞ algebra
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G
              is presented by the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n+1)
              %a.existingWikiWord{:href => "/nlab/show/simplicial+skeleton"} coskeleton
              %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaf"} simplicial presheaf
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi cosk
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mi 𝔤
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{cosk}_{n+1}\exp(\mathfrak{g})
            %p
              Then for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi CartSp
                      %mi smooth
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                  %annotation{:encoding => "application/x-tex"} X \in [CartSp_{smooth}, sSet]_{proj}
              any object and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat X
              a cofibrant resolution, we say that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi CartSp
                      %mi smooth
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
                    %mo ,
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi cosk
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi diff
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    [CartSp_{smooth}^{op},sSet](\hat X, \mathbf{cosk}_{n+1}\exp(\mathfrak{g})_{diff})
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
              of
              %strong
                %a.existingWikiWord{:href => "/nlab/show/connection+on+an+%E2%88%9E-bundle"} pseudo n-connections
              on
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
          %h4#connections
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} \infty
            \-Connections
          %p
            We discuss presentations in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msubsup
                    %mi CartSp
                    %mi smooth
                    %mi op
                  %mo ,
                  %mi sSet
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [CartSp_{smooth}^{op}, sSet]
            of the the
            %a{:href => "http://ncatlab.org/nlab/show/cohesive+(infinity%2C1)-topos#ChernWeilTheory"} intrinsic notion of ∞-connections
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Smooth
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} Smooth \infty Grpd
          %p
            Let still
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                  %msub
                    %mo ∈
                    %mn ∞
                  %mover
                    %mo ↪
                    %mrow
                      %mi CE
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                  %msup
                    %mi dgAlg
                    %mi op
                %annotation{:encoding => "application/x-tex"} \mathfrak{g} \in _\infty \stackrel{CE(-)}{\hookrightarrow} dgAlg^{op}
            be an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra"} L-∞ algebra
          .num_defn
            %h6#definition_21 Definition
            %p
              An
              %strong
                %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              is an element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                    %mo ∈
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \langle - \rangle \in W(\mathfrak{g})
              such that both
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                    %mo ∈
                    %msup
                      %mo ∧
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \langle - \rangle \in \wedge^\bullet
              as well as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mrow
                        %mi W
                        %mo{:stretchy => "false"} (
                        %mi 𝔤
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} d_{W(\mathfrak{g})}\; \langle - \rangle
              are elements in the graded subalgebra generated by the shifted generators
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝔤
                        %mo *
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo ↪
                      %mi W
                      %mo{:stretchy => "false"} (
                      %mi 𝔤
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}^*[1] \hookrightarrow W(\mathfrak{g})
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi inv
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} inv(\mathfrak{g}) \hookrightarrow W(\mathfrak{g})
              for the sub-dg-algebra of invariant polynomials.
          .num_prop
            %h6#observation_7 Observation
            %p
              For the
              %a.existingWikiWord{:href => "/nlab/show/line+Lie+n-algebra"} line Lie n-algebra
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} inv
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi b
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi b
                      %mi n
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathrm{inv}(b^{n-1}\mathbb{R}) \simeq CE(b^n \mathbb{R})
                    \\,.
            %p
              This allows us to identify an invariant polynomial
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle - \rangle
              of degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n+1
              with a morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi inv
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ←
                      %mrow
                        %mo{:stretchy => "false"} ⟨
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} ⟩
                    %mi inv
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi b
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    inv(\mathfrak{g}) \stackrel{\langle - \rangle}{\leftarrow}
                    inv(b^{n-1}\mathbb{R})
            %p
              in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/dgAlg"} dgAlg
          .num_defn
            %h6#definition_22 Definition
            %p
              We say an invariant polynomial
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle - \rangle
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              is
              %strong in transgression
              with an
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebra+cohomology"} L-∞ algebra cocycle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo :
                    %mi 𝔤
                    %mo →
                    %msup
                      %mi b
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mu : \mathfrak{g} \to b^{n-1} \mathbb{R}
              if there is a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi cs
                    %mo :
                    %mi W
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi b
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} cs : W(b^{n-1}\mathbb{R}) \to W(\mathfrak{g})
              such that we have a
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi CE
                            %mo{:stretchy => "false"} (
                            %mi 𝔤
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ←
                              %mi μ
                          %mtd
                            %mi CE
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi b
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mi ℝ
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↑
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↑
                        %mtr
                          %mtd
                            %mi W
                            %mo{:stretchy => "false"} (
                            %mi 𝔤
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ←
                              %mi cs
                          %mtd
                            %mi W
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi b
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mi ℝ
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↑
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↑
                        %mtr
                          %mtd
                            %mi inv
                            %mo{:stretchy => "false"} (
                            %mi 𝔤
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ←
                              %mrow
                                %mo{:stretchy => "false"} ⟨
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo{:stretchy => "false"} ⟩
                          %mtd
                            %mi inv
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi b
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mi ℝ
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mi CE
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi b
                              %mi n
                            %mi ℝ
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    CE(\mathfrak{g}) &amp;\stackrel{\mu}{\leftarrow}&amp;
                    CE(b^{n-1}\mathbb{R})
                    \\\
                    \\uparrow &amp;&amp; \uparrow
                    \\\
                    W(\mathfrak{g}) &amp;\stackrel{cs}{\leftarrow}&amp;
                    W(b^{n-1}\mathbb{R})
                    \\\
                    \\uparrow &amp;&amp; \uparrow
                    \\\
                    inv(\mathfrak{g}) &amp;\stackrel{\langle- \rangle}{\leftarrow}&amp;
                    inv(b^{n-1}\mathbb{R}) &amp; = CE(b^n \mathbb{R})
                    }
                    \\,.
            %p
              We say that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi cs
                  %annotation{:encoding => "application/x-tex"} cs
              is a
              %strong
                %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+element"} Chern-Simons element
              exhibiting the transgression between
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ⟩
                    %annotation{:encoding => "application/x-tex"} \langle - \rangle
            %p
              We say that an
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
              %strong transgressive
              if it is in transgression with some invariant polynomial.
          .num_prop
            %h6#observation_8 Observation
            %p We have
            %ol
              %li
                %p There is a transgressive cocycle for every invariant polynomial.
              %li
                %p
                  Any two
                  = succeed "-algebra" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi L
                            %mn ∞
                        %annotation{:encoding => "application/x-tex"} L_\infty
              %li
                %p Every decomposable invariant polynomial (the wedge product of two non-vanishing invariant polynomials) transgresses to a cocycle cohomologous to 0.
          .proof
            %h6#proof_41 Proof
            %ol
              %li
                By the fact that the
                %a.existingWikiWord{:href => "/nlab/show/Weil+algebra"} Weil algebra
                is free, its
            %p
              %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cochain cohomology
              vanishes and hence the definition
            %p
              property
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mrow
                        %mi W
                        %mo{:stretchy => "false"} (
                        %mi 𝔤
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} d_{W(\mathfrak{g})} \langle -\rangle = 0
              implies that there is some element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi cs
                    %mo ∈
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} cs \in W(\mathfrak{g})
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mrow
                          %mi W
                          %mo{:stretchy => "false"} (
                          %mi 𝔤
                          %mo{:stretchy => "false"} )
                      %mi cs
                      %mo =
                      %mo{:stretchy => "false"} ⟨
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ⟩
                    %annotation{:encoding => "application/x-tex"} d_{W(\mathfrak{g})} cs = \langle - \rangle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi cs
                  %annotation{:encoding => "application/x-tex"} cs
              along the canonical dg-algebra homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} W(\mathfrak{g}) \to CE(\mathfrak{g})
              is
              = succeed "-closed" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mrow
                          %mi CE
                          %mo{:stretchy => "false"} (
                          %mi 𝔤
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} d_{CE(\mathfrak{g})}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ⟩
                    %annotation{:encoding => "application/x-tex"} \langle - \rangle
            %ol
              %li
                %p
                  Let
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi cs
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} cs_1
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi cs
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} cs_2
                  be Chern-Simons elements for the to given
                  = succeed "-algebra" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi L
                            %mn ∞
                        %annotation{:encoding => "application/x-tex"} L_\infty
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi d
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mi 𝔤
                              %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi cs
                            %mn 1
                          %mo −
                          %msub
                            %mi cs
                            %mn 2
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} d_{(\mathfrak{g})} (cs_1 - cs_2) = 0
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi W
                        %mo{:stretchy => "false"} (
                        %mi 𝔤
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} W(\mathfrak{g})
                  there is then
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi λ
                        %mo ∈
                        %mi W
                        %mo{:stretchy => "false"} (
                        %mi 𝔤
