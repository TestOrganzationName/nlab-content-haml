                  %mrow
                    %mi X
                    %mo ∈
                    %mi Smooth
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} X \in Smooth\infty Grpd
              is presented by
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mo •
                      %mo ∈
                      %msup
                        %mi SmoothMfd
                        %mrow
                          %msup
                            %mi Δ
                            %mi op
                      %mo ↪
                      %mo{:stretchy => "false"} [
                      %msubsup
                        %mi CartSp
                        %mi smooth
                        %mi op
                      %mo ,
                      %mi sSet
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} X_\bullet \in SmoothMfd^{\Delta^{op}} \hookrightarrow [CartSp_{smooth}^{op}, sSet]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mo !
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} i_!(X) \in
              %a.existingWikiWord{:href => "/nlab/show/ETop%E2%88%9EGrpd"} ETop∞Grpd
              under the
              %a{:href => "#RelativeTopologicalCohesion"} relative topological cohesion morphism
              is presented by the underlying
              %a.existingWikiWord{:href => "/nlab/show/simplicial+topological+space"} simplicial topological space
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
