                            %mo →
                            %mrow
                              %msub
                                %mi curv
                                %mi smp
                        %mtd
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mo ♭
                            %mi dR
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mrow
                              %mi n
                              %mo +
                              %mn 1
                          %msub
                            %mi ℝ
                            %mi smp
                      %mtr
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mo ≃
                      %mtr
                        %mtd
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi n
                          %msub
                            %mi ℝ
                            %mi smp
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\mathbf{B}^n \mathbb{R}_{diff,smp}
                  \&amp;\stackrel{curv_{smp}}{\to}&amp;
                  \\mathbf{\flat}_{dR}\mathbf{B}^{n+1} \mathbb{R}_{smp}
                  \\\
                  \\downarrow^{\mathrlap{\simeq}}
                  \\\
                  \\mathbf{B}^n \mathbb{R}_{smp}
                  }
          %p
            in the
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi CartSp
                      %mi smooth
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                  %annotation{:encoding => "application/x-tex"} [CartSp_{smooth}^{op}, sSet]_{proj}
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/differential+form"} differential form
          %p
            We now insert this in the above general abstract definition of the
            = succeed "-Chern-Weil" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
