                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    sPSh(K_\bullet, \Xi A[n])
                    \&amp; \simeq
                    \\int_U sSet(K_\bullet(U) , U \Xi A(U)[n])
                    \\\
                    \&amp; \simeq \int_U sAb(\mathbb{Z} K_\bullet(U), \Xi A(U)[n])
                    \\\
                    \&amp;\simeq \int_U Ch_\bullet( C_\bullet(\mathbb{Z} K_\bullet(U)), A(U)\otimes_{\mathbb{Z}}\mathbb{Z}[n] )
                    \\\
                    \&amp; \simeq \int_U Ch^\bullet( \mathbb{Z}[n], C^\bullet (Set(K_\bullet(U),A(U))))
                    \\\
                    \&amp; \simeq Ch^\bullet (\mathbb{Z}[n],
                    \\int_U C^\bullet(Set(K_\bullet(U),A(U)))
                    \\\
                    \&amp; \simeq Ch^\bullet(\mathbb{Z}[n], C^\bullet( PSh(K_\bullet, A) )
                    \\end{aligned}
                    \\,.
            %p
              Setting here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mo •
                    %mo =
                    %msup
                      %mo ∫
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi k
                        %mo{:stretchy => "false"} ]
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi k
                    %mo{:stretchy => "false"} ]
                    %mo ⋅
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msubsup
                      %mi U
                      %mi i
                      %mi k
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K_\bullet = \int^{[k]} \Delta[k] \cdot C(\{U^k_i\})
              and using the
              %a.existingWikiWord{:href => "/nlab/show/Eilenberg-Zilber+theorem"} Eilenberg-Zilber theorem
              to identify the
              %a.existingWikiWord{:href => "/nlab/show/Moore+complex"} Moore complex
              of the
              %a.existingWikiWord{:href => "/nlab/show/bisimplicial+set"} diagonal
              to the
              %a.existingWikiWord{:href => "/nlab/show/total+complex"} total complex
              of the double complex of Moore complexes, the claim follows.
          .num_prop
            %h6#proposition_10 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              a
              %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              either
            %ol
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
              %li
                %p
                  the additive Lie group of
                  %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℝ
                        %annotation{:encoding => "application/x-tex"} \mathbb{R}
            %p
              the intrinsic cohomology of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Smooth
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} Smooth\infty Grpd
              coincides with the refined
              %a.existingWikiWord{:href => "/nlab/show/Lie+group+cohomology"} Lie group cohomology
              of (
              %a{:href => "#Segal"}> Segal
              \/
              %a{:href => "#Brylinski"}> Brylinski
              )
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mrow
                        %mi Smooth
                        %mn ∞
                        %mi Grpd
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msubsup
                      %mi H
                      %mi Segal
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^n_{Smooth\infty Grpd}(\mathbf{B}G, A) \simeq H^n_{Segal}(G,A)
                    \\,.
            %p In particular we have in general
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mrow
                        %mi Smooth
                        %mn ∞
                        %mi Grpd
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msubsup
                      %mi H
                      %mi top
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi G
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    H^n_{Smooth\infty Grpd}(\mathbf{B}G, \mathbb{Z})
                    \\simeq
                    H^{n}_{top}(B G, \mathbb{Z})
            %p
              and for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
              also
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mrow
                        %mi Smooth
                        %mn ∞
                        %mi Grpd
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo ,
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msubsup
                      %mi H
                      %mi top
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi G
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^n_{Smooth\infty Grpd}(\mathbf{B}G, U(1))
                    \\simeq
                    H^{n+1}_{top}(B G, \mathbb{Z})
                    \\,.
          .proof
            %h6#proof_11 Proof
            %p
              The first statement is a special case of the
              %a{:href => "#CohomologyWithConstantCoefficients"} above proposition
              about cohomology with constant coefficients.
            %p
              The second statement is a special case of the more general statement that is proven at
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/SynthDiff%E2%88%9EGrpd"} SynthDiff∞Grpd
            %p
              The last statement follows then from the observation (
              %a{:href => "#Brylinski"}> Brylinski
              ) that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mi diffr
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msubsup
                      %mi H
                      %mi naive
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^n_{diffr}(G,\mathbb{R}) \simeq H^n_{naive}(G,\mathbb{R})
              and the classical result (
              %a{:href => "#Blanc"}> Blanc
              ) that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mi naive
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} H_{naive}^n(G,\mathbb{R}) = 0
              in positive degree, and using the
              %a.existingWikiWord{:href => "/nlab/show/fiber+sequence"} fiber sequence
              induced from the
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
              of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo →
                      %mi ℝ
                      %mo →
                      %mi ℝ
                      %mo{:stretchy => "false"} /
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z} \to \mathbb{R} \to \mathbb{R}/\mathbb{Z}
          %h4#SmoothPrincipal1And2Bundles Smooth principal 1-bundles and 2-bundles
          .num_prop
            %h6#proposition_11 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              be a
              %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo :
                    %mo =
                    %mn ∞
                    %mi LieGrpd
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G \in \mathbf{H} := \infty LieGrpd
              its
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              as discussed
              = succeed "." do
                %a{:href => "LieGroups"} above
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/paracompact+space"} paracompact
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi G
                    %mi Bund
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{H}(X,\mathbf{B}G)
                    \\simeq
                    G Bund(X)
                    \\,.
            %p
              is equivalent to the groupoid of smooth
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mi Smooth
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi π
                      %mn 0
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    H^1_{Smooth}(X,G) \simeq \pi_0 \mathbf{H}(X,\mathbf{B}G)
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/nonabelian+cohomology"} nonabelian
              smooth
              %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech cohomology
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with coefficients in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
            %p
              Analogously, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              be a strict
              %a.existingWikiWord{:href => "/nlab/show/Lie+2-group"} Lie 2-group
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \pi_0 G
              is a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mn 0
                    %mo →
                    %msub
                      %mi π
                      %mn 0
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G_0 \to \pi_0 G
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/submersion"} submersion
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi G
                    %mi Bund
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{H}(X, \mathbf{B}G) \simeq G Bund(X)
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/2-groupoid"} 2-groupoid
              of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/principal+2-bundle"} principal 2-bundle
              %a.existingWikiWord{:href => "/nlab/show/nonabelian+cohomology"} nonabelian
              %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech cohomology
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi H
                        %mi Smooth
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi G
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} H^1_{Smooth}(X,G)
          .proof
            %h6#proof_12 Proof
            %p The first case is a special case of the second, it is sufficient to consider that.
            %p
              First we argue that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G
              is fibrant in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi CartSp
                        %mi op
                      %mo ,
                      %mi sSet
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mrow
                          %mi proj
                          %mo ,
                          %mi loc
                    %annotation{:encoding => "application/x-tex"} [CartSp^{op}, sSet]_{proj, loc}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U_i \to \mathbb{R}^n\}
              an
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              we have a weak equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo ,
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≃
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{B}C^\infty(\mathbb{R}^n, G)
                    \\stackrel{\simeq}{\to}
                    [CartSp^{op}, sSet](C(U), \mathbf{B}G)
                    \\,,
            %p
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(U)
              the
              %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
              of the good cover. Since the
              %a.existingWikiWord{:href => "/nlab/show/site"} site
              %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              with good open cover coverage is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Verdier+site"} Verdier site
              %em
                %a.existingWikiWord{:href => "/nlab/show/hypercover"} hypercover
              that every hypercover has a refinement by a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/split+hypercover"} split hypercover
              %a.existingWikiWord{:href => "/nlab/show/resolution"} resolution
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi CartSp
                        %mi op
                      %mo ,
                      %mi sSet
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mrow
                          %mi proj
                          %mo ,
                          %mi loc
                    %annotation{:encoding => "application/x-tex"} [CartSp^{op}, sSet]_{proj,loc}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} C(U) \to X
              is a cofibrant resolution. Hence by the existence of the global model structure and using that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G
              is fibrant in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi CartSp
                        %mi op
                      %mo ,
                      %mi sSet
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi proj
                    %annotation{:encoding => "application/x-tex"} [CartSp^{op}, sSet]_{proj}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi H
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo ,
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_0[CartSp^{op}, sSet](C(U), \mathbf{B}G)
                    \\simeq
                    H^1(\mathbb{R}^n, G)
            %p
              is nonabelian degree 1
              %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech cohomology
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              with coefficients in the 2-group
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed ")" do
                %a{:href => "#NikolausWaldorf"} NikolausWaldorf, prop. 4.1
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              %a.existingWikiWord{:href => "/nlab/show/descent"} descent
              morphism in quesion is an isomorphism on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} \pi_0
            %p
              Next,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \pi_1
              on the right is similarly the set of equivalence classes of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi G
                        %mn 0
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi G
                        %mn 0
                      %mo ⋉
                      %msub
                        %mi G
                        %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} G_0//(G_0 \ltimes G_1)
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/groupoid+principal+bundle"} groupoid principal bundle
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi G
                        %mn 0
                      %mo ×
                      %msub
                        %mi G
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} G_0 \times G_1
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
              on the contractible
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              is trivializable, hence
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi CartSp
                        %mi op
                      %mo ,
                      %mi sSet
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi g
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo ,
                      %msub
                        %mi G
                        %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi_1([CartSp^{op}, sSet](C(U), \mathbf{B}^g)) \simeq C^\infty(\mathbb{R}^n , G_0)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \pi_1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \pi_2
              is clear.
            %p
              Now for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              an arbitrary paracompact
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U \to X
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} C(U) \to X
              is a cofibrant resolution in the local model structure, hence hence by the above it follows that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Smooth
                    %mn ∞
                    %mi Grpd
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Smooth \infty Grpd(X, \mathbf{B}G)
                    \\simeq
                    [CartSp^{op}, sSet](C(U), \mathbf{B}G)
                    \\,.
            %p
              By the same argument about
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/hypercover"} hypercover
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/Verdier+site"} Verdier site
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mi Smooth
                    %mn ∞
                    %mi Grpd
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msubsup
                      %mi H
                      %mi Smooth
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_0 Smooth \infty Grpd(X, \mathbf{B}G)
                    \\simeq
                    H^1_{Smooth}(X, G)
                    \\,.
          %h3#StrucTwistedCohomology Twisted cohomology
          %p
            We discuss implementation in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Smooth
                  %mn ∞
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"} Smooth \infty Grpd
            of the notion of
            = succeed "." do
              %a{:href => "http://nlab.mathforge.org/nlab/show/cohesive+%28infinity%2C1%29-topos#TwistedCohomology"} twisted cohomology in a cohesive (∞,1)-topos
          %ul
            %li
              %p
                See
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/twisted+bundle"} twisted bundle
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/twisted+K-theory"} twisted K-theory
            %li
              %p
                The definition of differential cohomology
                %a{:href => "#StrucDifferentialCohomology"} below
                is an instance of twisted cohomology, with the twist being given by
                = succeed "s." do
                  %a.existingWikiWord{:href => "/nlab/show/curvature+characteristic+form"} curvature characteristic form
          %h3#StrucConcordance Concordance
          %p (…)
          %h3#StrucVanKampen van Kampen theorem
          %p (…)
          %h3#StrucPaths Paths and geometric Postnikov towers
          %p (…)
          %h3#StrucWhitehead Universal coverings and geometric Whitehead towers
          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological group
            and form the
            %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℬ
                  %mi G
                  %mo ∈
                %annotation{:encoding => "application/x-tex"} \mathcal{B}G \in
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≃
                %annotation{:encoding => "application/x-tex"} \simeq
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            %a.existingWikiWord{:href => "/nlab/show/Lie+groupoid"} Lie groupoid
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo ∈
                    %mn ∞
                    %mi LieGrpd
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G \in \infty LieGrpd
            %a{:href => "#LieGroups"} section on Lie groups
            above. By the discussion in the
            %a{:href => "#GeometricRealization"} section on geometric realization
            we have that under the canonical geometric realization functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                  %mo :
                  %mn ∞
                  %mi LieGrpd
                  %mo →
                  %mn ∞
                  %mi Grpd
                  %mo ≃
                  %mi Top
                %annotation{:encoding => "application/x-tex"}
                  \\Pi : \infty LieGrpd \to \infty Grpd \simeq Top
          %p we have
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℬ
                  %mi G
                  %mo ≃
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{B}G \simeq \Pi(\mathbf{B}G)
                  \\,.
          %p
            Analogous statements hold for
            = succeed "-Lie" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a{:href => "#BnU1"} circle n-groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{B}^n U(1)
            maps to the
            %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+space"} Eilenberg-MacLane space
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi ℤ
                  %mo ,
                  %mi n
                  %mo +
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\Pi(\mathbf{B}^n U(1)) \simeq K(\mathbb{Z}, n+1)
                  \\,.
          %p
            This means that given a
            %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo :
                  %mi ℬ
                  %mi G
                  %mo →
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi ℤ
                  %mo ,
                  %mi n
                  %mo +
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  c : \mathcal{B}G \to K(\mathbb{Z},n+1)
          %p
            in
            %a.existingWikiWord{:href => "/nlab/show/integral+cohomology"} integral cohomology
            (defining a
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/characteristic+class"} characteristic class
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                %annotation{:encoding => "application/x-tex"} \Pi
            to a morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi c
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{c} : \mathbf{B}G \to \mathbf{B}^n U(1)
                  \\,.
          %p
            Classes of examples of such lifts have been described in the section on
            = succeed "." do
              %a{:href => "#IntegrationOfCocycles"} integration of ∞-Lie algebra cocycles
          %p
            By general reasoning, the extensions/
            %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"}> principal ∞-bundle
            s classified by such cocycles are their
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mover
                            %mi G
                            %mo{:stretchy => "false"} ^
                        %mtd
                          %mo →
                        %mtd
                          %mo *
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                        %mtd
                          %mover
                            %mo →
                            %mstyle{:mathvariant => "bold"}
                              %mi c
                        %mtd
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi n
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\mathbf{B}\hat G &amp;\to&amp; *
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  \\mathbf{B}G &amp;\stackrel{\mathbf{c}}{\to}&amp; \mathbf{B}^n U(1)
                  }
          %p
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn ∞
                  %mi LieGrpd
                %annotation{:encoding => "application/x-tex"} \infty LieGrpd
            and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi ℬ
                          %mover
                            %mi G
                            %mo{:stretchy => "false"} ^
                        %mtd
                          %mo →
                        %mtd
                          %mo *
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi ℬ
                          %mi G
                        %mtd
                          %mover
                            %mo →
                            %mi c
                        %mtd
                          %mi K
                          %mo{:stretchy => "false"} (
                          %mi ℤ
                          %mo ,
                          %mi n
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\mathcal{B}\hat G &amp;\to&amp; *
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  \\mathcal{B}G &amp;\stackrel{c}{\to}&amp; K(\mathbb{Z}, n)
                  }
          %p
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Top
                    %mo ≃
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} Top \simeq \infty Grpd
            %a{:href => "#GeometricRealization"} Geometric realization
            we have that these two homotopy fibers correspond to each other under
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo :
                    %mn ∞
                    %mi LieGrpd
                    %mo →
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} \Pi : \infty LieGrpd \to \infty Grpd
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mover
                    %mi G
                    %mo{:stretchy => "false"} ^
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi ℬ
                  %mover
                    %mi G
                    %mo{:stretchy => "false"} ^
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\Pi(\mathbf{B}\hat G) \simeq \mathcal{B}\hat G
                  \\,.
          %p
            So this means with a smooth lift of a cocycle, we automatically obtain the corresponding smooth lift of the extension that it classifies (assuming that the simplicial topological group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is well-sectioned). This is notably useful for finding smooth lifts of
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/Whitehead+tower"} Whitehead tower
          %h4#the_smooth_whitehead_tower_of_the_orthogonal_group The smooth Whitehead tower of the orthogonal group
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi O
                %annotation{:encoding => "application/x-tex"} O
            denote the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/orthogonal+group"} orthogonal group
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            %a.existingWikiWord{:href => "/nlab/show/Whitehead+tower"} Whitehead tower
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi O
                %annotation{:encoding => "application/x-tex"} O
            refined to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                    %mi LieGrpd
                  %annotation{:encoding => "application/x-tex"} \infty LieGrpd
          %h5#first_stiefelwhitney_class First Stiefel-Whitney class
          .num_prop
            %h6#proposition_12 Proposition
            %p
              A lift of the first
              %a.existingWikiWord{:href => "/nlab/show/Stiefel-Whitney+class"} Stiefel-Whitney class
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi w
                      %mn 1
                    %mo :
                    %mi ℬ
                    %mi O
                    %mo →
                    %mi K
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ℤ
                      %mn 2
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi Top
                    %mo ≃
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} w_1 : \mathcal{B}O \to K(\mathbb{Z}_2 ,1) \in Top \simeq \infty Grpd
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                    %mi LieGrpd
                  %annotation{:encoding => "application/x-tex"} \infty LieGrpd
              is given by the morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi w
                      %mn 1
                    %mo :
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi O
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi ℤ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{w}_1 : \mathbf{B}O \to \mathbf{B}\mathbb{Z}_2
            %p
              of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/Lie+groupoid"} Lie groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ∈
                    %mi O
                  %annotation{:encoding => "application/x-tex"} g \in O
              to its signature
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %msub
                        %mi ℤ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \sigma(g) \in \mathbb{Z}_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \sigma(g) = 1
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              is in the connected component of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                  %annotation{:encoding => "application/x-tex"} O
              (is orientation preserving as an orthogonal map) and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \sigma(g) = -1
              otherwise.
          %p
            We may compute the
            %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn ∞
                  %mi LieGrpd
                %annotation{:encoding => "application/x-tex"} \infty LieGrpd
            classified by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi w
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \mathbf{w}_1
            as the ordinry
            %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi E
                    %msub
                      %mi ℤ
                      %mn 2
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi ℤ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbf{E} \mathbb{Z}_2 \to \mathbf{B}\mathbb{Z}_2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi E
                  %msub
                    %mi ℤ
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \mathbf{E}\mathbb{Z}_2
            is the groupoid
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℤ
                      %mn 2
                    %mo ×
                    %msub
                      %mi ℤ
                      %mn 2
                    %mover
                      %mrow
                        %munder
                          %mo →
                          %mrow
                            %msub
                              %mi p
                              %mn 1
                        %msub
                          %mi ℤ
                          %mn 2
                      %mrow
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} ovserset
                        %mo ⋅
                        %mo →
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2 \times \mathbb{Z}_2 \stackrel{\ovserset{\cdot}{\to}}{\underset{p_1}{\to} \mathbb{Z}_2}
          %p The resulting pullback groupoid
          .maruku-equation
