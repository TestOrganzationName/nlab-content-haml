                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimit"} (∞,1)-colimit
          .num_prop
            %h6#corollary Corollary
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi Smooth
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} X \in Smooth\infty Grpd
              is presented by
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mo •
                      %mo ∈
                      %msup
                        %mi SmoothMfd
                        %mrow
                          %msup
                            %mi Δ
                            %mi op
                      %mo ↪
                      %mo{:stretchy => "false"} [
                      %msubsup
                        %mi CartSp
                        %mi smooth
                        %mi op
                      %mo ,
                      %mi sSet
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} X_\bullet \in SmoothMfd^{\Delta^{op}} \hookrightarrow [CartSp_{smooth}^{op}, sSet]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              under the
              = succeed "-functor" do
                %a.existingWikiWord{:href => "/nlab/show/fundamental+%E2%88%9E-groupoid+in+a+locally+%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} fundamental ∞-groupoid in a locally ∞-connected (∞,1)-topos
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Smooth
                    %mn ∞
                    %mi Grpd
                    %mover
                      %mo →
                      %mi Π
                    %mn ∞
                    %mi Grpd
                    %munderover
                      %mo →
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mo −
                        %mo{:stretchy => "false"} |
                      %mo ≃
