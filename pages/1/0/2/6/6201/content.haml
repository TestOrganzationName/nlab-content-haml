                              %mi θ
                      %mo }
                    %mo ≃
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    U \mapsto
                    \\left\{
                    \\array{
                    A_0 = 0
                    \\\
                    \\downarrow^{\mathrlap{g}}
                    \\\
                    g^* \theta
                    }
                    \\right\}
                    \\simeq
                    C^\infty(U,G)
                    \= G(U)
                    \\,,
            %p equipped with the projection
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi t
                      %mi U
                    %mo :
                    %mi G
                    %mo →
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mo ♭
                      %mi dR
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi G
                      %mi c
                  %annotation{:encoding => "application/x-tex"}
                    t_U :  G \to \mathbf{\flat}_{dR} \mathbf{B}G_c
            %p given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi t
                      %mi U
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo :
                    %mi U
                    %mo →
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %msup
