                            %mo{:stretchy => "false"} ]
                            %mo ×
                            %msup
                              %mi Δ
                              %mi n
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi id
                                %mo ×
                                %msub
                                  %mi η
                                  %mi n
                          %mtd
