                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    a'_{i j}
                    \&amp; = A'_j - A'_i - d g_{i j}
                    \\\
                    \&amp; = a_{i j} +
                    \- \sum_{i_0}( a_{i_0 i} - a_{i_0 j} )
                    \\\
                    \&amp; = 0
                    \\end{aligned}
                    \\,.
          %p So in total we have found the following story:
          %ol
            %li
              %p
                In order to compute the curvature characteristic form of a
                %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech cohomology
                cocycle
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo :
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi U
                        %mi i
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} g : C(\{U_i\}) \to \mathbf{B}U(1)
                of a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/principal+U%281%29-bundle"} principal U(1)-bundle
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %msub
                                %mstyle{:mathvariant => "bold"}
                                  %mi B
                                %mi diff
                              %mi U
                              %mo{:stretchy => "false"} (
                              %mn 1
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %mi g
                                    %mo ,
                                    %mo ∇
                                    %mo{:stretchy => "false"} )
                              %mo ↗
