                    \\overset{Ad_{p_1}(p_2)+ p_1^{-1} d p_1}{\to}}{\underset{p_2}{\to}} \Omega^1_{flat}(-,\mathfrak{g})
                    \\right)
            %p
              and this is such that the canonical morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mo ♭
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{\flat} \mathbf{B}G \to \mathbf{B}G
              is presented by the canonical morphism of simplicial presheaves
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mo ♭
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi G
                      %mi c
