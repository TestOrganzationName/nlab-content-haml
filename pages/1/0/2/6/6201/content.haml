                        %mi A
                      %mo →
                      %msub
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} tra
                        %mrow
                          %mi A
                          %mo ′
                    %annotation{:encoding => "application/x-tex"} (\lambda,\alpha) : tra_A \to \tra_{A'}
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
