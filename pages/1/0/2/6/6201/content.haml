            %p Form the defining pullback as before. (…)
          %h3#StrucLieAlg
            Exponentiated
            = succeed "-Lie" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
