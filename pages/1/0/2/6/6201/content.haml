          %h4#cohomology_with_constant_coefficients_2 Cohomology with constant coefficients
          #FlatCohomologyAndWithConstantCoefficients.num_theorem
            %h6#theorem Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/paracompact+space"} paracompact
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              regarded as a
              %a.existingWikiWord{:href => "/nlab/show/0-truncated"} 0-truncated
              smooth
              = succeed "-groupoid" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
