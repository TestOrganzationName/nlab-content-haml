                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %mi Smooth
                              %mn ∞
                              %mi Grpd
                              %mo{:stretchy => "false"} (
                              %mi X
                              %mo ,
                              %mi A
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mover
                                %mo →
                                %mrow
                                  %msub
                                    %mstyle{:mathvariant => "bold"}
                                      %mi c
                                    %mi dR
                            %mtd
                              %mi Smooth
                              %mn ∞
                              %mi Grpd
                              %mo{:stretchy => "false"} (
                              %mi X
                              %mo ,
