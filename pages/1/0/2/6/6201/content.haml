                        %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (a_{i j})
          .proof
            %h6#proof_36 Proof
            %p
              The first statements are effectively the definition and the construction of the above models. The last statement is as in the
              %a{:href => "#OrdinaryDeRham"} above discussion
              of our model for ordinary de Rham cohomology: given a cocycle with non-vanishing closed
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi a
                        %mrow
                          %mi i
                          %mi j
                    %annotation{:encoding => "application/x-tex"} a_{i j}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ρ
                      %mi i
                    %mo ∈
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\rho_i \in C^\infty(X))
              subordinate to the chosen cover and the coboundary given by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %msub
                            %mi i
                            %mn 0
                      %msub
                        %mi ρ
                        %mrow
                          %msub
                            %mi i
                            %mn 0
                      %msub
                        %mi a
                        %mrow
                          %msub
                            %mi i
                            %mn 0
                          %mi i
                      %mo{:stretchy => "false"} )
