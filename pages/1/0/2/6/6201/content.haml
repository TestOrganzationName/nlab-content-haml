              and of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p
              The claim then follows for general simplicial spaces by observing that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                    %mo =
                    %msup
                      %mo ∫
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi k
                        %mo{:stretchy => "false"} ]
                        %mo ∈
                        %mi Δ
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi k
                    %mo{:stretchy => "false"} ]
                    %mo ⋅
                    %msub
                      %mi X
                      %mi k
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi CartSp
                      %mi smooth
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo ,
                        %mi loc
                  %annotation{:encoding => "application/x-tex"} X_\bullet = \int^{[k] \in \Delta} \Delta[k] \cdot X_k \in [CartSp_{smooth}^{op}, sSet]_{proj,loc}
              presents the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimit"} (∞,1)-colimit
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
