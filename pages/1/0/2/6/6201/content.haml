                are in bijection with pairs consisting of a
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                      %mo ∈
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \lambda \in C^\infty(X,U(1))
                and a 1-form
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                      %mo ∈
                      %msup
                        %mi Ω
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \alpha \in \Omega^1(X)
                such that
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ′
                        %mo =
                        %mi A
                        %mo +
                        %msub
                          %mi d
                          %mi dR
                        %mi λ
                        %mo −
                        %mi α
                      %annotation{:encoding => "application/x-tex"} A' = A + d_{dR} \lambda - \alpha
            %li
              %p
                And finally
                %a.existingWikiWord{:href => "/nlab/show/k-morphism"} 3-morphisms
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                      %mo :
                      %mo{:stretchy => "false"} (
                      %mi λ
                      %mo ,
                      %mi α
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mi λ
                      %mo ′
                      %mo ,
                      %mi α
                      %mo ′
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} h : (\lambda, \alpha) \to (\lambda', \alpha')
                are in bijection with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                      %mo ∈
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} h \in C^\infty(X,U(1))
                such that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                      %mo ′
                      %mo =
                      %mi λ
                      %mo ⋅
                      %mi h
                    %annotation{:encoding => "application/x-tex"} \lambda' = \lambda \cdot h
                and
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi α
                        %mo ′
                        %mo =
                        %mi α
                        %mo +
                        %msub
                          %mi d
                          %mi dR
                        %mi h
                      %annotation{:encoding => "application/x-tex"} \alpha' = \alpha + d_{dR} h
          %p
            By the same reasoning we find that the coefficient object for flat
            = succeed "-valued" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 2
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}^2 U(1)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mo ♭
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 2
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi Π
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 2
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %mi Ξ
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi d
                        %mi dR
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi d
                        %mi dR
                  %msubsup
                    %mi Ω
                    %mi cl
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{\flat}\mathbf{B}^2 U(1)
                  \=
                  [\Pi_2(-), \mathbf{B}^2U(1)]
                  \=
                  \\Xi(
                  C^\infty(-,U(1))
                  \\stackrel{d_{dR}}{\to}
                  \\Omega^1(-) \stackrel{d_{dR}}{\to} \Omega^2_{cl}(-)
                  )
                  \\,.
          %p
            So by the above definition of differential cohomology in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            we find that
            = succeed "-differential" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}U(1)
            %a.existingWikiWord{:href => "/nlab/show/paracompact+space"} paracompact
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is given by choosing any
            %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U_i \to X\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi U
                    %mi i
                  %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C(\{U_i\})
            to be the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi CartSp
                    %mi op
                  %mo ,
                  %mi sSet
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mrow
                      %mi proj
                      %mo ,
                      %mi cov
                %annotation{:encoding => "application/x-tex"} [CartSp^{op}, sSet]_{proj,cov}
            and forming the ordinary pullback
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mi diff
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %msubsup
                            %mi H
                            %mi dR
                            %mn 2
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} [
                          %msup
                            %mi CartSp
                            %mi op
                          %mo ,
                          %mi sSet
                          %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} (
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mo{:stretchy => "false"} {
                          %msub
                            %mi U
                            %mi i
                          %mo{:stretchy => "false"} }
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi diff
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo →
                            %mi curv
                        %mtd
                          %mo{:stretchy => "false"} [
                          %msup
                            %mi CartSp
                            %mi op
                          %mo ,
                          %mi sSet
                          %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} (
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mo{:stretchy => "false"} {
                          %msub
                            %mi U
                            %mi i
                          %mo{:stretchy => "false"} }
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %msub
                            %mo ♭
                            %mi dR
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mn 2
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\mathbf{H}_{diff}(X,\mathbf{B}U(1)) &amp;\to&amp; H^2_{dR}(X)
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  [CartSp^{op},sSet](C(\{U_i\}), \mathbf{B}_{diff}U(1))
                  \&amp;\stackrel{curv}{\to}&amp;
                  [CartSp^{op},sSet](C(\{U_i\}), \flat_{dR}\mathbf{B}^2 U(1))
                  }
          %p
            (because the bottom vertical morphism is a fibration, by the fact that our model for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi diff
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mo ♭
                    %mi dR
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 2
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{B}_{diff} U(1) \to \flat_{dR}\mathbf{B}^2 U(1)
            is a fibration, that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi U
                    %mi i
                  %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C(\{U_i\})
            is cofibrant and using the axioms of the
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
            %a.existingWikiWord{:href => "/nlab/show/enriched+model+category"} enriched model category
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                  %annotation{:encoding => "application/x-tex"} [CartSp^{op}, sSet]_{proj}
          .num_prop
            %h6#observations Observations
            %p
              A cocycle in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi diff
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} [CartSp^{op},sSet](C(\{U_i\}), \mathbf{B}_{diff}U(1))
              is
            %ol
              %li
                %p a collection of functions
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi g
                          %mrow
                            %mi i
                            %mi j
                        %mo ∈
                        %msup
                          %mi C
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi U
                          %mi i
                        %mo ∩
                        %msub
                          %mi U
                          %mi j
                        %mo ,
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        (g_{i j } \in C^\infty(U_i \cap U_j, U(1)))
                %p
                  satsifying
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi g
                          %mrow
                            %mi i
                            %mi j
                        %msub
                          %mi g
                          %mrow
                            %mi j
                            %mi k
                        %mo =
                        %msub
                          %mi g
                          %mrow
                            %mi i
                            %mi k
                      %annotation{:encoding => "application/x-tex"} g_{i j} g_{j k} = g_{i k}
                  on
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi U
                            %mi i
                          %mo ∩
                          %msub
                            %mi U
                            %mi j
                          %mo ∩
                          %msub
                            %mi U
                            %mi k
                        %annotation{:encoding => "application/x-tex"} U_i \cap U_j \cap U_k
              %li
                %p a collection of 1-forms
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi A
                          %mi i
                        %mo ∈
                        %msup
                          %mi Ω
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi U
                          %mi i
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        (A_i \in \Omega^1(U_i))
              %li
                %p a collection of 1-forms
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi a
                          %mrow
                            %mi i
                            %mi j
                        %mo ∈
                        %msup
                          %mi Ω
                          %mo{:stretchy => "false"} (
                        %msub
                          %mi U
                          %mi i
                        %mo ∩
                        %msub
                          %mi U
                          %mi j
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        (a_{i j} \in \Omega^(U_i \cap U_j))
                %p such that
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi A
                          %mi j
                        %mo =
                        %msub
                          %mi A
                          %mi i
                        %mo +
                        %msub
                          %mi d
                          %mi dR
                        %msub
                          %mi g
                          %mrow
                            %mi i
                            %mi j
                        %mo +
                        %msub
                          %mi a
                          %mrow
                            %mi i
                            %mi j
                      %annotation{:encoding => "application/x-tex"}
                        A_j = A_i + d_{dR} g_{i j} + a_{i j}
                %p
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi U
                          %mi i
                        %mo ∩
                        %msub
                          %mi U
                          %mi j
                      %annotation{:encoding => "application/x-tex"} U_i \cap U_j
                  and
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi a
                          %mrow
                            %mi i
                            %mi j
                        %mo +
                        %msub
                          %mi a
                          %mrow
                            %mi j
                            %mi k
                        %mo =
                        %msub
                          %mi a
                          %mrow
                            %mi i
                            %mi k
                      %annotation{:encoding => "application/x-tex"}
                        a_{i j} + a_{j k} = a_{i k}
                %p
                  on
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi U
                            %mi i
                          %mo ∩
                          %msub
                            %mi U
                            %mi j
                          %mo ∩
                          %msub
                            %mi U
                            %mi k
                        %annotation{:encoding => "application/x-tex"} U_i \cap U_j \cap U_k
            %p The curvature-morphism takes such a cocycle to the cocycle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi d
                    %msub
                      %mi A
                      %mi i
                    %mo ,
                    %msub
                      %mi a
                      %mrow
                        %mi i
                        %mi j
                    %mo ,
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (d A_i, a_{i j}, )
            %p
              in the
              %a{:href => "#OrdinaryDeRham"} above model
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mo ♭
                      %mi dR
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 2
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} [CartSp^{op},sSet](C(\{U_i\}), \mathbf{\flat}_{dR}\mathbf{B}^2 U(1))
              for intrinsic de Rham cohomology.
            %p
              Every cocycle with nonvanishing
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
