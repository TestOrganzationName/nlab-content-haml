                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} )
                            %msub
                              %mo ⊗
                              %mi ℤ
                            %mi ℤ
                            %mo{:stretchy => "false"} [
                            %mi n
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mo ∫
                              %mi U
                            %msup
                              %mi Ch
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi ℤ
                            %mo{:stretchy => "false"} [
                            %mi n
                            %mo{:stretchy => "false"} ]
                            %mo ,
                            %msup
                              %mi C
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi Set
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi K
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msup
                              %mi Ch
                              %mo •
                            %mo{:stretchy => "false"} (
