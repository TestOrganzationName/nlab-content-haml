            %p we find
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ω
                      %mrow
                        %msub
                          %mi U
                          %mn 0
                        %mover
                          %mo →
                          %mi f
