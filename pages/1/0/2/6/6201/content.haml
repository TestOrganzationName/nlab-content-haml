                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi diff
