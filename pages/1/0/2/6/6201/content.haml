            %p
              of the standard presentation of the delooping of the
              %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete group
              underlying
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
