                      A \stackrel{\mathbf{c}}{\to}
                      \\mathbf{B}^n U(1) \stackrel{curv}{\to}
                      \\mathbf{\flat}_{dR} \mathbf{B}^{n+1} \mathbb{R}
              %p
                with the
                %a{:href => "#StrucCurvatureForms"} universal curvature characteristic
                on
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi n
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathbf{B}^n U(1)
                %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi H
                        %mi Smooth
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi G
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mo =
                      %msub
                        %mi π
                        %mn 0
                      %mi Smooth
                      %mn ∞
                      %mi Grpd
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi π
                            %mn 0
                          %mo{:stretchy => "false"} (
                          %mrow
                            %mo{:stretchy => "false"} (
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi c
                              %mi dR
                            %msub
                              %mo{:stretchy => "false"} )
                              %mo *
                          %mo{:stretchy => "false"} )
                      %msub
                        %mi π
                        %mn 0
                      %mi Smooth
                      %mn ∞
                      %mi Grpd
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %msub
                        %mstyle{:mathvariant => "bold"}
