                            %mi U
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msup
                              %mi Ch
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi ℤ
                            %mo{:stretchy => "false"} [
                            %mi n
                            %mo{:stretchy => "false"} ]
                            %mo ,
                            %msup
                              %mi C
                              %mo •
