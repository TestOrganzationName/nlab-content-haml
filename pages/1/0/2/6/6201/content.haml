          .num_prop
            %h6#proposition_4 Proposition
            %p
              A fibrant representative of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo ,
                        %mi cov
                  %annotation{:encoding => "application/x-tex"} [CartSp^{op}, sSet]_{proj,cov}
              is given by the
              %a.existingWikiWord{:href => "/nlab/show/crossed+complex"} crossed complex
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ξ
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi G
                      %mn 2
                    %mo →
                    %msub
                      %mi G
                      %mn 1
                    %mover
                      %mo →
                      %mo →
                    %mo *
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
