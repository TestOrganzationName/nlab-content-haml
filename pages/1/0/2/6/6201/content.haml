                  %annotation{:encoding => "application/x-tex"}
                    Smooth \infty Grpd \stackrel{\Pi}{\to}
                    \\infty Grpd
                    \\underoverset{|-|}{\simeq}{\to}
                    Top
            %p
              is
              %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} equivalent to
              the
              %a.existingWikiWord{:href => "/nlab/show/geometric+realization+of+simplicial+topological+spaces"} geometric realization
              of (a Reedy cofibrant replacement of) the underlying
              %a.existingWikiWord{:href => "/nlab/show/simplicial+topological+space"} simplicial topological space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} |
                    %mo ≃
                    %mo{:stretchy => "false"} |
