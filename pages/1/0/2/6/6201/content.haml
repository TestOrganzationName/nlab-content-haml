                              %mo{:stretchy => "false"} (
                              %mo{:stretchy => "false"} {
                              %msub
                                %mi U
                                %mi i
                              %mo{:stretchy => "false"} }
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mover
                                %mo →
                                %mi g
                            %mtd
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mi U
                              %mo{:stretchy => "false"} (
                              %mn 1
                              %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \&amp;&amp; \mathbf{B}_{diff}U(1)
                      \\\
                      \&amp; {}^{\mathllap{(g,\nabla)}}\nearrow &amp; \downarrow
                      \\\
                      C(\{U_i\}) &amp;\stackrel{g}{\to}&amp; \mathbf{B}U(1)
                      }
              %p
                to an equivalent
                = succeed "-cocycle," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi diff
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathbf{B}_{diff}U(1)
                %em pseudo-connection
                on the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/principal+U%281%29-bundle"} principal U(1)-bundle
            %li
              %p From that lift the desired curvature characteristic is simply projected out
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %msub
                                %mstyle{:mathvariant => "bold"}
                                  %mi B
                                %mi diff
                              %mi U
                              %mo{:stretchy => "false"} (
                              %mn 1
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mover
                                %mo →
                                %mi curv
                            %mtd
