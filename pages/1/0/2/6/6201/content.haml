          .num_prop
            %h6#proposition_27 Proposition
            %p This map yields a morphism of simplicial presheaves
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∫
                    %mo :
                    %mstyle{:mathvariant => "bold"}
                      %mo ♭
