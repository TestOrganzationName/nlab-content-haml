            \.
          .num_prop
            %h6#proposition_22 Proposition
            %p
              The objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi CartSp
                      %mi smooth
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \exp(\mathfrak{g}) \in [CartSp_{smooth}^{op}, sSet]
              are
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/connected"}> connected
                  ;
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Kan+complex"}> Kan complex
                  es over each
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo ∈
                      %annotation{:encoding => "application/x-tex"} U \in
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
          .proof
            %h6#proof_23 Proof
            %p
              That
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 0
                    %mo =
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \exp(\mathfrak{g})_0 = *
              follows from degree-counting:
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mrow
                        %mi si
                        %mo ,
                        %mi vert
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %msup
                      %mi Δ
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega^\bullet_{si,vert}(U \times \Delta^0) = C^\infty(U)
              is entirely in degree 0 and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CE(\mathfrak{g})
              is in degree 0 the ground field
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
            %p
              To see that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \exp(\mathfrak{g})
              has all
              = succeed "-fillers" do
                %a.existingWikiWord{:href => "/nlab/show/horn"} horn
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                    %mi CartSp
                  %annotation{:encoding => "application/x-tex"} U \in CartSp
              observe that the standard
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous
              %a.existingWikiWord{:href => "/nlab/show/horn"} horn
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/retract"} retract
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %msup
                      %mi Δ
                      %mi k
                    %mo →
                    %msubsup
                      %mi Λ
                      %mi i
                      %mi k
                  %annotation{:encoding => "application/x-tex"} f : \Delta^k \to \Lambda^k_i
              are smooth away from the preimages of the
              = succeed "-faces" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi r
                      %mo &lt;
                      %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (r \lt k)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Λ
                      %mo{:stretchy => "false"} [
                      %mi k
                      %msup
                        %mo{:stretchy => "false"} ]
                        %mi i
                    %annotation{:encoding => "application/x-tex"} \Lambda[k]^i
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo ∈
                    %msubsup
                      %mi Ω
                      %mrow
                        %mi si
                        %mo ,
                        %mi vert
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %mi Λ
                    %mo{:stretchy => "false"} [
                    %mi k
                    %msup
                      %mo{:stretchy => "false"} ]
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \omega \in \Omega^\bullet_{si,vert}(U \times \Lambda[k]^i)
              a differential form with sitting instants on
              = succeed "-neighbourhoods," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                    %annotation{:encoding => "application/x-tex"} \epsilon
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ⊂
                    %mo ∂
                    %msup
                      %mi Δ
                      %mi k
                  %annotation{:encoding => "application/x-tex"} K \subset \partial \Delta^k
              be the set of points of distance
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≤
                    %mi ϵ
                  %annotation{:encoding => "application/x-tex"} \leq \epsilon
              from any subface. Then we have a smooth function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %msup
                      %mi Δ
                      %mi k
                    %mo ∖
                    %mi K
                    %mo →
                    %msubsup
                      %mi Λ
                      %mi i
                      %mi k
                    %mo ∖
                    %mi K
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f : \Delta^k \setminus K \to \Lambda^k_i \setminus K
                    \\,.
            %p
              The pullback
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mi ω
                    %mo ∈
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mi k
                    %mo ∖
                    %mi K
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f^* \omega \in \Omega^\bullet(\Delta^k \setminus K)
              may be extended constantly back to a form with sitting instants on all of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Δ
                        %mi k
                    %annotation{:encoding => "application/x-tex"} \Delta^k
            %p The resulting assignment
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mi A
                    %msubsup
                      %mi Ω
                      %mrow
                        %mi si
                        %mo ,
                        %mi vert
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %msubsup
                      %mi Λ
                      %mi i
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mi A
                    %msubsup
                      %mi Ω
                      %mrow
                        %mi si
                        %mo ,
                        %mi vert
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %msubsup
                      %mi Λ
                      %mi i
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %msup
                          %mi f
                          %mo *
                    %msubsup
                      %mi Ω
                      %mrow
                        %mi si
                        %mo ,
                        %mi vert
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %msup
                      %mi Δ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (CE(\mathfrak{g}) \stackrel{A}{\to} \Omega^\bullet_{si,vert}(U \times \Lambda^k_i))
                    \\mapsto
                    (CE(\mathfrak{g}) \stackrel{A}{\to} \Omega^\bullet_{si,vert}(U \times \Lambda^k_i) \stackrel{f^*}{\to} \Omega^\bullet_{si,vert}(U \times \Delta^n))
            %p
              provides fillers for all
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/horn"} horn
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} U \in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
          .num_prop
            %h6#definition_9 Definition
            %p
              We say that the
              %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop space object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega \exp(\mathfrak{g})
              is the
              %strong
                smooth
                = succeed "-group" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
              exponentiating
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
          .num_prop
            %h6#proposition_23 Proposition
            %p
              The objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi Smooth
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} \exp(\mathfrak{g}) \in Smooth \infty Grpd
              are geometrically contractible:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Pi \exp(\mathfrak{g}) \simeq *
                    \\,.
          .proof
            %h6#proof_24 Proof
            %p
              Observe that every
              %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaf"} simplicial presheaf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+colimit"} homotopy colimit
              over its component presheaves
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi n
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi CartSp
                      %mi smooth
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                    %mo ↪
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi CartSp
                      %mi smooth
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi loc
                  %annotation{:encoding => "application/x-tex"} X_n \in [CartSp_{smooth}^{op}, Set] \hookrightarrow [CartSp_{smooth}^{op}, sSet]_{loc}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ≃
                    %mi 𝕃
                    %msub
                      %mrow
                        %munder
                          %mi lim
                          %mo →
                      %mi n
                    %msub
                      %mi X
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    X \simeq \mathbb{L} {\lim_{\to}}_n X_n
                    \\,.
            %p
              (Use for instance the injective model structure for which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                  %annotation{:encoding => "application/x-tex"} X_\bullet
              is cofibrant in the
              %a.existingWikiWord{:href => "/nlab/show/Reedy+model+structure"} Reedy model structure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Δ
                      %mi op
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi CartSp
                      %mi smooth
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi inj
                        %mo ,
                        %mi loc
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi Reedy
                  %annotation{:encoding => "application/x-tex"} [\Delta^{op},[CartSp_{smooth}^{op}, sSet]_{inj,loc}]_{Reedy}
              ).
            %p
              Therefore it is sufficient to show that in each degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              the
              %a.existingWikiWord{:href => "/nlab/show/0-truncated"} 0-truncated
              object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \exp(\mathfrak{g})_{n}
              is geometrically contractible. To exhibit a geometric contraction, choose for each
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi n
                    %mo :
                    %msup
                      %mi Δ
                      %mi n
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %msup
                      %mi Δ
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    \\eta_n : \Delta^n \times [0,1] \to \Delta^n
            %p
              of the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/simplex"} simplex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi Id
                  %annotation{:encoding => "application/x-tex"} \eta_n(-,1) = Id
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \eta_n(-,0)
              factors through the point.
            %p We claim that this induces a diagram of presheaves
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %mi 𝔤
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi n
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mi id
                                  %mo ,
                                  %mn 1
                                  %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msup
                              %mo ↘
                              %mi{:mathvariant => "normal"} id
                        %mtr
                          %mtd
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %mi 𝔤
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi n
                            %mo ×
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msubsup
                                  %mi η
                                  %mi n
                                  %mo *
                          %mtd
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %mi 𝔤
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi n
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mi id
                                  %mo ,
                                  %mn 0
                                  %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ↑
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↑
                        %mtr
                          %mtd
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %mi 𝔤
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi n
                          %mtd
                            %mo →
                          %mtd
                            %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\exp(\mathfrak{g})_n
                    \\\
                    {}^{\mathllap{(id,1)}}\downarrow &amp; \searrow^{\mathrm{id}}
                    \\\
                    \\exp(\mathfrak{g})_n \times [0,1] &amp;\stackrel{\eta_n^*}{\to}&amp; \exp(\mathfrak{g})_n
                    \\\
                    {}^{\mathllap{(id,0)}}\uparrow &amp; &amp; \uparrow
                    \\\
                    \\exp(\mathfrak{g})_n &amp;\to&amp; *
                    }
                    \\,,
            %p
              where over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                    %mi CartSp
                  %annotation{:encoding => "application/x-tex"} U \in CartSp
              the middle morphism is given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi η
                      %mi n
                      %mo *
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi α
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %msub
                      %mi η
                      %mi n
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mi α
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\eta_n^*
                    \:
                    (\alpha, f)
                    \\mapsto
                    (f,\eta_n)^* \alpha
                    \\,,
            %p where
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi α
                        %mo :
                        %mi CE
                        %mo{:stretchy => "false"} (
                        %mi 𝔤
                        %mo{:stretchy => "false"} )
                        %mo →
                        %msubsup
                          %mi Ω
                          %mi vert
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi U
                        %mo ×
                        %msup
                          %mi Δ
                          %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \alpha : CE(\mathfrak{g}) \to \Omega^\bullet_{vert}(U \times \Delta^n)
                  is an element of the set
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi exp
                          %mo{:stretchy => "false"} (
