                    U(1) = S^1 = \mathbb{R}/\mathbb{Z}
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian
              %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
              called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/circle+group"} circle group
              or
              %em
                1-dimensional
                %a.existingWikiWord{:href => "/nlab/show/unitary+group"} unitary group
              , regarded as a
              %a.existingWikiWord{:href => "/nlab/show/0-truncated"} 0-truncated
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
              object in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Smooth
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} Smooth\infty Grpd
              under the
              %a{:href => "#SmoothManifoldEmbeds"} embedding
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SmoothMfd
                      %mo ↪
                      %mi Smooth
                      %mn ∞
                      %mi Grpd
                    %annotation{:encoding => "application/x-tex"} SmoothMfd \hookrightarrow Smooth \infty Grpd
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              the
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi Smooth
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}^n U(1) \in Smooth \infty Grpd
              we call the
              = succeed "." do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/circle+n-group"} circle Lie (n+1)-group
          %p Write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo :
                  %mo =
                  %mo{:stretchy => "false"} [
                  %mi ⋯
                  %mo →
                  %mn 0
                  %mo →
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mn 0
                  %mo →
                  %mi ⋯
                  %mo →
                  %mn 0
                  %mo{:stretchy => "false"} ]
                  %mo ∈
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi CartSp
                    %mi op
                  %mo ,
                  %msubsup
                    %mi Ch
                    %mo •
                    %mo +
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  U(1)[n] := [\cdots \to 0 \to C^\infty(-,U(1)) \to 0 \to \cdots \to 0]
                  \\in
                  [CartSp^{op}, Ch^+_\bullet]
          %p
            for the
            %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
            of sheaves concentrated in degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(1)
          %p
            Recall the right Quillen functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ξ
                  %mo :
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi CartSp
                    %mi op
                  %mo ,
                  %msubsup
                    %mi Ch
                    %mo •
                    %mo +
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi CartSp
                    %mi op
                  %mo ,
                  %mi sSet
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \Xi : [CartSp^{op}, Ch_\bullet^+] \to [CartSp^{op}, sSet]
            from
            = succeed "." do
              %a{:href => "#DoldKanInclusion"} above
          .num_prop
            %h6#proposition_5 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaf"} simplicial presheaf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ξ
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \Xi(U(1)[n]) \in [CartSp^{op}, sSet]
              is a fibrant representative in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo ,
                        %mi loc
                  %annotation{:encoding => "application/x-tex"} [CartSp^{op},sSet]_{proj,loc}
              of the circle Lie
              = succeed "-group" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n+1)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi n
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}^n U(1)
          .proof
            %h6#proof_7 Proof
            %p
              First notice that since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} U(1)[n]
              is fibrant in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi CartSp
                      %mi smooth
                      %mi op
                    %mo ,
                    %msub
                      %mi Ch
                      %mo •
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                  %annotation{:encoding => "application/x-tex"} [CartSp_{smooth}^{op}, Ch_\bullet]_{proj}
              we have that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ξ
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \Xi U(1)[n]
              is fibrant in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi CartSp
                        %mi op
                      %mo ,
                      %mi sSet
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi proj
                    %annotation{:encoding => "application/x-tex"} [CartSp^{op}, sSet]_{proj}
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
              that defines the
              %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop space object
              in the global model structure (by the discussion at
              = succeed ")" do
                %a{:href => "http://ncatlab.org/nlab/show/model+structure+on+simplicial+presheaves#HomotopyLimits"} model structure on simplicial presheaves – homotopy (co)limits
            %p
              Consider the global fibration
              %a.existingWikiWord{:href => "/nlab/show/resolution"} resolution
              of the point inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo →
                    %mi Ξ
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} * \to \Xi(U(1)[n])
              given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Ξ
                            %mo{:stretchy => "false"} [
                            %msup
                              %mi C
                              %mn ∞
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo ,
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mover
                              %mo →
                              %mi Id
                            %msup
                              %mi C
                              %mn ∞
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo ,
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo →
                            %mn 0
                            %mo →
                            %mi ⋯
                            %mo →
                            %mn 0
                            %mo{:stretchy => "false"} ]
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi Ξ
                            %mo{:stretchy => "false"} [
                            %msup
                              %mi C
                              %mn ∞
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo ,
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo →
                            %mn 0
                            %mo →
                            %mn 0
                            %mo →
                            %mi ⋯
                            %mo →
                            %mn 0
                            %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\Xi [C^\infty(-,U(1)) \stackrel{Id}{\to} C^\infty(-,U(1)) \to 0 \to \cdots \to 0]
                    \\\
                    \\downarrow
                    \\\
                    \\Xi [C^\infty(-,U(1)) \to 0  \to 0 \to \cdots \to 0]
                    }
                    \\,.
            %p
              The underlying morphism of chain complexes is clearly degreewise surjective, hence a projective fibration, hence its image under
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ξ
                  %annotation{:encoding => "application/x-tex"} \Xi
              is a projective fibration. Therefore the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
              in question is given by the ordinary
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Ξ
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo →
                            %msup
                              %mi C
                              %mn ∞
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo ,
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo →
                            %mn 0
                            %mo →
                            %mi ⋯
                            %mo →
                            %mn 0
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mo →
                          %mtd
                            %mi Ξ
                            %mo{:stretchy => "false"} [
                            %msup
                              %mi C
                              %mn ∞
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo ,
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mover
                              %mo →
                              %mi Id
                            %msup
                              %mi C
                              %mn ∞
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo ,
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo →
                            %mn 0
                            %mo →
                            %mi ⋯
                            %mo →
                            %mn 0
                            %mo{:stretchy => "false"} ]
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi Ξ
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo →
                            %mn 0
                            %mo →
                            %mn 0
                            %mo →
                            %mi ⋯
                            %mo →
                            %mn 0
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mo →
                          %mtd
                            %mi Ξ
                            %mo{:stretchy => "false"} [
                            %msup
                              %mi C
                              %mn ∞
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo ,
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo →
                            %mn 0
                            %mo →
                            %mn 0
                            %mo →
                            %mi ⋯
                            %mo →
                            %mn 0
                            %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\Xi[0 \to C^\infty(-,U(1)) \to 0 \to \cdots \to 0]
                    \&amp;\to&amp;
                    \\Xi [C^\infty(-,U(1)) \stackrel{Id}{\to} C^\infty(-,U(1)) \to 0 \to \cdots \to 0]
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    \\Xi [0 \to 0  \to 0 \to \cdots \to 0]
                    \&amp; \to &amp;
                    \\Xi [C^\infty(-,U(1)) \to 0  \to 0 \to \cdots \to 0]
                    }
                    \\,,
            %p
              computed in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %msub
                      %mi Ch
                      %mo •
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [CartSp^{op}, Ch_\bullet]
              and then using that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ξ
                  %annotation{:encoding => "application/x-tex"} \Xi
              is the
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              and hence preserves pullbacks. This shows that the loop object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                    %mi Ξ
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega \Xi(U(1)[n])
              is indeed presented by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ξ
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Xi (U(1)[n-1])
            %p
              Now we discuss the fibrancy of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} U(1)[n]
              in the local model structure
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi CartSp
                        %mi op
                      %mo ,
                      %mi sSet
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mrow
                          %mi proj
                          %mo ,
                          %mi loc
                    %annotation{:encoding => "application/x-tex"} [CartSp^{op}, sSet]_{proj,loc}
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi U
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U_i \to U\}
              of a
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              we have that the mophism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Ξ
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    C^\infty(U,U(1))[n] \to [CartSp^{op}, sSet](C(\{U_i\}), \Xi U(1)[n])
            %p
              is an equivalence of Kan complexes, where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(\{U_i\})
              is the
              %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
              of the cover. Observe that the Kan complex on the right is that whose vertices are
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech cohomology
              (see there for details) with coefficients in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(1)
              and whose morphisms are coboundaries between these.
            %p
              We proceed by induction on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} n = 0
              the condition is just that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^\infty(-,U(1))
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              we use that since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(\{U_i\})
              is cofibrant, the above is the
              %a.existingWikiWord{:href => "/nlab/show/derived+hom-space"} derived hom-space
              functor which commutes with
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop space object
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Ξ
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Ξ
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_1 [CartSp^{op}, sSet](C(\{U_i\}), \Xi (U(1)[n]))
                    \\simeq
                    \\pi_0 [CartSp^{op}, sSet](C(\{U_i\}), \Xi (U(1)[n-1]))
            %p
              by the above result on delooping. So we find that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo ≤
                    %mi k
                    %mo ≤
                    %mi n
                  %annotation{:encoding => "application/x-tex"} 0 \leq k \leq n
              that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi k
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Ξ
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_k [CartSp^{op}, sSet](C(\{U_i\}), \Xi(U(1)[n]))
              is the
              %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech cohomology
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              with coefficients in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(1)
              in degree
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo −
                      %mi k
                    %annotation{:encoding => "application/x-tex"} n-k
              %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech cohomology
              (using the
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
              of abelian groups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo →
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z} \to U(1)\to \mathbb{R}
              and the fact that the cohomology with coefficients in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              vanishes in positive degree, for instance by a
              %a.existingWikiWord{:href => "/nlab/show/partition+of+unity"} partition of unity
              argument) we have that this is given by the
              %a.existingWikiWord{:href => "/nlab/show/integral+cohomology"} integral cohomology
              groups
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Ξ
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi H
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_0 [CartSp^{op}, sSet](C(\{U_i\}), \Xi (U(1)[n]))
                    \\simeq
                    H^{n+1}(U, \mathbb{Z})
            %p
              for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ≥
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n \geq 1
              %a.existingWikiWord{:href => "/nlab/show/contractible"} contractible
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              all these cohomology groups vanish.
            %p
              So we have that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ξ
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Xi(U(1)[n])(U)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Ξ
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} [CartSp^{op}, sSet](C(\{U_i\}), \Xi U(1)[n])
              both have homotopy groups concentrated in degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U(1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(1)
              is a sheaf also shows that the morphism in question is an isomorphism on this degree-
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              homotopy group, hence is indeed a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
          .num_remark
            %h6#remark Remark
            %p
              In the equivalent presentation of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Smooth
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} Smooth\infty Grpd
              by simplicial presheaves on all of
              %a.existingWikiWord{:href => "/nlab/show/SmoothMfd"} SmoothMfd
              the objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ξ
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \Xi U(1)[n]
              are far from being locally fibrant. Instead, their local fibrant replacements are given by the
              = succeed "-stacks" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle n-bundle
          %h4#SimplicialSmoothGroups Simplicial Lie groups
          %p
            Every
            %a.existingWikiWord{:href => "/nlab/show/connected"} connected
            object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                  %mn ∞
                  %mi Lie
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"} X \in \infty Lie Grpd
            is – by definition – the
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo =
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} X = \mathbf{B}G
            of a Lie
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo =
                    %mi Ω
                    %mi X
                  %annotation{:encoding => "application/x-tex"} G = \Omega X
            %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop space object
            formed in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                    %mi LieGrpd
                  %annotation{:encoding => "application/x-tex"} \infty LieGrpd
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/group+object+in+an+%28infinity%2C1%29-category"} group objects
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop space object
            %a.existingWikiWord{:href => "/nlab/show/limit+in+a+quasi-category"} (∞,1)-limits
            and
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-stackification"} ∞-stackification
            preserves these, this may be discussed in the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-presheaves"} (∞,1)-category of (∞,1)-presheaves
            on
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
            = succeed "-limits" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
            object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn ∞
                  %mi LieGrpd
                %annotation{:encoding => "application/x-tex"} \infty LieGrpd
            is modeled by a
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-presheaf"} (∞,1)-presheaf
            with values in
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
          %p
            By standard results on
            %a{:href => "http://ncatlab.org/nlab/show/groupoid+object+in+an+(infinity,1)-category#ModelsInInfGrpd"} Models for group objects in ∞Grpd
            the latter may equivalently be modeled by
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+group"} simplicial group
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
            equipped with a
            %em strict
            group object structure. While
            %a.existingWikiWord{:href => "/nlab/show/strict+omega-groupoid"} strict ∞-groupoids
            with weak group object structure do not model all
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
            = succeed "-groupoids" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            There is a good supply of standard results for and constructions with
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+group"} simplicial group
          %h3{:id => "StrucCohomology}{#Cohomology"}
            Cohomology and principal
            = succeed "-bundles" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            We discuss the
            %a{:href => "http://nlab.mathforge.org/nlab/show/cohesive+(infinity%2C1)-topos#Cohomology"} intrinsic cohomology and pricipal ∞-bundles
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Smooth
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} Smooth \infty Grpd
          %h4#CohomologyWithConstantCoefficients Cohomology with constant coefficients
          %div
            %h6#definition_3 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} A \in
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
              be any
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/discrete+%E2%88%9E-groupoid"} discrete ∞-groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi A
                    %mo{:stretchy => "false"} |
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} |A| \in
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              for its
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              any
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %a.existingWikiWord{:href => "/nlab/show/nonabelian+cohomology"} nonabelian cohomology
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with coefficients in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is the set of
              %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
              classes of maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mo{:stretchy => "false"} |
                    %mi A
                    %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} X \to |A|
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi Top
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %msub
                      %mi π
                      %mn 0
                    %mi Top
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:stretchy => "false"} |
                    %mi A
                    %mo{:stretchy => "false"} |
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H_{Top}(X,A) := \pi_0 Top(X,|A|)
                    \\,.
            %p
              We say
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Top
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:stretchy => "false"} |
                    %mi A
                    %mo{:stretchy => "false"} |
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Top(X,|A|)
              itself is the
              %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
              for
              = succeed "-valued" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %a.existingWikiWord{:href => "/nlab/show/nonabelian+cohomology"} nonabelian cohomology
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p
              Similarly, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi A
                    %mo ∈
                    %mi Smooth
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} X, \mathbf{A} \in Smooth \infty Grpd
              two smooth
              = succeed "-groupoids," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi Smooth
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi A
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %msub
                      %mi π
                      %mn 0
                    %mi Smooth
                    %mn ∞
                    %mi Grpd
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    H_{Smooth}(X,\mathbf{A}) := \pi_0 Smooth\infty Grpd(X,\mathbf{A})
            %p
              for the intrinsic
              %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Smooth
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} Smooth \infty Grpd
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with coefficients in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi A
                    %annotation{:encoding => "application/x-tex"} \mathbf{A}
          .num_prop
            %h6#proposition_6 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} A \in
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                    %mi A
                    %mo ∈
                    %mi Smooth
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} Disc A \in Smooth \infty Grpd
              for the corresponding
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/discrete+%E2%88%9E-groupoid"} discrete smooth ∞-groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi SmoothMfd
                    %mover
                      %mo ↪
                      %mi i
                    %mi Smooth
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} X \in SmoothMfd \stackrel{i}{\hookrightarrow} Smooth \infty Grpd
              be a
              %a.existingWikiWord{:href => "/nlab/show/paracompact+topological+space"} paracompact topological space
              regarded as a 0-
              %a.existingWikiWord{:href => "/nlab/show/truncated"} truncated
              Euclidean-topological
              = succeed "-groupoid." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
            %p
              We have an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              of cohomology sets
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi Top
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi H
                      %mi Smooth
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Disc
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    H_{Top}(X,A) \simeq H_{Smooth}(X,Disc A)
            %p
              and in fact an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+in+an+%28%E2%88%9E%2C1%29-category"} equivalence
              of
              %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Top
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:stretchy => "false"} |
                    %mi A
                    %mo{:stretchy => "false"} |
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Smooth
                    %mn ∞
                    %mi Grpd
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Disc
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Top(X,|A|) \simeq Smooth\infty Grpd(X, Disc A)
                    \\,.
            %p
              More generally, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                    %mo ∈
                    %msup
                      %mi SmoothMfd
                      %mrow
                        %msup
                          %mi Δ
                          %mi op
                  %annotation{:encoding => "application/x-tex"} X_\bullet \in SmoothMfd^{\Delta^{op}}
              presenting an object in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Smooth
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} Smooth \infty Grpd
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi Smooth
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mo •
                    %mo ,
                    %mi Disc
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi H
                      %mi Top
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} |
                    %mi X
                    %mo{:stretchy => "false"} |
                    %mo ,
                    %mo{:stretchy => "false"} |
                    %mi A
                    %mo{:stretchy => "false"} |
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H_{Smooth}(X_\bullet, Disc A)
                    \\simeq
                    H_{Top}(|X|, |A|)
                    \\,.
          .proof
            %h6#proof_8 Proof
            %p
              This follows from the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Π
                      %mo ⊣
                      %mi Disc
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\Pi \dashv Disc)
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
              and the
              %a{:href => "#StrucGeometricHomotopy"} above proposition
              asserting that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} |
                    %mo ≃
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi X
                      %mo •
                    %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} |\Pi(X_\bullet)| \simeq |X_\bullet|
              is the ordinary
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/geometric+realization+of+simplicial+topological+spaces"} geometric realization of simplicial topological spaces
          %h4#principal_bundles_for__a_lie_group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            \-Principal bundles for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            a Lie group
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            be a Lie group, regarded as a group object in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Smooth
                  %mn ∞
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"} Smooth \infty Grpd
            as in the
            = succeed "." do
              %a{:href => "#LieGroups"} above discussion
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/universal+principal+%E2%88%9E-bundle"} universal G-principal bundle
            is a replacement of the point inclusion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} * \to \mathbf{B}G
            by a fibration
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi E
                    %mi G
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{E}G \to \mathbf{B}G
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            an ordinary
            %a.existingWikiWord{:href => "/nlab/show/group"} group
            one model for this is given by the Lie groupoid
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi E
                  %mi G
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo ×
                  %mi G
                  %mover
                    %munder
                      %mo →
                      %mrow
                        %msub
                          %mi p
                          %mn 1
                    %mover
                      %mo →
                      %mo ⋅
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{E}G = (G\times G \stackrel{\overset{\cdot}{\to}}{\underset{p_1}{\to}} G)
                  \\,,
          %p
            which is the
            %a.existingWikiWord{:href => "/nlab/show/action+groupoid"} action groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} /
                  %mi G
                %annotation{:encoding => "application/x-tex"} G//G
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            acting on itself.
          %p
            One noteworthy aspect of this object is that it is itself groupal, in fact itself a Lie
            %a.existingWikiWord{:href => "/nlab/show/strict+2-group"} strict 2-group
            in a way that is compatible with the canonical inclusion
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi E
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G \to \mathbf{E}G
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/groupal+model+for+universal+principal+%E2%88%9E-bundles"} groupal model for universal principal ∞-bundles
          %p
            To emphasize this group structure, we also write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi INN
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} INN(G)
            for this groupoid, following
            = succeed "." do
              %a{:href => "#http://arxiv.org/abs/0708.1741"} SchrRob
            %a.existingWikiWord{:href => "/nlab/show/crossed+module"} crossed module
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi INN
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mover
                    %mo →
                    %mi Id
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  [INN(G)] = (G \stackrel{Id}{\to} G)
                  \\,.
          %p
            Accordingly we write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mrow
                      %mi B
                      %mi E
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{B E}G
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi INN
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{B}INN(G)
            for the 2-groupoid given by the Lie
            %a.existingWikiWord{:href => "/nlab/show/crossed+complex"} crossed complex
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mover
                    %mo →
                    %mi Id
                  %mi G
                  %mover
                    %mo →
                    %mo →
                  %mo *
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (G \stackrel{Id}{\to}G \stackrel{\to}{\to} * )
                  \\,.
          %p
            The following proposition asserts that the general definition of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            applied to the coefficient object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{B}G
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo =
                  %mn ∞
                  %mi LieGrpd
                %annotation{:encoding => "application/x-tex"} \mathbf{H} = \infty LieGrpd
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            a
            %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            does reprpduce the ordinary notion of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
          %div
            %h6#proposition_7 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/paracompact+space"} paracompact
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              %a.existingWikiWord{:href => "/nlab/show/nonabelian+cohomology"} nonabelian cohomology
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with coefficients in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              coincided with the intrinsic
              %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                    %mi Lie
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} \infty Lie Grpd
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi π
                      %mn 0
                    %mn ∞
                    %mi LieGrpd
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    H^1(X,G) \simeq \pi_0 \infty LieGrpd(X, \mathbf{B}G)
            %p
              and the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} P \to X
              corresponding to a
              %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} X \to \mathbf{B}G
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                    %mi LieGrpd
                  %annotation{:encoding => "application/x-tex"} \infty LieGrpd
              is indeed the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
              of that cocycle.
          .proof
            %h6#proof_9 Proof
            %p
              By the discussion at
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
              we have that a cofibrant
              %a.existingWikiWord{:href => "/nlab/show/resolution"} resolution
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              in the model
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo ,
                        %mi cov
                  %annotation{:encoding => "application/x-tex"} [CartSp^{op}, sSet]_{proj,cov}
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                    %mi LieGrpd
                  %annotation{:encoding => "application/x-tex"} \infty LieGrpd
              is civen by the
              %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} C\{U_i\}
              of a
              %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi U
                        %mi i
                      %mo →
                      %mi X
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{U_i \to X\}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mn ∞
                    %mi LieGrpd
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_0 \infty LieGrpd(X,\mathbf{B}G)
              is the
              %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech cohomology
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with coefficients in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              (see there for details).
            %p Concretely, a cocycle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"}
                    g : C(\{U_i\}) \to \mathbf{B}G
            %p is canonically identified with a transition function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                    %msub
                      %mi U
                      %mi i
                    %mo ∩
                    %msub
                      %mi U
                      %mi j
                    %mo →
                    %mi G
                  %annotation{:encoding => "application/x-tex"}
                    g : \coprod_{i,j} U_i \cap U_j \to G
            %p
              satisfying on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi i
                    %mo ∩
                    %msub
                      %mi U
                      %mi j
                    %mo ∩
                    %msub
                      %mi U
                      %mi k
                  %annotation{:encoding => "application/x-tex"} U_i \cap U_j \cap U_k
              the cocycle condition
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi g
                        %mrow
                          %mi i
                          %mi j
                      %msub
                        %mi g
                        %mrow
                          %mi j
                          %mi k
                      %mo =
                      %msub
                        %mi g
                        %mrow
                          %mi i
                          %mi k
                    %annotation{:encoding => "application/x-tex"} g_{i j} g_{j k} = g_{i k}
            %p
              From this we can compute the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} g : C(\{U_i\}) \to \mathbf{B}G
              by forming the ordinary
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              of the fibrant replacement
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi E
                    %mi G
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{E}G \to \mathbf{B}G
              of the point inclusion
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                    %annotation{:encoding => "application/x-tex"} * \to \mathbf{B}G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} mathb
                    %mi E
                    %mi G
                    %mo =
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msup
                      %mi G
                      %mi I
                    %msub
                      %mo ×
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \mathb{E}G = \mathbf{B}G^{I} \times_{\mathbf{B}G} *
              is the smooth groupoid
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi E
                    %mi G
                    %mo =
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mo •
                          %mtr
                            %mtd
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %msub
                                      %mi g
                                      %mn 1
                              %mo ↙
                            %mtd
                            %mtd
                              %msup
                                %mo ↘
                                %mpadded{:width => "0"}
                                  %mrow
                                    %msub
                                      %mi g
                                      %mn 2
                          %mtr
                            %mtd
                              %mo *
                            %mtd
                            %mtd
                              %mover
                                %mo →
                                %mi h
                            %mtd
                            %mtd
                              %mo *
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi g
                        %mn 1
                      %mo ,
                      %msub
                        %mi g
                        %mn 2
                      %mo ,
                      %mi h
                      %mo ∈
                      %mi G
                      %mo ,
                      %msub
                        %mi g
                        %mn 2
                      %mo =
                      %mi h
                      %msub
                        %mi g
                        %mn 1
                      %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{E}G
                    \=
                    \\left\{
                    \\array{
                    \&amp;&amp; \bullet
                    \\\
                    \&amp; {}^{\mathllap{g_1}}\swarrow &amp;&amp; \searrow^{\mathrlap{g_2}}
                    \\\
                    * &amp;&amp;\stackrel{h}{\to}&amp;&amp; *
                    }
                    \\;\;|
                    \\;\;
                    g_1,g_2,h \in G, g_2 = h g_1
                    \\right\}
                    \\,.
            %p
              From this we find the pullback
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi P
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat P
              in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mover
                              %mi P
                              %mo{:stretchy => "false"} ^
                          %mtd
                            %mo →
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi E
                            %mi G
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} {
                            %msub
                              %mi U
                              %mi i
                            %mo{:stretchy => "false"} }
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mi g
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\hat P &amp;\to&amp; \mathbf{E}G
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    C(\{U_i\}) &amp;\stackrel{g}{\to}&amp; \mathbf{B}G
                    }
            %p to be the smooth Lie groupoid
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi P
                      %mo{:stretchy => "false"} ^
                    %mo =
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                        %mrow
                          %mi i
                          %mo ,
                          %mi j
                      %msub
                        %mi U
                        %mi i
                      %mo ∩
                      %msub
                        %mi U
                        %mi j
                      %mo ×
                      %mi G
                      %mover
                        %munder
                          %mo →
                          %mrow
                            %msub
                              %mi p
                              %mn 1
                            %mo ×
                            %msub
                              %mi P
                              %mn 3
                        %mover
                          %mo →
                          %mrow
                            %msub
                              %mi p
                              %mn 2
                            %mo ×
                            %msub
                              %mi g
                              %mrow
                                %mi i
                                %mo ,
                                %mi j
                            %mo ⋅
                            %msub
                              %mi p
                              %mn 3
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                        %mi i
                      %msub
                        %mi U
                        %mi i
                      %mo ×
                      %mi G
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\hat P
                    \=
                    \\left(
                    \\coprod_{i,j} U_i\cap U_j \times G
                    \\stackrel{\overset{p_2 \times g_{i,j} \cdot p_3}{\to}}{\underset{p_1 \times P_3}{\to}}
                    \\coprod_{i} U_i \times G
                    \\right)
            %p i.e.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi P
                      %mo{:stretchy => "false"} ^
                    %mo =
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mo •
                          %mtr
                            %mtd
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %msub
                                      %mi g
                                      %mn 1
                              %mo ↙
                            %mtd
                            %mtd
                              %msup
                                %mo ↘
                                %mpadded{:width => "0"}
                                  %mrow
                                    %msub
                                      %mi g
                                      %mn 2
                          %mtr
                            %mtd
                              %mo *
                            %mtd
                            %mtd
                              %mover
                                %mo →
                                %mrow
                                  %msub
                                    %mi g
                                    %mrow
                                      %mi i
                                      %mi j
                                  %mo{:stretchy => "false"} (
                                  %mi x
                                  %mo{:stretchy => "false"} )
                            %mtd
                            %mtd
                              %mo *
                          %mtr
                            %mtd
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo ,
                              %mi i
                              %mo{:stretchy => "false"} )
                            %mtd
                            %mtd
                              %mo →
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo ,
                              %mi j
                              %mo{:stretchy => "false"} )
                      %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\hat P
                    \=
                    \\left\{
                    \\array{
                    \&amp;&amp; \bullet
                    \\\
                    \&amp; {}^{\mathllap{g_1}}\swarrow &amp;&amp; \searrow^{\mathrlap{g_2}}
                    \\\
                    * &amp;&amp;\stackrel{g_{i j}(x)}{\to}&amp;&amp; *
                    \\\
                    \\\
                    (x,i) &amp;&amp;\to&amp;&amp; (x,j)
                    }
                    \\right\}
                    \\,.
            %p
              The evident projection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi P
                      %mo{:stretchy => "false"} ^
                    %mo →
                    %mi P
                  %annotation{:encoding => "application/x-tex"} \hat P \to P
              is objectwise a surjective and full and faithful functor.
          %h4#CohomologyOfLieGroups Cohomology of Lie groups
          %p
            We consider the cohomology in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            of smooth
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            groupoids
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{B}G
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            an ordinary
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            %a.existingWikiWord{:href => "/nlab/show/group+cohomology"} group cohomology
            for Lie groups.
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %msub
                    %mi π
                    %mn 0
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo ,
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  H^n(G,A) := \pi_0 \mathbf{H}(\mathbf{B}G, \mathbf{B}^n A)
                  \\,.
          %p
            We discuss how this relates to other definitions of
            %a{:href => "http://ncatlab.org/nlab/show/group+cohomology#LieGroupcohomology"} Lie group cohomology
            in the literature.
          .num_defn
            %h6#definition_4 Definition
            %p
              %strong (naive Lie group cohomology)
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              a Lie group and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              an abelian Lie group and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              define
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mi rest
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^n_{rest}(G,A)
              to be the group of equivalence classes of cocycles given by
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi G
                      %mi n
                      %mo ×
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} G^\times_n \to A
              by coboundatries given by smooth functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi G
                      %mrow
                        %msub
                          %mo ×
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} G^{\times_{n-1}} \to A
              subject to the usual relations.
          %p
            Observe that with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo =
                  %msup
                    %mi G
                    %mrow
                      %msub
                        %mo ×
                        %mo •
                %annotation{:encoding => "application/x-tex"} \mathbf{B}G = G^{\times_\bullet}
            regarded as an object of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sPSh
                    %mo{:stretchy => "false"} (
                    %mi CartSp
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} sPSh(CartSp)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi H
                    %mi rest
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi π
                    %mn 0
                  %mi sPSh
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo ,
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  H^n_{rest}(G,A)
                  \=
                  \\pi_0 sPSh(\mathbf{B}G, \mathbf{B}^n A)
                  \\,.
          %p
            Written this way it is evident that this definition misses to take into account any cofibrant replacement of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G
          %p
            A more refined definition of cohomology of Lie groups has been given by (
            %a{:href => "#Segal"}> Segal
            ), which was later rediscovered by (
            %a{:href => "#Brylinski"}> Brylinski
            ), following (
            %a{:href => "#Blanc"}> Blanc
            ). A review is in section 4 of (
            %a{:href => "#SchommerPries"}> Schommer-Pries
            ).
          .num_defn
            %h6#definition_5 Definition
            %p
              %strong (differential Lie group cohomology)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              be a
              %a.existingWikiWord{:href => "/nlab/show/paracompact+space"} paracompact
              %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              an abelian Lie group.
            %p
              For eack
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
              we can pick a
              %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msubsup
                      %mi U
                      %mi i
                      %mi k
                    %mo →
                    %msup
                      %mi G
                      %mrow
                        %msub
                          %mo ×
                          %mi k
                    %mo{:stretchy => "false"} |
                    %mi i
                    %mo ∈
                    %msub
                      %mi I
                      %mi k
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U^{k}_{i} \to G^{\times_k}| i \in I_k\}
              such that
            %ul
              %li
                %p
                  the index sets arrange themselves into a
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi I
                          %mo :
                          %mo{:stretchy => "false"} [
                          %mi k
                          %mo{:stretchy => "false"} ]
                          %mo ↦
                          %msub
                            %mi I
                            %mi k
                        %annotation{:encoding => "application/x-tex"} I : [k] \mapsto I_k
              %li
                %p
                  and for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi d
                          %mi j
                        %mo{:stretchy => "false"} (
                        %msubsup
                          %mi U
                          %mi i
                          %mi k
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} d_j(U^k_i)
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi s
                          %mi j
                        %mo{:stretchy => "false"} (
                        %msubsup
                          %mi U
                          %mi i
                          %mi k
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} s_j(U^k_i)
                  the images of the face and degeneracy maps of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi G
                          %mrow
                            %mo ×
                            %mo •
                      %annotation{:encoding => "application/x-tex"} G^{\times\bullet}
                  we have
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi d
                          %mi j
                        %mo{:stretchy => "false"} (
                        %msubsup
                          %mi U
                          %mi i
                          %mi k
                        %mo{:stretchy => "false"} )
                        %mo ⊂
                        %msubsup
                          %mi U
                          %mrow
                            %msub
                              %mi d
                              %mi j
                            %mo{:stretchy => "false"} (
                            %mi i
                            %mo{:stretchy => "false"} )
                          %mrow
                            %mi k
                            %mo −
                            %mn 1
                      %annotation{:encoding => "application/x-tex"}
                        d_j(U^k_i) \subset U^{k-1}_{d_j(i)}
                %p and
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi s
                          %mi j
                        %mo{:stretchy => "false"} (
                        %msubsup
                          %mi U
                          %mi i
                          %mi k
                        %mo{:stretchy => "false"} )
                        %mo ⊂
                        %msubsup
                          %mi U
                          %mrow
                            %msub
                              %mi s
                              %mi j
                            %mo{:stretchy => "false"} (
                            %mi i
                            %mo{:stretchy => "false"} )
                          %mrow
                            %mi k
                            %mo +
                            %mn 1
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        s_j(U^k_i) \subset U^{k+1}_{s_j(i)}
                        \\,.
            %p
              For instance start with a
              %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msubsup
                      %mi U
                      %mi i
                      %mn 1
                    %mo →
                    %mi G
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U^1_i \to G\}
              and define a good open cover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msubsup
                      %mi U
                      %mrow
                        %msub
                          %mi i
                          %mn 0
                        %msub
                          %mi i
                          %mn 1
                        %msub
                          %mi i
                          %mn 2
                      %mn 2
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U^2_{i_0 i_1 i_2}\}
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ×
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G \times G
              by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi U
                        %mrow
                          %msub
                            %mi i
                            %mn 0
                          %msub
                            %mi i
                            %mn 1
                          %msub
                            %mi i
                            %mn 2
                        %mn 2
                      %mo :
                      %mo =
                      %msubsup
                        %mi d
                        %mn 0
                        %mo *
                      %msubsup
                        %mi U
                        %mrow
                          %msub
                            %mi i
                            %mn 0
                        %mn 1
                      %mo ∩
                      %msubsup
                        %mi d
                        %mn 1
                        %mo *
                      %msubsup
                        %mi U
                        %mrow
                          %msub
                            %mi i
                            %mn 1
                        %mn 1
                      %mo ∩
                      %msubsup
                        %mi d
                        %mn 2
                        %mo *
                      %msubsup
                        %mi U
                        %mrow
                          %msub
                            %mi i
                            %mn 2
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} U^2_{i_0 i_1 i_2} := d_0^* U^1_{i_0} \cap d_1^* U^1_{i_1} \cap d_2^* U^1_{i_2}
            %p
              Then the
              %strong
                %a{:href => "http://ncatlab.org/nlab/show/group+cohomology#LieGroupcohomology"} differentiable Lie group cohomology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mi diffr
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^\bullet_{diffr}(G,A)
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              with coefficients in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is the cohomology of the total complex of the
              %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech
              double complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi U
                      %mrow
                        %msub
                          %mi i
                          %mn 0
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %msub
                          %mi i
                          %mo •
                      %mo •
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^\infty( U^{\bullet}_{i_0, \cdots, i_\bullet} , A)
              whose differentials are the alternating sums of the face maps of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi G
                      %mrow
                        %msub
                          %mo ×
                          %mo •
                  %annotation{:encoding => "application/x-tex"} G^{\times_\bullet}
              and of the
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mi diff
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %msup
                      %mi H
                      %mi n
                    %mi Tot
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi U
                      %mrow
                        %msub
                          %mi i
                          %mn 0
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %msub
                          %mi i
                          %mo •
                      %mo •
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    H^n_{diff}(G,A) := H^n Tot C^\infty( U^{\bullet}_{i_0, \cdots, i_\bullet} , A)
          %p
            This is (
            %a{:href => "#Brylinski"}> Brylinski, definition 1.1
            ).
          %p
            As discussed there, this is equivalent to other definitions, notably to a definition given earlier in (
            %a{:href => "#Segal"}> Segal
            ).
          .num_lemma
            %h6#observation Observation
            %p There is a natural map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mi restr
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msubsup
                      %mi H
                      %mi diffr
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    H^n_{restr}(G,A) \to H^n_{diffr}(G,A)
            %p obtained by pulling back globally defined cocycles and coboundaries to good covers.
          %p
            We can understand this differentiable Lie group cohomology in terms of maps out of a certain resolution of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{B}G
            in
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sPSh
                    %mo{:stretchy => "false"} (
                    %mi CartSp
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi proj
                        %mo ,
                        %mi cov
                  %annotation{:encoding => "application/x-tex"} sPSh(CartSp)_{proj,cov}
          .num_prop
            %h6#proposition_8 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msubsup
                      %mi U
                      %mrow
                        %msub
                          %mi i
                          %mo •
                      %mo •
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U^\bullet_{i_\bullet}\}
              a system of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo :
                    %mo{:stretchy => "false"} [
                    %mi k
                    %mo{:stretchy => "false"} ]
                    %mo ↦
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msubsup
                      %mi U
                      %mi i
                      %mi k
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    C : [k] \mapsto C(\{U^k_{i}\})
            %p
              which is degreewise a cofibrant resolution on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sPSh
                    %mo{:stretchy => "false"} (
                    %mi CartSp
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi proj
                        %mo ,
                        %mi cov
                  %annotation{:encoding => "application/x-tex"} sPSh(CartSp)_{proj,cov}
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi G
                        %mrow
                          %msub
                            %mo ×
                            %mi n
                    %annotation{:encoding => "application/x-tex"} G^{\times_n}
              %a.existingWikiWord{:href => "/nlab/show/bisimplicial+set"} totalization
              %a.existingWikiWord{:href => "/nlab/show/coend"} coend
              is connected by a zig-zag of weak equivalences in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sPSh
                    %mo{:stretchy => "false"} (
                    %mi CartSp
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi proj
                        %mo ,
                        %mi cov
                  %annotation{:encoding => "application/x-tex"} sPSh(CartSp)_{proj,cov}
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mover
                      %mo ←
                      %mo ≃
                    %mover
                      %mo →
                      %mo ≃
                    %msup
                      %mo ∫
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi k
                        %mo{:stretchy => "false"} ]
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi k
                    %mo{:stretchy => "false"} ]
                    %mo ⋅
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msubsup
                      %mi U
                      %mi i
                      %mi k
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{B}G
                    \\stackrel{\simeq}{\leftarrow}
                    \\stackrel{\simeq}{\to}
                    \\int^{[k]} \Delta[k] \cdot C(\{U^k_i\})
            %p and we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mi diffr
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi π
                      %mn 0
                    %mi sPSh
                    %mo{:stretchy => "false"} (
                    %mi CartSp
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msup
                      %mo ∫
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi k
                        %mo{:stretchy => "false"} ]
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi k
                    %mo{:stretchy => "false"} ]
                    %mo ⋅
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msubsup
                      %mi U
                      %mi i
                      %mi k
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^n_{diffr}(G,A)
                    \=
                    \\pi_0 sPSh(CartSp)(\int^{[k]} \Delta[k] \cdot C(\{U^k_i\}), \mathbf{B}^n A)
                    \\,.
          %p The proof of this will also show the following
          .num_prop
            %h6#proposition_9 Proposition
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %msub
                      %mi π
                      %mn 0
                    %msub
                      %mi Sh
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi CartSp
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo ,
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^\bullet(G,A) := \pi_0 Sh_{(\infty,1)}(CartSp)(\mathbf{B}G, \mathbf{B}^n A)
              for the intrinsic cohomology of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G
              regarded as an object of the
              = succeed "-topos" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              = succeed "-Lie" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
            %p There is a natural morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mi diffr
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^n_{diffr}(G,A) \to H^n(G,A)
                    \\,.
          .proof
            %h6#proof_10 Proof
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}^n A
              does satisfy descent with respect to
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n-1)
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %a.existingWikiWord{:href => "/nlab/show/bundle+gerbe"} bundle gerbe
              over an
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              is trivializable), to compute the intrinsic cohomology we have to find a cofibrant replacement for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}G
            %p
              A cofibrant replacement of any paracompact
              %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo ,
                        %mi cov
                  %annotation{:encoding => "application/x-tex"} [CartSp^{op}, sSet]_{proj,cov}
              is given by the
              %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≃
                    %mi X
                  %annotation{:encoding => "application/x-tex"} C(\{U_i\}) \stackrel{\simeq}{\to} X
              of a
              %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi U
                        %mi i
                      %mo →
                      %mi X
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{U_i \to X\}
              %a.existingWikiWord{:href => "/nlab/show/local+epimorphism"} local epimorphism
              as described at
              = succeed "." do
                %a{:href => "http://ncatlab.org/nlab/show/model+structure+on+simplicial+presheaves#CechLocalization"} model structure on simplicial presheaves - Cech localization
            %p
              Therefore from a choice of compatible families of open covers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msubsup
                      %mi U
                      %mi i
                      %mi k
                    %mo →
                    %msup
                      %mi G
                      %mrow
                        %mo ×
                        %mi k
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U^k_i \to G^{\times k}\}
              as in the definition of differentiable group cohomology above, we obtain cofibrant replacements
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msubsup
                      %mi U
                      %mi i
                      %mi k
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≃
                    %msup
                      %mi G
                      %mrow
                        %msub
                          %mo ×
                          %mi k
                  %annotation{:encoding => "application/x-tex"}
                    C(\{U^k_i\}) \stackrel{\simeq}{\to} G^{\times_k}
            %p
              for each
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msubsup
                      %mi U
                      %mi i
                      %mo •
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msup
                      %mi Δ
                      %mi op
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    C(\{U^\bullet_i\}) : \Delta^{op} \to [CartSp^{op}, sSet]
                    \\,,
            %p
              which is cofibrant in the injective
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+functors"} model structure on functors
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi Δ
                        %mi op
                      %mo ,
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi CartSp
                        %mi op
                      %mo ,
                      %mi sSet
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mrow
                          %mi proj
                          %mo ,
                          %mi cov
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi inj
                    %annotation{:encoding => "application/x-tex"} [\Delta^{op}, [CartSp^{op}, sSet]_{proj,cov}]_{inj}
            %p
              Observe that the fact that this is inded a simplicial diagram in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sPSh
                    %mo{:stretchy => "false"} (
                    %mi CartSp
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} sPSh(CartSp)
              is due to the extra compatibility condition in the above definition of differentiable Lie group cohomology.
            %p
              Notice from the discussion at
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
              that we have canonically another cofibrant replacement
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi G
                      %mrow
                        %msub
                          %mo ×
                          %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Q (G^{\times_n})
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi G
                      %mrow
                        %msub
                          %mo ×
                          %mi n
                  %annotation{:encoding => "application/x-tex"} G^{\times_n}
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                  %annotation{:encoding => "application/x-tex"} [CartSp^{op}, sSet]_{proj}
              which is functorial and has the special property that the
              %a.existingWikiWord{:href => "/nlab/show/bisimplicial+set"} diagonal
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∫
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi k
                        %mo{:stretchy => "false"} ]
                        %mo ∈
                        %mi Δ
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi k
                    %mo{:stretchy => "false"} ]
                    %mo ⋅
                    %mi Q
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi G
                      %mrow
                        %msub
                          %mo ×
                          %mi k
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≃
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"}
                    \\int^{[k] \in \Delta}
                    \\Delta[k] \cdot Q(G^{\times_k})
                    \\stackrel{\simeq}{\to}
                    \\mathbf{B}G
            %p
              is a cofibrant replacement of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Δ
                      %mi op
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi inj
                  %annotation{:encoding => "application/x-tex"} [\Delta^{op}, [CartSp^{op}, sSet]_{proj}]_{inj}
              we therefore have a zig-zag of weak equivalences
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msubsup
                      %mi U
                      %mi i
                      %mo •
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≃
                    %mover
                      %mo ←
                      %mo ≃
                    %mi Q
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi G
                      %mrow
                        %msub
                          %mo ×
                          %mo •
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    C(\{U^\bullet_i\}) \stackrel{\simeq}{\to}
                    \\stackrel{\simeq}{\leftarrow}
                    Q(G^{\times_\bullet})
            %p
              between cofibrant replacements of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi G
                        %mrow
                          %msub
                            %mo ×
                            %mo •
                    %annotation{:encoding => "application/x-tex"} G^{\times_\bullet}
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Δ
                      %mo •
                    %mo :
                    %mi Δ
                    %mo →
                    %mi sSet
                    %mo :
                    %mo{:stretchy => "false"} [
                    %mi k
                    %mo{:stretchy => "false"} ]
                    %mo ↦
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi Δ
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} [
                    %mi k
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{\Delta}^\bullet : \Delta \to sSet : [k] \mapsto N(\Delta/[k])
              for the standard
              %a.existingWikiWord{:href => "/nlab/show/Bousfield-Kan+map"} Bousfield-Kan
              cofibrant replacement of the point, hence also of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                    %annotation{:encoding => "application/x-tex"} \Delta
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi Δ
                    %mo ,
                    %msub
                      %mi sSet
                      %mi Quillen
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                  %annotation{:encoding => "application/x-tex"} [\Delta, sSet_{Quillen}]_{proj}
              (more discussion of this is at
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+colimit"} homotopy colimit
            %p
              Then by the fact that the
              %a.existingWikiWord{:href => "/nlab/show/coend"} coend
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∫
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo{:stretchy => "false"} [
                    %mi Δ
                    %mo ,
                    %msub
                      %mi sSet
                      %mi Quillen
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Δ
                      %mi op
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %msub
                      %mi sSet
                      %mi Quilen
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo ,
                        %mi cov
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi inj
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %msub
                      %mi sSet
                      %mi Quillen
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo ,
                        %mi cov
                  %annotation{:encoding => "application/x-tex"}
                    \\int (-)\otimes (-) : [\Delta,sSet_{Quillen}]_{proj} \times [\Delta^{op}, [CartSp^{op}, sSet_{Quilen}]_{proj,cov}]_{inj}
                    \\to
                    [CartSp^{op}, sSet_{Quillen}]_{proj,cov}
            %p
              over the
              %a.existingWikiWord{:href => "/nlab/show/copower"} tensoring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊗
                    %msub
                      %mi sSet
                      %mi Quillen
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %msub
                      %mi sSet
                      %mi Quillen
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo ,
                        %mi cov
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %msub
                      %mi sSet
                      %mi Quillen
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo ,
                        %mi cov
                  %annotation{:encoding => "application/x-tex"} \otimes sSet_{Quillen} \times [CartSp^{op}, sSet_{Quillen}]_{proj,cov} \to [CartSp^{op}, sSet_{Quillen}]_{proj,cov}
              is a left
              %a.existingWikiWord{:href => "/nlab/show/Quillen+bifunctor"} Quillen bifunctor
              (as discussed there), we have weak equivalences in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo ,
                        %mi cov
                  %annotation{:encoding => "application/x-tex"} [CartSp^{op}, sSet]_{proj,cov}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo =
                    %msup
                      %mo ∫
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi k
                        %mo{:stretchy => "false"} ]
                        %mo ∈
                        %mi Δ
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi k
                    %mo{:stretchy => "false"} ]
                    %mo ⋅
                    %msup
                      %mi G
                      %mrow
                        %msub
                          %mo ×
                          %mi n
                    %mover
                      %mo ←
                      %mo ≃
                    %msup
                      %mo ∫
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi k
                        %mo{:stretchy => "false"} ]
                        %mo ∈
                        %mi Δ
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi k
                    %mo{:stretchy => "false"} ]
                    %mo ⋅
                    %mi Q
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi G
                      %mrow
                        %msub
                          %mo ×
                          %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ←
                      %mo ≃
                    %msup
                      %mo ∫
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi k
                        %mo{:stretchy => "false"} ]
                        %mo ∈
                        %mi Δ
                    %mstyle{:mathvariant => "bold"}
                      %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi k
                    %mo{:stretchy => "false"} ]
                    %mo ⋅
                    %mi Q
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi G
                      %mrow
                        %msub
                          %mo ×
                          %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≃
                    %mover
                      %mo ←
                      %mo ≃
                    %msup
                      %mo ∫
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi k
                        %mo{:stretchy => "false"} ]
                        %mo ∈
                        %mi Δ
                    %mstyle{:mathvariant => "bold"}
                      %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi k
                    %mo{:stretchy => "false"} ]
                    %mo ⋅
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msubsup
                      %mi U
                      %mi i
                      %mi k
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≃
                    %msup
                      %mo ∫
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi k
                        %mo{:stretchy => "false"} ]
                        %mo ∈
                        %mi Δ
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi k
                    %mo{:stretchy => "false"} ]
                    %mo ⋅
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msubsup
                      %mi U
                      %mi i
                      %mi k
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{B}G
                    \=
                    \\int^{[k] \in \Delta}
                    \\Delta[k] \cdot G^{\times_n}
                    \\stackrel{\simeq}{\leftarrow}
                    \\int^{[k] \in \Delta} \Delta[k] \cdot Q(G^{\times_k}))
                    \\stackrel{\simeq}{\leftarrow}
                    \\int^{[k] \in \Delta} \mathbf{\Delta}[k] \cdot Q(G^{\times_k}))
                    \\stackrel{\simeq}{\to}
                    \\stackrel{\simeq}{\leftarrow}
                    \\int^{[k] \in \Delta} \mathbf{\Delta}[k] \cdot C(\{U^k_i\}))
                    \\stackrel{\simeq}{\to}
                    \\int^{[k] \in \Delta} \Delta[k] \cdot C(\{U^k_i\}))
            %p where
            %ul
              %li
                %p the first one is Dugger’s cofibrant replacement mentioned above, even a global weak equivalence;
              %li
                %p
                  the second one is objectwise the
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Bousfield-Kan+map"} Bousfield-Kan map
              %li
                %p
                  the zig-zag is the image under the left Quillen functor
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mo ∫
                          %mrow
                            %mo{:stretchy => "false"} [
                            %mi k
                            %mo{:stretchy => "false"} ]
                            %mo ∈
                            %mi Δ
                        %mstyle{:mathvariant => "bold"}
                          %mi Δ
                        %mo{:stretchy => "false"} [
                        %mi k
                        %mo{:stretchy => "false"} ]
                        %mo ⋅
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \int^{[k] \in \Delta} \mathbf{\Delta}[k] \cdot (-)
                  (using that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} mathf
                        %mi Δ
                      %annotation{:encoding => "application/x-tex"} \mathf{\Delta}
                  is cofibrant) of the above zig-zag of weak equivalences between cofibrant objects;
              %li
                %p
                  the last one is again the global weak equivalence coming objectwise from the
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/Bousfield-Kan+map"} Bousfield-Kan map
            %p
              This shows the first claim, that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                      %mover
                        %mo ←
                        %mo ≃
                      %mover
                        %mo →
                        %mo ≃
                      %msup
                        %mo ∫
                        %mi k
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mi k
                      %mo{:stretchy => "false"} ]
                      %mo ⋅
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} {
                      %msubsup
                        %mi U
                        %mi i
                        %mi k
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}G \stackrel{\simeq}{\leftarrow}\stackrel{\simeq}{\rightarrow} \int^{k} \Delta[k] \cdot C(\{U^k_i\})
            %p
              Moreover, again by the left Quillen bifunctor property of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∫
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \int(-)\cdot(-)
              we have that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∫
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi k
                        %mo{:stretchy => "false"} ]
                        %mo ∈
                        %mi Δ
                    %mstyle{:mathvariant => "bold"}
                      %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi k
                    %mo{:stretchy => "false"} ]
                    %mo ⋅
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msubsup
                      %mi U
                      %mi i
                      %mi k
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \int^{[k] \in \Delta} \mathbf{\Delta}[k] \cdot C(\{U^k_i\}))
              is cofibrant. Therefore the intrinsic cohomology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^n(G,A)
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo ,
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo ,
                        %mi cov
                    %mrow
                      %mo (
                      %msup
                        %mo ∫
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi k
                          %mo{:stretchy => "false"} ]
