                            %mo ≃
                            %msub
                              %mo ∫
                              %mi U
                            %mi sSet
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi K
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi U
                            %mi Ξ
                            %mi A
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} [
                            %mi n
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mo ∫
                              %mi U
