              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi CartSp
                        %mi op
                      %mo ,
                      %mi sSet
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi proj
                    %annotation{:encoding => "application/x-tex"} [CartSp^{op}, sSet]_{proj}
          .proof
            %h6#proof_25 Proof
            %p
              The morphism in question is on each object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                    %mi CartSp
                  %annotation{:encoding => "application/x-tex"} U \in CartSp
              the morphism of simplicial sets
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi dgAlg
                    %mo{:stretchy => "false"} (
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msubsup
                      %mi Ω
                      %mi si
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi Hom
                      %mi dgAlg
                    %mo{:stretchy => "false"} (
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msubsup
                      %mi Ω
                      %mi si
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %msup
                      %mi Δ
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{dgAlg}(CE(\mathfrak{g}), \Omega_{si}^\bullet(\Delta^k))
                    \\to
                    Hom_{dgAlg}(CE(\mathfrak{g}), \Omega_{si}^\bullet(U \times \Delta^k))
                    \\,,
            %p
              which is given by pullback of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/differential+form"} differential form
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ×
                      %msup
                        %mi Δ
                        %mi k
                      %mo →
                      %msup
                        %mi Δ
                        %mi k
                    %annotation{:encoding => "application/x-tex"} U \times \Delta^k \to \Delta^k
            %p
              To show that for fixed
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              this is a weak equivalence in the standard
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+sets"} model structure on simplicial sets
              we produce objectwise a left inverse
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi U
                    %mo :
                    %msub
                      %mi Hom
                      %mi dgAlg
                    %mo{:stretchy => "false"} (
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msubsup
                      %mi Ω
                      %mi si
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %msup
                      %mi Δ
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi Hom
                      %mi dgAlg
                    %mo{:stretchy => "false"} (
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msubsup
                      %mi Ω
                      %mi si
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    F_U
                    \:
                    Hom_{dgAlg}(CE(\mathfrak{g}), \Omega_{si}^\bullet(U \times \Delta^\bullet))
                    \\to
                    Hom_{dgAlg}(CE(\mathfrak{g}), \Omega_{si}^\bullet(\Delta^\bullet))
            %p
              and show that this is an acyclic fibration of simplicial sets. The statement then follows by the
              = succeed "-property" do
                %a.existingWikiWord{:href => "/nlab/show/category+with+weak+equivalences"} 2-out-of-3
            %p
              We take
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi U
                  %annotation{:encoding => "application/x-tex"} F_U
              to be given by evaluation at
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo :
                      %mo *
                      %mo →
                      %mi U
                    %annotation{:encoding => "application/x-tex"} 0: * \to U
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %msup
                      %mi Δ
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %mi Id
                        %mo ×
                        %msup
                          %mn 0
                          %mo *
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo ×
                    %msup
                      %mi Δ
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^\bullet(U \times \Delta^k )
                    \\stackrel{Id \times 0^*}{\to}
                    \\Omega^\bullet(* \times \Delta^k )
                    \=
                    \\Omega^\bullet(\Delta^k)
                    \\,.
            %p
              (This of course is not natural in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              and hence does not extend to a morphism of simplicial presheaves. But for our argument here it need not.)
            %p
              The morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi U
                  %annotation{:encoding => "application/x-tex"} F_U
              is an acyclic
              %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"} Kan fibration
              precisely if all diagrams of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo ∂
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mi n
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mo →
                          %mtd
                            %mi Hom
                            %mo{:stretchy => "false"} (
                            %mi CE
                            %mo{:stretchy => "false"} (
                            %mi 𝔤
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %msubsup
                              %mi Ω
                              %mi si
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo ×
                            %msup
                              %mi Δ
                              %mo •
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi F
                                    %mi U
                        %mtr
                          %mtd
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mi n
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mover
                              %mo →
                              %mrow
                          %mtd
                            %mi Hom
                            %mo{:stretchy => "false"} (
                            %mi CE
                            %mo{:stretchy => "false"} (
                            %mi 𝔤
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %msubsup
                              %mi Ω
                              %mi si
                              %mo •
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi Δ
                              %mo •
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\partial \Delta[n] &amp;\to&amp;
                    Hom(CE(\mathfrak{g}), \Omega_{si}^\bullet(U \times \Delta^\bullet ))
                    \\\
                    {}^{\mathllap{}}\downarrow &amp;&amp; \downarrow^\mathrlap{F_U}
                    \\\
                    \\Delta[n]
                    \&amp;\stackrel{}{\to}&amp;
                    Hom(CE(\mathfrak{g}), \Omega_{si}^\bullet(\Delta^\bullet))
                    }
            %p
              have a lift. Using the
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
              over the
              %a.existingWikiWord{:href => "/nlab/show/simplex+category"} simplex category
              and since the differential forms on the simplices have sitting instants, we may, as above, equivalently reformulate this in terms of spheres as follows:
            %p
              for every morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msubsup
                      %mi Ω
                      %mi si
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi D
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CE(\mathfrak{g}) \to \Omega^\bullet_{si}(D^n)
              and morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msubsup
                      %mi Ω
                      %mi si
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %msup
                      %mi S
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CE(\mathfrak{g}) \to \Omega^\bullet_{si}(U \times S^{n-1})
              such that the diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi CE
                            %mo{:stretchy => "false"} (
                            %mi 𝔤
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %msup
                              %mi Ω
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo ×
                            %msup
                              %mi S
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msubsup
                              %mi Ω
                              %mi si
                              %mo •
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi D
                              %mi n
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %msup
                              %mi Ω
                              %mo •
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi S
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    CE(\mathfrak{g}) &amp;\to&amp; \Omega^\bullet(U \times S^{n-1})
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    \\Omega_{si}^\bullet(D^n) &amp;\to&amp; \Omega^\bullet(S^{n-1})
                    }
            %p commutes, this may be factored as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi CE
                            %mo{:stretchy => "false"} (
                            %mi 𝔤
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msubsup
                              %mi Ω
                              %mi si
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo ×
                            %msup
                              %mi D
                              %mi n
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %msup
                              %mi Ω
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo ×
                            %msup
                              %mi S
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mi Ω
                              %mo •
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi D
                              %mi n
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %msup
                              %mi Ω
                              %mo •
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi S
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    CE(\mathfrak{g})
                    \\\
                    \&amp; \searrow
                    \\\
                    \&amp;&amp;\Omega_{si}^\bullet(U \times D^n)
                    \&amp;\to&amp; \Omega^\bullet(U \times S^{n-1})
                    \\\
                    \&amp;&amp;\downarrow &amp;&amp; \downarrow
                    \\\
                    \&amp;&amp;\Omega^\bullet(D^n) &amp;\to&amp; \Omega^\bullet(S^{n-1})
                    }
                    \\,.
            %p
              (Here the subscript “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mrow
                      %mi si
                  %annotation{:encoding => "application/x-tex"} {}_{si}
              ” denotes differential forms on the disk that are radially constant in a neighbourhood of the boundary.)
            %p This factorization we now construct.
            %p
              Let first
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} f : [0,1] \to [0,1]
              be any smoothing function, i.e. a
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              which is surjective, non-decreasing, and constant in a neighbourhood of the boundary. Define a smooth map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi U
                  %annotation{:encoding => "application/x-tex"}
                    U \times [0,1] \to U
            %p by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo ,
                    %mi σ
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mi u
                    %mo ⋅
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo −
                    %mi σ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    (u,\sigma) \mapsto u \cdot f(1-\sigma)
                    \\,,
            %p
              where we use the multiplicative structure on the
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \sigma = 0
              and is the constant map to the origin at
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} \sigma = 1
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
            %p Pullback of differential forms along this map produces a morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %msup
                      %mi S
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %msup
                      %mi S
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^\bullet(U \times S^{n-1})
                    \\to
                    \\Omega^\bullet(U \times S^{n-1} \times [0,1])
            %p
              which is such that a form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              is sent to a form which in a neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo −
                    %mi ϵ
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} (1-\epsilon,1]
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} 1 \in [0,1]
              is constant along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo −
                    %mi ϵ
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ×
                    %mi U
                  %annotation{:encoding => "application/x-tex"} (1-\epsilon,1] \times U
              on the value
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo ,
                      %msub
                        %mi Id
                        %mrow
                          %msup
                            %mi S
                            %mrow
                              %mi n
                              %mo −
                              %mn 1
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                      %mi ω
                    %annotation{:encoding => "application/x-tex"} (0 , Id_{S^{n-1}})^* \omega
            %p
              (Notice that this step does not respect vertical forms. This is the crucial difference between
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msubsup
                      %mi Ω
                      %mi si
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %msup
                      %mi Δ
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mo ←
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{\Omega^\bullet_{si}(U \times \Delta ^k) \leftarrow CE(\mathfrak{g})\}
              and
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msubsup
                        %mi Ω
                        %mrow
                          %mi si
                          %mo ,
                          %mi vert
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo ×
                      %msup
                        %mi Δ
                        %mi k
                      %mo{:stretchy => "false"} )
                      %mo ←
                      %mi CE
                      %mo{:stretchy => "false"} (
                      %mi 𝔤
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{\Omega^\bullet_{si,vert}(U \times \Delta ^k) \leftarrow CE(\mathfrak{g})\}
            %p
              Let now
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo &lt;
                    %mi ϵ
                    %mo ∈
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} 0 \lt \epsilon \in \mathbb{R}
              some value such that the given forms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msubsup
                      %mi Ω
                      %mi si
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi D
                      %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CE(\mathfrak{g}) \to \Omega^\bullet_{si}(D^k)
              are constant a distance
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo ≤
                    %mi ϵ
                  %annotation{:encoding => "application/x-tex"} d \leq \epsilon
              from the boundary of the disk. Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo :
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mi ϵ
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} q : [0,\epsilon/2] \to [0,1]
              be given by multiplication by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mi ϵ
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} 1/(\epsilon/2)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo :
                    %msubsup
                      %mi D
                      %mrow
                        %mn 1
                        %mo −
                        %mi ϵ
                        %mo{:stretchy => "false"} /
                        %mn 2
                      %mi k
                    %mo →
                    %msubsup
                      %mi D
                      %mn 1
                      %mi n
                  %annotation{:encoding => "application/x-tex"} h : D_{1-\epsilon/2}^k \to D_1^n
              the injection of the
              = succeed "-disk" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo −
                    %mi ϵ
                    %mo{:stretchy => "false"} /
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 1-\epsilon/2
              into the unit
              = succeed "-disk." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            %p We can then glue to the morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %msup
                      %mi S
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ×
                    %msup
                      %mi S
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mover
                      %mrow
                        %msub
                          %mo →
                          %mo ≃
                      %mrow
                        %mi id
                        %mo ×
                        %msup
                          %mi q
                          %mo *
                        %mo ×
                        %mi id
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mi ϵ
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mo{:stretchy => "false"} ]
                    %mo ×
                    %msup
                      %mi S
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    CE(\mathfrak{g}) \to
                    \\Omega^\bullet(U \times S^{n-1})
                    \\to
                    \\Omega^\bullet(U \times [0,1] \times S^{n-1})
                    \\stackrel{id \times q^* \times id}{\to_\simeq}
                    \\Omega^\bullet(U \times [0,\epsilon/2] \times S^{n-1})
            %p to the morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi D
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo{:stretchy => "false"} }
                    %mo ×
                    %msup
                      %mi D
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mover
                      %mrow
                        %msub
                          %mo →
                          %mo ≃
                      %mrow
                        %msup
                          %mi h
                          %mo *
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo{:stretchy => "false"} }
                    %mo ×
                    %msubsup
                      %mi D
                      %mrow
                        %mn 1
                        %mo −
                        %mi ϵ
                        %mo{:stretchy => "false"} /
                        %mn 2
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    CE(\mathfrak{g}) \to \Omega^\bullet(D^n)
                    \\to
                    \\Omega^\bullet(U \times \{1\} \times D^n)
                    \\stackrel{h^*}{\to_\simeq}
                    \\Omega^\bullet(U \times \{1\} \times D^n_{1-\epsilon/2})
            %p
              by smoothly identifying the union
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mi ϵ
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mo{:stretchy => "false"} ]
                    %mo ×
                    %msup
                      %mi S
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %msup
                          %mi S
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                    %msubsup
                      %mi D
                      %mrow
                        %mn 1
                        %mo −
                        %mi ϵ
                        %mo{:stretchy => "false"} /
                        %mn 2
                      %mi n
                  %annotation{:encoding => "application/x-tex"} [0,\epsilon/2] \times S^{n-1} \coprod_{S^{n-1}} D^n_{1-\epsilon/2}
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mi n
                  %annotation{:encoding => "application/x-tex"} D^n
              (we glue a disk into an annulus to obtain a new disk) to obtain in total a morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %msup
                      %mi D
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    CE(\mathfrak{g}) \to \Omega^\bullet(U \times D^n)
            %p
              with the desired properties: at
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} u = 0
              the homotopy that we constructed is constant and the above construction hence restricts the forms to radius
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≤
                    %mn 1
                    %mo −
                    %mi ϵ
                    %mo{:stretchy => "false"} /
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} \leq 1-\epsilon/2
              and then extends back to radius
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≤
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \leq 1
              by the constant value that they had before. Away from 0 the homotopy in the rmaining
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo{:stretchy => "false"} /
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} \epsilon/2
              bit smoothly interpolates to the boundary value.
          .num_lemma
            %h6#lemma_2 Lemma
            %p The canonical morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mo ♭
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi smp
                    %mo →
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{\flat}\exp(\mathfrak{g})_{smp}
                    \\to
                    \\exp(\mathfrak{g})
            %p
              is a fibration in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msubsup
                        %mi CartSp
                        %mi smooth
                        %mi op
                      %mo ,
                      %mi sSet
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi proj
                    %annotation{:encoding => "application/x-tex"} [CartSp_{smooth}^{op}, sSet]_{proj}
          .proof
            %h6#proof_26 Proof
            %p
              Over each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                    %mi CartSp
                  %annotation{:encoding => "application/x-tex"} U \in CartSp
              the morphism is induced from the morphism of dg-algebras
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^\bullet(U) \to C^\infty(U)
            %p that discards all differential forms of non-vanishing degree.
            %p It is sufficient to show that for
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msubsup
                      %mi Ω
                      %mrow
                        %mi si
                        %mo ,
                        %mi vert
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi D
                      %mi n
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    CE(\mathfrak{g})
                    \\to
                    \\Omega_{si,vert}^\bullet(
                    U \times (D^n \times [0,1])
                    )
            %p a morphism and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msubsup
                      %mi Ω
                      %mi si
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %msup
                      %mi D
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    CE(\mathfrak{g}) \to \Omega^\bullet_{si}(U \times D^n )
            %p
              a lift of its restriction to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo =
                    %mn 0
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \sigma = 0 \in [0,1]
              we have an extension to a lift
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msubsup
                      %mi Ω
                      %mrow
                        %mi si
                        %mo ,
                        %mi vert
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi D
                      %mi n
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    CE(\mathfrak{g}) \to \Omega_{si,vert}^\bullet(U \times (D^n \times [0,1]))
                    \\,.
            %p From these lifts all the required lifts are obtained by precomposition with some evident smooth retractions.
            %p
              The idea of the proof is that the lifts in question are obtained from solving
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/differential+equation"} differential equation
              %a.existingWikiWord{:href => "/nlab/show/Bianchi+identities"} Bianchi identities
              for flat
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebroid+valued+differential+forms"} ∞-Lie algebroid valued differential forms
            %p
              %strong
                1st case:
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                      %mo =
                      %msup
                        %mi b
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g} = b^{n-1} \mathbb{R}
            %p
              We condsider the case
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                      %mo =
                      %msup
                        %mi b
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g} = b^{n-1} \mathbb{R}
            %p
              A morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi b
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msubsup
                      %mi Ω
                      %mrow
                        %mi si
                        %mo ,
                        %mi vert
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi D
                      %mi k
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CE(b^{n-1} \mathbb{R}) \to \Omega_{si,vert}^\bullet( U \times (D^k \times [0,1]))
              is a
              = succeed "-parameterized" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              = succeed "-forms" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo =
                    %msub
                      %mi A
                      %mrow
                        %msup
                          %mi D
                          %mi k
                    %mo +
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mi σ
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mi λ
                  %annotation{:encoding => "application/x-tex"} A = A_{D^k} + (d \sigma) \wedge \lambda
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mi k
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} D^k \times [0,1]
              satisfying
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mrow
                        %msup
                          %mi D
                          %mi k
                    %msub
                      %mi A
                      %mrow
                        %msup
                          %mi D
                          %mi k
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    d_{D^k} A_{D^k} = 0
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∂
                      %mi σ
                    %msub
                      %mi A
                      %mrow
                        %msup
                          %mi D
                          %mi k
                    %mo =
                    %msub
                      %mi d
                      %mrow
                        %msup
                          %mi D
                          %mi k
                    %mi λ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\partial_\sigma A_{D^k} = d_{D^k} \lambda
                    \\,.
            %p
              Consider a lift of the restriction to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \sigma = 0
              by a term
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mrow
                        %msup
                          %mi D
                          %mi k
                    %mo +
                    %msub
                      %mi A
                      %mrow
                        %mi U
                        %mo ×
                        %msup
                          %mi D
                          %mi k
                  %annotation{:encoding => "application/x-tex"} A_{D^k} + A_{U  \times D^k}
              being a morphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi CE
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi b
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                      %mi ℝ
                      %mo{:stretchy => "false"} )
                      %mo →
                      %msubsup
                        %mi Ω
                        %mi si
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo ×
                      %msub
                        %mi D
                        %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} CE(b^{n-1}\mathbb{R}) \to \Omega^\bullet_{si}(U \times D_k )
            %p
              We can extend this to a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi b
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msubsup
                      %mi Ω
                      %mi si
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %msub
                      %mi D
                      %mi k
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CE(b^{n-1}\mathbb{R}) \to \Omega^\bullet_{si}(U \times D_k \times [0,1])
              by lifting
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                  %annotation{:encoding => "application/x-tex"} \lambda
              without adding any terms to it and solving the differential equation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∂
                      %mi σ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mrow
                        %msup
                          %mi D
                          %mi k
                    %mo +
                    %msub
                      %mi A
                      %mrow
                        %mi U
                        %mo ×
                        %msup
                          %mi D
                          %mi k
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi d
                      %mi U
                    %mo +
                    %msub
                      %mi d
                      %mrow
                        %msup
                          %mi D
                          %mi k
                    %mo{:stretchy => "false"} )
                    %mi λ
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\partial_\sigma (A_{D^k} + A_{U \times D^k} ) = (d_U + d_{D^k}) \lambda
                    \\,,
            %p equivalently for the new term
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∂
                      %mi σ
                    %msub
                      %mi A
                      %mrow
                        %mi U
                        %mo ×
                        %msup
                          %mi D
                          %mi k
                    %mo =
                    %msub
                      %mi d
                      %mi U
                    %mi λ
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\partial_\sigma A_{U \times D^k}  = d_U \lambda
                    \\,,
            %p
              with boundary condition the given value at
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \sigma = 0
            %p
              For this unique solution to be a lift we need in addition that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi d
                        %mi U
                      %mo +
                      %msub
                        %mi d
                        %mrow
                          %msup
                            %mi D
                            %mi k
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi A
                        %mrow
                          %msup
                            %mi D
                            %mi k
                      %mo +
                      %msub
                        %mi A
                        %mrow
                          %mi U
                          %mo ×
                          %msup
                            %mi D
                            %mi k
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} (d_U + d_{D^k}) (A_{D^k} + A_{U \times D^k}) = 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \sigma = 0
              by assumption of the lift at that end, we need to check that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∂
                      %mi σ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi d
                      %mi U
                    %mo +
                    %msub
                      %mi d
                      %mrow
                        %msup
                          %mi D
                          %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mrow
                        %msup
                          %mi D
                          %mi k
                    %mo +
                    %msub
                      %mi A
                      %mrow
                        %mi U
                        %mo ×
                        %msup
                          %mi D
                          %mi k
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\partial_\sigma (d_U + d_{D^k}) (A_{D^k} + A_{U \times D^k}) = 0
                    \\,.
            %p
              But by the above this follows from the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Bianchi+identity"} Bianchi identity
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi d
                      %mi U
                    %mo +
                    %msub
                      %mi d
                      %mrow
                        %msup
                          %mi D
                          %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi d
                      %mi U
                    %mo +
                    %msub
                      %mi d
                      %mrow
                        %msup
                          %mi D
                          %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mrow
                        %msup
                          %mi D
                          %mi k
                    %mo +
                    %msub
                      %mi A
                      %mrow
                        %mi U
                        %mo ×
                        %msup
                          %mi D
                          %mi k
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots =
                    (d_U + d_{D^k}) (d_U + d_{D^k}) (A_{D^k} + A_{U \times D^k}) = 0
                    \\,.
            %p
              %strong
                2nd case:
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                      %mi an
                      %mi arbitrary
                      %mi Lie
                      %mi algebra
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g} an arbitrary Lie algebra
            %p
              Now let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              be an ordinary Lie algebra. Choose a dual basis
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi t
                      %mi a
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{t^a\}
              and structue constants
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mi a
                      %msub
                        %mrow
                        %mrow
                          %mi b
                          %mi c
                    %annotation{:encoding => "application/x-tex"} C^a{}_{b c}
            %p
              the original element is a collection of 1-forms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi A
                      %mi v
                      %mi a
                    %mi d
                    %mi v
                    %mo +
                    %msubsup
                      %mi A
                      %mi σ
                      %mi a
                    %mi d
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} A^a_v d v + A^a_\sigma d \sigma
              satisfying
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∂
                      %mi σ
                    %msubsup
                      %mi A
                      %mi v
                      %mi a
                    %mo =
                    %msub
                      %mo ∂
                      %mi v
                    %msub
                      %mi A
                      %mi σ
                    %mo −
                    %msup
                      %mi C
                      %mi a
                    %msub
                      %mrow
                      %mrow
                        %mi b
                        %mi c
                    %msubsup
                      %mi A
                      %mi v
                      %mi b
                    %msubsup
                      %mi A
                      %mi σ
                      %mi c
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\partial_\sigma A_v^a = \partial_v A_\sigma
                    \- C^a{}_{b c} A_v^b A_\sigma^c
                    \\,.
            %p
              We lift by adding a term
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi A
                      %mi u
                      %mi a
                    %mi d
                    %mi u
                  %annotation{:encoding => "application/x-tex"} A_u^a d u
              that is uniquely fixed by the condition that it solves the differential equation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∂
                      %mi σ
                    %msub
                      %mi A
                      %mi u
                    %mo =
                    %msub
                      %mo ∂
                      %mi u
                    %msub
                      %mi A
                      %mi σ
                    %mo −
                    %msup
                      %mi C
                      %mi a
                    %msub
                      %mrow
                      %mrow
                        %mi b
                        %mi c
                    %msubsup
                      %mi A
                      %mi σ
                      %mi b
                    %msubsup
                      %mi A
                      %mi u
                      %mi c
                  %annotation{:encoding => "application/x-tex"}
                    \\partial_\sigma A_u = \partial_u A_\sigma
                    \- C^a{}_{b c} A_\sigma^b  A_u^c
            %p
              for given boundary value at
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \sigma = 0
            %p We need to show that the lift found this way also satisfies the equation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi F
                      %mrow
                        %mi v
                        %mi u
                      %mi a
                    %mo :
                    %mo =
                    %msub
                      %mo ∂
                      %mi v
                    %msubsup
                      %mi A
                      %mi u
                      %mi a
                    %mo −
                    %msub
                      %mo ∂
                      %mi u
                    %msubsup
                      %mi A
                      %mi v
                      %mi a
                    %mo +
                    %msup
                      %mi C
                      %mi a
                    %msub
                      %mrow
                      %mrow
                        %mi b
                        %mi c
                    %msubsup
                      %mi A
                      %mi v
                      %mi b
                    %msubsup
                      %mi A
                      %mi u
                      %mi c
                    %mo =
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    F_{v u}^a
                    \:=
                    \\partial_v A^a_u - \partial_u A^a_v + C^a{}_{b c} A_v^b A_u^c = 0
                    \\,.
            %p
              By assumption, this is true at
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \sigma = 0
              = succeed "-derivative" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                    %annotation{:encoding => "application/x-tex"} \sigma
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∂
                      %mi σ
                    %msubsup
                      %mi F
                      %mrow
                        %mi v
                        %mi u
                      %mi a
                    %mo =
                    %msup
                      %mi C
                      %mi a
                    %msub
                      %mrow
                      %mrow
                        %mi b
                        %mi c
                    %msubsup
                      %mi A
                      %mi σ
                      %mi b
                    %msubsup
                      %mi F
                      %mrow
                        %mi v
                        %mi u
                      %mi c
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\partial_\sigma F^a_{v u}
                    \=
                    C^a{}_{b c} A^b_\sigma F^c_{v u}
                    \\,.
            %p
              A solution to this differential equation with initial value 0 is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi F
                        %mrow
                          %mi v
                          %mi u
                        %mi a
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} F^a_{v u} = 0
            %p Now compute:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mo ∂
                              %mi σ
                            %msubsup
                              %mi F
                              %mrow
                                %mi u
                                %mi v
                              %mi a
                          %mtd
                            %mo :
                            %mo =
                            %msub
                              %mo ∂
                              %mi σ
                            %msub
                              %mo ∂
                              %mi u
                            %msubsup
                              %mi A
                              %mi v
                              %mi a
                            %mo −
                            %msub
                              %mo ∂
                              %mi σ
                            %msub
                              %mo ∂
                              %mi v
                            %msubsup
                              %mi A
                              %mi u
                              %mi a
                            %mo +
                            %msub
                              %mo ∂
                              %mi σ
                            %msup
                              %mi C
                              %mi a
                            %msub
                              %mrow
                              %mrow
                                %mi b
                                %mi c
                            %msubsup
                              %mi A
                              %mi u
                              %mi b
                            %msubsup
                              %mi A
                              %mi v
                              %mi c
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mo ∂
                              %mi u
                            %msub
                              %mo ∂
                              %mi σ
                            %msubsup
                              %mi A
                              %mi v
                              %mi a
                            %mo −
                            %msub
                              %mo ∂
                              %mi v
                            %msub
                              %mo ∂
                              %mi σ
                            %msubsup
                              %mi A
                              %mi u
                              %mi a
                            %mo +
                            %msub
                              %mo ∂
                              %mi σ
                            %msup
                              %mi C
                              %mi a
                            %msub
                              %mrow
                              %mrow
                                %mi b
                                %mi c
                            %msubsup
                              %mi A
                              %mi u
                              %mi b
                            %mo ∧
                            %msubsup
                              %mi A
                              %mi v
                              %mi c
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mo ∂
                              %mi u
                            %mo{:stretchy => "false"} (
                            %msub
                              %mo ∂
                              %mi v
                            %msubsup
                              %mi A
                              %mi σ
                              %mi a
                            %mo −
                            %msup
                              %mi C
                              %mi a
                            %msub
                              %mrow
                              %mrow
                                %mi b
                                %mi c
                            %msubsup
                              %mi A
                              %mi σ
                              %mi b
                            %msubsup
                              %mi A
                              %mi v
                              %mi c
                            %mo{:stretchy => "false"} )
                            %mo −
                            %msub
                              %mo ∂
                              %mi v
                            %mo{:stretchy => "false"} (
                            %msub
                              %mo ∂
                              %mi u
                            %msubsup
                              %mi A
                              %mi σ
                              %mi a
                            %mo −
                            %msup
                              %mi C
                              %mi a
                            %msub
                              %mrow
                              %mrow
                                %mi b
                                %mi c
                            %msubsup
                              %mi A
                              %mi σ
                              %mi b
                            %msubsup
                              %mi A
                              %mi u
                              %mi c
                            %mo{:stretchy => "false"} )
                            %mo +
                            %msub
                              %mo ∂
                              %mi σ
                            %msup
                              %mi C
                              %mi a
                            %msub
                              %mrow
                              %mrow
                                %mi b
                                %mi c
                            %msubsup
                              %mi A
                              %mi u
                              %mi b
                            %msubsup
                              %mi A
                              %mi v
                              %mi c
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mo ∂
                              %mi u
                            %msup
                              %mi C
                              %mi a
                            %msub
                              %mrow
                              %mrow
                                %mi b
                                %mi c
                            %msubsup
                              %mi A
                              %mi σ
                              %mi b
                            %msubsup
                              %mi A
                              %mi v
                              %mi c
                            %mo −
                            %msub
                              %mo ∂
                              %mi v
                            %msup
                              %mi C
                              %mi a
                            %msub
                              %mrow
                              %mrow
                                %mi b
                                %mi c
                            %msubsup
                              %mi A
                              %mi σ
                              %mi b
                            %msubsup
                              %mi A
                              %mi u
                              %mi c
                            %mo +
                            %msub
                              %mo ∂
                              %mi σ
                            %msup
                              %mi C
                              %mi a
                            %msub
                              %mrow
                              %mrow
                                %mi b
                                %mi c
                            %msubsup
                              %mi A
                              %mi u
                              %mi b
                            %msubsup
                              %mi A
                              %mi v
                              %mi c
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msup
                              %mi C
                              %mi a
                            %msub
                              %mrow
                              %mrow
                                %mi b
                                %mi c
                            %msubsup
                              %mi A
                              %mi σ
                              %mi b
                            %mo{:stretchy => "false"} (
                            %msub
                              %mo ∂
                              %mi u
                            %msubsup
                              %mi A
                              %mi v
                              %mi c
                            %mo −
                            %msub
                              %mo ∂
                              %mi v
                            %msubsup
                              %mi A
                              %mi u
                              %mi c
                            %mo{:stretchy => "false"} )
                            %mo +
                            %msup
                              %mi C
                              %mi a
                            %msub
                              %mrow
                              %mrow
                                %mi b
                                %mi c
                            %mo{:stretchy => "false"} (
                            %msub
                              %mo ∂
                              %mi σ
                            %msubsup
