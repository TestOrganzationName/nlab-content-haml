            %li
              %p
                Moreover
                %a.existingWikiWord{:href => "/nlab/show/k-morphism"} 2-morphisms
                of the form
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
