                        %mi F
                        %mi i
                      %mo ,
                      %mn 0
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (F_i, 0, \cdots, 0)
            %p
              Such a cocycle being
              = succeed "-closed" do
