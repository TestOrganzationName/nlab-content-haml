                        %mi proj
                    %annotation{:encoding => "application/x-tex"} [CartSp_{smooth}^{op}, sSet]_{proj}
          .num_remark
            %h6#remark_2 Remark
            %p
              This means that a
              = succeed "-parameterized" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mo ♭
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi G
                      %mi c
                  %annotation{:encoding => "application/x-tex"} \mathbf{\flat}\mathbf{B}G_{c}
              is given by a
              %a.existingWikiWord{:href => "/nlab/show/Lie-algebra+valued+1-form"} Lie-algebra valued 1-form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} A \in \Omega^1(U)\otimes \mathfrak{g}
              whose
              %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
              2-form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi A
                    %mo =
                    %msub
                      %mi d
                      %mi dR
                    %mi A
                    %mo +
                    %mo{:stretchy => "false"} [
                    %mi A
                    %mo ,
                    %mo ∧
                    %mi A
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} F_A = d_{dR} A + [A ,\wedge A]  = 0
              vanishes,
              %br>/
              and a
              = succeed "-parameterized" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %mi A
                    %mo →
                    %mi A
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} g : A \to A'
              is given by a smooth function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ∈
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} g \in C^\infty(U,G)
              such that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ′
                      %mo =
                      %msub
                        %mi Ad
                        %mi g
                      %mi A
                      %mo +
                      %msup
                        %mi g
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mi d
                      %mi g
                    %annotation{:encoding => "application/x-tex"} A' = Ad_g A + g^{-1} d g
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ad
                      %mi g
                    %mi A
                    %mo =
                    %msup
                      %mi g
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mi A
                    %mi g
                  %annotation{:encoding => "application/x-tex"} Ad_g A = g^{-1} A g
              is the
              %a.existingWikiWord{:href => "/nlab/show/adjoint+action"} adjoint action
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              on its
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi g
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mi d
                    %mi g
                    %mo :
                    %mo =
                    %msup
                      %mi g
                      %mo *
                    %mi θ
                  %annotation{:encoding => "application/x-tex"} g^{-1} d g := g^* \theta
              is the pullback of the
              %a.existingWikiWord{:href => "/nlab/show/Maurer-Cartan+form"} Maurer-Cartan form
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
