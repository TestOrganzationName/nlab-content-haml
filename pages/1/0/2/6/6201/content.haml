            %p
              be the
              %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
              of
              %a.existingWikiWord{:href => "/nlab/show/simplicial+groupoids"} simplicial groupoids
              which in degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              is the
              %a.existingWikiWord{:href => "/nlab/show/groupoid+of+Lie-algebra+valued+forms"} groupoid of Lie-algebra valued forms
              with values in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mi k
                  %annotation{:encoding => "application/x-tex"} G_k
              from
              = succeed "." do
                %a{:href => "#CanonicalFormOnLieGroup"} above
              %a{:href => "#CanonicalFormOnLieGroup"} above
              discussion there we have that under the degreewise
              %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
              this is a degreewise fibrant
              %a.existingWikiWord{:href => "/nlab/show/resolution"} resolution
              of presheaves of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/bisimplicial+set"} bisimplicial set
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mrow
                      %mo (
                      %msubsup
                        %mi Ω
                        %mi flat
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %msub
                        %mi 𝔤
                        %mo •
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} /
                      %msub
                        %mi G
                        %mo •
                      %mo )
                    %mo →
                    %mi N
                    %mo *
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi G
                      %mo •
                    %mo =
                    %mi N
                    %mi B
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi G
                      %mi disc
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                  %annotation{:encoding => "application/x-tex"}
                    N \left(  \Omega^1_{flat}(-,\mathfrak{g}_\bullet)
                    \//
                    G_\bullet
                    \\right)
                    \\to
                    N *//G_\bullet
