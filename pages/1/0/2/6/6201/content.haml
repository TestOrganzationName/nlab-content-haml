              given by the
              %a.existingWikiWord{:href => "/nlab/show/groupoid+of+Lie-algebra+valued+forms"} groupoid of Lie-algebra valued forms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mo ♭
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi G
                      %mi c
                    %mo =
                    %mi N
                    %mrow
                      %mo (
                      %msup
                        %mi C
