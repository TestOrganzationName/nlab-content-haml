            %a{:href => "#SmoothManifoldEmbeds"} embedding
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SmoothMfd
                  %mo ↪
                  %mi Smooth
