                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi proj
                    %annotation{:encoding => "application/x-tex"} [CartSp^{op}, sSet]_{proj}
          .proof
            %h6#proof_27 Proof
            %p
              First we check that we have a morphism of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ∈
                      %mi CartSp
                    %annotation{:encoding => "application/x-tex"} U \in CartSp
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+group"} simplicial group
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan correspondence
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Moore+complex"} normalized chain complexes
            %p
              Notice that the chain complex differential on the forms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo ∈
                    %msubsup
                      %mi Ω
                      %mi cl
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %msup
                      %mi Δ
                      %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \omega \in \Omega^n_{cl}(U \times \Delta^k)
              on simplices sends a form to the alternating sum of its restriction to the faces of the simplex. Postcomposed with the integration map this is the operation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo ↦
                    %msub
                      %mo ∫
                      %mrow
                        %mo ∂
                        %msup
                          %mi Δ
                          %mi k
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega \mapsto \int_{\partial \Delta^k} \omega
              of integration over the boundary.
            %p
              Conversely, first integrating over the simplex and then applying the de Rham differential on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              yields
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi ω
                            %mo ↦
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi k
                                %mo +
                                %mn 1
                            %msub
                              %mi d
                              %mi U
                            %msub
                              %mo ∫
                              %mrow
                                %msup
                                  %mi Δ
                                  %mi k
                            %mi ω
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msub
                              %mo ∫
                              %mrow
                                %msup
                                  %mi Δ
                                  %mi k
                            %msub
                              %mi d
                              %mi U
                            %mi ω
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mo ∫
                              %mrow
                                %msup
                                  %mi Δ
                                  %mi k
                            %msub
                              %mi d
                              %mrow
                                %msup
                                  %mi Δ
                                  %mi k
                            %mi ω
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mo ∫
                              %mrow
                                %mo ∂
                                %msup
                                  %mi Δ
                                  %mi k
                            %mi ω
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\omega \mapsto (-1)^{k+1} d_U \int_{\Delta^k} \omega
                    \&amp;=
                    \- \int_{\Delta^k} d_U \omega
                    \\\
                    \&amp; = \int_{\Delta^k} d_{\Delta^k} \omega
                    \\\
                    \&amp; =  \int_{\partial \Delta^k} \omega
                    \\end{aligned}
                    \\,,
            %p
              where we first used that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              is closed, so that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mi dR
                      %mi ω
                      %mo =
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi d
                        %mi U
                      %mo +
                      %msub
                        %mi d
                        %mrow
                          %msup
                            %mi Δ
                            %mi k
                      %mo{:stretchy => "false"} )
                      %mi ω
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} d_{dR} \omega = (d_U + d_{\Delta^k}) \omega = 0
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Stokes%27+theorem"} Stokes' theorem
            %p
              By the discussion of the two objects we already know that both present the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mo ♭
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi n
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbf{\flat} \mathbf{B}^n \mathbb{R}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                    %mi CartSp
                  %annotation{:encoding => "application/x-tex"} U \in CartSp
              an isomorphism on the
              %a.existingWikiWord{:href => "/nlab/show/simplicial+homotopy+group"} simplicial homotopy group
              in degree
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            %p Clearly the morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mrow
                        %msup
                          %mi Δ
                          %mi n
                    %mo :
                    %msubsup
                      %mi Ω
                      %mrow
                        %mi si
                        %mo ,
                        %mi cl
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %msup
                      %mi Δ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\int_{\Delta^n} : \Omega^\bullet_{si,cl}(U  \times \Delta^n)
                    \\to
                    C^\infty(U, \mathbb{R})
            %p
              is surjective on degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              homotopy groups: for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi U
                    %mo →
                    %mo *
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} f : U \to * \to \mathbb{R}
              constant, a preimage is
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ⋅
                      %msub
                        %mi vol
                        %mrow
                          %msup
                            %mi Δ
                            %mi n
                    %annotation{:encoding => "application/x-tex"} f \cdot vol_{\Delta^n}
              %a.existingWikiWord{:href => "/nlab/show/volume+form"} volume form
              of the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/simplex"} simplex
              times
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
            %p
              Moreover, these preimages clearly span the whole homotopy group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mo ♭
