                    }
            %p and picking the lowest horizontal morphism.
          %p Here the terms mean the following:
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi INN
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} INN(U(1))
                is the
                %a.existingWikiWord{:href => "/nlab/show/2-group"} 2-group
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Ξ
                        %mo{:stretchy => "false"} (
                        %mi U
                        %mo{:stretchy => "false"} (
