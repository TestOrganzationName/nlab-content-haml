                  %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
                  “
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mo ″
                        %mi over
                        %mi the
                        %mi empty
                        %mi diagram
                        %mi is
                        %mi hence
                        %mi that
                        %mi for
                        %mi every
                        %mi object
                      %annotation{:encoding => "application/x-tex"}
                        '' over the empty diagram is hence that
                        for every object
                  X
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mo ,
                        %mi there
                        %mi is
                        %mi a
                        %mi unique
                        %mi map
                        %mi of
                        %mi the
                        %mi form
                      %annotation{:encoding => "application/x-tex"} , there is a unique map of the form
                  0 \to X
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mo .
                        %mi Such
                        %mi an
                        %mi object
                      %annotation{:encoding => "application/x-tex"} . Such an object
                  \\ast$ is called a
                  = succeed "." do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
          #CoProduct.num_example
            %h6#example_7 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
                and
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi X
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{X_i\}_{i \in I}
              be a
              %a.existingWikiWord{:href => "/nlab/show/discrete+category"} discrete
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              (example
              = succeed ")," do
                %a.maruku-ref{:href => "#DiscreteDiagram"}
            %ol
              %li
                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/limit"} limit
                  over this diagram is called the
                  = succeed "," do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                            %mrow
                              %mi i
                              %mo ∈
                              %mi I
                          %msub
                            %mi X
                            %mi i
                        %annotation{:encoding => "application/x-tex"} \underset{i \in I}{\prod} X_i
              %li
                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
                  over this diagram is called the
                  = succeed "," do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/coproducts"} coproducts
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                            %mrow
                              %mi i
                              %mo ∈
                              %mi I
                          %msub
                            %mi X
                            %mi i
                        %annotation{:encoding => "application/x-tex"} \underset{i \in I}{\coprod} X_i
          #Equalizer.num_example
            %h6#example_8 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/equalizer"}> equalizer
                )
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 1
                    %munderover
                      %mrow
                      %munder
                        %mo ⟶
                        %mrow
                          %mphantom
                            %mi AA
                          %msub
                            %mi f
                            %mn 2
                          %mphantom
                            %mi AA
                      %mover
                        %mo ⟶
                        %mrow
                          %mphantom
                            %mi AA
                          %msub
                            %mi f
                            %mn 1
                          %mphantom
                            %mi AA
                    %msub
                      %mi X
                      %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    X_1
                    \\underoverset
                    {\underset{\phantom{AA}f_2\phantom{AA}}{\longrightarrow}}
                    {\overset{\phantom{AA}f_1\phantom{AA}}{\longrightarrow}}
                    {}
                    X_2
            %p
              be a
              %a.existingWikiWord{:href => "/nlab/show/free+diagram"} free diagram
              of the shape “
              %a.existingWikiWord{:href => "/nlab/show/pair+of+parallel+morphisms"}> pair of parallel morphisms
              ” (example
              = succeed ")." do
                %a.maruku-ref{:href => "#ParallelMorphisms"}
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/limit"} limit
              over this diagram according to def.
              %a.maruku-ref{:href => "#LimitingCone"}
              is also called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/equalizer"} equalizer
              of the maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} f_1
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} f_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi eq
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mn 1
                    %mo ,
                    %msub
                      %mi f
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} eq(f_1,f_2)
              equipped with a map
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi eq
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi f
                        %mn 1
                      %mo ,
                      %msub
                        %mi f
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo ⟶
                        %mrow
                          %msub
                            %mi p
                            %mn 1
                      %msub
                        %mi X
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} eq(f_1,f_2) \overset{p_1}{\longrightarrow} X_1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn 1
                    %mo ∘
                    %msub
                      %mi p
                      %mn 1
                    %mo =
                    %msub
                      %mi f
                      %mn 2
                    %mo ∘
                    %msub
                      %mi p
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} f_1 \circ p_1 = f_2 \circ p_1
              and such that if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo →
                    %msub
                      %mi X
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} Y \to X_1
              is any other map with this property
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi Y
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                            %mi eq
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi f
                              %mn 1
                            %mo ,
                            %msub
                              %mi f
                              %mn 2
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi p
                                  %mn 1
                          %mtd
                            %msub
                              %mi X
                              %mn 1
                          %mtd
                            %munderover
                              %mrow
                              %munder
                                %mo ⟶
                                %mrow
                                  %mphantom
                                    %mi AA
                                  %msub
                                    %mi f
                                    %mn 2
                                  %mphantom
                                    %mi AA
                              %mover
                                %mo ⟶
                                %mrow
                                  %mphantom
                                    %mi AA
                                  %msub
                                    %mi f
                                    %mn 1
                                  %mphantom
                                    %mi AA
                          %mtd
                            %msub
                              %mi X
                              %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; Y
                    \\\
                    \&amp;&amp; \downarrow &amp; \searrow
                    \\\
                    eq(f_1,f_2)
                    \&amp;\overset{p_1}{\longrightarrow}&amp;
                    X_1
                    \&amp;
                    \\underoverset
                    {\underset{\phantom{AA}f_2\phantom{AA}}{\longrightarrow}}
                    {\overset{\phantom{AA}f_1\phantom{AA}}{\longrightarrow}}
                    {}
                    \&amp;
                    X_2
                    }
            %p then there is a unique factorization through the equalizer:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi Y
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mo ∃
                                  %mo !
                            %mo ↙
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                            %mi eq
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi f
                              %mn 1
                            %mo ,
                            %msub
                              %mi f
                              %mn 2
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi p
                                  %mn 1
                          %mtd
                            %msub
                              %mi X
                              %mn 1
                          %mtd
                            %munderover
                              %mrow
                              %munder
                                %mo ⟶
                                %mrow
                                  %msub
                                    %mi f
                                    %mn 2
                              %mover
                                %mo ⟶
                                %mrow
                                  %msub
                                    %mi f
                                    %mn 1
                          %mtd
                            %msub
                              %mi X
                              %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; Y
                    \\\
                    \&amp;{}^{\mathllap{\exists !}}\swarrow&amp; \downarrow &amp; \searrow
                    \\\
                    eq(f_1,f_2)
                    \&amp;\overset{p_1}{\longrightarrow}&amp;
                    X_1
                    \&amp;
                    \\underoverset
                    {\underset{f_2}{\longrightarrow}}
                    {\overset{f_1}{\longrightarrow}}
                    {}
                    \&amp;
                    X_2
                    }
                    \\,.
            %p
              In example
              %a.maruku-ref{:href => "#ConeIncarnationOfSolutionsToEquations"}
              we have seen that a cone over such a pair of parallel morphisms is a
              %em
                %a.existingWikiWord{:href => "/nlab/show/solution"} solution
              to the equation
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi f
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f_1(x) = f_2(x)
            %p
              The equalizer above is the
              %em space of all solutions
              of this equation.
          #Pushout.num_example
            %h6#example_9 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/pullback"}> pullback
                \/
                %a.existingWikiWord{:href => "/nlab/show/fiber+product"} fiber product
                and
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
            %p
              Consider a
              %a.existingWikiWord{:href => "/nlab/show/cospan"} cospan
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#SpanDiagram"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi Y
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %munder
                              %mo ⟶
                              %mi g
                          %mtd
                            %mi Z
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; Y
                    \\\
                    \&amp;&amp; \downarrow^{\mathrlap{f}}
                    \\\
                    X
                    \&amp;\underset{g}{\longrightarrow}&amp;
                    Z
                    }
                    \\,.
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/limit"} limit
              over this diagram is also called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/fiber+product"} fiber product
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Z
                    %annotation{:encoding => "application/x-tex"} Z
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %munder
                        %mo ×
                        %mi Z
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X \underset{Z}{\times}Y
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %em
                %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                            %munder
                              %mo ×
                              %mi X
                            %mi Z
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi Y
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi pb
                            %mo{:stretchy => "false"} )
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %munder
                              %mo ⟶
                              %mi g
                          %mtd
                            %mi Z
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X \underset{X}{\times} Z
                    \&amp;\longrightarrow&amp;
                    Y
                    \\\
                    \\downarrow &amp;(pb)&amp; \downarrow^{\mathrlap{f}}
                    \\\
                    X
                    \&amp;\underset{g}{\longrightarrow}&amp;
                    Z
                    }
                    \\,.
            %p
              %a.existingWikiWord{:href => "/nlab/show/formal+duality"}> Dually
              , consider a
              %a.existingWikiWord{:href => "/nlab/show/span"} span
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#SpanDiagram"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Z
                          %mtd
                            %mover
                              %mo ⟶
                              %mi g
                          %mtd
                            %mi Y
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi f
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Z
                    \&amp;\overset{g}{\longrightarrow}&amp;
                    Y
                    \\\
                    {}^{\mathllap{f}}\downarrow
                    \\\
                    X
                    }
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              over this diagram is also called the
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              along
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %munder
                        %mo ⊔
                        %mi Z
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X \underset{Z}{\sqcup}Y
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Z
                          %mtd
                            %mover
                              %mo ⟶
                              %mi g
                          %mtd
                            %mi Y
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi f
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi po
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi X
                            %munder
                              %mo ⊔
                              %mi Z
                            %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Z
                    \&amp;\overset{g}{\longrightarrow}&amp;
                    Y
                    \\\
                    {}^{\mathllap{f}}\downarrow &amp;(po)&amp; \downarrow
                    \\\
                    X &amp;\longrightarrow&amp; X \underset{Z}{\sqcup} Y
                    }
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p Here is a more explicit description of the limiting cone over a diagram of sets:
          #SetLimits.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (
                %a{:href => "limits+and+colimits+by+example#limcoliminset"}> limits and colimits of sets
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo {
                        %msub
                          %mi X
                          %mi i
                        %mover
                          %mo ⟶
                          %mrow
                            %msub
                              %mi f
                              %mi α
                        %msub
                          %mi X
                          %mi j
                        %mo }
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                        %mo ∈
                        %mi I
                        %mo ,
                        %mi α
                        %mo ∈
                        %msub
                          %mi I
                          %mrow
                            %mi i
                            %mo ,
                            %mi j
                  %annotation{:encoding => "application/x-tex"} \left\{ X_i \overset{f_\alpha}{\longrightarrow} X_j \right\}_{i,j \in I, \alpha \in I_{i,j}}
              be a
              %a.existingWikiWord{:href => "/nlab/show/free+diagram"} free diagram
              of sets (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#Diagram"}
            %ol
