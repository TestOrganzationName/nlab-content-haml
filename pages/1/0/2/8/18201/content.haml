            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          #Cone.num_defn
            %h6#definition_7 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/cone"} cone
                over a
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/free+diagram"} free diagram
            %p
              Consider a
              %a.existingWikiWord{:href => "/nlab/show/free+diagram"} free diagram
              of sets or of topological spaces (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Diagram"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                    %mspace{:width => "thinmathspace"}
                    %mo =
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mrow
                        %mo {
                        %msub
                          %mi X
                          %mi i
                        %mover
                          %mo ⟶
                          %mrow
                            %msub
                              %mi f
                              %mi α
                        %msub
                          %mi X
                          %mi j
                        %mo }
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                        %mo ∈
                        %mi I
                        %mo ,
                        %mi α
                        %mo ∈
                        %msub
                          %mi I
                          %mrow
                            %mi i
                            %mo ,
                            %mi j
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    X_\bullet
                    \\,=\,
                    \\left\{
                    X_i \overset{f_\alpha}{\longrightarrow} X_j
                    \\right\}_{i,j \in I, \alpha \in I_{i,j}}
                    \\,.
            %p Then
            %ol
              %li
                %p
                  a
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/cone"} cone
                  over this diagram is
                %ol
                  %li
                    %p
                      a
                      %a.existingWikiWord{:href => "/nlab/show/set"} set
                      or
                      %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mover
                              %mi X
                              %mo{:stretchy => "false"} ˜
                          %annotation{:encoding => "application/x-tex"} \tilde X
                      (called the
                      %em tip
                      of the cone);
                  %li
                    %p
                      for each
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi i
                            %mo ∈
                            %mi I
                          %annotation{:encoding => "application/x-tex"} i \in I
                      a
                      %a.existingWikiWord{:href => "/nlab/show/function"} function
                      or
                      %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mover
                              %mi X
                              %mo{:stretchy => "false"} ˜
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi p
                                  %mi i
                            %msub
                              %mi X
                              %mi i
                          %annotation{:encoding => "application/x-tex"} \tilde X \overset{p_i}{\longrightarrow} X_i
                %p such that
                %ul
                  %li
                    %p
                      for all
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi i
                            %mo ,
                            %mi j
                            %mo{:stretchy => "false"} )
                            %mo ∈
                            %mi I
                            %mo ×
                            %mi I
                          %annotation{:encoding => "application/x-tex"} (i,j) \in I \times I
                      and all
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi α
                            %mo ∈
                            %msub
                              %mi I
                              %mrow
                                %mi i
                                %mo ,
                                %mi j
                          %annotation{:encoding => "application/x-tex"} \alpha \in I_{i,j}
                      then the condition
                    .maruku-equation
                      %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi f
                              %mi α
                            %mo ∘
                            %msub
                              %mi p
                              %mi i
                            %mo =
                            %msub
                              %mi p
                              %mi j
                          %annotation{:encoding => "application/x-tex"}
                            f_{\alpha} \circ p_i = p_j
                    %p holds, which we depict as follows:
                    .maruku-equation
                      %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mrow
                              %mtable
                                %mtr
                                  %mtd
                                  %mtd
                                  %mtd
                                    %mover
                                      %mi X
                                      %mo{:stretchy => "false"} ˜
                                %mtr
                                  %mtd
                                  %mtd
                                    %msup
                                      %mrow
                                      %mpadded{:lspace => "-100%width", :width => "0"}
                                        %mrow
                                          %msub
                                            %mi p
                                            %mi i
                                    %mo ↙
                                  %mtd
                                  %mtd
                                    %msup
                                      %mo ↘
                                      %mpadded{:width => "0"}
                                        %mrow
                                          %msub
                                            %mi p
                                            %mi j
                                %mtr
                                  %mtd
                                    %msub
                                      %mi X
                                      %mi i
                                  %mtd
                                  %mtd
                                    %munder
                                      %mo ⟶
                                      %mrow
                                        %msub
                                          %mi f
                                          %mi α
                                  %mtd
                                  %mtd
                                    %msub
                                      %mi X
                                      %mi j
                          %annotation{:encoding => "application/x-tex"}
                            \\array{
                            \&amp;&amp; \tilde X
                            \\\
                            \&amp; {}^{\mathllap{p_i}}\swarrow &amp;&amp; \searrow^{\mathrlap{p_j}}
                            \\\
                            X_i
                            \&amp;&amp; \underset{f_\alpha}{\longrightarrow} &amp;&amp;
                            X_j
                            }
              %li
                %p
                  a
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/co-cone"} co-cone
                  over this diagram is
                %ol
                  %li
                    %p
                      a set or topological space
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mover
                              %mi X
                              %mo{:stretchy => "false"} ˜
                          %annotation{:encoding => "application/x-tex"} \tilde X
                      (called the
                      %em tip
                      of the co-cone);
                  %li
                    %p
                      for each
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi i
                            %mo ∈
                            %mi I
                          %annotation{:encoding => "application/x-tex"} i \in I
                      a function or continuous function
                      = succeed ";" do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %msub
                                %mi q
                                %mi i
                              %mo{:lspace => "verythinmathspace"} :
                              %msub
                                %mi X
                                %mi i
                              %mo ⟶
                              %mover
                                %mi X
                                %mo{:stretchy => "false"} ˜
                            %annotation{:encoding => "application/x-tex"} q_i \colon X_i \longrightarrow \tilde X
                %p such that
                %ul
                  %li
                    %p
                      for all
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi i
                            %mo ,
                            %mi j
                            %mo{:stretchy => "false"} )
                            %mo ∈
                            %mi I
                            %mo ×
                            %mi I
                          %annotation{:encoding => "application/x-tex"} (i,j) \in I \times I
                      and all
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi α
                            %mo ∈
                            %msub
                              %mi I
                              %mrow
                                %mi i
                                %mo ,
                                %mi j
                          %annotation{:encoding => "application/x-tex"} \alpha \in I_{i,j}
                      then the condition
                    .maruku-equation
                      %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi q
                              %mi j
                            %mo ∘
                            %msub
                              %mi f
                              %mi α
                            %mo =
                            %msub
                              %mi q
                              %mi i
                          %annotation{:encoding => "application/x-tex"}
                            q_j \circ f_{\alpha} = q_i
                    %p holds, which we depict as follows:
                    .maruku-equation
                      %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mrow
                              %mtable
                                %mtr
                                  %mtd
                                    %msub
                                      %mi X
                                      %mi i
                                  %mtd
                                  %mtd
                                    %mover
                                      %mo ⟶
                                      %mrow
                                        %msub
                                          %mi f
                                          %mi α
                                  %mtd
                                  %mtd
                                    %msub
                                      %mi X
                                      %mi j
                                %mtr
                                  %mtd
                                  %mtd
                                    %msub
                                      %mrow
                                      %mpadded{:lspace => "-100%width", :width => "0"}
                                        %mrow
                                          %msub
                                            %mi q
                                            %mi i
                                    %mo ↘
                                  %mtd
                                  %mtd
                                    %msub
                                      %mo ↙
                                      %mpadded{:width => "0"}
                                        %mrow
                                          %msub
                                            %mi q
                                            %mi j
                                %mtr
                                  %mtd
                                  %mtd
                                  %mtd
                                    %mover
                                      %mi X
                                      %mo{:stretchy => "false"} ˜
                            %mspace{:width => "thinmathspace"}
                            %mo .
                          %annotation{:encoding => "application/x-tex"}
                            \\array{
                            X_i &amp;&amp; \overset{f_\alpha}{\longrightarrow} &amp;&amp; X_j
                            \\\
                            \&amp; {}_{\mathllap{q_i}}\searrow &amp;&amp; \swarrow_{\mathrlap{q_j}}
                            \\\
                            \&amp;&amp; \tilde X
                            }
                            \\,.
          #ConeIncarnationOfSolutionsToEquations.num_example
            %h6#example_5 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/solutions"} solutions
                to
                %a.existingWikiWord{:href => "/nlab/show/equations"} equations
                are
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/cones"} cones
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ,
                    %mi g
                    %mo{:lspace => "verythinmathspace"} :
                    %mi ℝ
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} f,g \colon \mathbb{R} \to \mathbb{R}
              be two
              %a.existingWikiWord{:href => "/nlab/show/functions"} functions
              from the
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              to themselves, and consider the corresponding
              %a.existingWikiWord{:href => "/nlab/show/parallel+morphism"} parallel morphism
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              of sets (example
              = succeed "):" do
                %a.maruku-ref{:href => "#ParallelMorphisms"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                    %munderover
                      %mphantom
                        %mi AAAAA
                      %munder
                        %mo ⟶
                        %mrow
                          %msub
                            %mi f
                            %mn 2
                      %mover
                        %mo ⟶
                        %mrow
                          %msub
                            %mi f
                            %mn 1
                    %mi ℝ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R}
                    \\underoverset
                    {\underset{f_2}{\longrightarrow}}
                    {\overset{f_1}{\longrightarrow}}
                    {\phantom{AAAAA}}
                    \\mathbb{R}
                    \\,.
            %p
              Then a
              %a.existingWikiWord{:href => "/nlab/show/cone"} cone
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Cone"}
              %a.existingWikiWord{:href => "/nlab/show/singleton"} singleton
              set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \ast
              is a
              %em
                %a.existingWikiWord{:href => "/nlab/show/solution"} solution
              to the
              %a.existingWikiWord{:href => "/nlab/show/equation"} equation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(x) = g(x)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi const
                                    %mi x
                            %mo ↙
                          %mtd
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi const
                                    %mi y
                        %mtr
                          %mtd
                            %mi ℝ
                          %mtd
                          %mtd
                            %munderover
                              %mphantom
                                %mi AAAAA
                              %munder
                                %mo ⟶
                                %mrow
                                  %msub
                                    %mi f
                                    %mn 2
                              %mover
                                %mo ⟶
                                %mrow
                                  %msub
                                    %mi f
                                    %mn 1
                          %mtd
                          %mtd
                            %mi ℝ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; \ast
                    \\\
                    \&amp; {}^{\mathllap{const_x}}\swarrow &amp;&amp; \searrow^{\mathrlap{const_y}}
                    \\\
                    \\mathbb{R}
                    \&amp;&amp;
                    \\underoverset
                    {\underset{f_2}{\longrightarrow}}
                    {\overset{f_1}{\longrightarrow}}
                    {\phantom{AAAAA}}
                    \&amp;&amp;
                    \\mathbb{R}
                    }
                    \\,.
            %p Namely the components of the cone are two functions of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi cont
                      %mi x
                    %mo ,
                    %msub
                      %mi const
                      %mi y
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo *
