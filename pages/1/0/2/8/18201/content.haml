            %p Similarly there are co-tower diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 0
                    %mover
                      %mo ⟵
                      %mrow
                        %mphantom
                          %mi A
                        %msub
                          %mi f
                          %mrow
                            %mn 0
                            %mo ,
                            %mn 1
                        %mphantom
                          %mi A
                    %msub
