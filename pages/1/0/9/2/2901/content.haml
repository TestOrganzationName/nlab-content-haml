                      %mi t
                      %mi x
                    %annotation{:encoding => "application/x-tex"} B a d t, B b d c, a \neq d \;\; \vdash \;\; (\exists x, y)\; B a b x \wedge B a c y \wedge B y t x
                (Parallel Postulate (!)),
            %li
              %p
                (Cut schema) Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \phi(x)
                be a formula in which variables
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ,
                      %mi b
                      %mo ,
                      %mi y
                    %annotation{:encoding => "application/x-tex"} a, b, y
                do not occur freely, and let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ψ
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \psi(y)
                be a formula in which
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ,
                      %mi b
                      %mo ,
                      %mi x
                    %annotation{:encoding => "application/x-tex"} a, b, x
                do not occur freely. Then
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo ∀
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} (
                      %mi ϕ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ∧
                      %mi ψ
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo ⇒
                      %mi B
                      %mi a
                      %mi x
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo ⊢
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} (
                      %mo ∃
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mo ∀
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
