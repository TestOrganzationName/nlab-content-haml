                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} (
                      %mo ∃
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mi B
                      %mi a
                      %mi b
                      %mi x
                      %mo ∧
                      %mi B
                      %mi a
                      %mi c
                      %mi y
                      %mo ∧
                      %mi B
