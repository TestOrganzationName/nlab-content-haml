                        %a.existingWikiWord{:href => "/nlab/show/Klein+geometry"}> Klein geometry
                        , (
                        %a.existingWikiWord{:href => "/nlab/show/higher+Klein+geometry"}> higher
                        )
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/G-structure"}> G-structure
                        ,
                        %a.existingWikiWord{:href => "/nlab/show/torsion+of+a+G-structure"} torsion of a G-structure
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/Euclidean+geometry"}> Euclidean geometry
                        ,
                        = succeed "," do
                          %a.existingWikiWord{:href => "/nlab/show/hyperbolic+geometry"} hyperbolic geometry
                        %a.existingWikiWord{:href => "/nlab/show/elliptic+geometry"} elliptic geometry
                    %li
                      %p
                        (
                        %a.existingWikiWord{:href => "/nlab/show/pseudo-Riemannian+geometry"}> pseudo
                        \-)
                        %a.existingWikiWord{:href => "/nlab/show/Riemannian+geometry"} Riemannian geometry
                      %ul
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/orthogonal+structure"} orthogonal structure
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/isometry"}> isometry
                            ,
                            = succeed "," do
                              %a.existingWikiWord{:href => "/nlab/show/Killing+vector+field"} Killing vector field
                            %a.existingWikiWord{:href => "/nlab/show/Killing+spinor"} Killing spinor
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/spacetime"}> spacetime
                            ,
                            %a.existingWikiWord{:href => "/nlab/show/super-spacetime"} super-spacetime
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/complex+geometry"} complex geometry
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/symplectic+geometry"} symplectic geometry
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/conformal+geometry"} conformal geometry
          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#properties"} Properties
              %li
                %a{:href => "#Axiomatizations"} Axiomatizations
              %ul
                %li
                  %a{:href => "#hilberts_axioms"} Hilbert’s axioms
                %li
                  %a{:href => "#TarskiAxioms"} Tarski’s axioms
                %li
                  %a{:href => "#MacLaneAxioms"} Mac Lane’s axioms
              %li
                %a{:href => "#related_concepts"} Related concepts
              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            %em Euclidean geometry
            (
            %a{:href => "#Euclid300BC"}> Euclid 300BC
            ) studies the
            %a.existingWikiWord{:href => "/nlab/show/geometry"} geometry
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+spaces"} Euclidean spaces
            %a.existingWikiWord{:href => "/nlab/show/metric+space"} metric
            in the sense of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/analysis"} analysis
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Riemannian+metric"} Riemannian metric
            %em local model
            for
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Riemannian+geometry"} Riemannian geometry
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Cartan+geometry"} Cartan geometry
          %p
            In distinction from
            %a.existingWikiWord{:href => "/nlab/show/non-Euclidean+geometry"} non-Euclidean geometry
            (
            %a.existingWikiWord{:href => "/nlab/show/hyperbolic+geometry"} hyperbolic geometry
            or
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/elliptic+geometry"} elliptic geometry
            %a.existingWikiWord{:href => "/nlab/show/Riemannian+geometry"} Riemannian geometry
            of
            %a.existingWikiWord{:href => "/nlab/show/Riemannian+manifolds"} Riemannian manifolds
            with
            %a.existingWikiWord{:href => "/nlab/show/zero"} zero
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/sectional+curvature"} sectional curvature
          %h2#properties Properties
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Pythagorean+theorem"} Pythagorean theorem
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/pentagon+decagon+hexagon+identity"} pentagon decagon hexagon identity
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/conic+section"} conic section
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Hadwiger%27s+theorem"} Hadwiger's theorem
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Non-Euclidean+geometry"} Non-Euclidean geometry
          %h2#Axiomatizations Axiomatizations
          %p
            Euclidean geometry in the sense of the Idea section makes# reference to the extrinsic notion of
            %a.existingWikiWord{:href => "/nlab/show/real+number"} real number
            (to delineate the notion of Euclidean space) and whatever surrounding structure is used to found that notion, but it has also received more intrinsic
            %a.existingWikiWord{:href => "/nlab/show/axiom"} axiomatic
            treatments in the spirit of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/synthetic+geometry"} synthetic geometry
            %a.existingWikiWord{:href => "/nlab/show/Hilbert"} Hilbert's
            axioms, as set out in his
            = succeed "," do
              %em Grundlagen der Geometrie
            = succeed "\u2018s" do
              %a.existingWikiWord{:href => "/nlab/show/Alfred+Tarski"} Tarski
          %h3#hilberts_axioms Hilbert’s axioms
          %p
            Here we will just give an extremely sketchy description (for now, see
            %a{:href => "http://en.wikipedia.org/wiki/Hilbert%27s_axioms"} Wikipedia
            for a fuller account). It should be said right away that two of the Hilbert axioms are
            %em not
            first-order.
          %p
            Hilbert’s
            %a.existingWikiWord{:href => "/nlab/show/theory"} theory
            has
          %ul
            %li
              Three sorts: points, line, planes (or if you like: tables, chairs, and beer mugs
              %sup#fnref:1>
                %a{:href => "#fn:1", :rel => "footnote"} 1
              );
          %ul
            %li
              %p
                Six relations: betweenness (a ternary relation on points), three incidence relations (one for points and lines, one for points and planes, one for lines and planes), and two congruence relations (a relation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo ,
                      %mi c
                      %mo ,
                      %mi d
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} L(a, b, c, d)
                on points whose intuitive meaning is that the the line segment
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mi b
                    %annotation{:encoding => "application/x-tex"} a b
                is congruent to the line segment
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi c
                        %mi d
                      %annotation{:encoding => "application/x-tex"} c d
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo ,
                      %mi c
                      %mo ,
                      %mi d
                      %mo ,
                      %mi e
                      %mo ,
                      %mi f
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} A(a, b, c, d, e, f)
                on points whose intuitive meaning is that the angle
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mi b
                      %mi c
                    %annotation{:encoding => "application/x-tex"} a b c
                is congruent to the angle
                = succeed ");" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mi e
                        %mi f
                      %annotation{:encoding => "application/x-tex"} d e f
            %li
              %p
                A bunch of
                %a.existingWikiWord{:href => "/nlab/show/axioms"} axioms
                (20 or 21 depending on which specific edition or translation or exposition one is working with; Wikipedia says 20 but actually has, confusingly, 21 – see the Talk page for more information). They are organized as
              %ul
                %li Axioms of incidence (8),
                %li Axioms of betweenness (4),
                %li Axioms of congruence (6),
                %li Axiom of parallels (the parallel postulate) (1),
                %li Axioms of completeness (2), mirroring the archimedean property and the completeness properties of the real numbers. These are not first-order.
          %p
            I (
            %a.existingWikiWord{:href => "/nlab/show/Todd+Trimble"}> Todd Trimble
            ) assume Hilbert’s theory is, or is at least intended to be,
            %a.existingWikiWord{:href => "/nlab/show/categoricity"} categorical
            in the model-theoretic sense, at least considered against a fixed set-theoretic background. In other words I assume the real numbers as complete ordered field would be a definable structure and the axioms are uniquely modeled by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mn 3
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^3
            with its Euclidean structure.
          %h3#TarskiAxioms Tarski’s axioms
          %p
            Tarski’s
            %a.existingWikiWord{:href => "/nlab/show/theory"} theory
            EPG (Elementary Plane [Euclidean] Geometry) is a one-sorted theory in classical first-order logic with equality, with variables representing points. There are no constants or operations in the signature, and just two relations:
          %ul
            %li
              %p
                A ternary relation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
                (betweenness), with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo ,
                      %mi z
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} B(x, y, z)
                meaning
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                    %annotation{:encoding => "application/x-tex"} y
                is between
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi z
                    %annotation{:encoding => "application/x-tex"} z
                (
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                    %annotation{:encoding => "application/x-tex"} y
                is on the line segment between
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
                and
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi z
                      %annotation{:encoding => "application/x-tex"} z
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mi x
                      %mi y
                      %mi z
                    %annotation{:encoding => "application/x-tex"} B x y z
                to conserve space;
            %li
              %p
                A 4-ary relation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                (congruence), with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo ,
                      %mi z
                      %mo ,
                      %mi w
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C(x, y, z, w)
                meaning that a line segment
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mi y
                    %annotation{:encoding => "application/x-tex"} x y
                is congruent (of the same length) as
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi z
                        %mi w
                      %annotation{:encoding => "application/x-tex"} z w
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mi y
                        %mo ≡
                        %mi z
                        %mi w
                      %annotation{:encoding => "application/x-tex"} x y \equiv z w
          %p
            The theory can be presented (in some sense very parsimoniously) by 10 axioms and one first-order axiom scheme. Axioms 8 and 9 constrain the dimension to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 2
                %annotation{:encoding => "application/x-tex"} n = 2
            (Euclidean plane geometry), but there are analogues of 8 and 9 that constrain the dimension to any chosen number. Axiom 10 is an extremely disguised version of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/parallel+postulate"} Parallel Postulate
          %ol
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mo ⊢
                      %mspace{:width => "thickmathspace"}
                      %mi a
                      %mi b
                      %mo ≡
                      %mi b
                      %mi a
                    %annotation{:encoding => "application/x-tex"} \vdash \; a b \equiv b a
                ,
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi a
                      %mi b
                      %mo ≡
                      %mi p
                      %mi q
                      %mo ,
                      %mi a
                      %mi b
                      %mo ≡
                      %mi r
                      %mi s
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo ⊢
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mi p
                      %mi q
                      %mo ≡
                      %mi r
                      %mi s
                    %annotation{:encoding => "application/x-tex"} a b \equiv p q, a b \equiv r s \;\; \vdash \;\; p q \equiv r s
                ,
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi a
                      %mi b
                      %mo ≡
                      %mi c
                      %mi c
                      %mo ⊢
                      %mi a
                      %mo =
                      %mi b
                    %annotation{:encoding => "application/x-tex"} a b \equiv c c \vdash a = b
                ,
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⊢
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} (
                      %mo ∃
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mi B
                      %mi q
                      %mi a
                      %mi x
                      %mo ∧
                      %mi a
                      %mi x
                      %mo ≡
                      %mi b
                      %mi c
                    %annotation{:encoding => "application/x-tex"} \vdash \; (\exists x)\; B q a x \wedge a x \equiv b c
                (segment construction: given a line segment
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mi c
                    %annotation{:encoding => "application/x-tex"} b c
                and a line segment from
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                    %annotation{:encoding => "application/x-tex"} q
                to
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                      %annotation{:encoding => "application/x-tex"} a
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mi x
                    %annotation{:encoding => "application/x-tex"} a x
                congruent to
                = succeed ")," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                        %mi c
                      %annotation{:encoding => "application/x-tex"} b c
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ≠
                      %mi b
                      %mo ,
                      %mi B
                      %mi a
                      %mi b
                      %mi c
                      %mo ,
                      %mi B
                      %mi a
                      %mo ′
                      %mi b
                      %mo ′
                      %mi c
                      %mo ′
                      %mo ,
                      %mi a
                      %mi b
                      %mo ≡
                      %mi a
                      %mo ′
                      %mi b
                      %mo ′
                      %mo ,
                      %mi b
                      %mi c
                      %mo ≡
                      %mi b
                      %mo ′
                      %mi c
                      %mo ′
                      %mo ,
                      %mi a
                      %mi d
                      %mo ≡
                      %mi a
                      %mo ′
                      %mi d
                      %mo ′
                      %mo ,
                      %mi b
                      %mi d
                      %mo ≡
                      %mi b
                      %mo ′
                      %mi d
                      %mo ′
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo ⊢
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mi c
                      %mi d
                      %mo ≡
                      %mi c
                      %mo ′
                      %mi d
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} a \neq b, B a b c, B a' b' c', a b \equiv a' b', b c \equiv b' c', a d \equiv a' d', b d \equiv b' d' \;\; \vdash \;\; c d \equiv c' d'
                (5 segment axiom),
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi B
                      %mi a
                      %mi b
                      %mi a
                      %mspace{:width => "thickmathspace"}
                      %mo ⊢
                      %mspace{:width => "thickmathspace"}
                      %mi a
                      %mo =
                      %mi b
                    %annotation{:encoding => "application/x-tex"} B a b a \; \vdash \; a = b
                ,
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mi a
                      %mi p
                      %mi c
                      %mo ,
                      %mi B
                      %mi b
                      %mi q
                      %mi c
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo ⊢
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} (
                      %mo ∃
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mi B
                      %mi p
                      %mi x
                      %mi b
                      %mo ∧
                      %mi B
                      %mi q
                      %mi x
                      %mi a
                    %annotation{:encoding => "application/x-tex"} B a p c, B b q c \;\; \vdash \;\; (\exists x)\; B p x b \wedge B q x a
                (Pasch axiom: roughly, if a line goes through one side of a triangle and not through a vertex, then it must go through another side),
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⊢
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} (
                      %mo ∃
                      %mi a
                      %mo ,
                      %mi b
                      %mo ,
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ¬
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mi a
                      %mi b
                      %mi c
                      %mo ∨
                      %mi B
                      %mi b
                      %mi c
                      %mi a
                      %mo ∨
                      %mi B
                      %mi c
                      %mi a
                      %mi b
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \vdash \; (\exists a, b, c)\; \neg (B a b c \vee B b c a \vee B c a b)
                (there exist three non-collinear points: the dimension is at least 2),
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ≠
                      %mi q
                      %mo ,
                      %mi a
                      %mi p
                      %mo ≡
                      %mi a
                      %mi q
                      %mo ,
                      %mi b
                      %mi p
                      %mo ≡
                      %mi b
                      %mi q
                      %mo ,
                      %mi c
                      %mi p
                      %mo ≡
                      %mi c
                      %mi q
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo ⊢
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mi B
                      %mi a
                      %mi b
                      %mi c
                      %mo ∨
                      %mi B
                      %mi b
                      %mi c
                      %mi a
                      %mo ∨
                      %mi B
                      %mi c
                      %mi a
                      %mi b
                    %annotation{:encoding => "application/x-tex"} p \neq q, a p \equiv a q, b p \equiv b q, c p \equiv c q \;\; \vdash \;\; B a b c \vee B b c a \vee B c a b
                (if three points are each equidistant from two given distinct points
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
