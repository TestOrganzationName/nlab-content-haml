                    %annotation{:encoding => "application/x-tex"} (\forall x, y)\; (\phi(x) \wedge \psi(y) \Rightarrow B a x y) \;\; \vdash \;\; (\exists b)(\forall x, y)\; (\phi(x) \wedge \psi(y) \Rightarrow B x b y)
              %p
                (if every element
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                    %annotation{:encoding => "application/x-tex"} y
                in the set defined by
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
