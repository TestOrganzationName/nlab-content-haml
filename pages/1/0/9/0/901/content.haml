                    %mo ,
                    %mi F
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Y,F)
              (with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cofinally+small+category"} cofinally small
          %h3#functoriality Functoriality
          %p
            Ind-cocompletion is functorial – in fact an underlying 2-functor of a
            %a.existingWikiWord{:href => "/nlab/show/lax-idempotent+2-monad"} lax-idempotent 2-monad
            (KZ-monad). More in detail:
          #FunctorialityOfInd.num_prop
            %h6#proposition_9 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi 𝒞
                      %mn 1
                    %mo ⟶
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} F \colon \mathcal{C}_1 \longrightarrow \mathcal{C}
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              %a.existingWikiWord{:href => "/nlab/show/extension"} extension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ind
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ind(F)
              of this functor to ind-objects, i.e. a
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi 𝒞
                              %mn 1
                          %mtd
                            %mover
                              %mo ⟶
                              %mi F
                          %mtd
                            %msub
                              %mi 𝒞
                              %mn 2
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi Ind
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi 𝒞
                              %mn 1
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %mi Ind
                                %mo{:stretchy => "false"} (
                                %mi F
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi Ind
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi 𝒞
                              %mn 2
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathcal{C}_1 &amp;\overset{F}{\longrightarrow}&amp; \mathcal{C}_2
                    \\\
                    \\downarrow
                    \&amp;&amp;
                    \\downarrow
                    \\\
                    Ind(\mathcal{C}_1)
                    \&amp;\underset{Ind(F)}{\longrightarrow}&amp;
                    Ind(\mathcal{C}_2)
                    }
                    \\,,
            %p such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ind
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msup
                      %munder
                        %mi lim
                        %mo ⟶
                      %mi f
                    %mi α
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %munder
                        %mi lim
                        %mo ⟶
                      %mi f
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo ∘
                    %mi α
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Ind(F)( \underset{\longrightarrow}{\lim}^f \alpha )
                    \\simeq
                    \\underset{\longrightarrow}{\lim}^f ( F \circ \alpha )
                    \\,.
            %p Moreover,
            %ol
              %li
                %p
                  this construction respects
                  %a.existingWikiWord{:href => "/nlab/show/composition"} composition
                  in that
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Ind
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo ∘
                        %mi F
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %mi Ind
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo{:stretchy => "false"} )
                        %mo ∘
                        %mi Ind
                        %mo{:stretchy => "false"} (
                        %mi F
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        Ind(G \circ F ) \simeq Ind(G) \circ Ind(F)
              %li
                %p
                  if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/faithful+functor"} faithful functor
                  or
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful functor
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Ind
                          %mo{:stretchy => "false"} (
                          %mi F
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} Ind(F)
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#KashiwaraSchapira06"} KashiwaraSchapira 06, prop.6.1.9-6.1.11
          .num_prop
            %h6#proposition_10 Proposition
            %p
              Ind-completion commutes with
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/comma+category"} comma categories
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi 𝒞
                    %mo →
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} F:\mathcal{C}\to\mathcal{E}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo :
                    %mi 𝒟
                    %mo →
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} G:\mathcal{D}\to\mathcal{E}
              are functors, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ind
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} /
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ind(F/G)
              is equivalent to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Ind
                      %mo{:stretchy => "false"} (
                      %mi F
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mi Ind
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (Ind(F)/Ind(G))
          %p
            (
            %a{:href => "#KashiwaraSchapira06"}> KashiwaraSchapira 06, prop. 6.4.2
            )
          .num_prop
            %h6#proposition_11 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_2
              be two
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/small+categories"} small categories
              %a.maruku-ref{:href => "#FunctorialityOfInd"}
              the two
              %a.existingWikiWord{:href => "/nlab/show/projections"} projections
              out of their
              %a.existingWikiWord{:href => "/nlab/show/product+category"} product category
              induce a functor of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ind
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒞
                      %mn 1
                    %mo ×
                    %msub
                      %mi 𝒞
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi Ind
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒞
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi Ind
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒞
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Ind(\mathcal{C}_1 \times \mathcal{C}_2)
                    \\longrightarrow
                    Ind(\mathcal{C}_1) \times Ind(\mathcal{C}_2)
                    \\,.
            %p
              This is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
          %p
            (
            %a{:href => "#KashiwaraSchapira06"}> KashiwaraSchapira 06, prop. 6.1.12
            )
          .num_prop
            %h6#proposition_12 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
              that has
              %a.existingWikiWord{:href => "/nlab/show/finite+colimits"} finite colimits
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℐ
                  %annotation{:encoding => "application/x-tex"} \mathcal{I}
              be a finite category. Then the canonical functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ind
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi 𝒞
                      %mi ℐ
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Ind
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi ℐ
                  %annotation{:encoding => "application/x-tex"} Ind(\mathcal{C}^{\mathcal{I}}) \to Ind(\mathcal{C})^{\mathcal{I}}
            %p
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#Henry2023"} Henry 2023: 2–3, theorem 1.2
          %h3#the_case_that__already_admits_filtered_colimits
            The case that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            already admits filtered colimits
          %p
            (
            %a{:href => "#KashiwaraSchapira06"}> KashiwaraSchapira 06, chapter 6.3
            )
          #ReflectionToYonedaEmbedding.num_prop
            %h6#proposition_13 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              which has all small
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/filtered+colimits"} filtered colimits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo ⟶
                    %mi Ind
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{C} \longrightarrow Ind(\mathcal{C})
              defines a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective subcategory
              %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful functor
              with a
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ⟶
                        %mrow
                      %mover
                        %mo ⟵
                        %mi L
                    %mi Ind
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}
                    \\underoverset
                    {\underset{}{\longrightarrow}}
                    {\overset{L}{\longleftarrow}}
                    {\bot}
                    Ind(\mathcal{C})
            %p
              which takes formal filtered colimits to actual filtered colimits in
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %munder
                        %mi lim
                        %mo ⟶
                      %mi f
                    %mi α
                    %mo ↦
                    %munder
                      %mi lim
                      %mo ⟶
                    %mi α
                  %annotation{:encoding => "application/x-tex"}
                    L
                    \\;\colon\;
                    \\underset{\longrightarrow}{\lim}^f \alpha
                    \\mapsto
                    \\underset{\longrightarrow}{\lim} \alpha
          %p
            (
            %a{:href => "#KashiwaraSchapira06"}> KashiwaraSchapira 06, prop. 6.3.1
            )
          #JFIsFullyFaithful.num_prop
            %h6#proposition_14 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝒥
                    %mo ⟶
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} F \colon \mathcal{J} \longrightarrow \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              such that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
                  is a
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful functor
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  has all small
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/filtered+colimits"} filtered colimits
              %li
                %p
                  for every object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi J
                        %mo ∈
                        %mi 𝒥
                      %annotation{:encoding => "application/x-tex"} J \in \mathcal{J}
                  its image
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi J
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} F(J) \in \mathcal{C}
                  is
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/compact+object"} compact
            %p Then the composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ind
                    %mo{:stretchy => "false"} (
                    %mi 𝒥
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %mi Ind
                        %mo{:stretchy => "false"} (
                        %mi F
                        %mo{:stretchy => "false"} )
                    %mi Ind
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mi L
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"}
                    Ind(\mathcal{J})
                    \\overset{Ind(F)}{\longrightarrow}
                    Ind(\mathcal{C})
                    \\overset{L}{\longrightarrow}
                    \\mathcal{C}
            %p
              (with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ind
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ind(F)
              from prop.
              %a.maruku-ref{:href => "#FunctorialityOfInd"}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              from prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#ReflectionToYonedaEmbedding"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful functor
          %p
            (
            %a{:href => "#KashiwaraSchapira06"}> KashiwaraSchapira 06, prop. 6.3.4
            )
          .num_prop
            %h6#proposition_15 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              such that
            %ol
              %li
                %p
                  every object of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/filtered+colimit"} filtered colimit
                  of
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/compact+objects"} compact objects
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  has all small
                  %a.existingWikiWord{:href => "/nlab/show/filtered+colimits"} filtered colimits
            %p then the composite functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ind
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒞
                      %mi cpt
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi Ind
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mi L
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"}
                    Ind(\mathcal{C}_{cpt})
                    \\longrightarrow
                    Ind(\mathcal{C})
                    \\overset{L}{\longrightarrow}
                    \\mathcal{C}
            %p
              (from prop.
              = succeed "," do
                %a.maruku-ref{:href => "#JFIsFullyFaithful"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mi cpt
                    %mo ↪
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_{cpt} \hookrightarrow \mathcal{C}
              is the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              of
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/compact+objects"} compact objects
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
          %p
            (
            %a{:href => "#KashiwaraSchapira06"}> KashiwaraSchapira 06, corollary 6.3.5
            )
          %h2#applications Applications
          %ul
            %li
              One important use of categories of ind-objects is in
              = succeed "-theory:" do
                %a.existingWikiWord{:href => "/nlab/show/abelian+sheaf"} abelian sheaf
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small
              %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              the category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ind
                    %mtext -
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} ind\text{-}\mathcal{C}
              is a
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+category"} Grothendieck category
              and hence a good coefficient object for
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/abelian+sheaf+cohomology"} abelian sheaf cohomology
          %h2#in_higher_category_theory In higher category theory
          %h3#in_categories
            In
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %p
            There is a notion of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/ind-object+in+an+%28%E2%88%9E%2C1%29-category"} ind-object in an (∞,1)-category
          %p
            With regard to the third of the properties listed above, notice that the
            %a.existingWikiWord{:href => "/nlab/show/comma+category"} comma category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo ,
                  %msub
                    %mi const
                    %mi F
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (Y,const_F)
            is the
            %a.existingWikiWord{:href => "/nlab/show/category+of+elements"} category of elements
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
            of the
            %a.existingWikiWord{:href => "/nlab/show/generalized+universal+bundle"} universal Set-bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo :
                  %msub
                    %mi Set
                    %mo *
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} U : Set_* \to Set
            along
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} F : \mathcal{C}^{op} \to Set
            %a.existingWikiWord{:href => "/nlab/show/stuff%2C+structure%2C+property"} forgetful functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo ,
                  %msub
                    %mi const
                    %mi F
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"}
                  (Y,const_F) \to \mathcal{C}
            is the fibration classified by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
          %p
            This is the starting point for the definition at
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/ind-object+in+an+%28%E2%88%9E%2C1%29-category"} ind-object in an (∞,1)-category
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %strong ind-object
                \/
                %a.existingWikiWord{:href => "/nlab/show/ind-object+in+an+%28%E2%88%9E%2C1%29-category"} ind-object in an (∞,1)-category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/locally+finitely+presentable+category"} locally finitely presentable category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/pro-object"} pro-object
                \/
                %a.existingWikiWord{:href => "/nlab/show/pro-object+in+an+%28%E2%88%9E%2C1%29-category"} pro-object in an (∞,1)-category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/sind-object"} sind-object
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/ind-pro-object"} ind-pro-object
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/strict+ind-object"} strict ind-object
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/flat+functor"} flat functor
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/KZ-monad"} KZ-monad
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/continuous+category"} continuous category
          %h2#references References
          %p Ind-categories were introduced in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Alexander+Grothendieck"}> Alexander Grothendieck
              ,
              %a.existingWikiWord{:href => "/nlab/show/Jean-Louis+Verdier"} Jean-Louis Verdier
              in
              %a.existingWikiWord{:href => "/nlab/show/SGA4"} SGA4
              Exp. 1
              %a{:href => "http://sage.math.washington.edu/home/wstein/www/home/craigcitro/sga4/Grothendieck/SGA4/sga41.pdf"} pdf file
          %p
            and the dual notion of
            %a.existingWikiWord{:href => "/nlab/show/pro-object"} pro-object
            in
          %ul
            %li
              A. Grothendieck,
              = succeed "," do
                %em Techniques de déscente et théorèmes d’existence en géométrie algébrique, II: le théorème d’existence en théorie formelle des modules
              = succeed "," do
                %strong 195
              = succeed "." do
                %a{:href => "http://archive.numdam.org/ARCHIVE/SB/SB_1958-1960__5_/SB_1958-1960__5__369_0/SB_1958-1960__5__369_0.pdf"} (pdf)
          %p Ind-objects are discussed in
          %ul
            %li#ArtinMazur69
              %a.existingWikiWord{:href => "/nlab/show/Michael+Artin"}> Michael Artin
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Barry+Mazur"} Barry Mazur
              = succeed "," do
                %em Étale homotopy theory
          %p
            (in their dual guise as
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/pro-objects"} pro-objects
          %ul
            %li#KashiwaraSchapira06
              %p
                %a.existingWikiWord{:href => "/nlab/show/Masaki+Kashiwara"}> Masaki Kashiwara
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Pierre+Schapira"} Pierre Schapira
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Categories+and+Sheaves"} Categories and Sheaves
                , Grundlehren der mathematischen Wissenschaften 332 (2006).
            %li#Johnstone1982
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+Johnstone"}> Peter Johnstone
                , section VI.1 of
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Stone+Spaces"} Stone Spaces
                %strong 3
                (1982).
          %p The relation between the Ind-completion and the ideal completion in order theory is discussed in section 1 of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Peter+Johnstone"}> Peter Johnstone
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Andr%C3%A9+Joyal"} André Joyal
              %em Continuous categories and exponentiable toposes
              , JPAA
              %strong 25
              (1982) pp.255-296.
          %p They are discussed in relation to generalisations in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Ji%C5%99%C3%AD+Ad%C3%A1mek"}> Jiří Adámek
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Francis+Borceux"} Francis Borceux
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Stephen+Lack"} Stephen Lack
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Jiri+Rosicky"} Jiří Rosický
              %em A classification of accessible categories,
              Journal of Pure and Applied Algebra 175:7-30, 2002.
              %a{:href => "http://maths.mq.edu.au/~slack/papers/acc.html"} abstract
          %p See also the remarks at the beginning of section 5.3 of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              ,
              %em
                %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} Higher Topos Theory
          %p Some relevant results are contained in:
          %ul
            %li#Henry2023_MO
              %p
                %a.existingWikiWord{:href => "/nlab/show/Simon+Henry"}> Simon Henry
                , answer &amp;lbrack;
                %a{:href => "https://mathoverflow.net/a/442827"}> MO:a/442827
                \&amp;rbrack;
              %p
                to
                %em
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} Ind
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi C
                          %mi I
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} Ind
                        %mo{:stretchy => "false"} (
                        %mi C
                        %msup
                          %mo{:stretchy => "false"} )
                          %mi I
                      %annotation{:encoding => "application/x-tex"} \operatorname{Ind}(C^I)=\operatorname{Ind}(C)^I
                  ?
                \&amp;lbrack;
                %a{:href => "https://mathoverflow.net/q/442827"}> MO:q/442827
                \&amp;rbrack;
            %li#Henry2023
              %p
                %a.existingWikiWord{:href => "/nlab/show/Simon+Henry"}> Simon Henry
                \:
                = succeed "," do
                  %em
                    When does
                    = succeed "?" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:lspace => "0em", :rspace => "thinmathspace"} Ind
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi C
                              %mi I
                            %mo{:stretchy => "false"} )
                            %mo ≃
                            %mo{:lspace => "0em", :rspace => "thinmathspace"} Ind
                            %mo{:stretchy => "false"} (
                            %mi C
                            %msup
                              %mo{:stretchy => "false"} )
                              %mi I
                          %annotation{:encoding => "application/x-tex"} \operatorname{Ind}(C^I)\simeq\operatorname{Ind}(C)^I
                = succeed "&rbrack;" do
                  %a{:href => "https://arxiv.org/abs/2307.06664"} arXiv:2307.06664
