          %h2#Idea Idea
          %p
            Yang–Mills theory is a
            %a.existingWikiWord{:href => "/nlab/show/gauge+theory"} gauge theory
            on a given 4-
            %a.existingWikiWord{:href => "/nlab/show/dimensional"} dimensional
            (
            %a.existingWikiWord{:href => "/nlab/show/pseudo-Riemannian+metric"}> pseudo
            \-)
            %a.existingWikiWord{:href => "/nlab/show/Riemannian+manifold"} Riemannian
            %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            whose field is the
            %a.existingWikiWord{:href => "/nlab/show/Yang%E2%80%93Mills+field"} Yang–Mills field
            – a cocycle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mover
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mo{:stretchy => "false"} ¯
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \nabla \in \mathbf{H}(X,\bar \mathbf{B}U(n))
            in differential
            %a.existingWikiWord{:href => "/nlab/show/nonabelian+cohomology"} nonabelian cohomology
            represented by a
            %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
            %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} with connection
            – and whose
            %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                  %mo ↦
                  %mfrac
                    %mn 1
                    %mrow
                      %msup
                        %mi g
                        %mn 2
                  %msub
                    %mo ∫
                    %mi X
                  %mi tr
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi F
                    %mo ∇
                  %mo ∧
                  %mo ⋆
                  %msub
                    %mi F
                    %mo ∇
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo +
                  %mspace{:width => "thickmathspace"}
                  %mi i
                  %mi θ
                  %msub
                    %mo ∫
                    %mi X
                  %mi tr
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi F
                    %mo ∇
                  %mo ∧
                  %msub
                    %mi F
                    %mo ∇
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\nabla \mapsto
                  \\frac{1}{g^2 }\int_X tr(F_\nabla \wedge \star F_\nabla)  \;+\; i \theta \int_X tr(F_\nabla \wedge F_\nabla)
          %p for
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mo ∇
                    %annotation{:encoding => "application/x-tex"} F_\nabla
                the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/field+strength"} field strength
                %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔲
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathfrak{u}(n)
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+valued+differential+form"} Lie algebra valued differential form
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                ( with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔲
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathfrak{u}(n)
