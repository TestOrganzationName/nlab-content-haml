          %h2#idea Idea
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/solid+state+physics"} solid state physics
            = succeed "-species" do
              %a.existingWikiWord{:href => "/nlab/show/anyon"} anyon
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/topological+quantum+computation"} topological quantum computation
            %a.existingWikiWord{:href => "/nlab/show/affine+Lie+algebras"} affine Lie algebras
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mover
                      %mi 𝔤
                      %mo ^
                    %mi k
                %annotation{:encoding => "application/x-tex"} \widehat{\mathfrak{g}}^k
            (at some
            %a.existingWikiWord{:href => "/nlab/show/level+%28Chern-Simons+theory%29"} level
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %a.existingWikiWord{:href => "/nlab/show/wavefunctions"} wavefunctions
            are, essentially,
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi g
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \widehat{g}
            %a.existingWikiWord{:href => "/nlab/show/conformal+blocks"} conformal blocks
            and their
            %a.existingWikiWord{:href => "/nlab/show/braid+group+representation"} braiding
            is described by
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
            at
            %a.existingWikiWord{:href => "/nlab/show/level+%28Chern-Simons+theory%29"} level
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            (possibly fractional, see at
            %em
              %a.existingWikiWord{:href => "/nlab/show/logarithmic+CFT"} logarithmic CFT
            = succeed ")." do
              %a{:href => "logarithmic+CFT#FractionalLevelWZWModelReferences"} here
          %p
            If here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
