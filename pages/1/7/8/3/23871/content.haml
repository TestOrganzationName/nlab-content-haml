          %p
            Early discussion of
            %a.existingWikiWord{:href => "/nlab/show/topological+quantum+computation"} topological quantum computation
            in
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
