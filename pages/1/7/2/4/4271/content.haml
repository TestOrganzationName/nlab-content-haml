                      ,
                      = succeed "," do
                        %a.existingWikiWord{:href => "/nlab/show/quantum+effect"} quantum effect
                      %a.existingWikiWord{:href => "/nlab/show/effect+algebra"} effect algebra
                  %li
                    %p
                      in
                      %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field theory
                    %ul
