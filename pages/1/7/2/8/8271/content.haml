          %h2#Definition Definition
          %p Originally, t-structures were defined
          %ul
            %li
              %a{:href => "#OnTriangulatedCategories"} on triangulated categories
          %p
            These typically arise as
            %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+an+%28infinity%2C1%29-category"} homotopy categories
            of t-structures
          %ul
            %li
              %a{:href => "#InStableInfinityCategories"}>
                on stable
                = succeed "-categories" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
              \.
          %h3#OnTriangulatedCategories On triangulated categories
          %p
          #tStructure.num_defn
            %h6 Definition
            %p
              %strong (t-structure on a triangulated category)
              %br/
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/triangulated+category"} triangulated category
              %em t-structure
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is a
              %a.existingWikiWord{:href => "/nlab/show/pair"} pair
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔱
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mrow
                        %mo ≥
                        %mn 0
                    %mo ,
                    %msub
                      %mi C
                      %mrow
                        %mo ≤
                        %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{t}=(C_{\ge 0}, C_{\le 0})
              of
              %a.existingWikiWord{:href => "/nlab/show/strictly+full+subcategories"} strictly full subcategories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mrow
                        %mo ≥
                        %mn 0
                    %mo ,
                    %msub
                      %mi C
                      %mrow
                        %mo ≤
                        %mn 0
                    %mo ↪
                    %mi C
                  %annotation{:encoding => "application/x-tex"}
                    C_{\geq 0}, C_{\leq 0} \hookrightarrow C
            %p such that
            %ol
              %li
                %p
                  for all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ∈
                        %msub
                          %mi C
                          %mrow
                            %mo ≥
                            %mn 0
                      %annotation{:encoding => "application/x-tex"} X \in C_{\geq 0}
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                        %mo ∈
                        %msub
                          %mi C
                          %mrow
                            %mo ≤
                            %mn 0
                      %annotation{:encoding => "application/x-tex"} Y \in C_{\leq 0}
                  the
                  %a.existingWikiWord{:href => "/nlab/show/hom+object"} hom object
                  is the
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/zero+object"} zero object
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi Hom
                            %mi C
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mi Y
                          %mo{:stretchy => "false"} [
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                          %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} Hom_{C}(X, Y[-1]) = 0
              %li
                %p
                  the subcategories are closed under
                  = succeed "/desuspension:" do
                    %a.existingWikiWord{:href => "/nlab/show/suspension"} suspension
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi C
                          %mrow
                            %mo ≥
                            %mn 0
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                        %mo ⊂
                        %msub
                          %mi C
                          %mrow
                            %mo ≥
                            %mn 0
                      %annotation{:encoding => "application/x-tex"} C_{\geq 0}[1] \subset C_{\geq 0}
                  and
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi C
                            %mrow
                              %mo ≤
                              %mn 0
                          %mo{:stretchy => "false"} [
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                          %mo{:stretchy => "false"} ]
                          %mo ⊂
                          %msub
                            %mi C
                            %mrow
                              %mo ≤
                              %mn 0
                        %annotation{:encoding => "application/x-tex"} C_{\leq 0}[-1] \subset C_{\leq 0}
              %li
                %p
                  For all
                  %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ∈
                        %mi C
                      %annotation{:encoding => "application/x-tex"} X \in C
                  there is a
                  %a.existingWikiWord{:href => "/nlab/show/fiber+sequence"} fiber sequence
                  (i.e. an
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/exact+triangle"} exact triangle
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                        %mo →
                        %mi X
                        %mo →
                        %mi Z
                      %annotation{:encoding => "application/x-tex"} Y \to X \to Z
                  with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                        %mo ∈
                        %msub
                          %mi C
                          %mrow
                            %mo ≥
                            %mn 0
                      %annotation{:encoding => "application/x-tex"} Y \in C_{\geq 0}
                  and
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Z
                          %mo ∈
                          %msub
                            %mi C
                            %mrow
                              %mo ≤
                              %mn 0
                          %mo{:stretchy => "false"} [
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                          %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"} Z \in C_{\leq 0}[-1]
            %p
          %p
          #HeartOfATStructure.num_defn
            %h6 Definition
            %p
              Given a t-structure (Def.
              = succeed ")," do
                %a.maruku-ref{:href => "#tStructure"}
              %em heart
              is the intersection
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mrow
                        %mo ≥
                        %mn 0
                    %mo ∩
                    %msub
                      %mi C
                      %mrow
                        %mo ≤
                        %mn 0
                    %mo ↪
                    %mi C
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    C_{\geq 0} \cap C_{\leq 0}
                    \\hookrightarrow
                    C
                    \\,.
            %p
          %h3#InStableInfinityCategories
            On stable
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
          #tStructureOnStableInfinityCategory.num_defn
            %h6 Definition
            %p
              %strong
                (t-structure in a stable
                = succeed "-category)" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
              %br/
              A
              %em t-structure
              on a
              %a.existingWikiWord{:href => "/nlab/show/stable+%28%E2%88%9E%2C1%29-category"} stable (∞,1)-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is a t-structure in the above sense (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#tStructure"}
              %a.existingWikiWord{:href => "/nlab/show/underlying"} underlying
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+an+%28%E2%88%9E%2C1%29-category"} homotopy category
              (which is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/triangulated+category"} triangulated
              = succeed ")." do
                %a{:href => "stable+infinity-category#TheTriangulatedHomotopyCategory"} there
          (
          %a{:href => "#LurieHA"}> Lurie, Higher Algebra, Def. 1.2.1.4
          )
          %p
            Therefore, a t-structure on a stable
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            is a system of
            %a.existingWikiWord{:href => "/nlab/show/full+sub-%28%E2%88%9E%2C1%29-categories"} full sub-(∞,1)-categories
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mrow
                        %mo ≥
                        %mi n
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_{\geq n}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mrow
                        %mo ≤
                        %mi n
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_{\leq n}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{Z}
          %p
          .num_prop
            %h6 Proposition
            %p
              In this situation (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#tStructureOnStableInfinityCategory"}
            %ol
              %li
                %p
                  the
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝒞
                          %mrow
                            %mo ≤
                            %mi n
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}_{\leq n}
                  are
                  %a.existingWikiWord{:href => "/nlab/show/reflective+sub-%28%E2%88%9E%2C1%29-categories"} reflective sub-(∞,1)-categories
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝒞
                          %mrow
                            %mo ≤
                            %mi n
                        %munderover
                          %mrow
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mo ⊥
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                          %munder
                            %mo ↪
                            %mrow
                          %mover
                            %mo ⟵
                            %mrow
                              %msub
                                %mi τ
                                %mrow
                                  %mo ≤
                                  %mi n
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"}
                        \\mathcal{C}_{\leq n}
                        \\underoverset
                        {\underset{}{\hookrightarrow}}
                        {\overset{\tau_{\leq n}}{\longleftarrow}}
                        {\;\; \bot \;\;}
                        \\mathcal{C}
              %li
                %p
                  the
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝒞
                          %mrow
                            %mo ≥
                            %mi n
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}_{\geq n}
                  are
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/coreflective+sub-%28%E2%88%9E%2C1%29-categories"} coreflective sub-(∞,1)-categories
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                        %munderover
                          %mrow
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mo ⊥
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                          %munder
                            %mo ⟶
                            %mrow
                              %msub
                                %mi τ
                                %mrow
                                  %mo ≥
                                  %mi n
                          %mo ↩
                        %msub
                          %mi 𝒞
                          %mrow
                            %mo ≤
                            %mi n
                      %annotation{:encoding => "application/x-tex"}
                        \\mathcal{C}
                        \\underoverset
                        {\underset{\tau_{\geq n}}{\longrightarrow}}
                        {\hookleftarrow}
                        {\;\; \bot \;\;}
                        \\mathcal{C}_{\leq n}
            %p
          (
          %a{:href => "#LurieHA"}> Lurie, Higher Algebra, Def. 1.2.1.5, Cor. 1.2.1.6, Ntn. 1.2.1.7
          )
          %center
            %img{:src => "https://ncatlab.org/nlab/files/HeartOfTStructureAsCoModals-230408.jpg", :width => "600"}/
          %h2#properties Properties
          %h3#general General
          .num_prop
            %h6#proposition Proposition
            %p
              The heart of a stable
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian category
          %p
            (
            %a{:href => "#BeilinsonBernsteinDeligne82"}> BBD 82
            ,
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Algebra"} Higher Algebra, remark 1.2.1.12
            %a{:href => "#FL16"} FL16, Ex. 4.1
            and
            = succeed ")" do
              %a{:href => "#FLM19"} FLM19, §3.1
          %h3#relation_to_spectral_sequences Relation to spectral sequences
          %p
            If the heart (Def.
            = succeed ")" do
              %a.maruku-ref{:href => "#HeartOfATStructure"}
            %a.existingWikiWord{:href => "/nlab/show/stable+%28%E2%88%9E%2C1%29-category"} stable (∞,1)-category
            with
            %a.existingWikiWord{:href => "/nlab/show/sequential+limits"} sequential limits
            is an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian category
            %a.existingWikiWord{:href => "/nlab/show/spectral+sequence+of+a+filtered+stable+homotopy+type"} spectral sequence of a filtered stable homotopy type
            %a{:href => "spectral+sequence#ConvergenceOfSpectralSequences"} converges
            (see there).
          %h3#RelationToNormalTorsionTheories Relation to normal torsion theories
          %p
            In the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+theory"} (∞,1)-category theory
            = succeed "-structures" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
            %a.existingWikiWord{:href => "/nlab/show/torsion+theory"} torsion/torsionfree
            classes associated with suitable
            %a.existingWikiWord{:href => "/nlab/show/orthogonal+factorization+system"} factorization systems
            on
            %a.existingWikiWord{:href => "/nlab/show/stable+%E2%88%9E-categories"} stable ∞-categories
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %ul
            %li
              %p
                In
                = succeed "-theory," do
                  %a.existingWikiWord{:href => "/nlab/show/stable+%E2%88%9E-category"} stable ∞-category
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-categories"} (∞,1)-categories
                are closed under de/suspension simply because they are (co-)
                %a.existingWikiWord{:href => "/nlab/show/reflective+sub-%28%E2%88%9E%2C1%29-categories"}> reflective
                , arising from co/
                %a.existingWikiWord{:href => "/nlab/show/reflective+factorization+systems"} reflective factorization systems
                on
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
            %li
              %p
                A
                %em bireflective
                factorization system on a
                = succeed "-category" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                consists of a
                %a.existingWikiWord{:href => "/nlab/show/orthogonal+factorization+system"} factorization system
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔽
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo ,
                      %mi M
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbb{F}=(E,M)
                where both classes satisfy the
                %a.existingWikiWord{:href => "/nlab/show/two-out-of-three"} two-out-of-three
                property.
            %li
              %p
                A bireflective factorization system
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo ,
                      %mi M
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (E,M)
                on a stable
                = succeed "-category" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                is called
                %em normal
                if the diagram
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mi x
                      %mo →
                      %mi x
                      %mo →
                      %mi R
                      %mi x
                    %annotation{:encoding => "application/x-tex"} S x\to x\to R x
                obtained from the reflection
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo{:lspace => "verythinmathspace"} :
                      %mi C
                      %mo →
                      %mi M
                      %mo{:stretchy => "false"} /
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} R\colon C\to M/0
                and the coreflection
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo{:lspace => "verythinmathspace"} :
                      %mi C
                      %mo →
                      %mo *
                      %mspace{:width => "negativethinmathspace"}
                      %mo{:stretchy => "false"} /
                      %mi E
                    %annotation{:encoding => "application/x-tex"} S\colon C\to *\!/E
                (where the category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                      %mo{:stretchy => "false"} /
                      %mspace{:width => "negativethinmathspace"}
                      %mo *
                      %mo =
                      %mo{:stretchy => "false"} {
                      %mi A
                      %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo →
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi M
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} M/\!* =\{A\mid (0\to A)\in M\}
                is obtained as
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ψ
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo ,
                      %mi M
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Psi(E,M)
                under the adjunction
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Φ
                      %mo ⊣
                      %mi Ψ
                    %annotation{:encoding => "application/x-tex"} \Phi \dashv \Psi
                described at
                %em
                  %a.existingWikiWord{:href => "/nlab/show/reflective+factorization+system"} reflective factorization system
                and in
                = succeed ";" do
                  %a{:href => "#CHK85"} CHK85
                = succeed ")" do
                  %a{:href => "#FL16"} FL16, §1.1
                = succeed "," do
                  %em exact
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mtable{:columnalign => "center center center center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %mo →
                          %mtd
                            %mi S
                            %mi X
                          %mtd
                            %mo →
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mn 0
                          %mtd
                            %mo →
                          %mtd
                            %mi R
                            %mi X
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mn 0
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{array}{cccccc}
                      0 &amp;\to&amp; S X &amp;\to&amp; X\\
                      \&amp;&amp; \downarrow&amp;&amp;\downarrow\\
                      \&amp;&amp; 0 &amp;\to&amp; R X\\
                      \&amp;&amp; &amp;&amp; \downarrow\\
                      \&amp;&amp; &amp;&amp; 0
                      \\end{array}
              %p
                is a fiber sequence for any object
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                %a{:href => "#FL16"} FL16, Def 3.5 and Prop. 3.10
                for equivalent conditions for normality.
          %p
          .num_remark
            %h6 Remark
            %p
              %a{:href => "#CHK85"} CHK85
              established a hierarchy between the three notions of simple, semi-exact and normal factorization system: in the setting of stable
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              = succeed "." do
                %a{:href => "#FL16"} FL16, Thm 3.11
          %p
          #CorrespondenceWithNormalTorsionTheories.num_prop
            %h6 Proposition
            %p
              There is a bijective correspondence between the class
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi TS
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} TS( C )
              of
              = succeed "-structures" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                    %annotation{:encoding => "application/x-tex"} t
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
            %ul
              %li
                %p
                  On the one side, given a normal, bireflective factorization system
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo ,
                        %mi M
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (E,M)
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  we define the two classes
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi C
                          %mrow
                            %mo ≥
                            %mn 0
                        %mo{:stretchy => "false"} (
                        %mi 𝔽
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %msub
                          %mi C
                          %mrow
                            %mo &lt;
                            %mn 0
                        %mo{:stretchy => "false"} (
                        %mi 𝔽
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (C_{\ge0}(\mathbb{F}), C_{\lt 0}(\mathbb{F}))
                  of a
                  = succeed "-structure" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi t
                        %annotation{:encoding => "application/x-tex"} t
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔱
                        %mo{:stretchy => "false"} (
                        %mi 𝔽
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathfrak{t}(\mathbb{F})
                  to be the torsion and torsionfree classes
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo *
                        %mspace{:width => "negativethinmathspace"}
                        %mo{:stretchy => "false"} /
                        %mi E
                        %mo ,
                        %mi M
                        %mo{:stretchy => "false"} /
                        %mspace{:width => "negativethinmathspace"}
                        %mo *
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (*\!/E, M/\!*)
                  associated to the factorization
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi E
                          %mo ,
                          %mi M
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (E,M)
              %li
                %p
                  On the other side, given a
                  = succeed "-structure" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi t
                        %annotation{:encoding => "application/x-tex"} t
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  we set
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                        %mo{:stretchy => "false"} (
                        %mi t
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo{:stretchy => "false"} {
                        %mi f
                        %mo ∈
                        %msup
                          %mi C
                          %mrow
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mn 1
                            %mo{:stretchy => "false"} ]
                        %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                        %msub
                          %mi τ
                          %mrow
                            %mo &lt;
                            %mn 0
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mtext is an equivalence
                        %mo{:stretchy => "false"} }
                        %mo ;
                      %annotation{:encoding => "application/x-tex"} E(t)=\{f\in C^{\Delta[1]} \mid \tau_{\lt 0}(f) \;\text{ is an equivalence}\};
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi M
                        %mo{:stretchy => "false"} (
                        %mi t
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo{:stretchy => "false"} {
                        %mi f
                        %mo ∈
                        %msup
                          %mi C
                          %mrow
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mn 1
                            %mo{:stretchy => "false"} ]
                        %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                        %msub
                          %mi τ
                          %mrow
                            %mo ≥
                            %mn 0
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mtext is an equivalence
                        %mo{:stretchy => "false"} }
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        M(t)=\{f\in C^{\Delta[1]} \mid \tau_{\geq0}(f) \;\text{ is an equivalence}\}.
            %p
          %p
            This is
            %a{:href => "#FL16"} FL16, Theorem 3.13
          %p
          .num_prop
            %h6 Proposition
            %p
              There is a natural monotone action of the group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              of integers on the class
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi TS
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} TS( C )
              (now confused with the class
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi FS
                      %mi ν
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} FS_\nu( C )
              of normal torsion theories on
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔽
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi M
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{F}=(E,M)
              goes to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔽
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo ,
                      %mi M
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbb{F}[1] = (E[1], M[1])
          %p
            This correspondence leads to study
            %em families
            of
            = succeed "-structures" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi 𝔽
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{\mathbb{F}_i\}_{i\in I}
            %em
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              \-equivariant
            %a.existingWikiWord{:href => "/nlab/show/k-ary+factorization+system"} multiple factorization systems
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                    %mo →
                    %mi TS
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} J\to TS( C )
          %p
          #StableTStructure.num_prop
            %h6 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔱
                    %mo ∈
                    %mi TS
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{t} \in TS(C)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔽
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi M
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{F}=(E,M)
              correspond each other under the above bijection (Prop.
              = succeed ");" do
                %a.maruku-ref{:href => "#CorrespondenceWithNormalTorsionTheories"}
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi 𝔱
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                        %mo =
                        %mi 𝔱
                      %annotation{:encoding => "application/x-tex"} \mathfrak{t}[1]=\mathfrak{t}
                  , i.e.
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi C
                            %mrow
                              %mo ≥
                              %mn 1
                          %mo =
                          %msub
                            %mi C
                            %mrow
                              %mo ≥
                              %mn 0
                        %annotation{:encoding => "application/x-tex"} C_{\geq 1}= C_{\geq 0}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi C
                          %mrow
                            %mo ≥
                            %mn 0
                        %mo =
                        %mo *
                        %mspace{:width => "negativethinmathspace"}
                        %mo{:stretchy => "false"} /
                        %mi E
                      %annotation{:encoding => "application/x-tex"} C_{\geq 0}=*\!/E
                  is a stable
                  = succeed "-category;" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn ∞
                        %annotation{:encoding => "application/x-tex"} \infty
              %li
                %p
                  the class
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
                  is closed under pullback.
            %p
          %p
            In each of these cases, we say that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔱
                %annotation{:encoding => "application/x-tex"} \mathfrak{t}
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo ,
                  %mi M
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (E,M)
            is
            = succeed "." do
              %em stable
          %p
            This is
            %a{:href => "#FLM19"} FLM19, Theorem 6.3
          %p
            This results allows us to recognize
            %em
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
              \-structures with stable classes
            precisely as those which are fixed in the natural
            = succeed "-action" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi TS
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} TS( C )
          %p
            Two “extremal” choices of
            = succeed "-chains" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            = succeed "-structures" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
            %em Harder-Narashiman filtrations
            and
            %em semiorthogonal decompositions
            on triangulated categories: we adopt the shorthand
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔱
                    %mrow
                      %mn 1
                      %mo ,
                      %mi …
                      %mo ,
                      %mi n
                %annotation{:encoding => "application/x-tex"} \mathfrak{t}_{1,\dots, n}
            to denote the tuple
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔱
                      %mn 1
                    %mo ⪯
                    %msub
                      %mi 𝔱
                      %mn 2
                    %mo ⪯
                    %mi ⋯
                    %mo ⪯
                    %msub
                      %mi 𝔱
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathfrak{t}_1\preceq \mathfrak{t}_2\preceq\cdots\preceq \mathfrak{t}_n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔱
                    %mi i
                %annotation{:encoding => "application/x-tex"} \mathfrak{t}_i
            being a
            = succeed "-structure" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi C
                    %mi i
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo ≥
                      %mn 0
                  %mo ,
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi C
                    %mi i
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo &lt;
                      %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} ((C_i)_{\ge 0}, (C_i)_{\lt 0})
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔱
                      %mi ω
                  %annotation{:encoding => "application/x-tex"} \mathfrak{t}_\omega
          %ul
            %li
              In the
              %em stable case
              the tuple
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi t
                      %mrow
                        %mn 1
                        %mo ,
                        %mi …
                        %mo ,
                        %mi n
                  %annotation{:encoding => "application/x-tex"} t_{1,\dots, n}
              is endowed with a (monotone)
              = succeed "-action," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo &lt;
                    %mn 1
                    %mi ⋯
                    %mo &lt;
                    %mi n
                    %mo{:stretchy => "false"} }
                    %mo →
                    %mi TS
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \{0\lt 1\cdots\lt n\}\to TS( C )
              is equivariant with respect to this action; the absence of nontrivial
              = succeed "-actions" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
