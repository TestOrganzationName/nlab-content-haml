              %em infinite
              family
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi t
                      %mi ω
                  %annotation{:encoding => "application/x-tex"} t_\omega
              of
              = succeed "-structures" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                    %annotation{:encoding => "application/x-tex"} t
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mn 0
                    %mo ,
                    %msub
                      %mi M
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi TS
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E_0, M_0)\in TS( C )
              with respect to the natural
              = succeed "-action." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
          %h3#towers Towers
          %p
            The HN-filtration induced by a
            = succeed "-structure" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
            %a.existingWikiWord{:href => "/nlab/show/semiorthogonal+decomposition"} semiorthogonal decomposition
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            both are the byproduct of the
            %em tower
            associated to a tuple
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔱
                      %mrow
                        %mn 1
                        %mo ,
                        %mi …
                        %mo ,
                        %mi n
                  %annotation{:encoding => "application/x-tex"} \mathfrak{t}_{1,\dots, n}
          %h2#Examples Examples
          %p
            The archetypical and historically motivating example (cf.
            = succeed ")" do
              %a{:href => "#GelfandManin96"} Gelfand &amp; Manin (1996), IV.4 §1
          %p
          #TStructureOnDerivedCategoryOfAbelianCategory.num_remark
            %h6 Example
            %p
              %strong
                (canonical t-structure on the
                %a.existingWikiWord{:href => "/nlab/show/derived+category"} derived category
                of an
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian category
              %br/
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian category
              %a.existingWikiWord{:href => "/nlab/show/derived+category"} derived category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒟
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{D}_\bullet(\mathcal{A})
            %ol
              %li
                %p
                  carries a t-structure (Def.
                  = succeed ")" do
