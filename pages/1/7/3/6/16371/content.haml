                %semantics
                  %mrow
                    %msub
                      %mi Sh
                      %mrow
                        %mi o
                        %mo{:stretchy => "false"} (
                        %mi U
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
