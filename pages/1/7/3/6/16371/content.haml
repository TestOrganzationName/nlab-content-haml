            %ul
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                    %annotation{:encoding => "application/x-tex"} j
                is open.
              %li
                The
                %a.existingWikiWord{:href => "/nlab/show/associated+sheaf+functor"} associated sheaf functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mo :
                      %mi ℰ
                      %mo →
