          %p
            See Johnstone (
            %a{:href => "#Johnstone80"}> 1980
            , pp.219-220;
            = succeed "," do
              %a{:href => "#Johnstone02"} 2002
          .num_prop
            %h6#proposition_2 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              a
              %a.existingWikiWord{:href => "/nlab/show/subterminal+object"} subterminal object
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Sh
