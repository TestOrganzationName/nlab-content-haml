                        %mi j
                      %mo{:stretchy => "false"} (
                      %mi ℰ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} L:\mathcal{E}\to Sh_j(\mathcal{E})
                is
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/logical+functor"} logical
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Sh
                        %mi j
                      %mo{:stretchy => "false"} (
                      %mi ℰ
                      %mo{:stretchy => "false"} )
                      %mo ↪
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} Sh_j(\mathcal{E})\hookrightarrow\mathcal{E}
                is an
                = succeed "." do
