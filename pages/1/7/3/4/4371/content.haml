          %p
          #smallest_j-dense.num_prop
            %h6 Proposition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topology"} topology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
              satisfies
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                      %mo ≤
                      %mo ¬
                      %mo ¬
                    %annotation{:encoding => "application/x-tex"} j\le\neg\neg
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/dense+subtopos"} dense
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi ℰ
                        %mi j
                      %msub
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mo ¬
                          %mo ¬
                      %mo =
                      %msub
                        %mi ℰ
                        %mrow
                          %mo ¬
                          %mo ¬
                    %annotation{:encoding => "application/x-tex"} (\mathcal{E}_j)_{\not\not}=\mathcal{E}_{\not\not}
          %p
          .num_prop
            %h6 Proposition
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℰ
                      %mrow
                        %mo ¬
                        %mo ¬
                    %mo ↪
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}_{\not \not} \hookrightarrow \mathcal{E}
              is a maximal
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Boolean+topos"} Boolean subtopos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              containing
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℰ
                      %mrow
                        %mo ¬
                        %mo ¬
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}_{\not \not}
              is equal to it.
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℰ
                      %mrow
                        %mo ¬
                        %mo ¬
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}_{\not \not}
              is
              %strong the
              largest Boolean subtopos, meaning every Boolean subtopos of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              is a subtopos of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℰ
                        %mrow
                          %mo ¬
                          %mo ¬
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}_{\neg\neg}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/regular+element"} regular
          %p
          .proof
            %h6 Proof
            %p
              From
              = succeed "," do
                %a{:href => "#Johnstone"} Johnstone 2002, Lemma A4.5.21
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              are exactly the “quasi-closed” subtoposes of the form
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℰ
                        %mrow
                          %mi q
                          %mo{:stretchy => "false"} (
                          %mi U
                          %mo{:stretchy => "false"} )
                      %mo :
                      %mo =
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi ℰ
                        %mrow
                          %mi c
                          %mo{:stretchy => "false"} (
                          %mi U
                          %mo{:stretchy => "false"} )
                      %msub
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mo ¬
                          %mo ¬
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}_{q(U)} := (\mathcal{E}_{c(U)})_{\neg\neg}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℰ
                      %mrow
                        %mi c
                        %mo{:stretchy => "false"} (
                        %mi U
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}_{c(U)}
              is the closed subtopos corresponding to a subterminal
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℰ
                      %mrow
                        %mi q
                        %mo{:stretchy => "false"} (
                        %mi U
                        %mo{:stretchy => "false"} )
                    %mo ⊆
                    %msub
                      %mi ℰ
                      %mrow
                        %mi q
                        %mo{:stretchy => "false"} (
                        %mi U
                        %mo ′
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}_{q(U)} \subseteq \mathcal{E}_{q(U')}
              then the same must be true of their closures; in particular,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℰ
                      %mrow
                        %mo ¬
                        %mo ¬
                    %mo =
                    %msub
                      %mi ℰ
                      %mrow
                        %mi q
                        %mo{:stretchy => "false"} (
                        %mo ⊥
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}_{\neg\neg} = \mathcal{E}_{q(\bot)}
              is maximal.
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℰ
                      %mrow
                        %mo ¬
                        %mo ¬
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}_{\neg\neg}
              to be
              %em the
              largest Boolean subtopos, each inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℰ
                      %mrow
                        %mi c
                        %mo{:stretchy => "false"} (
                        %mi U
                        %mo{:stretchy => "false"} )
                    %mo →
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}_{c(U)} \to \mathcal{E}
              must restrict to the respect double-negation subtoposes; that is, these inclusions must be
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/skeletal+geometric+morphism"} skeletal
              = succeed "," do
                %a{:href => "#Johnstone"} Johnstone 2002, Lemma D4.6.10
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} c(U)
              is a
              = succeed "-closed" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ¬
                      %mo ¬
                    %annotation{:encoding => "application/x-tex"} \neg\neg
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} c(U)
              is precisely
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
          %p From these two results, we can deduce the following characterization of the double negation topology.
          %p
          #largest_boolean.num_prop
            %h6 Proposition
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                    %mo ¬
                  %annotation{:encoding => "application/x-tex"} \not\not
              is the unique topology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
              such that (1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/dense+subtopos"} dense
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} j(0)=0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℰ
                      %mi j
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}_j
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Boolean+topos"} Boolean
          %p There are several other characterizations of the double negation topology:
          #Sierpinski.num_prop
            %h6#proposition Proposition
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                    %mo ¬
                  %annotation{:encoding => "application/x-tex"} \not \not
              is the smallest topology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              such that the canonical mono
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo ⊤
                    %mo ,
                    %mo ⊥
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo =
                    %mspace{:width => "thinmathspace"}
                    %mn 1
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo ↣
                    %mspace{:width => "thinmathspace"}
                    %mi Ω
                  %annotation{:encoding => "application/x-tex"} (\top,\bot)\, \colon \; 2 \,=\, 1\coprod 1 \, \rightarrowtail\, \Omega
              is
              = succeed "-dense." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                    %annotation{:encoding => "application/x-tex"} j
          %p
            This is theorem 2.4. in
            = succeed "." do
              %a{:href => "#Caramello09"} Caramello (2009)
          #Boolean_mono.num_prop
            %h6#proposition_2 Proposition
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                    %mo ¬
                  %annotation{:encoding => "application/x-tex"} \neg\neg
              is the smallest
              %a.existingWikiWord{:href => "/nlab/show/Lawvere-Tierney+topology"} topology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              such that all monomorphisms of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∨
                    %mo ¬
                    %mi A
                    %mo ↣
                    %mi E
                  %annotation{:encoding => "application/x-tex"} A\vee\neg A\rightarrowtail E
              for subobjects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ↣
                    %mi E
                  %annotation{:encoding => "application/x-tex"} A\rightarrowtail E
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              are
              = succeed "-dense." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                    %annotation{:encoding => "application/x-tex"} j
          %p
            This appears as proposition 6.2 in
            = succeed "." do
              %a{:href => "#Caramello12a"} Caramello (2012a)
          %p
            As the smallest dense subtopos,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℰ
                    %mrow
                      %mo ¬
                      %mo ¬
                %annotation{:encoding => "application/x-tex"} \mathcal{E}_{\not\not}
            becomes important for Lawvere’s calculus of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Aufhebung"} Aufhebung
          #RelationToAufhebungof01.num_prop
            %h6#proposition_3 Proposition
            %p
              The smallest
              %em essential
              subtopos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℰ
                      %mi j
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}_j
              that is dense (in other words the
              %a.existingWikiWord{:href => "/nlab/show/Aufhebung"} Aufhebung
              of
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo ⊣
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 0 \dashv 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℰ
                      %mrow
                        %mo ¬
                        %mo ¬
                    %mo ≤
                    %msub
                      %mi ℰ
                      %mi j
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}_{\neg\neg}\le \mathcal{E}_j
              and concides with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℰ
                      %mrow
                        %mo ¬
                        %mo ¬
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}_{\neg\neg}
              in case the latter is an
              %a.existingWikiWord{:href => "/nlab/show/essential+geometric+morphism"} essential
              subtopos:
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℰ
                      %mi j
                    %mo =
                    %msub
                      %mi ℰ
                      %mrow
                        %mo ¬
                        %mo ¬
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}_j=\mathcal{E}_{\neg\neg}
              (cf.
              = succeed ")." do
                %a{:href => "#LawvereMenni15"} Lawvere-Menni 2015
              %sup#fnref:1
                %a{:href => "#fn:1", :rel => "footnote"} 1
          %p
            For further discussion of this relation see at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/dense+subtopos"} dense subtopos
          %p
            The double negation topology is closely related to the class of
            %a.existingWikiWord{:href => "/nlab/show/skeletal+geometric+morphism"} skeletal geometric morphims
            i.e.
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi ℱ
                  %mo →
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} f:\mathcal{F}\to\mathcal {E}
            that restrict to a geometric morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℱ
                    %mrow
                      %mo ¬
                      %mo ¬
                  %mo →
                  %msub
                    %mi ℰ
                    %mrow
                      %mo ¬
                      %mo ¬
                %annotation{:encoding => "application/x-tex"} \mathcal{F}_{\neg\neg}\to\mathcal{E}_{\neg\neg}
            e.g. skeletal geometric morphisms are the 1-cells in 2-category of toposes in which Boolean toposes are co-reflective (cf. Johnstone (2002, p.1008)).
          %p
            The next propositions consider the important special case of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ¬
                  %mo ¬
                %annotation{:encoding => "application/x-tex"} \neg\neg
            on
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/presheaf+toposes"} presheaf toposes
          .num_prop
            %h6#proposition_4 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              be a small category admitting a
              %a.existingWikiWord{:href => "/nlab/show/calculus+of+fractions"} right calculus of fractions
              with respect to the set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              of
              %em all
              morphisms and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              be the free groupoid generated by
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo ≅
                      %mi C
                      %msup
                        %mi Σ
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} G\cong C\Sigma^{-1}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Sh
                      %mrow
                        %mo ¬
                        %mo ¬
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Set
                      %mrow
                        %msup
                          %mi C
                          %mi op
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %msup
                      %mi Set
                      %mrow
                        %msup
                          %mi G
                          %mi op
                    %mspace{:width => "1em"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Sh_{\neg\neg}(Set^{C^{op}})\cong Set^{G^{op}}\quad .
          %p
            This appears as ex.5.2 in
            = succeed "." do
              %a{:href => "#Johnstone77"} Johnstone (1977, p.162)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            a commutative monoid.
          .num_prop
            %h6#proposition_5 Proposition
            %p
              For every
              %a.existingWikiWord{:href => "/nlab/show/presheaf+topos"} presheaf topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [C^{op}, Set]
              the double negation topology coincides with the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/dense+topology"} dense topology
          %p
            This appears as
            = succeed "." do
              %a{:href => "#MacLaneMoerdijk"} MacLaneMoerdijk, corollary VI 5
          #DoubleNegationSheavesSatisfyAxiomOfChoice.num_prop
            %h6#proposition_6 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/poset"} poset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Sh
                      %mrow
                        %mo ¬
                        %mo ¬
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} Sh_{\not \not}(C) \hookrightarrow [C^{op}, Set]
              satisfies the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
          %p
            This appears as
            = succeed "." do
              %a{:href => "#MacLaneMoerdijk"} MacLaneMoerdijk, corollary VI 9
          #RelationToForcing.num_remark
            %h6#remark Remark
            %p
              %strong
                (relation to
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/forcing"} forcing
            %p
              Essentially because of prop.
              = succeed "," do
                %a.maruku-ref{:href => "#DoubleNegationSheavesSatisfyAxiomOfChoice"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/forcing"} forcing
              in
              %a.existingWikiWord{:href => "/nlab/show/set+theory"} set theory
              (since set theorists generally want the
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
              to be preserved in forcing models). For such a use of double negation in the so called
              %strong Cohen topos
              see at
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/continuum+hypothesis"} continuum hypothesis
          %h3#Examples Examples
          %p
          #ForSierpinskiTopos.num_remark
            %h6 Example
            %p
              Consider the
              %a.existingWikiWord{:href => "/nlab/show/Sierpinski+topos"} Sierpinski topos
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℰ
                      %mspace{:width => "thinmathspace"}
                      %mo ≔
                      %mspace{:width => "thinmathspace"}
                      %msup
                        %mi Set
                        %mo →
                    %annotation{:encoding => "application/x-tex"} \mathcal{E} \,\coloneqq\, Set^{\to}
              %a.existingWikiWord{:href => "/nlab/show/arrow+category"} arrow category
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            %p This has
            %ul
              %li
                %p
                  exactly two
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/dense+subtoposes"} dense subtoposes
                %ol
                  %li
                    %p the topos itself
                  %li
                    %p
                      the double-negation topos whose sheaves are the
                      = succeed "," do
                        %a.existingWikiWord{:href => "/nlab/show/bijections"} bijections
              %li
                %p
                  exactly three
                  %a.existingWikiWord{:href => "/nlab/show/Boolean+topos"} Boolean
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/subtoposes"} subtoposes
                %ol
                  %li
                    %p the double-negation subtopos,
                  %li
                    %p
                      the subcategory on the arrows whose
                      %a.existingWikiWord{:href => "/nlab/show/codomain"} codomain
                      is the
                      = succeed "," do
                        %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
                  %li
                    %p
                      the degenerate subtopos consisting of just the
                      %a.existingWikiWord{:href => "/nlab/show/identity+morphism"} identity morphism
                      on the
                      = succeed "." do
                        %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
            %p
              Observe that the two non-degenerate Boolean toposes, which complement each other in the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/lattice+of+subtoposes"} lattice of subtoposes
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
              to the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Set"} topos of sets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ℰ
                      %mi j
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo ¬
                        %mo ¬
                    %mo ≃
                    %msub
                      %mi ℰ
                      %mrow
                        %mo ¬
                        %mo ¬
                  %annotation{:encoding => "application/x-tex"} (\mathcal{E}_j)_{\neg\neg}\simeq \mathcal{E}_{\neg\neg}
              in Prop.
              %a.maruku-ref{:href => "#smallest_j-dense"}
              is not sufficient.
          %h2#InHigherToposTheory In higher topos theory
          %p
            %a.existingWikiWord{:href => "/nlab/show/classical+logic"} Classically
            the double negation modality is equivalent to the
            %a.existingWikiWord{:href => "/nlab/show/n-truncation+modality"} n-truncation modality
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                %annotation{:encoding => "application/x-tex"} n = -1
            (the
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/bracket+type"} bracket type
            = succeed "-type," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
