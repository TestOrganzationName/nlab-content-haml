          %h2#PoissonLInfinityAlgebras
            Poisson
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
          %p
            To an ordinary
            %a.existingWikiWord{:href => "/nlab/show/symplectic+manifold"} symplectic manifold
            is associated its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Poisson+algebra"} Poisson algebra
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            = succeed "." do
              %em Poisson bracket
          %p
            We discuss here how to an
            = succeed "-plectic" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo &gt;
                  %mn 1
                %annotation{:encoding => "application/x-tex"} n \gt 1
            there is correspondingly assoociated not a Lie algebra, but a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Lie+n-algebra"} Lie n-algebra
            = succeed "." do
              %strong
                %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket+Lie+n-algebra"} Poisson bracket Lie n-algebra
            %strong
              Poisson Lie
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            (see for instance at
            = succeed ")." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Poisson+Lie+2-algebra"} Poisson Lie 2-algebra
          %p
            (Not to be confused with the Lie algebra of a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Poisson+Lie+group"} Poisson Lie group
            %a.existingWikiWord{:href => "/nlab/show/Poisson+manifold"} Poisson manifold
            structure. It is a bit unfortunate that there is no better established term for the Lie algebra underlying a Poisson algebra apart from “Poisson bracket”.)
          %p
            Consider the ordinary case in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} n=1
            for how a
            %a.existingWikiWord{:href => "/nlab/show/Poisson+algebra"} Poisson algebra
            is obtained from a
            %a.existingWikiWord{:href => "/nlab/show/symplectic+manifold"} symplectic manifold
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X, \omega)
          %p Here
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi ω
                    %mo{:stretchy => "false"} ^
                  %mo :
                  %msub
                    %mi T
                    %mi x
                  %mi X
                  %mo →
                  %msubsup
                    %mi T
                    %mi x
                    %mo *
                  %mi X
                %annotation{:encoding => "application/x-tex"}
                  \\hat \omega : T_x X \to T^*_x X
          %p
            is an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
          %p
            Given
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \in C^\infty(X)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∃
                  %mo !
                  %msub
                    %mi ν
                    %mi f
                  %mo ∈
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \exists ! \nu_f \in \Gamma(T X)
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mi f
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi ω
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi v
                    %mi f
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} d f = - \omega(v_f, -)
          %p
            Define
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi f
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} }
                    %mo :
                    %mo =
                    %mi ω
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi v
                      %mi f
                    %mo ,
                    %msub
                      %mi v
                      %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \{f,g\} := \omega(v_f, v_g)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mo{:stretchy => "false"} {
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (C^\infty(X,), \{-,-\})
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Poisson+algebra"} Poisson algebra
          %p
            We can generalize this to
            = succeed "-plectic" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ω
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,\omega)
            be
            = succeed "-plectic" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo &gt;
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n \gt 1
          %p
            Observe that then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi ω
                    %mo{:stretchy => "false"} ^
                  %mo :
                  %msub
                    %mi T
                    %mi x
                  %mi X
                  %mo →
                  %msup
                    %mo ∧
                    %mi n
                  %msub
                    %mi T
                    %mi x
                  %mi X
                %annotation{:encoding => "application/x-tex"} \hat \omega : T_x X \to \wedge^n T_x X
            is no longer an
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            in general.
          %p
            %strong Definition
          %p Say
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo ∈
                  %msup
                    %mi Ω
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\alpha \in \Omega^{n-1}(X)
          %p
            is
            %strong Hamiltonian
            precisely if
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∃
                  %msub
                    %mi v
                    %mi α
                  %mo ∈
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\exists v_\alpha \in \Gamma(T X)
          %p such that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mi α
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi ω
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi v
                    %mi α
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  d \alpha = - \omega(v_\alpha, -)
                  \\,.
          %p
            This makes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi v
                    %mi α
                %annotation{:encoding => "application/x-tex"} v_\alpha
            uniquely defined.
          %p
            Denote the collection of
            %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+forms"} Hamiltonian forms
            by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi Hamilt
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega^{n-1}_{Hamilt}(X)
          %p Define a bracket
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} }
                  %mo :
                  %msubsup
                    %mi Ω
                    %mi Hamilt
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %msub
                        %mo ⊗
                        %mn 2
                  %mo →
                  %msubsup
                    %mi Ω
                    %mi Hamilt
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\{-,-\} : \Omega^{n-1}_{Hamilt}(X)^{\otimes_2} \to \Omega^{n-1}_{Hamilt}(X)
          %p by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi α
                  %mo ,
                  %mi β
                  %mo{:stretchy => "false"} }
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi ω
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi v
                    %mi α
                  %mo ,
                  %msub
                    %mi v
                    %mi β
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\{\alpha, \beta\} = - \omega(v_\alpha, v_\beta, -, \cdots, -)
                  \\,.
          %p This satisfies
          %ol
            %li
              %p k
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo{:stretchy => "false"} {
                      %mi α
                      %mo ,
                      %mi β
                      %mo{:stretchy => "false"} }
                      %mo =
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi ω
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi v
                        %mi α
                      %mo ,
                      %msub
                        %mi v
                        %mi β
                      %mo{:stretchy => "false"} ]
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      d \{\alpha, \beta\} = - \omega([v_\alpha, v_\beta], -, \cdots, -)
                      \\,.
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{-,-\}
                is skew-symmetric;
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi α
                        %mn 1
                      %mo ,
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi α
                        %mn 2
                      %mo ,
                      %msub
                        %mi α
                        %mn 3
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{\alpha_1, \{\alpha_2, \alpha_3\}\}
                + cyclic permutations
                %br/
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mi ω
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi v
                          %mrow
                            %msub
                              %mi α
                              %mn 1
                        %mo ,
                        %msub
                          %mi v
                          %mrow
                            %msub
                              %mi α
                              %mn 2
                        %mo ,
                        %msub
                          %mi v
                          %mrow
                            %msub
                              %mi α
                              %mn 3
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mi ⋯
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} d \omega(v_{\alpha_1}, v_{\alpha_2}, v_{\alpha_3}, -, \cdots)
          %p
            So the Jacobi dientity fails up to an exact term. This will yield the structure of an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/L-infinity+algebra"} L-infinity algebra
          %p
            %strong Proposition
          %p
            Given an
            = succeed "-plectic" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ω
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,\omega)
            we get a
            %a.existingWikiWord{:href => "/nlab/show/Lie+n-algebra"} Lie n-algebra
            structure on the complex
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi d
                        %mi dR
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi d
                        %mi dR
                  %mo →
                  %mi ⋯
                  %mo →
                  %msubsup
                    %mi Ω
                    %mi Hamilt
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  C^\infty(X) \stackrel{d_{dR}}{\to} \Omega^1(X) \stackrel{d_{dR}}{\to}
                  \\to \cdots \to
                  \\Omega^{n-1}_{Hamilt}(X)
          %p (where the rightmost term is taken to be in degree 0).
          %p where
          %ul
            %li
              %p
                the unary bracket is
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi d
                          %mi dR
                      %annotation{:encoding => "application/x-tex"} d_{dR}
            %li
              %p
                the
                = succeed "-ary" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi α
                        %mn 1
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %msub
                        %mi α
                        %mi k
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %mrow
                        %mo {
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mo ±
                                %mi ω
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi v
                                  %mrow
                                    %msub
                                      %mi α
                                      %mn 1
                                %mo ,
                                %mi ⋯
                                %mo ,
                                %msub
                                  %mi v
                                  %mrow
                                    %msub
                                      %mi α
                                      %mi k
                                %mo{:stretchy => "false"} )
                              %mtd
                                %mi if
                                %mo ∀
                                %mi i
                                %mo :
                                %msub
                                  %mi α
                                  %mi i
                                %mo ∈
                                %msubsup
                                  %mi Ω
                                  %mi Hamilt
                                  %mrow
                                    %mi n
                                    %mo −
                                    %mn 1
                                %mo{:stretchy => "false"} (
                                %mi X
                                %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                                %mn 0
                              %mtd
                                %mi otherwise
                    %annotation{:encoding => "application/x-tex"}
                      [\alpha_1, \cdots, \alpha_k]
                      \=
                      \\left\{
                      \\array{
                      \\pm \omega(v_{\alpha_1}, \cdots, v_{\alpha_k}) &amp; if \forall i : \alpha_i \in \Omega^{n-1}_{Hamilt}(X)
                      \\\
                      0 &amp; otherwise
                      }
                      \\right.
          %p
            This is the
            = succeed "." do
              %strong
                %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket+Lie+n-algebra"} Poisson bracket Lie n-algebra
          %p
            This appears as (
            %a{:href => "#Rogers11"}> Rogers 11, theorem 3.14
            ).
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} n = 1
            this recovers the definition of the
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            underlying a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Poisson+algebra"} Poisson algebra
          %h2#prequantization Prequantization
          %h3#review_of_the_symplectic_situation Review of the symplectic situation
          %p
            Recall for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} n=1
            the mechanism of
            %a.existingWikiWord{:href => "/nlab/show/geometric+quantization"} geometric quantization
            of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/symplectic+manifold"} symplectic manifold
          %p
            Given a 2-form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \omega
            and the corresponding complex
            %a.existingWikiWord{:href => "/nlab/show/line+bundle"} line bundle
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            %a.existingWikiWord{:href => "/nlab/show/Atiyah+Lie+algebroid"} Atiyah Lie algebroid
            sequence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ad
                  %mi P
                  %mo →
                  %mi T
                  %mi P
                  %mo{:stretchy => "false"} /
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi T
                  %mi X
                %annotation{:encoding => "application/x-tex"}
                  ad P \to T P/U(1) \to T X
          %p
            The smooth
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/section"} section
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mi P
                  %mo{:stretchy => "false"} /
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} T P/U(1) \to X
            are the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} U(1)
            invariant
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/vector+field"} vector field
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
          %p
            Using a
            %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                %annotation{:encoding => "application/x-tex"} \nabla
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            we may write such a section as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mi f
                  %msub
                    %mo ∂
                    %mi t
                %annotation{:encoding => "application/x-tex"}
                  s(v) + f \partial_t
          %p
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                  %mo ∈
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} v \in \Gamma(T X)
            a vector field downstairs,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} s(v)
            a horizontal lift with respect to the given connection and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \in C^\infty(X)
          %p
            Locally on a suitable patch
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ⊂
                  %mi X
                %annotation{:encoding => "application/x-tex"} U \subset X
            we have that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo{:stretchy => "false"} |
                    %mi U
                  %mo =
                  %mi v
                  %msub
                    %mo{:stretchy => "false"} |
                    %mi U
                  %mo +
                  %msub
                    %mi ι
                    %mi v
                  %msub
                    %mi θ
                    %mi i
                  %msub
                    %mo{:stretchy => "false"} |
                    %mi U
                %annotation{:encoding => "application/x-tex"} s(V)|_U = v|_U + \iota_v \theta_i|_U
            \.
          %p
            We say that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi v
                    %mo{:stretchy => "false"} ˜
                  %mo =
                  %mi s
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mi f
                  %msub
                    %mo ∂
                    %mi t
                %annotation{:encoding => "application/x-tex"} \tilde v = s(v) + f \partial_t
            %strong preserves the splitting
            iff
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∀
                  %mi u
                  %mo ∈
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \forall u \in \Gamma(X)
            we have
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mover
                    %mi v
                    %mo{:stretchy => "false"} ˜
                  %mo ,
                  %mi s
                  %mo{:stretchy => "false"} (
                  %mi u
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %mi s
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} [
                  %mi v
                  %mo ,
                  %mi u
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  [\tilde v, s(u)] = s([v,u])
                  \\,.
          %p One finds that this is the case precisely if
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mi f
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msub
                    %mi ι
                    %mi v
                  %mi ω
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  d f = - \iota_v \omega
                  \\,.
          %p
            This gives a
            %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mi P
                  %mo{:stretchy => "false"} /
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  C^\infty(X) \to \Gamma(T P / U(1))
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ↦
                  %mi s
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi v
                    %mi f
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mi f
                  %msub
                    %mo ∂
                    %mi t
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  f \mapsto s(v_f) + f \partial_t
                  \\,.
          %h3#2plectic_geometry_and_courant_algebroids 2-plectic geometry and Courant algebroids
          %p
            We consder now
            %a.existingWikiWord{:href => "/nlab/show/geometric+quantization"} prequantization
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/2-plectic+manifolds"} 2-plectic manifolds
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ω
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,\omega)
            be a 2-plectic manifold such that the
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+cohomology"} de Rham cohomology
            class
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi ω
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} /
                  %mn 2
                  %mi π
                  %mi i
                %annotation{:encoding => "application/x-tex"} [\omega]/2 \pi i
            is in the image of
            %a.existingWikiWord{:href => "/nlab/show/integral+cohomology"} integral cohomology
            (Has integral periods.)
          %p
            We can form a cocycle in
            %a.existingWikiWord{:href => "/nlab/show/Deligne+cohomology"} Deligne cohomology
            from this, encoding a
            %a.existingWikiWord{:href => "/nlab/show/bundle+gerbe"} bundle gerbe
            with connection.
          %p
            On a
            %a.existingWikiWord{:href => "/nlab/show/cover"} cover
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi U
                    %mi i
                  %mo →
                  %mi X
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{U_i \to X\}
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            this is given in terms of
            %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech cohomology
            by data
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi g
                        %mrow
                          %mi i
                          %mi j
                          %mi k
                      %mo :
                      %msub
                        %mi U
                        %mrow
                          %mi i
                          %mi j
                          %mi k
                      %mo →
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi U
                        %mrow
                          %mi i
                          %mi j
                          %mi k
                      %mo ,
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (g_{i j k} : U_{i j k} \to U(1)) \in C^\infty(U_{i j k}, U(1))
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mrow
                          %mi i
                          %mi j
                      %mo ∈
                      %msup
                        %mi Ω
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi U
                        %mrow
                          %mi i
                          %mi j
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} A_{i j} \in \Omega^1(U_{i j})
                ;
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi B
                        %mi i
                      %mo ∈
                      %msup
                        %mi Ω
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi U
                        %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} B_i \in \Omega^2(U_i)
          %p satisfying a cocycle condition.
          %p
            Now recall that an exact
            %a.existingWikiWord{:href => "/nlab/show/Courant+algebroid"} Courant algebroid
            is given by the following data:
          %ul
            %li
              %p
                a
                %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} E \to X
            %li
              %p
                an
                %em anchor
                morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                      %mo :
                      %mi E
                      %mo →
                      %mi T
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \rho : E \to T X
                to the
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
            %li
              %p
                an
                %em inner product
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ⟩
                    %annotation{:encoding => "application/x-tex"} \langle -,-\rangle
                on the fibers of
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
            %li
              %p
                a bracket
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [-,-]
                on the sections of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
          %p Satisfying some conditions.
          %p
            The fact that the
            %a.existingWikiWord{:href => "/nlab/show/Courant+algebroid"} Courant algebroid
            is
            %em exact
            means that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo →
                  %msup
                    %mi T
                    %mo *
                  %mi X
                  %mo →
                  %mi E
                  %mo →
                  %mi T
                  %mi X
                  %mo →
                  %mn 0
                %annotation{:encoding => "application/x-tex"}
                  0 \to T^* X \to E \to T X \to 0
          %p
            is an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exact sequence
          %p
            The
            %strong standard Courant algebroid
            is the example where
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi E
                      %mo =
                      %mi T
                      %mi X
                      %mo ⊕
                      %msup
                        %mi T
                        %mo *
                      %mi X
                    %annotation{:encoding => "application/x-tex"} E = T X \oplus T^* X
                ;
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %msub
                        %mi v
                        %mn 1
                      %mo +
                      %msub
                        %mi α
                        %mn 1
                      %mo ,
                      %msub
                        %mi v
                        %mn 2
                      %mo +
                      %msub
                        %mi α
                        %mn 2
                      %mo{:stretchy => "false"} ⟩
                      %mo =
                      %msub
                        %mi α
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi v
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo +
                      %msub
                        %mi α
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi v
                        %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \langle v_1 + \alpha_1, v_2 + \alpha_2\rangle = \alpha_2(v_1) + \alpha_1(v_2)
                ;
            %li
              %p the bracket is the skew-symmetrization of the Dorfman bracket
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi v
                        %mn 1
                      %mo +
                      %msub
                        %mi α
                        %mn 1
                      %mo ,
                      %msub
                        %mi v
                        %mn 2
                      %mo +
                      %msub
                        %mi α
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi v
                        %mn 1
                      %mo ,
                      %msub
                        %mi v
                        %mn 2
                      %mo{:stretchy => "false"} ]
                      %mo −
                      %msub
                        %mi 𝕃
                        %mrow
                          %msub
                            %mi v
                            %mn 1
                      %msub
                        %mi α
                        %mn 2
                      %mo −
                      %mo{:stretchy => "false"} (
                      %mi d
                      %msub
                        %mi α
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi v
                        %mn 2
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      (v_1 + \alpha_1, v_2 + \alpha_2) = [v_1, v_2] - \mathbb{L}_{v_1}\alpha_2
                      \- (d \alpha_1)(v_2,-)
          %p Now with respect to the above Deligne cocycle, build a Courant algebroid as follows:
          %ul
            %li
              %p
                on each patch
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi i
                    %annotation{:encoding => "application/x-tex"} U_i
                is is the standard Courant algebroid
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi E
                          %mi i
                        %mo :
                        %mo =
                        %mi T
                        %msub
                          %mi U
                          %mi i
                        %mo ⊕
                        %msup
                          %mi T
                          %mo *
                        %msub
                          %mi U
                          %mi i
                      %annotation{:encoding => "application/x-tex"} E_i := T U_i \oplus T^* U_i
            %li
              %p
                glued together on double intersections using the
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %msub
                        %mi A
                        %mrow
                          %mi i
                          %mi j
                    %annotation{:encoding => "application/x-tex"} d A_{i j}
          %p
            This gives an exact Courant algebroid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} E \to X
            as well as a splitting
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mo :
                  %mi T
                  %mi X
                  %mo →
                  %mi E
                %annotation{:encoding => "application/x-tex"} s : T X \to E
            given by the
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi B
                      %mi i
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{B_i\}
          %p
            The bracket on this
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            is given by the skew-symmetrization of
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %mi s
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi v
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %msub
                    %mi α
                    %mn 1
                  %mo ,
                  %mi s
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi v
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo +
                  %msub
                    %mi α
                    %mn 2
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %mi s
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi v
                    %mn 1
                  %mo ,
                  %msub
                    %mi v
                    %mn 2
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mo +
                  %msub
                    %mi ℒ
                    %mrow
                      %msub
                        %mi v
                        %mn 1
                  %msub
                    %mi α
                    %mn 2
                  %mo −
                  %mo{:stretchy => "false"} (
                  %mi d
                  %msub
                    %mi α
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi v
                    %mn 2
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo −
                  %mi ω
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi v
                    %mn 1
                  %mo ,
                  %msub
                    %mi v
                    %mn 2
                  %mo ,
                  %mi ⋯
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  [ [ s(v_1)  \alpha_1, s(v_2) + \alpha_2 ] ] = s([v_1, v_2])
                  +
                  \\mathcal{L}_{v_1} \alpha_2 - (d \alpha_2)(v_2, -) -
                  \\omega(v_1, v_2, \cdots)
                  \\,.
          %p
            Here a section
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                  %mo =
                  %mi s
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mo .
                  %mo .
                  %mo .
                %annotation{:encoding => "application/x-tex"} e = s(v) + ...
            preserves the splitting precisely if
          %p
            for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                  %mo ∈
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} u \in \Gamma(T X)
            we have
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %mi e
                  %mo ,
                  %mi s
                  %mo{:stretchy => "false"} (
                  %mi u
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mi D
                  %mo =
                  %mi s
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} [
                  %mi v
                  %mo ,
                  %mi u
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  [ [ e, s(u)] ]_D = s([v,u])
          %p
            exactly if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            is Hamiltonian and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo =
                    %msub
                      %mi v
                      %mi α
                  %annotation{:encoding => "application/x-tex"} v = v_\alpha
          %p
            %strong Theorem
          %p
            Recall that to every
            %a.existingWikiWord{:href => "/nlab/show/Courant+algebroid"} Courant algebroid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            is associated a
            %a.existingWikiWord{:href => "/nlab/show/Lie+2-algebra"} Lie 2-algebra
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} L_\infty(E)
          %p
            Then: we have an embedding of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/L-infinity+algebra"} L-infinity algebra
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo :
                  %msub
                    %mi L
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ω
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi L
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\phi : L_\infty(X,\omega) \to L_\infty(E)
          %p
