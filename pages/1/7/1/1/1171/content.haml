          %h1#convergence_spaces Convergence spaces
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#definitions"} Definitions
              %li
                %a{:href => "#examples"} Examples
              %li
                %a{:href => "#properties"} Properties
              %li
                %a{:href => "#topological_structure"} Topological structure
              %li
                %a{:href => "#related_concepts"} Related concepts
              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            A
            %em convergence space
            is a generalisation of a
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            based on the concept of
            %a.existingWikiWord{:href => "/nlab/show/convergence"} convergence
            of
            %a.existingWikiWord{:href => "/nlab/show/filters"} filters
            (or
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/nets"} nets
            %a.existingWikiWord{:href => "/nlab/show/point-set+topology"} point-set topology
            (
            %a.existingWikiWord{:href => "/nlab/show/continuous+functions"}> continuous functions
            ,
            %a.existingWikiWord{:href => "/nlab/show/compact+space"} compact
            and
            %a.existingWikiWord{:href => "/nlab/show/Hausdorff+space"} Hausdorff
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Conv
                %annotation{:encoding => "application/x-tex"} Conv
            of convergence spaces is a
            %a.existingWikiWord{:href => "/nlab/show/quasitopos"} quasitopos
            and may be thought of as a
            %a.existingWikiWord{:href => "/nlab/show/nice+category+of+spaces"} nice category of spaces
            that includes
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            as a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
          %h2#definitions Definitions
          %p
            A
            %strong convergence space
            is a
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            together with a
            %a.existingWikiWord{:href => "/nlab/show/relation"} relation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo →
                %annotation{:encoding => "application/x-tex"} \to
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℱ
                  %mi S
                %annotation{:encoding => "application/x-tex"} \mathcal{F}S
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℱ
                  %mi S
                %annotation{:encoding => "application/x-tex"} \mathcal{F}S
            is the set of
            %a.existingWikiWord{:href => "/nlab/show/filters"} filters
            on
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo →
                    %mi x
                  %annotation{:encoding => "application/x-tex"} F \to x
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            %strong converges
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            or that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            is a
            %strong limit
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
          %ol
            %li
              Centred: The
              %a.existingWikiWord{:href => "/nlab/show/principal+ultrafilter"} principal ultrafilter
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi x
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi A
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} |
                    %mspace{:width => "thickmathspace"}
                    %mi x
                    %mo ∈
                    %mi A
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} F_x = \{ A \;|\; x \in A \}
              at
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              converges to
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
            %li
              Isotone: If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ⊆
                    %mi G
                  %annotation{:encoding => "application/x-tex"} F \subseteq G
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo →
                      %mi x
                    %annotation{:encoding => "application/x-tex"} F \to x
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo →
                      %mi x
                    %annotation{:encoding => "application/x-tex"} G \to x
            %li
              Directed: If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo →
                    %mi x
                  %annotation{:encoding => "application/x-tex"} F \to x
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo →
                      %mi x
                    %annotation{:encoding => "application/x-tex"} G \to x
              %a.existingWikiWord{:href => "/nlab/show/intersection"} intersection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ∩
                    %mi G
                  %annotation{:encoding => "application/x-tex"} F \cap G
              converges to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ∩
                    %mi G
                    %mo →
                    %mi x
                  %annotation{:encoding => "application/x-tex"} F \cap G \to x
              itself. (Strictly speaking, the relation should not be called
              %a.existingWikiWord{:href => "/nlab/show/directed+set"} directed
              unless also every point is a limit of some filter, but this follows from 1.)
          %p
            It follows that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo →
                  %mi x
                %annotation{:encoding => "application/x-tex"} F \to x
            if and only if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo ∩
                  %msub
                    %mi F
                    %mi x
                %annotation{:encoding => "application/x-tex"} F \cap F_x
            does. Given that, the convergence relation is defined precisely by specifying, for each point
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            %span.newWikiWord
              subfilters
              %a{:href => "/nlab/new/subfilter"} ?
            of the principal ultrafilter at
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
          %p
            A filter
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            %strong clusters
            at a point
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ⇝
                    %mi x
                  %annotation{:encoding => "application/x-tex"} F \rightsquigarrow x
            %a.existingWikiWord{:href => "/nlab/show/proper+filter"} proper filter
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo ⊆
                  %mi G
                %annotation{:encoding => "application/x-tex"} F \subseteq G
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo →
                    %mi x
                  %annotation{:encoding => "application/x-tex"} G \to x
          %p
            The definition can also be phrased in terms of
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/nets"} nets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ν
                %annotation{:encoding => "application/x-tex"} \nu
            converges to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            if and only if its
            %a.existingWikiWord{:href => "/nlab/show/eventuality+filter"} eventuality filter
            converges to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
          %p
            The morphisms of convergence spaces are the
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            between convergence spaces is
            %strong continuous
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo →
                  %mi x
                %annotation{:encoding => "application/x-tex"} F \to x
            implies that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(F) \to f(x)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f(F)
            is the filter generated by the
            %a.existingWikiWord{:href => "/nlab/show/filterbase"} filterbase
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} |
                    %mspace{:width => "thickmathspace"}
                    %mi A
                    %mo ∈
                    %mi F
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{f(A) \;|\; A \in F\}
            %a.existingWikiWord{:href => "/nlab/show/concrete+category"} concrete category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Conv
                  %annotation{:encoding => "application/x-tex"} Conv
          %p
            Note that the definition of ‘convergence’ varies in the literature; at the extreme end, one could define it as any relation whatsoever from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℱ
                  %mi S
                %annotation{:encoding => "application/x-tex"} \mathcal{F}S
            (or even from the
            %a.existingWikiWord{:href => "/nlab/show/proper+class"} class
            of all nets on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/generalised+filter+space"} generalised filter space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/filter+space"} filter space
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/preconvergence+space"} preconvergence space
            = succeed "." do
              %a{:href => "#LC"} Lowen-Colebunders
          %h2#examples Examples
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/measure+theory"} measure theory
            %a.existingWikiWord{:href => "/nlab/show/measure+space"} measure space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and a
            %a.existingWikiWord{:href => "/nlab/show/measurable+space"} measurable space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            %a.existingWikiWord{:href => "/nlab/show/almost-everywhere+defined"} almost-everywhere defined
            %a.existingWikiWord{:href => "/nlab/show/measurable+functions"} measurable functions
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            becomes a convergence space under
            = succeed "." do
              %span.newWikiWord
                convergence almost everywhere
                %a{:href => "/nlab/new/convergence+almost+everywhere"} ?
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/pseudotopological+space"} pseudotopological space
            is a convergence space satisfying the
            = succeed ":" do
              %em star property
          %ul
            %li
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is a filter such that every proper filter
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ⊇
                    %mi F
                  %annotation{:encoding => "application/x-tex"} G \supseteq F
              clusters at
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              converges to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
          %p
            Assuming the
            %a.existingWikiWord{:href => "/nlab/show/ultrafilter+theorem"} ultrafilter theorem
            (a weak version of the
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            converges to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            whenever every
            %a.existingWikiWord{:href => "/nlab/show/ultrafilter"} ultrafilter
            that refines
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            converges to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            (or clusters there, since these are equivalent for ultrafilters).
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/subsequential+space"} subsequential space
            is a pseudotopological space that may be defined using only
            %a.existingWikiWord{:href => "/nlab/show/sequences"} sequences
            instead of arbitrary nets/filters. (More precisely, a filter converges to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            only if it refines (the eventuality filter of) a
            %a.existingWikiWord{:href => "/nlab/show/infinite+sequence"} sequence
            that converges to
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/pretopological+space"} pretopological space
            is a convergence space that is
            = succeed ":" do
              %em infinitely filtered
          %ul
            %li
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi F
                      %mi α
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi α
                  %annotation{:encoding => "application/x-tex"} (F_\alpha)_\alpha
              is any family of filters each of which converges to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋂
                      %mi α
                    %msub
                      %mi F
                      %mi α
                  %annotation{:encoding => "application/x-tex"} \bigcap_\alpha F_\alpha
              converges to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
          %p
            In particular, the
            %a.existingWikiWord{:href => "/nlab/show/intersection"} intersection
            of all of the filters converging to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            (the
            %a.existingWikiWord{:href => "/nlab/show/neighbourhood+filter"} neighbourhood filter
            of
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
          %p
            Any
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            is a convergence space, and in fact a pretopological one: we define
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo →
                  %mi x
                %annotation{:encoding => "application/x-tex"} F \to x
            if every
            %a.existingWikiWord{:href => "/nlab/show/neighbourhood"} neighbourhood
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            belongs to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            %strong topological
            if it comes from a topology on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Conv
                %annotation{:encoding => "application/x-tex"} Conv
            consisting of the topological convergence spaces is
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
            to the category
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            of topological spaces. In this way, the definitions below are all suggested by theorems about topological spaces.
          %p
            Every
            %a.existingWikiWord{:href => "/nlab/show/Cauchy+space"} Cauchy space
            is a convergence space.
          %h2#properties Properties
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/improper+filter"} improper filter
            (the
            %a.existingWikiWord{:href => "/nlab/show/power+set"} power set
            of
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is
            %strong
              %a.existingWikiWord{:href => "/nlab/show/Hausdorff+space"} Hausdorff
            if every
            %a.existingWikiWord{:href => "/nlab/show/proper+filter"} proper filter
            converges to at most one point; then we have a
            %a.existingWikiWord{:href => "/nlab/show/partial+function"} partial function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi lim
                %annotation{:encoding => "application/x-tex"} \lim
            from the proper filters on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
          %p
            A convergence space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is
            %strong
              %a.existingWikiWord{:href => "/nlab/show/compact+space"} compact
            if every proper filter clusters at some point; that is, every proper filter is contained in a convergent proper filter. Equivalently (assuming the
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/ultrafilter+theorem"} ultrafilter theorem
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is compact iff every ultrafilter converges. A topological space is compact in the usual sense if and only if it is compact as a convergence space.
          %p
            The topological convergence spaces can be characterized as the pseudotopological ones in which the convergence satisfies a certain “associativity” condition. In this way one can (assuming the ultrafilter theorem) think of a topological space as a “
            %a.existingWikiWord{:href => "/nlab/show/generalized+multicategory"}> generalized multicategory
            ” parametrized by ultrafilters. In particular, note that a compact Hausdorff pseudotopological space is defined by a single function
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒰
                    %mi S
                    %mo →
                    %mi S
                  %annotation{:encoding => "application/x-tex"} \mathcal{U}S \to S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒰
                  %mi S
                %annotation{:encoding => "application/x-tex"} \mathcal{U}S
            is the set of ultrafilters on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo →
                  %mi 𝒰
                  %mi S
                  %mo →
                  %mi S
                %annotation{:encoding => "application/x-tex"} S \to \mathcal{U}S \to S
            is the identity. That is, it is an
            %a.existingWikiWord{:href => "/nlab/show/algebra+for+an+endofunctor"} algebra
            for the
            %a.existingWikiWord{:href => "/nlab/show/pointed+object"} pointed
            %a.existingWikiWord{:href => "/nlab/show/endofunctor"} endofunctor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒰
                  %annotation{:encoding => "application/x-tex"} \mathcal{U}
            %em topological
            spaces are precisely the
            %a.existingWikiWord{:href => "/nlab/show/algebra+for+a+monad"} algebras
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒰
                %annotation{:encoding => "application/x-tex"} \mathcal{U}
            considered as a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/monad"} monad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒰
                %annotation{:encoding => "application/x-tex"} \mathcal{U}
            as a monad on
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Rel"} Rel
            %a.existingWikiWord{:href => "/nlab/show/lax+algebra"} lax algebras
            are the topological spaces in their guise as
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/relational+beta-modules"} relational beta-modules
          %h2#topological_structure Topological structure
          %p
            Given a convergence space, a filter
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            %strong star-converges
            to a point
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %msup
                      %mo →
                      %mo *
                    %mi x
