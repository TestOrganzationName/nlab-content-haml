                      %mo *
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(\mathcal{F}) \to^* f(x)
              whenever
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℱ
                    %mo →
                    %mi x
                  %annotation{:encoding => "application/x-tex"} \mathcal{F} \to x
              in a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/pretopological+space"} pretopological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %msup
                      %mo ∈
                      %mo ∘
                    %msup
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x \in^\circ f^*(V)
              whenever
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %msup
                        %mo ∈
                        %mo ∘
                      %mi V
                    %annotation{:encoding => "application/x-tex"} f(x) \in^\circ V
              %a.existingWikiWord{:href => "/nlab/show/proof+by+contradiction"} by contradiction
              and flagrant use of
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} choice
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %msup
                      %mo ∈
                      %mo ∘
                    %mi V
