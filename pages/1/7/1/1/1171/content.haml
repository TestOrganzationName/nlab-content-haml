            %p
              But the theorem is in fact perfectly
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒩
                      %mi x
                  %annotation{:encoding => "application/x-tex"} \mathcal{N}_x
              of neighbourhoods of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              converges to
