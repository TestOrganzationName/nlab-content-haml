                    \\,.
            %p
          %p
          #TheBraidgroupBr3.num_remark
            %h6 Example
            %p
              The group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Br
                    %mo{:stretchy => "false"} (
                    %mn 3
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Br(3)
              (we will simplify notation writing
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                      %mo =
                      %msub
                        %mi y
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} u = y_1
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                      %mo =
                      %msub
                        %mi y
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} v = y_2
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Br
                    %mo{:stretchy => "false"} (
                    %mn 3
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒫
                    %mo ≔
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi u
                    %mo ,
                    %mi v
                    %mo :
                    %mi r
                    %mo ≡
                    %mi u
                    %mi v
                    %mi u
                    %msup
                      %mi v
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %msup
                      %mi u
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %msup
                      %mi v
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Br(3)
                    \\;\simeq\;
                    \\mathcal{P}
                    \\coloneqq
                    \\big(
                    u,v : r \equiv u v u v^{-1} u^{-1} v^{-1}
                    \\big).
            %p
              This is also known as the “trefoil
              = succeed "\u201D," do
