                      %semantics
                        %mrow
                          %mi S
                        %annotation{:encoding => "application/x-tex"} S
              %a{:href => "http://www.math.uiuc.edu/K-theory/0408/"} KTheory:0408
          %p
            and for
            %a.existingWikiWord{:href => "/nlab/show/operads"} operads
            enriched over orthogonal spectra in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Tore+Kro"}> Tore Kro
