          %h2#idea Idea
          %p
            The
            %em Hörmander criterion
            (
            %a{:href => "#Hoermander90"}> Hörmander 90, theorem 8.2.10
            ) says that the
            %a.existingWikiWord{:href => "/nlab/show/product+of+distributions"} product of two distributions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi u
                    %mn 1
                  %mo ⋅
                  %msub
                    %mi u
                    %mn 2
                %annotation{:encoding => "application/x-tex"} u_1 \cdot u_2
            (on some
            %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/wave+front+sets"} wave front sets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi WF
                  %mo{:stretchy => "false"} (
                  %mi u
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} WF(u)
            are such that for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                  %mo ∈
                  %msubsup
                    %mi T
                    %mi x
                    %mo *
                  %mi X
                %annotation{:encoding => "application/x-tex"} v \in T^\ast_x X
            a
            %a.existingWikiWord{:href => "/nlab/show/covector"} covector
            contained in one of the two wave front sets then the covector
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi v
                  %mo ∈
                  %msubsup
                    %mi T
                    %mi x
                    %mo *
                  %mi X
                %annotation{:encoding => "application/x-tex"} -v \in T^\ast_x X
            with the opposite
            %a.existingWikiWord{:href => "/nlab/show/direction+of+a+vector"} direction
            in
            %em not
            contained in the other wave front set, i.e. the
            %a.existingWikiWord{:href => "/nlab/show/intersection"} intersection
            %a.existingWikiWord{:href => "/nlab/show/fiber+product"} fiber product
            inside the
            %a.existingWikiWord{:href => "/nlab/show/cotangent+bundle"} cotangent bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi T
                    %mo *
                  %mi X
                %annotation{:encoding => "application/x-tex"} T^\ast X
            of the pointwise
            %a.existingWikiWord{:href => "/nlab/show/sum"} sum
            of wave fronts with the
            %a.existingWikiWord{:href => "/nlab/show/zero+section"} zero section
            is
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/empty+set"} empty
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
