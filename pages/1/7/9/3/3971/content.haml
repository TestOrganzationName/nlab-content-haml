            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:lspace => "verythinmathspace"} :
                    %mstyle{:mathvariant => "bold"}
                      %mn 2
                    %mi ⇸
                    %mi J
                  %annotation{:encoding => "application/x-tex"} K\colon \mathbf{2} &amp;#8696; J
          %p
            Now suppose that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is a
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi x
                  %mo →
                  %mi y
                %annotation{:encoding => "application/x-tex"} f\colon x\to y
            is a morphism in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            can be identified with a
            = succeed "-functor" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} ulcorner
                    %mi f
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} urcorner
                    %mo{:lspace => "verythinmathspace"} :
                    %mstyle{:mathvariant => "bold"}
                      %mn 2
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} \ulcorner f \urcorner \colon \mathbf{2}\to C
            %strong kernel
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is defined to be the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %a.existingWikiWord{:href => "/nlab/show/weighted+limit"} weighted limit
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} ulcorner
                    %mi f
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} urcorner
                  %annotation{:encoding => "application/x-tex"} \ulcorner f \urcorner
            = succeed "-functor" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi J
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} ker(f)\colon J\to C
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %a.existingWikiWord{:href => "/nlab/show/Kan+extension"} Kan extension
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} ulcorner
                  %mi f
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} urcorner
                %annotation{:encoding => "application/x-tex"} \ulcorner f \urcorner
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \mathbf{2}
            into
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \mathbf{2}
            into
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            is fully faithful, it follows that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} ulcorner
                    %mi f
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} urcorner
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi x
                  %annotation{:encoding => "application/x-tex"} ker(f)(0) = \ulcorner f \urcorner (0) = x
          %p
            Similarly, let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            be a
            = succeed "-functor" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} J\to C
            = succeed "." do
              %strong kernel data
            %strong quotient
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            defined to be its
            = succeed "-weighted" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mn 2
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbf{2}\to C
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            can equivalently be described by the left Kan extension of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbf{2}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                  %mo →
                  %mi H
                %annotation{:encoding => "application/x-tex"} J\to H
            is fully faithful, the source of the quotient of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            is the object
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} M(0)
          %p Since colimits and limits weighted by a fixed profunctor are adjoint to each other (or equivalently, since left and right Kan extension are left and right adjoint to restriction), we obtain an adjunction
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi quot
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mi J
                  %mo ,
                  %mi C
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thickmathspace"}
                  %mo ⇄
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} [
                  %mstyle{:mathvariant => "bold"}
                    %mn 2
                  %mo ,
                  %mi C
                  %mo{:stretchy => "false"} ]
                  %mo :
                  %mi ker
                %annotation{:encoding => "application/x-tex"} quot: [J,C] \;\rightleftarrows\; [\mathbf{2},C] :ker
          %p
            Moreover, by the remarks above, for any object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi C
                %annotation{:encoding => "application/x-tex"} x\in C
            this adjunction restricts to an adjunction
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi quot
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mi J
                  %mo ,
                  %mi C
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mi x
                  %mspace{:width => "thickmathspace"}
                  %mo ⇄
                  %mspace{:width => "thickmathspace"}
                  %mi x
                  %mo{:stretchy => "false"} /
                  %mi C
                  %mo :
                  %mi ker
                %annotation{:encoding => "application/x-tex"} quot: [J,C]_x \;\rightleftarrows\; x/C :ker
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi J
                  %mo ,
                  %mi C
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mi x
                %annotation{:encoding => "application/x-tex"} [J,C]_x
            denotes the subcategory of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi J
                  %mo ,
                  %mi C
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [J,C]
            on those functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi x
                  %annotation{:encoding => "application/x-tex"} M(0)=x
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mstyle{:mathvariant => "bold"}
                    %mn 2
                  %mo ,
                  %mi C
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mi x
                %annotation{:encoding => "application/x-tex"} [\mathbf{2},C]_x
            is just the
            %a.existingWikiWord{:href => "/nlab/show/coslice+category"} coslice category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo{:stretchy => "false"} /
                    %mi C
                  %annotation{:encoding => "application/x-tex"} x/C
          %p
            Of particular interest is the
            %a.existingWikiWord{:href => "/nlab/show/counit"} counit
            of this adjunction at a morphism
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi x
                    %mo →
                    %mi y
                  %annotation{:encoding => "application/x-tex"} f\colon x\to y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi quot
                  %mo{:stretchy => "false"} (
                  %mi ker
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi f
                %annotation{:encoding => "application/x-tex"} quot(ker(f)) \to f
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo{:stretchy => "false"} /
                    %mi C
                  %annotation{:encoding => "application/x-tex"} x/C
            %em factorization
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
          %h2#examples Examples
          %ol
            %li
              %p
                With
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                        %mo =
                        %mi Set
                      %annotation{:encoding => "application/x-tex"} V=Set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
                be the category
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi z
                      %mspace{:width => "thickmathspace"}
                      %mo ⇉
                      %mspace{:width => "thickmathspace"}
                      %mn 0
                      %mo →
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} z \;\rightrightarrows\; 0 \to 1
              %p
                with the two composites
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi z
                      %mo →
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} z\to 1
                being equal. That is,
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
                is the “
                %a.existingWikiWord{:href => "/nlab/show/walking+structure"} walking
                fork.” Then kernel data is a pair of parallel arrows, the kernel of a morphism is its
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/kernel+pair"} kernel pair
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/coequalizer"} coequalizer
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/regular+category"} regular category
                %a.existingWikiWord{:href => "/nlab/show/image"} image
                factorization.
              %p
                Note that since coequalizers are epic, the full image of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi quot
                      %mo{:lspace => "verythinmathspace"} :
                      %mo{:stretchy => "false"} [
                      %mi J
                      %mo ,
                      %mi C
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mo{:stretchy => "false"} [
                      %mstyle{:mathvariant => "bold"}
                        %mn 2
                      %mo ,
                      %mi C
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} quot\colon [J,C] \to [\mathbf{2},C]
                is a preorder, and thus in this case the adjunction is
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/idempotent+adjunction"} idempotent
            %li
              %p
                Again with
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                        %mo =
                        %mi Set
                      %annotation{:encoding => "application/x-tex"} V=Set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
                be the category
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mn 0
                          %mtr
                            %mtd
                            %mtd
                              %mo ↘
                          %mtr
                            %mtd
                              %mi z
                            %mtd
                              %mo →
                            %mtd
                              %mn 1
                    %annotation{:encoding => "application/x-tex"} \array{ 0 \\ &amp; \searrow \\ z &amp; \to &amp; 1 }
              %p
                Then kernel data is just a pair of objects, the kernel of a morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi x
                      %mo →
                      %mi y
                    %annotation{:encoding => "application/x-tex"} f\colon x\to y
                is the pair
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo ,
                        %mi x
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (y,x)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (y,x)
                is the
                %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
                injection
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo →
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ⊔
                        %mi y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} x \to (x\sqcup y)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi x
                      %mo →
                      %mi y
                    %annotation{:encoding => "application/x-tex"} f\colon x\to y
                obtained in this way is
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo →
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ⊔
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo →
                          %mrow
                            %mo{:stretchy => "false"} [
                            %mi f
                            %mo ,
                            %mi id
                            %mo{:stretchy => "false"} ]
                        %mi y
                      %annotation{:encoding => "application/x-tex"} x \to (x\sqcup y) \overset{[f,id]}{\to} y
            %li
              %p
                With
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                        %mo =
                        %mi Ab
                      %annotation{:encoding => "application/x-tex"} V=Ab
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
                be the
                %a.existingWikiWord{:href => "/nlab/show/Ab-enriched+category"} Ab-enriched category
                with three objects
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi z
                      %mo ,
                      %mn 0
                      %mo ,
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} z,0,1
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo ,
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi H
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo ,
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi H
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi H
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo ,
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi H
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} H(z,z) = H(0,0) = H(1,1) = H(z,0) = H(0,1) = \mathbb{Z}
                and all other hom-groups being
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} 0
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
                in an Ab-category consists of a pair of composable arrows whose composite is zero. Then kernel data is also just a single morphism, the kernel of a morphism is its
                %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
                in the usual sense, and the quotient of a morphism (considered as kernel data) is its
                %a.existingWikiWord{:href => "/nlab/show/cokernel"} cokernel
                in the usual sense. The resulting factorization is again the usual image factorization, and the adjunction is again idempotent.
            %li
              %p
                With
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                        %mo =
                        %mi Cat
                      %annotation{:encoding => "application/x-tex"} V=Cat
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
                be the (strict)
                %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
                with three objects
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi z
                      %mo ,
                      %mn 0
                      %mo ,
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} z,0,1
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi H
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo *
                      %annotation{:encoding => "application/x-tex"} H(0,1) = *
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi H
                        %mo{:stretchy => "false"} (
                        %mi z
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mstyle{:mathvariant => "bold"}
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} H(z,1) = \mathbf{2}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo ,
                      %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} H(z,0)
                the “
                %a.existingWikiWord{:href => "/nlab/show/walking+structure"} walking
                = succeed "\u201D" do
                  %a.existingWikiWord{:href => "/nlab/show/parallel+pair"} parallel pair
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo ⋅
                        %mo ⇉
                        %mo ⋅
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\cdot \rightrightarrows \cdot)
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/coequifier"} coequifier
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Cat
                    %annotation{:encoding => "application/x-tex"} Cat
                at least, the kernel
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi x
                      %mo →
                      %mi y
                    %annotation{:encoding => "application/x-tex"} f\colon x\to y
                of a functor is the category of parallel pairs in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
                which become equal in
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi y
                      %annotation{:encoding => "application/x-tex"} y
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                consists of an bijective-on-objects-and-full functor followed by a faithful one. Since bijective-on-objects-and-full functors are epic in
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Cat
                      %annotation{:encoding => "application/x-tex"} Cat
            %li
              %p
                Again with
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                        %mo =
                        %mi Cat
                      %annotation{:encoding => "application/x-tex"} V=Cat
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
                be the 2-category with three objects
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo ,
                      %mn 0
                      %mo ,
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} y,0,1
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi H
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo *
                      %annotation{:encoding => "application/x-tex"} H(0,1)=*
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo ,
                      %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} H(y,0)
                the discrete category with two objects, and
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi H
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mstyle{:mathvariant => "bold"}
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} H(y,1)=\mathbf{2}
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/coinserter"} coinserter
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi x
                      %mo →
                      %mi y
                    %annotation{:encoding => "application/x-tex"} f\colon x\to y
                is the
                %a.existingWikiWord{:href => "/nlab/show/comma+object"} comma object
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} /
                        %mi f
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (f/f)
            %li
              %p
                Once again with
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                        %mo =
                        %mi Cat
                      %annotation{:encoding => "application/x-tex"} V=Cat
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
                be the 2-category
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mn 0
                          %mtr
                            %mtd
                            %mtd
                              %mo ↗
                            %mtd
                              %mo ≅
                            %mtd
                              %mo ↘
                          %mtr
                            %mtd
                              %mi z
                            %mtd
                            %mtd
                              %mo →
                            %mtd
                            %mtd
                              %mn 1
                    %annotation{:encoding => "application/x-tex"} \array{ &amp;&amp; 0\\ &amp; \nearrow &amp; \cong &amp; \searrow \\ z &amp;&amp; \to &amp;&amp; 1}
              %p
                Then kernel data is again a single arrow, its quotient is its pseudocolimit, and the kernel of a morphism is its pseudolimit. The resulting factorization is one of the ones arising in the
                %a.existingWikiWord{:href => "/nlab/show/canonical+model+structure"} canonical model structure
                on any 2-category.
            %li
              %p
                Continuing with
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                        %mo =
                        %mi Cat
                      %annotation{:encoding => "application/x-tex"} V=Cat
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
                be the 2-category on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi z
                      %mo ,
                      %mn 0
                      %mo ,
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} z,0,1
                with
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi H
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo *
                      %annotation{:encoding => "application/x-tex"} H(0,1)=*
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi H
                        %mo{:stretchy => "false"} (
                        %mi z
                        %mo ,
                        %mn 0
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mstyle{:mathvariant => "bold"}
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} H(z,0) = \mathbf{2}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} H(z,1)
                the
                %a.existingWikiWord{:href => "/nlab/show/walking+structure"} walking
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/coinverter"} coinverter
                = succeed "." do
                  %span.newWikiWord
                    invertee
                    %a{:href => "/nlab/new/invertee"} ?
            %li
              %p
                Finally with
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                        %mo =
                        %mi Cat
                      %annotation{:encoding => "application/x-tex"} V=Cat
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
                be the 3-truncated augmented
                %a.existingWikiWord{:href => "/nlab/show/simplex+category"} simplex category
                with additional 2-cells added, in such a way that kernel data is
                %em codescent data
                and the quotient of such data is a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/codescent+object"} codescent object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Cat
                    %annotation{:encoding => "application/x-tex"} Cat
                consists of a bijective-on-objects functor followed by a fully faithful one.
          %h2#factorization_systems Factorization systems
          %p
            In some of the above examples, the resulting factorization of a morphism is not what one would hope for. In particular, it need not give a
            %a.existingWikiWord{:href => "/nlab/show/factorization+system"} factorization system
            of any kind. However, the adjunction does induce a
            %a.existingWikiWord{:href => "/nlab/show/comonad"} comonad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Q
                    %mn 1
                  %mo =
                  %mi quot
                  %mo ∘
                  %mi ker
                %annotation{:encoding => "application/x-tex"} Q_1 = quot \circ ker
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mstyle{:mathvariant => "bold"}
                    %mn 2
                  %mo ,
                  %mi C
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [\mathbf{2},C]
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi dom
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Q
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi dom
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} dom(Q_1(f)) = dom(f)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi R
                    %mn 1
                %annotation{:encoding => "application/x-tex"} R_1
            is merely a
            %a.existingWikiWord{:href => "/nlab/show/pointed+endofunctor"} pointed endofunctor
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi cod
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi R
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi cod
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} cod(R_1(f)) = cod(f)
            %a.existingWikiWord{:href => "/nlab/show/algebra+for+an+endofunctor"} algebras
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi R
                    %mn 1
                %annotation{:encoding => "application/x-tex"} R_1
            are usually what one would hope for as the “right class” of the (weak) factorization systems intuitively associated to the above examples.
          %p
            Now this data is exactly the required input for the construction of a
            %em free
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+weak+factorization+system"} algebraic weak factorization system
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is sufficiently well-behaved (such as
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/locally+presentable+category"} locally presentable
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is usually
            %a.existingWikiWord{:href => "/nlab/show/free+monad"} algebraically-free
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi R
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} R_1
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %a.existingWikiWord{:href => "/nlab/show/algebra+for+a+monad"} algebras
            are again just what we would expect.
          %p
            For example, in the coinverter-invertee example above, the right clas of the factorization system produced in this way consists of
            %a.existingWikiWord{:href => "/nlab/show/conservative+functor"} conservative
            functors.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/kernel"}> kernel
                ,
                %a.existingWikiWord{:href => "/nlab/show/cokernel"} cokernel
            %li
              %p
                %strong generalized kernel
          %h2#references References
          %p
            This sort of idea has been thought of by various people at various times. The above version, especially the view of factorization systems, is a slight modification of one presented by
            %a.existingWikiWord{:href => "/nlab/show/Richard+Garner"} Richard Garner
            to the Sydney category seminar in February 2010. Other references include
          %ul
            %li
              %p
                Betti, Schumacher, and
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ross+Street"} Street
            %li
              %p Betti, “Adjointness in descent theory”, JPAA
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mathieu+Dupont"}> Mathieu Dupont
                ,
                = succeed "," do
                  %em Abelian categories in dimension 2
                = succeed "," do
                  %a{:href => "http://arxiv.org/abs/0809.1760"} arXiv:0809.1760
