                          %mi 𝕀
                          %mrow
                            %mi A
                            %mo ,
                            %mi B
                            %mo ,
                            %mi e
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi A
                    %mo ≅
                    %mi B
                  %annotation{:encoding => "application/x-tex"} \mathrm{ind}_{\mathrm{Id}}^{\mathbb{I}, \mathrm{rec}_{\mathbb{I}}^{A, B, e}(0) \cong \mathrm{rec}_{\mathbb{I}}^{A, B, e}(1)}(p):A \cong B
            %p
              This implies that for all types
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} const
                      %mrow
                        %mi 𝕀
                        %mo ,
                        %mi A
                    %mo ≔
                    %mi λ
                    %mi x
                    %mo :
                    %mi A
                    %mo .
                    %mi λ
                    %mi i
                    %mo :
                    %mi 𝕀
                    %mo .
                    %mi x
                    %mo :
                    %mi A
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %mi 𝕀
                    %mo →
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{const}_{\mathbb{I}, A} \coloneqq \lambda x:A.\lambda i:\mathbb{I}.x:A \simeq (\mathbb{I} \to A)
            %p
              in
              %a.existingWikiWord{:href => "/nlab/show/interval+type+localization"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi 𝕀
                    %annotation{:encoding => "application/x-tex"} \mathbb{I}
                \-localization
              can be turned into the definitional isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi{:mathvariant => "normal"} ind
                      %mi{:mathvariant => "normal"} Id
                      %mrow
                        %mi 𝕀
                        %mo ,
                        %msubsup
                          %mi{:mathvariant => "normal"} rec
                          %mi 𝕀
                          %mrow
                            %mi A
                            %mo ,
                            %mi 𝕀
                            %mo →
                            %mi A
                            %mo ,
                            %msub
                              %mi{:mathvariant => "normal"} const
                              %mrow
                                %mi 𝕀
                                %mo ,
                                %mi A
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                        %mo ≅
                        %msubsup
                          %mi{:mathvariant => "normal"} rec
                          %mi 𝕀
                          %mrow
                            %mi A
                            %mo ,
                            %mi 𝕀
                            %mo →
                            %mi A
                            %mo ,
                            %msub
                              %mi{:mathvariant => "normal"} const
                              %mrow
                                %mi 𝕀
                                %mo ,
                                %mi A
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi A
                    %mo ≅
                    %mo{:stretchy => "false"} (
                    %mi 𝕀
                    %mo →
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{ind}_{\mathrm{Id}}^{\mathbb{I}, \mathrm{rec}_{\mathbb{I}}^{A, \mathbb{I} \to A, \mathrm{const}_{\mathbb{I}, A}}(0) \cong \mathrm{rec}_{\mathbb{I}}^{A, \mathbb{I} \to A, \mathrm{const}_{\mathbb{I}, A}}(1)}(p):A \cong (\mathbb{I} \to A)
            %p
              which is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/definitional+interval+type+localization"}
                  definitional
                  = succeed "-localization" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝕀
                        %annotation{:encoding => "application/x-tex"} \mathbb{I}
              = succeed "-localization" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕀
                    %annotation{:encoding => "application/x-tex"} \mathbb{I}
              %a.existingWikiWord{:href => "/nlab/show/equality+reflection"} equality reflection
              as proven in the
              %a.existingWikiWord{:href => "/nlab/show/definitional+interval+type+localization"}
                definitional
                = succeed "-localization" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝕀
                      %annotation{:encoding => "application/x-tex"} \mathbb{I}
              and
              %a.existingWikiWord{:href => "/nlab/show/extensional+type+theory"} extensional type theory
              articles.
          %h3#using_dependent_sum_types_of_identity_types Using dependent sum types of identity types
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/extensional+type+theory"} extensional type theory
            %a.existingWikiWord{:href => "/nlab/show/dependent+sum+types"} dependent sum types
            of
            %a.existingWikiWord{:href => "/nlab/show/identity+type"} identity type
            as a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/negative+type"} negative type
          %p
            The idea is that using the inference rules for dependent sum types, the standard J-rule states that the dependent sum type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi y
                      %mo :
                      %mi A
                  %mi x
                  %msub
                    %mo =
                    %mi A
                  %mi y
                %annotation{:encoding => "application/x-tex"} \sum_{x:A} \sum_{y:A} x =_A y
            is a
            %a.existingWikiWord{:href => "/nlab/show/positive+copy"} positive copy
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            with respect to the
            %a.existingWikiWord{:href => "/nlab/show/diagonal+function"} diagonal function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %msub
                    %mi{:mathvariant => "normal"} refl
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi y
                      %mo :
                      %mi A
                  %mi x
                  %msub
                    %mo =
                    %mi A
                  %mi y
                %annotation{:encoding => "application/x-tex"} \Delta_{A}(x) \coloneqq (x, (x, \mathrm{refl}_A(x))):\sum_{x:A} \sum_{y:A} x =_A y
          %p
            However, there is also a negative version of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/copy+types"} copy types
            %a.existingWikiWord{:href => "/nlab/show/diagonal+function"} diagonal function
            is a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/definitional+isomorphism"} definitional isomorphism
          %ul
            %li Elimination rules for negative identity types:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                    %mrow
                      %mi Γ
                      %mo ,
                      %mi z
                      %mo :
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi x
                          %mo :
                          %mi A
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi y
                          %mo :
                          %mi A
                      %mi x
                      %msub
                        %mo =
                        %mi A
                      %mi y
                      %mo ⊢
                      %msubsup
                        %mi Δ
                        %mi A
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi A
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A \; \mathrm{type}}{\Gamma, z:\sum_{x:A} \sum_{y:A} x =_A y \vdash \Delta_A^{-1}(z):A}
          %ul
            %li Computation rules for negative identity types:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                    %mrow
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo :
                      %mi A
                      %mo ⊢
                      %msubsup
                        %mi Δ
                        %mi A
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Δ
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ≡
                      %mi x
                      %mo :
                      %mi A
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A \; \mathrm{type}}{\Gamma, x:A \vdash \Delta_A^{-1}(\Delta_{A}(x)) \equiv x:A}
          %ul
            %li Uniqueness rules for negative identity types:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                    %mrow
                      %mi Γ
                      %mo ,
                      %mi z
                      %mo :
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi x
                          %mo :
                          %mi A
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi y
                          %mo :
                          %mi A
                      %mi x
                      %msub
                        %mo =
                        %mi A
                      %mi y
                      %mo ⊢
                      %msub
                        %mi Δ
                        %mi A
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi Δ
                        %mi A
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ≡
                      %mi z
                      %mo :
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi x
                          %mo :
                          %mi A
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi y
                          %mo :
                          %mi A
                      %mi x
                      %msub
                        %mo =
                        %mi A
                      %mi y
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A \; \mathrm{type}}{\Gamma, z:\sum_{x:A} \sum_{y:A} x =_A y \vdash \Delta_{A}(\Delta_A^{-1}(z)) \equiv z:\sum_{x:A} \sum_{y:A} x =_A y}
          %p
            The uniqueness rules yield
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/equality+reflection"} equality reflection
            %a.existingWikiWord{:href => "/nlab/show/judgmental+equality"} judgmental equality
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+sum+types"} dependent sum types
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi Δ
                    %mi A
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo ,
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msubsup
                    %mi Δ
                    %mi A
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo ,
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msub
                    %mi{:mathvariant => "normal"} refl
                    %mi A
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi Δ
                    %mi A
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo ,
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ≡
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo ,
                  %mi p
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\Delta_A^{-1}(x, y, p), \Delta_A^{-1}(x, y, p), \mathrm{refl}_A(\Delta_A^{-1}(x, y, p))) \equiv (x, y, p)
          %p
            one can derive
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ≡
                  %msubsup
                    %mi Δ
                    %mi A
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo ,
                  %mi p
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} x \equiv \Delta_A^{-1}(x, y, p)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                  %mo ≡
                  %msubsup
                    %mi Δ
                    %mi A
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo ,
                  %mi p
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} y \equiv \Delta_A^{-1}(x, y, p)
            and thus
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ≡
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x \equiv y
          %p
            Similarly, the Paulin-Mohring J-rule states that given
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} x:A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi y
                      %mo :
                      %mi A
                  %mi x
                  %msub
                    %mo =
                    %mi A
                  %mi y
                %annotation{:encoding => "application/x-tex"} \sum_{y:A} x =_A y
            is a
            %a.existingWikiWord{:href => "/nlab/show/positive+unit+type"} positive unit type
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            with specified element
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %msub
                    %mi{:mathvariant => "normal"} refl
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi y
                      %mo :
                      %mi A
                  %mi x
                  %msub
                    %mo =
                    %mi A
                  %mi y
                %annotation{:encoding => "application/x-tex"} (x, \mathrm{refl}_A(x)):\sum_{y:A} x =_A y
          %p
            However, there are also
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/negative+unit+types"} negative unit types
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi y
                      %mo :
                      %mi A
                  %mi x
                  %msub
                    %mo =
                    %mi A
                  %mi y
                %annotation{:encoding => "application/x-tex"} \sum_{y:A} x =_A y
            is a definitional singleton with
            %a.existingWikiWord{:href => "/nlab/show/judgmental+equality"} judgmental
            %a.existingWikiWord{:href => "/nlab/show/center+of+contraction"} center of contraction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %msub
                    %mi{:mathvariant => "normal"} refl
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (x, \mathrm{refl}_A(x))
          %ul
            %li Uniqueness rules for negative identity types:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                    %mrow
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo :
                      %mi A
                      %mo ,
                      %mi z
                      %mo :
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi y
                          %mo :
                          %mi A
                      %mi x
                      %msub
                        %mo =
                        %mi A
                      %mi y
                      %mo ⊢
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %msub
                        %mi{:mathvariant => "normal"} refl
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ≡
                      %mi z
                      %mo :
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi y
                          %mo :
                          %mi A
                      %mi x
                      %msub
                        %mo =
                        %mi A
                      %mi y
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A \; \mathrm{type}}{\Gamma, x:A, z:\sum_{y:A} x =_A y \vdash (x, \mathrm{refl}_A(x)) \equiv z:\sum_{y:A} x =_A y}
          %p
            Similarly to the case for the standard Martin-Lof identity types, the uniqueness rule yields
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/equality+reflection"} equality reflection
            %a.existingWikiWord{:href => "/nlab/show/judgmental+equality"} judgmental equality
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+sum+types"} dependent sum types
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ≡
                  %mi y
                %annotation{:encoding => "application/x-tex"} x \equiv y
            from
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %msub
                      %mi{:mathvariant => "normal"} refl
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x, \mathrm{refl}_A(x)) \equiv (y, p)
          %h2#properties Properties
          %h3#decidability Decidability
          %p
            Extensional
            %a.existingWikiWord{:href => "/nlab/show/Martin-L%C3%B6f+type+theory"} Martin-Löf type theory
            does not have
            %a.existingWikiWord{:href => "/nlab/show/decidability"} decidable
            type checking. See
            %em
              %a.existingWikiWord{:href => "/nlab/show/intensional+type+theory"} intensional type theory
            for more on this.
          %p
          .num_theorem
            %h6 Theorem
            %p
              In addition, extensional type theory does not have decidable
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/judgmental+equality"} judgmental equality
          %p
          .proof
            %h6 Proof
            %p
              Already, the equality reflection rule for the
              %a.existingWikiWord{:href => "/nlab/show/natural+numbers+type"} natural numbers type
              implies undecidability of judgmental equality in the dependent type theory.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                        %mi Γ
                        %mo ⊢
                        %mi p
                        %mo :
                        %msub
                          %mi{:mathvariant => "normal"} Id
                          %mi ℕ
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} )
                      %mrow
                        %mi Γ
                        %mo ⊢
                        %mi x
                        %mo ≡
                        %mi y
                  %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash p:\mathrm{Id}_\mathbb{N}(x,y)}{\Gamma \vdash x \equiv y}
            %p
              In order to show that, in an arbitrary
              %a.existingWikiWord{:href => "/nlab/show/context"} context
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo ≡
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 0 \equiv 1
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} \mathbb{N}
              %a.existingWikiWord{:href => "/nlab/show/pointed+type"} pointed type
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
          %h2#justification Justification
          %p
            Extensional type theory is justified by the
            %a.existingWikiWord{:href => "/nlab/show/meaning+explanation"} meaning explanations
            of type theory. To see this, it suffices to notice that the equality reflection rule is validated by the meaning explanations. For more on this, see
            = succeed "," do
              %a{:href => "#Dybjer12"} Dybjer 2012
            = succeed "," do
              %a{:href => "#Bentzen24"} Bentzen 2024
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/axiom+K"}> axiom K
                ,
                %a.existingWikiWord{:href => "/nlab/show/axiom+UIP"} axiom UIP
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/intensional+type+theory"}> intensional type theory
                ,
                %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/observational+type+theory"}> observational type theory
                ,
                %a.existingWikiWord{:href => "/nlab/show/higher+observational+type+theory"} higher observational type theory
          %h2#examples Examples
          %ul
