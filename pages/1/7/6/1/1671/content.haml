              %a.existingWikiWord{:href => "/nlab/show/section"} section
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/entire+relations"} entire relations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi N
                %annotation{:encoding => "application/x-tex"} \mathbf{N}
            to any other set contains (in the
            %a.existingWikiWord{:href => "/nlab/show/2-poset"} 2-poset
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Rel"} Rel
            %a.existingWikiWord{:href => "/nlab/show/functional+relation"} functional
            entire relation.
          %h3#in_dependent_type_theory In dependent type theory
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            %strong countable choice
            says that the
            %a.existingWikiWord{:href => "/nlab/show/dependent+product+type"} dependent product
            of a family of inhabited sets indexed by the
            %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} natural numbers
            is itself inhabited:
