                %annotation{:encoding => "application/x-tex"} p\colon X \to \mathbf{N}
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/surjection"} surjection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            has a
