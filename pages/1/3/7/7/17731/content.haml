                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mi Mat
                      %mrow
                        %mn 1
                        %mo ×
                        %mi ν
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (-)^T C
                    \\;\colon\;
                    Mat_{\nu \times 1}(\mathbb{C})
                    \\longrightarrow
                    Mat_{1 \times \nu}(\mathbb{C})
            %p
              (from complex column vectors to complex row vectors) which is given by transposition followed by
              %a.existingWikiWord{:href => "/nlab/show/matrix+multiplication"} matrix multiplication
              from the right by the
              %a.existingWikiWord{:href => "/nlab/show/charge+conjugation+matrix"} charge conjugation matrix
              according to prop.
              %a.maruku-ref{:href => "#MajoranaConjugationIsRealStructure"}
              is called the
              = succeed "." do
                %strong Majorana conjugation
          #TheMajoranaConditionInComponents.num_prop
            %h6#proposition_7 Proposition
            %p
              In dimensions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo =
                    %mn 4
                    %mo ,
                    %mn 8
                    %mo ,
                    %mn 9
                    %mo ,
                    %mn 10
                    %mo ,
                    %mn 11
                  %annotation{:encoding => "application/x-tex"} d = 4,8,9,10,11
              a spinor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                    %mo ∈
                    %msup
                      %mi ℂ
                      %mrow
                        %msup
                          %mn 2
                          %mi ν
                  %annotation{:encoding => "application/x-tex"} \psi \in \mathbb{C}^{2^\nu}
              is Majorana according to def.
              %a.maruku-ref{:href => "#MajoranaSpinorGeneral"}
              with respect to the
              %a.existingWikiWord{:href => "/nlab/show/real+structure"} real structure
              from prop.
              = succeed "," do
                %a.maruku-ref{:href => "#MajoranaConjugationIsRealStructure"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                    %mo =
                    %mi C
                    %msubsup
                      %mi Γ
                      %mn 0
                      %mi T
                    %msup
                      %mi ψ
                      %mo *
                  %annotation{:encoding => "application/x-tex"}
                    \\psi = C \Gamma_0^T \psi^\ast
            %p
              (as e.g. in
              = succeed ")," do
                %a{:href => "#CastellaniDAuriaFre"} Castellani-D’Auria-Fré, (II.7.22)
            %p
              This is equivalent to the condition that the Majorana conjugate (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#MajoranaConjugation"}
              = succeed ")" do
                %a.maruku-ref{:href => "#DiracConjugate"}
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ψ
                    %annotation{:encoding => "application/x-tex"} \psi
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ψ
                      %mi T
                    %mi C
                    %mo =
                    %msup
                      %mi ψ
                      %mo †
                    %msub
                      %mi Γ
                      %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\psi^T C = \psi^\dagger \Gamma_0
                    \\,,
            %p which in turn is equivalent to the condition that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ψ
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mi ψ
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    (\psi,-) = \langle \psi,-\rangle
                    \\,,
            %p
              where on the left we have the complex bilinear form of prop.
              %a.maruku-ref{:href => "#ComplexBilinearFormInducedFromMajoranaStructure"}
              and on the right the
              %a.existingWikiWord{:href => "/nlab/show/hermitian+form"} hermitian form
              from prop.
              = succeed "." do
                %a.maruku-ref{:href => "#CliffordAlgebraRepresentation"}
          .proof
            %h6#proof_6 Proof
            %p
              The first statement is immediate. The second follows by applying the transpose to the first equation, and using that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo =
                    %msup
                      %mi C
                      %mi T
                  %annotation{:encoding => "application/x-tex"} C^{-1} = C^T
              (from prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#ChargeConjugationMatrix"}
              = succeed "." do
                %a.maruku-ref{:href => "#ComplexBilinearFormInducedFromMajoranaStructure"}
          %h3#pseudomajorana_spinors_and_symplectic_structure Pseudo-Majorana spinors and Symplectic structure
          %p
            In
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo =
                    %mn 5
                  %annotation{:encoding => "application/x-tex"} d = 5
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ψ
                  %mo =
                  %mi C
                  %msubsup
                    %mi Γ
                    %mn 0
                    %mi T
                  %msup
                    %mi ψ
                    %mo *
                %annotation{:encoding => "application/x-tex"}
                  \\psi = C \Gamma_0^T \psi^\ast
          %p
            from prop.
            %a.maruku-ref{:href => "#MajoranaConjugationIsRealStructure"}
            has no solution. But if we consider the
            %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
            of two copies of the complex spinor representation space, with elements denoted
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ψ
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \psi_1
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ψ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \psi_2
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %msubsup
                    %mi Γ
                    %mn 0
                    %mi T
                  %msubsup
                    %mi ψ
                    %mn 1
                    %mo *
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msub
                    %mi ψ
                    %mn 2
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi C
                  %msubsup
                    %mi Γ
                    %mn 0
                    %mi T
                  %msubsup
                    %mi ψ
                    %mn 2
                    %mo *
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %msub
                    %mi ψ
                    %mn 1
                %annotation{:encoding => "application/x-tex"}
                  C \Gamma_0^T \psi_1^\ast = -\psi_2
                  \\;\;\;\;
                  C \Gamma_0^T \psi_2^\ast = +\psi_1
          %p
            (e.g
            = succeed ")." do
              %a{:href => "#CastellaniDAuriaFre"} Castellani-D’Auria-Fré, II.8.41
            %a.maruku-ref{:href => "#MajoranaConjugationIsRealStructure"}
            and def.
            %a.maruku-ref{:href => "#MajoranaSpinorGeneral"}
            shows that this exhibits a quaternionic structure on the original complex spinor space, and hence a real structure on its direct sum double.
          %h3#majoranaweyl_spinors Majorana-Weyl spinors
          #WeylMajorana.num_defn
            %h6#definition_9 Definition
            %p
              In the even dimensions among those dimensions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              for which the Majorana projection operator (real structure)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
              exists (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#MajoranaConjugationIsRealStructure"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mi d
                  %annotation{:encoding => "application/x-tex"} \Gamma_{d}
              exists (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#WeylRepresentation"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                  %annotation{:encoding => "application/x-tex"} \psi
              is both Majorana,
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                      %mo{:stretchy => "false"} (
                      %mi ψ
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi ψ
                    %annotation{:encoding => "application/x-tex"} J(\psi) = \psi
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Γ
                        %mi d
                      %mi ψ
                      %mo =
                      %mo ±
                      %mi i
                      %mi ψ
                    %annotation{:encoding => "application/x-tex"} \Gamma_d \psi = \pm i \psi
              = succeed "," do
                %strong Majorana-Weyl spinor
              %a.existingWikiWord{:href => "/nlab/show/sub-representation"} sub-representation
              these form is a called a
              = succeed "." do
                %em Majorana-Weyl representation
          #WeylMajoranaInLorentzian10d.num_prop
            %h6#proposition_8 Proposition
            %p
              In Lorentzian signature (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LorentzianSignature"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 4
                      %mo ≤
                      %mi d
                      %mo ≤
                      %mn 11
                    %annotation{:encoding => "application/x-tex"} 4 \leq d \leq 11
              = succeed ")" do
                %a.maruku-ref{:href => "#WeylMajorana"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo =
                      %mn 10
                    %annotation{:encoding => "application/x-tex"} d = 10
          .proof
            %h6#proof_7 Proof
            %p
              According to prop.
              %a.maruku-ref{:href => "#MajoranaConjugationIsRealStructure"}
              Majorana spinors in the given range exist for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo ∈
                      %mo{:stretchy => "false"} {
                      %mn 4
                      %mo ,
                      %mn 8
                      %mo ,
                      %mn 9
                      %mo ,
                      %mn 10
                      %mo ,
                      %mn 11
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} d \in \{4,8,9,10,11\}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo ∈
                      %mo{:stretchy => "false"} {
                      %mn 4
                      %mo ,
                      %mn 8
                      %mo ,
                      %mn 10
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} d \in \{4,8,10\}
            %p Majorana-Weyl spinors clearly exist precisely if the two relevant projection operators in these dimensions commute with each other, i.e. if
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi J
                    %mo ,
                    %mi ϵ
                    %msub
                      %mi Γ
                      %mn 0
                    %mi ⋯
                    %msub
                      %mi Γ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    [J, \epsilon \Gamma_0 \cdots \Gamma_{d-1}] = 0
            %p where
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo =
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mn 1
                            %mtd
                              %mo{:stretchy => "false"} |
                              %mspace{:width => "thickmathspace"}
                              %mi ν
                              %mspace{:width => "thinmathspace"}
                              %mtext odd
                          %mtr
                            %mtd
                              %mi i
                            %mtd
                              %mo{:stretchy => "false"} |
                              %mspace{:width => "thickmathspace"}
                              %mi ν
                              %mspace{:width => "thinmathspace"}
                              %mtext even
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\epsilon
                    \=
                    \\left\{
                    \\array{
                    1 &amp; \vert \; \nu \, \text{odd}
                    \\\
                    i &amp; \vert \; \nu \, \text{even}
                    }
                    \\right.
                    \\,.
            %p
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo =
                    %mn 2
                    %mi ν
                  %annotation{:encoding => "application/x-tex"} d = 2\nu
              (from the proof of prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#CliffordAlgebraRepresentation"}
            %p
              By prop.
              %a.maruku-ref{:href => "#RealStructureAntiCommutesWithSingleCliffordGenerator"}
              all the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mi a
                  %annotation{:encoding => "application/x-tex"} \Gamma_a
              commute or all anti-commute with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                    %annotation{:encoding => "application/x-tex"} J
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mn 0
                    %mi ⋯
                    %msub
                      %mi Γ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \Gamma_0 \cdots \Gamma_{d-1}
              contains an even number of these, it commutes with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                    %annotation{:encoding => "application/x-tex"} J
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
              commutes with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mi d
                  %annotation{:encoding => "application/x-tex"} \Gamma_d
              precisely if it commutes with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                    %annotation{:encoding => "application/x-tex"} \epsilon
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
              is conjugate-linear, this is the case precisely if
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} \epsilon = 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo =
                    %mn 2
                    %mi ν
                  %annotation{:encoding => "application/x-tex"} d = 2\nu
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ν
                  %annotation{:encoding => "application/x-tex"} \nu
              odd.
            %p
              This is the case for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo =
                      %mn 10
                      %mo =
                      %mn 2
                      %mo ⋅
                      %mn 5
                    %annotation{:encoding => "application/x-tex"} d = 10 = 2 \cdot 5
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo =
                    %mn 8
                    %mo =
                    %mn 2
                    %mo ⋅
                    %mn 4
                  %annotation{:encoding => "application/x-tex"} d = 8 = 2 \cdot 4
              neither for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo =
                      %mn 4
                      %mo =
                      %mn 2
                      %mo ⋅
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} d = 4 = 2 \cdot 2
          %h2#TheSpinorPairingToVectors
            The spinor bilinear pairing to antisymmetric
            = succeed "-tensors" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
          %p
            We now discuss, in the component expressions established
            = succeed "," do
              %a{:href => "#InComponents"} above
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/vector"} vector
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/tensor"} tensor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ψ
                  %mo ↦
                  %mi ϵ
                  %mspace{:width => "thinmathspace"}
                  %mover
                    %mi ψ
                    %mo ¯
                  %msup
                    %mi Γ
                    %mrow
                      %msub
                        %mi a
                        %mn 1
                      %mi ⋯
                      %msub
                        %mi a
                        %mi p
                  %mi ψ
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\psi
                  \\mapsto
                  \\epsilon \, \overline{\psi} \Gamma^{a_1 \cdots a_p} \psi
                  \\,,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϵ
                  %mo ∈
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} \epsilon \in \mathbb{C}
            is some prefactor, constrained such as to make the whole expression be real, hence such as to make this the components of an element in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∧
                      %mi p
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \wedge^p \mathbb{R}^{d-1,1}
          %p
            For a
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spin
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo −
                  %mn 1
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Spin(d-1,1)
            representation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            as in prop.
            = succeed "," do
              %a.maruku-ref{:href => "#CliffordAlgebraRepresentation"}
            = succeed "," do
              %a.maruku-ref{:href => "#MajoranaConjugationIsRealStructure"}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo ↪
                  %mi V
                %annotation{:encoding => "application/x-tex"}
                  S \hookrightarrow V
          %p for the subspace of Majorana spinors, regarded as a real vector space.
          %p
            Recall, by prop.
            = succeed "," do
              %a.maruku-ref{:href => "#TheMajoranaConditionInComponents"}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi T
                  %mi C
                %annotation{:encoding => "application/x-tex"} (-)^T C
            coincides with the Dirac conjugate
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %mo ¯
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo †
                    %msub
                      %mi Γ
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \overline{(-)} \coloneqq (-)^\dagger \Gamma_0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %mo ¯
                %annotation{:encoding => "application/x-tex"} \overline{(-)}
            in the following for the conjugation of Majorana spinors, unambiguously defined.
          #SpinorToVectorBilinearPairing.num_defn
            %h6#definition_10 Definition
            %p
              For a
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spin(d-1,1)
              representation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              as in prop.
              = succeed "," do
                %a.maruku-ref{:href => "#CliffordAlgebraRepresentation"}
              = succeed "," do
                %a.maruku-ref{:href => "#MajoranaConjugationIsRealStructure"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %mo ¯
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi S
                    %mo ×
                    %mi S
                    %mo ⟶
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\overline{(-)}\Gamma (-)
                    \\;\colon\;
                    S \times S
                    \\longrightarrow
                    \\mathbb{R}^{d-1,1}
            %p
              be the function that takes Majorana spinors
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ψ
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \psi_1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ψ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \psi_2
              to the vector with components
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi ψ
                        %mo ¯
                      %mn 1
                    %msup
                      %mi Γ
                      %mi a
                    %msub
                      %mi ψ
                      %mn 2
                    %mo ≔
                    %msubsup
                      %mi ψ
                      %mn 1
                      %mi T
                    %mi C
                    %msup
                      %mi Γ
                      %mi a
                    %msub
                      %mi ψ
                      %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\overline{\psi}_1\Gamma^a \psi_2
                    \\coloneqq
                    \\psi_1^T C \Gamma^a \psi_2
                    \\,.
          #SpinorToVectorPairing.num_prop
            %h6#proposition_9 Proposition
            %p
              The pairing in def.
              %a.maruku-ref{:href => "#SpinorToVectorBilinearPairing"}
              is
            %ol
              %li
                %p symmetric:
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mover
                            %mi ψ
                            %mo ¯
                          %mn 1
                        %mi Γ
                        %msub
                          %mi ψ
                          %mn 2
                        %mo =
                        %msub
                          %mover
                            %mi ψ
                            %mo ¯
                          %mn 2
                        %mi Γ
                        %msub
                          %mi ψ
                          %mn 1
                      %annotation{:encoding => "application/x-tex"}
                        \\overline{\psi}_1 \Gamma \psi_2
                        \=
                        \\overline{\psi}_2 \Gamma \psi_1
              %li
                %p
                  component-wise real-valued (i.e. it indeed takes values in
                  = succeed ");" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi ℝ
                            %mi d
                          %mo ⊂
                          %msup
                            %mi ℂ
                            %mi d
                        %annotation{:encoding => "application/x-tex"} \mathbb{R}^d \subset \mathbb{C}^d
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi Spin
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Spin(d-1,1)
                  \-equivariant: for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mo ∈
                        %mi Spin
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} g \in Spin(d-1,1)
                  then
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mrow
                            %mi g
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                          %mo ¯
                        %mi Γ
                        %mo{:stretchy => "false"} (
                        %mi g
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi g
                        %mo{:stretchy => "false"} (
                        %mover
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                          %mo ¯
                        %mi Γ
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\overline{g(-)}\Gamma(g(-))
                        \=
                        g(\overline{(-)}\Gamma(-))
                        \\,.
          .proof
            %h6#proof_8 Proof
            %p
              Regarding the first point, we need to show that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %msub
                      %mi Γ
                      %mi a
                  %annotation{:encoding => "application/x-tex"} C \Gamma_a
              is a symmetric matrix. Indeed:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi C
                            %msub
                              %mi Γ
                              %mi a
                            %msup
                              %mo{:stretchy => "false"} )
                              %mi T
                          %mtd
                            %mo =
                            %msubsup
                              %mi Γ
                              %mi a
                              %mi T
                            %msup
                              %mi C
                              %mi T
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo ±
                            %msubsup
                              %mi Γ
                              %mi a
                              %mi T
                            %mi C
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo ±
                            %mo ±
                            %mi C
                            %msub
                              %mi Γ
                              %mi a
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi C
                            %msub
                              %mi Γ
                              %mi a
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    (C \Gamma_a)^T
                    \&amp; =
                    \\Gamma_a^T C^T
                    \\\
                    \&amp; = \pm \Gamma_a^T C
                    \\\
                    \&amp; = \pm \pm C \Gamma_a
                    \\\
                    \&amp; = C \Gamma_a
                    \\end{aligned}
                    \\,,
            %p
              where the first sign picked up is from
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mi T
                      %mo =
                      %mo ±
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C^T = \pm C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Γ
                      %mi a
                      %mi T
                    %mi C
                    %mo =
                    %mo ±
                    %mi C
                    %msub
                      %mi Γ
                      %mi a
                  %annotation{:encoding => "application/x-tex"} \Gamma_a^T C = \pm C \Gamma_a
              (according to prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#ChargeConjugationMatrix"}
              %a.maruku-ref{:href => "#MajoranaConjugationIsRealStructure"}
              one finds that these signs agree, and hence cancel out.
            %p
              (In
              %a{:href => "#VanProeyen99"} van Proeyen99
              this is part of table 1, in (
              %a{:href => "#CastellaniDAuriaFre"}> Castellani-D’Auria-Fré
              ) this is implicit in equation (II.2.32a).)
            %p
              With this the second point follows together with the relation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ψ
                      %mi T
                    %mi C
                    %mo =
                    %msup
                      %mi ψ
                      %mo †
                    %msub
                      %mi Γ
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \psi^T C = \psi^\dagger \Gamma_0
              for Majorana spinors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                  %annotation{:encoding => "application/x-tex"} \psi
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#TheMajoranaConditionInComponents"}
              %a.existingWikiWord{:href => "/nlab/show/hermitian+form"} hermitian form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo †
                    %msub
                      %mi Γ
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \langle -,-\rangle = (-)^\dagger \Gamma_0 (-)
              as well as the hermiticity of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mn 0
                    %msub
                      %mi Γ
                      %mi a
                  %annotation{:encoding => "application/x-tex"} \Gamma_0 \Gamma_a
              (both from prop.
              = succeed "):" do
                %a.maruku-ref{:href => "#CliffordAlgebraRepresentation"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mover
                                %mi ψ
                                %mo ¯
                              %mn 1
                            %msub
                              %mi Γ
                              %mi a
                            %msub
                              %mi ψ
                              %mn 2
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo *
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi ψ
                              %mn 1
                              %mi T
                            %mi C
                            %msub
                              %mi Γ
                              %mi a
                            %msub
                              %mi ψ
                              %mn 2
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo *
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi ψ
                              %mn 1
                              %mo †
                            %msub
                              %mi Γ
                              %mn 0
                            %msup
                              %mi Γ
                              %mi a
                            %msub
                              %mi ψ
                              %mn 2
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo *
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msubsup
                              %mi ψ
                              %mn 2
                              %mo †
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Γ
                              %mn 0
                            %msup
                              %mi Γ
                              %mi a
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo †
                            %msub
                              %mi ψ
                              %mn 1
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msubsup
                              %mi ψ
                              %mn 2
                              %mo †
                            %msub
                              %mi Γ
                              %mn 0
                            %msup
                              %mi Γ
                              %mi a
                            %msub
                              %mi ψ
                              %mn 1
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mover
                                %mi ψ
                                %mo ¯
                              %mn 2
                            %msub
                              %mi Γ
                              %mi a
                            %msub
                              %mi ψ
                              %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    (\overline{\psi}_1 \Gamma_a \psi_2)^\ast
                    \&amp;=
                    (\psi_1^T C \Gamma_a \psi_2)^\ast
                    \\\
                    \&amp; =
                    (\psi_1^\dagger \Gamma_0 \Gamma^a \psi_2)^\ast
                    \\\
                    \&amp; =
                    \\psi_2^\dagger (\Gamma_0 \Gamma^a)^\dagger \psi_1
                    \\\
                    \&amp; =
                    \\psi_2^\dagger \Gamma_0 \Gamma^a \psi_1
                    \\\
                    \&amp; =
                    \\overline{\psi}_2 \Gamma_a \psi_1
                    \\end{aligned}
                    \\,.
            %p
              Regarding the third point: By prop.
              %a.maruku-ref{:href => "#MajoranaConjugationIsRealStructure"}
              and prop.
              %a.maruku-ref{:href => "#ComplexBilinearFormInducedFromMajoranaStructure"}
              we get
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi g
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi ψ
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %msub
                              %mi Γ
                              %mi a
                            %mi g
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi ψ
                              %mn 2
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} ⟨
                            %mi g
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi ψ
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %msub
                              %mi Γ
                              %mi a
                            %mi g
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi ψ
                              %mn 2
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ⟩
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} ⟨
                            %msub
                              %mi ψ
                              %mn 1
                            %mo ,
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi Γ
                              %mn 0
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %msup
                              %mi g
                              %mo †
                            %msub
                              %mi Γ
                              %mn 0
                            %mo{:stretchy => "false"} )
                            %msub
                              %mi Γ
                              %mi a
                            %mi g
                            %msub
                              %mi ψ
                              %mn 2
                            %mo{:stretchy => "false"} ⟩
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} ⟨
                            %msub
                              %mi ψ
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi g
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %msub
                              %mi Γ
                              %mi a
                            %mi g
                            %mo{:stretchy => "false"} )
                            %msub
                              %mi ψ
                              %mn 2
                            %mo{:stretchy => "false"} ⟩
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    (g(\psi_1), \Gamma_a g(\psi_2))
                    \&amp; =
                    \\langle g(\psi_1),\Gamma_a g(\psi_2)\rangle
                    \\\
                    \&amp; =
                    \\langle \psi_1, (\Gamma_0^{-1}g^\dagger\Gamma_0) \Gamma_a g \psi_2 \rangle
                    \\\
                    \&amp; = \langle \psi_1 (g^{-1} \Gamma_a g) \psi_2 \rangle
                    \\end{aligned}
                    \\,,
            %p
              where we used that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Γ
                      %mn 0
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo †
                    %msub
                      %mi Γ
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \Gamma_0^{-1}(-)^\dagger \Gamma_0
              is the adjoint with respect to the hermitian form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo †
                    %msub
                      %mi Γ
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \langle -,-\rangle = (-)^\dagger \Gamma_0 (-)
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#CliffordRepresentationIsDiracSelfConjugate"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              is unitary with respect to this hermitian form by prop.
              = succeed "." do
                %a.maruku-ref{:href => "#CliffordAlgebraRepresentation"}
            %p
              (In (
              %a{:href => "#CastellaniDAuriaFre"}> Castellani-D’Auria-Fré
              ) this third statement implicit in equations (II.2.35)-(II.2.39).)
          #SuperPoincareOutlook.num_remark
            %h6#remark_2 Remark
            %p
              Proposition
              %a.maruku-ref{:href => "#SpinorToVectorPairing"}
              implies that adding a copy of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              to the
              %a.existingWikiWord{:href => "/nlab/show/Poincar%C3%A9+Lie+algebra"} Poincaré Lie algebra
              in odd degree, then the pairing of def.
              %a.maruku-ref{:href => "#SpinorToVectorBilinearPairing"}
              is a consistent extension of the
              %a.existingWikiWord{:href => "/nlab/show/Lie+bracket"} Lie bracket
              of the latter to a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/super+Poincar%C3%A9+Lie+algebra"} super Poincaré Lie algebra
          #SpinorToRank2TensorBilinearPairing.num_defn
            %h6#definition_11 Definition
            %p
              For a
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
                    %mo{:stretchy => "false"} (
