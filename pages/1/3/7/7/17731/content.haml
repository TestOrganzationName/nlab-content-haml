                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mo{:stretchy => "false"} ⟨
                    %mi e
                    %mo{:stretchy => "false"} ⟩
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi d
                    %mi e
                    %mo =
                    %mi ω
                    %mo{:stretchy => "false"} )
