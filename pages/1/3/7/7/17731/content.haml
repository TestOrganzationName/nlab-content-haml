          .proof
            %h6 Proof
            %p
              With the skew-symmetry of the spinor pairing
              %a.maruku-eqref{:href => "#eq:SpinorPairingOn32"} (3)
              we compute as follows:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "left left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mover
                            %mi ψ
                            %mo ¯
                          %msub
                            %mi Γ
                            %mrow
                              %mo{:stretchy => "false"} [
                              %msub
                                %mi a
                                %mn 1
                              %mi ⋯
                              %msub
                                %mi a
                                %mi p
                              %mo{:stretchy => "false"} ]
                          %mi ϕ
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo ≔
                          %mspace{:width => "thickmathspace"}
                          %mi{:mathvariant => "normal"} Re
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %msup
                            %mi ψ
                            %mo †
                          %msub
                            %mi Γ
                            %mn 0
                          %msub
                            %mi Γ
                            %mrow
                              %mo{:stretchy => "false"} [
                              %msub
                                %mi a
                                %mn 1
                              %mi ⋯
                              %msub
                                %mi a
                                %mi p
                              %mo{:stretchy => "false"} ]
                          %mi ϕ
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mtr
                        %mtd
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %mo −
                          %mi{:mathvariant => "normal"} Re
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                          %msup
                            %mi ϕ
                            %mo †
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %msub
                            %mi Γ
                            %mrow
                              %mo{:stretchy => "false"} [
                              %msub
                                %mi a
                                %mn 1
                              %mi ⋯
                              %msub
                                %mi a
                                %mi p
                              %mo{:stretchy => "false"} ]
                          %msup
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %mo †
                          %msub
                            %mi Γ
                            %mn 0
                          %mi ψ
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
