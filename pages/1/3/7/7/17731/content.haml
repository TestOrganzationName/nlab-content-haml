          #TransposeChargeConjugation.num_remark
            %h6#remark Remark
            %p
              Prop.
              %a.maruku-ref{:href => "#ChargeConjugationMatrix"}
              implies that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo ±
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C_{(\pm)}
              listed there then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo =
                    %msup
                      %mi C
                      %mi T
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    C^{-1} = C^T
                    \\,.
            %p This implies in all cases that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mi a
                    %msubsup
                      %mi C
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo ±
                        %mo{:stretchy => "false"} )
                      %mi T
                    %mo =
                    %mo ±
                    %msubsup
                      %mi C
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo ±
                        %mo{:stretchy => "false"} )
                      %mi T
                    %msubsup
                      %mi Γ
                      %mi a
                      %mi T
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma_a C_{(\pm)}^T = \pm C_{(\pm)}^T \Gamma_a^T
                    \\,.
          %h3#majorana_representations_and_real_structure Majorana representations and Real structure
          #MajoranaConjugationIsRealStructure.num_prop
            %h6#proposition_4 Proposition
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
