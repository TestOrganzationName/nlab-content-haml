                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              as in prop.
              = succeed "," do
                %a.maruku-ref{:href => "#CliffordAlgebraRepresentation"}
              = succeed "," do
                %a.maruku-ref{:href => "#MajoranaConjugationIsRealStructure"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
