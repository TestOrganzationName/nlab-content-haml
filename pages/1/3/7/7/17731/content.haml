                    %mi S
                    %mo ⟶
                    %msup
                      %mo ∧
                      %mn 2
                    %msup
                      %mi ℂ
                      %mi d
                  %annotation{:encoding => "application/x-tex"}
                    \\overline{(-)}\Gamma\Gamma (-)
                    \\;\colon\;
                    S \times S
                    \\longrightarrow
                    \\wedge^2 \mathbb{C}^d
            %p
              be the function that takes Majorana spinors
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
