                    \\,,
          #RealityOfTheSpinorPairingtoBivectors.num_prop
            %h6#proposition_10 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ψ
                      %mn 1
                    %mo =
                    %msub
                      %mi ψ
                      %mn 2
                    %mo =
                    %mi ψ
                  %annotation{:encoding => "application/x-tex"} \psi_1 = \psi_2 = \psi
              then the pairing in prop.
              %a.maruku-ref{:href => "#SpinorToRank2TensorBilinearPairing"}
              is real
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ∀
                      %mrow
                        %mi a
                        %mo ,
                        %mi b
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi i
                    %mover
                      %mi ψ
                      %mo ¯
                    %msup
                      %mi Γ
                      %mrow
                        %mi a
                        %mi b
                    %mi ψ
                    %mo ∈
                    %mi ℝ
                    %mo ⊂
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{a,b}{\forall}
                    \\;\;\;\;
                    i \overline{\psi} \Gamma^{a b} \psi \in \mathbb{R} \subset \mathbb{C}
            %p
              and
              = succeed "-equivariant." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Spin
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo −
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Spin(d-1,1)
          .proof
            %h6#proof_9 Proof
            %p
              The equivariance follows exactly as in the proof of prop.
              = succeed "." do
                %a.maruku-ref{:href => "#SpinorToVectorPairing"}
            %p The reality is checked by direct computation as follows:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mover
                                %mi ψ
                                %mo ¯
                              %mn 1
                            %msub
                              %mi Γ
                              %mi a
                            %msub
                              %mi Γ
                              %mi b
                            %msub
                              %mi ψ
                              %mn 2
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo *
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi ψ
                              %mn 1
                              %mo †
                            %msub
                              %mi Γ
                              %mi a
                            %msub
                              %mi Γ
                              %mi b
                            %msub
                              %mi ψ
                              %mn 2
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo *
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msubsup
                              %mi ψ
                              %mn 2
                              %mo †
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Γ
                              %mn 0
                            %msub
                              %mi Γ
                              %mi a
                            %msub
                              %mi Γ
                              %mi b
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo †
                            %msub
                              %mi ψ
                              %mn 1
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} ⟨
                            %msubsup
                              %mi ψ
                              %mn 2
                              %mo †
                            %msub
                              %mi Γ
                              %mn 0
                            %msub
                              %mi Γ
                              %mi a
                            %msub
                              %mi Γ
                              %mi b
                            %msub
                              %mi ψ
                              %mn 1
                            %mo{:stretchy => "false"} ⟩
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msub
                              %mover
                                %mi ψ
                                %mo ¯
                              %mn 2
                            %msub
                              %mi Γ
                              %mi a
                            %msub
                              %mi Γ
                              %mi b
                            %msub
                              %mi ψ
                              %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    (\overline{\psi}_1 \Gamma_a \Gamma_b \psi_2)^\ast
                    \&amp; =
                    (\psi_1^\dagger \Gamma_a \Gamma_b \psi_2)^\ast
                    \\\
                    \&amp; =
                    \\psi_2^\dagger (\Gamma_0 \Gamma_a \Gamma_b)^\dagger \psi_1
                    \\\
                    \&amp; =
                    \-\langle \psi_2^\dagger \Gamma_0 \Gamma_a \Gamma_b \psi_1 \rangle
                    \\\
                    \&amp; =
                    \-\overline{\psi}_2 \Gamma_a \Gamma_b \psi_1
                    \\end{aligned}
                    \\,,
            %p
              where for the identification
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Γ
                      %mn 0
                    %msub
                      %mi Γ
                      %mi a
                    %msub
                      %mi Γ
                      %mi b
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo †
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mi Γ
                      %mn 0
                    %msub
                      %mi Γ
                      %mi a
                    %msub
                      %mi Γ
                      %mi b
                  %annotation{:encoding => "application/x-tex"} (\Gamma_0 \Gamma_a \Gamma_b)^\dagger = - \Gamma_0 \Gamma_a \Gamma_b
              we used the properties in prop.
              = succeed "." do
                %a.maruku-ref{:href => "#CliffordAlgebraRepresentation"}
            %p
              Hence for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ψ
                      %mn 1
                    %mo =
                    %msub
                      %mi ψ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \psi_1 = \psi_2
              then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi ψ
                      %mo ¯
                    %msub
                      %mi Γ
                      %mi a
                    %msub
                      %mi Γ
                      %mi b
                    %mi ψ
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mover
                      %mi ψ
                      %mo ¯
                    %msub
                      %mi Γ
                      %mi a
                    %msub
                      %mi Γ
                      %mi b
                    %mi ψ
                  %annotation{:encoding => "application/x-tex"}
                    (\overline{\psi} \Gamma_a \Gamma_b \psi)^\ast
                    \=
                    \-
                    \\overline{\psi} \Gamma_a \Gamma_b \psi
            %p
              and so this sign cancels against the sign in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
