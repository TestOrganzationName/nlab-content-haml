          %h3#ChargeConjugationMatrix Charge conjugation matrix
          #ChargeConjugationMatrix.num_prop
            %h6#proposition_3 Proposition
            %p
              Given the Clifford algebra representation of the form of prop.
              = succeed "," do
                %a.maruku-ref{:href => "#CliffordAlgebraRepresentation"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo ±
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi Γ
                      %mi a
                    %mo =
                    %mo ±
                    %msubsup
                      %mi Γ
                      %mi a
                      %mi T
                    %msub
                      %mi C
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo ±
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    C_{(\pm)} \Gamma_a  = \pm \Gamma_a^T C_{(\pm)}
            %p
              for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi C
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo ±
                          %mo{:stretchy => "false"} )
                      %mo ∈
                      %msub
                        %mi Mat
                        %mrow
                          %mi ν
                          %mo ×
                          %mi n
                      %mo{:stretchy => "false"} (
                      %mi ℂ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C_{(\pm)} \in Mat_{\nu \times n}(\mathbb{C})
            %p
              In even dimensions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo =
                    %mn 2
                    %mi ν
                  %annotation{:encoding => "application/x-tex"} d = 2 \nu
              then both these equations have a solution, wheras in odd dimensions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo =
                    %mn 2
                    %mi ν
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} d = 2 \nu + 1
              only one of them does (alternatingly, starting with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C_{(+)}
