                              %mo −
                              %mn 1
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} /
                              %mn 2
                          %mi{:mathvariant => "normal"} Re
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                          %msup
                            %mi ϕ
                            %mo †
                          %msub
                            %mi Γ
                            %mn 0
                          %msub
                            %mi Γ
                            %mrow
                              %mo{:stretchy => "false"} [
                              %msub
                                %mi a
                                %mn 1
                              %mi ⋯
                              %msub
                                %mi a
                                %mi p
                              %mo{:stretchy => "false"} ]
                          %mi ψ
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                      %mtr
                        %mtd
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %mo −
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                          %msup
                            %mo{:stretchy => "false"} )
                            %mrow
                              %mi p
                              %mo{:stretchy => "false"} (
