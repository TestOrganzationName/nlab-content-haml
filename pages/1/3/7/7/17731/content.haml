                        %mn 32
                      %msub
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mi sym
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mn 32
                    %annotation{:encoding => "application/x-tex"} \big(\mathbf{32} \otimes \mathbf{32}\big)_{sym} \to \mathbf{32}
