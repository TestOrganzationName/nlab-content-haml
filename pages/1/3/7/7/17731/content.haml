                    \\begin{array}{ll}
                    \\big(
                    \\overline{\psi}
                    \\Gamma_{[a_1 \cdots a_p]}
                    \\phi
                    \\big)
                    \&amp; \;\coloneqq\;
                    \\mathrm{Re}\big(
                    \\psi^\dagger
                    \\Gamma_0
                    \\Gamma_{[a_1 \cdots a_p]}
                    \\phi
                    \\big)
                    \\\
                    \&amp; \;=\;
                    \-
                    \\mathrm{Re}\Big(
                    \\phi^\dagger
                    \\big(\Gamma_{[a_1 \cdots a_p]}\big)^\dagger
