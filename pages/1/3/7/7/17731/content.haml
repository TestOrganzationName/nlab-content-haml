                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %mo −
                          %mi{:mathvariant => "normal"} Re
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                          %msup
                            %mi ϕ
                            %mo †
                          %msub
                            %mi Γ
                            %mn 0
                          %msubsup
                            %mi Γ
                            %mn 0
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %msub
                            %mi Γ
                            %mrow
                              %mo{:stretchy => "false"} [
                              %msub
                                %mi a
                                %mn 1
                              %mi ⋯
                              %msub
                                %mi a
                                %mi p
                              %mo{:stretchy => "false"} ]
                          %msup
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %mo †
                          %msub
                            %mi Γ
                            %mn 0
                          %mi ψ
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                      %mtr
                        %mtd
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %mo −
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                          %msup
                            %mo{:stretchy => "false"} )
                            %mrow
                              %mi p
                              %mo +
                              %mi p
                              %mo{:stretchy => "false"} (
