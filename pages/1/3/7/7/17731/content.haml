                      %mi Γ
                      %mrow
                        %msub
                          %mi a
                          %mn 1
                        %mi ⋯
                        %msub
                          %mi a
                          %mi p
                  %annotation{:encoding => "application/x-tex"}
                    M
                    \\;=\;
                    \\tfrac{1}{32}
                    \\sum_{p = 0}^5
                    \\;
                    \\frac{
                    (-1)^{p(p-1)/2}
                    }{ p! }
                    \\mathrm{Tr}\big(
                    \\phi \circ
                    \\Gamma_{a_1 \cdots a_p}
                    \\big)
                    \\Gamma^{a_1 \cdots a_p}
            %p
