              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ≔
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi a
                        %mn 1
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %msub
                        %mi a
                        %mi j
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} A \coloneqq \{a_1, \cdots, a_j\}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ≔
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi b
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi b
                      %mi k
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} B \coloneqq \{b_1, \cdots, b_k\}
              and their intersection
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo :
                      %mo =
                      %mi A
                      %mo ∩
                      %mi B
                    %annotation{:encoding => "application/x-tex"} C := A \cap B
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} card
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi l
                    %annotation{:encoding => "application/x-tex"} \mathrm{card}(C) = l
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Γ
                      %mi c
                    %mo ,
                    %msub
                      %mi Γ
                      %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\Gamma^c , \Gamma_{c})
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} c \in C
              at a time. We claim that in the first step this can be written as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Γ
                      %mrow
                        %msub
                          %mi a
                          %mi j
                        %mi ⋯
                        %msub
                          %mi a
                          %mn 1
                    %msub
                      %mi Γ
                      %mrow
                        %msub
                          %mi b
                          %mn 1
                        %mi ⋯
                        %msub
                          %mi b
                          %mi k
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mrow
                        %mi j
                        %mi k
                      %mi l
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi Γ
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi a
                          %mi j
                        %mi ⋯
                        %msub
                          %mi a
                          %mn 2
                    %msubsup
                      %mi δ
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi b
                          %mn 1
                      %mrow
                        %msub
                          %mi a
                          %mn 1
                        %mo{:stretchy => "false"} ]
                    %msub
                      %mi Γ
                      %mrow
                        %msub
                          %mi b
                          %mn 2
                        %mi ⋯
                        %msub
                          %mi b
                          %mi k
                        %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma^{a_j \cdots a_1}
                    \\Gamma_{b_1 \cdots b_k}
                    \\;=\;
                    \\frac{j k}{l}
                    \\,
                    \\Gamma^{[a_j \cdots a_2}
                    \\delta^{a_1]}_{[b_1}
                    \\Gamma_{b_2 \cdots b_k]}
                    \\,.
            %p
              Namely, notice that for any tensor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mrow
                        %msub
                          %mi a
                          %mn 1
                        %mi ⋯
                        %msub
                          %mi a
                          %mi k
                  %annotation{:encoding => "application/x-tex"} X^{a_1 \cdots a_k}
              the expression
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %msup
                      %mi X
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi a
                          %mi k
                        %mi ⋯
                        %msub
                          %mi a
                          %mn 1
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} k X^{[a_k \cdots a_1]}
              is the signed sum over all ways of moving any one index to the far right, and similarly
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi l
                    %msup
                      %mi Y
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi b
                          %mn 1
                        %mi ⋯
                        %msub
                          %mi b
                          %mi l
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} l Y^{[b_1 \cdots b_l]}
              is the signed sum over all ways of moving any one index to the far left. In contracting all the indices that thus become coincident “in the middle” of our expression, we are contracting the one index that we set out to contract, but since we are doing this for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} c \in C
              we are overcounting by a factor of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi l
                    %annotation{:encoding => "application/x-tex"} l
            %p In order to conveniently recurse on this expression, we just move the Kronecker-delta to the left to obtain
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Γ
                      %mrow
                        %msub
                          %mi a
                          %mi j
                        %mi ⋯
                        %msub
                          %mi a
                          %mn 1
                    %msub
                      %mi Γ
                      %mrow
                        %msub
                          %mi b
                          %mn 1
                        %mi ⋯
                        %msub
                          %mi b
                          %mi k
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi j
                        %mo −
                        %mn 1
                    %mfrac
                      %mrow
                        %mi j
                        %mi k
                      %mi l
                    %mspace{:width => "thinmathspace"}
                    %msubsup
                      %mi δ
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi b
                          %mn 1
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi a
                          %mn 1
                    %msup
                      %mi Γ
                      %mrow
                        %msub
                          %mi a
                          %mi j
                        %mi ⋯
                        %msub
                          %mi a
                          %mn 2
                        %mo{:stretchy => "false"} ]
                    %msub
                      %mi Γ
                      %mrow
                        %msub
                          %mi b
                          %mn 2
                        %mi ⋯
                        %msub
                          %mi b
                          %mi k
                        %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma^{a_j \cdots a_1}
                    \\Gamma_{b_1 \cdots b_k}
                    \\;=\;
                    (-1)^{j-1}
                    \\frac{j k}{l}
                    \\,
                    \\delta^{[a_1}_{[b_1}
                    \\Gamma^{a_j \cdots a_2]}
                    \\Gamma_{b_2 \cdots b_k]}
                    \\,.
            %p Now recursing, we arrive at
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Γ
                      %mrow
                        %msub
                          %mi a
                          %mi j
                        %mi ⋯
                        %msub
                          %mi a
                          %mn 1
                    %msub
                      %mi Γ
                      %mrow
                        %msub
                          %mi b
                          %mn 1
                        %mi ⋯
                        %msub
                          %mi b
                          %mi k
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi j
                        %mo −
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mi ⋯
                        %mo{:stretchy => "false"} (
                        %mi j
                        %mo −
                        %mi l
                        %mo{:stretchy => "false"} )
                    %msub
                      %munder
                        %mfrac
                          %mrow
                            %mi j
                            %mi ⋯
                            %mo{:stretchy => "false"} (
                            %mi j
                            %mo −
                            %mi l
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %mi k
                            %mi ⋯
                            %mo{:stretchy => "false"} (
                            %mi k
                            %mo −
                            %mi l
                            %mo{:stretchy => "false"} )
                          %mrow
                            %mi l
                            %mo !
                        %mo ⏟
                      %mrow
                        %mi l
                        %mo !
                        %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                        %mfrac{:linethickness => "0"}
                          %mrow
                            %mi k
                          %mrow
                            %mi l
                        %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                        %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                        %mfrac{:linethickness => "0"}
                          %mrow
                            %mi j
                          %mrow
                            %mi l
                        %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                    %mspace{:width => "thinmathspace"}
                    %msubsup
                      %mi δ
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi b
                          %mn 1
                        %mi ⋯
                        %msub
                          %mi b
                          %mi l
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi a
                          %mn 1
                        %mi ⋯
                        %msub
                          %mi a
                          %mi l
                    %msub
                      %munder
                        %mrow
                          %msup
                            %mi Γ
                            %mrow
                              %msub
                                %mi a
                                %mi j
                              %mi ⋯
                              %msub
                                %mi a
                                %mrow
                                  %mi l
                                  %mo +
                                  %mn 1
                              %mo{:stretchy => "false"} ]
                          %msub
                            %mi Γ
                            %mrow
                              %msub
                                %mi b
                                %mrow
                                  %mi l
                                  %mo +
                                  %mn 1
                              %mi ⋯
                              %msub
                                %mi b
                                %mi k
                              %mo{:stretchy => "false"} ]
                        %mo ⏟
                      %mrow
                        %msup
                          %mi Γ
                          %mrow
                            %msub
                              %mi a
                              %mi j
                            %mi ⋯
                            %msub
                              %mi a
                              %mrow
                                %mi l
                                %mo +
                                %mn 1
                            %mo{:stretchy => "false"} ]
                        %msub
                          %mrow
                          %mrow
                            %msub
                              %mi b
                              %mrow
                                %mi j
                                %mo +
                                %mi l
                            %mi ⋯
                            %msub
                              %mi b
                              %mi k
                            %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma^{a_j \cdots a_1}
                    \\Gamma_{b_1 \cdots b_k}
                    \\;=\;
                    (-1)^{(j-1) \cdots (j-l)}
                    \\underbrace{
                    \\frac{
                    j \cdots (j-l)
                    \\,
                    k \cdots (k-l)
                    }{l!}
                    }_{
                    l!
                    \\Big(
                    { k \atop l }
                    \\Big)
                    \\Big(
                    { j \atop l }
                    \\Big)
                    }
                    \\,
                    \\delta
                    ^{[a_1 \cdots a_l}
                    _{[b_1 \cdots b_l}
                    \\underbrace{
                    \\Gamma^{a_j \cdots a_{l+1}]}
                    \\Gamma_{b_{l+1} \cdots b_{k}]}
                    }_{
                    \\Gamma
                    ^{ a_j \cdots a_{l+1}] }
                    {}_{ b_{j + l} \cdots b_k] }
                    }
            %p
              Under the brace on the far right we use that by assumption no further contraction is possible. With the subsitution under the brace made, the right hand side can just as well be summed over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi l
                    %annotation{:encoding => "application/x-tex"} l
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi l
                      %mspace{:width => "thinmathspace"}
                      %mo ≠
                      %mspace{:width => "thinmathspace"}
                      %mi{:mathvariant => "normal"} card
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} l \,\neq\, \mathrm{card}(C)
          %p
          #ExpandingEndomorphismOf32InCliffordElements.num_prop
            %h6 Proposition
            %p
              Every
              = succeed "-linear" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mn 32
                  %annotation{:encoding => "application/x-tex"} \mathbf{32}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi{:mathvariant => "normal"} End
                      %mi ℝ
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mn 32
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    M
                    \\;\in\;
                    \\mathrm{End}_{\mathbb{R}}(\mathbf{32})
              may be expanded as:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mn 32
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi p
                        %mo =
                        %mn 0
                      %mn 5
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                        %msup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mi p
                            %mo{:stretchy => "false"} (
                            %mi p
                            %mo −
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} /
                            %mn 2
                      %mrow
                        %mi p
                        %mo !
                    %mi{:mathvariant => "normal"} Tr
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi ϕ
                    %mo ∘
                    %msub
                      %mi Γ
                      %mrow
                        %msub
