                    \\\
                    \&amp;  \;=\;
                    \-
                    \\mathrm{Re}\Big(
                    \\phi^\dagger
                    \\Gamma_0
                    \\Gamma^{-1}_0
                    \\big(\Gamma_{[a_1 \cdots a_p]}\big)^\dagger
                    \\Gamma_0
                    \\psi
                    \\Big)
                    \\\
                    \&amp; \;=\;
                    \-
                    (-1)^{p + p(p-1)/2}
                    \\mathrm{Re}\Big(
                    \\phi^\dagger
                    \\Gamma_0
                    \\Gamma_{[a_1 \cdots a_p]}
                    \\psi
                    \\Big)
                    \\\
                    \&amp;  \;=\;
                    \-(-1)^{p(p+1)/2}
                    \\big(
                    \\overline{\phi}
                    \\,\Gamma_{[a_1 \cdots a_p]}\,
                    \\psi
                    \\big)
                    \\;.
                    \\end{array}
