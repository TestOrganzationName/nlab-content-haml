                      %mn 1
                      %mo ,
                      %mi even
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (1,even)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e
              taking to be
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
