              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#RealStructureOnLinearRepresentation"}
              %a.existingWikiWord{:href => "/nlab/show/spin+representation"} spin representation
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℂ
                        %mi ν
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}^\nu
          .proof
            %h6#proof_3 Proof
            %p
              The conjugate linearity of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
              is clear, since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"} (-)^\ast
              is conjugate linear and
              %a.existingWikiWord{:href => "/nlab/show/matrix+multiplication"} matrix multiplication
              is complex linear.
            %p
              To see that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
              squares to +1 in the given dimensions: Applying it twice yields,
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msup
                              %mi J
                              %mn 2
                            %mi ψ
                          %mtd
                            %mo =
                            %mi C
                            %msubsup
                              %mi Γ
                              %mn 0
                              %mi T
                            %mo{:stretchy => "false"} (
                            %mi C
                            %msubsup
                              %mi Γ
                              %mn 0
                              %mi T
                            %msup
                              %mi ψ
                              %mo *
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo *
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi C
                            %msubsup
                              %mi Γ
                              %mn 0
                              %mi T
                            %mi C
                            %msubsup
                              %mi Γ
                              %mn 0
                              %mo †
                            %mi ψ
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi C
                            %munder
                              %munder
                                %mrow
                                  %msubsup
                                    %mi Γ
                                    %mn 0
                                    %mi T
                                  %mi C
                                %mo ⏟
                              %mrow
                                %mo =
                                %mo ±
                                %mi C
                                %msub
                                  %mi Γ
                                  %mn 0
                            %msub
                              %mi Γ
                              %mn 0
                            %mi ψ
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo ±
                            %msubsup
                              %mi C
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mo ±
                                %mo{:stretchy => "false"} )
                              %mn 2
                            %msubsup
                              %mi Γ
                              %mn 0
                              %mn 2
                            %mi ψ
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo ±
                            %msubsup
                              %mi C
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mo ±
                                %mo{:stretchy => "false"} )
                              %mn 2
                            %mi ψ
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    J^2 \psi &amp;=
                    C \Gamma_0^T (C \Gamma_0^T\psi^\ast)^\ast
                    \\\
                    \&amp; =
                    C \Gamma_0^T C \Gamma_0^\dagger \psi
                    \\\
                    \&amp;=
                    C \underset{= \pm C \Gamma_0}{\underbrace{\Gamma_0^T C}} \Gamma_0 \psi
                    \\\
                    \&amp; = \pm C_{(\pm)}^2 \Gamma_0^2 \psi
                    \\\
                    \&amp; = \pm C_{(\pm)}^2 \psi
                    \\end{aligned}
                    \\,,
            %p
              where we used
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Γ
                      %mn 0
                      %mo †
                    %mo =
                    %msub
                      %mi Γ
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \Gamma_0^\dagger = \Gamma_0
              from prop.
              = succeed "," do
                %a.maruku-ref{:href => "#CliffordAlgebraRepresentation"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                    %mo =
                    %mo *
                  %annotation{:encoding => "application/x-tex"} C^\ast = \ast
              from prop.
              %a.maruku-ref{:href => "#ChargeConjugationMatrix"}
              and then the defining equation of the
              %a.existingWikiWord{:href => "/nlab/show/charge+conjugation+matrix"} charge conjugation matrix
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Γ
                      %mi a
                      %mi T
                    %msub
                      %mi C
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo ±
                        %mo{:stretchy => "false"} )
                    %mo =
                    %mo ±
                    %msub
                      %mi C
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo ±
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi Γ
                      %mi a
                  %annotation{:encoding => "application/x-tex"} \Gamma_a^T C_{(\pm)} = \pm C_{(\pm)} \Gamma_a
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#ChargeConjugationMatrix"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Γ
                        %mn 0
                        %mn 2
                      %mo =
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} \Gamma_0^2 = +1
            %p
              Hence this holds whenever there exists a choice
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo ±
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C_{(\pm)}
              for the charge conjugation matrix with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi C
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo ±
                          %mo{:stretchy => "false"} )
                        %mn 2
                      %mo =
                      %mo ±
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} C_{(\pm)}^2 = \pm 1
              %a.maruku-ref{:href => "#ChargeConjugationMatrix"}
              shows that this is the case in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo =
                      %mn 4
                      %mo ,
                      %mn 8
                      %mo ,
                      %mn 9
                      %mo ,
                      %mn 10
                      %mo ,
                      %mn 11
                    %annotation{:encoding => "application/x-tex"} d = 4,8,9,10,11
            %p
              Finally to see that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
              is spin-invariant (in
              %a{:href => "#CastellaniDAuriaFre"} Castellani-D’Auria-Fré
              this is essentially (II.2.29)), it is sufficient to show for distinct indices
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ,
                      %mi b
                    %annotation{:encoding => "application/x-tex"} a,b
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Γ
                      %mi a
                    %msub
                      %mi Γ
                      %mi b
                    %mi ψ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi Γ
                      %mi a
                    %msub
                      %mi Γ
                      %mi b
                    %mi J
                    %mo{:stretchy => "false"} (
                    %mi ψ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    J(\Gamma_a \Gamma_b \psi)
                    \=
                    \\Gamma_a \Gamma_b J(\psi)
                    \\,.
            %p
              First let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ,
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a,b
              both be spatial. Then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi J
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Γ
                              %mi a
                            %msub
                              %mi Γ
                              %mi b
                            %mi ψ
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mi C
                            %msubsup
                              %mi Γ
                              %mn 0
                              %mi T
                            %msubsup
                              %mi Γ
                              %mi a
                              %mo *
                            %msubsup
                              %mi Γ
                              %mi b
                              %mo *
                            %msup
                              %mi ψ
                              %mo *
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi C
                            %msubsup
                              %mi Γ
                              %mn 0
                              %mi T
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msubsup
                              %mi Γ
                              %mi a
                              %mi T
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msubsup
                              %mi Γ
                              %mi b
                              %mi T
                            %mo{:stretchy => "false"} )
                            %msup
                              %mi ψ
                              %mo *
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi C
                            %msubsup
                              %mi Γ
                              %mn 0
                              %mi T
                            %msubsup
                              %mi Γ
                              %mi a
                              %mi T
                            %msubsup
                              %mi Γ
                              %mi b
                              %mi T
                            %msup
                              %mi ψ
                              %mo *
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi C
                            %msubsup
                              %mi Γ
                              %mi a
                              %mi T
                            %msubsup
                              %mi Γ
                              %mi b
                              %mi T
                            %msubsup
                              %mi Γ
                              %mn 0
                              %mi T
                            %msup
                              %mi ψ
                              %mo *
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi Γ
                              %mi a
                            %msub
                              %mi Γ
                              %mi b
                            %mi C
                            %msubsup
                              %mi Γ
                              %mn 0
                              %mi T
                            %msup
                              %mi ψ
                              %mo *
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi Γ
                              %mi a
                            %msub
                              %mi Γ
                              %mi b
                            %mi J
                            %mo{:stretchy => "false"} (
                            %mi ψ
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    J(\Gamma_a \Gamma_b \psi)
                    \&amp; =
                    C \Gamma_0^T \Gamma_a^\ast \Gamma_b^\ast \psi^\ast
                    \\\
                    \&amp; =
                    C \Gamma_0^T (-\Gamma_a^T)(-\Gamma_b^T) \psi^\ast
                    \\\
                    \&amp; =
                    C \Gamma_0^T \Gamma_a^T \Gamma_b^T \psi^\ast
                    \\\
                    \&amp; =
                    C  \Gamma_a^T \Gamma_b^T \Gamma_0^T \psi^\ast
                    \\\
                    \&amp; =
                    \\Gamma_a \Gamma_b C \Gamma_0^T \psi^\ast
                    \\\
                    \&amp; =
                    \\Gamma_a \Gamma_b J(\psi)
                    \\end{aligned}
                    \\,.
            %p
              Here we first used that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Γ
                      %mi spatial
                      %mo †
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mi Γ
                      %mi spatial
                  %annotation{:encoding => "application/x-tex"} \Gamma_{spatial}^\dagger = -\Gamma_{spatial}
              (prop.
              = succeed ")," do
                %a.maruku-ref{:href => "#CliffordAlgebraRepresentation"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Γ
                      %mi spatial
                      %mo *
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msubsup
                      %mi Γ
                      %mi spatial
                      %mi T
                  %annotation{:encoding => "application/x-tex"} \Gamma_{spatial}^\ast = - \Gamma_{spatial}^T
              and then that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \Gamma_0
              anti-commutes with the spatial Clifford matrices, hence that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Γ
                      %mn 0
                      %mi T
                  %annotation{:encoding => "application/x-tex"} \Gamma_0^T
              anti-commutes the the transposeso fthe spatial Clifford matrices. Then we used the defining equation for the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/charge+conjugation+matrix"} charge conjugation matrix
            %p
              Finally, that the same conclusion holds for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mi spatial
                    %msub
                      %mi Γ
                      %mi spatial
                  %annotation{:encoding => "application/x-tex"} \Gamma_{spatial} \Gamma_{spatial}
              replaced by
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Γ
                        %mn 0
                      %msub
                        %mi Γ
                        %mi spatial
                    %annotation{:encoding => "application/x-tex"} \Gamma_0 \Gamma_{spatial}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \Gamma_0
              commutes with itself, one from the fact that it is hermitian, by prop.
              = succeed "." do
                %a.maruku-ref{:href => "#CliffordAlgebraRepresentation"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi J
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Γ
                              %mn 0
                            %msub
                              %mi Γ
                              %mi a
                            %mi ψ
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mi C
                            %msubsup
                              %mi Γ
                              %mn 0
                              %mi T
                            %msubsup
                              %mi Γ
                              %mn 0
                              %mo *
                            %msubsup
                              %mi Γ
                              %mi a
                              %mo *
                            %msup
                              %mi ψ
                              %mo *
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi C
                            %msubsup
                              %mi Γ
                              %mn 0
                              %mi T
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                            %msubsup
                              %mi Γ
                              %mn 0
                              %mi T
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msubsup
                              %mi Γ
                              %mi a
                              %mi T
                            %mo{:stretchy => "false"} )
                            %msup
