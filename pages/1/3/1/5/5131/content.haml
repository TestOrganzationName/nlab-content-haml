          %h2#idea Idea
          %p
            This page describes aspects of the
            %a.existingWikiWord{:href => "/nlab/show/combinatorics"} combinatorics
            of
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+products"} Cartesian products
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
            = succeed ")" do
              %a.maruku-ref{:href => "#NonDegenerateSimplicesInProductOfSimplices"}
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mi p
                  %mo{:stretchy => "false"} ]
                  %mo ×
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mi q
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \Delta[p] \times \Delta[q]
            of basic
            %a.existingWikiWord{:href => "/nlab/show/n-simplices"} n-simplices
            for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mi p
                    %mo ,
                    %mi q
                  %annotation{:encoding => "application/x-tex"} n = p,q
            = succeed "-(un-)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (p,q)
            %a.existingWikiWord{:href => "/nlab/show/shuffles"} shuffles
            in a manner that for
            %a.existingWikiWord{:href => "/nlab/show/simplicial+abelian+groups"} simplicial abelian groups
            is originally known from the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Eilenberg-Zilber+map"} Eilenberg-Zilber map
          %h2#ProductsOfSimplicialSets Products of simplicial sets
          %p
          #CartesianProductOfSimplicialSetsIsComponentwise.num_prop
            %h6 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/cartesian+product"} cartesian product
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
              %br/
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ,
                    %mi L
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} K, L \,\in\,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/SimplicialSets"} SimplicialSets
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ×
                    %mi L
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi SimplicialSets
                  %annotation{:encoding => "application/x-tex"}
                    K \times L
                    \\;\in\;
                    SimplicialSets
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
              whose
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              is the
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
              of
              %a.existingWikiWord{:href => "/nlab/show/Sets"} Sets
              of the components of the two factors
            #eq:ComponentSetsOfProductSimplicialSet.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo ×
                    %mi L
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi k
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi K
                      %mi k
                    %mo ×
                    %msub
                      %mi L
                      %mi k
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    (K\times L)_k
                    \\;=\;
                    K_k \times L_k
                    \\,,
            %p
              and whose face- and degeneracy maps are, similarly, the image under the Cartesian product-
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              of the face- and degeneracy maps of the factors:
            #eq:StructureMapsOfProductSimpliciaSet.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi d
                      %mi i
                      %mrow
                        %mi K
                        %mo ×
                        %mi L
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msubsup
                      %mi d
                      %mi i
                      %mi K
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %msubsup
                      %mi d
                      %mi i
                      %mi L
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi s
                      %mi i
                      %mrow
                        %mi K
                        %mo ×
                        %mi L
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msubsup
                      %mi s
                      %mi i
                      %mi K
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %msubsup
                      %mi s
                      %mi i
                      %mi L
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    d^{K \times L}_i(x,y)
                    \\;=\;
                    \\big(
                    d^K_i(x), \, d^L_i(y)
                    \\big)
                    \\,,
                    \\;\;\;\;\;
                    s^{K \times L}_i(x,y)
                    \\;=\;
                    \\big(
                    s^K_i(x), \, s^L_i(y)
                    \\big)
            %p
          .proof
            %h6 Proof
            %p
              %br>/
              Since
              %a.existingWikiWord{:href => "/nlab/show/SimplicialSets"} SimplicialSets
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/category+of+presheaves"} category of presheaves
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/simplex+category"} simplex category
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/limits+of+presheaves+are+computed+objectwise"} limits of presheaves are computed objectwise
            %p
              But it is also immediate to check that
              %a.maruku-eqref{:href => "#eq:StructureMapsOfProductSimpliciaSet"} (2)
              with
              %a.maruku-eqref{:href => "#eq:ComponentSetsOfProductSimplicialSet"} (1)
              satisfies the defining
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
          %p
          #DegenerateSimplicesInProductOfSimplicialSets.num_remark
            %h6 Remark
            %p
              %strong (degenerate simplices in product of simplicial sets)
              Prop.
              %a.maruku-ref{:href => "#CartesianProductOfSimplicialSetsIsComponentwise"}
              means in particular that a
              %a.existingWikiWord{:href => "/nlab/show/simplex"} simplex
              of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi s
                      %mi α
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi s
                      %mi β
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mi K
                    %mo ×
                    %mi L
                  %annotation{:encoding => "application/x-tex"} \big(s_\alpha(x),\, s_\beta(y)\big) \,\in\, K \times L
              may be non-degenerate even though its two components are each degenerate (see the archetypical Example
              %a.maruku-ref{:href => "#NonDegenerateSimplicesInSimplicialSquare"}
              below).
            %p
              Indeed, the proposition says that the degenerate simplices in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ×
                    %mi L
                  %annotation{:encoding => "application/x-tex"} K \times L
              are precisely those such that their two simplex-components in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                    %annotation{:encoding => "application/x-tex"} L
              %em same
              degeneracy map
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                      %mo =
                      %mi β
                    %annotation{:encoding => "application/x-tex"} \alpha = \beta
          %h2#NonDegenerateCellsInAProductOfSimplices Non-degenerate cells in a product of simplices
          %p
            Using the
            %a{:href => "#ProductsOfSimplicialSets"} above
            basic facts about products of simplicial sets, we have the following explicit characterization of the non-degenerated cells in products
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mi p
                  %mo{:stretchy => "false"} ]
                  %mo ×
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mi q
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \Delta[p] \times \Delta[q]
            of the basic
            %a.existingWikiWord{:href => "/nlab/show/simplices"} simplices
            (the simplicial sets
            %a.existingWikiWord{:href => "/nlab/show/representable+functor"} represented
            by the objects in the
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/simplex+category"} simplex category
          %h3#Characterization Characterization
          %p
          #NonDegenerateSimplicesInProductOfSimplices.num_prop
            %h6 Proposition
            %p
              %strong
                (non-degenerate
                = succeed "-simplices" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo +
                        %mi q
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (p+q)
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mi p
                        %mo{:stretchy => "false"} ]
                        %mo ×
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mi q
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} \Delta[p] \times \Delta[q]
              %br/
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ,
                      %mi q
                      %mspace{:width => "thinmathspace"}
                      %mo ∈
                      %mspace{:width => "thinmathspace"}
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} p,q \,\in\, \mathbb{N}
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
              (Prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#CartesianProductOfSimplicialSetsIsComponentwise"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi p
                    %mo{:stretchy => "false"} ]
                    %mo ×
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi q
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\Delta[p] \times \Delta[q]
            %p
              of standard
              %a.existingWikiWord{:href => "/nlab/show/simplices"} simplices
              in
              %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              correspond, under the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              of
              %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
            #eq:GenericSimplexInProductOfSimplices.maruku-equation
              %span.maruku-eq-number (3)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi p
                    %mo +
                    %mi q
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo →
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mi σ
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi p
                    %mo{:stretchy => "false"} ]
                    %mo ×
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi q
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\Delta[p+q]
                    \\xrightarrow{\;\; \sigma \;\;}
                    \\Delta[p] \times \Delta[q]
            %p which satisfy the following equivalent conditions:
            %ul
              %li
                %p
                  as morphisms of
                  %a.existingWikiWord{:href => "/nlab/show/posets"} posets
                  they are
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/strictly+monotone"} strictly monotone
              %li
                %p
                  as
                  %a.existingWikiWord{:href => "/nlab/show/permutations"} permutations
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo +
                        %mi q
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (p+q)
                  elements they are
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi p
                          %mo ,
                          %mi q
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (p,q)
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/shuffles"} shuffles
              %li
                %p
                  as morphisms of
                  %a.existingWikiWord{:href => "/nlab/show/finitely+generated+object"} finitely generated
                  %a.existingWikiWord{:href => "/nlab/show/categories"} categories
                  they take generating morphisms to generating morphisms;
            %p
          %p
            (e.g.
            = succeed ":" do
              %a{:href => "#Kerodon"} Kerodon 2.5.7.2
            = succeed ")" do
              %a{:href => "https://kerodon.net/tag/00RH"} 00RH
          %p
            Here the first statement says that such morphisms may hence be represented by
            %a.existingWikiWord{:href => "/nlab/show/paths"} paths
          %ul
            %li
              %p
                on a
                = succeed "-lattice," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo +
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo ×
                        %mo{:stretchy => "false"} (
                        %mi q
                        %mo +
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (p+1)\times(q+1)
            %li
              %p from one corner to its opposite corner,
            %li
              %p
                consisting of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo +
                      %mi q
                    %annotation{:encoding => "application/x-tex"} p+q
                unit steps,
            %li
              %p each either horizontally or vertically
          %p
