              %path{:d => "M -2.485165 2.86766 C -2.031466 1.146732 -1.018465 0.333202 -0.00155262 0.000749983 C -1.018465 -0.335613 -2.031466 -1.149143 -2.485165 -2.870071 ", :style => "fill:none;stroke-width:0.47818;stroke-linecap:round;stroke-linejoin:round;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(0.998734,0,0,-0.998734,312.470301,244.465593)"}
          %p
          .proof
            %h6 Proof
            %p
              From Prop.
              %a.maruku-ref{:href => "#CartesianProductOfSimplicialSetsIsComponentwise"}
              it is clear (Rem.
              = succeed ")" do
                %a.maruku-ref{:href => "#DegenerateSimplicesInProductOfSimplicialSets"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
              %a.maruku-eqref{:href => "#eq:GenericSimplexInProductOfSimplices"} (3)
              is degenerate precisely if, when regarded as a path as above, it contains a
              %a.existingWikiWord{:href => "/nlab/show/constant+function"} constant
              step, i.e. one which moves neither horizontally nor vertically. But then – by degree reasons, since we are looking at paths of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo +
                    %mi q
                  %annotation{:encoding => "application/x-tex"} p + q
              steps in a lattice of side length
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
              – it must be that the path proceeds by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo +
                    %mi q
                  %annotation{:encoding => "application/x-tex"} p + q
              unit steps.
          %p
          #NotationForSimplicesInAProductOfSimplices.num_remark
            %h6 Remark
            %p
              %strong (sequence- and shuffle-notation for simplices in a product of simplices)
              %br/
              Written as a
              %a.existingWikiWord{:href => "/nlab/show/pair"} pair
              of
              = succeed "-simplices," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo +
                      %mi q
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (p+q)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi p
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \Delta[p]
              and one in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mi q
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \Delta[q]
              %a.maruku-eqref{:href => "#eq:GenericSimplexInProductOfSimplices"} (3)
              is hence a
              %a.existingWikiWord{:href => "/nlab/show/pair"} pair
              of
              %a.existingWikiWord{:href => "/nlab/show/monotone"} monotone
              lists of
              %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} natural numbers
            #eq:ListNotationForProductsOfSimplices.maruku-equation
              %span.maruku-eq-number (4)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mtable{:columnalign => "center center center center center center center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %mi …
                          %mtd
                            %mn 0
                          %mtd
                            %mn 1
                          %mtd
                            %mi …
                          %mtd
                            %mn 1
                          %mtd
                            %mn 2
                          %mtd
                            %mi …
                          %mtd
                            %mi p
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %mi …
                          %mtd
                            %mi i
                          %mtd
                            %mi i
                          %mtd
                            %mi …
                          %mtd
                            %mi j
                          %mtd
                            %mi j
                          %mtd
                            %mi …
                          %mtd
                            %mi q
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    \\begin{array}{ccccccccc}
                    0&amp; \ldots &amp; 0 &amp; 1 &amp; \ldots &amp; 1 &amp; 2 &amp; \ldots &amp; p
                    \\\
                    0&amp; \ldots &amp; i &amp; i &amp; \ldots &amp; j &amp; j &amp; \ldots &amp; q
                    \\end{array}
                    \\right)
                    \\,,
            %p such that one row has a constant step precisely where the other has not.
            %p
              Recording the step numbers where either of these lists is non-constant yields a
              = succeed ":" do
                %em
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo ,
                        %mi q
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (p,q)
                  \-
                  %a.existingWikiWord{:href => "/nlab/show/shuffle"} shuffle
            #eq:ShuffleNotationForProductsOfSimplices.maruku-equation
              %span.maruku-eq-number (5)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mtext positions of horizontal steps
                        %mtd
                          %mtext positions of vertical steps
                      %mtr
                        %mtd
                          %msub
                            %mi μ
                            %mn 1
                          %mo &lt;
                          %msub
                            %mi μ
                            %mn 2
                          %mo &lt;
                          %mi ⋯
                          %mo &lt;
                          %msub
                            %mi μ
                            %mi p
                        %mtd
                          %msub
                            %mi ν
                            %mn 1
                          %mo &lt;
                          %msub
                            %mi ν
                            %mn 2
                          %mo &lt;
                          %mi ⋯
                          %mo &lt;
                          %msub
                            %mi ν
                            %mi p
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{cc}
                    \\text{positions of horizontal steps}
                    \&amp;
                    \\text{positions of vertical steps}
                    \\\
                    \\mu_1 \lt \mu_2 \lt \cdots \lt \mu_p
                    \&amp;
                    \\nu_1 \lt \nu_2 \lt \cdots \lt \nu_p
                    \\end{array}
            %p
              namely a
              %a.existingWikiWord{:href => "/nlab/show/permutation"} permutation
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo +
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (p+q)
              elements where each element is larger than its left neighbour, except possibly when going from the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              = succeed "st" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo +
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} p+1
            %p
          %p The shuffle-data yields a conveniently explicit re-construction of the product of simplices, as follows:
          %p
          .num_defn
            %h6 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi μ
                      %mn 1
                    %mo &lt;
                    %msub
                      %mi μ
                      %mn 2
                    %mo &lt;
                    %mi ⋯
                    %mo &lt;
                    %msub
                      %mi μ
                      %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mu = (\mu_1 \lt  \mu_2 \lt \cdots \lt \mu_p)
              a sequence of
              %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} natural numbers
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mn 1
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %mi p
                      %mo +
                      %mi q
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{1, \cdots,  p+q\}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi σ
                      %mi μ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi X
                      %mi q
                    %mo →
                    %msub
                      %mi X
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                  %annotation{:encoding => "application/x-tex"}
                    \\sigma_\mu
                    \\;\colon\;
                    X_q \to X_{p+q}
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/composition"} composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi p
                    %mo +
                    %mi q
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo ⟶
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mi σ
                          %mrow
                            %msub
                              %mi μ
                              %mi q
                            %mo −
                            %mn 1
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %mi p
                    %mo +
                    %mi q
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ⟶
                    %mi ⋯
                    %mo ⟶
                    %mo{:stretchy => "false"} [
                    %mi q
                    %mo +
                    %mn 2
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo ⟶
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mi σ
                          %mrow
                            %msub
                              %mi μ
                              %mn 2
                            %mo −
                            %mn 1
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %mi q
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo ⟶
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mi σ
                          %mrow
                            %msub
                              %mi μ
                              %mn 1
                            %mo −
                            %mn 1
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %mi q
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    [p+q]
                    \\overset{\;\;
                    \\sigma_{\mu_q - 1 }
                    \\;\;}{\longrightarrow}
                    [p+q-1]
                    \\longrightarrow
                    \\cdots
                    \\longrightarrow
                    [q + 2]
                    \\overset{\;\;
                    \\sigma_{ \mu_{2} - 1 }
                    \\;\;}{\longrightarrow}
                    [q + 1]
                    \\overset{\;\;
                    \\sigma_{ \mu_1 - 1 }
                    \\;\;}{\longrightarrow}
                    [q]
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi σ
                      %mi i
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \sigma_i \,\colon\, [n+1] \to [n]
              denotes the
              %a.existingWikiWord{:href => "/nlab/show/surjective+map"} surjective
              %a.existingWikiWord{:href => "/nlab/show/monotone+map"} monotone map
              (the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/codegeneracy+map"} codegeneracy map
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
            %p
          %p
          .num_prop
            %h6 Proposition
            %p
              The non-degenerate simplices in the
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
              (Prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#CartesianProductOfSimplicialSetsIsComponentwise"}
            .maruku-equation
