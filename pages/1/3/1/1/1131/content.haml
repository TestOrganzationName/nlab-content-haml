                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
            = succeed "-ary" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo &gt;
                  %mn 2
                %annotation{:encoding => "application/x-tex"} n \gt 2
            are trivial. These may be thought of as the
            %em strict
            = succeed "-algebras:" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
            %a.existingWikiWord{:href => "/nlab/show/Jacobi+identity"} Jacobi identity
            holds on the nose and all its possible higher coherences are trivial.
          .num_theorem
            %h6#theorem Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              be a
              %a.existingWikiWord{:href => "/nlab/show/field"} field
              of
              %a.existingWikiWord{:href => "/nlab/show/characteristic"} characteristic
              0 and write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                    %msub
                      %mi Alg
                      %mi k
                  %annotation{:encoding => "application/x-tex"} L_\infty Alg_k
              for the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              of
              %a.existingWikiWord{:href => "/nlab/show/L-infinity+algebras"} L-infinity algebras
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
            %p
              Then every object of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                    %msub
                      %mi Alg
                      %mi k
                  %annotation{:encoding => "application/x-tex"} L_\infty Alg_k
              is
              %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphic
              to a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/dg-Lie+algebra"} dg-Lie algebra
            %p
              Moreover, one can find a functorial replacement: there is a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo :
                    %msub
                      %mi L
                      %mn ∞
                    %msub
                      %mi Alg
                      %mi k
                    %mo →
                    %msub
                      %mi L
                      %mn ∞
                    %msub
                      %mi Alg
                      %mi k
                  %annotation{:encoding => "application/x-tex"}
                    W : L_\infty Alg_k \to L_\infty Alg_k
            %p
              such that for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                    %mo ∈
                    %msub
                      %mi L
                      %mn ∞
                    %msub
                      %mi Alg
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g} \in L_\infty Alg_k
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi W
                        %mo{:stretchy => "false"} (
                        %mi 𝔨
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} W(\mathfrak{k})
                  is a
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/dg-Lie+algebra"} dg-Lie algebra
              %li
                %p
                  there is a
                  %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔤
                        %mover
                          %mo →
                          %mo ≃
                        %mi W
                        %mo{:stretchy => "false"} (
                        %mi 𝔤
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\mathfrak{g} \stackrel{\simeq}{\to}
                        W(\mathfrak{g})
                        \\,.
          %p
            This appears for instance as (
            %a{:href => "#KrizMay"}> KrizMay, cor. 1.6
            ).
          %p For more see at
          %ul
            %li
              %p
                %em
                  %a.existingWikiWord{:href => "/nlab/show/model+structure+on+dg-Lie+algebras"} model structure on dg-Lie algebras
                the section
                = succeed "." do
                  %em
                    %a{:href => "model+structure+on+dg-Lie+algebras#RectificationResolution"} Relation to L-infinity algebras
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/model+structure+for+L-infinity+algebras"}> model structure for L-infinity algebras
                , the section
                = succeed "." do
                  %em
                    %a{:href => "model+structure+for+L-infinity+algebras#OndgLieAlgebras"} on dg-Lie algebras
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/relation+between+L-%E2%88%9E+algebras+and+dg-Lie+algebras"} relation between L-∞ algebras and dg-Lie algebras
          %h3#relation_to_dgcoalgebras Relation to dg-coAlgebras
          %p
            Via the above relation to
            = succeed "-algebras," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
            %a.existingWikiWord{:href => "/nlab/show/dg-coalgebras"} dg-coalgebras
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi dgLieAlg
                    %mi k
                  %munderover
                    %mo ⊥
                    %munder
                      %mo ⟶
                      %mi CE
                    %mover
                      %mo ⟵
                      %mi ℒ
                  %msub
                    %mi dgCoAlg
                    %mi k
                %annotation{:encoding => "application/x-tex"}
                  dgLieAlg_k
                  \\underoverset
                  {\underset{CE}{\longrightarrow}}
                  {\overset{\mathcal{L}}{\longleftarrow}}
                  {\bot}
                  dgCoAlg_k
          %p Here
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi CE
                    %annotation{:encoding => "application/x-tex"} CE
                is the
                %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
                functor. It sends a dg-Lie algebra
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi 𝔤
                      %mo ,
                      %mo ∂
                      %mo ,
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\mathfrak{g}, \partial, [-,-])
                to
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi CE
                      %mo{:stretchy => "false"} (
                      %mi 𝔤
                      %mo ,
                      %mo ∂
                      %mo ,
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %mrow
                        %mo (
                        %msup
                          %mo ∨
                          %mo •
                        %mi 𝔤
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                        %mo ,
                        %mspace{:width => "thickmathspace"}
                        %mi D
                        %mo =
                        %mo ∂
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mo{:stretchy => "false"} [
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} ]
                        %mo )
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      CE(\mathfrak{g},\partial,[-,-])
                      \\;\coloneqq\;
                      \\left(
                      \\vee^\bullet \mathfrak{g}[1]
                      ,\;
                      D = \partial + [-,-]
                      \\right)
                      \\,,
              %p
                where on the right the extension of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∂
                    %annotation{:encoding => "application/x-tex"} \partial
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [-,-]
                to graded derivations is understood.
            %li
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi D
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,D)
                a dg-coalgebra, then
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℒ
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi D
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %mrow
                        %mo (
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mover
                          %mi X
                          %mo ¯
                        %mo{:stretchy => "false"} [
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mspace{:width => "thickmathspace"}
                        %mo ∂
                        %mo ≔
                        %mi D
                        %mo +
                        %mo{:stretchy => "false"} (
                        %mi Δ
                        %mo −
                        %mn 1
                        %mo ⊗
                        %mi id
                        %mo −
                        %mi id
                        %mo ⊗
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo )
                    %annotation{:encoding => "application/x-tex"}
                      \\mathcal{L}(X,D)
                      \\coloneqq
                      \\left(
                      F(\overline{X}[-1]),\;
                      \\partial \coloneqq D + (\Delta - 1 \otimes id - id \otimes 1)
                      \\right)
              %p where
              %ol
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mover
                            %mi X
                            %mo ¯
                          %mo ≔
                          %mi ker
                          %mo{:stretchy => "false"} (
                          %mi ϵ
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \overline{X} \coloneqq ker(\epsilon)
                    is the
                    %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
                    of the
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/counit"} counit
                    = succeed ";" do
                      %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi F
                        %annotation{:encoding => "application/x-tex"} F
                    is the
                    %a.existingWikiWord{:href => "/nlab/show/free+Lie+algebra"} free Lie algebra
                    functor (as graded Lie algebras);
                %li
                  %p
                    on the right we are extending
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi Δ
                          %mo −
                          %mn 1
                          %mo ⊗
                          %mi id
                          %mo −
                          %mi id
                          %mo ⊗
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo{:lspace => "verythinmathspace"} :
                          %mover
                            %mi X
                            %mo ¯
                          %mo →
                          %mover
                            %mi X
                            %mo ¯
                          %mo ⊗
                          %mover
                            %mi X
                            %mo ¯
                        %annotation{:encoding => "application/x-tex"} (\Delta - 1 \otimes id - id \otimes 1) \colon \overline{X} \to \overline{X} \otimes \overline{X}
                    as a Lie algebra
                    %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
          %p Moreover
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Hom
                  %mo{:stretchy => "false"} (
                  %mi ℒ
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi Hom
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi MC
                  %mo{:stretchy => "false"} (
                  %mi Hom
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi X
                    %mo ¯
                  %mo ,
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  Hom(\mathcal{L}(X), \mathfrak{g})
                  \\simeq
                  Hom(X, CE(\mathfrak{g}))
                  \\simeq
                  MC(Hom(\overline{X},\mathfrak{g}))
          %p
            is the
            %a.existingWikiWord{:href => "/nlab/show/Maurer-Cartan+elements"} Maurer-Cartan elements
            in the Hom-dgLie algebra from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi X
                    %mo ¯
                %annotation{:encoding => "application/x-tex"} \overline{X}
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
          %p
            For dg-Lie algebras concentrated in degrees
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≥
                  %mi n
                  %mo ≥
                  %mn 1
                %annotation{:encoding => "application/x-tex"} \geq n \geq 1
            this is due to (
            %a{:href => "#Quillen"}> Quillen 69, appendix B, prop 6.1, 6.2
            ). For unbounded dg-algebras, this is due to (
            %a{:href => "#Hinich98"}> Hinich 98, 2.2
            ).
          %p
            For more see at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+dg-Lie+algebras"} model structure on dg-Lie algebras
          %h3#relation_to_simplicial_lie_algebras Relation to simplicial Lie algebras
          .num_theorem
            %h6#theorem_2 Theorem
            %p
              There is an
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi N
                      %mo *
                    %mo ⊣
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msup
                      %mi LieAlg
                      %mi Δ
                    %mover
                      %munder
                        %mo →
                        %mi N
                      %mover
                        %mo ←
                        %mrow
                          %msup
                            %mi N
                            %mo *
                    %mi dgLieAlg
                  %annotation{:encoding => "application/x-tex"}
                    (N^* \dashv N) : LieAlg^\Delta \stackrel{\overset{N^*}{\leftarrow}}{\underset{N}{\to}}
                    dgLieAlg
            %p
              between
              %a.existingWikiWord{:href => "/nlab/show/simplicial+Lie+algebras"} simplicial Lie algebras
              and
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/dg-Lie+algebra"} dg-Lie algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              acts on the underlying simplicial vector spaces as the
              %a.existingWikiWord{:href => "/nlab/show/Moore+complex"} Moore complex
              functor.
          %p
            This is (
            %a{:href => "#Quillen"}> Quillen, prop. 4.4
            ). For more see at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/simplicial+Lie+algebra"} simplicial Lie algebra
          .num_theorem
            %h6#theorem_3 Theorem
            %p
              This adjunction is a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
              with respect to the projective
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+dg-Lie+algebras"} model structure on dg-Lie algebras
              and the projective
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+Lie+algebras"} model structure on simplicial Lie algebras
              (
              %a{:href => "model+structure+on+simplicial+Lie+algebras#QuillenAdjunctionTodgLieAlgebras"}> this prop.
              ).
            %p
              The corresponding
              %a.existingWikiWord{:href => "/nlab/show/derived+functors"} derived functors
              constitute an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
              between the corresponding
              %a.existingWikiWord{:href => "/nlab/show/homotopy+categories"} homotopy categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi L
                    %msup
                      %mi N
                      %mo *
                    %mo ⊣
                    %mover
                      %mi N
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi LieAlg
                      %mi Δ
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 1
                    %mover
                      %munder
                        %mo →
                        %mover
                          %mi N
                          %mo{:stretchy => "false"} ˜
                      %mover
                        %mo ←
                        %mrow
                          %mi L
                          %msup
                            %mi N
                            %mo *
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi dgLieAlg
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    (L N^* \dashv \tilde N)
                    \:
                    Ho(LieAlg^\Delta)_1
                    \\stackrel{\overset{L N^*}{\leftarrow}}{\underset{\tilde N}{\to}} Ho(dgLieAlg)_1
            %p
              of
              %a.existingWikiWord{:href => "/nlab/show/1-connected"} 1-connected
              objects on both sides.
          %p
            This is in the proof of (
            %a{:href => "#Quillen"}> Quillen, theorem. 4.4
            ).
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/crossed+complex"} crossed complex
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⇐
                    %annotation{:encoding => "application/x-tex"} \Leftarrow
                %a.existingWikiWord{:href => "/nlab/show/crossed+module"} crossed module
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⇒
                    %annotation{:encoding => "application/x-tex"} \Rightarrow
                %a.existingWikiWord{:href => "/nlab/show/2-crossed+module"} 2-crossed module
            %li
              %p
                %strong dg-Lie algebra
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⇐
                    %annotation{:encoding => "application/x-tex"} \Leftarrow
                %a.existingWikiWord{:href => "/nlab/show/differential+crossed+module"} differential crossed module
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⇒
                    %annotation{:encoding => "application/x-tex"} \Rightarrow
                %a.existingWikiWord{:href => "/nlab/show/differential+2-crossed+module"} differential 2-crossed module
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra"} L-∞ algebra
              %ul
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/model+structure+for+L-%E2%88%9E+algebras"} model structure for L-∞ algebras
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/sheaf+of+L-%E2%88%9E+algebras"} sheaf of L-∞ algebras
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/formal+moduli+problem"}> formal moduli problem
                ,
                %a.existingWikiWord{:href => "/nlab/show/deformation+theory"} deformation theory
          %h2#references References
          %p
            A standard reference in the context of
            %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+theory"} rational homotopy theory
            is
          %ul
            %li#Quillen
              %a.existingWikiWord{:href => "/nlab/show/Dan+Quillen"}> Dan Quillen
              ,
              = succeed "," do
                %em Rational homotopy theory
              = succeed ")" do
                %a{:href => "http://www.jstor.org/stable/1970725"} JSTOR
          %p For the unbounded case there is general discussion in
          %ul
            %li#Hinich97
              %a.existingWikiWord{:href => "/nlab/show/Vladimir+Hinich"}> Vladimir Hinich
              ,
              = succeed "," do
                %em Homological algebra of homotopy algebras
              = succeed "," do
                %a{:href => "http://arxiv.org/abs/q-alg/9702015"} arXiv:q-alg/9702015
              %em Erratum
              (
              %a{:href => "http://arxiv.org/abs/math/0309453"}> arXiv:math/0309453
              ))
          %p
            The relation to
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
          %ul
            %li#KrizMay
              %a.existingWikiWord{:href => "/nlab/show/Igor+Kriz"}> Igor Kriz
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Peter+May"} Peter May
              %em Operads, algebras, modules and motives
              (
              %a{:href => "http://www.math.uchicago.edu/~may/PAPERS/kmbooklatex.pdf"}> pdf
              )
          %p
            See also the references at
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+dg-Lie+algebras"} model structure on dg-Lie algebras
          %p
            A discussion of how formal neighbourhoods of points in
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/infinity-stack"} infinity-stack
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              ,
              %em
                %a.existingWikiWord{:href => "/nlab/show/Moduli+Problems+and+DG-Lie+Algebras"} Moduli Problems and DG-Lie Algebras
          %p Classification in the case of vanishing differential:
          %ul
            %li
              Mark D. Gould, Phillip S. Isaac, Ian Marquette, Jorgen Rasmussen:
              %em
                Finite-dimensional
