              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi BMod
                  %annotation{:encoding => "application/x-tex"} BMod
              for the
              %a.existingWikiWord{:href => "/nlab/show/colored+operad"} colored
              %a.existingWikiWord{:href => "/nlab/show/symmetric+operad"} symmetric operad
              whose
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                  are three elements, to be denoted
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝔞
                          %mo −
                        %mo ,
                        %msub
                          %mi 𝔞
                          %mo +
                      %annotation{:encoding => "application/x-tex"} \mathfrak{a}_-, \mathfrak{a}_+
                  and
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝔫
                        %annotation{:encoding => "application/x-tex"} \mathfrak{n}
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/multimorphisms"} multimorphisms
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi X
                          %mi i
                        %msubsup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mi i
                            %mo =
                            %mn 1
                          %mi n
                        %mo →
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} (X_i)_{i = 1}^n \to Y
                  form
                %ul
                  %li
                    %p
                      if
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi Y
                            %mo =
                            %msub
                              %mi 𝔞
                              %mo −
                          %annotation{:encoding => "application/x-tex"} Y = \mathfrak{a}_-
                      and all
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi X
                              %mi i
                            %mo =
                            %msub
                              %mi 𝔞
                              %mo −
                          %annotation{:encoding => "application/x-tex"} X_i = \mathfrak{a}_-
                      then: the set of
                      %a.existingWikiWord{:href => "/nlab/show/linear+orders"} linear orders
                      of
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi n
                          %annotation{:encoding => "application/x-tex"} n
                      elements;
                  %li
                    %p
                      if
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi Y
                            %mo =
                            %msub
                              %mi 𝔞
                              %mo *
                          %annotation{:encoding => "application/x-tex"} Y = \mathfrak{a}_*
                      and all
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi X
                              %mi i
                            %mo =
                            %msub
                              %mi 𝔞
                              %mo *
                          %annotation{:encoding => "application/x-tex"} X_i = \mathfrak{a}_*
                      then again: the set of
                      %a.existingWikiWord{:href => "/nlab/show/linear+orders"} linear orders
                      of
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi n
                          %annotation{:encoding => "application/x-tex"} n
                      elements;
                  %li
                    %p
                      if
                      = succeed ":" do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi Y
                              %mo =
                              %mi 𝔫
                            %annotation{:encoding => "application/x-tex"} Y = \mathfrak{n}
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} {
                            %msub
                              %mi i
                              %mn 1
                            %mo &lt;
                            %mi ⋯
                            %mo &lt;
                            %msub
                              %mi i
                              %mi n
                            %mo{:stretchy => "false"} }
                          %annotation{:encoding => "application/x-tex"} \{i_1 \lt \cdots \lt i_n\}
                      such that there is exactly one index
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi i
                              %mi k
                          %annotation{:encoding => "application/x-tex"} i_k
                      with
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi X
                              %mrow
                                %msub
                                  %mi i
                                  %mi k
                            %mo =
                            %mi 𝔫
                          %annotation{:encoding => "application/x-tex"} X_{i_k} = \mathfrak{n}
                      and
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi X
                              %mrow
                                %msub
                                  %mi i
                                  %mi j
                            %mo =
                            %msub
                              %mi 𝔞
                              %mo −
                          %annotation{:encoding => "application/x-tex"} X_{i_j} = \mathfrak{a}_-
                      for all
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi j
                            %mo &lt;
                            %mi k
                          %annotation{:encoding => "application/x-tex"} j \lt k
                      and
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi X
                              %mrow
                                %msub
                                  %mi i
                                  %mi j
                            %mo =
                            %msub
                              %mi 𝔞
                              %mo +
                          %annotation{:encoding => "application/x-tex"} X_{i_j} = \mathfrak{a}_+
                      for all
                      = succeed "." do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi j
                              %mo &gt;
                              %mi k
                            %annotation{:encoding => "application/x-tex"} j \gt k
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/composition"} composition
                  is given by the composition of linear orders as for the
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/associative+operad"} associative operad
          %h2#properties Properties
          %h3#RelationToTheAssociativeOperad Relation to the associative operad
          %p
            There are two canonical inclusions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Assoc
                  %mo →
                  %mi BMod
                %annotation{:encoding => "application/x-tex"} Assoc \to BMod
            of the
            %a.existingWikiWord{:href => "/nlab/show/associative+operad"} associative operad
            given by labelling its unique color/object with either
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔞
                    %mo −
                %annotation{:encoding => "application/x-tex"} \mathfrak{a}_-
            or
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔞
                      %mo +
                  %annotation{:encoding => "application/x-tex"} \mathfrak{a}_+
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi A
                    %mn 1
                  %mo ,
                  %msub
                    %mi A
                    %mn 2
                  %mo ,
                  %mi N
                  %mo{:stretchy => "false"} )
                  %mo{:lspace => "verythinmathspace"} :
                  %msup
                    %mi BMod
                    %mo ⊗
                  %mo →
                  %msup
                    %mi 𝒞
                    %mo ⊗
                %annotation{:encoding => "application/x-tex"}
                  (A_1,A_2,N) \colon BMod^\otimes \to \mathcal{C}^\otimes
          %p
            a morphism to a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mi i
                  %mo{:lspace => "verythinmathspace"} :
                  %msup
                    %mi Assoc
                    %mo ⊗
                  %mo →
                  %msup
                    %mi BMod
                    %mo ⊗
                  %mover
                    %mo →
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi A
                        %mn 1
                      %mo ,
                      %msub
                        %mi A
                        %mn 2
                      %mo ,
                      %mi N
                      %mo{:stretchy => "false"} )
                  %msup
                    %mi 𝒞
                    %mo ⊗
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  A_i \colon Assoc^\otimes \to BMod^\otimes \stackrel{(A_1, A_2, N)}{\to}
                  \\mathcal{C}^\otimes
                  \\,.
          %p
            There is also a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi BMod
                  %mo →
                  %mi Assoc
                %annotation{:encoding => "application/x-tex"} BMod \to Assoc
            given by forgetting the labels and just remembering the linear orders.
          .num_defn
            %h6#proposition Proposition
            %p
              This is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/fibration+of+%28%E2%88%9E%2C1%29-operads"} fibration of (∞,1)-operads
          %p
            In (
            %a{:href => "#Lurie"}> Lurie
            ) this appears as remark 4.3.1.8.
          %p This is such that for
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo{:lspace => "verythinmathspace"} :
                  %msup
                    %mi Assoc
                    %mo ⊗
                  %mo →
                  %msup
                    %mi 𝒞
                    %mo ⊗
                %annotation{:encoding => "application/x-tex"}
                  A \colon Assoc^\otimes \to \mathcal{C}^\otimes
          %p an algebra, the composite
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi A
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo{:lspace => "verythinmathspace"} :
                  %msup
                    %mi BMod
                    %mo ⊗
                  %mo →
                  %msup
                    %mi Assoc
                    %mo ⊗
                  %mover
                    %mo →
                    %mi A
                  %msup
                    %mi 𝒞
                    %mo ⊗
                %annotation{:encoding => "application/x-tex"}
                  (A, A, A) \colon BMod^\otimes \to Assoc^\otimes \stackrel{A}{\to} \mathcal{C}^\otimes
          %p
            exhibits
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            canonically as a bimodule over itself.
          %h3#relation_to_the_operad_for_modules_over_an_algebra Relation to the operad for modules over an algebra
          %p
            Similarly, there is an inclusion of the
            %a.existingWikiWord{:href => "/nlab/show/operad+for+modules+over+an+algebra"} operad for modules over an algebra
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi LMod
                  %mo →
                  %mi BMod
                %annotation{:encoding => "application/x-tex"}
                  LMod \to BMod
          %p etc.
          %h3#RelationToBitensoring Relation to bitensoring
          .num_defn
            %h6#definition_3 Definition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/coCartesian+fibration+of+%28%E2%88%9E%2C1%29-operads"} coCartesian fibration of (∞,1)-operads
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝒞
                        %mo ⊗
                      %mo →
                      %msup
                        %mi BMod
                        %mo ⊗
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}^\otimes \to BMod^\otimes
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi BMod
                    %annotation{:encoding => "application/x-tex"} BMod
              %a.existingWikiWord{:href => "/nlab/show/monoidal+%28%E2%88%9E%2C1%29-category"} monoidal (∞,1)-category
              is a
              %strong
                bi
                %a.existingWikiWord{:href => "/nlab/show/tensoring"} tensoring
              of
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo ≔
                    %msup
                      %mi 𝒞
                      %mo ⊗
                    %munder
                      %mo ×
                      %mi BMod
                    %mo{:stretchy => "false"} {
                    %mi 𝔫
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C} \coloneqq \mathcal{C}^\otimes \underset{BMod}{\times} \{\mathfrak{n}\}
            %p
              over the (ordinary)
              %a.existingWikiWord{:href => "/nlab/show/monoidal+%28%E2%88%9E%2C1%29-categories"} monoidal (∞,1)-categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi 𝒞
                      %mo ±
                      %mo ⊗
                    %mo ≔
                    %msup
                      %mi 𝒞
                      %mo ⊗
                    %munder
                      %mo ×
                      %mi BMod
                    %msubsup
                      %mi Assoc
                      %mo ±
                      %mo ⊗
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}^\otimes_{\pm}
                    \\coloneqq
                    \\mathcal{C}^\otimes \underset{BMod}{\times} Assoc^\otimes_{\pm}
                    \\,.
          %p
            (
            %a{:href => "#Lurie"}> Lurie, def. 4.3.1.17
            )
          .num_remark
            %h6#remark Remark
            %p
              By the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/microcosm+principle"} microcosm principle
              = succeed "-categories" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/bimodules"} bimodules
              %em
                %a{:href => "#RelationToCategoriesOfBimodules"} Relation to the category of bimodules
              below.
          %h3#RelationToCategoriesOfBimodules Relation to categories of bimodules
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝒞
                    %mo ⊗
                  %mo →
                  %msup
                    %mi BMod
                    %mo ⊗
                %annotation{:encoding => "application/x-tex"} \mathcal{C}^\otimes \to BMod^\otimes
            a
            %a.existingWikiWord{:href => "/nlab/show/fibration+of+%28%E2%88%9E%2C1%29-operads"} fibration of (∞,1)-operads
            the corresponding
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            of
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-algebras+over+an+%28%E2%88%9E%2C1%29-operad"} (∞,1)-algebras over an (∞,1)-operad
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi BMod
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %msub
                    %mi Alg
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mi BMod
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  BMod(\mathcal{C})
                  \\coloneqq
                  Alg_{/BMod}(\mathcal{C})
          %p
            is the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-bimodules"} (∞,1)-category of (∞,1)-bimodules
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
          %h2#related_concepts Related concepts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/operad+for+modules+over+an+algebra"} operad for modules over an algebra
          %h2#references References
          %p Section 4.3.1 in
          %ul#Lurie
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              ,
              %em
                %a.existingWikiWord{:href => "/nlab/show/Higher+Algebra"} Higher Algebra
