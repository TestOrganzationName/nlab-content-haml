          %h2#definition Definition
          %p
            For
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            %strong
              Poisson
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is a
            %a.existingWikiWord{:href => "/nlab/show/Poisson+algebra"} Poisson algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            in a
            %a.existingWikiWord{:href => "/nlab/show/category+of+chain+complexes"} category of chain complexes
            with Poisson bracket of degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo −
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (1-n)
            (which is a bracket of degree 0 on
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}^{n-1} A
          %h2#properties Properties
          %h3#RelationToEnAlgebras
            Relation to
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mi n
                  %annotation{:encoding => "application/x-tex"} E_n
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/homology"} homology
            of an
            %a.existingWikiWord{:href => "/nlab/show/E-n+algebra"} E-n algebra
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ≥
                  %mn 2
                %annotation{:encoding => "application/x-tex"} n \geq 2
            is a Poisson
            = succeed "-algebra." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p
            Moreover, in
            %a.existingWikiWord{:href => "/nlab/show/chain+complexes"} chain complexes
            over a
            %a.existingWikiWord{:href => "/nlab/show/field"} field
            of
            %a.existingWikiWord{:href => "/nlab/show/characteristic+zero"} characteristic zero
            the
            %a.existingWikiWord{:href => "/nlab/show/E-n+operad"} E-n operad
            is
            %a.existingWikiWord{:href => "/nlab/show/formal+dg-algebra"} formal
            (see
            = succeed ")," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/the+little+n-disk+operad+is+formal"} the little n-disk operad is formal
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mi n
                  %annotation{:encoding => "application/x-tex"} E_n
            = succeed "-algebras." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p
            This fact is a higher analog of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Kontsevich+formality"} Kontsevich formality
            %a.existingWikiWord{:href => "/nlab/show/prequantum+field+theory"} prequantum field theory
            given by a
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi P
                    %mi n
                %annotation{:encoding => "application/x-tex"} P_n
            algebra does have a
            %a.existingWikiWord{:href => "/nlab/show/deformation+quantization"} deformation quantization
            (as
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/factorization+algebras"} factorization algebras
            %a.existingWikiWord{:href => "/nlab/show/automorphism+infinity-group"} automorphism infinity-group
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mi n
                  %annotation{:encoding => "application/x-tex"} E_n
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck-Teichm%C3%BCller+group"} Grothendieck-Teichmüller group
          %p
            See also tho
            = succeed "." do
              %em
                %a{:href => "#MODiscussion"} MO discussion
                linked to below
          %h3#RelationToLInfinityAlgebras
            Relation to
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
          %p
            There is a
            %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
            from Poisson
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/dg-Lie+algebras"} dg-Lie algebras
            given by forgetting the
            %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
            structure and by
            %a.existingWikiWord{:href => "/nlab/show/suspension+of+a+chain+complex"} shifting
            the underlying chain complex by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n-1)
          %p
            Conversely, this functor has a
            %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            which sends a
            %a.existingWikiWord{:href => "/nlab/show/dg-Lie+algebra"} dg-Lie algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathfrak{g},d)
            to its
            %em
              %a.existingWikiWord{:href => "/nlab/show/universal+enveloping+E-n+algebra"} universal enveloping Poisson n-algebra
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Sym(\mathfrak{g}[n-1], d))
            = succeed ")." do
              %a{:href => "#Gwilliam"} Gwilliam, section 4.5
