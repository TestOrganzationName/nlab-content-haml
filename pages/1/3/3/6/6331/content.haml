                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\pi^n(X_b)
                    \\,\simeq\,
                    \\pi_0 Map\big(X_b, \, S^n\big)
                    \\,.
            %p
          %p
          #FiberwiseNonAbelianCohomologySetsFormLocalSystem.num_prop
            %h6 Proposition
            %p
              %strong (fiberwise non-abelian cohomology sets form local system)
              %br/
              For any
              %a.existingWikiWord{:href => "/nlab/show/k-space"} k-space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mspace{:width => "thinmathspace"}
                      %mo ∈
                      %mspace{:width => "thinmathspace"}
                      %mi kTop
                    %annotation{:encoding => "application/x-tex"} A \,\in\, kTop
              = succeed "-sets" do
                %a.existingWikiWord{:href => "/nlab/show/non-abelian+cohomology"} non-abelian cohomology
              %a.maruku-eqref{:href => "#eq:NonAbelianCohomologySets"} (5)
              of the
              %a.existingWikiWord{:href => "/nlab/show/fibers"} fibers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi b
                  %annotation{:encoding => "application/x-tex"} X_b
              %a.maruku-eqref{:href => "#eq:FiberOfTheFibration"} (4)
              with
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              constitute a
              %a.existingWikiWord{:href => "/nlab/show/local+system"} local system
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              %a.existingWikiWord{:href => "/nlab/show/covering+space"} covering space
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              (
              %a.existingWikiWord{:href => "/nlab/show/fundamental+theorem+of+covering+spaces"}> equivalently
              , they are the values of a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              from the
              %a.existingWikiWord{:href => "/nlab/show/fundamental+groupoid"} fundamental groupoid
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              to
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/Sets"} Sets
