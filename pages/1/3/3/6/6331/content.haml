                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi B
                    %mo ×
                    %mi A
                    %mover
                      %mo →
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mi pr
                          %mi B
                        %mspace{:width => "thickmathspace"}
                    %mi B
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    p_B^\ast A
                    \\;\;\;\coloneqq\;\;\;
                    B \times A \xrightarrow{\; pr_B \;} B
                    \\,.
            %p
              This is clearly a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Hurewicz+fibration"} Hurewicz fibration
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi X
                  %annotation{:encoding => "application/x-tex"} p_X
              is such by assumption
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:AssumingpXIsFibration"} (1)
              = succeed ")" do
                %a{:href => "parameterized+homotopy+theory#FiberwiseMappingSpacePreservesHFibrations"} this Prop.
              %a{:href => "parameterized+homotopy+theory#FiberwiseMappingSpaces"} fiberwise mapping space
              between the two (
              %a{:href => "parameterized+homotopy+theory#FiberwiseMappingSpace"}> this Def.
              ) is also a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Hurewicz+fibration"} Hurewicz fibration
