                          %mi j
                    %mi B
                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                      %mrow
                        %mi j
                        %mo ∈
                        %mi J
                  %annotation{:encoding => "application/x-tex"} \big\{U_j \xhookrightarrow{\iota_j} B\big\}_{j \in J}
              is an
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              over which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} X \to B
              %a.existingWikiWord{:href => "/nlab/show/local+trivialization"} locally trivializes
              with
              %a.existingWikiWord{:href => "/nlab/show/typical+fiber"} typical fiber
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} X_0
              %a.existingWikiWord{:href => "/nlab/show/local+trivialization"} locally trivializes
              over the same cover, with
              %a.existingWikiWord{:href => "/nlab/show/typical+fiber"} typical fiber
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi H
                        %mn 0
                      %mo{:stretchy => "false"} (
                      %msub
