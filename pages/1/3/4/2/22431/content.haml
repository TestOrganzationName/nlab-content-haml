              %path{:d => "M -9.082219 3.870312 L 58.8045 46.522656 ", :fill => "none", :stroke => "rgb(0%, 0%, 0%)", "stroke-linecap" => "butt", "stroke-linejoin" => "miter", "stroke-miterlimit" => "10", "stroke-opacity" => "1", "stroke-width" => "0.47818", :transform => "matrix(1, 0, 0, -1, 84.758, 63.175)"}
              %path{:d => "M -9.082219 -2.680469 L 18.417781 3.249219 ", :fill => "none", :stroke => "rgb(0%, 0%, 0%)", "stroke-linecap" => "butt", "stroke-linejoin" => "miter", "stroke-miterlimit" => "10", "stroke-opacity" => "1", "stroke-width" => "0.47818", :transform => "matrix(1, 0, 0, -1, 84.758, 63.175)"}
              %path{:d => "M -55.550969 -55.813281 L 56.706844 -55.813281 ", :fill => "none", :stroke => "rgb(0%, 0%, 0%)", "stroke-linecap" => "butt", "stroke-linejoin" => "miter", "stroke-miterlimit" => "10", "stroke-opacity" => "1", "stroke-width" => "0.47818", :transform => "matrix(1, 0, 0, -1, 84.758, 63.175)"}
            %p
              from which one readily reads off the Cayley distance: Ordering the 6
              %a.existingWikiWord{:href => "/nlab/show/permutations"} permutations
              as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi σ
                      %mo{:stretchy => "false"} →
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo [
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mn 123
                          %mtr
                            %mtd
                              %mn 213
                          %mtr
                            %mtd
                              %mn 132
                          %mtr
                            %mtd
                              %mn 321
                          %mtr
                            %mtd
                              %mn 312
                          %mtr
                            %mtd
                              %mn 231
                      %mo ]
                  %annotation{:encoding => "application/x-tex"}
                    \\vec \sigma
                    \\;\coloneqq\;
                    \\left[
                    \\array{
                    123
                    \\\
                    213
                    \\\
                    132
                    \\\
                    321
                    \\\
                    312
                    \\\
                    231
                    }
                    \\right]
            %p
              the
              %a.existingWikiWord{:href => "/nlab/show/Cayley+distance"} Cayley distance
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sym
                      %mo{:stretchy => "false"} (
                      %mn 3
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Sym(3)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 6
                    %mo ×
                    %mn 6
                  %annotation{:encoding => "application/x-tex"} 6 \times 6
              %a.existingWikiWord{:href => "/nlab/show/matrix"} matrix
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi d
                      %mi C
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi d
                      %mi C
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi σ
                      %mi i
                    %mo ,
                    %msub
                      %mi σ
                      %mi j
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Mat
                      %mrow
                        %mn 6
                        %mo ×
                        %mn 6
                    %mo{:stretchy => "false"} (
                    %mi ℕ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    [d_C]
                    \\;\coloneqq\;
                    \\big(
                    d_C
                    \\big(
                    \\sigma_i, \sigma_j
                    \\big)
                    \\big)_{i,j}
                    \\;\in\;
                    Mat_{6 \times 6}(\mathbb{N})
            %p is this:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi d
                      %mi C
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo [
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mn 1
                            %mtd
                              %mn 1
                            %mtd
                              %mn 1
                            %mtd
                              %mn 2
                            %mtd
                              %mn 2
                          %mtr
                            %mtd
                              %mn 1
                            %mtd
                              %mn 0
                            %mtd
                              %mn 2
                            %mtd
                              %mn 2
                            %mtd
                              %mn 1
                            %mtd
                              %mn 1
                          %mtr
                            %mtd
                              %mn 1
                            %mtd
                              %mn 2
                            %mtd
                              %mn 0
                            %mtd
                              %mn 2
                            %mtd
                              %mn 1
                            %mtd
                              %mn 1
                          %mtr
                            %mtd
                              %mn 1
                            %mtd
                              %mn 2
                            %mtd
                              %mn 2
                            %mtd
                              %mn 0
                            %mtd
                              %mn 1
                            %mtd
                              %mn 1
                          %mtr
                            %mtd
                              %mn 2
                            %mtd
                              %mn 1
                            %mtd
                              %mn 1
                            %mtd
                              %mn 1
                            %mtd
                              %mn 0
                            %mtd
                              %mn 2
                          %mtr
                            %mtd
                              %mn 2
                            %mtd
                              %mn 1
                            %mtd
                              %mn 1
                            %mtd
                              %mn 1
                            %mtd
                              %mn 2
                            %mtd
                              %mn 0
                      %mo ]
                  %annotation{:encoding => "application/x-tex"}
                    [d_C]
                    \\;=\;
                    \\left[
                    \\array{
                    0 &amp; 1 &amp; 1 &amp; 1  &amp; 2 &amp;  2
                    \\\
                    1 &amp; 0 &amp; 2 &amp; 2 &amp; 1 &amp; 1
                    \\\
                    1 &amp; 2 &amp; 0 &amp; 2 &amp; 1 &amp; 1
                    \\\
                    1 &amp; 2 &amp; 2 &amp; 0 &amp; 1 &amp; 1
                    \\\
                    2 &amp; 1 &amp; 1 &amp; 1 &amp; 0 &amp; 2
                    \\\
                    2 &amp; 1 &amp; 1 &amp; 1 &amp; 2 &amp; 0
                    }
                    \\right]
