                        %msub
                          %mi i
                          %mn 1
                        %mo ,
                        %msub
                          %mi j
                          %mn 1
                    %mo ∘
                    %msub
                      %mi σ
                      %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\sigma_2
                    \\;=\;
                    \\sigma_{i_d, j_d}
                    \\circ
                    \\cdots
                    \\circ
                    \\sigma_{i_2, j_2}
                    \\circ
                    \\sigma_{i_1, j_1}
                    \\circ
                    \\sigma_1
                    \\,.
            %p
          %h2#properties Properties
          %p
          #CayleyMetricIsRightInvariant.num_prop
            %h6 Proposition
            %p
              %strong (Cayley metric is right invariant)
              The Cayley metric is an
              %a.existingWikiWord{:href => "/nlab/show/right+invariant+metric"} right invariant metric
              in that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo ∈
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sigma \in Sym(n)
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi σ
                      %mo *
                    %msub
                      %mi d
                      %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi d
                      %mi C
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %mi σ
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %mi σ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi d
                      %mi C
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mo −
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\sigma^\ast d_C(-,-)
                    \\;\coloneqq\;
                    d_C
                    \\big(
                    (-) \circ \sigma
                    ,\,
                    (-) \circ \sigma
                    \\big)
                    \\;=\;
                    d_C
                    \\big(
                    \-
                    ,\,
                    \-
                    \\big)
                    \\,.
            %p
          .proof
            %h6 Proof
            %p This is immediate from the definition.
          %p
          #CayleyObservation.num_prop
            %h6 Proposition
            %p
              %strong (Cayley’s formula)
              The Cayley distance (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CayleyDistance"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi σ
                      %mn 1
                    %mo ,
                    %msub
                      %mi σ
                      %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sigma_1, \sigma_2 \,\in\, Sym(n)
              equals
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              minus the
              %a.existingWikiWord{:href => "/nlab/show/natural+number"} number
              of
              %a.existingWikiWord{:href => "/nlab/show/permutation+cycles"} permutation cycles
              in
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi σ
                        %mn 1
                      %mo ∘
                      %msubsup
                        %mi σ
                        %mn 2
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} \sigma_1 \circ \sigma_2^{-1}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi C
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi σ
                      %mn 1
                    %mo ,
                    %msub
                      %mi σ
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi n
                    %mo −
                    %mrow
                      %mo |
                      %mi Cycles
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %msub
                        %mi σ
                        %mn 1
                      %mo ∘
                      %msubsup
                        %mi σ
                        %mn 2
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mo |
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    d_C(\sigma_1, \sigma_2)
                    \\;=\;
                    n
                    \-
                    \\left\vert
                    Cycles
                    \\big(
                    \\sigma_1
                    \\circ
                    \\sigma_2^{-1}
                    \\big)
                    \\right\vert
                    \\,.
            %p
          (e.g.
          = succeed ")" do
            %a{:href => "#Diaconis88"} Diaconis 88, p. 118
          .proof
            %h6 Proof
            %p
              By right invariance (Prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#CayleyMetricIsRightInvariant"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi σ
                      %mn 2
                    %mo =
                    %mi e
                  %annotation{:encoding => "application/x-tex"} \sigma_2 = e
              is the
              %a.existingWikiWord{:href => "/nlab/show/neutral+element"} neutral element
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sym
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Sym(n)
              %a.existingWikiWord{:href => "/nlab/show/identity+function"} identity
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/permutation"} permutation
            %p
              Here we need to see that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo =
                    %msub
                      %mi σ
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \sigma = \sigma_1
              any permutation, the minimum number of transpositions whose product yields
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
              equals
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              minus the number of
              %a.existingWikiWord{:href => "/nlab/show/permutation+cycle"} cycles
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                    %annotation{:encoding => "application/x-tex"} \sigma
            %p Now observe that:
            %ol
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/cyclic+permutation"} cyclic permutation
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
                  elements is the composite of no less than
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                        %mo −
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} k-1
                  transpositions:
                #eq:CyclicPermutationAsProductOfTranspositions.maruku-equation
                  %span.maruku-eq-number (1)
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo (
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                  %mn 1
                                %mtd
                                  %mn 2
                                %mtd
                                  %mn 3
                                %mtd
                                  %mi ⋯
                                %mtd
                                  %mi k
                              %mtr
                                %mtd
                                  %mi k
                                %mtd
                                  %mn 1
                                %mtd
                                  %mn 2
                                %mtd
                                  %mi ⋯
                                %mtd
                                  %mi k
                                  %mo −
                                  %mn 1
                          %mo )
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %munder
                          %munder
                            %mrow
                              %msub
                                %mi σ
                                %mrow
                                  %mi k
                                  %mo −
                                  %mn 1
                                  %mo ,
                                  %mi k
                                  %mo −
                                  %mn 2
                              %mo ∘
                              %mi ⋯
                              %mo ∘
                              %msub
                                %mi σ
                                %mrow
                                  %mn 3
                                  %mo ,
                                  %mn 2
                              %mo ∘
                              %msub
                                %mi σ
                                %mrow
                                  %mn 2
                                  %mo ,
                                  %mn 1
                              %mo ∘
                              %msub
                                %mi σ
                                %mrow
                                  %mn 1
                                  %mo ,
                                  %mi k
                            %mo ⏟
                          %mrow
                            %mi k
                            %mo −
                            %mn 1
                            %mspace{:width => "thickmathspace"}
                            %mi factors
                      %annotation{:encoding => "application/x-tex"}
                        \\left(
                        \\array{
                        1 &amp; 2 &amp; 3 &amp; \cdots &amp; k
                        \\\
                        k &amp; 1 &amp; 2 &amp; \cdots &amp; k-1
                        }
                        \\right)
                        \\;=\;
                        \\underset{
                        k-1 \; factors
                        }{
                        \\underbrace{
                        \\sigma_{k-1,k-2}
                        \\circ
                        \\cdots
                        \\circ \sigma_{3,2} \circ \sigma_{2,1} \circ \sigma_{1,k}
                        }
                        }
              %li
                %p
                  Any
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi σ
                      %annotation{:encoding => "application/x-tex"} \sigma
                  is the product of elements of the form
                  = succeed "," do
                    %a.maruku-eqref{:href => "#eq:CyclicPermutationAsProductOfTranspositions"} (1)
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/permutation+cycles"} permutation cycles
            %p
              Since it is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} k-1
              transposition factors in
              %a.maruku-eqref{:href => "#eq:CyclicPermutationAsProductOfTranspositions"} (1)
              for cycles of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              elements, each cycle reduces the number of transposition needed by one.
          %p
          #CayleyDistancePreservedByInclusionOfSymmetricGroups.num_prop
            %h6 Proposition
            %p
              Cayley distance is preserved under the canonical inclusions of
              %a.existingWikiWord{:href => "/nlab/show/symmetric+groups"} symmetric groups
            #eq:CanonicalInclusionsOfSymmetricGroups.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ↪
                      %mi i
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi ⋯
                  %annotation{:encoding => "application/x-tex"}
                    Sym(n)
                    \\overset{
                    i
                    }{
                    \\hookrightarrow
                    }
                    Sym(n+1)
                    \\hookrightarrow
                    Sym(n+2)
                    \\hookrightarrow
                    \\cdots
            %p in that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi C
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi σ
                      %mn 1
                    %mo ,
                    %msub
                      %mi σ
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi d
                      %mi C
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi i
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi σ
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi i
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi σ
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    d_C( \sigma_1, \sigma_2 )
                    \\; = \;
                    d_C\big(
                    i(\sigma_1), i(\sigma_2)
                    \\big)
                    \\,.
            %p
              In other words, when regarding the
              %a.existingWikiWord{:href => "/nlab/show/metric+space"} metric space
              given by the set of permutations in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sym(n)
              with their Cayley distance function between them
            %ul
              %li
                %p
                  as an
                  = succeed "0-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi ℝ
                            %mrow
                              %mo ≥
                              %mn 0
                          %mo ,
                          %mo ≥
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (\mathbb{R}_{\geq 0}, \geq)
                  %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
                  (see
                  = succeed ")," do
                    %a{:href => "metric+space#LawvereMetricSpace"} here
                  %a.existingWikiWord{:href => "/nlab/show/functors"} functors
                  induced by the inclusions
                  %a.maruku-eqref{:href => "#eq:CanonicalInclusionsOfSymmetricGroups"} (2)
                  are
                  %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful
                  and hence are
                  %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
                  inclusions.
              %li
                %p
                  as a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/matrix"} matrix
                  %a.maruku-eqref{:href => "#eq:CanonicalInclusionsOfSymmetricGroups"} (2)
                  correspond to
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/principal+submatrices"} principal submatrices
            %p
          #ProofOfCayleyDistancePreservedByInclusionOfSymmetricGroups.proof
            %h6 Proof
            %p Observing that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo |
                      %mi Cycles
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mi i
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi σ
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ∘
                      %mi i
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi σ
                        %mn 2
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mo |
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo |
                      %mi Cycles
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %msub
                        %mi σ
                        %mn 1
                      %mo ∘
                      %msubsup
                        %mi σ
                        %mn 2
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mo |
                    %mspace{:width => "thickmathspace"}
                    %mo +
                    %mspace{:width => "thickmathspace"}
                    %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\left\vert
                    Cycles
                    \\big(
                    i(\sigma_1) \circ i(\sigma_2)^{-1}
                    \\big)
                    \\right\vert
                    \\;=\;
                    \\left\vert
                    Cycles
                    \\big(
                    \\sigma_1 \circ \sigma_2^{-1}
                    \\big)
                    \\right\vert
                    \\;+\;
                    1
            %p
              the claim follows by Cayley’s formula (Prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#CayleyObservation"}
