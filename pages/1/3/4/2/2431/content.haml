              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo ⋆
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\star)
              to this gives a further extension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi η
                      %mo{:stretchy => "false"} ¯
                    %mo ′
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Z
                    %mo ′
                    %mo →
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} \bar \eta' \colon Z' \to Z
              which now makes the following diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Ho
                            %mo{:stretchy => "false"} (
                            %mi 𝒞
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo ,
                            %mi X
                            %mo ′
                            %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mo ⟶
                          %mtd
                          %mtd
                            %mi Ho
                            %mo{:stretchy => "false"} (
                            %mi 𝒞
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo ,
                            %mi Z
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi η
                                  %mo ′
                                  %mo ∘
                                  %mo{:stretchy => "false"} (
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mo{:stretchy => "false"} )
                            %mo ↘
                          %mtd
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mrow
                                  %mover
                                    %mi η
                                    %mo{:stretchy => "false"} ¯
                                  %mo ′
                                  %mo ∘
                                  %mo{:stretchy => "false"} (
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Ho(\mathcal{C})(-,X') &amp;&amp; \longrightarrow &amp;&amp; Ho(\mathcal{C})(-, Z)
                    \\\
                    \&amp; {}_{\mathllap{\eta'\circ(-)}}\searrow &amp;&amp; \swarrow_{\mathrlap{\bar \eta' \circ (-)}}
                    \\\
                    \&amp;&amp; F(-)
                    }
            %p
              such that the diagonal maps become isomorphisms when evaluated on the
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi S
                        %mi i
                    %annotation{:encoding => "application/x-tex"} S_i
              %a.maruku-ref{:href => "#WhiteheadTheoremForCompactGenerationByCogroupObjects"}
              that the morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ′
                    %mo ⟶
                    %mi Z
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} h \colon X' \longrightarrow Z'
              is an equivalence.
            %p
              Since by this construction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo ∘
                    %mi f
                  %annotation{:encoding => "application/x-tex"} h\circ f
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo ∘
                    %mi g
