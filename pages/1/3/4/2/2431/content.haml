                            %mi Z
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi Z
                            %mo ′
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Y \sqcup Y &amp;\stackrel{(f,g)}{\longrightarrow}&amp; X'
                    \\\
                    \\downarrow &amp;&amp; \downarrow &amp; \searrow^{\mathrlap{\stackrel{h}{\simeq}}}
                    \\\
                    Y &amp;\longrightarrow&amp; Z &amp;\longrightarrow&amp; Z'
                    }
            %p
              it follows with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
              being an equivalence that already
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              were homotopic, hence that they represented the same element.
          #GeneralizedCohomologyOnGeneralInfinityCategory.num_defn
            %h6#definition_3 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
              with
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pushouts"} (∞,1)-pushouts
              %a.existingWikiWord{:href => "/nlab/show/zero+object"} zero object
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo ∈
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} 0 \in \mathcal{C}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝒞
                    %mo →
                    %mi 𝒞
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ↦
                    %mn 0
                    %munder
                      %mo ⊔
                      %mi X
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \Sigma \colon \mathcal{C} \to \mathcal{C}\colon X\mapsto 0 \underset{X}{\sqcup} 0
              for the corresponding
              %a.existingWikiWord{:href => "/nlab/show/suspension"} suspension
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
            %p
              A
              %strong
                reduced additive
                %a.existingWikiWord{:href => "/nlab/show/generalized+%28Eilenberg-Steenrod%29+cohomology"} generalized (Eilenberg-Steenrod) cohomology
                theory
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is
            %ol
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/functor"} functor
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi H
                          %mo •
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi Ho
                        %mo{:stretchy => "false"} (
                        %mi 𝒞
                        %msup
                          %mo{:stretchy => "false"} )
                          %mi op
                        %mo ⟶
                        %msup
                          %mi Ab
                          %mi ℤ
                      %annotation{:encoding => "application/x-tex"}
                        H^\bullet \;\colon \; Ho(\mathcal{C})^{op} \longrightarrow Ab^{\mathbb{Z}}
                %p
                  (from the
                  %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+an+%28infinity%2C1%29-category"} homotopy category
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  into
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℤ
                        %annotation{:encoding => "application/x-tex"} \mathbb{Z}
                  = succeed ");" do
                    %a.existingWikiWord{:href => "/nlab/show/graded+abelian+groups"} graded abelian groups
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/natural+isomorphisms"} natural isomorphisms
                  (“
                  %a.existingWikiWord{:href => "/nlab/show/suspension+isomorphisms"}> suspension isomorphisms
                  ”) of degree +1
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi δ
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %msup
                          %mi H
                          %mo •
                        %mo ⟶
                        %msup
                          %mi H
                          %mrow
                            %mo •
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                            %mn 1
                        %mo ∘
                        %mi Σ
                      %annotation{:encoding => "application/x-tex"}
                        \\delta \; \colon \; H^\bullet \longrightarrow H^{\bullet+1} \circ \Sigma
            %p
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mo •
                  %annotation{:encoding => "application/x-tex"} H^\bullet
            %ol
              %li
                %p
                  %strong (exactness)
                  takes
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+cofiber+sequences"} homotopy cofiber sequences
                  to
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/exact+sequences"} exact sequences
              %li
                %p
                  %strong (additivity)
                  takes small
                  %a.existingWikiWord{:href => "/nlab/show/coproducts"} coproducts
                  to
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/products"} products
          #ConnectinHomomorphismForCohomologyTheoryOnInfinityCategory.num_defn
            %h6#definition_4 Definition
            %p
              Given a generalized cohomology theory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi H
                      %mo •
                    %mo ,
                    %mi δ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (H^\bullet,\delta)
              on some
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              as in def.
              = succeed "," do
                %a.maruku-ref{:href => "#GeneralizedCohomologyOnGeneralInfinityCategory"}
              %a.existingWikiWord{:href => "/nlab/show/homotopy+cofiber+sequence"} homotopy cofiber sequence
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mover
                      %mo ⟶
                      %mi f
                    %mi Y
                    %mover
                      %mo ⟶
                      %mi g
                    %mi Z
                    %mover
                      %mo ⟶
                      %mrow
                        %mi coker
                        %mo{:stretchy => "false"} (
                        %mi g
                        %mo{:stretchy => "false"} )
                    %mi Σ
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    X \stackrel{f}{\longrightarrow} Y \stackrel{g}{\longrightarrow} Z
                    \\stackrel{coker(g)}{\longrightarrow}
                    \\Sigma X
                    \\,,
            %p
              then the corresponding
              %strong
                %a.existingWikiWord{:href => "/nlab/show/connecting+homomorphism"} connecting homomorphism
              is the composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mi δ
                    %msup
                      %mi H
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %mi coker
                        %mo{:stretchy => "false"} (
                        %mi g
                        %msup
                          %mo{:stretchy => "false"} )
                          %mo *
                    %msup
                      %mi H
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Z
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\partial
                    \\;\colon\;
                    H^\bullet(X)
                    \\stackrel{\delta}{\longrightarrow}
                    H^{\bullet+1}(\Sigma X)
                    \\stackrel{coker(g)^\ast}{\longrightarrow}
                    H^{\bullet+1}(Z)
                    \\,.
          #LongExactSequenceOfACohomologyTheoryOnAnInfinityCategory.num_prop
            %h6#proposition_2 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/connecting+homomorphisms"} connecting homomorphisms
              of def.
              %a.maruku-ref{:href => "#ConnectinHomomorphismForCohomologyTheoryOnInfinityCategory"}
              are parts of
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequences"} long exact sequences
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mover
                      %mo ⟶
                      %mo ∂
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi Z
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ∂
                    %msup
                      %mi H
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Z
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ⋯
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots
                    \\stackrel{\partial}{\longrightarrow}
                    H^{\bullet}(Z) \longrightarrow H^\bullet(Y) \longrightarrow H^\bullet(X)
                    \\stackrel{\partial}{\longrightarrow}
                    H^{\bullet+1}(Z)
                    \\to \cdots
                    \\,.
          .proof
            %h6#proof_3 Proof
            %p
              By the defining exactness of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi H
                        %mo •
                    %annotation{:encoding => "application/x-tex"} H^\bullet
              = succeed "," do
                %a.maruku-ref{:href => "#GeneralizedCohomologyOnGeneralInfinityCategory"}
              = succeed "," do
                %a.maruku-ref{:href => "#ConnectinHomomorphismForCohomologyTheoryOnInfinityCategory"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                  %annotation{:encoding => "application/x-tex"} \delta
              is by definition an isomorphism.
          #CohomologyFunctorOnInfinityCategoryIsBrownFunctor.num_prop
            %h6#proposition_3 Proposition
            %p
              Given a reduced addive generalized cohomology functor
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi H
                        %mo •
                      %mo{:lspace => "verythinmathspace"} :
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi op
                      %mo →
                      %msup
                        %mi Ab
                        %mi ℤ
                    %annotation{:encoding => "application/x-tex"} H^\bullet \colon Ho(\mathcal{C})^{op}\to Ab^{\mathbb{Z}}
              = succeed "," do
                %a.maruku-ref{:href => "#GeneralizedCohomologyOnGeneralInfinityCategory"}
              = succeed "-valued" do
                %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mi n
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo →
                    %mi Ab
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} H^n \colon Ho(\mathcal{C})^{op}\to Ab\to Set
              are
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Brown+functors"} Brown functors
              = succeed "." do
                %a.maruku-ref{:href => "#BrownFunctorOnInfinityCategory"}
          .proof
            %h6#proof_4 Proof
            %p
              The first condition on a
              %a.existingWikiWord{:href => "/nlab/show/Brown+functor"} Brown functor
              holds by additivity. For the second condition, given a homotopy pushout square
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi X
                              %mn 1
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi f
                                  %mn 1
                          %mtd
                            %msub
                              %mi Y
                              %mn 1
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mrow
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
