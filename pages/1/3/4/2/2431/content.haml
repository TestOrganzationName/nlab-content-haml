              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representable
          %p
            (
            %a{:href => "#Jardine09"}> Jardine 09, theorem 24
            )
          %h3#ForEquivariantCohomology
            For
            = succeed "-graded" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi RO
                    %mo{:stretchy => "false"} (
                    %mi G
