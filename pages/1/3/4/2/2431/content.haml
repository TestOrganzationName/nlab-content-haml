                        A &amp;\to&amp; X
                        \\\
                        \\downarrow^i &amp;&amp; \downarrow
                        \\\
                        B &amp;\to&amp; B \coprod_A X,
                        }
                %p
                  with all objects cofibrant and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                      %annotation{:encoding => "application/x-tex"} i
                  a cofibration, to a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/weak+pullback"} weak pullback
            %p
              (
              %a{:href => "#Jardine09"}> Jardine 09, p. 21
              )
            %p
              Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
