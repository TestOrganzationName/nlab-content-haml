                %semantics
                  %mrow
                    %mi Σ
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \Sigma X
              in the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+an+%28%E2%88%9E%2C1%29-category"} homotopy category
            %p
              This is equivalently the
              = succeed "-structure" do
                %a.existingWikiWord{:href => "/nlab/show/group"} group
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} fundamental
