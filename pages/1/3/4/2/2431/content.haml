                    \\pi_1 Ho(\mathcal{C})(X, Y)
                    \\,.
          #TheClassicalPointedConnectedHomotopyCategoryAsDomainForTheAbstractBrownRepresentabilityTheorem.num_example
            %h6#example_2 Example
