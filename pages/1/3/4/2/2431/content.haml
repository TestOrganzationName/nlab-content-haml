          #CompactGenerationByCogroupObjects.num_defn
            %h6#definition_2 Definition
            %p
              Say that a
              %a.existingWikiWord{:href => "/nlab/show/locally+presentable+%28%E2%88%9E%2C1%29-category"} locally presentable (∞,1)-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
