            %h6#proof_5 Proof
            %p
              Via prop.
              = succeed "," do
                %a.maruku-ref{:href => "#CohomologyFunctorOnInfinityCategoryIsBrownFunctor"}
              %a.maruku-ref{:href => "#BrownRepresentabilityOnPresentableInfinityCategories"}
              gives the first clause. With this, the second clause follows by the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Yoneda+lemma"} (∞,1)-Yoneda lemma
              (in fact just with the
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
          %h2#further_variants Further variants
          %h3#for_triangulated_categories_and_model_categories For triangulated categories and model categories
          %p
            For
            %a.existingWikiWord{:href => "/nlab/show/triangulated+categories"} triangulated categories
            a discussion is in (
            %a{:href => "#Neeman96"}> Neeman 96
            ).
          %p
            For
            %a.existingWikiWord{:href => "/nlab/show/model+categories"} model categories
            a discussion is in (
            %a{:href => "#Jardine09"}> Jardine 09
            ):
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be a
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            with a
            %a.existingWikiWord{:href => "/nlab/show/zero+object"} zero object
            and such that there is a
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            of
            %a.existingWikiWord{:href => "/nlab/show/cofibrant+object"} cofibrant
            %a.existingWikiWord{:href => "/nlab/show/compact+objects"} compact objects
            such that the
            %a.existingWikiWord{:href => "/nlab/show/weak+equivalences"} weak equivalences
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            are precisely the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/local+morphisms"} local morphisms
          %p
            (
            %a{:href => "#Jardine09"}> Jardine 09, p. 20
            )
          .num_theorem
            %h6#theorem_3 Theorem
            %p
              %strong (Jardine)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %msup
                      %mi C
                      %mi op
                    %mo →
                    %msub
                      %mi Set
                      %mo *
                  %annotation{:encoding => "application/x-tex"} F : C^{op} \to Set_{*}
              be a pointed
              %a.existingWikiWord{:href => "/nlab/show/homotopical+functor"} homotopical functor
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi op
                  %annotation{:encoding => "application/x-tex"} C^{op}
              to the category of
              %a.existingWikiWord{:href => "/nlab/show/pointed+sets"} pointed sets
              such that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
                  preserves small
                  %a.existingWikiWord{:href => "/nlab/show/coproducts"} coproducts
                  of cofibrant objects (including preserving the
                  = succeed ")." do
                    %a.existingWikiWord{:href => "/nlab/show/zero+object"} zero object
              %li
                %p
                  %strong (Mayer-Vietoris property)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
                  takes any
                  %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
                  diagram
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi A
                              %mtd
                                %mo →
                              %mtd
