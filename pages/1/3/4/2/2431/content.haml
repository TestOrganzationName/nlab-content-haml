                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ′
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mo ∃
                                  %mi η
                                  %mo ′
                            %mo ↗
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi epi
                        %mtr
                          %mtd
                          %mtd
                            %mo *
                            %mover
                              %mo ⟶
                              %mrow
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi η
                                  %mi n
                                %msub
                                  %mo{:stretchy => "false"} )
                                  %mi n
                          %mtd
                            %msub
                              %munder
                                %mi lim
                                %mo ⟵
                              %mi n
                            %mi F
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi X
                              %mi n
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ↙
                          %mtd
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                              %mi n
                            %mi F
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi X
                              %mrow
                                %mn 2
                                %mi n
                                %mo +
                                %mn 1
                            %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                              %mi n
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi X
                              %mrow
                                %mn 2
                                %mi n
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                          %mtd
                            %mo ↙
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                              %mi n
                            %mi F
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi X
                              %mi n
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; \underset{n}{\sqcup} X_n
                    \\\
                    \&amp; \swarrow &amp;&amp; \searrow
                    \\\
                    \\underset{n}{\sqcup} X_{2n+1} &amp;\longrightarrow&amp; X' &amp;\longleftarrow&amp; \underset{n}{\sqcup} X_{2n}
                    \\\
                    \&amp; {}_{\mathllap{(\eta_{2n+1})_{n}}}\searrow&amp; \downarrow^{\mathrlap{\exists \eta'}} &amp; \swarrow_{\mathrlap{(\eta_{2n})_n}}
                    \\\
                    \&amp;&amp; F
                    }
                    \\;\;\;\;\;\;\;\;\;
                    \\Leftrightarrow
                    \\;\;\;\;\;\;\;\;\;
                    \\array{
                    \&amp;&amp; F(X')
                    \\\
                    \&amp;{}^{\mathllap{\exists \eta'}}\nearrow&amp; \downarrow^{\mathrlap{epi}}
                    \\\
                    \&amp;\ast \overset{(\eta_n)_n}{\longrightarrow}&amp; \underset{\longleftarrow}{\lim}_n F(X_n)
                    \\\
                    \&amp; \swarrow &amp;&amp; \searrow
                    \\\
                    \\underset{n}{\prod}F(X_{2n+1})
                    \&amp;&amp; &amp;&amp;
                    \\underset{n}{\prod}(X_{2n})
                    \\\
                    \&amp; \searrow &amp;&amp; \swarrow
                    \\\
                    \&amp;&amp; \underset{n}{\prod}F(X_n)
                    }
                    \\,,
            %p
              It remains to confirm that this indeed gives the desired bijection. Surjectivity is clear. For injectivity use that all the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mi i
                  %annotation{:encoding => "application/x-tex"} S_i
              are, by assumption,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/compact+object"} compact
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/sequential+colimit"} sequential colimit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi X
                              %mrow
                                %mi n
                                %mo{:stretchy => "false"} (
                                %mi γ
                                %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mo ∃
                                  %mover
                                    %mi γ
                                    %mo{:stretchy => "false"} ^
                            %mo ↗
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msub
                              %mi S
                              %mi i
                          %mtd
                            %mover
                              %mo ⟶
                              %mi γ
                          %mtd
                            %mi X
                            %mo ′
                            %mo =
                            %msub
                              %munder
                                %mi lim
                                %mo ⟶
                              %mi n
                            %msub
                              %mi X
                              %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; X_{n(\gamma)}
                    \\\
                    \&amp;{}^{\mathllap{ \exists \hat \gamma}}\nearrow&amp; \downarrow
                    \\\
                    S_i
                    \&amp;\overset{\gamma}{\longrightarrow}&amp;
                    X'
                    \=
                    \\underset{\longrightarrow}{\lim}_n X_n
                    }
                    \\,.
            %p
              With this, injectivity follows because by construction we quotiented out the kernel at each stage. Because suppose that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                  %annotation{:encoding => "application/x-tex"} \gamma
              is taken to zero in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi S
                        %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F(S_i)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} X_{n+1}
              above there is a factorization of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                  %annotation{:encoding => "application/x-tex"} \gamma
              through the point:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mn 0
                            %mo{:lspace => "verythinmathspace"} :
                          %mtd
                            %msub
                              %mi S
                              %mi i
                          %mtd
                            %mover
                              %mo ⟶
                              %mover
                                %mi γ
                                %mo{:stretchy => "false"} ^
                          %mtd
                            %msub
                              %mi X
                              %mrow
                                %mi n
                                %mo{:stretchy => "false"} (
                                %mi γ
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi η
                                  %mi n
                          %mtd
                            %mi F
                        %mtr
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                        %mtr
                          %mtd
                          %mtd
                            %mo *
                          %mtd
                            %mo ⟶
                          %mtd
                            %msub
                              %mi X
                              %mrow
                                %mi n
                                %mo{:stretchy => "false"} (
                                %mi γ
                                %mo{:stretchy => "false"} )
                                %mo +
                                %mn 1
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi X
                            %mo ′
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    0 \colon &amp; S_i
                    \&amp;\overset{\hat \gamma}{\longrightarrow}&amp;
                    X_{n(\gamma)}
                    \&amp;\overset{\eta_n}{\longrightarrow}&amp; F
                    \\\
                    \&amp; \downarrow &amp;&amp; \downarrow &amp;
                    \\\
                    \&amp; \ast &amp;\longrightarrow&amp; X_{n(\gamma)+1}
                    \\\
                    \&amp; &amp;&amp; \downarrow
                    \\\
                    \&amp; &amp;&amp; X'
                    }
            %p
              This concludes the proof of Lemma (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo ⋆
                  %annotation{:encoding => "application/x-tex"} \star
              ).
            %p
              Now apply the construction given by this lemma to the case
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 0
                    %mo ≔
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} X_0 \coloneqq 0
              and the unique
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi η
                        %mn 0
                      %mo{:lspace => "verythinmathspace"} :
                      %mn 0
                      %mover
                        %mo →
                        %mrow
                          %mo ∃
                          %mo !
                      %mi F
                    %annotation{:encoding => "application/x-tex"} \eta_0 \colon 0 \stackrel{\exists !}{\to} F
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo ⋆
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\star)
              then produces an object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} X'
              which represents
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              on all the
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi S
                        %mi i
                    %annotation{:encoding => "application/x-tex"} S_i
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} X'
              actually represents
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              generally, hence that for every
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} Y \in \mathcal{C}
              the function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                    %mo ≔
                    %mi η
                    %mo ′
                    %mo ∘
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi X
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\theta \coloneqq \eta'\circ (-)
                    \\;\colon\;
                    Ho(\mathcal{C})(Y,X')
                    \\stackrel{}{\longrightarrow}
                    F(Y)
            %p
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
            %p
              First, to see that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                  %annotation{:encoding => "application/x-tex"} \theta
              is surjective, we need to find a preimage of any
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                      %mo{:lspace => "verythinmathspace"} :
                      %mi Y
                      %mo →
                      %mi F
                    %annotation{:encoding => "application/x-tex"} \rho \colon Y \to F
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo ⋆
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\star)
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi η
                    %mo ′
                    %mo ,
                    %mi ρ
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ′
                    %mo ⊔
                    %mi Y
                    %mo ⟶
                    %mi F
                  %annotation{:encoding => "application/x-tex"} (\eta',\rho)\colon X'\sqcup Y \longrightarrow F
              we get an extension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                  %annotation{:encoding => "application/x-tex"} \kappa
              of this through some
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ′
                    %mo ⊔
                    %mi Y
                    %mo ⟶
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} X' \sqcup Y \longrightarrow Z
              and the morphism on the right of the following commuting diagram:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Ho
                            %mo{:stretchy => "false"} (
                            %mi 𝒞
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo ,
                            %mi X
                            %mo ′
                            %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mo ⟶
                          %mtd
                          %mtd
                            %mi Ho
                            %mo{:stretchy => "false"} (
                            %mi 𝒞
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo ,
                            %mi Z
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi η
                                  %mo ′
                                  %mo ∘
                                  %mo{:stretchy => "false"} (
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mo{:stretchy => "false"} )
                            %mo ↘
                          %mtd
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi κ
                                  %mo ∘
                                  %mo{:stretchy => "false"} (
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Ho(\mathcal{C})(-,X') &amp;&amp; \longrightarrow &amp;&amp; Ho(\mathcal{C})(-, Z)
                    \\\
                    \&amp; {}_{\mathllap{\eta'\circ(-)}}\searrow &amp;&amp; \swarrow_{\mathrlap{\kappa \circ (-)}}
                    \\\
                    \&amp;&amp; F(-)
                    }
                    \\,.
            %p
              Moreover, Lemma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo ⋆
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\star)
              gives that evaluated on all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi S
                        %mi i
                    %annotation{:encoding => "application/x-tex"} S_i
              %a.maruku-ref{:href => "#WhiteheadTheoremForCompactGenerationByCogroupObjects"}
              implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ′
                    %mo ⟶
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} X' \longrightarrow Z
              is in fact an equivalence. Hence the component map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo →
                    %mi Z
                    %mo ≃
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} Y \to Z \simeq Z
              is a lift of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                  %annotation{:encoding => "application/x-tex"} \kappa
              through
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi θ
                    %annotation{:encoding => "application/x-tex"} \theta
            %p
              Second, to see that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                  %annotation{:encoding => "application/x-tex"} \theta
              is injective, suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ,
                    %mi g
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Y
                    %mo →
                    %mi X
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} f,g \colon Y \to X'
              have the same image under
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi θ
                    %annotation{:encoding => "application/x-tex"} \theta
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pushout"} homotopy pushout
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Y
                            %mo ⊔
                            %mi Y
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi f
                                %mo ,
                                %mi g
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi X
                            %mo ′
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi Y
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi Z
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Y \sqcup Y &amp;\stackrel{(f,g)}{\longrightarrow}&amp; X'
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    Y &amp;\longrightarrow&amp; Z
                    }
            %p
              along the
              %a.existingWikiWord{:href => "/nlab/show/codiagonal"} codiagonal
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              sends this to a
              %a.existingWikiWord{:href => "/nlab/show/weak+pullback"} weak pullback
              by assumption, we obtain an extension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi η
                      %mo{:stretchy => "false"} ¯
                  %annotation{:encoding => "application/x-tex"} \bar \eta
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \eta'
              along
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
