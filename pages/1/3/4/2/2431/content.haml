                    %mi Σ
                    %mi X
                    %mo ≃
                    %mn 0
                    %munder
                      %mo ⊔
                      %mi X
                    %mn 0
                    %munder
                      %mo ⊔
                      %mi X
                    %mn 0
                    %mo ⟶
                    %mn 0
                    %munder
                      %mo ⊔
                      %mi X
                    %mi X
                    %munder
                      %mo ⊔
                      %mi X
                    %mn 0
                    %mo ≃
                    %mn 0
                    %munder
                      %mo ⊔
                      %mi X
                    %mn 0
