        #revision
          %p
            In
            %a{:href => "http://arxiv.org/PS_cache/math/pdf/0502/0502155v2.pdf#page=11"} section 4
            of
          %ul
            %li
              Clemens Berger,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ieke+Moerdijk"} Ieke Moerdijk
              %em The Boardman-Vogt resolution of operads in monoidal model categories
              (
              %a{:href => "http://arxiv.org/abs/math.AT/0502155"}> arXiv
              )
          %p the following definition is given:
          %p
            Let
            %math#mathml_f266a8451c55d2f6723644a39c392c7c3d108114_1.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            be a
            %a.existingWikiWord{:href => "/nlab/show/monoidal+model+category"} monoidal model category
            and write
            %math#mathml_f266a8451c55d2f6723644a39c392c7c3d108114_2.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi pt
                %annotation{:encoding => "application/x-tex"} pt
            for the tensor unit in
            %math#mathml_f266a8451c55d2f6723644a39c392c7c3d108114_3.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            (not necessarily the terminal object).
          %p
            A
            %strong
              %a.existingWikiWord{:href => "/nlab/show/segment+object"} segment (object)
            %math#mathml_f266a8451c55d2f6723644a39c392c7c3d108114_4.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            in a
            %a.existingWikiWord{:href => "/nlab/show/monoidal+model+category"} monoidal model category
            %math#mathml_f266a8451c55d2f6723644a39c392c7c3d108114_5.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            is
          %ul
            %li
              %p a factorization
              .maruku-equation
                %math#mathml_f266a8451c55d2f6723644a39c392c7c3d108114_6.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi pt
                      %mo ⨿
                      %mi pt
                      %mover
                        %mo →
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mn 0
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} ]
                      %mi I
                      %mover
                        %mo →
                        %mi ϵ
                      %mi pt
                    %annotation{:encoding => "application/x-tex"}
                      pt \amalg pt \stackrel{[0 , 1]}{\to}
                      I \stackrel{\epsilon}{\to} pt
              %p
                of the
                %a.existingWikiWord{:href => "/nlab/show/codiagonal+morphism"} codiagonal morphism
              .maruku-equation
                %math#mathml_f266a8451c55d2f6723644a39c392c7c3d108114_7.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi pt
                      %mo ⨿
                      %mi pt
                      %mover
                        %mo →
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi Id
                          %mo ,
                          %mi Id
                          %mo{:stretchy => "false"} ]
                      %mi pt
                    %annotation{:encoding => "application/x-tex"}
                      pt \amalg pt \stackrel{[Id , Id]}{\to} pt
              %p
                from the
                %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
                of
                %math#mathml_f266a8451c55d2f6723644a39c392c7c3d108114_8.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi pt
                    %annotation{:encoding => "application/x-tex"} pt
                with itself that sends each component identically to
                = succeed "." do
                  %math#mathml_f266a8451c55d2f6723644a39c392c7c3d108114_9.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi pt
                      %annotation{:encoding => "application/x-tex"} pt
            %li
              %p together with an associative morphsim
              .maruku-equation
                %math#mathml_f266a8451c55d2f6723644a39c392c7c3d108114_10.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∨
                      %mo :
                      %mi I
                      %mo ⊗
                      %mi I
                      %mo →
                      %mi I
                    %annotation{:encoding => "application/x-tex"}
                      \\vee : I \otimes I \to I
              %p
                which has 0 as its
                %em neutral
                and 1 as its
                %em absorbing
                element, and for which
                %math#mathml_f266a8451c55d2f6723644a39c392c7c3d108114_11.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                    %annotation{:encoding => "application/x-tex"} \epsilon
                is a counit.
          %p
            If
            %math#mathml_f266a8451c55d2f6723644a39c392c7c3d108114_12.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            is equipped with the structure of a
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            then a segment object is an
            %strong interval
            in
            %math#mathml_f266a8451c55d2f6723644a39c392c7c3d108114_13.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            if
          .maruku-equation
            %math#mathml_f266a8451c55d2f6723644a39c392c7c3d108114_14.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo{:lspace => "verythinmathspace"} :
                  %mi pt
                  %mo ⨿
                  %mi pt
                  %mo →
                  %mi I
                %annotation{:encoding => "application/x-tex"}
                  [0, 1]\colon pt \amalg pt \to I
          %p
            is a cofibration and
            %math#mathml_f266a8451c55d2f6723644a39c392c7c3d108114_15.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϵ
                  %mo :
                  %mi I
                  %mo →
                  %mi pt
                %annotation{:encoding => "application/x-tex"} \epsilon : I \to pt
            a weak equivalence.
          %p The axioms of a segment are expressed by the commutativity of the following five diagrams (all isomorphisms being induced by the symmetric monoidal structure):
          .maruku-equation
            %math#mathml_f266a8451c55d2f6723644a39c392c7c3d108114_16.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mi H
                          %mo ⊗
                          %mi H
                          %mo{:stretchy => "false"} )
                          %mo ⊗
                          %mi H
                        %mtd
                          %msup
                            %mo →
                            %mo ∼
                        %mtd
                          %mi H
                          %mo ⊗
                          %mo{:stretchy => "false"} (
                          %mi H
                          %mo ⊗
                          %mi H
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mrow
                              %mo ∨
                              %mo ⊗
                              %mi H
                        %mtd
                        %mtd
                          %msub
                            %mo{:stretchy => "false"} ↓
                            %mrow
                              %mi H
                              %mo ⊗
                              %mo ∨
                      %mtr
                        %mtd
                          %mi H
                          %mo ⊗
                          %mi H
                        %mtd
                          %mover
                            %mo ←
                            %mo ∨
                          %mi H
                          %mover
                            %mo ⟵
                            %mo ∨
                        %mtd
                          %mi H
                          %mo ⊗
                          %mi H
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  (H\otimes H)\otimes H&amp;\to^\sim&amp;H\otimes(H\otimes H)\\\downarrow^{\vee\otimes H}&amp;&amp;\downarrow_{H\otimes\vee}\\H\otimes H&amp;\overset{\vee}{\leftarrow} H\overset{\vee}{\longleftarrow}&amp;H\otimes H
                  }
          .maruku-equation
            %math#mathml_f266a8451c55d2f6723644a39c392c7c3d108114_17.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi I
                          %mo ⊗
                          %mi H
                        %mtd
                          %msup
