                  %div
                    %p
                      %a{:href => "/nlab/edit/%28infinity%2C1%29-topos+-+contents"} Edit this sidebar
          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %ul
                %li
                  %a{:href => "#in_higher_topos_theory"} In higher topos theory
                %li
                  %a{:href => "#in_homotopy_type_theory"} In homotopy type theory
              %li
                %a{:href => "#OverviewOfTheBasicConcepts"} Overview of the basic concepts
              %li
