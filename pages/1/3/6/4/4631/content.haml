                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            may be thought of a
            %a.existingWikiWord{:href => "/nlab/show/space"} space
            made up of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/simplices"} simplices
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                  %mo ∈
                  %msub
                    %mi X
                    %mi n
                %annotation{:encoding => "application/x-tex"} \sigma \in X_n
            for all
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo ,
                    %mn 2
                    %mo ,
                    %mn 3
                    %mo ,
                    %mi ⋯
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} n \in \{0,1,2,3, \cdots \}
            %em augmented simplicial set
            additionally has a set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} X_{-1}
            of “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (-1)
            \-simplices” such that each 0-simplex has a single
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (-1)
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (-1)
            = succeed "-simplex" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
          %p
            Equivalently, this may be thought of as the data that encodes a
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mi const
                  %msub
                    %mi X
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} X \to const X_{-1}
            in
            %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
            between ordinary simplicial sets from an
            %em underlying
            simplicial set to a
            %em constant
            simplicial set with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} X_{-1}
            as its set of
            = succeed "-simplices" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          %p It is in this latter form that augmented simplicial sets maybe mostly arise in practice, whereas the former incarnation offers a more succinct way of thinking about them.
          %p
            For instance, a major source of augmented
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+object"} simplicial object
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+colimit"} homotopy colimit
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo{:lspace => "verythinmathspace"} :
                  %msup
                    %mi Δ
                    %mi op
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} X\colon \Delta^{op} \to C
            a simplicial object in a category with colimits, its colimit
            %a.existingWikiWord{:href => "/nlab/show/cocone"} cocone
            may be thought of as a morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mo •
                  %mo →
                  %mi const
                  %munder
                    %mi lim
                    %mo →
                  %msub
                    %mi X
                    %mo •
                %annotation{:encoding => "application/x-tex"}
                  X_\bullet \to const \lim_{\to} X_\bullet
          %p into the constant simplicial object.
          %h2#definitions Definitions
          %p
            Denote by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mo +
                %annotation{:encoding => "application/x-tex"} \Delta_+
            (also denoted
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi a
                  %annotation{:encoding => "application/x-tex"} \Delta_a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/augmented+simplex+category"} augmented simplex category
            %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
            of
            %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
            on the
            %a.existingWikiWord{:href => "/nlab/show/free+categories"} free categories
            over finite and
            %em possibly empty
            linear
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/directed+graphs"} directed graphs
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo :
                      %mo =
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} [-1] := \emptyset
                ;
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo{:stretchy => "false"} ]
                      %mo :
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} [0] := (0)
                ;
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo :
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo →
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} [1] := (0 \to 1)
                ;
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 2
                      %mo{:stretchy => "false"} ]
                      %mo :
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo →
                      %mn 1
                      %mo →
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} [2] := (0 \to 1 \to 2)
                ;
            %li
              %p and so on.
          %p
            An
            %strong augmented simplicial set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a
            %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mo +
                %annotation{:encoding => "application/x-tex"} \Delta_+
            and the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            of augmented simplicial sets,
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/ASSet"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi sSet
                        %mo +
                    %annotation{:encoding => "application/x-tex"} sSet_+
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msubsup
                    %mi Δ
                    %mo +
                    %mi op
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  [\Delta_+^{op}, Set]
                  \\,.
          %p
            There is a canonical inclusion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo ↪
                  %msub
                    %mi Δ
                    %mo +
                %annotation{:encoding => "application/x-tex"} \Delta \hookrightarrow \Delta_+
            of the ordinary
            %a.existingWikiWord{:href => "/nlab/show/simplex+category"} simplex category
            and the
            %a.existingWikiWord{:href => "/nlab/show/restriction"} restriction
            of an augmented simplicial set along this inclusion is a simplicial set. This gives a
            %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo :
                  %msub
                    %mi sSet
                    %mo +
                  %mo →
                  %mi sSet
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  U : sSet_+ \to sSet
                  \\,.
          %p A cartoon of an augmented simplicial set, showing just the face maps, looks like
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mo •
                  %mo =
                  %mrow
                    %mo (
                    %mi ⋯
                    %msub
                      %mi X
                      %mn 2
                    %mover
                      %mover
                        %mo →
                        %mo →
                      %mo →
                    %msub
                      %mi X
                      %mn 1
                    %mover
                      %munder
                        %mo →
                        %mrow
                          %msubsup
                            %mi d
                            %mn 0
                            %mn 0
                      %mover
                        %mo →
                        %mrow
                          %msubsup
                            %mi d
                            %mn 1
                            %mn 0
                    %msub
                      %mi X
                      %mn 0
                    %mover
                      %mo →
                      %mrow
                        %msup
                          %mi d
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                    %msub
                      %mi X
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo )
                %annotation{:encoding => "application/x-tex"}
                  X_\bullet =
                  \\left(
                  \\cdots
                  X_2 \stackrel{\to}{\stackrel{\to}{\to}} X_1 \stackrel{\overset{d^0_1}{\to}}{\underset{d^0_0}{\to}} X_0 \stackrel{d^{-1}}{\to} X_{-1}
                  \\right)
          %p
            where the only new
            %a.existingWikiWord{:href => "/nlab/show/simplicial+identity"} simplicial identity
            satisfied by the new face map in degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                %annotation{:encoding => "application/x-tex"} -1
            is that it coequalizes the degree-
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            face maps in that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi d
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo ∘
                  %msubsup
                    %mi d
                    %mn 1
                    %mn 0
                  %mo =
                  %msup
                    %mi d
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo ∘
                  %msubsup
                    %mi d
                    %mn 0
                    %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  d^{-1}\circ d^0_1 = d^{-1}\circ d^0_0
                  \\,.
          %p
            It follows that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi d
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} d^{-1}
            coequalizes every pair of composites of face maps
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi n
                    %mo →
                    %msub
                      %mi X
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} X_n \to X_0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mo •
                %annotation{:encoding => "application/x-tex"} X_\bullet
            is equivalent to a morphism of ordinary simplicial sets
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mo •
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi const
                  %msub
                    %mi X
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  U(X_\bullet) \to const X_{-1}
                  \\,.
          %p
            We say that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mo •
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} U(X_\bullet)
            is
            %em augmented
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} X_{-1}
          %p
            More explicitly, an
            %strong augmented simplicial set
            consists of
          %ul
            %li
              for each
              %a.existingWikiWord{:href => "/nlab/show/integer"} integer
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ≥
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n \geq -1
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi n
                  %annotation{:encoding => "application/x-tex"} X_n
              (so an
              %a.existingWikiWord{:href => "/nlab/show/infinite+sequence"} infinite sequence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ,
                    %msub
                      %mi X
                      %mn 0
                    %mo ,
                    %msub
                      %mi X
                      %mn 1
                    %mo ,
                    %msub
                      %mi X
                      %mn 2
                    %mo ,
                    %mi …
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X_{-1},X_0,X_1,X_2,\ldots)
              of sets),
            %li
              for each integer
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n \geq -1
              and each
              %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                      %mo ≤
                      %mi n
                      %mo +
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} m \leq n + 1
              %strong face map
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi d
                        %mi m
                        %mi n
                      %mo{:lspace => "verythinmathspace"} :
                      %msub
                        %mi X
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mo →
                      %msub
                        %mi X
                        %mi n
                    %annotation{:encoding => "application/x-tex"} d^n_m\colon X_{n+1} \to X_n
            %li
              for each integer
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n \geq -1
              and each natural number
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                      %mo ≤
                      %mi n
                    %annotation{:encoding => "application/x-tex"} m \leq n
              %strong degeneracy map
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi s
                        %mi m
                        %mi n
                      %mo{:lspace => "verythinmathspace"} :
                      %msub
                        %mi X
                        %mi n
                      %mo →
                      %msub
                        %mi X
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} s^n_m\colon X_n \to X_{n+1}
            %li
              satisfying the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+identities"} simplicial identities
          %p
            Above, we use the traditional system of numbering for a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
          %ul
            %li
              for each
              %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi n
                  %annotation{:encoding => "application/x-tex"} X_n
              (so an
              %a.existingWikiWord{:href => "/nlab/show/infinite+sequence"} infinite sequence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 0
                    %mo ,
                    %msub
                      %mi X
                      %mn 1
                    %mo ,
                    %msub
                      %mi X
                      %mn 2
                    %mo ,
                    %mi …
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X_0,X_1,X_2,\ldots)
              of sets),
            %li
              for each natural number
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              and each natural number
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
