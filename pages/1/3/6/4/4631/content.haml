                          %mi op
                        %mo ,
                        %mi sSet
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} C(U) \in [C^{op}, sSet]
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo{:lspace => "verythinmathspace"} :
                        %mi C
                        %mo{:stretchy => "false"} (
                        %mi U
