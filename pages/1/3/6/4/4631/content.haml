          %h2#examples Examples
          %ul
            %li
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/site"} site
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi U
                        %mi i
                      %mo →
                      %mi X
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{U_i \to X\}
                a
                %a.existingWikiWord{:href => "/nlab/show/covering"} covering
                family, we have the
                %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
                %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaf"} simplicial presheaf
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                        %mo{:stretchy => "false"} (
                        %mi U
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %mo{:stretchy => "false"} [
                        %msup
