          %h2#warning Warning
          %p
            %em
              The term ‘frame’ is used in a different sense here than in
              = succeed ";" do
                %a.existingWikiWord{:href => "/nlab/show/geometric+logic"} geometric logic
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/frame"} frame
              %a.existingWikiWord{:href => "/nlab/show/Kripke+frames"} Kripke frames
              in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/modal+logic"} modal logic
          %h2#idea Idea
          %p
            A
            %strong ternary frame
            is a way of presenting a model for a
            %a.existingWikiWord{:href => "/nlab/show/substructural+logic"} substructural logic
            (such as
            %a.existingWikiWord{:href => "/nlab/show/linear+logic"} linear logic
            and
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/relevant+logic"} relevant logic
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/relation"} relation
          %p
            The construction generalizes from
            %a.existingWikiWord{:href => "/nlab/show/posets"} posets
            to
            %a.existingWikiWord{:href => "/nlab/show/categories"} categories
            using the
            %a.existingWikiWord{:href => "/nlab/show/Day+convolution"} Day convolution
            of a
            %a.existingWikiWord{:href => "/nlab/show/promonoidal+category"} promonoidal category
            (
            %a{:href => "#dayconvolution"}> see below
            ), or a “promagmal category” in the weakest version.
          %h2#definition Definition
          %p
            A
            %strong ternary frame
            is a set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            together with a ternary relation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            on
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mi x
                  %mi y
                  %mi z
                %annotation{:encoding => "application/x-tex"} R x y z
            when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            holds of three elements
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ,
                    %mi y
                    %mo ,
                    %mi z
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} x,y,z\in A
          %p
            We may additionally ask that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            have a
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/partial+ordering"} partial ordering
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mi x
                  %mi y
                  %mi z
                %annotation{:encoding => "application/x-tex"} R x y z
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ′
                    %mo ≤
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x'\le x
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ′
                    %mo ≤
                    %mi y
                  %annotation{:encoding => "application/x-tex"} y'\le y
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                    %mo ≤
                    %mi z
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} z\le z'
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mi x
                    %mo ′
                    %mi y
                    %mo ′
                    %mi z
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} R x' y' z'
          %h2#modeling_substructural_logic Modeling substructural logic
          %p
            We can model
            %a.existingWikiWord{:href => "/nlab/show/logic"} logic
            using a ternary frame with a “forcing” or “satisfaction” relation between points of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and formulas. We begin by assigning to each
            %span.newWikiWord
              atomic formula
              %a{:href => "/nlab/new/atomic+formula"} ?
            a set of points of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            which satisfy it. If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            has a partial order, as above, then we ask each of these sets to be up-closed.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/logical+connectives"} logical connectives
            can then be defined inductively by clauses such as the following:
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ⊩
                    %mi P
                    %mi &amp;
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} x \Vdash P \&amp; Q
              (the negative
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/conjunction"} conjunction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ⊩
                    %mi P
                  %annotation{:encoding => "application/x-tex"} x\Vdash P
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ⊩
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} x\Vdash Q
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ⊩
                    %mi P
                    %mo ⊕
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} x \Vdash P \oplus Q
              (the positive
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/disjunction"} disjunction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ⊩
                    %mi P
                  %annotation{:encoding => "application/x-tex"} x \Vdash P
              or
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ⊩
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} x\Vdash Q
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ⊩
                    %mstyle{:mathvariant => "bold"}
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} x \Vdash \mathbf{0}
              (the positive
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/falsity"} falsity
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ⊩
                    %mo ⊤
                  %annotation{:encoding => "application/x-tex"} x \Vdash \top
              (the negative
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/truth"} truth
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ⊩
                    %mi P
                    %mo ⊗
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} x \Vdash P \otimes Q
              (the positive conjunction) if and only if there exist
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ,
                    %mi z
                  %annotation{:encoding => "application/x-tex"} y,z
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mi y
                    %mi z
                    %mi x
                  %annotation{:encoding => "application/x-tex"} R y z x
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ⊩
                    %mi P
                  %annotation{:encoding => "application/x-tex"} y\Vdash P
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi z
                      %mo ⊩
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} z\Vdash Q
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ⊩
                    %mi P
                    %mo ⊸
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} x \Vdash P \multimap Q
              (the one-sided linear implication) if and only if for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo ,
                      %mi z
                    %annotation{:encoding => "application/x-tex"} y,z
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mi x
                    %mi y
                    %mi z
                  %annotation{:encoding => "application/x-tex"} R x y z
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo ⊩
                      %mi P
                    %annotation{:encoding => "application/x-tex"} y\Vdash P
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi z
                      %mo ⊩
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} z\Vdash Q
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ⊩
                    %mi Q
                    %mi ⟜
                    %mi P
                  %annotation{:encoding => "application/x-tex"} x \Vdash Q &amp;#10204; P
              (the dual linear implication) if and only if for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo ,
                      %mi z
                    %annotation{:encoding => "application/x-tex"} y,z
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mi x
                    %mi y
                    %mi z
                  %annotation{:encoding => "application/x-tex"} R x y z
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi z
                      %mo ⊩
                      %mi P
                    %annotation{:encoding => "application/x-tex"} z\Vdash P
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo ⊩
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} y\Vdash Q
          %p
            The logic obtained thereby will generally be
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/substructural+logic"} substructural
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/weakening+rule"} weakening
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/contraction+rule"} contraction
            %a.existingWikiWord{:href => "/nlab/show/exchange+rule"} exchange
            or even associativity and unit for the tensor product. On this page, we have used the notation for substructural connectives from
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/linear+logic"} linear logic
          %h2#additional_structure Additional structure
          %p
            We can impose properties or structure on the ternary frame to affect the logic. For instance, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mi x
                  %mi y
                  %mi z
                %annotation{:encoding => "application/x-tex"} R x y z
            implies
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mi y
                    %mi x
                    %mi z
                  %annotation{:encoding => "application/x-tex"} R y x z
          %p We also need additional structure in order to model positive truth, negative falsity, negative disjunction, and negation.
          %h3#truth_sets Truth sets
          %p
            A
            %strong truth set
            in an ordered ternary frame is a subset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo ⊆
                  %mi A
                %annotation{:encoding => "application/x-tex"} T\subseteq A
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ≤
                  %mi y
                %annotation{:encoding => "application/x-tex"} x\le y
            if and only if there exists a
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo ∈
                  %mi T
                %annotation{:encoding => "application/x-tex"} t\in T
            with
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mi t
                    %mi x
                    %mi y
                  %annotation{:encoding => "application/x-tex"} R t x y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mo ∈
                  %mi T
                %annotation{:encoding => "application/x-tex"} s\in T
            with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mi x
                    %mi s
                    %mi y
                  %annotation{:encoding => "application/x-tex"} R x s y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is commutative, as above, then the two conditions are equivalent.) Alternatively, given an unordered ternary frame
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and a subset
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %em define
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ≤
                  %mi y
                %annotation{:encoding => "application/x-tex"} x\le y
            in this way, and then require as a property of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            that the resulting relation is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/partial+order"} partial order
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            is a truth set, then it makes sense to define
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ⊩
                    %mstyle{:mathvariant => "bold"}
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} x \Vdash \mathbf{1}
              (the positive truth) if and only if
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi T
                    %annotation{:encoding => "application/x-tex"} x\in T
          %h3#compatibility_relations Compatibility relations
          %p
            One way to model negation (and thereby obtain negative falsity
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊥
                %annotation{:encoding => "application/x-tex"} \bot
            and negative disjunction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⅋
                %annotation{:encoding => "application/x-tex"} \parr
            by duality from positive truth
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \mathbf{1}
            and positive conjunction
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊗
                  %annotation{:encoding => "application/x-tex"} \otimes
            = succeed "," do
              %strong compatibility relation
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            has a partial order, we demand additionally that if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mi C
                  %mi y
                %annotation{:encoding => "application/x-tex"} x C y
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ′
                  %mo ≤
                  %mi x
                %annotation{:encoding => "application/x-tex"} x'\le x
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ≤
                    %mi y
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} y\le y'
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ′
                    %mi C
                    %mi y
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} x' C y'
          %p
            Given such a
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ⊩
                    %mo ¬
                    %mi P
                  %annotation{:encoding => "application/x-tex"} x \Vdash \neg P
              if and only if for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                    %annotation{:encoding => "application/x-tex"} y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mi C
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x C y
              then not
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo ⊩
                      %mi P
                    %annotation{:encoding => "application/x-tex"} y\Vdash P
          %h3#falsity_sets Falsity sets
          %p
            Negation can alternatively be modeled using a
            = succeed "." do
              %em false set
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ⊆
                    %mi A
                  %annotation{:encoding => "application/x-tex"} F\subseteq A
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊥
                  %annotation{:encoding => "application/x-tex"} \bot
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ⊩
                    %mo ⊥
                  %annotation{:encoding => "application/x-tex"} x\Vdash \bot
              if and only if
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi F
                    %annotation{:encoding => "application/x-tex"} x\in F
          %p
            We can then, if we wish, interpret negation and negative disjunction by defining
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ¬
                  %mi P
                  %mo ≔
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo ⊸
                  %mo ⊥
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \neg P \coloneqq (P\multimap \bot)
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ⅋
                    %mi Q
                    %mo ≔
                    %mo ¬
                    %mo{:stretchy => "false"} (
                    %mo ¬
                    %mi P
                    %mo ⊗
                    %mo ¬
                    %mi Q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P\parr Q \coloneqq \neg (\neg P \otimes \neg Q)
          %p
            The latter is most sensible if negation is involutive, which it need not be in general — that is, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ⊩
                  %mo ¬
                  %mo ¬
                  %mi P
                %annotation{:encoding => "application/x-tex"} x \Vdash \neg \neg P
            we need not have
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ⊩
                    %mi P
                  %annotation{:encoding => "application/x-tex"} x\Vdash P
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊩
                %annotation{:encoding => "application/x-tex"} \Vdash
            under double-negation. This entails replacing the clauses defining the interpretation of the positive connectives
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊗
                  %annotation{:encoding => "application/x-tex"} \otimes
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊕
                  %annotation{:encoding => "application/x-tex"} \oplus
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbf{1}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mn 0
                %annotation{:encoding => "application/x-tex"} \mathbf{0}
            with their double-negation closure. This is commonly done in the
            %a.existingWikiWord{:href => "/nlab/show/phase+semantics"} phase semantics
            for linear logic (see below).
          %h2#dayconvolution From ternary frames to quantales
          %p
            Since the models above associate to formulas
            %em subsets
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %a.existingWikiWord{:href => "/nlab/show/powerset"} powerset
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is a poset, instead of the powerset of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            we must use the set of up-closed subsets of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            to be a poset, with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            having the assumed compatibility relation.
          %p In fact, this axiom (which we repeat here for the reader’s convenience):
          %ul
            %li
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mi x
                    %mi y
                    %mi z
                  %annotation{:encoding => "application/x-tex"} R x y z
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ′
                      %mo ≤
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x'\le x
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo ′
                      %mo ≤
                      %mi y
                    %annotation{:encoding => "application/x-tex"} y'\le y
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi z
                      %mo ≤
                      %mi z
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} z\le z'
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mi x
                      %mo ′
                      %mi y
                      %mo ′
                      %mi z
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} R x' y' z'
          %p
            says precisely that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbf{2}
            %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched
            %a.existingWikiWord{:href => "/nlab/show/profunctor"} profunctor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mi op
                    %mo ×
                    %msup
                      %mi A
                      %mi op
                    %mi ⇸
                    %msup
                      %mi A
                      %mi op
                  %annotation{:encoding => "application/x-tex"} A^{op} \times A^{op} &amp;#8696; A^{op}
            = succeed "-enriched" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbf{2}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \mathbf{2}
            is the
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/interval+category"} interval category
          %p
            Therefore, by
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Day+convolution"} Day convolution
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            induces a binary tensor product on the
            = succeed "-enriched" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbf{2}
            %a.existingWikiWord{:href => "/nlab/show/presheaf+category"} presheaf category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mn 2
                      %mi A
                  %annotation{:encoding => "application/x-tex"} \mathbf{2}^A
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊗
                  %annotation{:encoding => "application/x-tex"} \otimes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊸
                %annotation{:encoding => "application/x-tex"} \multimap
            and its dual.
          %p
            Of course, the interpretations of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi &amp;
                %annotation{:encoding => "application/x-tex"} \&amp;
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊕
                %annotation{:encoding => "application/x-tex"} \oplus
            are just the categorical product and coproduct in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mn 2
                      %mi A
                  %annotation{:encoding => "application/x-tex"} \mathbf{2}^A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mn 0
                %annotation{:encoding => "application/x-tex"} \mathbf{0}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊤
                %annotation{:encoding => "application/x-tex"} \top
            are the initial and terminal objects.
          %p
            A truth set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            corresponds to a profunctor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mi ⇸
                  %msup
                    %mi A
                    %mi op
                %annotation{:encoding => "application/x-tex"} 1 &amp;#8696; A^{op}
            which is a unit for the pro-multiplication
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mn 2
                    %mi A
                %annotation{:encoding => "application/x-tex"} \mathbf{2}^A
            has a unit object, which is precisely
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbf{1}
          %p
            If we were to additionally add the assumption that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is
            = succeed "," do
              %em associative
          %ul
            %li
              there exists a
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                  %annotation{:encoding => "application/x-tex"} z
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mi x
                    %mi y
                    %mi z
                  %annotation{:encoding => "application/x-tex"} R x y z
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mi z
                    %mi u
                    %mi v
                  %annotation{:encoding => "application/x-tex"} R z u v
              if and only if there exists a
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi w
                  %annotation{:encoding => "application/x-tex"} w
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mi x
                    %mi w
                    %mi v
                  %annotation{:encoding => "application/x-tex"} R x w v
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mi y
                    %mi u
                    %mi w
                  %annotation{:encoding => "application/x-tex"} R y u w
          %p
            then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi A
                    %mi op
                %annotation{:encoding => "application/x-tex"} A^{op}
            would become a
            %a.existingWikiWord{:href => "/nlab/show/promonoidal+category"} promonoidal
            poset, and hence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mn 2
                    %mi A
                %annotation{:encoding => "application/x-tex"} \mathbf{2}^A
            would be a complete and cocomplete closed monoidal poset, i.e. a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/quantale"} quantale
          %p
            A false set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            is of course just an arbitrary object of this quantale. Closing up under double-negation means restricting to the sub-poset of elements that are equal to their “double dual”
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ⊸
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mo ⊸
                    %mi F
                  %annotation{:encoding => "application/x-tex"} x = (x \multimap F) \multimap F
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ⊸
                  %mi F
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (-\multimap F)
            is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/idempotent+adjunction"} idempotent
            %a.existingWikiWord{:href => "/nlab/show/star-autonomous+category"} *-autonomous
            one.
          %p
            The quantale-theoretic content of a compatibility relation is somewhat trickier: as defined it is a profunctor from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            to itself, whereas the negation of a pro-
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mo *
                %annotation{:encoding => "application/x-tex"} *
            \-autonomous poset would be a profunctor from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi A
                    %mi op
                %annotation{:encoding => "application/x-tex"} A^{op}
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mn 2
                    %mi A
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mn 2
                    %mi A
                %annotation{:encoding => "application/x-tex"} (\mathbf{2}^A)^{op} \to \mathbf{2}^{A}
            due to the special property that
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mn 2
                    %mo ≅
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mn 2
                      %mi op
                  %annotation{:encoding => "application/x-tex"} \mathbf{2}\cong \mathbf{2}^{op}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ⊩
                  %mo ¬
                  %mi P
                %annotation{:encoding => "application/x-tex"} x \Vdash \neg P
            for a compatibility relation is also the (metatheoretic)
            %em negation
            of the map on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mn 2
                    %mi A
                %annotation{:encoding => "application/x-tex"} \mathbf{2}^A
            that would be induced profunctorially. If we put these together, we can see that negation ought to be the the composite of the map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mn 2
                    %mi A
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mn 2
                    %mi A
                %annotation{:encoding => "application/x-tex"} \mathbf{2}^A \to \mathbf{2}^A
            induced by the profunctor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            with the isomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mn 2
                    %mi A
                  %mo ≅
                  %mo{:stretchy => "false"} (
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mn 2
                    %mrow
                      %msup
                        %mi A
                        %mi op
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                %annotation{:encoding => "application/x-tex"} \mathbf{2}^A \cong (\mathbf{2}^{A^{op}})^{op}
            (using again that
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mn 2
                    %mo ≅
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mn 2
                      %mi op
                  %annotation{:encoding => "application/x-tex"} \mathbf{2}\cong \mathbf{2}^{op}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is discrete, so that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ≅
                    %msup
                      %mi A
                      %mi op
                  %annotation{:encoding => "application/x-tex"} A\cong A^{op}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mn 2
                    %mi A
                %annotation{:encoding => "application/x-tex"} \mathbf{2}^A
            = succeed "-autononmous." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} *
          .query
            %p To be completed…
          %h3#generalizations Generalizations
          %p
            The quantale-theoretic viewpoint suggests a generalization replacing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \mathbf{2}
            by any other quantale. That is, for any quantale
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
            = succeed "-valued" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                %annotation{:encoding => "application/x-tex"} Q
            itself to be
            = succeed "-autonomous." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} *
          %h2#examples Examples
          %h3#phase_spaces Phase spaces
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is a
            %a.existingWikiWord{:href => "/nlab/show/magma"} magma
            with multiplication
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⋅
                  %annotation{:encoding => "application/x-tex"} \cdot
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mi x
                  %mi y
                  %mi z
                %annotation{:encoding => "application/x-tex"} R x y z
            to mean
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ⋅
                    %mi y
                    %mo =
                    %mi z
                  %annotation{:encoding => "application/x-tex"} x \cdot y = z
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is a poset equipped with a binary multiplication
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⋅
                  %annotation{:encoding => "application/x-tex"} \cdot
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mi x
                  %mi y
                  %mi z
                %annotation{:encoding => "application/x-tex"} R x y z
            to mean
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ⋅
                    %mi y
                    %mo ≤
                    %mi z
                  %annotation{:encoding => "application/x-tex"} x \cdot y \le z
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⋅
                %annotation{:encoding => "application/x-tex"} \cdot
            has a unit object
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi t
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} T = \{t\}
            (in the unordered case) or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi x
                  %mo{:stretchy => "false"} |
                  %mi t
                  %mo ≤
                  %mi x
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} T = \{x | t \le x \}
            (in the ordered case) is a truth set.
          %p
            Categorically, this corresponds to the usual way of regarding a
            %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            as a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/promonoidal+category"} promonoidal category
          %p
            In the special case when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is a commutative
            %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
            equipped with a “false set”
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            as above (usually written
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊥
                  %annotation{:encoding => "application/x-tex"} \bot
            %a.existingWikiWord{:href => "/nlab/show/phase+semantics"} phase semantics
            (see there for more). It is usually expressed in terms of the quantale
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mn 2
                    %mi A
                %annotation{:encoding => "application/x-tex"} \mathbf{2}^A
            obtained by Day convolution, but after passing to fixed points of the double-negation monad (in order to obtain an involutive negation). In this context, fixed points of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ¬
                  %mo ¬
                %annotation{:encoding => "application/x-tex"} \neg\neg
            are referred to as
            = succeed "." do
              %em facts
          %p
            It is also possible to interpret the exponential modalities
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo !
                %annotation{:encoding => "application/x-tex"} !
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ?
                %annotation{:encoding => "application/x-tex"} ?
            of linear logic using phase space semantics. For instance, we can define
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ⊩
                    %mo !
                    %mi P
                  %annotation{:encoding => "application/x-tex"} x \Vdash !P
              if and only if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              belongs to the
              = succeed "-closure" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ¬
                      %mo ¬
                    %annotation{:encoding => "application/x-tex"} \neg\neg
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo ⊩
                      %mi P
                      %mi &amp;
                      %mstyle{:mathvariant => "bold"}
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} y\Vdash P \&amp; \mathbf{1}
          %p
            and obtain
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ?
                  %mi P
                %annotation{:encoding => "application/x-tex"} ?P
            by duality.
          %p
            Phase space semantics is
            %em complete
            for
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/linear+logic"} linear logic
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ⊨
                    %mi P
                  %annotation{:encoding => "application/x-tex"} 1\vDash P
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            is the unit element of the monoid
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %h3#pcas PCAs
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is a
            %a.existingWikiWord{:href => "/nlab/show/partial+combinatory+algebra"} partial combinatory algebra
            (PCA), we can make it a ternary frame by defining
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mi x
                  %mi y
                  %mi z
                %annotation{:encoding => "application/x-tex"} R x y z
            to mean that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ⋅
                  %mi y
                %annotation{:encoding => "application/x-tex"} x \cdot y
            is defined and equals
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                  %annotation{:encoding => "application/x-tex"} z
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is an ordered PCA we can make it an ordered ternary frame.) The resulting interpretation of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊸
                %annotation{:encoding => "application/x-tex"} \multimap
            almost coincides with the usual interpretation of implication in
            %a.existingWikiWord{:href => "/nlab/show/realizability"} realizability
            over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo ,
                  %mi s
                %annotation{:encoding => "application/x-tex"} k,s
            have the property that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo ⊩
                  %mi P
                  %mo ⊸
                  %mo{:stretchy => "false"} (
                  %mi Q
                  %mo ⊸
                  %mi P
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} k \Vdash P \multimap (Q \multimap P)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mo ⊩
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo ⊸
                  %mi Q
                  %mo ⊸
                  %mi R
                  %mo{:stretchy => "false"} )
                  %mo ⊸
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo ⊸
                  %mi Q
                  %mo{:stretchy => "false"} )
                  %mo ⊸
                  %mi P
                  %mo ⊸
                  %mi R
                %annotation{:encoding => "application/x-tex"} s \Vdash (P \multimap Q \multimap R) \multimap (P \multimap Q) \multimap P \multimap R
            for any
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ,
                    %mi Q
                    %mo ,
                    %mi R
                  %annotation{:encoding => "application/x-tex"} P,Q,R
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/combinatory+logic"} combinatory logic
          %h2#references References
