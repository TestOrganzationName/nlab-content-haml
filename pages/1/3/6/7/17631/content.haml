                to
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 1
                        %mo +
                        %mi Moun
                        %mo{:stretchy => "false"} (
                        %mi w
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mi j
                        %mo −
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} 1 + Moun(w)(j-1)
          %p
            The map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                  %mo :
                  %mi Tree
                  %mo →
                  %mi Range
                %annotation{:encoding => "application/x-tex"} \rho: Tree \to Range
            is defined to be the restriction of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Moun
                %annotation{:encoding => "application/x-tex"} Moun
            along the canonical inclusion
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Tree
                    %mo ↪
                    %msup
                      %mi Tree
                      %mo *
                  %annotation{:encoding => "application/x-tex"} Tree \hookrightarrow Tree^\ast
          .num_prop
            %h6#proposition_3 Proposition
            %p
              The mapping
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo ↦
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} T \mapsto \rho(T)
              defines a bijection from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Tree
                      %mi n
                  %annotation{:encoding => "application/x-tex"} Tree_n
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Range
                      %mi n
                  %annotation{:encoding => "application/x-tex"} Range_n
              , consisting of mountain ranges of the form
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mo{:stretchy => "false"} [
                      %mn 2
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} f: [2n] \to \mathbb{N}
          %p
            The inverse mapping can be described as follows. For each mountain range
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mo{:stretchy => "false"} [
                    %mn 2
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} f: [2n] \to \mathbb{N}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mn 2
                  %mi n
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [2n]
            into subintervals according to subdivision points
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                  %msub
                    %mi n
                    %mi k
                %annotation{:encoding => "application/x-tex"} 2n_k
            where
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %msub
                      %mi n
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
