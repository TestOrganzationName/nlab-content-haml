          %h2#idea Idea
          %p
            Catalan numbers are a specific sequence of
            %a.existingWikiWord{:href => "/nlab/show/negative+number"} nonnegative
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/integers"} integers
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mi n
                  %annotation{:encoding => "application/x-tex"} C_n
            %a.existingWikiWord{:href => "/nlab/show/combinatorics"} combinatorial
            interpretations. In terms of
            %a.existingWikiWord{:href => "/nlab/show/binomial+coefficients"} binomial coefficients
            they are given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mi n
                  %mo =
                  %mfrac
                    %mn 1
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mrow
                    %mo (
                    %mfrac{:linethickness => "0"}
                      %mrow
                        %mn 2
                        %mi n
                      %mi n
                    %mo )
                  %mo =
                  %mfrac
                    %mn 1
                    %mrow
                      %mn 2
                      %mi n
                      %mo +
                      %mn 1
                  %mrow
                    %mo (
                    %mfrac{:linethickness => "0"}
                      %mrow
                        %mn 2
                        %mi n
                        %mo +
                        %mn 1
                      %mi n
                    %mo )
                  %mo =
                  %mfrac
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mi n
                      %mo{:stretchy => "false"} )
                      %mo !
                    %mrow
                      %mi n
                      %mo !
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo !
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  C_n = \frac{1}{n+1}\binom{2 n}{n} = \frac1{2n+1}\binom{2n+1}{n} = \frac{(2n)!}{n!(n+1)!}
                  \\,.
          %p
            The Catalan numbers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mi n
                %annotation{:encoding => "application/x-tex"} C_n
            count a myriad of different families of objects, including:
          %ul
            %li
              %p
                nonisomorphic (rooted planar) binary
                %a.existingWikiWord{:href => "/nlab/show/trees"} trees
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                internal
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/vertices"} vertices
            %li
              %p
                ways of unambiguously defining the product of elements
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi x
                        %mn 0
                      %mo ,
                      %mi …
                      %mo ,
                      %msub
                        %mi x
                        %mi n
                    %annotation{:encoding => "application/x-tex"} x_0,\dots,x_n
                within an arbitrary (not necessarily
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/associative"} associative
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/magma"} magma
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n+1
                letters;
            %li
              %p
                elements of the free magma
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Mag
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Mag(x)
                generated by a singleton
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
                (called
                = succeed ")" do
                  %em words
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n+1
                instances of the letter
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x
            %li
              %p
                nonisomorphic rooted planar
                %a.existingWikiWord{:href => "/nlab/show/trees"} trees
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/edges"} edges
            %li
              %p
                strings consisting of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                well-balanced pairs of parentheses (also known as “Dyck words”), or equivalently,
                %a.existingWikiWord{:href => "/nlab/show/surjective"} surjective
                %a.existingWikiWord{:href => "/nlab/show/monotone+functions"} monotone functions
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi w
                      %mo :
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} w : (n) + (n) \to (2n)
                such that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi w
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi ι
                        %mn 1
                      %mi j
                      %mo{:stretchy => "false"} )
                      %mo ≤
                      %mi w
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi ι
                        %mn 2
                      %mi j
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} w(\iota_1 j) \le w(\iota_2 j)
                for all
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mo ≤
                      %mi j
                      %mo ≤
                      %mi n
                    %annotation{:encoding => "application/x-tex"} 1 \le j \le n
                (where we write
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (k)
                for the finite
                %a.existingWikiWord{:href => "/nlab/show/ordinal"} ordinal
                = succeed ");" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi k
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo{:stretchy => "false"} {
                        %mn 1
                        %mo ,
                        %mi …
                        %mo ,
                        %mi k
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} (k) = \{1,\dots,k\}
            %li
              %p
                monotonic lattice paths in an
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ×
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n\times n
                grid which do not cross below the diagonal, or equivalently,
                %a.existingWikiWord{:href => "/nlab/show/injective"} injective
                %a.existingWikiWord{:href => "/nlab/show/monotone+functions"} monotone functions
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo :
                      %mo{:stretchy => "false"} [
                      %mn 2
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo ×
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} p : [2n] \to [n] \times [n]
                such that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 1
                      %mi p
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo{:stretchy => "false"} )
                      %mo ≤
                      %msub
                        %mi π
                        %mn 2
                      %mi p
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi_1 p(i) \le \pi_2 p(i)
                for all
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo ≤
                      %mi i
                      %mo ≤
                      %mn 2
                      %mi n
                    %annotation{:encoding => "application/x-tex"} 0 \le i \le 2n
                (where we write
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi k
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [k]
                for the non-empty finite
                %a.existingWikiWord{:href => "/nlab/show/ordinal"} ordinal
                = succeed ");" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi k
                        %mo{:stretchy => "false"} ]
                        %mo =
                        %mo{:stretchy => "false"} {
                        %mn 0
                        %mo ,
                        %mi …
                        %mo ,
                        %mi k
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} [k] = \{0,\dots,k\}
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/monotone+functions"} monotone functions
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} f : [n] \to [n]
                such that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} f(0) = 0
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ≤
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} x \le f(x)
                for all
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 0
                        %mo ≤
                        %mi x
                        %mo ≤
                        %mi n
                      %annotation{:encoding => "application/x-tex"} 0 \le x \le n
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} f : [n] \to [n]
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Δ
                        %mo ⊥
                    %annotation{:encoding => "application/x-tex"} \Delta_\bot
                (the sub-2-category of the
                %a.existingWikiWord{:href => "/nlab/show/simplex+category"} simplex 2-category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                    %annotation{:encoding => "application/x-tex"} \Delta
                spanned by the first-element-preserving functions) which are
                %em pointed
                in the sense of being equipped with a 2-cell
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} id
                          %mrow
                            %mo{:stretchy => "false"} [
                            %mi n
                            %mo{:stretchy => "false"} ]
                        %mo ⇒
                        %mi f
                      %annotation{:encoding => "application/x-tex"} \id_{[n]} \Rightarrow f
            %li
              %p
                “mountain ranges”, i.e., functions
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mo{:stretchy => "false"} [
                      %mn 2
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} f: [2n] \to \mathbb{N}
                such that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                      %mo =
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f(0) = 0 = f(2n)
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi j
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo −
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi j
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mo{:stretchy => "false"} {
                      %mn 1
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} f(j+1) - f(j) \in \{1, -1\}
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo ≤
                      %mi j
                      %mo &lt;
                      %mn 2
                      %mi n
                    %annotation{:encoding => "application/x-tex"} 0 \leq j \lt 2n
                (so called because graphs of such depict mountain ranges);
            %li
              %p
                “stay-ahead races”, i.e., functions
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mo{:stretchy => "false"} [
                      %mn 2
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mo{:stretchy => "false"} {
                      %mn 1
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} f: [2n] \to \{1, -1\}
                such that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi i
                          %mo =
                          %mn 0
                        %mi j
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo{:stretchy => "false"} )
                      %mo &gt;
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \sum_{i=0}^j f(i) \gt 0
                for
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 0
                        %mo ≤
                        %mi j
                        %mo ≤
                        %mn 2
                        %mi n
                      %annotation{:encoding => "application/x-tex"} 0 \leq j \leq 2n
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi i
                          %mo =
                          %mn 0
                        %mrow
                          %mn 2
                          %mi n
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} \sum_{i=0}^{2n} f(i) = 1
                (see below for explanation of terminology);
          %p
            and many, many more besides (see the
            %a{:href => "#Stanley2015"} Stanley
            references and OEIS
            = succeed ")." do
              %a{:href => "#a000108"} A000108
          %h2#some_structural_bijections Some structural bijections
          %p
            In this section we describe some “canonical” isomorphisms between various structures named above. Most of these can be seen as isomorphisms between various
            %a.existingWikiWord{:href => "/nlab/show/species"} species
            of structures, which collectively might be called “the Catalan species”.
          %h3#rooted_planar_binary_trees_and_magma_words Rooted planar binary trees and magma words
          %p
            Each (finite) rooted planar binary tree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            internal vertices (i.e., vertices that have a left child and a right child) either consists of only a root (the case
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} n=0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mi l
                %annotation{:encoding => "application/x-tex"} T_l
            and a right subtree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mi r
                %annotation{:encoding => "application/x-tex"} T_r
            adjacent to the root. The associated magma word
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi Mag
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} m(T) \in Mag(x)
            is defined recursively according to these cases:
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi x
                    %annotation{:encoding => "application/x-tex"} m(T) = x
                in the case
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} n=0
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi m
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi T
                        %mi l
                      %mo{:stretchy => "false"} )
                      %mi m
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi T
                        %mi r
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} m(T) = m(T_l) m(T_r)
                [expressing the magma product by simple juxtaposition] in the case
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo &gt;
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} n \gt 0
          %p
            Put slightly differently, the collection of isomorphism classes of rooted planar binary trees carries a magma structure, defined by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi T
                    %mi l
                  %mo ,
                  %msub
                    %mi T
                    %mi r
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mi T
                %annotation{:encoding => "application/x-tex"} (T_l, T_r) \mapsto T
            using the notation above, and we have the following result.
          .num_prop
            %h6#proposition Proposition
            %p
              The mapping
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo ↦
                    %mi m
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} T \mapsto m(T)
              defines a bijection from the set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Bin
                      %mi n
                  %annotation{:encoding => "application/x-tex"} Bin_n
              of isomorphism clases of rooted planar binary trees with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              internal vertices to the set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Mag
                    %mo{:stretchy => "false"} (
                    %mi x
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                  %annotation{:encoding => "application/x-tex"} Mag(x)_n
              of magma words with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n+1
              instances of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
          %p
            The inverse is given by the unique magma map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Mag
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Bin
                %annotation{:encoding => "application/x-tex"} Mag(x) \to Bin
            that takes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            to the isomorphism class of trees consisting of just a root.
          %h3#magma_words_and_rooted_planar_trees Magma words and rooted planar trees
          %p
            It is often suggestive to use exponential notation to denote the magma operation:
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %msup
                      %mi x
                      %mi y
                  %annotation{:encoding => "application/x-tex"} (x, y) \mapsto x^y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            of the free magma
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Mag
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Mag(x)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi a
                  %annotation{:encoding => "application/x-tex"} (-)^a
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Mag
                  %mo{:stretchy => "false"} (
                  %mi x
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo *
                %annotation{:encoding => "application/x-tex"} Mag(x)^\ast
            denotes the free monoid on the set
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Mag
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Mag(x)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo :
                  %mi Mag
                  %mo{:stretchy => "false"} (
                  %mi x
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo *
                  %mo →
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %mi Mag
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi Mag
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \phi: Mag(x)^\ast \to \hom(Mag(x), Mag(x))
          %p
            that carries
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ∈
                  %mi Mag
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} a \in Mag(x)
            to the unary operation
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi a
                  %annotation{:encoding => "application/x-tex"} (-)^a
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi Mag
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} a \in Mag(x)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Mag
                  %mo{:stretchy => "false"} (
                  %mi x
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo *
                  %mover
                    %mo →
                    %mi ϕ
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %mi Mag
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi Mag
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi eval
                        %mi a
                  %mi Mag
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Mag(x)^\ast \stackrel{\phi}{\to} \hom(Mag(x), Mag(x)) \stackrel{eval_a}{\to} Mag(x)
          %p
            by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi w
                    %mo ↦
                    %msup
                      %mi a
                      %mi w
                  %annotation{:encoding => "application/x-tex"} w \mapsto a^w
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Mag
                  %mo{:stretchy => "false"} (
                  %mi x
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo *
                %annotation{:encoding => "application/x-tex"} Mag(x)^\ast
            by simple juxtaposition. Under these conventions, we have for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ,
                  %mi b
                  %mo ,
                  %mi c
                  %mo ∈
                  %mi Mag
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} a, b, c \in Mag(x)
            the exponential equation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi a
                    %mi b
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi c
                  %mo =
                  %msup
                    %mi a
                    %mrow
                      %mi b
                      %mi c
                  %mo .
                %annotation{:encoding => "application/x-tex"} (a^b)^c = a^{b c}.
          %p
            If we regard the right-hand side of the exponential equation as a reduction of the left-hand side, then for any formal magma expression
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi a
                      %mi d
                  %annotation{:encoding => "application/x-tex"} a^d
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo =
                    %mi x
                  %annotation{:encoding => "application/x-tex"} a = x
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo =
                  %msup
                    %mi b
                    %mi c
                %annotation{:encoding => "application/x-tex"} a = b^c
            and then reduce
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi a
                    %mi d
                %annotation{:encoding => "application/x-tex"} a^d
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi b
                      %mrow
                        %mi c
                        %mi d
                  %annotation{:encoding => "application/x-tex"} b^{c d}
          %p
            Continuing recursively in this manner, every word
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ∈
                  %mi Mag
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} a \in Mag(x)
            can be eventually expressed as a “reduced form” (where no further reductions are possible), where we formally define a
            %strong reduced form
            as follows:
          %ul
            %li
              %p
                The expression
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
                is a reduced form;
            %li
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi w
                        %mn 1
                      %mo ,
                      %msub
                        %mi w
                        %mn 2
                      %mo ,
                      %mi …
                      %mo ,
                      %msub
                        %mi w
                        %mi n
                    %annotation{:encoding => "application/x-tex"} w_1, w_2, \ldots, w_n
                are reduced forms, then so is
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi x
                          %mrow
                            %msub
                              %mi w
                              %mn 1
                            %msub
                              %mi w
                              %mn 2
                            %mi …
                            %msub
                              %mi w
                              %mi n
                      %annotation{:encoding => "application/x-tex"} x^{w_1 w_2 \ldots w_n}
          %p
            The reader who is following where this is going will have observed that this recursive description of reduced forms matches precisely the recursive description of rooted planar trees, formalized by saying the set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Tree
                %annotation{:encoding => "application/x-tex"} Tree
            of isomorphism classes of rooted planar trees is the least fixed point, or
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/initial+algebra+of+an+endofunctor"} initial algebra
            %a.existingWikiWord{:href => "/nlab/show/endofunctor"} endofunctor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo ↦
                  %msup
                    %mi T
                    %mo *
                %annotation{:encoding => "application/x-tex"} T \mapsto T^\ast
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
          %p
            To put it more visually: let us designate the term
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            appearing as the base of a reduced form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi x
                    %mrow
                      %msub
                        %mi w
                        %mn 1
                      %mi …
                      %msub
                        %mi w
                        %mi n
                %annotation{:encoding => "application/x-tex"} x^{w_1 \ldots w_n}
            as the root of a corresponding tree. (If the reduced form is just
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            is designated the root of a tree consisting of only a root.) The reduced forms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi w
                    %mi i
                %annotation{:encoding => "application/x-tex"} w_i
            themselves have roots, and we draw an edge connecting those roots to the root
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            appearing in the base. Continuing this pattern, we climb recursively up the stacked exponentials, eventually obtaining a structure of rooted planar tree from a reduced form, whose vertices are just the instances of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            appearing in the reduced form.
          %p In fact, there is no harm in identifying rooted planar trees with reduced forms, and we will repeatedly use this identification below.
          %p
            Letting
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Red
                  %mo{:stretchy => "false"} (
                  %mi w
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Red(w)
            denote the reduced form of a magma word
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi w
                    %mo ∈
                    %mi Mag
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} w \in Mag(x)
          .num_prop
            %h6#proposition_2 Proposition
            %p
              The mapping
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi w
                    %mo ↦
                    %mi Red
                    %mo{:stretchy => "false"} (
                    %mi w
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} w \mapsto Red(w)
              defines a bijection from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Mag
                    %mo{:stretchy => "false"} (
                    %mi x
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                  %annotation{:encoding => "application/x-tex"} Mag(x)_n
              to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Tree
                        %mi n
                    %annotation{:encoding => "application/x-tex"} Tree_n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n+1
              instances of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              to isomorphism classes of rooted planar trees with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              edges.
          %p
            The inverse takes a reduced form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi x
                    %mi w
                  %mo =
                  %msup
                    %mi x
                    %mrow
                      %msub
                        %mi w
                        %mn 1
                      %msub
                        %mi w
                        %mn 2
                      %mi …
                      %msub
                        %mi w
                        %mi n
                %annotation{:encoding => "application/x-tex"} x^w = x^{w_1 w_2 \ldots w_n}
            to the magma word
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi x
                    %mi w
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mu(x^w)
            defined recursively by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi …
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi x
                    %mrow
                      %mi μ
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi w
                        %mn 1
                      %mo{:stretchy => "false"} )
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi μ
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi w
                        %mn 2
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mi …
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi μ
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi w
                        %mi n
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\ldots ((x^{\mu(w_1)})^{\mu(w_2)})\ldots )^{\mu(w_n)}
          %p
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi x
                  %annotation{:encoding => "application/x-tex"} \mu(x) = x
          %h3#rooted_planar_trees_and_mountain_ranges Rooted planar trees and mountain ranges
          %p
            To each rooted planar tree or reduced form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi x
                    %mrow
                      %msub
                        %mi w
                        %mn 1
                      %mi …
                      %msub
                        %mi w
                        %mi n
                %annotation{:encoding => "application/x-tex"} x^{w_1 \ldots w_n}
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            edges, we associate a mountain range
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mn 2
                  %mi k
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} f: [2k] \to \mathbb{N}
            as follows.
          %p
            In the first place, there is a monoid structure on the set of mountain ranges, essentially given by juxtaposition. Formally, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mn 2
                  %mi m
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} f: [2m] \to \mathbb{N}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mn 2
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} g: [2n] \to \mathbb{N}
            are mountain ranges, then their product
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo *
                  %mi g
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mn 2
                  %mo{:stretchy => "false"} (
                  %mi m
                  %mo +
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} f \ast g: [2(m+n)] \to \mathbb{N}
          %p
            is defined by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                  %mo ↦
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi j
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} j \mapsto f(j)
            if
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo ≤
                    %mi j
                    %mo ≤
                    %mn 2
                    %mi m
                  %annotation{:encoding => "application/x-tex"} 0 \leq j \leq 2m
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                  %mo ↦
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi j
                  %mo −
                  %mn 2
                  %mi m
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} j \mapsto g(j-2m)
            if
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mi m
                    %mo ≤
                    %mi j
                    %mo ≤
                    %mn 2
                    %mo{:stretchy => "false"} (
                    %mi m
                    %mo +
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} 2m \leq j \leq 2(m+n)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo *
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mi m
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} (f \ast g)(2m) = 0
            in either case by definition of mountain range (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mi m
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 0
                  %mo =
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f(2m) = 0 = g(0)
            ).
          %p
            We define
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Moun
                    %mo :
                    %msup
                      %mi Tree
                      %mo *
                    %mo →
                    %mi Range
                  %annotation{:encoding => "application/x-tex"} Moun: Tree^\ast \to Range
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Moun
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo{:stretchy => "false"} }
                      %mo →
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} Moun(x): \{0\} \to \mathbb{N}
                takes the value
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} 0
            %li
              %p
                For reduced forms
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi w
                          %mn 1
                        %mo ,
                        %mi …
                        %mo ,
                        %msub
                          %mi w
                          %mi n
                      %annotation{:encoding => "application/x-tex"} w_1, \ldots, w_n
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi w
                        %mo =
                        %msub
                          %mi w
                          %mn 1
                        %mo ,
                        %msub
                          %mi w
                          %mn 1
                        %mi …
                        %msub
                          %mi w
                          %mi n
                      %annotation{:encoding => "application/x-tex"} w = w_1, w_1 \ldots w_n
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Moun
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi x
                        %mi w
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mo{:stretchy => "false"} [
                      %mn 2
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} Moun(x^w): [2(k+1)] \to \mathbb{N}
                to be the function that takes
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                    %annotation{:encoding => "application/x-tex"} j
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mo ≤
                      %mi j
                      %mo ≤
                      %mn 2
                      %mi k
                      %mo +
                      %mn 1
