            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi n
                    %mi k
                %annotation{:encoding => "application/x-tex"} n_k
            such that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo &lt;
                    %msub
                      %mi n
                      %mi k
                    %mo &lt;
                    %mi n
                  %annotation{:encoding => "application/x-tex"} 0 \lt n_k \lt n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            to the subintervals (before and after
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi n
                      %mi k
                  %annotation{:encoding => "application/x-tex"} n_k
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn 1
                    %mo ,
                    %msub
                      %mi f
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} f_1, f_2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            have assigned reduced trees
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mrow
                        %msub
                          %mi w
                          %mn 1
                    %mo =
                    %msup
                      %mi ρ
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msup
                      %mi x
                      %mrow
                        %msub
                          %mi w
                          %mn 2
                    %mo =
                    %msup
                      %mi ρ
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x^{w_1} = \rho^{-1}(f_1), x^{w_2} = \rho^{-1}(f_2)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ρ
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi x
                      %mrow
                        %msub
                          %mi w
                          %mn 1
                        %msub
                          %mi w
                          %mn 2
                  %annotation{:encoding => "application/x-tex"} \rho^{-1}(f) = x^{w_1 w_2}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ≥
                  %mn 1
                %annotation{:encoding => "application/x-tex"} f \geq 1
            on the subinterval
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo ,
                    %mn 2
                    %mo ,
                    %mi …
                    %mo ,
                    %mn 2
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{1, 2, \ldots, 2n-1\}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
                    %mo =
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(1) = 1 = f(2n-1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 0
                  %mo =
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f(0) = 0 = f(2n)
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} f(j+1) - f(j) \in \{1, -1\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo =
                  %mi f
                  %mo −
                  %mn 1
                %annotation{:encoding => "application/x-tex"} g = f-1
            defines a mountain range over the subinterval
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %mn 2
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{1, \ldots, 2n-1\}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo =
                    %msup
                      %mi ρ
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
