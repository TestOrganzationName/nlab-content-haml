            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ρ
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi x
                      %mi T
                  %annotation{:encoding => "application/x-tex"} \rho^{-1}(f) = x^T
          %h3#mountain_ranges_and_stayahead_races Mountain ranges and stay-ahead races
          %p
            The terminology “stay-ahead” race is suggested by the following scenario: a poll race is held between a proponent P and an opponent O. A vote for P is indicated by the value
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} -1
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mo{:stretchy => "false"} [
                    %mn 2
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} f: [2n] \to \{1, -1\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi i
                      %mo =
                      %mn 0
                    %mi j
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo{:stretchy => "false"} )
                  %mo &gt;
                  %mn 0
                %annotation{:encoding => "application/x-tex"} \sum_{i=0}^j f(i) \gt 0
            for each
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %mn 2
                    %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} j \in [2n]
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo =
                        %mn 0
                      %mrow
                        %mn 2
                        %mi n
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \sum_{i=0}^{2n} f(i) = 1
          %p
            To each stay-ahead race
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mn 2
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mo{:stretchy => "false"} {
                  %mn 1
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} f: [2n] \to \{1, -1\}
            we associate a mountain range
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo =
                  %mi Σ
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mn 2
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} g = \Sigma(f): [2n] \to \mathbb{N}
            by defining
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo +
                    %msubsup
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo =
                        %mn 0
                      %mi j
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} g(j) = -1 + \sum_{i=0}^j f(i)
          .num_prop
            %h6#proposition_4 Proposition
            %p
              The mapping
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ↦
                    %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \mapsto \Sigma(f)
              defines a bijection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Race
                      %mi n
                    %mo →
                    %msub
                      %mi Range
                      %mi n
                  %annotation{:encoding => "application/x-tex"} Race_n \to Range_n
              from stay-ahead races
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 2
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} [2n] \to \{1, -1\}
              to mountain ranges
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 2
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} [2n] \to \mathbb{N}
          %p
            The inverse mapping takes a mountain range
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mn 2
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} g: [2n] \to \mathbb{N}
            to the stay-ahead race defined by the function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                  %mo ↦
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi j
                  %mo{:stretchy => "false"} )
                  %mo −
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi j
                  %mo −
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} j \mapsto g(j) - g(j-1)
            for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo ≤
                    %mi j
                    %mo ≤
                    %mn 2
                    %mi n
                  %annotation{:encoding => "application/x-tex"} 0 \leq j \leq 2n
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} g(-1) \coloneqq -1
          %h3#mountain_ranges_and_monotonic_lattice_paths Mountain ranges and monotonic lattice paths
          %p
            A mountain range
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mn 2
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} f: [2n] \to \mathbb{N}
            (or more precisely, the graph of a mountain range) can easily be converted, by a linear transformation, to an injective poset mapping
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi g
                    %mn 1
                  %mo ,
                  %msub
                    %mi g
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mn 2
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo ×
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} g = (g_1, g_2): [2n] \to [n] \times [n]
            satisfying the diagonal conditions
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} g(0) = (0, 0)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} g(2n) = (n, n)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mn 1
                    %mo ≤
                    %msub
                      %mi g
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} g_1 \leq g_2
          %p
            To wit: we remark that for a mountain range
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi j
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f(j)
            has the same parity as
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi j
                  %mo{:stretchy => "false"} )
                  %mo ≤
                  %mi j
                %annotation{:encoding => "application/x-tex"} f(j) \leq j
            for all
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %mn 2
                    %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} j \in [2n]
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msub
                        %mi g
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi j
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mfrac
                        %mn 1
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %mi j
                      %mo −
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi j
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} g_1(j) = \frac1{2}(j - f(j))
                ,
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msub
                        %mi g
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %mi j
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mfrac
                        %mn 1
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %mi j
                      %mo +
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi j
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} g_2(j) = \frac1{2}(j + f(j))
                \.
          %p
            Denote the poset map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi g
                    %mn 1
                  %mo ,
                  %msub
                    %mi g
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} g = (g_1, g_2)
            thus defined by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \lambda(f)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Path
                    %mi n
                %annotation{:encoding => "application/x-tex"} Path_n
            denote the set of monotonic lattice paths satisfying the diagonal conditions.
          .num_prop
            %h6#proposition_5 Proposition
            %p
              The mapping
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ↦
                    %mi λ
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \mapsto \lambda(f)
              defines a bijection
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Range
                        %mi n
                      %mo →
                      %msub
                        %mi Path
                        %mi n
                    %annotation{:encoding => "application/x-tex"} Range_n \to Path_n
          %p
            The inverse mapping takes an element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi g
                    %mn 1
                  %mo ,
                  %msub
                    %mi g
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %msub
                    %mi Path
                    %mi n
                %annotation{:encoding => "application/x-tex"} (g_1, g_2) \in Path_n
            to the mountain range defined by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo ↦
                    %msub
                      %mi g
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo{:stretchy => "false"} )
                    %mo −
                    %msub
                      %mi g
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} j \mapsto g_2(j) - g_1(j)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi g
                    %mn 1
                  %mo ,
                  %msub
                    %mi g
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} g = (g_1, g_2)
            forces each step of the path to go just one step (or block) north or just one block east, corresponding to the fact that the difference between
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi g
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi j
                  %mo +
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo −
                  %msub
                    %mi g
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi j
                  %mo +
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} g_2(j+1) - g_1(j+1)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi g
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi j
                  %mo{:stretchy => "false"} )
                  %mo −
                  %msub
                    %mi g
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi j
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} g_2(j) - g_1(j)
            always lies in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{1, -1\}
          %h3#monotonic_lattice_paths_and_pointed_inflationary_maps Monotonic lattice paths and pointed inflationary maps
          %p
            Each injective map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi g
                    %mn 1
                  %mo ,
                  %msub
                    %mi g
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mn 2
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo ×
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} g = (g_1, g_2): [2n] \to [n] \times [n]
            determines and is determined by a map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo =
                  %mi ϕ
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} f = \phi(g): [n] \to [n]
            defined as follows: if
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo ≤
                    %mi j
                    %mo ≤
                    %mi n
                  %annotation{:encoding => "application/x-tex"} 0 \leq j \leq n
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi min
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi g
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msub
                      %mi g
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi j
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} f(j) = \min \{g_2(k): g_1(k) = j\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            implies that the lattice path crosses each line
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo =
                    %mi j
                  %annotation{:encoding => "application/x-tex"} x = j
          .num_prop
            %h6#proposition_6 Proposition
            %p
              The mapping
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ↦
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} g \mapsto \phi(g)
              defines a bijection from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Path
                      %mi n
                  %annotation{:encoding => "application/x-tex"} Path_n
              to the set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi PtInf
                      %mi n
                  %annotation{:encoding => "application/x-tex"} PtInf_n
              consisting of maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} f: [n] \to [n]
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} f(0) = 0
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo ≤
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} j \leq f(j)
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                      %mo ∈
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} j \in [n]
          %p
            Indeed, the pointed inflationary conditions on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            are direct consequences of the diagonal conditions on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            to the lattice path that proceeds north and east, interpolating through the points
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi …
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo ,
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} (0, 0)\;\; (0, f(1))\;\; (1, f(1))\;\; (1, f(2))\;\; \ldots\;\; (n, n).
          %h2#structural_enumeration Structural enumeration
          %p
            The bijections of the last section indicate that all of the structures named above are counted by the same quantity
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mi n
                  %annotation{:encoding => "application/x-tex"} C_n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mi n
                %annotation{:encoding => "application/x-tex"} C_n
            mentioned above.
          %h3#method_1 Method 1
          %p
            A tried-and-true approach (explained in
            = succeed ")" do
              %a{:href => "#bd"} Baez-Dolan
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            internal indices, use the fact that there is just one such tree where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} n=0
            (i.e.,
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mn 0
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} C_0 = 1
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} n \gt 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            is determined by a pair
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi T
                    %mi l
                  %mo ,
                  %msub
                    %mi T
                    %mi r
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (T_l, T_r)
            consisting of a left tree and right tree adjacent to the root; if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mi l
                %annotation{:encoding => "application/x-tex"} T_l
            has
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi n
                    %mi l
                %annotation{:encoding => "application/x-tex"} n_l
            internal vertices and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mi r
                %annotation{:encoding => "application/x-tex"} T_r
            has
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi n
                    %mi r
                %annotation{:encoding => "application/x-tex"} n_r
            internal vertices, then
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %msub
                      %mi n
                      %mi l
                    %mo +
                    %msub
                      %mi n
                      %mi r
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n = n_l + n_r + 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ≥
                  %mn 0
                %annotation{:encoding => "application/x-tex"} n \geq 0
            we have the recursive equation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi j
                      %mo +
                      %mi k
                      %mo =
                      %mi n
                  %msub
                    %mi C
                    %mi j
                  %msub
                    %mi C
                    %mi k
                  %mo .
                %annotation{:encoding => "application/x-tex"} C_{n+1} = \sum_{j + k = n} C_j C_k.
          %p
            Letting
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi n
                      %mo ≥
                      %mn 0
                  %msub
                    %mi C
                    %mi n
                  %msup
                    %mi x
                    %mi n
                %annotation{:encoding => "application/x-tex"} C(x) = \sum_{n \geq 0} C_n x^n
            be the generating function (really a
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/formal+power+series"} formal power series
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 1
                  %mo +
                  %mi x
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi x
                  %msup
                    %mo{:stretchy => "false"} )
                    %mn 2
                %annotation{:encoding => "application/x-tex"} C(x) = 1 + x C(x)^2
          %p
            which we solve as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mfrac
                    %mrow
                      %mn 1
                      %mo −
                      %msqrt
                        %mrow
                          %mn 1
                          %mo −
                          %mn 4
                          %mi x
                    %mrow
                      %mn 2
                      %mi x
                %annotation{:encoding => "application/x-tex"} C(x) = \frac{1 - \sqrt{1 - 4x}}{2x}
            in the formal power series sense. Starting with the
            %a.existingWikiWord{:href => "/nlab/show/binomial+theorem"} binomial theorem
            to expand
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo −
                  %mn 4
                  %mi x
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mn 2
                %annotation{:encoding => "application/x-tex"} (1 - 4x)^{1/2}
            as a power series, a series of (somewhat tedious and unilluminating) manipulations eventually leads to the calculation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mi n
                  %mo =
                  %mfrac
                    %mn 1
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mrow
                    %mo (
                    %mfrac{:linethickness => "0"}
                      %mrow
                        %mn 2
                        %mi n
                      %mi n
                    %mo )
                  %mo .
                %annotation{:encoding => "application/x-tex"} C_n = \frac1{n+1}\binom{2n}{n}.
          %h3#method_2 Method 2
          %p
            A more structural derivation can be obtained by counting stay-ahead races, in the following manner. Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mi n
                %annotation{:encoding => "application/x-tex"} S_n
            be the set of functions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mn 2
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mo{:stretchy => "false"} {
                  %mn 1
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} f: [2n] \to \{1, -1\}
            for which
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo =
                        %mn 0
                      %mrow
                        %mn 2
                        %mi n
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \sum_{i=0}^{2n} f(i) = 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            takes the value
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            a total of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo +
                  %mn 1
                %annotation{:encoding => "application/x-tex"} n+1
            times, and the value
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                %annotation{:encoding => "application/x-tex"} -1
            a total of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            times, so the cardinality of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mi n
                %annotation{:encoding => "application/x-tex"} S_n
            is
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mn 2
                          %mi n
                          %mo +
                          %mn 1
                        %mi n
                      %mo )
                  %annotation{:encoding => "application/x-tex"} \binom{2n+1}{n}
          %p
            We let the
            %a.existingWikiWord{:href => "/nlab/show/cyclic+group"} cyclic group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mi n
                  %mo +
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}/(2n+1)
            %a.existingWikiWord{:href => "/nlab/show/group+action"} act
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mi n
                  %annotation{:encoding => "application/x-tex"} S_n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mn 2
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mo{:stretchy => "false"} {
                  %mn 1
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} f: [2n] \to \{1, -1\}
            with powers of the cyclic
            %a.existingWikiWord{:href => "/nlab/show/permutation"} permutation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi τ
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mspace{:width => "thickmathspace"}
                  %mn 1
                  %mspace{:width => "thickmathspace"}
                  %mi …
                  %mspace{:width => "thickmathspace"}
                  %mn 2
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mn 2
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mn 2
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo .
                %annotation{:encoding => "application/x-tex"} \tau = (0\; 1\; \ldots\; 2n): [2n] \to [2n].
          %p
            The number of stay-ahead races in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Race
                    %mi n
                %annotation{:encoding => "application/x-tex"} Race_n
            is seen to be
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mi n
                    %mo =
                    %mfrac
                      %mn 1
                      %mrow
                        %mn 2
                        %mi n
                        %mo +
                        %mn 1
                    %mrow
                      %mo (
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mn 2
                          %mi n
                          %mo +
                          %mn 1
                        %mi n
                      %mo )
                  %annotation{:encoding => "application/x-tex"} C_n = \frac1{2n+1}\binom{2n+1}{n}
          .num_prop
            %h6#proposition_7 Proposition
            %p
              Each
              %a.existingWikiWord{:href => "/nlab/show/orbit"} orbit
              of the cyclic group action on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mi n
                  %annotation{:encoding => "application/x-tex"} S_n
              contains exactly one stay-ahead race, and has exactly
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mi n
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 2n+1
              elements.
          .proof
            %h6#proof Proof
            %p
              Given
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ∈
                      %msub
                        %mi S
                        %mi n
                    %annotation{:encoding => "application/x-tex"} f \in S_n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ˜
                    %mo :
                    %mi ℤ
                    %mo →
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \tilde{f}: \mathbb{Z} \to \{1, -1\}
              that is periodic with period
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mi n
                      %mo +
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 2n+1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo =
                    %mi σ
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} g = \sigma(f)
              be the unique function such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} g(0) = 0
              and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} g(j+1) - g(j) = \tilde{f}(j)
            %p
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                      %mo ∈
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} j \in \mathbb{Z}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mn 0
                        %mo ≤
                        %mi i
                        %mo &lt;
                        %mi j
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} g(j) = \sum_{0 \leq i \lt j} \tilde{f}(i)
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                      %mo ≥
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} j \geq 0
            %p
              Observe that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo +
                    %mn 2
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} g(j+2n+1) = g(j)+1
              for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                    %annotation{:encoding => "application/x-tex"} j
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mrow
                        %mi g
                        %mo ,
                        %mi j
                  %annotation{:encoding => "application/x-tex"} L_{g, j}
              with slope
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mn 1
                      %mrow
                        %mn 2
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \frac1{2n+1}
              that passes through
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (j, g(j))
              also passes through
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi j
                      %mo +
                      %mn 2
                      %mi n
                      %mo +
                      %mn 1
                      %mo ,
                      %mi g
                      %mo{:stretchy => "false"} (
                      %mi j
                      %mo +
                      %mn 2
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (j+2n+1, g(j+2n+1))
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (k, g(k))
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo &lt;
                    %mi k
                    %mo &lt;
                    %mi j
                    %mo +
                    %mn 2
                    %mi n
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} j \lt k \lt j+2n+1
              since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} g(k)
              is integral but
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mrow
                        %mi g
                        %mo ,
                        %mi j
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} L_{g, j}(k)
              is not, being strictly between
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} g(j)
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo{:stretchy => "false"} (
                      %mi j
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} g(j)+1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mrow
                        %mi g
                        %mo ,
                        %mi j
                  %annotation{:encoding => "application/x-tex"} L_{g, j}
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
              ranging over a period block
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi j
                    %mo ,
                    %mi j
                    %mo +
                    %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %mi j
                    %mo +
                    %mn 2
                    %mi n
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{j, j+1, \ldots, j+2n\}
              are all distinct, i.e., the cyclic group action on these
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mrow
                        %mi g
                        %mo ,
                        %mi j
                  %annotation{:encoding => "application/x-tex"} L_{g, j}
              according to the formula
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi τ
                    %msub
                      %mi L
                      %mrow
                        %mi g
                        %mo ,
                        %mi j
                    %mo =
                    %msub
                      %mi L
                      %mrow
                        %mi g
                        %mo ,
                        %mi j
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \tau L_{g, j} = L_{g, j+1}
              is faithful.
            %p
              Pick
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
              so that the line
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mi j
                  %annotation{:encoding => "application/x-tex"} L_j
              is “lowest”; all the lines have the same slope
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mfrac
                        %mn 1
                        %mrow
                          %mn 2
                          %mi n
                          %mo +
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} \frac1{2n+1}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mi j
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} L_j(0)
              is minimal. Minimality implies that that for every other
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ≠
                    %mi j
                  %annotation{:encoding => "application/x-tex"} k \neq j
              within a periodic block, the point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (k, g(k))
              lies above the line
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo =
                      %msub
                        %mi L
                        %mi j
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} y = L_j(x)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
              by considering
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo ∘
                      %msup
                        %mi τ
                        %mi j
                    %annotation{:encoding => "application/x-tex"} g \circ \tau^j
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo{:stretchy => "false"} (
                      %mi j
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo ∘
                      %msup
                        %mi τ
                        %mi j
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} g(j) = (g \circ \tau^j)(0)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                      %mo =
                      %mi σ
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo ∘
                      %msup
                        %mi τ
                        %mi j
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} h = \sigma(f \circ \tau^j)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo ,
                    %mi h
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (k, h(k))
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %mn 2
                    %mi n
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} k = 1, \ldots, 2n+1
              stay above the line
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo =
                      %msub
                        %mi L
                        %mrow
                          %mi h
                          %mo ,
                          %mn 0
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mfrac
                        %mn 1
                        %mrow
                          %mn 2
                          %mi n
                          %mo +
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} y = L_{h, 0}(x) = \frac1{2n+1}(x)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} h(k)
              are all positive and
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} h(2n+1) = 1
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ∘
                      %msup
                        %mi τ
                        %mi j
                    %annotation{:encoding => "application/x-tex"} f \circ \tau^j
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %msub
                      %mi S
                      %mi n
                  %annotation{:encoding => "application/x-tex"} f \in S_n
              contains a stay-ahead race. Moreover, this is the only stay-ahead race in the orbit since the stay-ahead positivity condition is equivalent to the minimality condition on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mi j
                    %annotation{:encoding => "application/x-tex"} L_j
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mi j
                  %annotation{:encoding => "application/x-tex"} L_j
              are distinct.
            %p
              Finally, the stabilizer of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              must be trivial, else we would have
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mrow
                        %mi g
                        %mo ,
                        %mi j
                    %mo =
                    %msub
                      %mi L
                      %mrow
                        %mi g
                        %mo ,
                        %mi j
                        %mo +
                        %mi k
                  %annotation{:encoding => "application/x-tex"} L_{g, j} = L_{g, j+k}
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              a non-multiple of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mi n
                      %mo +
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 2n+1
          %h3#method_3 Method 3
          %p
            Yet another proof of the formula is based on Jean-Luc Rémy’s algorithm for generating binary trees uniformly at random
            = succeed "," do
              %a{:href => "#KnuthTACP4a"} (see Knuth TACP 4A, Section 7.2.1.6)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            iterations of the following simple rule:
          %ul
            %li
              %p Pick any edge of the tree.
            %li
              %p Create a new internal node by splitting the edge in two and budding off a freshly-labelled leaf, either to the left or to the right of the new internal node.
          %p
            Starting from the trivial binary tree (containing no internal nodes and a single leaf labelled “0”), this algorithm will generate a binary tree with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            internal nodes, together with a labelling of its leaves by distinct labels in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mi …
                    %mi n
                  %annotation{:encoding => "application/x-tex"} 0 \dots n
          %p
            Since at the
            = succeed "th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mi k
                  %mo −
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ⋅
                  %mn 2
                %annotation{:encoding => "application/x-tex"} (2k-1)\cdot 2
            possible choices of an edge and a direction, after
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            iterations we obtain the identity:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mi n
                  %mo ⋅
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo +
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo !
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mi n
                  %mo −
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo !
                  %mo !
                  %mo ⋅
                  %msup
                    %mn 2
                    %mi n
                %annotation{:encoding => "application/x-tex"} C_n\cdot (n+1)! = (2n-1)!! \cdot 2^n
          %p
            (where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mi n
                  %mo −
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo !
                  %mo !
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mi n
                  %mo −
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mi n
                  %mo −
                  %mn 3
                  %mo{:stretchy => "false"} )
                  %mi ⋯
                  %mn 1
                  %mo =
                  %mfrac
                    %mn 1
                    %mrow
                      %msup
                        %mn 2
                        %mi n
                  %mfrac
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mi n
                      %mo{:stretchy => "false"} )
                      %mo !
                    %mrow
                      %mi n
                      %mo !
                %annotation{:encoding => "application/x-tex"} (2n-1)!! = (2n-1)(2n-3)\cdots 1 = \frac1{2^n} \frac{(2n)!}{n!}
            is the
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/double+factorial"} double factorial
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mi n
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mi n
                  %mo −
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo !
                  %mo !
                  %mo ⋅
                  %msup
                    %mn 2
                    %mi n
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo +
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo !
                  %mo =
                  %mfrac
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mi n
                      %mo{:stretchy => "false"} )
                      %mo !
                    %mrow
                      %mi n
                      %mo !
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo !
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"} C_n = (2n-1)!! \cdot 2^n/(n+1)! = \frac{(2n)!}{n!(n+1)!} \,.
          %h2#relation_to_cyclic_objects Relation to cyclic objects
          %p
            As pointed out for example in
            = succeed "," do
              %a{:href => "#KV"} Kapranov-Voevodsky
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo +
                  %mn 2
                %annotation{:encoding => "application/x-tex"} n+2
            points (labeled by elements in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo +
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [n+1]
            in clockwise order) into
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            triangles. Thus there are
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                %annotation{:encoding => "application/x-tex"} 2
            distinct subdivisions of a square,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 5
                %annotation{:encoding => "application/x-tex"} 5
            possible subdivisions of a pentagon, and in general
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mi n
                %annotation{:encoding => "application/x-tex"} C_n
            possible subdivisions of an
            = succeed "-gon." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n+2)
          %p (To be continued.)
          %h2#related_concepts Related concepts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/associahedron"} associahedron
          %h2#references References
          %p General references:
          %ul
            %li
              Wikipedia,
              %em
                %a{:href => "https://en.wikipedia.org/wiki/Catalan_number"} Catalan number
            %li
              %a.existingWikiWord{:href => "/nlab/show/Richard+P.+Stanley"}> Richard P. Stanley
              ,
              = succeed "," do
                %em Catalan addendum
              = succeed "," do
                %em Enumerative Combinatorics
              %a{:href => "http://www-math.mit.edu/~rstan/ec/catadd.pdf"} pdf
            %li#Stanley2015
              %a.existingWikiWord{:href => "/nlab/show/Richard+P.+Stanley"}> Richard P. Stanley
              ,
              = succeed "," do
                %em Catalan numbers
          %p Other references:
          %ul
            %li#KnuthTACP4a
              %p
                %a.existingWikiWord{:href => "/nlab/show/Donald+E.+Knuth"}> Donald E. Knuth
                ,
                = succeed "," do
                  %em The Art of Computer Programming, Volume 4A: Combinatorial Algorithms, Part 1
                = succeed ")." do
                  %a{:href => "http://www.cs.utsa.edu/~wagner/knuth/fasc4a.pdf"} pre-fascicle
            %li#a000108
              %p
                Sequence
                %a{:href => "https://oeis.org/A000108"} A000108
                in the
                %a{:href => "https://oeis.org/"} OEIS
          %p
            For an interpretation in terms of
            %a.existingWikiWord{:href => "/nlab/show/species"} species
            (or
            = succeed ")" do
              %em structure types
          %ul
            %li#bd
              %a.existingWikiWord{:href => "/nlab/show/John+Baez"}> John Baez
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/James+Dolan"} James Dolan
              = succeed "," do
                %em From Finite Sets to Feynman Diagrams
              = succeed "," do
                %a{:href => "https://arxiv.org/abs/math/0004133"} arXiv:math/0004133
