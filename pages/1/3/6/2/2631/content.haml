          %h2#idea Idea
          %p
            A
            %em generating function
            is an element of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mspace{:width => "negativethinmathspace"}
                    %mo{:stretchy => "false"} [
                    %mi z
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "negativethinmathspace"}
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} R[\![z]\!]
            %a.existingWikiWord{:href => "/nlab/show/rig"} rig
            of formal
            %a.existingWikiWord{:href => "/nlab/show/power+series"} power series
            over the rig
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            (which is often taken to be the
            %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} natural numbers
            or the
            = succeed "s)," do
              %a.existingWikiWord{:href => "/nlab/show/rational+number"} rational number
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/combinatorics"} combinatorics
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi z
                  %mo{:stretchy => "false"} )
                  %mo =
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi n
                      %mo =
                      %mn 0
                    %mn ∞
                  %msub
                    %mi f
                    %mi n
                  %msup
                    %mi z
                    %mi n
                  %mo .
                %annotation{:encoding => "application/x-tex"} f(z) = \sum_{n=0}^{\infty}f_n z^n.
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is taken to be the
            %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
            or the
            %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
            (or any subrig), then we can ask whether the power series has a radius of convergence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                  %mo ≥
                  %mn 0
                %annotation{:encoding => "application/x-tex"} r \ge 0
            and if there’s an
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/analytic+continuation"} analytic continuation
          %p
            When
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo =
                  %mi ℕ
                  %mo ,
                %annotation{:encoding => "application/x-tex"} R = \mathbb{N},
            we can think of the coefficients on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi z
                    %mi n
                %annotation{:encoding => "application/x-tex"} z^n
            as counting the number of ways to put a particular structure on the
            %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite set
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/structure+types"} structure types
            if you take this literally.)
          %p Multiplying generating functions in the same variable gives
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi n
                        %mo =
                        %mn 0
                      %mn ∞
                    %msub
                      %mi f
                      %mi n
                    %msup
                      %mi z
                      %mi n
                    %mo )
                  %mrow
                    %mo (
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi n
                        %mo =
                        %mn 0
                      %mn ∞
                    %msub
                      %mi g
                      %mi n
                    %msup
                      %mi z
                      %mi n
                    %mo )
                  %mo =
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi n
                      %mo =
                      %mn 0
                    %mn ∞
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi k
                      %mo =
                      %mn 0
                    %mi n
                  %msub
                    %mi f
                    %mi k
                  %msub
                    %mi g
                    %mrow
                      %mi n
                      %mo −
                      %mi k
                  %msup
                    %mi z
                    %mi n
                  %mo ,
                %annotation{:encoding => "application/x-tex"} \left(\sum_{n=0}^{\infty}f_n z^n\right)\left(\sum_{n=0}^{\infty}g_n z^n\right) = \sum_{n=0}^{\infty}\sum_{k=0}^n f_k g_{n-k} z^n,
          %p
            which effectively says to split up the set into two parts, put the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            structure on the first part and the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            structure on the second part.
          %p
            %em Ordinary
            generating functions (OGFs) describe structures on
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/totally+ordered+sets"} totally ordered sets
            %em exponential
            generating functions (EGFs) apply to unordered
            %a.existingWikiWord{:href => "/nlab/show/sets"} sets
            (whose elements may be distinguished by having different
            = succeed ")." do
              %em labels
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi e
                    %mi z
                  %mo =
                  %mn 1
                  %mo +
                  %mi z
                  %mo +
                  %mfrac
                    %mrow
                      %msup
                        %mi z
                        %mn 2
                    %mrow
                      %mn 2
                      %mo !
                  %mo +
                  %mfrac
                    %mrow
                      %msup
                        %mi z
                        %mn 3
                    %mrow
                      %mn 3
                      %mo !
                  %mo +
                  %mi ⋯
                  %mo ,
                %annotation{:encoding => "application/x-tex"} e^z = 1 + z + \frac{z^2}{2!} + \frac{z^3}{3!} + \cdots ,
          %p while the generating function for being a finite ordered set is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mn 1
                    %mrow
                      %mn 1
                      %mo −
                      %mi z
                  %mo =
                  %mn 1
                  %mo +
                  %mi z
                  %mo +
                  %msup
                    %mi z
                    %mn 2
                  %mo +
                  %msup
                    %mi z
                    %mn 3
                  %mo +
                  %mi ⋯
                  %mo .
                %annotation{:encoding => "application/x-tex"} \frac{1}{1-z} = 1 + z + z^2 + z^3 + \cdots .
          %p
            If we assume that the zeroth term is
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi n
                        %mo =
                        %mn 0
                      %mn ∞
                    %msub
                      %mi f
                      %mi n
                    %msup
                      %mi x
                      %mi n
                    %mo )
                  %mrow
                    %mo (
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi n
                        %mo =
                        %mn 0
                      %mn ∞
                    %msub
                      %mi g
                      %mi n
                    %msup
                      %mi z
                      %mi n
                    %mo )
                  %mo =
                  %mn 1
                  %mo +
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi f
                    %mn 1
                  %mi x
                  %mo +
                  %msub
                    %mi g
                    %mn 1
                  %mi z
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi f
                    %mn 2
                  %msup
                    %mi x
                    %mn 2
                  %mo +
                  %msub
                    %mi f
                    %mn 1
                  %msub
                    %mi g
                    %mn 1
                  %mi x
                  %mi z
                  %mo +
                  %msub
                    %mi g
                    %mn 2
                  %msup
                    %mi z
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mi ⋯
                %annotation{:encoding => "application/x-tex"} \left(\sum_{n=0}^{\infty}f_n x^n\right)\left(\sum_{n=0}^{\infty}g_n z^n\right) = 1 + (f_1 x + g_1 z) + (f_2 x^2 + f_1 g_1 x z + g_2 z^2) + \cdots
          %p
            If we take the product of countably many generating functions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mi i
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi x
                    %mi i
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f^i(x_i)
            and then set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mi i
                  %mo =
                  %msubsup
                    %mi p
                    %mi i
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi s
                  %mo ,
                %annotation{:encoding => "application/x-tex"} x_i = p_i^{-s},
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi p
                    %mi i
                %annotation{:encoding => "application/x-tex"} p_i
            is the
            = succeed "th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mn 1
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi s
                  %mo +
                  %msubsup
                    %mi f
                    %mn 1
                    %mn 1
                  %msup
                    %mn 2
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi s
                  %mo +
                  %msubsup
                    %mi f
                    %mn 1
                    %mn 2
                  %msup
                    %mn 3
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi s
                  %mo +
                  %msubsup
                    %mi f
                    %mn 2
                    %mn 1
                  %msup
                    %mn 4
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi s
                  %mo +
                  %msubsup
                    %mi f
                    %mn 1
                    %mn 3
                  %msup
                    %mn 5
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi s
                  %mo +
                  %msubsup
                    %mi f
                    %mn 1
                    %mn 1
                  %msubsup
                    %mi f
                    %mn 1
                    %mn 2
                  %msup
                    %mn 6
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi s
                  %mo +
                  %mi ⋯
                  %mo +
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mi i
                  %msubsup
                    %mi f
                    %mrow
                      %msub
                        %mi e
                        %mi i
                    %mi i
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi p
                    %mi i
                    %mrow
                      %msub
                        %mi e
                        %mi i
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi s
                  %mo +
                  %mi ⋯
                  %mo ,
                %annotation{:encoding => "application/x-tex"} 1^{-s} + f^1_1 2^{-s} + f^2_1 3^{-s} + f^1_2 4^{-s} + f^3_1 5^{-s} + f^1_1 f^2_1 6^{-s} + \cdots + \prod_{i} f^i_{e_i} (p_i^{e_i})^{-s} + \cdots,
          %p
            which is called the
            %em Dirichlet
            generating function for the family
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mi i
                  %mo .
                %annotation{:encoding => "application/x-tex"} f^i.
          %p The product of two Dirichlet generating functions gives
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi n
                        %mo =
                        %mn 1
                      %mn ∞
                    %msub
                      %mi f
                      %mi n
                    %msup
                      %mi n
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi s
                    %mo )
                  %mrow
                    %mo (
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi n
                        %mo =
                        %mn 1
                      %mn ∞
                    %msub
                      %mi g
                      %mi n
                    %msup
                      %mi n
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi s
                    %mo )
                  %mo =
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi n
                      %mo =
                      %mn 1
                    %mn ∞
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi d
                      %mo{:stretchy => "false"} |
                      %mi n
                  %msub
                    %mi f
                    %mi d
                  %msub
                    %mi g
                    %mrow
                      %mi n
                      %mo{:stretchy => "false"} /
                      %mi d
                  %msup
                    %mi n
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi s
                  %mo ,
                %annotation{:encoding => "application/x-tex"} \left(\sum_{n=1}^{\infty}f_n n^{-s}\right)\left(\sum_{n=1}^{\infty}g_n n^{-s}\right) = \sum_{n=1}^{\infty} \sum_{d|n} f_d g_{n/d} n^{-s},
          %p
            which effectively says to
            %em factor
            the term into two dimensions, apply
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            to the first and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            to the second.
          %p
            Sometimes we take the
            %em exponents
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi z
                %annotation{:encoding => "application/x-tex"} z
            to be in a rig other than the natural numbers. For example, we might set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi z
                    %mi a
                  %mo ⋅
                  %msup
                    %mi z
                    %mi b
                  %mo =
                  %msup
                    %mi z
                    %mrow
                      %mi max
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} z^a \cdot z^b = z^{\max(a,b)}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi z
                    %mi a
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi b
                  %mo =
                  %msup
                    %mi z
                    %mrow
                      %mi a
                      %mo +
                      %mi b
                  %mo ;
                %annotation{:encoding => "application/x-tex"} (z^a)^b = z^{a+b};
            such a system lets us talk about the
            %a.existingWikiWord{:href => "/nlab/show/rig+of+costs"} cost
            of operations done in parallel (max) or sequentially (+). Similarly, we could take the exponents to be
            = succeed "s" do
              %span.newWikiWord
                binary string
                %a{:href => "/nlab/new/binary+string"} ?
            %a.existingWikiWord{:href => "/nlab/show/finite+field"} finite field
            elements when considering structures on a finite collection of objects.
          %h2#examples Examples
          %p
            The OGF
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi z
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} T(z)
            for binary
            %a.existingWikiWord{:href => "/nlab/show/trees"} trees
            (rooted in the plane, counted by number of internal nodes) satisfies
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
                    %mo +
                    %mi z
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi z
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} T(z) = 1 + z T(z)^2
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mfrac
                      %mrow
                        %mn 1
                        %mo −
                        %msqrt
                          %mrow
                            %mn 1
                            %mo −
                            %mn 4
                            %mi z
                      %mrow
                        %mn 2
                        %mi z
                  %annotation{:encoding => "application/x-tex"} T(z) = \frac{1-\sqrt{1-4z}}{2z}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi z
                    %mi n
                %annotation{:encoding => "application/x-tex"} z^n
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi z
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} T(z)
            is the
            = succeed "th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %em Catalan number
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mn 2
                          %mi n
                        %mi n
                      %mo )
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \binom{2n}{n}/(n+1)
          %p
            Fixed-point free
            %a.existingWikiWord{:href => "/nlab/show/involutions"} involutions
            on a set have the EGF
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi e
                      %mrow
                        %msup
                          %mi z
                          %mn 2
                        %mo{:stretchy => "false"} /
                        %mn 2
                  %annotation{:encoding => "application/x-tex"} e^{z^2/2}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi e
                      %mrow
                        %mi z
                        %mo +
                        %msup
                          %mi z
                          %mn 2
                        %mo{:stretchy => "false"} /
                        %mn 2
                  %annotation{:encoding => "application/x-tex"} e^{z+z^2/2}
            %a.existingWikiWord{:href => "/nlab/show/partition#of_sets"} partitions
            have EGF
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi e
                      %mrow
                        %msup
                          %mi e
                          %mi z
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} e^{e^z-1}
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field theory
            generating functions often appear as
            %a.existingWikiWord{:href => "/nlab/show/partition+functions"} partition functions
            and
            %a.existingWikiWord{:href => "/nlab/show/vacuum+amplitudes"} vacuum amplitudes
            as functions of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/source+fields"} source fields
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bogoliubov%27s+formula"} Bogoliubov's formula
                for
                %a.existingWikiWord{:href => "/nlab/show/quantum+observables"} quantum observables
                in
                %a.existingWikiWord{:href => "/nlab/show/perturbative+quantum+field+theory"} perturbative quantum field theory
                generated from an
                %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
                functional
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/species"} species
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Witten+conjecture"} Witten conjecture
          %h2#references References
          %p Early articles exploring the foundations of generating functions include:
          %ul
            %li
              %p
                %span.newWikiWord>
                  Peter Doubilet
                  %a{:href => "/nlab/new/Peter+Doubilet"} ?
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Gian-Carlo+Rota"} Gian-Carlo Rota
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Richard+Stanley"} Richard Stanley
                = succeed "," do
                  %em Sixth Berkeley Symposium on Mathematical Statistics and Probability
                = succeed "," do
                  %em Probability Theory
                = succeed ")" do
                  %a{:href => "https://projecteuclid.org/euclid.bsmsp/1200514223"} euclid
            %li#Joyal81
              %p
                %a.existingWikiWord{:href => "/nlab/show/Andr%C3%A9+Joyal"}> André Joyal
                ,
                %em Une théorie combinatoire des séries formelles
                , Advances in Mathematics 42:1-82 (1981)
                = succeed "," do
                  %a{:href => "http://dx.doi.org/10.1016/0001-8708(81)90052-9"} doi
                %a{:href => "http://www.ams.org/mathscinet-getitem?mr=633783"} MR84d:05025
          %p Textbook accounts include:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Herbert+Wilf"}> Herbert Wilf
                ,
                %em generatingfunctionology
                (Third Edition), A K Peters, 2006. (
                %a{:href => "https://www.math.upenn.edu/~wilf/DownldGF.html"}> book webpage
                ) (
                %a{:href => "https://www.math.upenn.edu/~wilf/DownldGF.html"}> author pdf
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Philippe+Flajolet"} Philippe Flajolet
                and
                = succeed "," do
                  %span.newWikiWord
                    Robert Sedgewick
                    %a{:href => "/nlab/new/Robert+Sedgewick"} ?
                = succeed "," do
                  %em Analytic Combinatorics
                = succeed ")" do
                  %a{:href => "http://algo.inria.fr/flajolet/Publications/book.pdf"} author pdf
        .revisedby
