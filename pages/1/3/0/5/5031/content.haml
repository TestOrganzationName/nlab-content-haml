          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#definition"} Definition
              %li
                %a{:href => "#properties"} Properties
              %ul
                %li
                  %a{:href => "#from_topological_spaces_to_toposes"} From topological spaces to toposes
                %li
                  %a{:href => "#from_toposes_to_higher_toposes"} From toposes to higher toposes
                %li
                  %a{:href => "#AdjunctionToLocallyPresentable"} From locally presentable categories to toposes
