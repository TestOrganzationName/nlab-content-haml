              %a.existingWikiWord{:href => "/nlab/show/local+isomorphisms"} local isomorphisms
              (cf. at
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/morphism+of+sites"} morphism of sites
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
