                  %annotation{:encoding => "application/x-tex"} sSh(C)
              of
              %a.existingWikiWord{:href => "/nlab/show/simplicial+sheaves"} simplicial sheaves
              is the Topos-product of the corresponding sheaf topos of Set-values sheaves with the topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} sSet
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
              %a.existingWikiWord{:href => "/nlab/show/presheaf+topos"} presheaf topos
              over the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/simplex+category"} simplex category
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ≡
                    %mspace{:width => "thinmathspace"}
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} )
