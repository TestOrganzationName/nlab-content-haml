              %em restriction of distributions
              (
              %a{:href => "#Hoermander90"}> Hörmander 90, first lines of section 2.2
              ). For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %msubsup
                      %mi C
                      %mi c
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} b \in C^\infty_c(Y)
              a
