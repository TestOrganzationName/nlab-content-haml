              %a.maruku-ref{:href => "#PullbackOfDistributionAlongSubmersion"}
              applies. The resulting pullback operation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
