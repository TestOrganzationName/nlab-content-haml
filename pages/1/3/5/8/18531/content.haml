              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/contravariant+functor"} contravariant functor
                %ul
                  %li
                    %p
                      %a.existingWikiWord{:href => "/nlab/show/pullback+in+cohomology"}> pullback in cohomology
                      ,
                      %a.existingWikiWord{:href => "/nlab/show/d-invariant"} d-invariant
