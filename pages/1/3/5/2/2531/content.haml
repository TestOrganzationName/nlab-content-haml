                                  %mi Δ
                                  %mi j
                                %mo ,
                                %mi X
                                %mo{:stretchy => "false"} ]
                                %mo{:stretchy => "false"} ]
                            %mtr
                              %mtd
                              %mtd
                                %mo ≃
                                %munder
                                  %mi lim
                                  %mi j
                                %mo{:stretchy => "false"} [
                                %mi Σ
                                %mo ,
                                %mo{:stretchy => "false"} [
                                %msub
                                  %mi Δ
                                  %mi j
                                %mo ,
                                %mi X
                                %mo{:stretchy => "false"} ]
                                %mo{:stretchy => "false"} ]
                            %mtr
                              %mtd
                              %mtd
                                %mo ≃
                                %munder
                                  %mi lim
                                  %mi j
                                %mo{:stretchy => "false"} [
                                %msub
                                  %mi Δ
                                  %mi j
                                %mo ,
                                %mo{:stretchy => "false"} [
                                %mi Σ
                                %mo ,
                                %mi X
                                %mo{:stretchy => "false"} ]
                                %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"}
                        \\begin{aligned}
                        [\Delta, [\Sigma, X]] &amp; \simeq [\Delta \times \Sigma, X]
                        \\\
                        \&amp; \simeq [\Sigma, [\Delta, X]]
                        \\\
                        \&amp; \simeq [\Sigma, \lim_j [\Delta_j, X]]
                        \\\
                        \&amp; \simeq \lim_j [\Sigma, [\Delta_j, X]]
                        \\\
                        \&amp; \simeq  \lim_j [\Delta_j, [\Sigma, X]]
                        \\end{aligned}
          .num_prop
            %h6#proposition_3 Proposition
            %p
              %strong (microlinear loci)
            %p
              Let
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℱ
                    %annotation{:encoding => "application/x-tex"} \mathcal{F}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                    %mo ,
                    %mi 𝒵
                    %mo ,
                    %mi ℬ
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}, \mathcal{Z}, \mathcal{B}
              be the
              %a.existingWikiWord{:href => "/nlab/show/smooth+toposes"} smooth toposes
              of the same name that are discussed in detail in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Models+for+Smooth+Infinitesimal+Analysis"} MSIA, capter III
              %a.existingWikiWord{:href => "/nlab/show/category+of+sheaves"} categories of sheaves
              on a
              %a.existingWikiWord{:href => "/nlab/show/subcategory"} subcategory
              of the category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕃
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi C
                      %mn ∞
                    %msup
                      %mi Ring
                      %mi fin
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{L} = (C^\infty Ring^{fin})
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/smooth+loci"} smooth loci
            %p
              All
              %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representable objects
              in these
              %a.existingWikiWord{:href => "/nlab/show/smooth+toposes"} smooth toposes
              are microlinear.
          .proof
            %h6#proof_2 Proof
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℱ
                  %annotation{:encoding => "application/x-tex"} \mathcal{F}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
              this is the statement of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Models+for+Smooth+Infinitesimal+Analysis"} MSIA, chapter V, section 7.1
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒵
                  %annotation{:encoding => "application/x-tex"} \mathcal{Z}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℬ
                  %annotation{:encoding => "application/x-tex"} \mathcal{B}
              the argument is similarly easy:
            %p
              These are categories of sheaves on the full category
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕃
                      %mo =
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi C
                        %mn ∞
                      %msup
                        %mi Ring
                        %mi fin
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi op
                    %annotation{:encoding => "application/x-tex"} \mathbb{L} = (C^\infty Ring^{fin})^{op}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is representable in each case,
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo =
                      %mi ℓ
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi ℝ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} R = \ell C^\infty(\mathbb{R})
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕃
                  %annotation{:encoding => "application/x-tex"} \mathbb{L}
              is a limit (not necessarily finite) over copies of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕃
                    %annotation{:encoding => "application/x-tex"} \mathbb{L}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℓ
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \ell A
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕃
                  %annotation{:encoding => "application/x-tex"} \mathbb{L}
              satisfies the microlinearity axioms in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕃
                  %annotation{:encoding => "application/x-tex"} \mathbb{L}
              in that for each cocone
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo →
                    %msub
                      %mi Δ
                      %mi c
                    %mo :
                    %mi J
                    %mo →
                    %mi 𝕃
                  %annotation{:encoding => "application/x-tex"} \Delta \to \Delta_c : J \to \mathbb{L}
              of
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+objects"} infinitesimal objects
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi R
                      %mrow
                        %msub
                          %mi Δ
                          %mi c
                    %mo ≃
                    %msub
                      %mi lim
                      %mrow
                        %mi j
                        %mo ∈
                        %mi J
                    %msup
                      %mi R
                      %mrow
                        %msub
                          %mi Δ
                          %mi j
                  %annotation{:encoding => "application/x-tex"} R^{\Delta_c} \simeq \lim_{j \in J} R^{\Delta_j}
              we also have
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi ℓ
                      %mi A
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %msub
                            %mi Δ
                            %mi c
                      %mo ≃
                      %msub
                        %mi lim
                        %mrow
                          %mi j
                          %mo ∈
                          %mi J
                      %mo{:stretchy => "false"} (
                      %mi ℓ
                      %mi A
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %msub
                            %mi Δ
                            %mi j
                    %annotation{:encoding => "application/x-tex"} (\ell A)^{\Delta_c} \simeq \lim_{j \in J} (\ell A)^{\Delta_j}
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo :
                    %mi 𝕃
                    %mo →
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Y : \mathbb{L} \to PSh(C)
              preserves limits and exponentials. Since the
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topology"} Grothendieck topology
              in question is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/subcanonical+coverage"} subcanonical
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi ℓ
                    %mi A
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mi Δ
                          %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Y((\ell A)^{\Delta_j})
              is in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh(C)
              and hence is the exponential object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo{:stretchy => "false"} (
                    %mi ℓ
                    %mi A
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi Y
                        %msub
                          %mi Δ
                          %mi j
                  %annotation{:encoding => "application/x-tex"} Y(\ell A)^{Y \Delta_j}
              there. Finally, the
              %em finite
              limit over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
              is preserved by the reflection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PSh(C) \to Sh(C)
              (sheafification, which acts trivially on our representables), so
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo{:stretchy => "false"} (
                    %mi ℓ
                    %mi A
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mi Δ
                          %mi c
                    %mo ≃
                    %msub
                      %mi lim
                      %mrow
                        %mi j
                        %mo ∈
                        %mi J
                    %mi Y
                    %mo{:stretchy => "false"} (
                    %mi ℓ
                    %mi A
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi Y
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi Δ
                          %mi j
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Y(\ell A)^{\Delta_c} \simeq \lim_{j \in J}  Y(\ell A)^{Y(\Delta_j)}
              and hence all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo{:stretchy => "false"} (
                    %mi ℓ
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Y(\ell A)
              are microlinear in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒵
                  %annotation{:encoding => "application/x-tex"} \mathcal{Z}
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℬ
                    %annotation{:encoding => "application/x-tex"} \mathcal{B}
          %h2#references References
          %p The notion of microlinear space in the above fashion is due to
          %ul
            %li
              F. Bergeron,
              = succeed "," do
                %em Objet infinitésimal en géométrie différentielle synthétique
          %p
            and was studied further under the name
            %em strong infinitesimal linearity
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Anders+Kock"}> Anders Kock
              ,
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Ren%C3%A9+Lavendhomme"} René Lavendhomme
              = succeed "," do
                %em Strong infinitesimal linearity, with applications to strong difference and affine connections
              %a.existingWikiWord{:href => "/nlab/show/Cahiers"} Cahiers
              de topologie et géométrie différentielle catégoriques, tome 25, no 3 (1984) 311-324 &amp;lbrack;
              %a{:href => "http://www.numdam.org/item?id=CTGDC_1984__25_3_311_0"}> numdam:CTGDC_1984__25_3_311_0
              \&amp;rbrack;
          %p This is similar to but stronger than the earlier “condition (E)” given in
          %ul
            %li Demazure (1970)
          %p which apparently was also called “infinitesimal linearity” (without the “strong”).
          %p
            Spaces satisfying this condition were called
            = succeed "," do
              %em infinitesimally linear spaces
          %ul
            %li#Kock81
              %a.existingWikiWord{:href => "/nlab/show/Anders+Kock"}> Anders Kock
              \:
              = succeed "," do
                %em Synthetic Differential Geometry
              = succeed "," do
                %a{:href => "http://home.imf.au.dk/kock/sdg99.pdf"} pdf
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1017/CBO9780511550812"} doi:10.1017/CBO9780511550812
          %p The 2006 revision of this book contains in its appendix D the definition of microlinearity as above.
          %p A comprehensive discussion of microlinearity is in chapter V, section 1 of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Ieke+Moerdijk"}> Ieke Moerdijk
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Gonzalo+Reyes"} Gonzalo Reyes
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Models+for+Smooth+Infinitesimal+Analysis"} Models for Smooth Infinitesimal Analysis
              = succeed "&rbrack;" do
                %a{:href => "https://link.springer.com/book/10.1007/978-1-4757-4143-8"} doi:10.1007/978-1-4757-4143-8
