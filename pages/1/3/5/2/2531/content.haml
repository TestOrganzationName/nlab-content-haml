                          %mo{:lspace => "verythinmathspace"} :
                          %mspace{:width => "thickmathspace"}
                          %mi d
                          %mo ↦
                          %msup
                            %mi r
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi v
                            %mn 1
                          %mo ,
                          %msub
                            %mi v
                            %mn 2
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %mi d
                          %mo ,
                          %mi d
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (v_1 + v_2) \;\colon\; d \mapsto r^{-1}(v_1,v_2)(d,d)
              %li
                %p
                  %strong Multiplication
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ⋅
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi R
                        %mo ×
                        %msup
                          %mi X
                          %mi D
                        %mo →
                        %msup
                          %mi X
                          %mi D
                      %annotation{:encoding => "application/x-tex"} \cdot \;\colon\; R \times X^D \to X^D
                  is defined componentwise by
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi α
                        %mo ⋅
                        %mi v
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi d
                        %mo ↦
                        %mi v
                        %mo{:stretchy => "false"} (
                        %mi α
                        %mo ⋅
                        %mi d
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\alpha \cdot v) \;\colon\; d \mapsto v (\alpha \cdot d)
                  \.
            %p
              One checks that this is indeed
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/unitality"} unital
              %a.existingWikiWord{:href => "/nlab/show/associativity"} associative
              and
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/distributivity"} distributive
          %h2#examples Examples
          %p A large class of examples is implied by the following proposition.
          .num_prop
            %h6#proposition_2 Proposition
            %p
              %strong (closedness of the collection of microlinear spaces)
            %p
              In every
              %a.existingWikiWord{:href => "/nlab/show/smooth+topos"} smooth topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒯
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{T},R)
              we have:
            %ol
              %li
                %p
                  The standard line
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                  is microlinear.
              %li
                %p
                  The collection of microlinear spaces is closed under
                  %a.existingWikiWord{:href => "/nlab/show/limits"} limits
                  in
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒯
                        %annotation{:encoding => "application/x-tex"} \mathcal{T}
                %p
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo =
                        %msub
                          %mi lim
                          %mi i
                        %msub
                          %mi X
                          %mi i
                      %annotation{:encoding => "application/x-tex"} X = \lim_i X_i
                  a
                  %a.existingWikiWord{:href => "/nlab/show/limit"} limit
                  of microlinear spaces
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi X
                            %mi i
                        %annotation{:encoding => "application/x-tex"} X_i
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  is microlinear.
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/mapping+space"} Mapping spaces
                  into microlinear spaces are microlinear: for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  any microlinear space and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Σ
                      %annotation{:encoding => "application/x-tex"} \Sigma
                  any space, also the
                  %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi X
                          %mi Σ
                      %annotation{:encoding => "application/x-tex"} X^\Sigma
                  is microlinear.
          .proof
            %h6#proof Proof
            %p
              This is obvious from the standard properties of
              %a.existingWikiWord{:href => "/nlab/show/limits"} limits
              and the fact that the
              = succeed "-functor" do
                %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi Y
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝒯
                    %mo →
                    %mi 𝒯
                  %annotation{:encoding => "application/x-tex"} (-)^Y \colon \mathcal{T} \to \mathcal{T}
              preserves limits. (See
              %a.existingWikiWord{:href => "/nlab/show/limits+and+colimits+by+example"} limits and colimits by example
              if you don’t find it obvious.)
            %ol
              %li
                %p by definition
              %li
                %p
                  Let
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Δ
                      %annotation{:encoding => "application/x-tex"} \Delta
                  be the tip of a cocone
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Δ
                          %mi j
                      %annotation{:encoding => "application/x-tex"} \Delta_j
                  of infinitesimal spaces such that
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi lim
                            %mi j
                          %msup
                            %mi R
                            %mrow
                              %msub
                                %mi Δ
                                %mi j
                          %mo =
                          %msup
                            %mi R
                            %mi Δ
                        %annotation{:encoding => "application/x-tex"} \lim_j R^{\Delta_j} = R^\Delta
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                            %mtr
                              %mtd
                                %msup
                                  %mi X
                                  %mi Δ
                              %mtd
                                %mo =
                                %mo{:stretchy => "false"} (
                                %munder
                                  %mi lim
                                  %mi i
                                %msub
                                  %mi X
                                  %mi i
                                %msup
                                  %mo{:stretchy => "false"} )
                                  %mi Δ
                            %mtr
                              %mtd
                              %mtd
                                %mo ≃
                                %munder
                                  %mi lim
                                  %mi i
                                %msubsup
                                  %mi X
                                  %mi i
                                  %mi Δ
                            %mtr
                              %mtd
                              %mtd
                                %mo ≃
                                %munder
                                  %mi lim
                                  %mi i
                                %munder
                                  %mi lim
                                  %mi j
                                %msubsup
                                  %mi X
                                  %mi i
                                  %mrow
                                    %msub
                                      %mi Δ
                                      %mi j
                            %mtr
                              %mtd
                              %mtd
                                %mo ≃
                                %munder
                                  %mi lim
                                  %mi j
                                %munder
                                  %mi lim
                                  %mi i
                                %msubsup
                                  %mi X
                                  %mi i
                                  %mrow
                                    %msub
                                      %mi Δ
                                      %mi j
                            %mtr
                              %mtd
                              %mtd
                                %mo ≃
                                %munder
                                  %mi lim
                                  %mi j
                                %msup
                                  %mi X
                                  %mrow
                                    %msub
                                      %mi Δ
                                      %mi j
                      %annotation{:encoding => "application/x-tex"}
                        \\begin{aligned}
                        X^{\Delta}
                        \&amp;= (\lim_i X_i)^\Delta
                        \\\
                        \&amp;\simeq \lim_i X_i^{\Delta}
                        \\\
                        \&amp; \simeq \lim_i \lim_j X_i^{\Delta_j}
                        \\\
                        \&amp; \simeq \lim_j \lim_i X_i^{\Delta_j}
                        \\\
                        \&amp; \simeq \lim_j X^{\Delta_j}
                        \\end{aligned}
              %li
                %p
                  with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Δ
                      %annotation{:encoding => "application/x-tex"} \Delta
                  as above we have (writing
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi A
                        %mo ,
                        %mi B
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [A,B]
                  for the
                  %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
                  otherwise equivalently denoted
                  = succeed ")" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi B
                            %mi A
                        %annotation{:encoding => "application/x-tex"} B^A
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} [
                                %mi Δ
                                %mo ,
                                %mo{:stretchy => "false"} [
                                %mi Σ
                                %mo ,
                                %mi X
                                %mo{:stretchy => "false"} ]
                                %mo{:stretchy => "false"} ]
                              %mtd
                                %mo ≃
                                %mo{:stretchy => "false"} [
                                %mi Δ
                                %mo ×
                                %mi Σ
                                %mo ,
