                                %mi Σ
                                %mo ,
                                %mo{:stretchy => "false"} [
                                %mi Δ
                                %mo ,
                                %mi X
                                %mo{:stretchy => "false"} ]
                                %mo{:stretchy => "false"} ]
                            %mtr
