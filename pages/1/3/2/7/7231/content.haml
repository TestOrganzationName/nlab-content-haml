          #ElementwiseStabilizerOfHIsSU2.num_prop
            %h6#proposition Proposition
            %p
              The elementwise stabilizer group of the
              %a.existingWikiWord{:href => "/nlab/show/quaternions"} quaternions
              is
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/SU%282%29"} SU(2)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Fix
                      %mrow
                        %msub
                          %mi G
                          %mn 2
                    %mo{:stretchy => "false"} (
                    %mi ℍ
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi SU
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Fix_{G_2}(\mathbb{H}) \simeq SU(2)
                    \\,.
          .proof
            %h6#proof Proof
            %p
              Consider
              %a{:href => "octonion#ElementaryTriples"} octonionic basic triples
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi e
                      %mn 1
                    %mo ,
                    %msub
                      %mi e
                      %mn 2
                    %mo ,
                    %msub
                      %mi e
                      %mn 3
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msup
                      %mi 𝕆
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} (e_1, e_2, e_3) \in \mathbb{O}^3
              and the fact (
              %a{:href => "octonion#BasicTriplesFormAutomorphism"}> this proposition
              ) that these form a
              %a.existingWikiWord{:href => "/nlab/show/torsor"} torsor
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi G
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} G_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi e
                      %mn 1
                    %mo ,
                    %msub
                      %mi e
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (e_1,e_2)
              is equivalently a choice of inclusion
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℍ
                      %mo ↪
                      %mi 𝕆
                    %annotation{:encoding => "application/x-tex"} \mathbb{H} \hookrightarrow \mathbb{O}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi e
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} e_3
              is the
              %a.existingWikiWord{:href => "/nlab/show/3-sphere"} 3-sphere
              (the space of unit imaginary octonions orthogonal to both
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi e
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} e_1
              and
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi e
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} e_2
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SU
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
