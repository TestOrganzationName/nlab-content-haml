              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(2)
            %a.existingWikiWord{:href => "/nlab/show/simple+Lie+group"} simple
