            = succeed ")" do
              %em
                %a{:href => "SO%283%29#irreducible_representations"} SO(3) – Irreps
          %p
            Furthermore there is a
            %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
