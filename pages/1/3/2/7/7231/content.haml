                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Stab_{G_2}(\mathbb{H})
                  , the
                  %a.existingWikiWord{:href => "/nlab/show/stabilizer+subgroup"} stabilizer subgroup
                  of
                  %a.existingWikiWord{:href => "/nlab/show/generalized+the"} the
                  %a.existingWikiWord{:href => "/nlab/show/quaternions"} quaternions
                  inside the octonions, i.e. of elements
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi σ
                        %mo ∈
                        %msub
                          %mi G
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} \sigma\in G_2
                  such that
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi σ
