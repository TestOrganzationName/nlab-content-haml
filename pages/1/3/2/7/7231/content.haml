          %p
            (from
            = succeed ")" do
              %a{:href => "#Kramer02"} Kramer 02
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/Weyl+group"} Weyl group
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
