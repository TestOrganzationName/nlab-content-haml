                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msub
                              %mi Stab
                              %mrow
                                %msub
                                  %mi G
                                  %mn 2
                            %mo{:stretchy => "false"} (
                            %mi ℍ
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                          %mtd
                            %mi SO
                            %mo{:stretchy => "false"} (
                            %mn 4
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi Aut
                            %mo{:stretchy => "false"} (
                            %mi ℍ
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                          %mtd
                            %mi SO
                            %mo{:stretchy => "false"} (
