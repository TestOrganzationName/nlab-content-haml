            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo ,
                    %mi v
                    %mo ,
                    %mi w
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mo ,
                    %mi v
                    %mo ×
                    %mi w
                    %mo{:stretchy => "false"} ⟩
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\omega(u,v,w) \coloneqq \langle u , v \times w\rangle
                    \\,,
            %p where
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
