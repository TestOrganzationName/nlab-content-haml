                      %mi ℝ
                      %mn 7
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \omega \in \Omega^3(\mathbb{R}^7)
              given on tangent vectors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo ,
                    %mi v
                    %mo ,
                    %mi w
                    %mo ∈
                    %msup
                      %mi ℝ
                      %mn 7
                  %annotation{:encoding => "application/x-tex"} u,v,w \in \mathbb{R}^7
