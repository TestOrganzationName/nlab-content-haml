              by the
              %a.existingWikiWord{:href => "/nlab/show/special+unitary+group"} special unitary group
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
