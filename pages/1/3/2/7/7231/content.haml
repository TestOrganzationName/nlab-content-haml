          #StabilizerOfQuaternions.num_defn
            %h6#definition_3 Definition
            %p Write
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msub
                          %mi G
                          %mn 2
                        %mo =
                        %mi Aut
                        %mo{:stretchy => "false"} (
                        %mi 𝕆
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} G_2 = Aut(\mathbb{O})
                  , the
                  %a.existingWikiWord{:href => "/nlab/show/automorphism+group"} automorphism group
                  of the octonions as a normed alegbra,
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msub
                          %mi Stab
