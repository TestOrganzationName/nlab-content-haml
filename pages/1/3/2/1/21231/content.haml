                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  E
                  \&amp; \coloneqq
                  \\sqrt{
                  \\vec E \cdot \vec E
                  }
                  \\\
                  B
                  \&amp; \coloneqq
                  \\sqrt{
                  \\vec B \cdot \vec B
                  }
                  \\end{aligned}
          %p
            for the
            %a.existingWikiWord{:href => "/nlab/show/norm"} norm
            of these field vectors. These, of course, depend on the choice of Lorentz frame. For the Schwinger effect the relevant
            %a.existingWikiWord{:href => "/nlab/show/Lorentz+group"} Lorentz
            %a.existingWikiWord{:href => "/nlab/show/invariants"} invariants
            are
          #eq:LorentzInvariantFieldStrenghts.maruku-equation
            %span.maruku-eq-number (2)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
