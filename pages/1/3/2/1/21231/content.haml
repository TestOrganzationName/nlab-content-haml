            a
            %a.existingWikiWord{:href => "/nlab/show/constant+function"} constant
            %a.existingWikiWord{:href => "/nlab/show/electromagnetic+field"} electromagnetic field
            on 4d
            %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
            in a given Lorentz frame.
          %p Write
          #eq:ActualFieldStrengths.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
