                %a.existingWikiWord{:href => "/nlab/files/Benabou-CategoriesMultiplicatives.pdf", :title => "pdf"} pdf
          %p Textbook accounts:
          %ul
            %li#MacLane71
              %p
                %a.existingWikiWord{:href => "/nlab/show/Saunders+MacLane"}> Saunders MacLane
                , Section VII.1 of:
                = succeed "," do
