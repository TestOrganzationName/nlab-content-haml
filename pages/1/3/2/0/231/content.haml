                                        %mi x
                                        %mo ⊗
                                        %mi y
                                        %mo ,
                                        %mi z
                              %mtd
                              %mtd
                                %mi w
                                %mo ⊗
                                %mo{:stretchy => "false"} (
                                %mo{:stretchy => "false"} (
                                %mi x
                                %mo ⊗
                                %mi y
                                %mo{:stretchy => "false"} )
                                %mo ⊗
                                %mi z
                                %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        \&amp;&amp; (w \otimes x) \otimes (y \otimes z)
                        \\\
                        \&amp; {}^{\mathllap{\alpha_{w \otimes x, y, z}}}\nearrow
                        \&amp;&amp;
                        \\searrow^{\mathrlap{\alpha_{w,x,y \otimes z}}}
                        \\\
                        ((w \otimes x ) \otimes y) \otimes z
                        \&amp;&amp; &amp;&amp;
                        w \otimes (x \otimes (y \otimes z))
                        \\\
                        {}^{\mathllap{\alpha_{w,x,y}} \otimes id_z }\downarrow
                        \&amp;&amp; &amp;&amp;
                        \\uparrow^{\mathrlap{ id_w \otimes \alpha_{x,y,z} }}
                        \\\
                        (w \otimes (x \otimes y)) \otimes z
                        \&amp;&amp; \underset{\alpha_{w,x \otimes y, z}}{\longrightarrow} &amp;&amp;
                        w \otimes ( (x \otimes y) \otimes z )
                        }
            %p
          %p
          #InViewOfMicrocosmPrinciple.num_remark
            %h6 Remark
            %p
              %strong
                (role of the
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/microcosm+principle"} microcosm principle
              %br/
              Notice how the very definition of monoidal categories (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#MonoidalCategory"}
              %em of
              categories, namely in the definition of the tensor product
              %a.maruku-eqref{:href => "#eq:TheTensorProductFunctor"} (2)
              %em in
              a category. But the operation of forming
              %a.existingWikiWord{:href => "/nlab/show/product+categories"} product categories
              is itself a (Cartesian) monoidal structure one level higher up in the
              %a.existingWikiWord{:href => "/nlab/show/higher+category+theory"} higher category theory
              ladder, namely on the ambient
              %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
              %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
              of categories, which thereby becomes a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/monoidal+2-category"} monoidal 2-category
            %p
              The ability to define pseudomonoids in any monoidal 2-category is an
              %a{:href => "microcosm+principle#examples"} example
              of the so-called
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/microcosm+principle"} microcosm principle
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/higher+structure"} higher
              %a.existingWikiWord{:href => "/nlab/show/mathematical+structure"} structures
              uses and requires analogous algebraic structure present on the ambient higher category.
              %br/
          %p
            With this understood, there is a succinct abstract definition of monoidal categories:
          #AsPseudomonoidsInCat.num_defn
            %h6 Definition
            %p
              %strong
                (as pseudomonoids in
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Cat
                      %annotation{:encoding => "application/x-tex"} Cat
              %br/
              A monoidal category (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#MonoidalCategory"}
              %a.existingWikiWord{:href => "/nlab/show/pseudomonoid"} pseudomonoid
              in the
              %a.existingWikiWord{:href => "/nlab/show/cartesian+monoidal+category"} cartesian
              %a.existingWikiWord{:href => "/nlab/show/monoidal+2-category"} monoidal 2-category
              %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
              of categories.
          %p
          #MakingTheAmbientStructureMorphismsExplicit.num_remark
            %h6 Remark
            %p
              %strong (making the ambient structure morphisms explicit)
              %br/
              The equivalent perspective of Def.
              %a.maruku-ref{:href => "#AsPseudomonoidsInCat"}
              makes manifest that there is room to be more pedantic about Def.
              = succeed "," do
                %a.maruku-ref{:href => "#MonoidalCategory"}
              %a.existingWikiWord{:href => "/nlab/show/monoidal+2-category"} monoidal 2-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Cat
                    %mo ,
                    %mo *
                    %mo ,
                    %mo ×
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Cat, \ast, \times)
              has its own
              %a.existingWikiWord{:href => "/nlab/show/associator"} associator
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi Cat
                    %mo ×
                    %mi Cat
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi Cat
                    %mover
                      %mo →
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mo ≃
                        %mspace{:width => "thickmathspace"}
                    %mi Cat
                    %mo ×
                    %mo{:stretchy => "false"} (
                    %mi Cat
                    %mo ×
                    %mi Cat
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\alpha
                    \\;\colon\;
                    (Cat\times Cat) \times Cat
                    \\xrightarrow{\; \simeq \;}
                    Cat \times (Cat\times Cat)
                    \\,,
            %p which, while evident, is, strictly speaking, non-trivial.
            %p
              This means that the
              %a.existingWikiWord{:href => "/nlab/show/associator"} associator
              %a.maruku-eqref{:href => "#eq:AssociatorInAMonoidalCategory"} (3)
              in a monoidal category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is actually of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi α
                      %mi 𝒞
                    %mrow
                      %mo [
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo ⊗
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ⊗
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo ]
                    %mover
                      %mo ⟶
                      %mo ≃
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    a
                    \\;\colon\;
                    \\alpha_\mathcal{C} \left[ ((-)\otimes (-)) \otimes (-)\right]
                    \\overset{\simeq}{\longrightarrow}
                    (-) \otimes ((-)\otimes(-))
                    \\,.
            %p
              Analogously, the ambient
              %a.existingWikiWord{:href => "/nlab/show/monoidal+2-category"} monoidal 2-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Cat
                    %mo ,
                    %mo *
                    %mo ,
                    %mo ×
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Cat, \ast, \times)
              comes with its own
              %a.existingWikiWord{:href => "/nlab/show/unitor"} unitor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Λ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo *
                    %mo ×
                    %mtext Cat
                    %mover
                      %mo →
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mo ≃
                        %mspace{:width => "thickmathspace"}
                    %mtext Cat
                  %annotation{:encoding => "application/x-tex"}
                    \\Lambda
                    \\;\colon\;
                    \\ast \times
                    \\text{Cat}
                    \\xrightarrow{\;\simeq\; }
                    \\text{Cat}
            %p
              (for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \ast
              denoting the
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/terminal+category"} terminal category
              %a.existingWikiWord{:href => "/nlab/show/unitor"} unitor
              %a.maruku-eqref{:href => "#eq:LeftUnitorInAMonoidalCategory"} (4)
              in a monoidal category is actually of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Λ
                      %mi 𝒞
                    %mrow
                      %mo [
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo ⊗
