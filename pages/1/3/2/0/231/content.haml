          #kel2.num_lemma
            %h6#lemma_2 Lemma
            %p
              %strong
                (
                %a{:href => "#Kelly"}> Kelly 64
                )
              The equation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi λ
                      %mn 1
                    %mo =
                    %msub
                      %mi ρ
                      %mn 1
                    %mo{:lspace => "verythinmathspace"} :
                    %mn 1
                    %mo ⊗
                    %mn 1
                    %mo →
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \lambda_1 = \rho_1 \colon 1 \otimes 1 \to 1
              holds in a monoidal category.
          .proof
            %h6#proof_2 Proof
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ⊗
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} - \otimes 1
              is an equivalence, it suffices to show
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi λ
                        %mn 1
                      %mn 1
                      %mo =
                      %msub
                        %mi ρ
                        %mn 1
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} \lambda_1 1=\rho_1 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %msub
                      %mi λ
                      %mn 1
                    %mo =
                    %msub
                      %mi λ
                      %mn 11
                  %annotation{:encoding => "application/x-tex"} 1\lambda_1=\lambda_{11}
              by the naturality equation
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi λ
                        %mn 1
                      %mo ∘
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %msub
                        %mi λ
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi λ
                        %mn 1
                      %mo ∘
                      %msub
                        %mi λ
                        %mn 11
                    %annotation{:encoding => "application/x-tex"} \lambda_1 \circ (1\lambda_1) = \lambda_1 \circ \lambda_{11}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi λ
                      %mn 1
                    %mn 1
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msub
                      %mi λ
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %msub
                      %mi α
                      %mrow
                        %mn 1
                        %mo ,
                        %mn 1
                        %mo ,
                        %mn 1
                    %mo =
                    %msub
                      %mi ρ
                      %mn 1
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \lambda_1 1 = (1 \lambda_1) \circ \alpha_{1, 1, 1} = \rho_1 1
            %p
              where the first equation follows from Lemma
              %a.maruku-ref{:href => "#kel1"}
              and the second from the triangle identity.
          #end_commutative.num_lemma
            %h6#proposition Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/endomorphism"} endomorphism
              %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi End
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} End(1)
              is commutative.
          .proof
            %h6#proof_3 Proof
            %p
              The isomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ≔
                    %msub
                      %mi λ
                      %mn 1
                    %mo =
                    %msub
                      %mi ρ
                      %mn 1
                    %mo{:lspace => "verythinmathspace"} :
                    %mn 1
                    %mo ⊗
                    %mn 1
                    %mo →
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} i \coloneqq \lambda_1 = \rho_1 \colon 1 \otimes 1 \to 1
              (using Lem.
              = succeed ")" do
                %a.maruku-ref{:href => "#kel2"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi End
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} End(1)
              given by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo *
                    %mi g
                    %mo ≔
                    %mi i
                    %mo ∘
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ⊗
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %msup
                      %mi i
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} f * g \coloneqq i \circ (f \otimes g) \circ i^{-1}
              for two endomorphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ,
                    %mi g
                    %mo{:lspace => "verythinmathspace"} :
                    %mn 1
                    %mo →
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} f, g\colon 1 \to 1
              with neutral element
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} id
                        %mn 1
                      %mo{:lspace => "verythinmathspace"} :
                      %mn 1
                      %mo →
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} \id_1\colon 1 \to 1
            %p
              For endomorphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ,
                    %mi b
                    %mo ,
                    %mi c
                    %mo ,
                    %mi d
                    %mo{:lspace => "verythinmathspace"} :
                    %mn 1
                    %mo →
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} a,b,c,d\colon 1 \to 1
              one has
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ∘
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo *
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ∘
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi i
                    %mo ∘
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ∘
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ∘
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %msup
                      %mi i
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo =
                    %mi i
                    %mo ∘
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ⊗
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo ⊗
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %msup
                      %mi i
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo *
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo *
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (a \circ b) * (c \circ d)
                    \=i \circ ((a \circ b) \otimes (c \circ d)) \circ i^{-1}
                    \=i \circ ((a \otimes c) \circ (b \otimes d)) \circ i^{-1}
                    \=(a * c) \circ (b * d)
            %p
              hence the
              %a.existingWikiWord{:href => "/nlab/show/Eckmann-Hilton+argument"} Eckmann-Hilton argument
              yields the result.
          %h3#strict_monoidal_categories Strict monoidal categories
          %p
          #StrictMonoidalCategory.num_defn
            %h6 Definition
            %p
              %strong (strict monoidal category)
              %br/
              A monoidal category (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#MonoidalCategory"}
              %strong strict
              if the associator, left unitor and right unitors are all
              %a.existingWikiWord{:href => "/nlab/show/identity+morphisms"} identity morphisms
              (up to the ambient structure morphisms, see Rem.
              = succeed ")." do
                %a.maruku-ref{:href => "#MakingTheAmbientStructureMorphismsExplicit"}
            %p
              In this case the
              %a.existingWikiWord{:href => "/nlab/show/pentagon+identity"} pentagon identity
              and the
              %a.existingWikiWord{:href => "/nlab/show/triangle+identities"} triangle identities
              hold automatically.
          %p
            In analogy to Def.
            %a.maruku-ref{:href => "#AsPseudomonoidsInCat"}
            we have:
          .num_defn
            %h6 Definition
            %p
              A strict monoidal category (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#StrictMonoidalCategory"}
              %a.existingWikiWord{:href => "/nlab/show/monoid+in+a+monoidal+category"} monoid in
              the
              %a.existingWikiWord{:href => "/nlab/show/cartesian+monoidal+category"} cartesian
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal
              %a.existingWikiWord{:href => "/nlab/show/1-category"} 1-category
              %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
              of categories and
              %a.existingWikiWord{:href => "/nlab/show/functors"} functors
              (i.e. with non non-identity
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
              between them).
          %p
            Very explicitly, it means that:
          .num_defn
            %h6 Definition
            %p
              A strict monoidal category (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#StrictMonoidalCategory"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              equipped with an object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} 1 \in \mathcal{C}
              and a
              %a.existingWikiWord{:href => "/nlab/show/bifunctor"} bifunctor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊗
                    %mo :
                    %mi 𝒞
                    %mo ×
                    %mi 𝒞
                    %mo →
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \otimes:\mathcal{C} \times \mathcal{C} \rightarrow \mathcal{C}
              such that for every objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ,
                    %mi B
                    %mo ,
                    %mi C
                  %annotation{:encoding => "application/x-tex"} A,B,C
              and morphisms
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ,
                      %mi g
                      %mo ,
                      %mi h
                    %annotation{:encoding => "application/x-tex"} f,g,h
            %ul
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ⊗
                      %mi B
                      %mo{:stretchy => "false"} )
                      %mo ⊗
                      %mi C
                      %mo =
                      %mi A
                      %mo ⊗
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo ⊗
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (A \otimes B) \otimes C = A \otimes (B \otimes C)
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mo ⊗
                      %mi A
                      %mo =
                      %mi A
                    %annotation{:encoding => "application/x-tex"} 1 \otimes A = A
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ⊗
                      %mn 1
                      %mo =
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A \otimes 1 = A
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo ⊗
                      %mi g
                      %mo{:stretchy => "false"} )
                      %mo ⊗
                      %mi h
                      %mo =
                      %mi f
                      %mo ⊗
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo ⊗
                      %mi h
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (f \otimes g) \otimes h = f \otimes (g \otimes h)
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Id
                        %mn 1
                      %mo ⊗
                      %mi f
                      %mo =
                      %mi f
                    %annotation{:encoding => "application/x-tex"} Id_{1} \otimes f = f
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ⊗
                      %msub
                        %mi Id
                        %mn 1
                      %mo =
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f \otimes Id_{1} = f
            %p
          %h3#the_2category_of_monoidal_categories The 2-category of monoidal categories
          %p
            There is a
            %a.existingWikiWord{:href => "/nlab/show/strict+2-category"} strict 2-category
            MonCat with:
          %ul
            %li
              %p
                monoidal categories as
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/monoidal+functors"} monoidal functors
                as
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/1-morphisms"} 1-morphisms
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/monoidal+natural+transformations"} monoidal natural transformations
                as
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/2-morphisms"} 2-morphisms
          %p
            One version of
            %a.existingWikiWord{:href => "/nlab/show/coherence+theorem+for+monoidal+categories"} Mac Lane's Coherence Theorem
            states that in MonCat, every monoidal category is equivalent to a strict one.
          %p
            Every monoidal category is also
            %a.existingWikiWord{:href => "/nlab/show/equivalence+in+a+2-category"} equivalent
            In MonCat to a
            %a.existingWikiWord{:href => "/nlab/show/skeletal+category"} skeletal
            monoidal category. However, not every monoidal category is equivalent in MonCat to a skeletal strict monoidal category. For example, the category
            %a.existingWikiWord{:href => "/nlab/show/FinSet"} FinSet
            with its cartesian product is equivalent in MonCat to a skeletal strict monoidal category, but the category
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            with its cartesian product is not. For the former fact, see
            = succeed ";" do
              %a{:href => "https://golem.ph.utexas.edu/category/2006/10/classical_vs_quantum_computati_2.html#c015959"} this remark by Jamie Vicary
            = succeed "." do
              %a{:href => "#MacLane71"} MacLane (1971), Section VII.1
          %h2#Properties Properties
          %h3#coherence Coherence
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/coherence+theorem+for+monoidal+categories"} coherence theorem for monoidal categories
          %h3#closure Closure
          .un_prop
            %h6#proposition_2 Proposition
            %p
              Every small monoidal category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              embeds as a
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ↪
                    %mi D
                  %annotation{:encoding => "application/x-tex"} C \hookrightarrow D
              into a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed monoidal category
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/monoidal+functor"} monoidal functor
          .proof
            %h6#proof_4 Proof
            %p
              One can take
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo =
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D = PSh(C)
              be the
              %a.existingWikiWord{:href => "/nlab/show/category+of+presheaves"} category of presheaves
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo :
                    %mi C
                    %mo ↪
                    %mi D
                  %annotation{:encoding => "application/x-tex"} j : C \hookrightarrow D
              the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              becomes a
              %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed monoidal category
              with the
              %a.existingWikiWord{:href => "/nlab/show/Day+convolution"} Day convolution
              tensor product, which for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ,
                    %mi G
                    %mo ∈
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F,G \in PSh(C)
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ⋆
                    %mi G
                    %mo :
                    %mi e
                    %mo ↦
                    %msup
                      %mo ∫
                      %mrow
                        %mi c
                        %mo ,
                        %mi d
                        %mo ∈
                        %mi C
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %msub
                      %mi Hom
                      %mi C
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %mi c
                    %mo ⊗
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    F \star G : e \mapsto
                    \\int^{c,d \in C}
                    F(c) \times G(d) \times Hom_C(e, c \otimes d)
                    \\,.
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              are both in the image of the Yoneda embedding,
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo =
                      %msub
                        %mi Hom
                        %mi C
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mi a
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F = Hom_C(-,a)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo =
                    %msub
                      %mi Hom
                      %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G = Hom_C(-,b)
              for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ,
                      %mi b
                      %mo ∈
                      %mi C
                    %annotation{:encoding => "application/x-tex"} a,b \in C
              %a.existingWikiWord{:href => "/nlab/show/co-Yoneda+lemma"} co-Yoneda lemma
              to the two
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/coend"} coend
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              we get
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi j
                            %mo{:stretchy => "false"} (
                            %mi a
                            %mo{:stretchy => "false"} )
                            %mo ⋆
                            %mi j
                            %mo{:stretchy => "false"} (
                            %mi b
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi e
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %msup
                              %mo ∫
                              %mrow
                                %mi c
                                %mo ,
                                %mi d
                                %mo ∈
                                %mi C
                            %msub
                              %mi Hom
                              %mi C
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo ,
                            %mi a
                            %mo{:stretchy => "false"} )
                            %mo ×
                            %msub
                              %mi Hom
                              %mi C
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo ,
                            %mi b
                            %mo{:stretchy => "false"} )
                            %mo ×
                            %msub
                              %mi Hom
                              %mi C
                            %mo{:stretchy => "false"} (
                            %mi e
                            %mo ,
                            %mi c
                            %mo ⊗
                            %mi d
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mi Hom
                              %mi C
                            %mo{:stretchy => "false"} (
                            %mi e
                            %mo ,
                            %mi a
                            %mo ⊗
                            %mi b
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mi j
                            %mo{:stretchy => "false"} (
                            %mi a
                            %mo ⊗
                            %mi b
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi e
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    (j(a) \star j(b))(e)
                    \&amp;
                    \=
                    \\int^{c,d \in C}
                    Hom_C(c,a) \times Hom_C(d,b)\times Hom_C(e, c \otimes d)
                    \\\
                    \&amp; \simeq
                    Hom_C(e, a \otimes b)
                    \\\
                    \&amp; \simeq
                    j(a \otimes b)(e)
                    \\,,
                    \\end{aligned}
            %p
              naturally in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi e
                    %annotation{:encoding => "application/x-tex"} e
          %h3#relation_to_multicategories Relation to multicategories
          %p
            There is a
            %a.existingWikiWord{:href => "/nlab/show/faithful+functor"} faithful functor
            from monoidal categories to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/multicategories"} multicategories
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/representable+multicategory"} representable multicategories
          %p
            %a.existingWikiWord{:href => "/nlab/show/lax+monoidal+functors"} Lax monoidal functors
            between monoidal categories are in correspondence with
            %a.existingWikiWord{:href => "/nlab/show/morphism+of+multicategories"} morphisms
            between their underlying representable multicategories.
          %h3#relation_to_pros Relation to PROs
          %p
            There is a
            %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful functor
            from monoidal categories to colored
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/PROs"} PROs
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/property"} property
          %p
            A colored PRO is called
            %em representable
            if every list of generating objects (or equivalently, every pair of generating objects and the empty list) is isomorphic to a single generating object. The category of monoidal categories and (strong) monoidal functors is equivalent to the category of representable colored PROs and colored PRO morphisms (which are required to preserve generating objects). Moreover, the category of monoidal categories and
            %em strict
            monoidal functors is equivalent to the category whose objects are colored PROs equipped with
            %em choices
            of such binary and nullary isomorphisms, and whose arrows are colored PRO homomorphisms that preserve these chosen isomorphisms.
          %h3#internal_logic Internal logic
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/internal+language"} internal language
            of monoidal categories is a flavor of
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/linear+logic"} linear logic
            %a.existingWikiWord{:href => "/nlab/show/linear+type+theory"} linear type theory
            (non-commutative multiplicative intuitionistic linear type theory). In this logical context the
            %a.existingWikiWord{:href => "/nlab/show/string+diagrams"} string diagrams
            of monoidal categories are called
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/proof+nets"} proof nets
          %h3#scalars Scalars
          %p
            In any monoidal category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mo ⊗
                    %mo ,
                    %mi I
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{C}, \otimes, I)
            %a.existingWikiWord{:href => "/nlab/show/hom-set"} hom-set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                  %mo{:stretchy => "false"} [
                  %mi I
                  %mo ,
                  %mi I
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \mathcal{C}[I,I]
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/commutative+monoid"} commutative monoid
            = succeed "," do
              %a{:href => "#KellyLaplaza80"} Kelly &amp; Laplaza (1980), Prop. 6.1
            %a.existingWikiWord{:href => "/nlab/show/categorical+quantum+mechanics"} categorical quantum mechanics
            by
            %a.existingWikiWord{:href => "/nlab/show/Samson+Abramsky"} Abramsky
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Bob+Coecke"} Coecke
            = succeed "." do
              %a{:href => "#AbramskyCoecke04"} Abramsky &amp; Coecke (2004), Sec. 6
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Eckmann-Hilton+argument"} Eckmann-Hilton argument
          %h2#where_the_definition_comes_from Where the definition comes from
          %p
            The definition of monoidal category looks rather complicated at first sight, so it is natural to wonder if there is some magic wand we can wave that makes it appear automatically. For example, one might wonder if we can define monoidal categories using
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/internalization"} internalization
          %p
            In fact a
            %em strict
            monoidal category is just a
            %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
            internal to the category
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
            %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
            is a monoidal category! Furthermore, hardly any of the monoidal categories in nature are strict.
          %p So, we need to weaken the definition of monoidal category, and this is where the subtleties come in: we need the associator, left unitor, and right unitor to satisfy some ‘coherence laws’ — e.g. the pentagon identity.
          %p
            But
            %em where do the coherence laws come from?
          %p In fact, these are precisely what we need to make any diagram built solely by tensoring, associators, and unitors commute. This fact is another version of Mac Lane’s Coherence Theorem. Mac Lane proved it in the same paper where he originally defined the concept of monoidal category.
          %p There are indeed ‘magic wands’ that automatically produce the definition of monoidal category, but most of these magic wands are so heavy that only more advanced wizards can lift them.
          %p
            For example, you can define a monoidal category to be a
            %a.existingWikiWord{:href => "/nlab/show/pseudomonoid"} pseudomonoid
            internal to the 2-category
            %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
            — but nobody knew how to define these concepts until they knew what a monoidal category is!
          %p
            Two other closely related approaches involve
            %a.existingWikiWord{:href => "/nlab/show/2-monad"} 2-monad theory
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
          %p
            To make the first one work, the magic words to say are “there is a 2-monad whose algebras are strict monoidal categories, and a (non-strict) monoidal category is a pseudo-algebra for that 2-monad.” This doesn’t give you the definition of monoidal categories that we’re used to, though; it gives you the
            %a.existingWikiWord{:href => "/nlab/show/bias"} unbiased
            version.
          %p
            To make the second magic wand work, the magic words to say are “there is a monad/operad/etc. in
            %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
            whose algebras are strict monoidal categories, and the monad/operad/etc. whose algebras are (non-strict) monoidal categories is a cofibrant replacement for that one.” Since cofibrant replacements are usually defined only up to equivalence, this one also doesn’t determine the usual definition uniquely. There is a “canonical” choice, but again it gives you the unbiased version. The equation “cofibrant =
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/flexibility"} flexible
          %p
            Of course, both are also sort of a cheat, since in order to prove that the biased and unbiased definitions are equivalent, you need to have the
            %a.existingWikiWord{:href => "/nlab/show/coherence+theorem"} coherence theorem
            for the biased definition. However, it’s only because of the coherence theorem that we can say definitely that the usual set of complicated-looking diagrams is “correct.” The approach using lax
            = succeed "-functors" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-functor" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %em specific
            diagrams in the usual biased definition of monoidal category.
          %p
            However, if we temporarily ignore the unitors and focus on the associator, we may ask
            %em where does the pentagon identity come from?
            And one answer to this is provided by the Stasheff polytopes, which can be nicely obtained using
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/orientals"} orientals
            = succeed "!" do
              %a.existingWikiWord{:href => "/nlab/show/oriental"} 4th oriental
          %h2#relation_to_lax_functors_orientals_and_descent Relation to lax functors, orientals and descent
          %p
            One can understand the structure of a monoidal category as a special simple case of the general notion of “lax
            = succeed "-functor\u201D," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-categorical" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/descent"} descent
            and as the notion of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/anafunctor"} infinity-anafunctor
          %p
            The discussion to follow now notably links the definition of monoidal category as above with that of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/monoidal+%28infinity%2C1%29-category"} monoidal (infinity,1)-category
          %p
            This may be familiar from the special simple case of a
            %em monoid
            in any bicategory
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo :
                  %mi pt
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"}
                  A : pt \to C
          %p
            from the point to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %a.existingWikiWord{:href => "/nlab/show/identity+morphism"} identity morphism
            on the point to some
            %a.existingWikiWord{:href => "/nlab/show/endomorphism"} endomorphism
            of that object. The unitor of the lax functor gives the product on that endomorphism and the coherence of the unitor is the associativity condition on this product.
          %p
            This is part of a more general principle. A lax
            %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
            in any tricategory would again be a lax functor from the point to that tricategory.
          %p
            And a monoidal category can be regarded as a pseudomonoid in the tricategory
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}Cat
            %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
            on categories.
          %p
            Evidently, in the fully general context of weak
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/higher+category+theory"} higher category theory
            is to organize this mess into something pretty and then to deal with this problem.
          %p
            But before being intimidated by the problem in its most general form, it may pay to understand it in slightly simplified situations. One such slightly simplified setup is that of
            %em strict
            = succeed "-categories," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/strict+omega-category"} strict omega-categories
          %p
            For that case, Ross Street has given a general combinatorial formula for the
            = succeed "-coherence" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/oriental"} orientals
          %p
            See the picture of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/oriental"} first five orientals
          %ul
            %li
              %p
                identify the monoidal category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
                itself with the first oriental, just an arrow;
            %li
              %p
                identify the ambient product
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                      %mo ×
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M \times M
                with the juxtaposition of two such arrows;
            %li
              %p
                identify the tensor product
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                      %mo ⊗
                      %mi M
                      %mo →
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M \otimes M \to M
                with the second oriental: a triangular cell going from the concatenation of two arrows to a single arrow;
            %li
              %p
                identify the
                %em associator
                with the third oriental, the tetrahedron: a map from one way to compose three arrows (=copies of
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi M
                      %annotation{:encoding => "application/x-tex"} M
            %li
              %p
                identify the pentagon identity with the fourth oriental. In general, the fourth oriental is itself a nontrivial 4-cell, but assume now that the big arrow in the middle of that is the identity. This makes what in general would be the
                = succeed "," do
                  %em pentagonator
                %em pentagon identity
                in this case.
