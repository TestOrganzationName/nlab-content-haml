                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    ((1 1)x) y
                    \&amp; \stackrel{\alpha_{1, 1, x}y}{\to} &amp;
                    (1(1 x))y
                    \&amp; \stackrel{\alpha_{1, 1 x, y}}{\longrightarrow} &amp;
