                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi q
                          %mtd
                            %msub
                              %mo ↗
                              %mi s
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi i
                        %mtr
                          %mtd
                          %mtd
                            %mover
                              %mo →
                              %mi j
                          %mtd
                  %annotation{:encoding => "application/x-tex"}
