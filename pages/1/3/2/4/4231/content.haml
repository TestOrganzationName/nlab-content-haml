                      %semantics
                        %mrow
                          %mi C
                        %annotation{:encoding => "application/x-tex"} C
              %li
                %p
                  every
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ∈
                        %mi PSh
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} X \in PSh(A)
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/union"} union
                  of those of its
                  %a.existingWikiWord{:href => "/nlab/show/sub-objects"} sub-objects
                  isomorphic to an object in
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi D
                        %annotation{:encoding => "application/x-tex"} D
              %li
                %p
                  for every
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo →
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} X \to Y
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  and every sub-object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Z
                      %annotation{:encoding => "application/x-tex"} Z
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} Y
                  in
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
