          #NaiveFibIntoFibIsWeakEquivIffItIsAcyclicFib.num_lemma
            %h6#lemma_8 Lemma
            %p
              A morphism into a fibrant object with
              %a.existingWikiWord{:href => "/nlab/show/right+lifting+property"} right lifting property
              against anodyne extensions is a weak equivalence precisely if it is an acyclic fibration.
          %p
            (
            %a{:href => "#Cisinski06"}> Cisinski 06, lemma 1.3.34
            ).
          .proof
            %h6#proof_22 Proof
            %p
              We already know from prop.
              %a.maruku-ref{:href => "#AcyclicFibrationsAreAcyclicFibrations"}
              that acyclic fibrations are weak equivalences.
            %p
              So let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              be fibrant and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} p : X \to Y
