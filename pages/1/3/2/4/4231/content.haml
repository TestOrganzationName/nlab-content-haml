                %a.existingWikiWord{:href => "/nlab/show/anodyne+extensions"} anodyne extensions
            %a.maruku-ref{:href => "#ModelStructureMorphismsFromHomotopicalStructure"}
            this defines a
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            structure on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PSh(A)
          #FunctorialCylinder.num_defn
            %h6#definition_3 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
