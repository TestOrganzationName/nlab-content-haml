              and
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/transfinite+composition"} transfinite composition
          %p The following lemma will be used to show that cellular structures always exist.
          #LemmaForGenerationOfMonos.num_lemma
            %h6#lemma_3 Lemma
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
