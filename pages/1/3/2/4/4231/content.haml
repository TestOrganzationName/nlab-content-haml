                    I \otimes X &amp;\stackrel{I \otimes f}{\to}&amp; I \otimes Y &amp;\stackrel{\eta}{\to}&amp; Z
                    \\\
                    \\uparrow &amp;&amp; \uparrow &amp; \nearrow_{g'}
                    \\\
                    X &amp;\stackrel{f}{\to}&amp; Y
                    }
            %p
              and then an elementary
              = succeed "-homotopy" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                    %annotation{:encoding => "application/x-tex"} J
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ′
                    %mo ∘
                    %mi f
                    %mo ⇒
                    %mi g
                    %mo ′
                    %mo ∘
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g' \circ f \Rightarrow g '\circ g
              by forming
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                          %mtd
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msup
                              %mo ↘
                              %mi f
                        %mtr
                          %mtd
                            %mi I
                            %mo ⊗
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mi η
                          %mtd
                            %mi Y
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi g
                                %mo ′
                          %mtd
                            %mi Z
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↑
                          %mtd
                            %msub
                              %mo ↗
                              %mi g
                        %mtr
                          %mtd
                            %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;&amp;
                    \\\
                    \\downarrow &amp; \searrow^f
                    \\\
                    I \otimes X &amp;\stackrel{\eta}{\to}&amp; Y &amp;\stackrel{g'}{\to}&amp; Z
                    \\\
                    \\uparrow &amp; \nearrow_g
                    \\\
                    X
                    }
                    \\,.
            %p
              Together this generates a
              = succeed "-homotopy" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                    %annotation{:encoding => "application/x-tex"} J
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ′
                      %mo ∘
                      %mi f
                      %mo ⇒
                      %mi g
                      %mo ′
                      %mo ∘
                      %mi g
                    %annotation{:encoding => "application/x-tex"} f' \circ f \Rightarrow g' \circ g
          %p Hence the following is well defined.
          #JHomotopyCategory.num_defn
            %h6#definition_5 Definition
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ho
                      %mi J
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ho_J(A)
              for the category whose objects are those of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi PSh
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} PSh(A)
              = succeed "-homotopy" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                    %annotation{:encoding => "application/x-tex"} J
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PSh(A)
              – the
              = succeed "." do
                %strong
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi J
                      %annotation{:encoding => "application/x-tex"} J
                  \-homotopy category
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo :
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi Ho
                      %mi J
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Q : PSh(A) \to Ho_J(A)
            %p for the projection functor.
          #JHomotopyEquivalence.num_defn
            %h6#definition_6 Definition
            %p
              A morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f : X \to Y
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PSh(A)
              is called a
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi J
                    %annotation{:encoding => "application/x-tex"} J
                \-homotopy equivalence
              if it is sent by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
              to an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            %p
              An object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \in PSh(A)
              is called
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi J
                    %annotation{:encoding => "application/x-tex"} J
                \-contractible
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mo *
                  %annotation{:encoding => "application/x-tex"} X \to *
              is a
              = succeed "-homotopy" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                    %annotation{:encoding => "application/x-tex"} J
          %p
            (
            %a{:href => "#Cisinski06"}> Cisinski 06, def. 1.3.4
            ).
          #AcyclicFibration.num_defn
            %h6#definition_7 Definition
            %p
              A morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f : X \to Y
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PSh(A)
              is called an
              %strong acyclic fibration
              if it has the
              %a.existingWikiWord{:href => "/nlab/show/right+lifting+property"} right lifting property
              against all monomorphisms.
          %p
            (
            %a{:href => "#Cisinski06"}> Cisinski 06, def. 1.2.18
            ).
          #SomePropertiesOfAcyclicFibrations.num_prop
            %h6#proposition_3 Proposition
            %p
              Every acyclic fibration in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PSh(A)
              is a
              = succeed "-homotopy" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                    %annotation{:encoding => "application/x-tex"} J
            %p
              More is true: every trivial fibration
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} p : X \to Y
            %ol
              %li
                %p
                  has a
                  %a.existingWikiWord{:href => "/nlab/show/section"} section
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi s
                          %mo :
                          %mi Y
                          %mo →
                          %mi X
                        %annotation{:encoding => "application/x-tex"} s : Y \to X
              %li
                %p
                  which is also a
                  = succeed "-homotopy" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi J
                        %annotation{:encoding => "application/x-tex"} J
              %li
                %p
                  by an elementary
                  = succeed "-homotopy" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi J
                        %annotation{:encoding => "application/x-tex"} J
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi h
                        %mo :
                        %mi id
                        %mo ⇒
                        %mi s
                        %mo ∘
                        %mi p
                      %annotation{:encoding => "application/x-tex"} h : id \Rightarrow s \circ p
                  which satisfies
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi p
                          %mo ∘
                          %mi h
                          %mo =
                          %mi p
                          %mo ∘
                          %msub
                            %mi σ
                            %mi X
                        %annotation{:encoding => "application/x-tex"} p \circ h = p \circ \sigma_X
          %p
            (
            %a{:href => "#Cisinski06"}> Cisinski 06, lemma 1.3.5
            ).
          .proof
            %h6#proof_2 Proof
            %p
              The existence of the section
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo :
                    %mi Y
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} s : Y \to X
              follows by right lifting against the monomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ∅
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} \emptyset \to Y
              (out of the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ∅
                          %mtd
                            %mo →
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msub
                              %mo ↗
                              %mi s
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi p
                        %mtr
                          %mtd
                            %mi Y
                          %mtd
                            %mover
                              %mo →
                              %mo =
                          %mtd
                            %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\emptyset &amp;\to&amp; X
                    \\\
                    \\downarrow &amp;\nearrow_s&amp; \downarrow^{\mathrlap{p}}
                    \\\
                    Y &amp;\stackrel{=}{\to}&amp; Y
                    }
                    \\,.
            %p
              The
              = succeed "-homotopy" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                    %annotation{:encoding => "application/x-tex"} J
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
              is obtained by lifting in the diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi id
                                  %mi X
                                %mo ,
                                %mi s
                                %mo ∘
                                %mi p
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %msubsup
                                    %mo ∂
                                    %mi X
                                    %mn 0
                                  %mo ,
                                  %msubsup
                                    %mo ∂
                                    %mi X
                                    %mn 1
                                  %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi p
                        %mtr
                          %mtd
                            %mi I
                            %mo ⊗
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi p
                                %mo ∘
                                %msub
                                  %mi σ
                                  %mi X
                          %mtd
                            %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X \coprod X &amp;\stackrel{(id_X, s \circ p)}{\to}&amp; X
                    \\\
                    {}^{\mathllap{(\partial^0_X, \partial^1_X)}}\downarrow
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{p}}
                    \\\
                    I \otimes X
                    \&amp;\stackrel{p \circ \sigma_X}{\to}&amp; Y
                    }
                    \\,.
          #ElementaryHomotopicalDatum.num_defn
            %h6#definition_8 Definition
            %p
              An
              %strong elementary homotopical datum
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PSh(A)
              is a functorial cylinder
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                    %annotation{:encoding => "application/x-tex"} J
              = succeed "," do
                %a.maruku-ref{:href => "#FunctorialCylinder"}
            %ol
              %li
                %p
                  the functor
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi I
                        %mo ⊗
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} I \otimes (-)
                  commutes with small
                  %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
                  and preserves monomorphisms;
              %li
                %p
                  for all
                  %a.existingWikiWord{:href => "/nlab/show/monomorphisms"} monomorphisms
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo :
                        %mi K
                        %mo →
                        %mi L
                      %annotation{:encoding => "application/x-tex"} f : K \to L
                  the
                  %a.existingWikiWord{:href => "/nlab/show/diagrams"} diagrams
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi K
                              %mtd
                                %mover
                                  %mo →
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %mi id
                                    %mo ,
                                    %mi f
                                    %mo{:stretchy => "false"} )
                              %mtd
                                %mi L
                            %mtr
                              %mtd
                                %msup
                                  %mrow
                                  %mpadded{:lspace => "-100%width", :width => "0"}
                                    %mrow
                                      %mo{:stretchy => "false"} (
                                      %mi e
                                      %mo ,
                                      %mi id
                                      %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} ↓
                              %mtd
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↓
                                  %mpadded{:width => "0"}
                                    %mrow
                                      %mo{:stretchy => "false"} (
                                      %mi e
                                      %mo ,
                                      %mi id
                                      %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                                %mi I
                                %mo ⊗
                                %mi K
                              %mtd
                                %mover
                                  %mo →
                                  %mrow
                                    %mi I
                                    %mo ⊗
                                    %mi f
                              %mtd
                                %mi I
                                %mo ⊗
                                %mi L
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        K &amp;\stackrel{(id, f)}{\to}&amp; L
                        \\\
                        {}^{\mathllap{(e,id)}}\downarrow &amp;&amp; \downarrow^{\mathrlap{(e,id)}}
                        \\\
                        I \otimes K &amp;\stackrel{I \otimes f}{\to}&amp; I \otimes L
                        }
                %p
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi e
                        %mo ∈
                        %mo{:stretchy => "false"} {
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} e \in \{0,1\}
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
                  square.
          %p
            (
            %a{:href => "#Cisinski06"}> Cisinski 06, def. 1.3.6
            ).
          #PullbackOfMonosAndUnions.num_remark
            %h6#remark_3 Remark
            %p For
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi R
                          %mtd
                            %mo →
                          %mtd
                            %mi S
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi T
                          %mtd
                            %mo →
                          %mtd
                            %mi U
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    R &amp;\to &amp; S
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    T &amp;\to&amp; U
                    }
            %p
              a
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              square in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PSh(A)
              of two monomorphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ↪
                    %mi U
                  %annotation{:encoding => "application/x-tex"} S \hookrightarrow U
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo ↪
                      %mi U
                    %annotation{:encoding => "application/x-tex"} T \hookrightarrow U
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mi R
                    %mi S
                    %mo →
                    %mi U
                  %annotation{:encoding => "application/x-tex"}
                    T \coprod_R S \to U
            %p
              is also a monomorphism, usually written as the morphism out of the
              %em
                %a.existingWikiWord{:href => "/nlab/show/union"} union
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo ∪
                    %mi S
                    %mo ↪
                    %mi U
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    T \cup S \hookrightarrow U
                    \\,.
          .proof
            %h6#proof_3 Proof
            %p
              All this follows, for instance, from the corresponding statements in
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
          .num_defn
            %h6#definition_9 Definition
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∂
                      %mi ϵ
                    %mo :
                    %mo{:stretchy => "false"} {
                    %mi ϵ
                    %mo{:stretchy => "false"} }
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi I
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\partial^\epsilon : \{\epsilon\}\otimes(-) \hookrightarrow I \otimes(-)
                    \\,,
            %p
              for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                      %mo =
                      %mn 0
                      %mo ,
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} \epsilon = 0,1
              %a.existingWikiWord{:href => "/nlab/show/subfunctor"} subfunctor
              which is the
              %a.existingWikiWord{:href => "/nlab/show/image"} image
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mo ∂
                        %mi ϵ
                      %mo :
                      %msub
                        %mi Id
                        %mrow
                          %mi PSh
                          %mo{:stretchy => "false"} (
                          %mi A
                          %mo{:stretchy => "false"} )
                      %mo →
                      %mi I
                      %mo ⊗
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \partial^\epsilon : Id_{PSh(A)} \to I \otimes (-)
            %p
              This way for any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \in PSh(A)
              the boundary inclusions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mo ∂
                      %mi X
                      %mi ϵ
                    %mo :
                    %mi X
                    %mo →
                    %mi I
                    %mo ⊗
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \partial^\epsilon_X : X \to I \otimes X
              are identified with
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∂
                      %mi ϵ
                    %mo ⊗
                    %msub
                      %mi id
                      %mi X
                    %mo :
                    %mo{:stretchy => "false"} {
                    %mi ϵ
                    %mo{:stretchy => "false"} }
                    %mo ⊗
                    %mi X
                    %mo →
                    %mi I
                    %mo ⊗
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\partial^\epsilon \otimes id_X : \{\epsilon\} \otimes X \to I \otimes X
                    \\,.
          .num_remark
            %h6#remark_4 Remark
            %p
              The second condition on an
              = succeed "," do
                %em elementary homotopical datum
              %a.maruku-ref{:href => "#ElementaryHomotopicalDatum"}
              implies that the canonical morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                    %mo ⊗
                    %mi K
                    %mo ∪
                    %mo{:stretchy => "false"} (
                    %mo ∂
                    %mi J
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mi L
                    %mo →
                    %mi J
                    %mo ⊗
                    %mi L
                  %annotation{:encoding => "application/x-tex"}
                    J \otimes K \cup (\partial J) \otimes L \to J \otimes L
            %p
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
          %p
            (
            %a{:href => "#Cisinski06"}> Cisinski 06, remark 1.3.7
            ).
          .proof
            %h6#proof_4 Proof
            %p The condition implies that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} {
                            %mi ϵ
                            %mo{:stretchy => "false"} }
                            %mo ⊗
                            %mi K
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi id
                                  %mo{:stretchy => "false"} {
                                %mi ϵ
                                %mo{:stretchy => "false"} }
                                %mo ⊗
                                %mi j
                          %mtd
                            %mo{:stretchy => "false"} {
                            %mi ϵ
                            %mo{:stretchy => "false"} }
                            %mo ⊗
                            %mi L
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msup
                                    %mo ∂
                                    %mi ϵ
                                  %mo ⊗
                                  %msub
                                    %mi id
                                    %mi K
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msup
                                    %mo ∂
                                    %mi ϵ
                                  %mo ⊗
                                  %msub
                                    %mi id
                                    %mi L
                        %mtr
                          %mtd
                            %mi I
                            %mo ⊗
                            %mi K
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi id
                                  %mi I
                                %mo{:stretchy => "false"} )
                                %mo ⊗
                                %mi j
                          %mtd
                            %mi I
                            %mo ⊗
                            %mi L
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\{\epsilon\} \otimes K &amp;\stackrel{id_\{\epsilon\} \otimes j}{\to}&amp;
                    \\{\epsilon\} \otimes L
                    \\\
                    {}^{\mathllap{\partial^\epsilon \otimes id_K}}\downarrow &amp;&amp; \downarrow^{\mathrlap{\partial^\epsilon \otimes id_L}}
                    \\\
                    I \otimes K &amp;\stackrel{(id_I) \otimes j}{\to}&amp; I \otimes L
                    }
            %p
              is a pullback, for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                      %mo =
                      %mn 0
                      %mo ,
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} \epsilon = 0,1
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo ∂
                            %mi I
                            %mo ⊗
                            %mi K
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi id
                                  %mrow
                                    %mo ∂
                                    %mi I
                                %mo ⊗
                                %mi j
                          %mtd
                            %mo ∂
                            %mi I
                            %mo ⊗
                            %mi L
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi i
                                  %mo ⊗
                                  %msub
                                    %mi id
                                    %mi K
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi i
                                  %mo ⊗
                                  %msub
                                    %mi id
                                    %mi L
                        %mtr
                          %mtd
                            %mi I
                            %mo ⊗
                            %mi K
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi id
                                  %mi I
                                %mo{:stretchy => "false"} )
                                %mo ⊗
                                %mi j
                          %mtd
                            %mi I
                            %mo ⊗
                            %mi L
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\partial I \otimes K &amp;\stackrel{id_{\partial I} \otimes j}{\to}&amp;
                    \\partial I \otimes L
                    \\\
                    {}^{\mathllap{i \otimes id_K}}\downarrow &amp;&amp; \downarrow^{\mathrlap{i \otimes id_L}}
                    \\\
                    I \otimes K &amp;\stackrel{(id_I) \otimes j}{\to}&amp; I \otimes L
                    }
            %p
              is a pullback. So the statement follows with remark
              = succeed "." do
                %a.maruku-ref{:href => "#PullbackOfMonosAndUnions"}
          #SegmentObject.num_example
            %h6#example Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo ∈
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} I \in PSh(A)
              be any object equipped with two points (global sections)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∂
                      %mn 0
                    %mo ,
                    %msup
                      %mo ∂
                      %mn 1
                    %mo :
                    %mo *
                    %mo →
                    %mi I
                  %annotation{:encoding => "application/x-tex"} \partial^0, \partial^1 : * \to I
              which are disjoint in that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ∅
                          %mtd
                            %mo →
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msup
                                    %mo ∂
                                    %mn 0
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msup
                                  %mo ∂
                                  %mn 1
                          %mtd
                            %mi I
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\emptyset &amp;\to&amp; *
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{\partial^0}}
                    \\\
                    * &amp;\stackrel{\partial^1}{\to}&amp; I
                    }
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              square (here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} \emptyset
              is the
              %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
              in
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi PSh
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} PSh(A)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ↦
                    %mi I
                    %mo ×
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    X \mapsto I \times X
                    \\,,
            %p where on the right we have the cartesian product.
            %p
              This defines an
              %em elementary homotopical datum
              in the sense of def.
              = succeed "." do
                %a.maruku-ref{:href => "#ElementaryHomotopicalDatum"}
          %p
            (
            %a{:href => "#Cisinski06"}> Cisinski 06, example 1.3.8
            ).
          .proof
            %h6#proof_5 Proof
            %p
              The disjointness of the two points ensures that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mo *
                    %mover
                      %mo →
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msup
                          %mo ∂
                          %mn 0
                        %mo ,
                        %msup
                          %mo ∂
                          %mn 1
                        %mo{:stretchy => "false"} )
                    %mi I
                  %annotation{:encoding => "application/x-tex"} * \coprod * \stackrel{(\partial^0, \partial^1)}{\to} I
              is a monomorphism.
            %p
              The interval commutes with colimits as these and the product are computed objectwise, and products in
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              commute with colimits. More abstractly: by the
              %a.existingWikiWord{:href => "/nlab/show/Giraud+theorem"} Giraud theorem
              valid in the
              %a.existingWikiWord{:href => "/nlab/show/presheaf+topos"} presheaf topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PSh(A)
              we have “
              %a.existingWikiWord{:href => "/nlab/show/universal+colimits"}> universal colimits
              ”: they are preserved by pullback, and in particular by cartesian product. Therefore the first clause of def.
              %a.maruku-ref{:href => "#ElementaryHomotopicalDatum"}
              is satisfied.
            %p
              Similarly, the second axiom of def.
              %a.maruku-ref{:href => "#ElementaryHomotopicalDatum"}
              holds because
              %a.existingWikiWord{:href => "/nlab/show/limits"} limits
              commute over each other.
          #LawvereCylinder.num_example
            %h6#example_2 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Lawvere+cylinder"}> Lawvere cylinder
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo :
                    %mo =
                    %mi Ω
                  %annotation{:encoding => "application/x-tex"} I := \Omega
              be the
              %a.existingWikiWord{:href => "/nlab/show/subobject+classifier"} subobject classifier
              in the
              %a.existingWikiWord{:href => "/nlab/show/presheaf+topos"} presheaf topos
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi PSh
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} PSh(A)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              assigns the set of
              %a.existingWikiWord{:href => "/nlab/show/subobjects"} subobjects
              of the
              %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representable functor
              given by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              (the
              %a.existingWikiWord{:href => "/nlab/show/sieves"} sieves
              on
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                    %mo :
                    %mi U
                    %mo ↦
                    %mi Sub
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega : U \mapsto Sub(U)
            %p
              and which to a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %msub
                      %mi U
                      %mn 1
                    %mo →
                    %msub
                      %mi U
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} f : U_1 \to U_2
              assigns the
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              functor
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mo *
                      %mo :
                      %mi Sub
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi U
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi Sub
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi U
                        %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f^* : Sub(U_2) \to Sub(U_1)
            %p Let then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∂
                      %mn 0
                    %mo ,
                    %msup
                      %mo ∂
                      %mn 1
                    %mo :
                    %mo =
                    %mo ⊤
                    %mo ,
                    %mo ⊥
                    %mo :
                    %mo *
                    %mo →
                    %mi Ω
                  %annotation{:encoding => "application/x-tex"}
                    \\partial^0, \partial^1 := \top, \bot: * \to \Omega
            %p
              be the morphisms that classify
              %a.existingWikiWord{:href => "/nlab/show/top"} top
              and
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/bottom"} bottom
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
            %p
              This is a segment object in the sense of example
              %a.maruku-ref{:href => "#SegmentObject"}
              (the “
              %a.existingWikiWord{:href => "/nlab/show/Bill+Lawvere"}> Lawvere
              \-segment”).
          %p
            (
            %a{:href => "#Cisinski06"}> Cisinski 06, example 1.3.9
            ).
          .proof
            %h6#proof_6 Proof
            %p That the two points are separated, in that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ∅
                          %mtd
                            %mo →
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ⊤
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %mover
                              %mo →
                              %mo ⊥
                          %mtd
                            %mi Ω
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\emptyset &amp;\to&amp; *
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{\top}}
                    \\\
                    * &amp;\stackrel{\bot}{\to}&amp; \Omega
                    }
            %p
              is a pullback, is the defining property of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/subobject+classifier"} subobject classifier
          #AnodyneExtensions.num_defn
            %h6#definition_10 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
              an elementary homotopical datum on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi PSh
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} PSh(A)
              %strong
                %a.existingWikiWord{:href => "/nlab/show/class"} class
                of
                %a.existingWikiWord{:href => "/nlab/show/anodyne+extensions"} anodyne extensions
              is a class
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi AnExt
                    %mo ⊂
                    %mi Mor
                    %mo{:stretchy => "false"} (
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} AnExt \subset Mor(PSh(A))
              such that
            %ol
              %li
                %p
                  there exists a
                  %a.existingWikiWord{:href => "/nlab/show/small+set"} small set
                  of monomorphisms
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
                  with
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi AnExt
                        %mo =
                        %mi LLP
                        %mo{:stretchy => "false"} (
                        %mi RLP
                        %mo{:stretchy => "false"} (
                        %mi S
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        AnExt = LLP(RLP(S))
              %li
                %p
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi K
                        %mo ↪
                        %mi L
                      %annotation{:encoding => "application/x-tex"} K \hookrightarrow L
                  a monomorphism, the
                  %a.existingWikiWord{:href => "/nlab/show/pushout-product+axiom"} pushout product
                  morphisms
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi I
                        %mo ⊗
                        %mi K
                        %mo{:stretchy => "false"} )
                        %mo ∪
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} {
                        %mi e
                        %mo{:stretchy => "false"} }
                        %mo ⊗
                        %mi L
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi I
                        %mo ⊗
                        %mi L
                      %annotation{:encoding => "application/x-tex"}
                        (I \otimes K) \cup (\{e\} \otimes L) \to I \otimes L
                %p
                  (by
                  %a.existingWikiWord{:href => "/nlab/show/Joyal-Tierney+calculus"} Joyal-Tierney calculus
                  to be thought of as “
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi K
                        %mo →
                        %mi L
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo ⊗
                          %mo{:stretchy => "false"} ¯
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} {
                        %mi e
                        %mo{:stretchy => "false"} }
                        %mo →
                        %mi I
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (K \to L) \bar \otimes (\{e\} \to I)
                  ”)
                %p
                  are in
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi AnExt
                        %annotation{:encoding => "application/x-tex"} AnExt
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi e
                          %mo ∈
                          %mo{:stretchy => "false"} {
                          %mn 0
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} }
                        %annotation{:encoding => "application/x-tex"} e \in \{0,1\}
              %li
                %p
                  if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi K
                        %mo →
                        %mi L
                      %annotation{:encoding => "application/x-tex"} K \to L
                  is in
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi AnExt
                        %annotation{:encoding => "application/x-tex"} AnExt
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi I
                        %mo ⊗
                        %mi K
                        %mo{:stretchy => "false"} )
                        %mo ∪
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} (
                        %mo ∂
                        %mi I
                        %mo{:stretchy => "false"} )
                        %mo ⊗
                        %mi L
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi I
                        %mo ⊗
                        %mi L
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        (I \otimes K) \cup ((\partial I) \otimes L)
                        \\to
                        I \otimes L
                        \\,.
                %p
                  (hence “
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi K
                        %mo →
                        %mi L
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo ⊗
                          %mo{:stretchy => "false"} ¯
                        %mo{:stretchy => "false"} (
                        %mo ∂
                        %mi I
                        %mo →
                        %mi I
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (K \to L) \bar \otimes (\partial I \to I)
                  ”).
          %p
            (
            %a{:href => "#Cisinski06"}> Cisinski 06, def. 1.3.10
            ).
          #PropertiesOfAnodyneExtensions.num_prop
            %h6#proposition_4 Proposition
            %p A class of anodyne extensions
            %ul
              %li
                %p
                  is generated under
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/pushouts"} pushouts
                  %a.existingWikiWord{:href => "/nlab/show/transfinite+composition"} transfinite composition
                  and
                  %a.existingWikiWord{:href => "/nlab/show/retracts"} retracts
                  from the morphisms in
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Λ
                        %annotation{:encoding => "application/x-tex"} \Lambda
              %li
                %p
                  is a subclass of the
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/monomorphisms"} monomorphisms
              %li
                %p
                  contains all morphisms of the form
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi e
                          %mo :
                          %mi K
                          %mo →
                          %mo{:stretchy => "false"} (
                          %mi I
                          %mo ⊗
                          %mi K
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} e : K \to (I \otimes K)
              %li
                %p
                  is closed under
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi I
                          %mo ⊗
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} I\otimes(-)
          %p
            (
            %a{:href => "#Cisinski06"}> Cisinski 06, remark. 1.3.11
            ).
          .proof
            %h6#proof_7 Proof
            %p
              By prop.
              = succeed "," do
                %a.maruku-ref{:href => "#PresheavesAreCompact"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \in PSh(A)
              is
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi Mor
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} /
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                    %annotation{:encoding => "application/x-tex"} |Mor(A/X)|
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/compact+object"} compact
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Λ
                  %annotation{:encoding => "application/x-tex"} \Lambda
              admits a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/small+object+argument"} small object argument
            %p Since monomorphisms are closed under these operations, the second statement follows.
            %p
              The third statement follows by choosing the morphism in the second item of def.
              %a.maruku-ref{:href => "#AnodyneExtensions"}
              to be
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ∅
                    %mo →
                    %mi K
                  %annotation{:encoding => "application/x-tex"} \emptyset \to K
              and using that by def.
              %a.maruku-ref{:href => "#ElementaryHomotopicalDatum"}
              the interval commutes with colimits, so that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mo ⊗
                      %mi ∅
                      %mo ≃
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} I \otimes \emptyset \simeq \emptyset
            %p
              Finally, to see that with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo :
                    %mi K
                    %mo →
                    %mi L
                  %annotation{:encoding => "application/x-tex"} j : K \to L
              also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo ⊗
                    %mi j
                    %mo :
                    %mi I
                    %mo ⊗
                    %mi L
                    %mo →
                    %mi I
                    %mo ⊗
                    %mi L
                  %annotation{:encoding => "application/x-tex"} I \otimes j : I \otimes L \to I \otimes L
              is anodyne, consider the naturality diagram of the endpoint inclusion
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi K
                          %mtd
                            %mover
                              %mo →
                              %mi j
                          %mtd
                            %mi L
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msubsup
                                    %mo ∂
                                    %mi k
                                    %mn 0
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi I
                            %mo ⊗
                            %mi K
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi j
                                %mo ′
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi I
                            %mo ⊗
                            %mi K
                            %mo{:stretchy => "false"} )
                            %mo ∪
                            %mo{:stretchy => "false"} {
                            %mn 0
                            %mo{:stretchy => "false"} }
                            %mo ⊗
                            %mi L
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mrow
                                %mi I
                                %mo ⊗
                                %mi j
                            %mo ↘
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi k
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi I
                            %mo ⊗
                            %mi L
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    K &amp;\stackrel{j}{\to}&amp; L
                    \\\
                    \\downarrow^{\mathrlap{\partial^0_k}} &amp;&amp; \downarrow
                    \\\
                    I \otimes K &amp;\stackrel{j'}{\to}&amp; (I \otimes K) \cup \{0\}\otimes L
                    \\\
                    \&amp; {}_{I \otimes j} \searrow &amp; \downarrow^{\mathrlap{k}}
                    \\\
                    \&amp;&amp; I \otimes L
                    }
                    \\,,
            %p
              factored through the top pushout square, as indicated. Here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} j'
              is anodyne, being a pushout of an anodyne morphism, and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              is anodyne by the second clause in def.
              = succeed "." do
                %a.maruku-ref{:href => "#AnodyneExtensions"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo ⊗
                    %mi j
                  %annotation{:encoding => "application/x-tex"} I \otimes j
              is anodyne.
          #HomotopicalStructure.num_defn
            %h6#definition_11 Definition
            %p
              A
              %strong homotopical structure
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PSh(A)
              is a choice of elementary homotopical datum
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                    %annotation{:encoding => "application/x-tex"} J
              %a.maruku-ref{:href => "#ElementaryHomotopicalDatum"}
              and a corresponding choice of a class of anodyne extensions
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi AnExt
                    %annotation{:encoding => "application/x-tex"} AnExt
              = succeed "." do
                %a.maruku-ref{:href => "#AnodyneExtensions"}
          %p
            (
            %a{:href => "#Cisinski06"}> Cisinski 06, def. 1.3.14
            ).
          %p
          #DefinitionHomotopicalDatum.num_defn
            %h6 Definition
            %p
              A
              = succeed "," do
                %em homotopical datum
              = succeed "," do
                %em donnée homotopique
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PSh(A)
              is a choice of elementary homotopical datum (Definition
              = succeed ")" do
                %a.maruku-ref{:href => "#ElementaryHomotopicalDatum"}
              %a.existingWikiWord{:href => "/nlab/show/monomorphisms"} monomorphisms
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi PSh
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} PSh(A)
          %p
            (
            %a{:href => "#Cisinski06"}> Cisinski 06, def. 1.3.14
            ).
          %p
          .num_remark
            %h6 Remark
            %p
              A homotopical datum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi J
                    %mo ,
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (J, S)
              %em generates
              a homotopical structure for which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi AnExt
                  %annotation{:encoding => "application/x-tex"} AnExt
              is the smallest class of anodyne extensions relative to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
              which contains
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
          %h3#the_model_structure The model structure
          #ModelStructureMorphismsFromHomotopicalStructure.num_defn
            %h6#definition_12 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              be a
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi J
                    %mo ,
                    %mi AnExt
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (J, AnExt)
              a homotopical structure, def.
              = succeed "," do
                %a.maruku-ref{:href => "#HomotopicalStructure"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi PSh
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} PSh(A)
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi PSh
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} PSh(A)
            %ul
              %li
                %p
                  the
                  %strong cofibrations
                  are the
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/monomorphisms"} monomorphisms
              %li
                %p
                  the
                  %strong fibrant objects
                  are those
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ∈
                        %mi PSh
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} X \in PSh(A)
                  for which the
                  %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal
                  morphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo →
                        %mo *
                      %annotation{:encoding => "application/x-tex"} X \to *
                  has the
                  %a.existingWikiWord{:href => "/nlab/show/right+lifting+property"} right lifting property
                  against the anodyne extensions (the morphisms in
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi AnExt
                        %annotation{:encoding => "application/x-tex"} AnExt
                  = succeed ");" do
                    %a.maruku-ref{:href => "#AnodyneExtensions"}
              %li
                %p
                  the
                  %strong weak equivalences
                  are those morphisms
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                          %mo :
                          %mi A
                          %mo →
                          %mi B
                        %annotation{:encoding => "application/x-tex"} f : A \to B
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  the induced morphism in the
                  = succeed "-homotopy" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi J
                        %annotation{:encoding => "application/x-tex"} J
                  = succeed "," do
                    %a.maruku-ref{:href => "#JHomotopyCategory"}
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Ho
                          %mi J
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo ,
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo :
                        %msub
                          %mi Ho
                          %mi J
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mo ,
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo →
                        %msub
                          %mi Ho
                          %mi J
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo ,
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        Ho_J(f,X) : Ho_J(B,X) \to Ho_J(A, X)
                %p
                  is an
                  %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
                  (a
                  %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
                  of sets).
          %p
            (
            %a{:href => "#Cisinski06"}> Cisinski 06, def. 1.3.21
            ).
          #ModelStructureFromHomotopicalStructure.num_theorem
            %h6#theorem Theorem
            %p
              With the classes of morphisms as in def.
              = succeed "," do
                %a.maruku-ref{:href => "#ModelStructureMorphismsFromHomotopicalStructure"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PSh(A)
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cofibrantly+generated+model+category"} cofibrantly generated model category
          %p
            (
            %a{:href => "#Cisinski06"}> Cisinski 06, theorem 1.3.22
            ).
          .proof
            %h6#proof_8 Proof
            %p
              The retract properties are clear, as is the 2-out-of-3 property for weak equivalences, see lemma
              %a.maruku-ref{:href => "#JHomotopyEquivsAreWeakEquivs"}
              below.
            %p
              The lifting properties hold by prop.
              %a.maruku-ref{:href => "#AcyclicFibrationsAreAcyclicFibrations"}
              below, the proof of which is in the section
              %em
                %a{:href => "#Lifting"} Lifting
              below.
            %p
              The factorization properties hold by cor.
              %a.maruku-ref{:href => "#FirstFactorizationEstablishes"}
              and cor.
              %a.maruku-ref{:href => "#FactorizationAcyclicCofibFib"}
              below, which are in the section
              %em
                %a{:href => "#Factorization"} Factorization
              below.
            %p
              The existence of a set of generating cofibrations is prop.
              %a.maruku-ref{:href => "#CellularStructuresExist"}
              below, that of generating acyclic cofibrations is prop.
              %a.maruku-ref{:href => "#GeneratingAcyclicCofibrationsExist"}
              below.
          #HomotopyCatIsFullSubcatgOfJHo.num_prop
            %h6#proposition_5 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi W
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (PSh(A), W)
              is (up to
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Ho
                        %mi J
                    %annotation{:encoding => "application/x-tex"} Ho_J
              = succeed "," do
                %a.maruku-ref{:href => "#JHomotopyCategory"}
          %p
            (
            %a{:href => "#Cisinski06"}> Cisinski 06, 1.3.23
            ).
          %p Before coming to the proof of these lemmas, the following two statements say that the terminology introduced so far is indeed consistent with the meaning of this theorem.
          #AcyclicFibrationsAreAcyclicFibrations.num_prop
            %h6#proposition_6 Proposition
            %p
              The morphisms called
              %em acyclic fibrations
              in def.
              %a.maruku-ref{:href => "#AcyclicFibration"}
              are indeed precisely the acyclic fibrations with respect to the model structure of theorem
              = succeed "." do
                %a.maruku-ref{:href => "#ModelStructureFromHomotopicalStructure"}
          %p
            (
            %a{:href => "#Cisinski06"}> Cisinski 06, theorem 1.3.27
            ).
          #EveryAnodyneExtensionIsWeakEquivalence.num_prop
            %h6#proposition_7 Proposition
            %p
              Every anodyne extension, def.
              = succeed "," do
                %a.maruku-ref{:href => "#AnodyneExtensions"}
              = succeed "." do
                %a.maruku-ref{:href => "#ModelStructureFromHomotopicalStructure"}
          .num_remark
            %h6#remark_5 Remark
            %p
              What is not true in general is the converse of prop.
              = succeed "," do
                %a.maruku-ref{:href => "#EveryAnodyneExtensionIsWeakEquivalence"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Paul+Goerss"} Goerss
              %a.existingWikiWord{:href => "/nlab/show/Rick+Jardine"} Jardine
              = succeed ".)" do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Simplicial+homotopy+theory"} Simplicial homotopy theory
          %p
            (
            %a{:href => "#Cisinski06"}> Cisinski 06, remark 1.3.46
            ).
          #ConditionsForCompleteness.num_prop
            %h6#proposition_8 Proposition
            %p
              For the model structure from theorem
              = succeed "," do
                %a.maruku-ref{:href => "#ModelStructureFromHomotopicalStructure"}
            %ol
              %li
                %p every acyclic cofibration is an anodyne extension;
              %li
                %p every morphism with right lifting against anodyne extensions is a fibration;
              %li
                %p every weak equivalence with right lifting against anodyne extensions is an acyclic fibration;
              %li
                %p every morphism with right lifting against anodyne extensions factors as an anodyne extension followed by a fibration.
          %p
            (
            %a{:href => "#Cisinski06"}> Cisinski 06, prop. 1.3.47
            ).
          .num_defn
            %h6#definition_13 Definition
            %p
              A homotopical structure, def.
              = succeed "," do
                %a.maruku-ref{:href => "#HomotopicalStructure"}
              %strong complete
              if the model structure from theorem
              %a.maruku-ref{:href => "#ModelStructureFromHomotopicalStructure"}
              satisfies the equivalent conditions of prop.
              = succeed "." do
                %a.maruku-ref{:href => "#ConditionsForCompleteness"}
          %p
            (
            %a{:href => "#Cisinski06"}> Cisinski 06, def. 1.3.48
            ).
          %p
            We discuss the proof of prop.
            %a.maruku-ref{:href => "#ConditionsForCompleteness"}
            below in
            = succeed "." do
              %em
                %a{:href => "#Completeness"} Completeness
          %h3#proof_9 Proof
          %p
            We collect lemmas to prove theorem
            %a.maruku-ref{:href => "#ModelStructureFromHomotopicalStructure"}
            and related statements. A little bit of work is required for demonstrating the lifting axioms, which we do below in
            = succeed "." do
              %em
                %a{:href => "#Lifting"} Lifting
            = succeed "." do
              %em
                %a{:href => "#Factorization"} Factorization
            = succeed "." do
              %em
                %a{:href => "#Completeness"} Completeness
          #JHomotopyEquivsAreWeakEquivs.num_lemma
            %h6#lemma Lemma
            %p
              Every
              = succeed "-homotopy" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                    %annotation{:encoding => "application/x-tex"} J
              = succeed "," do
                %a.maruku-ref{:href => "#JHomotopyEquivalence"}
            %p
              The weak equivalences satisfy the
              = succeed "-property" do
                %a.existingWikiWord{:href => "/nlab/show/two-out-of-three"} two-out-of-three
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/retracts"} retracts
          %p
            (
            %a{:href => "#Cisinski06"}> Cisinski 06, remark 1.3.24
            ).
          .proof
            %h6#proof_10 Proof
            %p
              The first statement holds by definition of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Ho
                        %mi J
                    %annotation{:encoding => "application/x-tex"} Ho_J
            %p
              The second statement also follows directly from the definition. If for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mover
                      %mo →
                      %mi f
                    %mi B
                    %mover
                      %mo →
                      %mi g
                    %mi C
                  %annotation{:encoding => "application/x-tex"} A \stackrel{f}{\to} B \stackrel{g}{\to} C
              and fibrant
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              in the composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ho
                      %mi J
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %msup
                          %mi g
                          %mo *
                    %msub
                      %mi Ho
                      %mi J
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %msup
                          %mi f
                          %mo *
                    %msub
                      %mi Ho
                      %mi J
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Ho_J(C,X) \stackrel{g^*}{\to} Ho_J(B,X) \stackrel{f^*}{\to} Ho_J(A,X)
            %p two of three are isomorphisms, then so is the third.
          %h4#Lifting Lifting
          %p
            We discuss the lifting properties in the model structure of def.
            = succeed "." do
              %a.maruku-ref{:href => "#ModelStructureMorphismsFromHomotopicalStructure"}
          %p
            Since fibrations are defined to be the morphisms satisfying the
            %a.existingWikiWord{:href => "/nlab/show/right+lifting+property"} right lifting property
            against acyclic cofibration, we only need to show that the fibrations which are also weak equivalences have the right lifting property against the monomorphisms. For this it is sufficient to show prop.
            = succeed "." do
              %a.maruku-ref{:href => "#AcyclicFibrationsAreAcyclicFibrations"}
          #DualDeformationRetract.num_defn
            %h6#definition_14 Definition
            %p
              A
              %em
                %a.existingWikiWord{:href => "/nlab/show/deformation+retract"} deformation retract
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f : X \to Y
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PSh(A)
              is a
              %a.existingWikiWord{:href => "/nlab/show/retract"} retract
              with retraction
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo :
                      %mi Y
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} g : Y \to X
              %a.existingWikiWord{:href => "/nlab/show/section"} section
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              up to a
              = succeed "-homotopy" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                    %annotation{:encoding => "application/x-tex"} J
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                      %mo :
                      %msub
                        %mi id
                        %mi Y
                      %mo ⇒
                      %mi f
                      %mo ∘
                      %mi g
                    %annotation{:encoding => "application/x-tex"} h : id_Y \Rightarrow f \circ g
              %em strong
              if
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                      %mo ∘
                      %mo{:stretchy => "false"} (
                      %mi I
                      %mo ⊗
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi σ
                        %mi Y
                      %mo ∘
                      %mo{:stretchy => "false"} (
                      %mi I
                      %mo ⊗
                      %mi f
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} h \circ (I \otimes f) = \sigma_Y \circ (I \otimes f)
            %p
              A
              %em dual deformation restract
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f : X \to Y
              has a
              %a.existingWikiWord{:href => "/nlab/show/section"} section
              by a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %mi Y
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} g : Y \to X
              and is also a retract up to a
              = succeed "-homotopy" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                    %annotation{:encoding => "application/x-tex"} J
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo :
                      %msub
                        %mi id
                        %mi X
                      %mo ⇒
                      %mi g
                      %mo ∘
                      %mi f
                    %annotation{:encoding => "application/x-tex"} k : id_X \Rightarrow g \circ f
              %em strong
              if
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ∘
                      %mi k
                      %mo =
                      %mi f
                      %mo ∘
                      %msub
                        %mi σ
                        %mi X
                    %annotation{:encoding => "application/x-tex"} f \circ k = f \circ \sigma_X
          #SectionsOfAcyclicFibrationsAreDefRetracts.num_lemma
            %h6#lemma_2 Lemma
            %p
              Every acyclic fibration is a dual
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/strong+deformation+retract"} strong deformation retract
              = succeed "." do
                %a.maruku-ref{:href => "#DualDeformationRetract"}
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/section"} section
              of an acyclic fibration is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/strong+deformation+retract"} strong deformation retract
          %p
            (
            %a{:href => "#Cisinski06"}> Cisinski 06, prop. 1.3.26
            ).
          .proof
            %h6#proof_11 Proof
            %p
              The first statement is a direct consequence of prop
              = succeed "." do
                %a.maruku-ref{:href => "#SomePropertiesOfAcyclicFibrations"}
            %p
              For the second statement, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} p : X \to Y
              be an acyclic fibration, and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo :
                    %mi Y
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} s : Y \to X
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/section"} section
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi I
                            %mo ⊗
                            %mi Y
                            %mo{:stretchy => "false"} )
                            %mo ∪
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} (
                            %mo ∂
                            %mi I
                            %mo{:stretchy => "false"} )
                            %mo ⊗
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi s
                                %mo ∘
                                %msub
                                  %mi σ
                                  %mi Y
                                %mo ,
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi id
                                  %mi X
                                %mo ,
                                %mi s
                                %mo ∘
                                %mi p
                                %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msub
                              %mo ↗
                              %mi h
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi p
                        %mtr
                          %mtd
                            %mi I
                            %mo ⊗
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi p
                                %mo ∘
                                %msub
                                  %mi σ
                                  %mi X
                          %mtd
                            %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    (I \otimes Y) \cup ((\partial I) \otimes X)
                    \&amp;\stackrel{(s\circ \sigma_Y,(id_X, s \circ p))}{\to}&amp; X
                    \\\
                    \\downarrow &amp;\nearrow_{h}&amp; \downarrow^{\mathrlap{p}}
                    \\\
                    I \otimes X
                    \&amp;\stackrel{ p \circ \sigma_X}{\to}&amp; Y
                    }
                    \\,,
            %p
              where the lift
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
              exists by assumption on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                  %annotation{:encoding => "application/x-tex"} s
              is necessarily a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/section"} section
            %p The resulting component triangle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mo ∂
                            %mi I
                            %mo{:stretchy => "false"} )
                            %mo ⊗
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi id
                                  %mi X
                                %mo ,
                                %mi s
                                %mo ∘
                                %mi p
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msub
                              %mo ↗
                              %mi h
                          %mtd
                        %mtr
                          %mtd
                            %mi I
                            %mo ⊗
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    (\partial I) \otimes X
                    \&amp;\stackrel{(id_X, s \circ p)}{\to}&amp; X
                    \\\
                    \\downarrow &amp;\nearrow_{h}&amp;
                    \\\
                    I \otimes X
                    }
            %p
              exhibits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                  %annotation{:encoding => "application/x-tex"} s
              as a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/deformation+retract"} deformation retract
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi I
                            %mo ⊗
                            %mi Y
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi s
                                %mo ∘
                                %msub
                                  %mi σ
                                  %mi Y
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi I
                                  %mo ⊗
                                  %mi s
