                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              in the following means a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cylinder+object"} cylinder object
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
