          %p
            (
            %a{:href => "#Cisinski06"}> Cisinski 06, cor. 1.2.11
            ).
          .proof
            %h6#proof_14 Proof
            %p
              By the
              %a.existingWikiWord{:href => "/nlab/show/co-Yoneda+lemma"} co-Yoneda lemma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
