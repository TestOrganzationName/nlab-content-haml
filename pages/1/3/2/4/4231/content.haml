                    %mi g
                  %annotation{:encoding => "application/x-tex"} f \Rightarrow g
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              is a
              %a.existingWikiWord{:href => "/nlab/show/left+homotopy"} left homotopy
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              with respect to the chosen cylinder object
