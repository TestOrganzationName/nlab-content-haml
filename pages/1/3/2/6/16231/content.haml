          %title
          %p
            Sylvester James Gates Jr., known as Jim Gates, works on
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/supersymmetry"} supersymmetry
            %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/superstring+theory"} superstring theory
          %ul
            %li
              %p
                %a{:href => "https://umdphysics.umd.edu/people/faculty/current/item/167-gatess.html"} institute page
            %li
              %p
                %a{:href => "http://en.wikipedia.org/wiki/Sylvester_James_Gates"} Wikipedia entry
            %li
              %p
                %a{:href => "https://inspirehep.net/authors/1008785"} InSpire page
            %li
              %p
                %a{:href => "https://genealogy.math.ndsu.nodak.edu/id.php?id=40774"} MathGenealogy page
          %h2#selected_writings Selected writings
          %p
            Formulating
            %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
            in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/superspace"} superspace
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Warren+Siegel"}> Warren Siegel
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/S.+James+Gates+Jr."} S. James Gates Jr.
                = succeed "," do
                  %em Superfield supergravity
                %strong 147
                1–2 (1979) 77-104 &amp;lbrack;
                %a{:href => "https://doi.org/10.1016/0550-3213(79)90416-4"}> doi:10.1016/0550-3213(79)90416-4
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/S.+James+Gates+Jr."}> S. James Gates Jr.
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Kellogg+S.+Stelle"} Kellogg S. Stelle
                %a.existingWikiWord{:href => "/nlab/show/Peter+C.+West"} Peter C. West
                = succeed "," do
                  %em Algebraic origins of superspace constraints in supergravity
                %strong 169
                3–4 (1980) 347-364 &amp;lbrack;
                %a{:href => "https://doi.org/10.1016/0550-3213(80)90037-1"}> doi:10.1016/0550-3213(80)90037-1
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/S.+James+Gates+Jr."}> S. James Gates Jr.
                ,
                = succeed "," do
                  %em
                    On-shell and conformal
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi N
                          %mo =
                          %mn 4
                        %annotation{:encoding => "application/x-tex"} N=4
                    supergravity in superspace
                %strong 213
                3 (1983) 409-444 &amp;lbrack;
                %a{:href => "https://doi.org/10.1016/0550-3213(83)90229-8"}> doi:10.1016/0550-3213(83)90229-8
                \&amp;rbrack;
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/supersymmetry"} supersymmetry
            via
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/superspace"} superspace
          %ul
            %li#GatesGrisaruRocekSiegel83
              %a.existingWikiWord{:href => "/nlab/show/Jim+Gates"} Jim Gates
              Jr,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Marcus+Grisaru"} Marcus Grisaru
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Martin+Ro%C4%8Dek"} Martin Roček
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Warren+Siegel"} Warren Siegel
              = succeed "," do
                %em Superspace, or One thousand and one lessons in supersymmetry
              %strong 58
              (1983) 1-548 &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/hep-th/0108200"}> arXiv:hep-th/0108200
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://inspirehep.net/literature/195126"} inspire:195126
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/Green-Schwarz+anomaly+cancellation"} Green-Schwarz anomaly cancellation
            in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/heterotic+supergravity"} heterotic supergravity
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/S.+James+Gates+Jr."}> S. James Gates Jr.
              ,
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Hitoshi+Nishino"} Hitoshi Nishino
              = succeed "," do
                %em
                  New
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi D
                          %mo =
                          %mn 10
                        %annotation{:encoding => "application/x-tex"} D = 10
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒩
                        %mo =
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} \mathcal{N} = 1
                  supergravity coupled to Yang-Mills supermultiplet and anomaly cancellations
              %strong 157
              2–3 (1985) 157-163 [
              %a{:href => "https://doi.org/10.1016/0370-2693(85)91537-0"}> doi:10.1016/0370-2693(85)91537-0
              ,
              = succeed "]" do
                %a{:href => "https://inspirehep.net/literature/16413"} spire:16413
          %p
            Early consideration of the idea of
            %a.existingWikiWord{:href => "/nlab/show/superstring"} superstring
            %a.existingWikiWord{:href => "/nlab/show/sigma-models"} sigma-models
            where both the
            %a.existingWikiWord{:href => "/nlab/show/worldsheet"} worldsheet
            as well as the
            %a.existingWikiWord{:href => "/nlab/show/target+spacetime"} target spacetime
            are treated as
            %a.existingWikiWord{:href => "/nlab/show/supermanifolds"} supermanifolds
            is due (under the name “supersymmetry squared”, cf. the
            = succeed "):" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/superembedding+approach"} superembedding approach
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/S.+James+Gates+Jr."}> S. James Gates Jr.
                ,
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Hitoshi+Nishino"} Hitoshi Nishino
                = succeed "," do
                  %em
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi D
                          %mo =
                          %mn 2
                        %annotation{:encoding => "application/x-tex"} D = 2
                    superfield supergravity, local
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi supersymmetry
                          %msup
                            %mo{:stretchy => "false"} )
                            %mn 2
                        %annotation{:encoding => "application/x-tex"} (supersymmetry)^2
                    and non-linear 2 models
                %strong 3
                3 (1986) 391-399 [
                %a{:href => "https://doi.org/10.1088/0264-9381/3/3/013"}> doi:10.1088/0264-9381/3/3/013
                ,
                = succeed "]" do
                  %a{:href => "https://inspirehep.net/literature/217518"} spire:217518
            %li
              %p
                R. Brooks, F. Muhammad,
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/S.+James+Gates+Jr."} S. James Gates Jr.
                = succeed "," do
                  %em
                    Matter Coupled to
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi D
                          %mo =
                          %mn 2
                        %annotation{:encoding => "application/x-tex"} D=2
                    Simple Unidexterous Supergravity, Local
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi Supersymmetry
                          %msup
                            %mo{:stretchy => "false"} )
                            %mn 2
                        %annotation{:encoding => "application/x-tex"} (Supersymmetry)^2
                    and Strings
                %strong 3
                5 (1986) 745-751 [
                %a{:href => "https://doi.org/10.1088/0264-9381/3/5/005"}> doi:10.1088/0264-9381/3/5/005
                ,
                = succeed "]" do
                  %a{:href => "https://inspirehep.net/literature/237390"} spire:237390
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/type+IIA+supergravity"} type IIA supergravity
            formulated in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/superspace"} superspace
          %ul
            %li
              James L. Carr,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/S.+James+Gates+Jr."} S. James Gates Jr.
              = succeed "," do
                %em
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi D
                        %mo =
                        %mn 10
                      %annotation{:encoding => "application/x-tex"} D = 10
                  ,
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                        %mo =
                        %mn 2
                        %mi a
                      %annotation{:encoding => "application/x-tex"} N = 2a
