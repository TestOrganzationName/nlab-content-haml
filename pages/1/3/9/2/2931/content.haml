            %h6#corollary Corollary
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi K
                      %mo ̲
                  %annotation{:encoding => "application/x-tex"} \underline{K}
              is a relation equipment satisfying the hypotheses of the theorem, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℋ
                    %mo{:stretchy => "false"} (
                    %munder
