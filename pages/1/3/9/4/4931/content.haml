                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbb{B}^n
                  \\coloneqq
                  \\Big\{
                  \\vec x \in \mathbb{R}^n
                  \\;\Big\vert\;
                  \\textstyle{\sum_{i}}
                  (x^i)^2 \lt 1
                  \\Big\}
                  \\;\subset\;
                  \\mathbb{R}^n
                  \\,.
          %p
            Its
            %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
            is the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n-1)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/sphere"} sphere
          %p
            More generally, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,d)
            a
            %a.existingWikiWord{:href => "/nlab/show/metric+space"} metric space
            then an open ball in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a subset of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi r
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mo{:stretchy => "false"} {
                  %mi y
                  %mo ∈
                  %mi X
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} |
                  %mspace{:width => "thickmathspace"}
                  %mi d
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo &lt;
                  %mi r
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"}
                  B(x,r) \coloneqq \{y \in X \;|\; d(x,y) \lt r \}
          %p
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi X
                %annotation{:encoding => "application/x-tex"} x \in X
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo ∈
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn ∞
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} r \in (0,\infty) \subset \mathbb{R}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            form the
            %a.existingWikiWord{:href => "/nlab/show/basis+of+a+topology"} basis
            of the
            %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
            on
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %h3#combinatorial Combinatorial
          %p
            There are also combinatorial notions of
            = succeed "." do
              %em disks
            = succeed ")," do
              %a{:href => "#Joyal"} Joyal
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Theta-category"} Theta-category
            = succeed ")." do
              %a{:href => "#MakkaiZawadowski"} Makkai-Zawadowski
          %h2#Properties Properties
          %h3#closed_balls Closed balls
          %p
            A simple result on the
            %em homeomorphism
            type of
            %em closed
            balls is the following:
          .num_theorem
            %h6#theorem Theorem
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/compact+space"} compact
              %a.existingWikiWord{:href => "/nlab/show/convex+subset"} convex
              %a.existingWikiWord{:href => "/nlab/show/subset"} subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              with
              %a.existingWikiWord{:href => "/nlab/show/nonempty+set"} nonempty
              %a.existingWikiWord{:href => "/nlab/show/interior"} interior
              is
              %a.existingWikiWord{:href => "/nlab/show/homeomorphic"} homeomorphic
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi D
                        %mi n
                    %annotation{:encoding => "application/x-tex"} D^n
          .proof
            %h6#proof Proof
            %p
              Without loss of generality we may suppose the origin is an interior point of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo :
                    %mi v
                    %mo ↦
                    %mi v
                    %mo{:stretchy => "false"} /
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mi v
                      %mo{:stretchy => "false"} ‖
                  %annotation{:encoding => "application/x-tex"} \phi: v \mapsto v/{\|v\|}
              maps the boundary
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                    %mi D
                  %annotation{:encoding => "application/x-tex"} \partial D
              homeomorphically onto
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} S^{n-1}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              is homeomorphic to the cone on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∂
                      %mi D
                    %annotation{:encoding => "application/x-tex"} \partial D
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} S^{n-1}
              which is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi D
                        %mi n
                    %annotation{:encoding => "application/x-tex"} D^n
            %p The claim reduces to the following three steps.
            %ol
              %li
                %p
                  The restricted map
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                        %mo :
                        %mo ∂
                        %mi D
                        %mo →
                        %msup
                          %mi S
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} \phi: \partial D \to S^{n-1}
                  is continuous.
              %li
                %p
                  It’s surjective:
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                      %annotation{:encoding => "application/x-tex"} D
                  contains a ball
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                        %mo =
                        %msub
                          %mi B
                          %mi ε
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} B = B_{\varepsilon}(0)
                  in its interior, and for each
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi x
                          %mo ∈
                          %mi B
                        %annotation{:encoding => "application/x-tex"} x \in B
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x
                  intersects
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                      %annotation{:encoding => "application/x-tex"} D
                  in a bounded half-open line segment. For the extreme point
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi v
                      %annotation{:encoding => "application/x-tex"} v
                  on this line segment,
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ϕ
                          %mo{:stretchy => "false"} (
                          %mi v
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi ϕ
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \phi(v) = \phi(x)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi u
                        %mo ∈
                        %msup
                          %mi S
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} u \in S^{n-1}
                  is of the form
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                        %mo{:stretchy => "false"} (
                        %mi v
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \phi(v)
                  for some extreme point
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi v
                          %mo ∈
                          %mi D
                        %annotation{:encoding => "application/x-tex"} v \in D
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo ∂
                          %mi D
                        %annotation{:encoding => "application/x-tex"} \partial D
              %li
                %p
                  It’s injective: for this we need to show that if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi v
                        %mo ,
                        %mi w
                        %mo ∈
                        %mo ∂
                        %mi D
                      %annotation{:encoding => "application/x-tex"} v, w \in \partial D
                  are distinct points, then neither is a positive multiple of the other. Supposing otherwise, we have
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi w
                        %mo =
                        %mi t
                        %mi v
                      %annotation{:encoding => "application/x-tex"} w = t v
                  for
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi t
                          %mo &gt;
                          %mn 1
                        %annotation{:encoding => "application/x-tex"} t \gt 1
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                      %annotation{:encoding => "application/x-tex"} B
                  be a ball inside
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                      %annotation{:encoding => "application/x-tex"} D
                  containing
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} 0
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mi w
                        %mo{:stretchy => "false"} }
                        %mo ∪
                        %mi B
                      %annotation{:encoding => "application/x-tex"} \{w\} \cup B
                  is contained in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                      %annotation{:encoding => "application/x-tex"} D
                  and contains
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi v
                      %annotation{:encoding => "application/x-tex"} v
                  as an interior point, contradiction.
            %p
              So the unit vector map, being a continuous bijection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                    %mi D
                    %mo →
                    %msup
                      %mi S
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \partial D \to S^{n-1}
              between
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+space"} compact Hausdorff space
          .num_cor
            %h6#corollary Corollary
            %p
              Any compact convex set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              is homeomorphic to a disk.
          .proof
            %h6#proof_2 Proof
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              has nonempty interior relative to its affine span which is some
              = succeed "-plane," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              is homeomorphic to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mi k
                  %annotation{:encoding => "application/x-tex"} D^k
              by the theorem.
          %h3#open_balls Open Balls
          %p
            Open balls are a little less rigid than closed balls, in that one can more easily manipulate them within the
            %em smooth
            category:
          .num_lemma
            %h6#observation Observation
            %p
              The open
              = succeed "-ball" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/homeomorphic"} homeomorphic
              and even
              %a.existingWikiWord{:href => "/nlab/show/diffeomorphic"} diffeomorphic
              to the
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔹
                      %mi n
                    %mo ≃
                    %msup
                      %mi ℝ
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{B}^n \simeq \mathbb{R}^n
                    \\,.
          .proof
            %h6#proof_3 Proof
            %p For instance, the smooth map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ↦
                    %mfrac
                      %mi x
                      %msqrt
                        %mrow
                          %mn 1
                          %mo +
                          %mo{:stretchy => "false"} |
                          %mi x
                          %msup
                            %mo{:stretchy => "false"} |
                            %mn 2
                    %mo :
                    %msup
                      %mi ℝ
                      %mi n
                    %mo →
                    %msup
                      %mi 𝔹
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    x\mapsto \frac{x}{\sqrt{1+|x|^2}} : \mathbb{R}^n \to \mathbb{B}^n
            %p has smooth inverse
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ↦
                    %mfrac
                      %mi y
                      %msqrt
                        %mrow
                          %mn 1
                          %mo −
                          %mo{:stretchy => "false"} |
                          %mi y
                          %msup
                            %mo{:stretchy => "false"} |
                            %mn 2
                    %mo :
                    %msup
                      %mi 𝔹
                      %mi n
                    %mo →
                    %msup
                      %mi ℝ
                      %mi n
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    y\mapsto \frac{y}{\sqrt{1-|y|^2}} : \mathbb{B}^n \to \mathbb{R}^n.
          %p
            This probe from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"} {\mathbb{R}}^n
            witnesses the property that the open
            = succeed "-ball" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"} {\mathbb{R}}^n
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔹
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{B}^n
          %p
            From general existence results about
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/smooth+structure"} smooth structure
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
          .num_theorem
            %h6#theorem_2 Theorem
            %p
              In
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} d \in \mathbb{N}
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo ≠
                    %mn 4
                  %annotation{:encoding => "application/x-tex"} d \neq 4
              we have:
            %p
              every open subset of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi d
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^d
              which is
              %a.existingWikiWord{:href => "/nlab/show/homeomorphic"} homeomorphic
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔹
                      %mi d
                  %annotation{:encoding => "application/x-tex"} \mathbb{B}^d
              is also
              %a.existingWikiWord{:href => "/nlab/show/diffeomorphic"} diffeomorphic
              to it.
          %p
            See the first page of (
            %a{:href => "#Ozols"}> Ozols
            ) for a list of references.
          .num_remark
            %h6#remark Remark
            %p
              In dimension 4 the analog statement fails due to the existence of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/exotic+smooth+structure"} exotic smooth structure
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mn 4
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^4
              = succeed "." do
                %a{:href => "#DeMFreed"} De Michelis-Freedman
          #StarShapedOpenDiffeomorphicToOpenBall.num_theorem
            %h6#theorem_3 Theorem
            %p
              %strong (star-shaped domains are diffeomorphic to open balls)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ⊂
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} C \subset \mathbb{R}^n
              be a
              %a.existingWikiWord{:href => "/nlab/show/star-shaped"} star-shaped
              %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
              of a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is
              %a.existingWikiWord{:href => "/nlab/show/diffeomorphic"} diffeomorphic
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
          #LiteratureOnStarShapedOpenDiffeoToOpenBall.num_remark
            %h6#remark_2 Remark
            %p
              Theorem
              %a.maruku-ref{:href => "#StarShapedOpenDiffeomorphicToOpenBall"}
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/folk+theorem"} folk theorem
              %strong proofs
              in the literature are hard to find. See the discussion in the References-section
              = succeed "." do
                %em
                  %a{:href => "#ReferencesStarShapedReasonDiffeomorphicToOpenBall"} here
              %a{:href => "http://www.math.tu-berlin.de/~ferus/ANA/Ana3.pdf#page=154"} theorem 237
              in
              = succeed "." do
                %a{:href => "#Ferus07"} Ferus 2007
              = succeed "," do
                %a{:href => "#GonnordTosel98"} Gonnord &amp; Tosel 1998
              = succeed "." do
                %a{:href => "http://mathoverflow.net/a/212595/381"} here
          %p Here is another proof:
          .proof
            %h6#proof_4 Proof
            %p
              Suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              is a star-shaped open subset of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} {\mathbb {R}}^n
              centered at the origin. Theorem 2.29 in
              %a{:href => "#Lee09"} Lee 2009
              proves that there is a function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} {\mathbb{R}}^n
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} f\gt 0
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              vanishes on the complement of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              %a.existingWikiWord{:href => "/nlab/show/bump+functions"} bump functions
              we can assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ≤
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} f\le 1
              everywhere and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} f=1
              in an open
              = succeed "-neighborhood" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                    %annotation{:encoding => "application/x-tex"} \epsilon
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                      %mo =
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} \epsilon=2
            %p
              The smooth vector field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo{:lspace => "verythinmathspace"} :
                    %mi x
                    %mo ↦
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mi x
                    %mo{:stretchy => "false"} /
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mi x
                      %mo{:stretchy => "false"} ‖
                  %annotation{:encoding => "application/x-tex"} V\colon x\mapsto f(x)\cdot x/{\|x\|}
              is defined on the complement of the origin in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              by a smooth bump function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo ≤
                    %mi b
                    %mo ≤
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 0\le b\le 1
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} b=1
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mi x
                      %mo{:stretchy => "false"} ‖
                    %mo &gt;
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} {\|x\|} \gt 1/2
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} b=0
              in a neighborhood of 0. The new vector field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              extends smoothly to the origin and defines a smooth global flow
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:lspace => "verythinmathspace"} :
                      %mi ℝ
                      %mo ×
                      %mi T
                      %mo →
                      %mi T
                    %annotation{:encoding => "application/x-tex"} F\colon \mathbb{R} \times T\to T
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              and not just some interval
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn ∞
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (-\infty,A)
              because the norm of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              is bounded by 1.) Observe that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mo &lt;
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mi x
                      %mo{:stretchy => "false"} ‖
                    %mo &lt;
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 1/2\lt {\|x\|} \lt 2
              the vector field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              equals
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ↦
                      %mi x
                      %mo{:stretchy => "false"} /
                      %mrow
                        %mo{:stretchy => "false"} ‖
                        %mi x
                        %mo{:stretchy => "false"} ‖
                    %annotation{:encoding => "application/x-tex"} x\mapsto x/{\|x\|}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              are radial rays.
            %p
              Now define the flow map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %msubsup
                      %mi ℝ
                      %mrow
                        %mo &gt;
                        %mn 1
                        %mo{:stretchy => "false"} /
                        %mn 2
                      %mi n
                    %mo →
                    %msub
                      %mi T
                      %mrow
                        %mo &gt;
                        %mn 1
                        %mo{:stretchy => "false"} /
                        %mn 2
                  %annotation{:encoding => "application/x-tex"} p\colon{\mathbb{R}}^n_{\gt 1/2}\to T_{\gt 1/2}
              as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ↦
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mi x
                      %mo{:stretchy => "false"} ‖
                    %mo −
                    %mn 1
                    %mo ,
                    %mfrac
                      %mi x
                      %mrow
                        %mo{:stretchy => "false"} ‖
                        %mi x
                        %mo{:stretchy => "false"} ‖
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x\mapsto F({\|x\|}-1, \frac{x}{{\|x\|}})
              for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} ‖
                        %mi x
                        %mo{:stretchy => "false"} ‖
                      %mo &gt;
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} {\|x\|} \gt 1/2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo &gt;
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} \gt 1/2
              removes the closed ball of radius
              = succeed ".)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} 1/2
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi ℝ
                      %mrow
                        %mo &gt;
                        %mn 1
                        %mo{:stretchy => "false"} /
                        %mn 2
                      %mi n
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mo ,
                    %mn ∞
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %msup
                      %mi S
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo →
                    %msub
                      %mi T
                      %mrow
                        %mo &gt;
                        %mn 1
                        %mo{:stretchy => "false"} /
                        %mn 2
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} {\mathbb{R}}^n_{\gt 1/2}\to(-1/2,\infty)\times S^{n-1} \to T_{\gt 1/2},
            %p
              hence itself is a diffeomorphism. (Note particularly that the latter map is surjective. In detail: a flow line is a smooth map of the form
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mo :
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mi B
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi T
                    %annotation{:encoding => "application/x-tex"} L: (A,B) \to T
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              can be finite or infinite. If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              is finite and the limit of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} L(t)
              as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} t \to B
              exists, then the vector field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              vanishes at
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              can only vanish at the boundary of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
            %p
              Finally, define the desired diffeomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi ℝ
                      %mi n
                    %mo →
                    %mi T
                  %annotation{:encoding => "application/x-tex"} d\colon{\mathbb{R}}^n\to T
              as the gluing of the identity map for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mi x
                      %mo{:stretchy => "false"} ‖
                    %mo &lt;
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} {\|x\|} \lt 2
              and as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} ‖
                        %mi x
                        %mo{:stretchy => "false"} ‖
                      %mo &gt;
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} {\|x\|}\gt 1/2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              is smooth because for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mo &lt;
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mi x
                      %mo{:stretchy => "false"} ‖
                    %mo &lt;
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 1/2\lt {\|x\|} \lt 2
              both definitions give the same value.
          %p And here is another proof, due to Gonnord and Tosel, translated into English by Erwann Aubry and available on MathOverflow:
          %p
          .num_theorem
            %h6 Theorem
            %p
              Every open star-shaped set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                  %annotation{:encoding => "application/x-tex"} \Omega
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              is
              = succeed "-diffeomorphic" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} C^\infty
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
          %p
          .proof
            %h6 Proof
            %p
              For convenience assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                  %annotation{:encoding => "application/x-tex"} \Omega
              is star-shaped at
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} 0
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo =
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi R
                      %mi n
                    %mo ∖
                    %mi Ω
                  %annotation{:encoding => "application/x-tex"} F=\mathbf{R}^n\setminus\Omega
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo :
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi R
                      %mi n
                    %mo →
                    %msub
                      %mi ℝ
                      %mo +
                  %annotation{:encoding => "application/x-tex"} \phi:\mathbf{R}^n\rightarrow\mathbb{R}_+
              (here
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi R
                        %mo +
                      %mo =
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn ∞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{R}_+=[0,\infty)
              = succeed "-function" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} C^\infty
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo =
                      %msup
                        %mi ϕ
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F=\phi^{-1}(\{0\})
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              exists by the
              = succeed ".)" do
                %a.existingWikiWord{:href => "/nlab/show/Whitney+extension+theorem"} Whitney extension theorem
            %p
              Now we define
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi Ω
                    %mo →
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} f:\Omega\rightarrow\mathbb{R}^n
              via the formula:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mover
                        %mrow
                          %mo [
                          %mn 1
                          %mo +
                          %msup
                            %mrow
                              %mo (
                              %msubsup
                                %mo ∫
                                %mn 0
                                %mn 1
                              %mfrac
                                %mi dv
                                %mrow
                                  %mi ϕ
                                  %mo{:stretchy => "false"} (
                                  %mi vx
                                  %mo{:stretchy => "false"} )
                              %mo )
                            %mn 2
                          %mo{:stretchy => "false"} ‖
                          %mi x
                          %msup
                            %mo{:stretchy => "false"} ‖
                            %mn 2
                          %mo ]
                        %mo ⏞
                      %mrow
                        %mi λ
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mi x
                    %mo =
                    %mrow
                      %mo [
                      %mn 1
                      %mo +
                      %msup
                        %mrow
                          %mo (
                          %msubsup
                            %mo ∫
                            %mn 0
                            %mrow
                              %mo{:stretchy => "false"} ‖
                              %mi x
                              %mo{:stretchy => "false"} ‖
                          %mfrac
                            %mi dt
                            %mrow
                              %mi ϕ
                              %mo{:stretchy => "false"} (
                              %mi t
                              %mfrac
                                %mi x
                                %mrow
                                  %mo{:stretchy => "false"} ‖
                                  %mi x
                                  %mo{:stretchy => "false"} ‖
                              %mo{:stretchy => "false"} )
                          %mo )
                        %mn 2
                      %mo ]
                    %mo ⋅
                    %mi x
                    %mo .
                  %annotation{:encoding => "application/x-tex"} f(x)=\overbrace{\left[1+\left(\int_0^1\frac{dv}{\phi(vx)}\right)^2\|x\|^2\right]}^{\lambda(x)}\cdot x=\left[1+\left(\int_0^{\|x\|}\frac{dt}{\phi(t\frac{x}{\|x\|})}\right)^2\right]\cdot x.
            %p
              Clearly
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is smooth on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ω
                    %annotation{:encoding => "application/x-tex"} \Omega
            %p
              We set
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi sup
                      %mo{:stretchy => "false"} {
                      %mi t
                      %mo &gt;
                      %mn 0
                      %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                      %mi t
                      %mfrac
                        %mi x
                        %mrow
                          %mo{:stretchy => "false"} ‖
                          %mi x
                          %mo{:stretchy => "false"} ‖
                      %mo ∈
                      %mi Ω
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} A(x)=\sup\{t\gt0\mid t\frac{x}{\|x\|}\in\Omega\}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              sends injectively the segment (or ray)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mfrac
                      %mi x
                      %mrow
                        %mo{:stretchy => "false"} ‖
                        %mi x
                        %mo{:stretchy => "false"} ‖
                  %annotation{:encoding => "application/x-tex"} [0,A(x))\frac{x}{\|x\|}
              to the ray
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi R
                        %mo +
                      %mfrac
                        %mi x
                        %mrow
                          %mo{:stretchy => "false"} ‖
                          %mi x
                          %mo{:stretchy => "false"} ‖
                    %annotation{:encoding => "application/x-tex"} \mathbf{R}_+\frac{x}{\|x\|}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mfrac
                      %mi x
                      %mrow
                        %mo{:stretchy => "false"} ‖
                        %mi X
                        %mo{:stretchy => "false"} ‖
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} f(0\frac{x}{\|X\|})=0
              and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi lim
                      %mrow
                        %mi r
                        %mo →
                        %mi A
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                    %mrow
                      %mo ‖
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi r
                      %mfrac
                        %mi x
                        %mrow
                          %mo{:stretchy => "false"} ‖
                          %mi x
                          %mo{:stretchy => "false"} ‖
                      %mo{:stretchy => "false"} )
                      %mo ‖
                    %mo =
                    %munder
                      %mi lim
                      %mrow
                        %mi r
                        %mo →
                        %mi A
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                    %mrow
                      %mo [
                      %mn 1
                      %mo +
                      %msup
                        %mrow
                          %mo (
                          %msubsup
                            %mo ∫
                            %mn 0
                            %mi r
                          %mfrac
                            %mi dt
                            %mrow
                              %mi ϕ
                              %mrow
                                %mo (
                                %mi t
                                %mo ⋅
                                %mfrac
                                  %mi rx
                                  %mrow
                                    %mo{:stretchy => "false"} ‖
                                    %mi x
                                    %mo{:stretchy => "false"} ‖
                                %mo ⋅
                                %mrow
                                  %mo ‖
                                  %mfrac
                                    %mrow
                                      %mo{:stretchy => "false"} ‖
                                      %mi x
                                      %mo{:stretchy => "false"} ‖
                                    %mi rx
                                  %mo ‖
                                %mo )
                          %mo )
                        %mn 2
                      %mo ]
                    %mo ⋅
                    %mi r
                    %mo =
                    %mrow
                      %mo [
                      %mn 1
                      %mo +
                      %msup
                        %mrow
                          %mo (
                          %msubsup
                            %mo ∫
                            %mn 0
                            %mrow
                              %mi A
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                          %mfrac
                            %mi dt
                            %mrow
                              %mi ϕ
                              %mo{:stretchy => "false"} (
                              %mi t
                              %mfrac
                                %mi x
                                %mrow
                                  %mo{:stretchy => "false"} ‖
                                  %mi x
                                  %mo{:stretchy => "false"} ‖
                              %mo{:stretchy => "false"} )
                          %mo )
                        %mn 2
                      %mo ]
                    %mo ⋅
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mn ∞
                    %mo .
                  %annotation{:encoding => "application/x-tex"} \lim_{r\rightarrow A(x)}\left\|f(r\frac{x}{\|x\|})\right\|=\lim_{r\to A(x)}\left[1+\left(\int_0^{r}\frac{dt}{\phi\left(t\cdot\frac{rx}{\|x\|}\cdot\left\|\frac{\|x\|}{rx}\right\|\right)}\right)^2\right]\cdot r= \left[1+\left(\int_0^{A(x)}\frac{dt}{\phi(t\frac{x}{\|x\|})}\right)^2\right]\cdot A(x)=+\infty.
            %p
              Indeed, if
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} A(x)=+\infty
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo &lt;
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} A(x)\lt+\infty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A(x)
              we get that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mfrac
                        %mi x
                        %mrow
                          %mo{:stretchy => "false"} ‖
                          %mi x
                          %mo{:stretchy => "false"} ‖
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \phi(A(x)\frac{x}{\|x\|})=0
              %a.existingWikiWord{:href => "/nlab/show/mean+value+theorem"} mean value theorem
              and the fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} C^1
              due to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mrow
                      %mo (
                      %mi r
                      %mfrac
                        %mi x
                        %mrow
                          %mo{:stretchy => "false"} ‖
                          %mi x
                          %mo{:stretchy => "false"} ‖
                      %mo )
                    %mo ≤
                    %mi M
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mi r
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \phi\left(r\frac{x}{\|x\|}\right)\le M(A(x)-r)
            %p
              for some constant
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              and every
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                    %annotation{:encoding => "application/x-tex"} r
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mo ∫
                      %mn 0
                      %mrow
                        %mi A
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                    %mfrac
                      %mi dt
                      %mrow
                        %mi ϕ
                        %mrow
                          %mo (
                          %mi t
                          %mfrac
                            %mi x
                            %mrow
                              %mo{:stretchy => "false"} ‖
                              %mi x
                              %mo{:stretchy => "false"} ‖
                          %mo )
                  %annotation{:encoding => "application/x-tex"} \int_0^{A(x)}\frac{dt}{\phi\left(t\frac{x}{\|x\|}\right)}
            %p
              diverges. Hence we infer that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mfrac
                      %mi x
                      %mrow
                        %mo{:stretchy => "false"} ‖
                        %mi x
                        %mo{:stretchy => "false"} ‖
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi R
                      %mo +
                    %mfrac
                      %mi x
                      %mrow
                        %mo{:stretchy => "false"} ‖
                        %mi x
                        %mo{:stretchy => "false"} ‖
                  %annotation{:encoding => "application/x-tex"} f([0,A(x))\frac{x}{\|x\|})=\mathbf{R}_+\frac{x}{\|x\|}
              and so
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi Ω
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi R
                        %mi n
                    %annotation{:encoding => "application/x-tex"} f(\Omega)=\mathbf{R}^n
            %p
              To end the proof we need to show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              has a
              = succeed "-inverse." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} C^\infty
              %a.existingWikiWord{:href => "/nlab/show/inverse+function+theorem"} inverse function theorem
              we get that it is sufficient to show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi df
                  %annotation{:encoding => "application/x-tex"} df
              vanishes nowhere.
            %p
              Suppose that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi x
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi h
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} d_x f(h)=0
              for some
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi Ω
                  %annotation{:encoding => "application/x-tex"} x\in\Omega
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                      %mo ≠
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} h\neq 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              we get that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi x
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi h
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi λ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mi h
                    %mo +
                    %msub
                      %mi d
                      %mi x
                    %mi λ
                    %mo{:stretchy => "false"} (
                    %mi h
                    %mo{:stretchy => "false"} )
                    %mi x
                    %mo .
                  %annotation{:encoding => "application/x-tex"} d_x f(h)=\lambda(x)h+d_x \lambda(h)x.
            %p
              Hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo =
                    %mi μ
                    %mi x
                  %annotation{:encoding => "application/x-tex"} h=\mu x
              for some
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo ≠
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \mu\neq 0
              and from that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ≠
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} x\neq 0
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo +
                      %msub
                        %mi d
                        %mi x
                      %mi λ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \lambda(x)+d_x \lambda(x)=0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≥
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \lambda(x)\ge1
              and function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %mi λ
                    %mo{:stretchy => "false"} (
                    %mi tx
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} g(t):=\lambda(tx)
              is increasing, so
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi d
                        %mi x
                      %mi λ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo &gt;
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} g'(1)=d_x \lambda(x)\gt0
          .num_example
            %h6#example Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} I(\Delta^n) \subset \mathbb{R}^n
              be the
              %a.existingWikiWord{:href => "/nlab/show/interior"} interior
              of the standard
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/simplex"} simplex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔹
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{B}^n
              defined as follows:
            %p
              Parameterize the
              = succeed "-simplex" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mrow
                      %mo {
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi x
                        %mn 1
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %msup
                        %mi x
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi ℝ
                      %mo{:stretchy => "false"} |
                      %mo{:stretchy => "false"} (
                      %mo ∀
                      %mi i
                      %mo :
                      %msup
                        %mi x
                        %mi i
                      %mo &gt;
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mi and
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} (
                      %munderover
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi i
                          %mo =
                          %mn 1
                        %mi n
                      %msup
                        %mi x
                        %mi i
                      %mo &lt;
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    I(\Delta^n)
                    \=
                    \\left\{
                    (x^1, \cdots, x^n) \in \mathbb{R}
                    |
                    (\forall i : x^i \gt 0)\; and \; ( \sum_{i=1}^n x^i \lt 1)
                    \\right\}
                    \\,.
            %p
              Then define the map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi I
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} f : I(\Delta^n) \to \mathbb{R}^n
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi x
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msup
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %mi log
                    %mo{:stretchy => "false"} (
                    %mfrac
                      %mrow
                        %msup
                          %mi x
                          %mn 1
                      %mrow
                        %mn 1
                        %mo −
                        %msup
                          %mi x
                          %mn 1
                        %mo −
                        %mi …
                        %mo −
                        %msup
                          %mi x
                          %mi n
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi …
                    %mo ,
                    %mi log
                    %mo{:stretchy => "false"} (
                    %mfrac
                      %mrow
                        %msup
                          %mi x
                          %mi n
                      %mrow
                        %mn 1
                        %mo −
                        %msup
                          %mi x
                          %mn 1
                        %mo −
                        %mi …
                        %mo −
                        %msup
                          %mi x
                          %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (x^1, \ldots, x^n)
                    \\mapsto
                    (\log(\frac{x^1}{1 - x^1 - \ldots -x^n}),
                    \\ldots,
                    \\log(\frac{x^n}{1 - x^1 - \ldots - x^n}))
                    \\,.
          %p
            (Thanks to
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/Todd+Trimble"} Todd Trimble
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Δ
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} I(\Delta^n)
            is the positive orthant of an open
            = succeed "-ball" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi l
                    %mn 1
                %annotation{:encoding => "application/x-tex"} l^1
            norm, so that in the opposite direction we have a chain of invertible maps
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msup
                            %mi ℝ
                            %mi n
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msup
                                %mi exp
                                %mi n
                        %mtd
                          %msubsup
                            %mi ℝ
                            %mo +
                            %mi n
                        %mtd
                          %mo →
                        %mtd
                          %mi I
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi Δ
                            %mi n
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mover
                            %mi x
                            %mo{:stretchy => "false"} →
                        %mtd
                          %mo ↦
                        %mtd
                          %mover
                            %mi x
                            %mo{:stretchy => "false"} →
                          %mo{:stretchy => "false"} /
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo +
                          %msub
                            %mrow
                              %mo{:stretchy => "false"} ‖
                              %mover
                                %mi x
                                %mo{:stretchy => "false"} →
                              %mo{:stretchy => "false"} ‖
                            %mn 1
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\mathbb{R}^n &amp; \stackrel{\exp^n}{\to} &amp; \mathbb{R}_+^n &amp; \to &amp; I(\Delta^n) \\
                  \&amp; &amp; \vec{x} &amp; \mapsto &amp; \vec{x}/(1 + {\|\vec{x}\|}_1)
                  }
          %p
            which we simply invert to get the map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            above.
          %h3#good_covers_by_balls Good covers by balls
          %p
            One central application of balls is as building blocks for
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/covering"} covering
            %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
            for some statements.
          %h2#related_concepts Related concepts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/unit+ball"} unit ball
          %h2#References References
          %h3#geometric_2 Geometric
          %ul
            %li#Ozols
              V. Ozols,
              %em Largest normal neighbourhoods
              , Proceedings of the American Mathematical Society Vol. 61, No. 1 (Nov., 1976), pp. 99-101 (
              %a{:href => "http://www.jstor.org/stable/2041672"}> jstor
              )
          %p
            That an open subset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ⊆
                  %msup
                    %mi ℝ
                    %mn 4
                %annotation{:encoding => "application/x-tex"} U \subseteq \mathbb{R}^4
            homeomorphic to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mn 4
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^4
            equipped with the smooth structure inherited as an open submanifold of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mn 4
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^4
            might nevertheless be non-diffeomorphic to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mn 4
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^4
          %ul#DeMFreed
            %li
              De Michelis, Stefano; Freedman, Michael H. (1992) “Uncountably many exotic
              = succeed "\u2018s" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mn 4
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^4
          %h3#ReferencesStarShapedReasonDiffeomorphicToOpenBall Star-shaped regions diffeomorphic to open ball
          %p The proof that open star-shaped regions are diffeomorphic to a ball appears as
          %ul
            %li#Ferus07
              %a.existingWikiWord{:href => "/nlab/show/Dirk+Ferus"}> Dirk Ferus
              ,
              %a{:href => "http://www.math.tu-berlin.de/~ferus/ANA/Ana3.pdf#page=154"} theorem 237
              in:
              %em Analysis III
              (2007) (
              %a{:href => "http://www.math.tu-berlin.de/~ferus/ANA/Ana3.pdf"}> pdf
              ,
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/files/Ferus_AnalysisIII.pdf", :title => "pdf"} pdf
          %p It is a lengthy proof, due to Stefan Born.
          %p A simpler version of the proof appears in
          %ul
            %li#GonnordTosel98
              Stéphane Gonnord, Nicolas Tosel, page 60 of:
              = succeed "," do
                %em Calcul Différentiel
              = succeed "," do
                %a{:href => "http://mathoverflow.net/a/212595"} MO:a/212595
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/files/Aubry_reproducing_GonnordAndTosel.pdf", :title => "pdf"} pdf
          %p
            These proofs had remained obscure (see also
            %a{:href => "good+open+cover#LiteratureOnExistenceOfDifferentiablyGoodOpenCovers"} this Remark
            at
            = succeed "):" do
              %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
          %p For instance in a remark below lemma 10.5.5 of
          %ul
            %li#Conlon08
              Lawrence Conlon,
              = succeed "," do
                %em Differentiable manifolds
              = succeed ")" do
                %a{:href => "https://link.springer.com/book/10.1007/978-0-8176-4767-4"} doi:10.1007/978-0-8176-4767-4
          %p it says:
          %blockquote
            %p
              It seems that open star shaped sets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ⊂
                    %mi M
                  %annotation{:encoding => "application/x-tex"} U \subset M
              are always diffeomorphic to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
          %p And in
          %ul
            %li#Lee09
              %a.existingWikiWord{:href => "/nlab/show/Jeffrey+Lee"}> Jeffrey Lee
              ,
              = succeed "," do
                %em Manifolds and differential geometry
              %strong 107
              (2009) (
              %a{:href => "https://bookstore.ams.org/gsm-107"}> ISBN: 978-0-8218-4815-9
              ,
              = succeed ")" do
                %a{:href => "https://doi.org/10.1090/gsm/107"} doi:10.1090/gsm/107
          %p one finds the statement:
          %blockquote
            %p
              Actually, the assertion that an open geodesically convex set in a Riemannian manifold is diffeomorphic to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              is common in literature, but it is a more subtle issue than it may seem, and references to a complete proof are hard to find (but see [Grom]).
          %p Here “Grom” refers to
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Mikhail+Gromov"}> Mikhail Gromov
              ,
              = succeed "," do
                %em Convex sets and Kähler manifolds
              = succeed "," do
                %em Advances in differential geometry and topology
              = succeed "&rbrack;" do
                %a{:href => "http://www.ihes.fr/~gromov/PDF/%5B68%5D.pdf"} pdf
          %p
            where the relevant statement is 1.4.C1 on page 8. Note however that the diffeomorphism considered there is only of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mn 1
                %annotation{:encoding => "application/x-tex"} C^1
            class, not
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} C^\infty
          %p A series of exercises covering the statement appears in
          %ul
            %li#GuilleminHaine19
              %a.existingWikiWord{:href => "/nlab/show/Victor+Guillemin"}> Victor Guillemin
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Peter+Haine"} Peter Haine
              = succeed "," do
                %em Differential Forms
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1142/11058"} doi:10.1142/11058
          %p See also the discussion at:
          %ul
            %li
              Math Overflow,
              %em explicit diffeomorphim between open simplex and open ball
              \&amp;lbrack;
              %a{:href => "https://mathoverflow.net/q/41853/381"}> q/41853
              \&amp;rbrack;
          %h3#combinatorial_2 Combinatorial
          %ul
            %li#Joyal
              %p
                %a.existingWikiWord{:href => "/nlab/show/Andre+Joyal"}> Andre Joyal
                ,
                %em Disks, duality and Theta-categories
                (
                %a.existingWikiWord{:href => "/nlab/files/JoyalThetaCategories.pdf", :title => "pdf"}> pdf
                )
            %li#MakkaiZawadowski
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mihaly+Makkai"}> Mihaly Makkai
                , Marek Zawadowski,
                %em
                  Duality for Simple
                  = succeed "-Categories" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ω
                        %annotation{:encoding => "application/x-tex"} \omega
                (
                %a{:href => "http://www.emis.de/journals/TAC/volumes/8/n7/8-07abs.html"}> TAC
                )
        .revisedby
