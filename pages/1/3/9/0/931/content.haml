                      %mo{:stretchy => "false"} /
                      %msub
                        %mi G
                        %mn 1
                      %mo )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} \overline{i} : \left( \left( G_2 \times T \right) / G_1 \right) \times \left( \left( G_2 \times T \right) / G_1 \right) \rightarrow G_2 \times \left( \left( G_2 \times T \right) / G_1 \right).
            %p
              That is, it respects, in its left factor, the passage to the quotient by the action of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi G
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} G_1
            %p
              Suppose indeed that we have
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo ,
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msub
                      %mi G
                      %mn 2
                    %mo ×
                    %mi T
                  %annotation{:encoding => "application/x-tex"} (g, t) \in G_2 \times T
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %msub
                        %mi g
                        %mn 1
                      %mo ,
                      %mi g
                      %mo ″
                      %mo ,
                      %mi t
                      %mo ″
                      %mo )
                    %mo ∈
                    %msub
                      %mi G
                      %mn 1
                    %mo ×
                    %msub
                      %mi G
                      %mn 2
                    %mo ×
                    %mi T
                  %annotation{:encoding => "application/x-tex"} \left( g_1, g'', t'' \right) \in G_1 \times G_2 \times T
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
