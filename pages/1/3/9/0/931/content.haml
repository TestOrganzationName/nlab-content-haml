                            %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    i\left( \left( g'', t'' \right), \left[ \left( g', t' \right) \right] \right) &amp;= i\left( \left( g'', t'' \right), \left[ \left( g' h(g_1), a\left( g_1^{-1}, t' \right) \right) \right] \right) \\
                    \&amp;= \left( g'' h(g_1)^{-1} \left(g' \right)^{-1}, \left[ \left( g' h(g_1), a\left( g_1^{-1}, t' \right) \right) \right] \right) \\
                    \&amp;= \left( g \left(g' \right)^{-1}, \left[ \left( g', t' \right) \right] \right) \\
                    \&amp;= i\left( g, \left[ \left( g', t' \right) \right] \right),
                    \\end{aligned}
            %p as required.
            %p
              We now observe that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi i
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"} \overline{i}
              defines an inverse to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ′
                      %mo ×
                      %msub
                        %mi p
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} a' \times p_{2}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} a'
              is the action of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} G_2
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %msub
                        %mi G
                        %mn 2
                      %mo ×
