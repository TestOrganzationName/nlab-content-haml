                      %mrow
                        %mo (
                        %msub
                          %mi G
                          %mn 2
                        %mo ×
                        %mi T
                        %mo )
                      %mo{:stretchy => "false"} /
                      %msub
                        %mi G
                        %mn 1
                      %mo )
                    %mo →
                    %msub
                      %mi G
                      %mn 2
                    %mo ×
                    %mrow
                      %mo (
                      %mrow
                        %mo (
                        %msub
                          %mi G
                          %mn 2
                        %mo ×
                        %mi T
