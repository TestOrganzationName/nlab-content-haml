                %a.existingWikiWord{:href => "/nlab/show/David+W%C3%A4rn"}> David Wärn
                ,
                %em Eilenberg-MacLane spaces and stabilisation in homotopy type theory
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2301.03685"}> arXiv:2301.03685
                \&amp;rbrack;
          %p
            Some further
            %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theoretic
            articles discussing torsors:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Tomasz+Brzezi%C5%84ski"}> Tomasz Brzeziński
                ,
                = succeed "," do
