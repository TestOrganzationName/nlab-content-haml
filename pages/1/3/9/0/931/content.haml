                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              is a
              = succeed "-torsor" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo{:stretchy => "false"} /
                      %mi B
                    %annotation{:encoding => "application/x-tex"} C/B
          %p
            Thus, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} B = 1
            is a point, a torsor over a point is the same as an ordinary torsor in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %p
            We restate this definition equivalently in more nuts-and-bolts terms. The ambient category is
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %p
          .num_defn
            %h6 Definition
            %p
              A left
              = succeed "-torsor" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} B \in C
              is a
              %a.existingWikiWord{:href => "/nlab/show/bundle"} bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mover
                      %mo →
                      %mi π
                    %mi B
                  %annotation{:encoding => "application/x-tex"} P\stackrel{\pi}{\to} B
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              together with a left group
              %a.existingWikiWord{:href => "/nlab/show/action"} action
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo :
                    %mi G
                    %msub
                      %mo ×
                      %mi B
                    %mi P
                    %mo →
                    %mi P
                  %annotation{:encoding => "application/x-tex"}
                    \\rho : G\times_B P \to P
            %p
              which in terms of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/generalized+element"} generalized element
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi g
                    %mo .
                    %mi p
                  %annotation{:encoding => "application/x-tex"}
                    (g,p)\to g.p
            %p
              such that the induced morphism of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/product"} product
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo :
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi ρ
                    %mo ,
                    %msub
                      %mi p
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi G
                    %msub
                      %mo ×
                      %mi B
                    %mi P
                    %mo →
                    %mi P
                    %msub
                      %mo ×
                      %mi B
                    %mi P
                  %annotation{:encoding => "application/x-tex"}
                    \\phi := (\rho, p_2) : G\times_B P \to P\times_B P
            %p which on elements acts as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo .
                    %mi p
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (g,p)\to (g.p,p)
            %p
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            %p
          %p
          .num_remark
            %h6 Remark
            %p
              As we explain
              = succeed "," do
                %a{:href => "#LocalTrivialization"} below
              = succeed "," do
                %strong locally trivial
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
              (so that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo →
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} U \to 1
              is epi, i.e.,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              is inhabited) such that the torsor, when pulled back to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              as
              = succeed "-torsor)." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi i
                    %mo ↪
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} U_i \hookrightarrow 1
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo =
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi i
                    %msub
                      %mi U
                      %mi i
                  %annotation{:encoding => "application/x-tex"} U = \sum_i U_i
              is inhabited (e.g., an open cover of a space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              seen as the terminal object of the sheaf topos
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Sh(B)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topology"} Grothendieck topology
            %p
              (The condition on the action can be translated to give transitivity etc. in the case of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              is a point (left as a standard exercise).)
            %p
          %h3#examples Examples
          %h4#in_topological_spaces In topological spaces
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo =
                %annotation{:encoding => "application/x-tex"} C =
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            are
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological group
          %p
            A topological
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi π
                  %mo :
                  %mi P
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} \pi: P \to B
            is an example of a torsor over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} Top
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            (see the remarks
            = succeed ")." do
              %a{:href => "#LocalTrivialization"} below
          %h4#in_sheaves In sheaves
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo =
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C = Sh(S)
            be a
            %a.existingWikiWord{:href => "/nlab/show/category+of+sheaves"} category of sheaves
            over a
            %a.existingWikiWord{:href => "/nlab/show/site"} site
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
          %p
            The canonical example for a torsor in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is the
            %a.existingWikiWord{:href => "/nlab/show/trivial+torsor"} trivial torsor
            over a
            %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
            of groups,
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %h4#GroupExtensions Group extensions
          %p
            Every
            %a.existingWikiWord{:href => "/nlab/show/group+extension"} group extension
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo →
                  %mover
                    %mi G
                    %mo{:stretchy => "false"} ^
                  %mo →
                  %mi G
                %annotation{:encoding => "application/x-tex"} A \to \hat G \to G
            canonically equips
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi G
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat G
            with the structure of an
            = succeed "-torsor" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a{:href => "http://ncatlab.org/nlab/show/group+extension#Torsors"} Group extensions as torsors
            for details
          %h3#LocalTrivialization Local trivialization
          %p
            In other categories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            besides
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            even if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo →
                  %mn 1
                %annotation{:encoding => "application/x-tex"} P \to 1
            is an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
            %a.existingWikiWord{:href => "/nlab/show/topos+theory"} topos theory
            that a statement is “locally true” in a category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            if it becomes true when reinterpreted in a slice after pulling back
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo →
                    %mi C
                    %mo{:stretchy => "false"} /
                    %mi U
                  %annotation{:encoding => "application/x-tex"} C \to C/U
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            is inhabited. (This in some sense is the basis of
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/Kripke-Joyal+semantics"} Kripke-Joyal semantics
          %p
            In the present case, we may take
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo =
                    %mi P
                  %annotation{:encoding => "application/x-tex"} U = P
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            (= global section of
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo →
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} P \to 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            if we reinterpret it by pulling back to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} /
                    %mi P
                  %annotation{:encoding => "application/x-tex"} C/P
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 2
                  %mo :
                  %mi P
                  %mo ×
                  %mi P
                  %mo →
                  %mn 1
                  %mo ×
                  %mi P
                  %mo ≅
                  %mi P
                %annotation{:encoding => "application/x-tex"} \pi_2: P \times P \to 1 \times P \cong P
            does have a global section regarded as an arrow in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} /
                    %mi P
                  %annotation{:encoding => "application/x-tex"} C/P
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo :
                    %mi P
                    %mo →
                    %mi P
                    %mo ×
                    %mi P
                  %annotation{:encoding => "application/x-tex"} \Delta: P \to P \times P
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi G
                          %mo ×
                          %mi P
                        %mtd
                          %mo →
                        %mtd
                          %mi G
                          %mo ×
                          %mi P
                          %mo ×
                          %mi P
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                          %mpadded{:width => "0"}
                            %mrow
                              %mo{:stretchy => "false"} ⟨
                              %mi ρ
                              %mo ,
                              %msub
                                %mi π
                                %mn 2
                              %mo{:stretchy => "false"} ⟩
                              %mo ×
                              %mi id
                      %mtr
                        %mtd
                          %mi P
                          %mo ×
                          %mi P
                        %mtd
                          %munder
                            %mo →
                            %mrow
                              %mi id
                              %mo ×
                              %mi Δ
                        %mtd
                          %mi P
                          %mo ×
                          %mi P
                          %mo ×
                          %mi P
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  G \times P &amp; \to &amp; G \times P \times P \\
                  \\downarrow &amp; &amp; \downarrow \mathrlap{\langle \rho, \pi_2 \rangle \times id} \\
                  P \times P &amp; \underset{id \times \Delta}{\to} &amp; P \times P \times P
                  }
          %p
            living in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} /
                    %mi P
                  %annotation{:encoding => "application/x-tex"} C/P
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mi ρ
                  %mo ,
                  %msub
                    %mi π
                    %mn 2
                  %mo{:stretchy => "false"} ⟩
                  %mo :
                  %mi G
                  %mo ×
                  %mi P
                  %mo →
                  %mi P
                  %mo ×
                  %mi P
                %annotation{:encoding => "application/x-tex"} \langle \rho, \pi_2 \rangle: G \times P \to P \times P
            we started with!
          %p
            Thus, a
            = succeed "-torsor" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "-actions" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            which become trivialized upon pulling back to the slice
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} /
                    %mi P
                  %annotation{:encoding => "application/x-tex"} C/P
          %h2#generalizations Generalizations
          %ul
            %li
              %p
                Instead of a torsor over a group, one can consider a torsor over a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/category"} category
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/torsor+with+structure+category"} torsor with structure category
            %li
              %p
                In
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/noncommutative+algebraic+geometry"} noncommutative algebraic geometry
