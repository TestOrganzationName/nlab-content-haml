                  %annotation{:encoding => "application/x-tex"} \left( G_2 \times T \right) / G_1
              induced by left multiplication, and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} p_2
              is the projection map
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi G
                        %mn 2
                      %mo ×
                      %mrow
                        %mo (
                        %mrow
                          %mo (
                          %msub
                            %mi G
                            %mn 2
                          %mo ×
                          %mi T
                          %mo )
                        %mo{:stretchy => "false"} /
                        %msub
                          %mi G
                          %mn 1
                        %mo )
                      %mo →
                      %mrow
                        %mo (
                        %mrow
                          %mo (
                          %msub
                            %mi G
                            %mn 2
                          %mo ×
                          %mi T
                          %mo )
                        %mo{:stretchy => "false"} /
                        %msub
                          %mi G
                          %mn 1
                        %mo )
                    %annotation{:encoding => "application/x-tex"} G_2 \times \left( \left( G_2 \times T \right) / G_1 \right) \rightarrow \left( \left( G_2 \times T \right) / G_1 \right)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ,
                    %mi g
                    %mo ′
                    %mo ∈
                    %msub
                      %mi G
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} g, g' \in G_2
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mo ∈
                      %mi T
                    %annotation{:encoding => "application/x-tex"} t \in T
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi i
                      %mo ¯
                    %mrow
                      %mo (
                      %mrow
                        %mo [
                        %mrow
                          %mo (
                          %mi g
                          %mo ′
                          %mi g
                          %mo ,
                          %mi t
                          %mo )
                        %mo ]
                      %mo ,
                      %mrow
                        %mo [
                        %mrow
                          %mo (
                          %mi g
                          %mo ,
                          %mi t
                          %mo )
                        %mo ]
                      %mo )
                    %mo =
                    %mrow
                      %mo (
                      %mi g
                      %mo ′
                      %mi g
                      %msup
                        %mi g
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo ,
                      %mrow
                        %mo [
                        %mrow
                          %mo (
                          %mi g
                          %mo ,
                          %mi t
