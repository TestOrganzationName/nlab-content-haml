                                    %mo ,
                                    %mi t
                                    %mo ′
                                    %mo )
                                  %mo )
                                %mo ]
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mrow
                              %mo (
                              %mi g
                              %msup
                                %mrow
                                  %mo (
                                  %mi g
                                  %mo ′
                                  %mo )
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mn 1
                              %mo ,
                              %mrow
                                %mo [
