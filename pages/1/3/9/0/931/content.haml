          %h3#TrivialisationInSets Trivialisation
          %p
          #PropositionTorsorIsomorphicAsSetToStructureGroup.num_prop
            %h6 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
