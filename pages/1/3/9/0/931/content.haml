                              %msub
                                %mi g
                                %mn 1
                              %msup
                                %mo{:stretchy => "false"} )
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mn 1
                              %msup
                                %mrow
                                  %mo (
                                  %mi g
                                  %mo ′
                                  %mo )
                                %mrow
