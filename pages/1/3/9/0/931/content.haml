                D. H. Van Osdol,
                = succeed "," do
                  %em Principal homogeneous objects as representable functors
                %a{:href => "http://www.numdam.org/item?id=CTGDC_1977__18_3_271_0"} numdam
            %li
              %p
                K. T. S. Mohapeloa,
                = succeed "," do
                  %em
                    A
                    = succeed "-colimit" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
