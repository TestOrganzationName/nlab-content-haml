                          %mo ′
                          %mo{:stretchy => "false"} )
                          %mo )
                        %mo ]
                      %mo =
                      %mrow
                        %mo [
                        %mrow
                          %mo (
                          %mi g
                          %mo ′
                          %mi h
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi g
                            %mn 1
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mi a
                          %mrow
                            %mo (
                            %msubsup
                              %mi g
                              %mn 1
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo ,
                            %mi t
                            %mo ′
                            %mo )
                          %mo )
                        %mo ]
                    %annotation{:encoding => "application/x-tex"} \left[ (g', t') \right] = \left[ \left( g' h\left(g_1^{-1}\right)^{-1}, a(g_1^{-1}, t') \right) \right] = \left[ \left( g' h(g_1), a\left(g_1^{-1}, t'\right) \right) \right]
            %p Putting these together, we obtain that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi i
                            %mrow
                              %mo (
