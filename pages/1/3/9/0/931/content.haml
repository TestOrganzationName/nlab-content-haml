                          %mn 1
                        %mo )
                      %mo ×
                      %mrow
                        %mo (
                        %mrow
                          %mo (
                          %msub
                            %mi G
                            %mn 2
                          %mo ×
                          %mi T
                          %mo )
                        %mo{:stretchy => "false"} /
                        %msub
                          %mi G
                          %mn 1
                        %mo )
                    %annotation{:encoding => "application/x-tex"} \left( \left[ \left(g, t \right) \right], \left[ \left( g', t' \right) \right] \right) \in \left( \left( G_2 \times T \right) / G_1 \right) \times \left( \left( G_2 \times T \right) / G_1 \right)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ×
                    %msub
                      %mi p
                      %mn 2
                    %mo :
                    %msub
                      %mi G
                      %mn 1
                    %mo ×
                    %mi T
                    %mo →
                    %mi T
                    %mo ×
                    %mi T
                  %annotation{:encoding => "application/x-tex"} a \times p_2 : G_1 \times T \rightarrow T \times T
              is an isomorphism, there is a
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mn 1
                    %mo ∈
                    %msub
                      %mi G
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} g_1 \in G_1
              such that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mo ′
                      %mo =
                      %mi a
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi g
                        %mn 1
                      %mo ,
                      %mi t
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} t' = a(g_1, t)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo [
                        %mrow
