                      %mo ′
                      %mo ,
                      %mrow
                        %mo [
                        %mrow
                          %mo (
                          %mi g
                          %mo ,
                          %mi t
                          %mo )
                        %mo ]
                      %mo )
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} \overline{i}\left( \left[ \left(g' g, t \right) \right], \left[ \left( g, t \right) \right] \right) = \left( g' g g^{-1}, \left[ \left( g, t \right) \right] \right) = \left( g', \left[ \left( g, t \right) \right] \right),
            %p
              as required. In the other direction, suppose that we have
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo (
                        %mrow
                          %mo [
                          %mrow
                            %mo (
                            %mi g
                            %mo ,
