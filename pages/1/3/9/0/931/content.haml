                          %mo{:stretchy => "false"} )
                          %mo )
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} g''  h(g_1)^{-1} \left(g'\right) ^{-1} = g'' \left( g' h(g_1) \right)^{-1}
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo [
                        %mo{:stretchy => "false"} (
                        %mi g
                        %mo ′
                        %mo ,
