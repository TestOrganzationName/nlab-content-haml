                  %use{:x => "80.337481", "xlink:href" => "#Ix7Wp-nP28oigEJfryYsqjYAgds=-glyph-2-2", :y => "89.661"}
                %g{:fill => "rgb(0%, 0%, 0%)", "fill-opacity" => "1"}
                  %use{:x => "85.784", "xlink:href" => "#Ix7Wp-nP28oigEJfryYsqjYAgds=-glyph-3-1", :y => "89.661"}
                %g{:fill => "rgb(0%, 0%, 0%)", "fill-opacity" => "1"}
                  %use{:x => "94.01775", "xlink:href" => "#Ix7Wp-nP28oigEJfryYsqjYAgds=-glyph-2-3", :y => "89.661"}
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi T
                      %mo ̲
                  %annotation{:encoding => "application/x-tex"} \underline{T}
              is a
              = succeed "-torsor," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ×
                    %msub
                      %mi p
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} a \times p_2
              is an isomorphism. The proposition thus follows immediately from the fact that pullbacks of isomorphisms are isomorphisms (as proven at
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
          %p
            In fact we can improve the above result to show that any
            = succeed "-torsor" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "-set," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            itself. Thus every
            = succeed "-torsor" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %p
          .num_defn
            %h6 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/group"} group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi T
                      %mo ̲
                    %mo =
                    %mrow
                      %mo (
                      %mi T
                      %mo ,
                      %mi a
                      %mo :
                      %mi G
                      %mo ×
                      %mi T
                      %mo →
                      %mi T
                      %mo )
                  %annotation{:encoding => "application/x-tex"} \underline{T} = \left( T, a: G \times T \rightarrow T \right)
              be a
              = succeed "-torsor." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %em trivialisation
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi T
                      %mo ̲
                  %annotation{:encoding => "application/x-tex"} \underline{T}
              is an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              of
              = succeed "-torsors" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              and the underlying
              = succeed "-torsor" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
          %p
          .num_remark
            %h6 Remark
            %p
              The proof of Proposition
              %a.maruku-ref{:href => "#PropositionTorsorIsomorphicAsSetToStructureGroup"}
              lets us see that any choice of element of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              gives rise to a trivialisation.
            %p
              Note also that a trivialization equips
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              with a
              %em choice
              of group structure making it isomorphic to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
          %h3#functoriality_change_of_structure_group Functoriality (change of structure group)
          %p
            Torsors can be transported, or in other words pushed forward, along group homomorphisms, as we shall now show. (See also at
            = succeed ")." do
              %em
                %a{:href => "topological+G-space#ChangeOfGroupsAndFixedLoci"} G-space – change of structure group
          %p
          .num_prop
            %h6 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo :
                    %msub
                      %mi G
                      %mn 1
                    %mo →
                    %msub
                      %mi G
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} h : G_1 \rightarrow G_2
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homomorphism"} group homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi T
                      %mo ̲
                    %mo =
                    %mrow
                      %mo (
                      %mi T
                      %mo ,
                      %mi a
                      %mo )
                  %annotation{:encoding => "application/x-tex"} \underline{T} = \left( T, a \right)
              be a
              = succeed "-torsor." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi G
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} G_1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %msub
                        %mi g
                        %mn 1
                      %mo ,
                      %msub
                        %mi g
                        %mn 2
                      %mo ,
                      %mi t
                      %mo )
                    %mo ↦
                    %mrow
                      %mo (
                      %msub
                        %mi g
                        %mn 2
                      %mo ⋅
                      %mi h
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi g
                        %mn 1
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo ,
                      %mi a
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi g
                        %mn 1
                      %mo ,
                      %mi t
                      %mo{:stretchy => "false"} )
                      %mo )
                  %annotation{:encoding => "application/x-tex"} \left(g_1, g_2, t \right) \mapsto \left( g_2 \cdot h(g_1)^{-1}, a(g_1, t) \right)
              defines an action
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mn 1
                    %mo ×
                    %msub
                      %mi G
                      %mn 2
                    %mo ×
                    %mi T
                    %mo →
                    %msub
                      %mi G
                      %mn 2
                    %mo ×
                    %mi T
                  %annotation{:encoding => "application/x-tex"} G_1 \times G_2 \times T \rightarrow G_2 \times T
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} G_1
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi G
                        %mn 2
                      %mo ×
                      %mi T
                    %annotation{:encoding => "application/x-tex"} G_2 \times T
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo (
                        %msub
                          %mi G
                          %mn 2
                        %mo ×
                        %mi T
                        %mo )
                      %mo{:stretchy => "false"} /
                      %msub
                        %mi G
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \left(G_2 \times T \right) / G_1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mn 2
                    %mo ×
                    %mi X
                  %annotation{:encoding => "application/x-tex"} G_2 \times X
              with respect to this
              = succeed "-action," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi G
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} G_1
              = succeed "-torsor" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi G
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} G_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} G_2
              induced by left multiplication, namely that given by
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo (
                        %mi g
                        %mo ,
                        %mrow
                          %mo [
                          %mo{:stretchy => "false"} (
                          %mi g
                          %mo ′
                          %mo ,
                          %mi t
                          %mo ′
                          %mo{:stretchy => "false"} )
                          %mo ]
                        %mo )
                      %mo ↦
                      %mrow
                        %mo [
                        %mrow
                          %mo (
                          %mi g
                          %mi g
                          %mo ′
                          %mo ,
                          %mi t
                          %mo ′
                          %mo )
                        %mo ]
                    %annotation{:encoding => "application/x-tex"} \left( g, \left[ (g', t') \right] \right) \mapsto \left[ \left(g g', t' \right) \right]
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo [
                        %mi p
                        %mo ]
                    %annotation{:encoding => "application/x-tex"} \left[ p \right]
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ∈
                      %msub
                        %mi G
                        %mn 2
                      %mo ×
                      %mi T
                    %annotation{:encoding => "application/x-tex"} p \in G_2 \times T
              %a.existingWikiWord{:href => "/nlab/show/orbit"} orbit
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              with respect to the action of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} G_1
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi G
                        %mn 2
                      %mo ×
                      %mi T
                    %annotation{:encoding => "application/x-tex"} G_2 \times T
          %p
          .proof
            %h6 Proof
            %p We shall demonstrate that the map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %mrow
                      %mo (
                      %msub
                        %mi G
                        %mn 2
                      %mo ×
                      %mi T
                      %mo )
                    %mo ×
                    %mrow
                      %mo (
                      %mrow
                        %mo (
                        %msub
                          %mi G
                          %mn 2
                        %mo ×
                        %mi T
                        %mo )
                      %mo{:stretchy => "false"} /
                      %msub
                        %mi G
                        %mn 1
                      %mo )
                    %mo →
                    %msub
                      %mi G
                      %mn 2
                    %mo ×
                    %mrow
                      %mo (
                      %mrow
                        %mo (
                        %msub
                          %mi G
                          %mn 2
                        %mo ×
