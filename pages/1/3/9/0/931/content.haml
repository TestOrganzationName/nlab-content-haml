          %p Elementary exposition:
          %ul
            %li#Baez
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+Baez"}> John Baez
                ,
                = succeed "," do
                  %em Torsors made easy
                = succeed ")" do
                  %a{:href => "http://math.ucr.edu/home/baez/torsors.html"} web
              %blockquote
                %p
                  (discussion for
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/discrete+groups"} discrete groups
          %p Textbook accounts:
          %ul
            %li#Milne80
              %p
                %a.existingWikiWord{:href => "/nlab/show/James+Milne"}> James Milne
                , Prop. III.4.1 in:
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/%C3%89tale+Cohomology"} Étale Cohomology
                %strong 33
                (1980) &amp;lbrack;
                %a{:href => "https://www.jstor.org/stable/j.ctt1bpmbk1"}> jstor:j.ctt1bpmbk1
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://press.princeton.edu/books/hardcover/9780691082387/etale-cohomology-pms-33-volume-33"} ISBN:9780691082387
              %blockquote
                %p
                  (discussion for
                  %a.existingWikiWord{:href => "/nlab/show/algebraic+groups"} algebraic groups
                  in
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/algebraic+geometry"} algebraic geometry
          %p
            For more see the references at
            %em
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            (which are torsors in the generality
