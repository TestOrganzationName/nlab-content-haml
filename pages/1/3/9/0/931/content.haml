                        %msub
                          %mi g
                          %mn 1
                        %mo ,
                        %mi t
                        %mo ″
                        %mo{:stretchy => "false"} )
                        %mo )
                    %annotation{:encoding => "application/x-tex"} (g, t) = \left( g'' \cdot h(g_1)^{-1}, a(g_1, t'') \right)
            %ol
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
