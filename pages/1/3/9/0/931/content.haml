                                  %mo (
                                  %mi g
                                  %mo ′
                                  %mo ,
                                  %mi t
                                  %mo ′
                                  %mo )
                                %mo ]
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi i
                            %mrow
                              %mo (
                              %mi g
                              %mo ,
                              %mrow
                                %mo [
                                %mrow
                                  %mo (
                                  %mi g
                                  %mo ′
                                  %mo ,
                                  %mi t
                                  %mo ′
                                  %mo )
                                %mo ]
