                                    %mo ′
                                    %mo )
                                  %mo )
                                %mo ]
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mrow
                              %mo (
                              %mi g
                              %mo ″
                              %mi h
