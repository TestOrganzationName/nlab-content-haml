              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi T
                      %mo ̲
                    %mo =
                    %mrow
                      %mo (
                      %mi T
                      %mo ,
                      %mi a
                      %mo :
                      %mi G
                      %mo ×
                      %mi T
                      %mo →
                      %mi T
                      %mo )
                  %annotation{:encoding => "application/x-tex"} \underline{T} = \left( T, a: G \times T \rightarrow T \right)
              be a
              = succeed "-torsor." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
