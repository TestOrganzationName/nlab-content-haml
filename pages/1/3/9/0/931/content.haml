                  %annotation{:encoding => "application/x-tex"} \left( (g, t), \left[ (g', t') \right] \right) \mapsto \left( g\left(g'\right)^{-1}, \left[ (g', t') \right] \right)
            %p induces a map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi i
                      %mo ¯
                    %mo :
                    %mrow
                      %mo (
                      %mrow
                        %mo (
                        %msub
                          %mi G
                          %mn 2
                        %mo ×
                        %mi T
                        %mo )
