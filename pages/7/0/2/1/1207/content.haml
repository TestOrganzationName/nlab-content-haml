          %title
          %p Measuring of coalgebras of algebra morphisms and algebras was introduced by Sweedler in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/M.+E.+Sweedler"}> M. E. Sweedler
              ,
              = succeed "," do
                %strong Hopf algebras
          %p
            Given a commutative ring
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "-coalgebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %msub
                    %mi Δ
                    %mi C
                  %mo ,
                  %mi ϵ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (C,\Delta_C,\epsilon)
            and
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ′
                  %mo ,
                  %mi μ
                  %mo ′
                  %mo ,
                  %mi η
                  %mo ′
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A',\mu',\eta')
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi μ
                    %mo ,
                    %mi η
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (A,\mu,\eta)
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              \-measuring
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ′
                %annotation{:encoding => "application/x-tex"} A'
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is a
            = succeed "-linear" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi C
                  %mo →
                  %msub
                    %mi Mod
                    %mi k
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ′
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f: C\to Mod_k(A',A)
            such that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ev
                  %mo ∘
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ⊗
                  %msub
                    %mi μ
                    %mrow
                      %mi A
                      %mo ′
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi μ
                    %mi A
                  %mo ∘
                  %mo{:stretchy => "false"} (
                  %mi ev
                  %mo ⊗
                  %mi ev
                  %mo{:stretchy => "false"} )
                  %mo ∘
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ⊗
                  %mi A
                  %mo ′
                  %mo ⊗
                  %mi f
                  %mo ⊗
                  %mi A
                  %mo ′
                  %mo{:stretchy => "false"} )
                  %mo ∘
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ⊗
                  %msub
                    %mi τ
                    %mrow
                      %mi A
                      %mo ′
                      %mo ,
                      %mi C
                  %mo ⊗
                  %mi A
                  %mo ′
                  %mo{:stretchy => "false"} )
                  %mo ∘
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Δ
                    %mi C
                  %mo ⊗
                  %mi A
                  %mo ′
                  %mo ⊗
                  %mi A
                  %mo ′
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi C
                  %mo ⊗
                  %mi A
                  %mo ′
                  %mo ⊗
                  %mi A
                  %mo ′
                  %mo →
                  %mi A
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  ev\circ (f\otimes\mu_{A'}) = \mu_A\circ (ev\otimes ev)\circ(f\otimes A'\otimes f\otimes A')\circ (C\otimes \tau_{A',C}\otimes A')\circ (\Delta_C\otimes A'\otimes A') : C\otimes A'\otimes A'\to A,
          %p
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ∘
                  %mi η
                  %mo ′
                  %mo =
                  %mi η
                  %mo ∘
                  %msub
                    %mi ϵ
                    %mi C
                  %mo :
                  %mi C
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} f\circ \eta' = \eta\circ\epsilon_C:C\to A
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi τ
                %annotation{:encoding => "application/x-tex"} \tau
            is the transposition of factors and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ev
                %annotation{:encoding => "application/x-tex"} ev
            the evaluation of a map. In Sweedler notation, the requirements on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            are
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi a
                  %msub
                    %mo ⋅
                    %mrow
                      %mi A
                      %mo ′
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi f
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ⋅
                    %mi A
                  %mi f
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f(c)(a\cdot_{A'} b) = f(c_{(1)})(a)\cdot_A f(c_{(2)})(b)
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mn 1
                      %mrow
                        %mi A
                        %mo ′
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi ϵ
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %msub
                      %mn 1
                      %mi A
                  %annotation{:encoding => "application/x-tex"} f(c)(1_{A'}) = \epsilon(c)1_{A}
          %p
            We can instead of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi C
                  %mo →
                  %msub
                    %mi Mod
                    %mi k
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ′
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f:C\to Mod_k(A',A)
            consider its adjoint map
