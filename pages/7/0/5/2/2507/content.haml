                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Spin
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo ,
                        %mi d
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Spin(1,d)
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/equivariant+map"} equivariant
            %p
              First, the super-Minkowski
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
              %a.existingWikiWord{:href => "/nlab/show/structure"} structure
              on the
              %a.existingWikiWord{:href => "/nlab/show/super+vector+space"} super vector space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 1
                        %mo ,
                        %mi d
                        %mo{:stretchy => "false"} |
                        %mstyle{:mathvariant => "bold"}
                          %mi N
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 1
                        %mo +
                        %mi d
                    %mo ×
                    %msubsup
                      %mi ℝ
                      %mi odd
                      %mi N
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R}^{1,d\vert\mathbf{N}}
                    \\;\coloneqq\;
                    \\mathbb{R}^{1+d} \times \mathbb{R}^N_{odd}
            %p
              is defined,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/formal+duality"} dually
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg
              %a.existingWikiWord{:href => "/nlab/show/dgc-superalgebra"} dgc-superalgebra
              with generators of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo ×
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z} \times \mathbb{Z}/2
              bidegree
            %table
              %thead
                %tr
                  %th generator
                  %th bidegree
              %tbody
                %tr
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi e
                            %mi a
                        %annotation{:encoding => "application/x-tex"} e^a
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo ,
                          %mi evn
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (1,evn)
                %tr
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi ψ
                            %mi α
                        %annotation{:encoding => "application/x-tex"} \psi^\alpha
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo ,
                          %mi odd
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (1,odd)
            %p
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} a \in \{0,1, \cdots, d\}
              indexing a
              %a.existingWikiWord{:href => "/nlab/show/linear+basis"} linear basis
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi D
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^D
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo ∈
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mi N
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \alpha \in \{1,\cdots, N\}
              indexing a
              %a.existingWikiWord{:href => "/nlab/show/linear+basis"} linear basis
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi N
                  %annotation{:encoding => "application/x-tex"} \mathbf{N}
              by the differential equations
            #eq:CEAlgebraOfSuperMinkowski.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "center center left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mi{:mathvariant => "normal"} d
                          %mspace{:width => "thinmathspace"}
                          %msup
                            %mi e
                            %mi a
                        %mtd
                          %mo ≔
                        %mtd
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mover
                            %mi ψ
                            %mo ¯
                          %mspace{:width => "thinmathspace"}
                          %msup
                            %mi Γ
                            %mi a
                          %mspace{:width => "thinmathspace"}
                          %mi ψ
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mtr
                        %mtd
                          %mi{:mathvariant => "normal"} d
                          %mspace{:width => "thinmathspace"}
                          %mi ψ
                        %mtd
                          %mo =
                        %mtd
                          %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{ccl}
                    \\mathrm{d}\, e^a
                    \&amp;\coloneqq&amp;
                    \\big( \overline{\psi} \,\Gamma^a\, \psi \big)
                    \\\
                    \\mathrm{d}\, \psi
                    \&amp;=&amp;
                    0
                    \\end{array}
            %p
              The first differential is the
              %a.existingWikiWord{:href => "/nlab/show/linear+dual"} linear dual
              of the archetypical
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+bracket"} super Lie bracket
              in the
              %a.existingWikiWord{:href => "/nlab/show/supersymmetry"} supersymmetry
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
              which takes two odd elements to a spatial translation. The second differential is the
              %a.existingWikiWord{:href => "/nlab/show/linear+dual"} linear dual
              of the fact that in the absence of rotational generators, no Lie bracket in the supersymmetry alegbra results in a non-vanishing odd element.
            %p
              Next we regard
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 1
                        %mo ,
                        %mn 10
                        %mo{:stretchy => "false"} |
                        %mstyle{:mathvariant => "bold"}
                          %mi N
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{1,10\vert\mathbf{N}}
              not just as a
              %a.existingWikiWord{:href => "/nlab/show/super+vector+space"} super vector space
              but as a
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+superspace"} Cartesian
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/supermanifold"} supermanifold
              %a.existingWikiWord{:href => "/nlab/show/coordinate+functions"} coordinate functions
            %table
              %thead
                %tr
                  %th generator
                  %th bidegree
              %tbody
                %tr
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi x
                            %mi a
                        %annotation{:encoding => "application/x-tex"} x^a
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo ,
                          %mi evn
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (0,evn)
                %tr
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi θ
                            %mi α
                        %annotation{:encoding => "application/x-tex"} \theta^\alpha
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo ,
                          %mi odd
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (0,odd)
            %p
              On this supermanifold, consider the
              %a.existingWikiWord{:href => "/nlab/show/super+coframe+field"} super coframe field
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %mi ψ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi T
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 1
                        %mo ,
                        %mi d
                        %mo{:stretchy => "false"} |
                        %mstyle{:mathvariant => "bold"}
                          %mi N
                    %mover
                      %mo →
                      %mspace{:width => "thickmathspace"}
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 1
                        %mo ,
                        %mn 10
                        %mo{:stretchy => "false"} |
                        %mstyle{:mathvariant => "bold"}
                          %mi N
                  %annotation{:encoding => "application/x-tex"}
                    (e,\psi)
                    \\;\colon\;
                    T\mathbb{R}^{1,d\vert\mathbf{N}}
                    \\xrightarrow{\;}
                    \\mathbb{R}^{1,10\vert\mathbf{N}}
            %p
              (where on the left we have the
              %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
              and on the right its
              %a.existingWikiWord{:href => "/nlab/show/typical+fiber"} typical fiber
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/super+vector+space"} super vector space
            #eq:LIFormsOnSuperMinkowski.maruku-equation
              %span.maruku-eq-number (3)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "center center left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %msup
                            %mi e
                            %mi a
                        %mtd
                          %mo ≔
                        %mtd
                          %mi{:mathvariant => "normal"} d
                          %msup
                            %mi x
                            %mi a
                          %mo +
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mover
                            %mi θ
                            %mo ¯
                          %mspace{:width => "thinmathspace"}
                          %msup
                            %mi Γ
                            %mi a
                          %mi{:mathvariant => "normal"} d
                          %mi θ
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mtr
                        %mtd
                          %mi ψ
                        %mtd
                          %mo ≔
                        %mtd
                          %mi{:mathvariant => "normal"} d
                          %mi θ
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{ccl}
                    e^a
                    \&amp;\coloneqq&amp;
                    \\mathrm{d}x^a
                    + \big(\overline{\theta} \,\Gamma^a \mathrm{d}\theta\big)
                    \\\
                    \\psi
                    \&amp;\coloneqq&amp;
                    \\mathrm{d}\theta
                    \\end{array}
            %p
              It is clear that this is a
              %a.existingWikiWord{:href => "/nlab/show/coframe+field"} coframe field
              in that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 1
                        %mo ,
                        %mi d
                        %mo{:stretchy => "false"} |
                        %mstyle{:mathvariant => "bold"}
                          %mi N
                  %annotation{:encoding => "application/x-tex"} x \in \mathbb{R}^{1,d\vert\mathbf{N}}
              it restricts to an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi x
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 1
                        %mo ,
                        %mi d
                        %mo{:stretchy => "false"} |
                        %mstyle{:mathvariant => "bold"}
                          %mi N
                    %mover
                      %mo →
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mo ∼
                        %mspace{:width => "thickmathspace"}
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 1
                        %mo ,
                        %mi d
                        %mo{:stretchy => "false"} |
                        %mstyle{:mathvariant => "bold"}
                          %mi N
                  %annotation{:encoding => "application/x-tex"}
                    T_{x}\mathbb{R}^{1,d\vert\mathbf{N}}
                    \\xrightarrow{\;\sim\;}
                    \\mathbb{R}^{1,d\vert\mathbf{N}}
            %p
              and the peculiar second summand in the first line is chosen such that its
              %a.existingWikiWord{:href => "/nlab/show/de+Rham+differential"} de Rham differential
              has the same form as the differential in the
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:CEAlgebraOfSuperMinkowski"} (2)
            %p
              (Incidentally, a
              %a.existingWikiWord{:href => "/nlab/show/frame+field"} frame field
              %a.existingWikiWord{:href => "/nlab/show/linear+dual"} linear dual
              to the
              %a.existingWikiWord{:href => "/nlab/show/coframe+field"} coframe field
              %a.maruku-eqref{:href => "#eq:LIFormsOnSuperMinkowski"} (3)
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "center center left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %msub
                            %mi D
                            %mi a
                        %mtd
                          %mo ≔
                        %mtd
                          %msub
                            %mo ∂
                            %mrow
                              %msup
                                %mi x
                                %mi a
                      %mtr
                        %mtd
                          %msub
                            %mi D
                            %mi α
                        %mtd
                          %mo ≔
                        %mtd
                          %msub
                            %mo ∂
                            %mrow
                              %msup
                                %mi θ
                                %mi α
                          %mo +
                          %mover
                            %mi θ
                            %mo ¯
                          %msup
                            %mi Γ
                            %mi a
                          %msub
                            %mo ∂
                            %mrow
                              %msup
                                %mi v
                                %mi a
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mtext such that
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mtable{:columnalign => "left left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %msup
                            %mi e
                            %mi a
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi D
                            %mi b
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thinmathspace"}
                          %mo =
                          %mspace{:width => "thinmathspace"}
                          %msubsup
                            %mi δ
                            %mi b
                            %mi a
                          %mspace{:width => "thinmathspace"}
                          %mo ,
                        %mtd
                          %msup
                            %mi e
                            %mi a
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi D
                            %mi α
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thinmathspace"}
                          %mo =
                          %mspace{:width => "thinmathspace"}
                          %mn 0
                      %mtr
                        %mtd
                          %msup
                            %mi ψ
                            %mi α
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi D
                            %mi a
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thinmathspace"}
                          %mo =
                          %mspace{:width => "thinmathspace"}
                          %mn 0
                          %mspace{:width => "thinmathspace"}
                          %mo ,
                        %mtd
                          %msup
                            %mi ψ
                            %mi α
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi D
                            %mi β
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thinmathspace"}
                          %mo =
                          %mspace{:width => "thinmathspace"}
                          %msubsup
                            %mi δ
                            %mi β
                            %mi α
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{ccl}
                    D_a
                    \&amp;\coloneqq&amp;
                    \\partial_{x^a}
                    \\\
                    D_\alpha &amp;\coloneqq&amp;
                    \\partial_{\theta^\alpha}
                    +
                    \\overline{\theta}\Gamma^a \partial_{v^a}
                    \\end{array}
                    \\;\;\;\;\;\;\;
                    \\text{such that}
                    \\;\;\;\;
                    \\begin{array}{ll}
                    e^a(D_b) \,=\, \delta^a_b \,,
                    \&amp;
                    e^a(D_\alpha) \,=\, 0
                    \\\
                    \\psi^\alpha(D_a) \,=\, 0 \,,
                    \&amp;
                    \\psi^\alpha(D_\beta) \,=\, \delta^\alpha_\beta
                    \\end{array}
            %p
              which are the operators often stated right away in introductory texts on
              = succeed ".)" do
                %a.existingWikiWord{:href => "/nlab/show/supersymmetry"} supersymmetry
            %p
              This fact, that the
              %a.existingWikiWord{:href => "/nlab/show/Maurer-Cartan+equations"} Maurer-Cartan equations
              of a
              %a.existingWikiWord{:href => "/nlab/show/coframe+field"} coframe field
              %a.maruku-eqref{:href => "#eq:LIFormsOnSuperMinkowski"} (3)
              coincide with the defining equations
              %a.maruku-eqref{:href => "#eq:CEAlgebraOfSuperMinkowski"} (2)
              of the
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
              of a
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
              of course characterizes the
              %a.existingWikiWord{:href => "/nlab/show/left+invariant+1-forms"} left invariant 1-forms
              on a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/super+Lie+group"} super Lie group
              %a.existingWikiWord{:href => "/nlab/show/structure"} structure
              on the
              %a.existingWikiWord{:href => "/nlab/show/supermanifold"} supermanifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 1
                        %mo ,
                        %mi d
                        %mo{:stretchy => "false"} |
                        %mstyle{:mathvariant => "bold"}
                          %mi N
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{1,d\vert\mathbf{N}}
              with respect to which the coframe
              %a.maruku-eqref{:href => "#eq:LIFormsOnSuperMinkowski"} (3)
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/left+invariant+1-form"} left invariant 1-form
            %p
              Recalling (from
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/embedding+of+smooth+manifolds+into+formal+duals+of+R-algebras"} here
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              of
              %a.existingWikiWord{:href => "/nlab/show/supermanifolds"} supermanifolds
              is dually given by a reverse
              %a.existingWikiWord{:href => "/nlab/show/algebra+homomorphism"} algebra homomorphism
              between their
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/function+algebras"} function algebras
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/coordinate+functions"} coordinate functions
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 1
                        %mo ,
                        %mi d
                        %mo{:stretchy => "false"} |
                        %mstyle{:mathvariant => "bold"}
                          %mi N
                    %mo ×
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 1
                        %mo ,
                        %mi d
                        %mo{:stretchy => "false"} |
                        %mstyle{:mathvariant => "bold"}
                          %mi N
