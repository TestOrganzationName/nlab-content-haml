                  %msup
                    %mi G
                    %mo +
                %annotation{:encoding => "application/x-tex"} G^+
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spec(L)
            %a.existingWikiWord{:href => "/nlab/show/quotient+stack"} quotient stack
            of this action is the
            %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
            of (1d commutative) formal groups
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
