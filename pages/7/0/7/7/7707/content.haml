        #revision
          %p This entry is about a section of the text
          %ul
            %li
              Michel
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Demazure%2C+lectures+on+p-divisible+groups"} Demazure, lectures on p-divisible groups
              %a{:href => "http://sites.google.com/site/mtnpdivisblegroupsworkshop/lecture-notes-on-p-divisible-groups"} web
          %p
            Let
            %math#mathml_ace9b3a0b0eb7507b9e8056d8d8e81971a13c8be_1.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            be a field of prime characteristic
            = succeed "." do
              %math#mathml_ace9b3a0b0eb7507b9e8056d8d8e81971a13c8be_2.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %math#mathml_ace9b3a0b0eb7507b9e8056d8d8e81971a13c8be_3.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                %annotation{:encoding => "application/x-tex"} W
            denote the
            %span.newWikiWord
              Witt ring over Z
              %a{:href => "/nlab/new/Witt+ring+over+Z"} ?
          .num_defn
            %h6#definition Definition
            %p
              The
              %strong
                Witt ring over
                %math#mathml_ace9b3a0b0eb7507b9e8056d8d8e81971a13c8be_4.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              denoted by is defined by the coefficient extension
              = succeed "." do
                %math#mathml_ace9b3a0b0eb7507b9e8056d8d8e81971a13c8be_5.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi W
                        %mi k
                      %mo :
                      %mo =
                      %mi W
                      %msub
                        %mo ⊗
                        %mi ℤ
                      %mi k
                    %annotation{:encoding => "application/x-tex"} W_k:=W\otimes_\mathbb{Z} k
              %math#mathml_ace9b3a0b0eb7507b9e8056d8d8e81971a13c8be_6.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi W
                      %mi nk
                    %mo :
                    %mo =
                    %msub
                      %mi W
                      %mi n
                    %msub
                      %mo ⊗
                      %mi ℤ
                    %mi k
                  %annotation{:encoding => "application/x-tex"} W_{nk}:=W_n\otimes_\mathbb{Z}k
            %p
              The
              %span.newWikiWord
                phantom-components
                %a{:href => "/nlab/new/Witt+ring+over+Z"} ?
              %math#mathml_ace9b3a0b0eb7507b9e8056d8d8e81971a13c8be_7.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi W
                      %mi k
                    %mo →
                    %msub
                      %mi α
                      %mi k
                  %annotation{:encoding => "application/x-tex"} W_k\to \alpha_k
              reduce now to
              = succeed "." do
                %math#mathml_ace9b3a0b0eb7507b9e8056d8d8e81971a13c8be_8.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi a
                        %mi i
                      %msub
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mn 0
                          %mo ≤
                          %mi i
                          %mo ≤
                          %mi n
                      %mo ↦
                      %msubsup
                        %mi a
                        %mn 0
                        %mrow
                          %msup
                            %mi p
                            %mi n
                    %annotation{:encoding => "application/x-tex"} (a_i)_{0\le i\le n}\mapsto a_0^{p^n}
            %p
              Since
              %math#mathml_ace9b3a0b0eb7507b9e8056d8d8e81971a13c8be_9.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi W
                      %mi k
                    %mo =
                    %msub
                      %mi W
                      %mrow
                        %msub
                          %mi F
                          %mi p
                    %msub
                      %mo ⊗
                      %mrow
                        %msub
                          %mi F
                          %mi p
                    %mi k
                  %annotation{:encoding => "application/x-tex"} W_k=W_{F_p}\otimes_{F_p}k
              we can identify
              = succeed "," do
                %math#mathml_ace9b3a0b0eb7507b9e8056d8d8e81971a13c8be_10.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi W
                        %mi k
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi p
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} W_k^{(p)}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Frobenius+morphism"} Frobenius morphism
              %math#mathml_ace9b3a0b0eb7507b9e8056d8d8e81971a13c8be_11.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi W
                      %mi k
                  %annotation{:encoding => "application/x-tex"} W_k
              and the
              %a.existingWikiWord{:href => "/nlab/show/Frobenius+morphism"} Frobenius morphism
              becomes the endomorphism
            .maruku-equation
              %math#mathml_ace9b3a0b0eb7507b9e8056d8d8e81971a13c8be_12.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mrow
                      %mo {
                      %mrow
                        %mtable{:columnalign => "left left", :displaystyle => "false"}
                          %mtr
                            %mtd
                              %msub
                                %mi W
                                %mi k
                              %mo →
                              %msub
                                %mi W
                                %mi k
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi a
                                %mn 0
                              %mo ,
                              %mi …
                              %mo ,
                              %msub
                                %mi a
                                %mi n
                              %mo ,
                              %mi …
                              %mo{:stretchy => "false"} )
                              %mo ↦
                              %mo{:stretchy => "false"} (
                              %msubsup
                                %mi a
                                %mn 0
                                %mi p
                              %mo ,
                              %mi …
                              %mo ,
                              %msubsup
                                %mi a
                                %mi n
                                %mi p
                              %mo ,
                              %mi …
                              %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F:\begin{cases}W_k\to W_k\\(a_0,\dots,a_n,\dots)\mapsto (a_0^p,\dots,a_n^p,\dots)\end{cases}
            %p
              This is a ring morphism since since
              %math#mathml_ace9b3a0b0eb7507b9e8056d8d8e81971a13c8be_13.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              commutes with products. Similar statements are true for
              %math#mathml_ace9b3a0b0eb7507b9e8056d8d8e81971a13c8be_14.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi W
                      %mi nk
                  %annotation{:encoding => "application/x-tex"} W_{nk}
              and the affine
              = succeed "-group" do
                %math#mathml_ace9b3a0b0eb7507b9e8056d8d8e81971a13c8be_15.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math#mathml_ace9b3a0b0eb7507b9e8056d8d8e81971a13c8be_16.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Λ
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \Lambda_k
              defined in
              = succeed "." do
                %span.newWikiWord
                  Artin-Hasse exponential series
                  %a{:href => "/nlab/new/Artin-Hasse+exponential+series"} ?
          .num_prop
            %h6#proposition Proposition
            %ol
              %li
                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/Verschiebung+morphism"} Verschiebung morphism
                  of
                  %math#mathml_ace9b3a0b0eb7507b9e8056d8d8e81971a13c8be_17.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Λ
                          %mi k
                      %annotation{:encoding => "application/x-tex"} \Lambda_k
                  is given by
                  = succeed "." do
                    %math#mathml_ace9b3a0b0eb7507b9e8056d8d8e81971a13c8be_18.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ϕ
                          %mo{:stretchy => "false"} (
                          %mi t
                          %mo{:stretchy => "false"} )
                          %mo →
                          %mi ϕ
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi t
                            %mi p
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \phi(t)\to \phi(t^p)
              %li
                %p
                  The Verschiebung morphism of
                  %math#mathml_ace9b3a0b0eb7507b9e8056d8d8e81971a13c8be_19.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi K
                          %mi k
                      %annotation{:encoding => "application/x-tex"} K_k
                  is the
                  %span.newWikiWord
                    translation
                    %a{:href => "/nlab/new/Witt+ring+over+Z"} ?
                  = succeed "." do
                    %math#mathml_ace9b3a0b0eb7507b9e8056d8d8e81971a13c8be_20.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi T
                        %annotation{:encoding => "application/x-tex"} T
              %li
                %p
                  The Verschiebung morphism of
                  %math#mathml_ace9b3a0b0eb7507b9e8056d8d8e81971a13c8be_21.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi W
                          %mi nk
                      %annotation{:encoding => "application/x-tex"} W_nk
                  is
                  = succeed "." do
                    %math#mathml_ace9b3a0b0eb7507b9e8056d8d8e81971a13c8be_22.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi R
                          %mo ⋅
                          %mi T
                          %mo =
                          %mi T
                          %mo ⋅
                          %mi R
                        %annotation{:encoding => "application/x-tex"} R \cdot T=T\cdot R
              %li
                %p
                  If
                  = succeed "," do
                    %math#mathml_ace9b3a0b0eb7507b9e8056d8d8e81971a13c8be_23.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi x
                          %mo ,
                          %mi y
                          %mo ∈
                          %msub
                            %mi W
                            %mi k
                          %mo{:stretchy => "false"} (
                          %mi R
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} x,y\in W_k(R)
                  = succeed "," do
                    %math#mathml_ace9b3a0b0eb7507b9e8056d8d8e81971a13c8be_24.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi R
                          %mo ∈
                          %msub
                            %mi M
                            %mi k
                        %annotation{:encoding => "application/x-tex"} R\in M_k
                  = succeed "." do
                    %math#mathml_ace9b3a0b0eb7507b9e8056d8d8e81971a13c8be_25.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi V
                          %mo{:stretchy => "false"} (
                          %mi F
                          %mi x
                          %mo ⋅
                          %mi y
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi x
                          %mo ⋅
                          %mi V
                          %mi y
                        %annotation{:encoding => "application/x-tex"} V(F x\cdot y)=x\cdot V y
          .num_cor
            %h6#corollary Corollary
          .num_cor
            %h6#corollary_2 Corollary
          .num_cor
            %h6#corollary_3 Corollary
            %p
              Let
              %math#mathml_ace9b3a0b0eb7507b9e8056d8d8e81971a13c8be_26.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              be perfect. Then
            %ol
              %li
                %p
                  %math#mathml_ace9b3a0b0eb7507b9e8056d8d8e81971a13c8be_27.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi W
                        %mo{:stretchy => "false"} (
                        %mi k
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} W(k)
                  is a discrete valuation ring.
              %li
                %p
                  %math#mathml_ace9b3a0b0eb7507b9e8056d8d8e81971a13c8be_28.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi W
                        %mo{:stretchy => "false"} (
                        %mi k
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} W(k)
                  is complete.
              %li
                %p
                  %math#mathml_ace9b3a0b0eb7507b9e8056d8d8e81971a13c8be_29.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi W
                        %mo{:stretchy => "false"} (
                        %mi k
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} /
                        %mi p
                        %mi W
                        %mo{:stretchy => "false"} (
                        %mi k
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi k
                      %annotation{:encoding => "application/x-tex"} W(k)/p W(k)=k
          .num_prop
            %h6#proposition_2 Proposition
            %p
              (Witt) Let
              %math#mathml_ace9b3a0b0eb7507b9e8056d8d8e81971a13c8be_30.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              be perfect, let
              %math#mathml_ace9b3a0b0eb7507b9e8056d8d8e81971a13c8be_31.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              be compete, noetherian local ring with residue field
              = succeed "." do
                %math#mathml_ace9b3a0b0eb7507b9e8056d8d8e81971a13c8be_32.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math#mathml_ace9b3a0b0eb7507b9e8056d8d8e81971a13c8be_33.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mo :
                    %mi A
                    %mo →
                    %mi k
                  %annotation{:encoding => "application/x-tex"} \pi:A\to k
              be the canonical projection. There exists a unique ring morphism
            .maruku-equation
              %math#mathml_ace9b3a0b0eb7507b9e8056d8d8e81971a13c8be_34.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo :
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} u:W(k)\to A
            %p
              which is compatible with the projections
              %math#mathml_ace9b3a0b0eb7507b9e8056d8d8e81971a13c8be_35.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi k
                  %annotation{:encoding => "application/x-tex"} W(k)\to k
              and
              = succeed "." do
                %math#mathml_ace9b3a0b0eb7507b9e8056d8d8e81971a13c8be_36.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi π
                      %mo :
                      %mi A
                      %mo →
                      %mi k
                    %annotation{:encoding => "application/x-tex"} \pi:A\to k
            %p
              If moreover
              %math#mathml_ace9b3a0b0eb7507b9e8056d8d8e81971a13c8be_37.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is a discrete valuation ring with
              = succeed "," do
                %math#mathml_ace9b3a0b0eb7507b9e8056d8d8e81971a13c8be_38.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ⋅
                      %msub
                        %mn 1
                        %mi A
                      %mo ¬
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} p\cdot 1_A\not 0
              %math#mathml_ace9b3a0b0eb7507b9e8056d8d8e81971a13c8be_39.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is a free finite
              = succeed "-module" do
                %math#mathml_ace9b3a0b0eb7507b9e8056d8d8e81971a13c8be_40.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} W(k)
              = succeed "." do
                %math#mathml_ace9b3a0b0eb7507b9e8056d8d8e81971a13c8be_41.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi A
                      %mo{:stretchy => "false"} /
                      %mi p
                      %mo :
                      %mi A
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [A/p : A]
            %p
              In particular if
              = succeed "," do
                %math#mathml_ace9b3a0b0eb7507b9e8056d8d8e81971a13c8be_42.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi pA
                      %mo =
                      %mi A
                    %annotation{:encoding => "application/x-tex"} pA=A
              %math#mathml_ace9b3a0b0eb7507b9e8056d8d8e81971a13c8be_43.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                  %annotation{:encoding => "application/x-tex"} u
              is an isomorphism.
