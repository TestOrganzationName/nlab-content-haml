          %h3#InTermsOfHomologicalAlgebra For an ordinary group and abelian coefficients: In terms of homological algebra
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            be an ordinary
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/group"} group
            %a.existingWikiWord{:href => "/nlab/show/group+object"} group object
            in a
            %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒯
                %annotation{:encoding => "application/x-tex"} \mathcal{T}
            such that the
            %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ab
                  %mo{:stretchy => "false"} (
                  %mi 𝒯
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Ab(\mathcal{T})
            has
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/projective+object"} enough projectives
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is an ordinary
            %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete group
            then this means that in the ambient
            %a.existingWikiWord{:href => "/nlab/show/set+theory"} set theory
            we assume the
            %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
            or ar least the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/presentation+axiom"} presentation axiom
          %p Write then
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                  %mo{:stretchy => "false"} [
                  %mi G
                  %mo{:stretchy => "false"} ]
                  %mo ∈
                  %mi Ring
