                  %mo ≔
                  %mi ℤ
                  %mo{:stretchy => "false"} [
                  %mi G
                  %mo{:stretchy => "false"} ]
                  %mi Mod
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{A} \coloneqq \mathbb{Z}[G] Mod
          %p
            for the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                  %mo{:stretchy => "false"} [
                  %mi G
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}[G]
            %a.existingWikiWord{:href => "/nlab/show/Mod"} Mod
            of
            %a.existingWikiWord{:href => "/nlab/show/modules"} modules
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mi G
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}[G]
          %p
            Notice that a
            %a.existingWikiWord{:href => "/nlab/show/module"} module
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %mi ℤ
                  %mo{:stretchy => "false"} [
                  %mi G
                  %mo{:stretchy => "false"} ]
                  %mi Mod
                %annotation{:encoding => "application/x-tex"}
