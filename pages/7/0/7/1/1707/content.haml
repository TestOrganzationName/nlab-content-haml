            %p
              Then the degree-
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              group cohomology of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              with
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is the set
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mi Grp
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi π
                      %mn 0
                    %mi sSet
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi W
                      %mo ¯
                    %mi G
                    %mo ,
                    %mi DK
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    H^n_{Grp}(G,A) \simeq \pi_0 sSet(\overline{W}G, DK(A[n]))
            %p
              of
              %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
              of
              %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
              modulo
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+homotopy"} simplicial homotopy
          .proof
            %h6#proof Proof
            %p
              By prop.
              %a.maruku-ref{:href => "#GroupCohomologyInInfinityToposForTrivialAction"}
              the group cohomology is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mi Grp
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi π
                      %mn 0
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo ,
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^n_{Grp}(G,A) \simeq \pi_0 \mathbf{H}(\mathbf{B}G, \mathbf{B}^n A)
                    \\,.
            %p
              By assumption the relevant
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              here is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo =
                  %annotation{:encoding => "application/x-tex"} \mathbf{H} =
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
              = succeed "\u201D." do
                %a.existingWikiWord{:href => "/nlab/show/Disc%E2%88%9EGrpd"} Disc∞Grpd
              %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-category"} presented
              by the standard
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+sets"} model structure on simplicial sets
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Disc
                      %mn ∞
                      %mi Grpd
                      %mo ≃
                      %msub
                        %mi L
                        %mi whe
                      %mi sSet
                    %annotation{:encoding => "application/x-tex"} Disc\infty Grpd \simeq L_{whe} sSet
            %p
              By the discussion at
              %em
                %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              and at
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cofibrant+object"} cofibrant
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G \in \mathbf{H}
              is the standard
              %a.existingWikiWord{:href => "/nlab/show/bar+construction"} bar construction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi W
                      %mo ¯
                    %mi G
                    %mo =
                    %mrow
                      %mo (
                      %mi ⋯
                      %mo →
                      %mi G
                      %mo ×
                      %mi G
                      %mo ×
                      %mi G
                      %mover
                        %mover
                          %mo ⟶
                          %mo ⟶
                        %mo ⟶
                      %mi G
                      %mo ×
                      %mi G
                      %mover
                        %mo ⟶
                        %mo ⟶
                      %mi G
                      %mo →
                      %mo *
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\overline{W}G
                    \=
                    \\left(
                    \\cdots \to G \times G \times G
                    \\stackrel{\longrightarrow}{\stackrel{\longrightarrow}{\longrightarrow}}
                    G  \times G
                    \\stackrel{\longrightarrow}{\longrightarrow}
                    G
                    \\to
                    {*}
                    \\right)
                    \\,,
            %p
              which is equivalently the
              %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
              of the
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                      %mo ⫽
                      %mi G
                    %annotation{:encoding => "application/x-tex"} *\sslash G
            %p
              Moreover, by the discussion at
              %em
                %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan correspondence
              a presentation of the
              %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+object"} Eilenberg-MacLane object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}^n A
              is
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi DK
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi sSet
                    %annotation{:encoding => "application/x-tex"} DK(A[n]) \in sSet
              %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
              and hence a
              %a.existingWikiWord{:href => "/nlab/show/fibrant+object"} fibrant object
              in the
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              structure.
            %p
              Therefore by the discussion at
              %em
                %a.existingWikiWord{:href => "/nlab/show/derived+hom-space"} derived hom-space
              we have that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sSet
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi W
                      %mo ¯
                    %mi G
                    %mo ,
                    %mi DK
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} sSet(\overline{W}G, DK(A[n]))
              is a
              %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
              which presents the required hom-
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
              \-groupoid.
          %p
            For low values of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            it is useful and easily possible to describe these simplicial maps explicitly. This we turn to now.
          %h4#Degree1
            Degree-
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            group cohomology
          %p
            A degree-one group cocycle
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi c
                  %mo{:stretchy => "false"} ]
                  %mo ∈
                  %msubsup
                    %mi H
                    %mi Grp
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} [c] \in H^1_{Grp}(G,A)
            is just
            %a.existingWikiWord{:href => "/nlab/show/group+homomorphism"} group homomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} G \to A
            – a
            %a.existingWikiWord{:href => "/nlab/show/character"} character
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %h4#Degree2
            Degree-
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                %annotation{:encoding => "application/x-tex"} 2
            group cohomology
          %p
            We discuss here in detail and in components the special case of degree-2 group cohomology of a
            %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            with coefficients in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            an
            %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian
            %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete group
            and regarded as being equipped with the trivial
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/action"} action
          #2CocyclesAndCoboundaries.num_prop
            %h6#proposition_3 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              be a
              %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete group
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              an
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete group
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/action"} action
            %p
              Then a
              %strong
                group 2-
                %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              with coefficients in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is a
              %a.existingWikiWord{:href => "/nlab/show/function"} function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo{:lspace => "verythinmathspace"} :
                    %mi G
                    %mo ×
                    %mi G
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    c \colon G \times G \to A
            %p
              such that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 1
                    %mo ,
                    %msub
                      %mi g
                      %mn 2
                    %mo ,
                    %msub
                      %mi g
                      %mn 3
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi G
                    %mo ×
                    %mi G
                    %mo ×
                    %mi G
                  %annotation{:encoding => "application/x-tex"} (g_1, g_2, g_3) \in G \times G \times G
              it satisfies the
              %a.existingWikiWord{:href => "/nlab/show/equation"} equation
            #eq:2CocycleConditionForCentralExtension.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 1
                    %mo ,
                    %msub
                      %mi g
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mi c
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 1
                    %mo ,
                    %msub
                      %mi g
                      %mn 2
                    %mo ⋅
                    %msub
                      %mi g
                      %mn 3
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi c
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 1
                    %mo ⋅
                    %msub
                      %mi g
                      %mn 2
                    %mo ,
                    %msub
                      %mi g
                      %mn 3
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mi c
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 2
                    %mo ,
                    %msub
                      %mi g
                      %mn 3
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    c(g_1, g_2)
                    \-
                    c(g_1, g_2 \cdot g_3)
                    +
                    c(g_1 \cdot g_2, g_3)
                    \-
                    c(g_2, g_3)
                    \=
                    0
                    \\;\;\;\; \in A
            %p
              (called the
              = succeed ")." do
                %strong group 2-cocycle condition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ,
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} c, \tilde c
              two such cocycles, a
              %strong
                %a.existingWikiWord{:href => "/nlab/show/coboundary"} coboundary
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo{:lspace => "verythinmathspace"} :
                    %mi c
                    %mo →
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} h \colon c \to \tilde c
              between them is a
              %a.existingWikiWord{:href => "/nlab/show/function"} function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo{:lspace => "verythinmathspace"} :
                    %mi G
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    h \colon G \to A
            %p
              such that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 1
                    %mo ,
                    %msub
                      %mi g
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi G
                    %mo ×
                    %mi G
                  %annotation{:encoding => "application/x-tex"} (g_1,g_2) \in G \times G
              the
              %a.existingWikiWord{:href => "/nlab/show/equation"} equation
            #eq:Group2CoboundaryEquation.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 1
                    %mo ,
                    %msub
                      %mi g
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi c
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 1
                    %mo ,
                    %msub
                      %mi g
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mi h
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 1
                    %mo ,
                    %msub
                      %mi g
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde c(g_1,g_2)
                    \=
                    c(g_1,g_2) + (d h)(g_1,g_2)
            %p
              holds in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mi h
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 1
                    %mo ,
                    %msub
                      %mi g
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi h
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 1
                    %msub
                      %mi g
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mi h
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mi h
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (d h)(g_1, g_2) \coloneqq h(g_1 g_2) - h(g_1) - h(g_2)
            %p
              is the
              %strong group 2-coboundary
              encoded by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                    %annotation{:encoding => "application/x-tex"} h
            %p
              The degree-2
              %strong group cohomology
              is the set
            .maruku-equation
