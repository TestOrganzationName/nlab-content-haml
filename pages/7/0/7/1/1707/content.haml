              %blockquote
                %p
                  (in the context of
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/algebraic+cycles"} algebraic cycles
          %p
            and specifically with an eye towards cohomology of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/finite+groups"} finite groups
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Atiyah"}> Michael Atiyah
                ,
                = succeed "," do
                  %em Characters and cohomology of finite groups
                = succeed ")" do
                  %a{:href => "http://www.numdam.org/item?id=PMIHES_1961__9__23_0"} Numdam
            %li#AM04finite
              %p
                %a.existingWikiWord{:href => "/nlab/show/Alejandro+Adem"}> Alejandro Adem
                ,
