                      %mo ,
                      %mi e
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi e
                    %annotation{:encoding => "application/x-tex"} \tilde c(e,e) = e
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                    %annotation{:encoding => "application/x-tex"} c
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
