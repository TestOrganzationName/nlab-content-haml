                          %mn 0
                    %mo )
                  %mo ,
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi σ
                    %mn 2
                  %mo ≔
                  %mrow
                    %mo (
                    %mtable{:columnalign => "center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mn 0
                        %mtd
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mi{:mathvariant => "normal"} i
                      %mtr
                        %mtd
