                        %mtd
                          %mn 0
                    %mo )
                  %mo ,
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi σ
                    %mn 3
                  %mo ≔
                  %mrow
                    %mo (
                    %mtable{:columnalign => "center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mn 1
                        %mtd
                          %mn 0
                      %mtr
                        %mtd
