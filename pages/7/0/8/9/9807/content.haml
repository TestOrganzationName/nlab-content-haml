              %a.existingWikiWord{:href => "/nlab/show/action"} action
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi E
                    %mi G
                  %annotation{:encoding => "application/x-tex"} X \times E G
              is
              %a.existingWikiWord{:href => "/nlab/show/free+action"} free
              (since the action on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
