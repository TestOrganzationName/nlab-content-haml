                        \\;=\;
                        d_{dR}
                        +
                        r^a \iota_{v^a}
                        \\,.
          %p
            This is the
            %em Mathai-Quillen isomorphism
            (
            %a{:href => "#MathaiQuillen86"}> Mathai-Quillen 86, around (5.9)
            ).
          .proof
            %h6#proof Proof
            %p
              Observe that the operator
              %a.maruku-eqref{:href => "#eq:ExponentialProjectionOperator"} (12)
              is equal to the product
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo :
                    %mi exp
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mi θ
                      %mi a
                    %msub
                      %mi ι
                      %mi a
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo :
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi id
                    %mo −
                    %msup
                      %mi θ
                      %mn 1
                    %msub
                      %mi ι
                      %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi id
                    %mo −
                    %msup
                      %mi θ
                      %mn 2
                    %msub
                      %mi ι
                      %mn 2
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mi ⋯
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi id
                    %mo −
                    %msup
                      %mi θ
                      %mrow
                        %mi dim
                        %mo{:stretchy => "false"} (
                        %mi 𝔤
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi ι
                      %mrow
                        %mi dim
                        %mo{:stretchy => "false"} (
                        %mi 𝔤
                        %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \:
                    \\exp
                    \\big(
                    \- \theta^a \iota_a
                    \\big)
                    \:
                    \\;=\;
                    \\big(
                    id - \theta^1 \iota_1
                    \\big)
                    \\big(
                    id - \theta^2 \iota_2
                    \\big)
                    \\cdots
                    \\big(
                    id - \theta^{dim(\mathfrak{g})} \iota_{dim(\mathfrak{g})}
                    \\big)
                    \\,.
            %p
              Here all factors commute with each other, and each factor is itself a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/projection+operator"} projection operator
              %a.existingWikiWord{:href => "/nlab/show/image"} image
              the
              %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
              of the corresponding single contraction operator, e.g.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi im
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mn 1
                    %mo −
                    %msup
                      %mi θ
                      %mn 1
                    %msub
                      %mi ι
                      %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi ker
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi ι
                      %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    im
                    \\big(
                    1 - \theta^1 \iota_1
                    \\big)
                    \\;\simeq\;
                    ker\big( \iota_1\big)
            %p etc.
            %p Hence the joint image is the joint kernel of the contraction operators.
            %p
              It is clear by inspection that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                  %annotation{:encoding => "application/x-tex"} \epsilon
              in
              %a.maruku-eqref{:href => "#eq:IsomorphismWeilToCartanModel"} (14)
              is a
              %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear
              %a.existingWikiWord{:href => "/nlab/show/inverse+function"} inverse
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo :
                      %mi exp
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msup
                        %mi θ
                        %mi a
                      %msub
                        %mi ι
                        %mi a
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mo :
                    %annotation{:encoding => "application/x-tex"} : \exp\big( - \theta^a \iota_a\big) :
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                  %annotation{:encoding => "application/x-tex"} \epsilon
              is manifestly an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/algebra+homomorphism"} algebra homomorphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo :
                      %mi exp
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msup
                        %mi θ
                        %mi a
                      %msub
                        %mi ι
                        %mi a
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mo :
                    %annotation{:encoding => "application/x-tex"} : \exp\big( - \theta^a \iota_a\big) :
            %p
              This implies that the induced differential
              %a.maruku-eqref{:href => "#eq:InducedDifferentialOnCartanModel"} (16)
              is a graded
              %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
              and hence that it may be identified by its action on generators. Direct inspection indeed yields
            %p
              for all generators
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi r
                      %mi a
                  %annotation{:encoding => "application/x-tex"} r^a
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi ϵ
                            %mo ∘
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %msub
                              %mi d
                              %mi dR
                            %mo +
                            %msub
                              %mi d
                              %mi W
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %mo ∘
                            %mo :
                            %mi exp
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msup
                              %mi θ
                              %mi a
                            %msub
                              %mi ι
                              %mi a
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %mo :
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %msup
                              %mi r
                              %mi a
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mtd
                            %mo =
                            %mn 0
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %msub
                              %mi d
                              %mi dR
                            %mo +
                            %msup
                              %mi r
                              %mi a
                            %msub
                              %mi ι
                              %mrow
                                %msup
                                  %mi v
                                  %mi a
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi r
                              %mi a
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\epsilon
                    \\circ
                    \\big( d_{dR} + d_W\big)
                    \\circ
                    \: \exp\big(  -\theta^a \iota_a \big) :
                    \\big(
                    r^a
                    \\big)
                    \&amp; = 0
                    \\\
                    \&amp; =
                    \\big( d_{dR} + r^a \iota_{v^a} \big) ( r^a )
                    \\end{aligned}
            %p
              and for all differential forms
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ω
                      %mo ∈
                      %msup
                        %mi Ω
                        %mo •
