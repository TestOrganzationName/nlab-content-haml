                  to zero
                #eq:WeilAugmentationOverCartan.maruku-equation
                  %span.maruku-eq-number (15)
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
