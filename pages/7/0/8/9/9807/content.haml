                  a
                  = succeed "-" do
                    %a.existingWikiWord{:href => "/nlab/show/dgc-algebra"} dgc-algebra
                  %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
                  and hence in particular a
                  %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
                  is
                #eq:InducedDifferentialOnCartanModel.maruku-equation
                  %span.maruku-eq-number (16)
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϵ
                        %mo ∘
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %msub
                          %mi d
                          %mi dR
                        %mo +
                        %msub
                          %mi d
                          %mi W
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mo ∘
                        %mo :
                        %mi exp
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %msup
                          %mi θ
                          %mi a
                        %msub
