                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mi 𝔤
                          %mo ,
                          %mo{:stretchy => "false"} [
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo ,
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} ]
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %annotation{:encoding => "application/x-tex"} \big(\mathfrak{g}, [-,-]\big)
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ×
                        %mi G
                        %mover
                          %mo ⟶
                          %mi ρ
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X \times G \overset{\rho}{\longrightarrow} X
                  a
                  %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth
                  %a.existingWikiWord{:href => "/nlab/show/action"} action
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                  on
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
            %p
              Often this data is called a
              = succeed "," do
                %em
                  smooth
                  = succeed "-manifold" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
          %h3#Models Models
          %p
            Given a smooth
            = succeed "-manifold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            (Def.
            = succeed ")" do
              %a.maruku-ref{:href => "#SmoothGManifold"}
            %a.existingWikiWord{:href => "/nlab/show/dg-algebras"} dg-algebras
            are used to model the corresponding
            = succeed "-equivariant" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %ul
            %li
              %p
                %em
                  %a{:href => "#TheWeilModel"} the Weil model
            %li
              %p
                %em
                  %a{:href => "#TheCartanModel"} the Cartan model
            %li
              %p
                %em the BRST/Kalkman model
          %h4#TheWeilModel The Weil model
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi W
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msub
                    %mi d
                    %mi W
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"} \big( W(\mathfrak{g}), d_W \big)
            denote the
            %a.existingWikiWord{:href => "/nlab/show/Weil+algebra"} Weil algebra
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi t
                    %mi a
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{t_a\}
            is a
            %a.existingWikiWord{:href => "/nlab/show/linear+basis"} linear basis
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
          #eq:LinearBasisForG.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mi span
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi t
                    %mi a
                  %mo{:stretchy => "false"} }
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathfrak{g}
                  \\;=\;
                  span\big(  \{t_a\} \big)
          %p
            with induced structure constants for the
            %a.existingWikiWord{:href => "/nlab/show/Lie+bracket"} Lie bracket
            being
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                  %msubsup
                    %mi f
                    %mrow
                      %mi b
                      %mi c
                    %mi a
                  %msub
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                    %mrow
                      %mi a
                      %mo ,
                      %mi b
                      %mo ,
                      %mi c
                %annotation{:encoding => "application/x-tex"} \big\{f_{b c}^a\big\}_{a,b,c}
          #eq:StructureConstants.maruku-equation
            %span.maruku-eq-number (2)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi t
                    %mi a
                  %mo ,
                  %msub
                    %mi t
                    %mi b
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %msubsup
                    %mi f
                    %mrow
                      %mi a
                      %mi b
                    %mi c
                  %msup
                    %mi t
                    %mi b
                  %mo ∧
                  %msup
                    %mi t
                    %mi c
                %annotation{:encoding => "application/x-tex"}
                  [t_a, t_b] \;=\; f_{a b}^c t^b \wedge t^c
          %p
            (using the
            %a.existingWikiWord{:href => "/nlab/show/Einstein+summation+convention"} Einstein summation convention
            throughout)
          %p
            then the
            %a.existingWikiWord{:href => "/nlab/show/Weil+algebra"} Weil algebra
            is the
            %a.existingWikiWord{:href => "/nlab/show/dgc-algebra"} dgc-algebra
            explicitly given by
            %a.existingWikiWord{:href => "/nlab/show/generators+and+relations"} generators and relations
            as follows:
          #eq:ExplicitWeilAlgebra.maruku-equation
            %span.maruku-eq-number (3)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mi ℝ
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                  %mo{:stretchy => "false"} {
                  %munder
                    %munder
                      %mrow
                        %msup
                          %mi t
                          %mi a
                      %mo ⏟
                    %mrow
                      %mi deg
                      %mo =
                      %mn 1
                  %msub
                    %mo{:stretchy => "false"} }
                    %mi a
                  %mo ,
                  %mo{:stretchy => "false"} {
                  %munder
                    %munder
                      %mrow
                        %msup
                          %mi r
                          %mi a
                      %mo ⏟
                    %mrow
                      %mi deg
                      %mo =
                      %mn 2
                  %msub
                    %mo{:stretchy => "false"} }
                    %mi a
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} /
                  %mrow
                    %mo (
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi d
                              %mi W
                            %mspace{:width => "thinmathspace"}
                            %msup
                              %mi t
                              %mi a
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mn 2
                            %msubsup
                              %mi f
                              %mrow
                                %mi b
                                %mi c
                              %mi a
                            %msup
                              %mi t
                              %mi b
                            %mo ∧
                            %msup
                              %mi t
                              %mi c
                            %mo +
                            %msup
                              %mi r
                              %mi a
                        %mtr
                          %mtd
                            %msub
                              %mi d
                              %mi W
                            %mspace{:width => "thinmathspace"}
                            %msup
                              %mi r
                              %mi a
                          %mtd
                            %mo =
                            %msubsup
                              %mi f
                              %mrow
                                %mi b
                                %mi c
                              %mi a
                            %msup
                              %mi t
                              %mi b
                            %mo ∧
                            %msup
                              %mi r
                              %mi c
                    %mo )
                %annotation{:encoding => "application/x-tex"}
                  W(\mathfrak{g})
                  \\;\coloneqq\;
                  \\mathbb{R}\big[
                  \\{
                  \\underset
                  { deg = 1 }
                  {
                  \\underbrace{ t^a }
                  }
                  \\}_a,
                  \\{
                  \\underset
                  { deg = 2 }
                  {
                  \\underbrace{ r^a }
                  }
                  \\}_a
                  \\big]
                  \\Big/
                  \\left(
                  \\begin{aligned}
                  d_W \, t^a &amp; =  - \tfrac{1}{2}f^a_{b c} t^b \wedge t^c + r^a
                  \\\
                  d_W \, r^a &amp; = f^a_{b c} t^b \wedge r^c
                  \\end{aligned}
                  \\right)
          %p
            Now consider the
            %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+algebras"} tensor product of
            %a.existingWikiWord{:href => "/nlab/show/dgc-algebras"} dgc-algebras
            of the
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+algebra"} de Rham algebra
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            with the
            %a.existingWikiWord{:href => "/nlab/show/Weil+algebra"} Weil algebra
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
          #eq:TensorProductOfdeRhamAlgebraWithWeilAlgebra.maruku-equation
            %span.maruku-eq-number (4)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                  %msup
                    %mi Ω
                    %mo •
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi X
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mo ⊗
                  %mi W
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi d
                    %mi dR
                  %mo +
                  %msub
                    %mi d
                    %mi W
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\Big(
                  \\Omega^\bullet
                  \\big(
                  X
                  \\big)
                  \\otimes
                  W(\mathfrak{g}),
                  \\,
                  d_{dR} + d_W
                  \\Big)
                  \\,.
          %p
            On this consider the following joint
            %a.existingWikiWord{:href => "/nlab/show/Cartan+calculus"} Cartan calculus
            operations: for each basis element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi t
                    %mi a
                %annotation{:encoding => "application/x-tex"} t_a
            %a.maruku-eqref{:href => "#eq:LinearBasisForG"} (1)
            a graded
            %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
            of degree -1 (contraction)
          #eq:WeilModelContractionOperation.maruku-equation
            %span.maruku-eq-number (5)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ι
                    %mi a
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                  %mi Ω
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi X
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mo ⊗
                  %mi W
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %msup
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                    %mo •
                  %mo ⟶
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                  %mi Ω
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi X
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mo ⊗
                  %mi W
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %msup
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                    %mrow
                      %mo •
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                %annotation{:encoding => "application/x-tex"}
                  \\iota_a
                  \\;\colon\;
                  \\Big(
                  \\Omega
                  \\big(
                  X
                  \\big)
                  \\otimes
                  W(\mathfrak{g})
                  \\Big)^{\bullet}
                  \\longrightarrow
                  \\Big(
                  \\Omega
                  \\big(
                  X
                  \\big)
                  \\otimes
                  W(\mathfrak{g})
                  \\Big)^{\bullet - 1 }
          %p
            and a graded derivation of degree 0 (generalized
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Lie+derivative"} Lie derivative
          #eq:WeilModelLieDerivative.maruku-equation
            %span.maruku-eq-number (6)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℒ
                    %mi a
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                  %mi Ω
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi X
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mo ⊗
                  %mi W
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %msup
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                    %mo •
                  %mo ⟶
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                  %mi Ω
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi X
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mo ⊗
                  %mi W
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %msup
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                    %mo •
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{L}_a
                  \\;\colon\;
                  \\Big(
                  \\Omega
                  \\big(
                  X
                  \\big)
                  \\otimes
                  W(\mathfrak{g})
                  \\Big)^\bullet
                  \\longrightarrow
                  \\Big(
                  \\Omega
                  \\big(
                  X
                  \\big)
                  \\otimes
                  W(\mathfrak{g})
                  \\Big)^{\bullet}
          %p
            defined on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                  %mo ∈
                  %msup
                    %mi Ω
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \omega \in \Omega^\bullet(X)
            any
            %a.existingWikiWord{:href => "/nlab/show/differential+form"} differential form
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi t
                    %mi a
                  %mo ,
                  %msup
