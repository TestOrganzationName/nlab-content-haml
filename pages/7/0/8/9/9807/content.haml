                    %mi a
                %annotation{:encoding => "application/x-tex"} t^a, r^a
            as in
            %a.maruku-eqref{:href => "#eq:ExplicitWeilAlgebra"} (3)
            as follows
          #eq:WeilModelContractionOnGenerators.maruku-equation
            %span.maruku-eq-number (7)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ι
                    %mi a
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mrow
                    %mo {
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi ω
                          %mtd
                            %mo ↦
                            %msub
                              %mi ι
                              %mrow
                                %msup
                                  %mi v
                                  %mi a
                            %mi ω
                        %mtr
                          %mtd
                            %msup
                              %mi t
                              %mi b
                          %mtd
                            %mo ↦
                            %msubsup
                              %mi δ
                              %mi b
                              %mi a
                        %mtr
                          %mtd
                            %msup
                              %mi r
