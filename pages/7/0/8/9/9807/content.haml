                            %mo ↦
                            %msubsup
                              %mi f
                              %mrow
                                %mi a
                                %mi c
                              %mi b
                            %msup
                              %mi t
                              %mi c
                        %mtr
                          %mtd
                            %msup
                              %mi r
                              %mi b
                          %mtd
                            %mo ↦
                            %msubsup
                              %mi f
                              %mrow
                                %mi a
                                %mi c
                              %mi b
                            %msup
                              %mi r
                              %mi c
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{L}_a
                  \\;\colon\;
                  \\left\{
                  \\begin{aligned}
                  \\omega &amp; \mapsto \mathcal{L}_{v^a} \omega
                  \\\
                  t^b &amp;\mapsto f_{a c}^b t^c
                  \\\
                  r^b &amp; \mapsto f_{a c}^b r^c
                  \\end{aligned}
                  \\right.
          %p where
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
