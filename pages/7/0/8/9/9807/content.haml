            %p
              By the ordinary
              %a.existingWikiWord{:href => "/nlab/show/de+Rham+theorem"} de Rham theorem
              the image of the smooth manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              in dgc-algebra
              %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+theory"} rational homotopy theory
              (with
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/real+number"} real number
              = succeed ")" do
