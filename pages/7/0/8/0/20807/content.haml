          %h2#idea Idea
          %p
            A
            %em fuzzy sphere
            is a variant of an
            %a.existingWikiWord{:href => "/nlab/show/n-sphere"} n-sphere
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/noncommutative+geometry"} noncommutative geometry
            %em
              %a.existingWikiWord{:href => "/nlab/show/2-sphere"} 2-sphere
            is meant by default, but there are also fuzzy spheres of higher dimension.
          %h2#definition Definition
          %h3#Fuzzy2SphereDefinition Fuzzy 2-sphere
          %p
            For
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mo ≤
                    %mi N
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} 2 \leq N \in \mathbb{N}
            %em fuzzy 2-sphere
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            “bits” is the
            %a.existingWikiWord{:href => "/nlab/show/formal+duality"} formal dual
            to the
            %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
            which is the sub-algebra in the
            %a.existingWikiWord{:href => "/nlab/show/matrix+algebra"} matrix algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Mat
                    %mrow
                      %mi N
                      %mo ×
                      %mi N
                %annotation{:encoding => "application/x-tex"} Mat_{N \times N}
            generated from the elements of the
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
            %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex
            %a.existingWikiWord{:href => "/nlab/show/irreducible+representation"} irreducible
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+representation"} Lie algebra representation
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/su%282%29"} su(2)
          %p We now say this more in detail:
          %h4#ConventionsAndNormalizations Conventions and Normalizations
          %p First to introduce relevant notation and to set out the proper choices of normalizations.
          %p
            %br/
          %p
            With
            %a.existingWikiWord{:href => "/nlab/show/su%282%29"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔰𝔲
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{su}(2)
            the
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/SU%282%29"} SU(2)
            %a.existingWikiWord{:href => "/nlab/show/complexification"} complexification
            is the
            %a.existingWikiWord{:href => "/nlab/show/special+linear+Lie+algebra"} special linear Lie algebra
            %a.existingWikiWord{:href => "/nlab/show/sl%282%29"} sl(2)
            (see
            = succeed ")" do
              %a{:href => "su2#Complexification"} here
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔰𝔲
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ⊗
                    %mi ℝ
                  %mi ℂ
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %mi 𝔰𝔩
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo ,
                  %mi ℂ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\mathfrak{su}(2) \otimes_{\mathbb{R}} \mathbb{C}
                  \\;\simeq\;
                  \\mathfrak{sl}(2,\mathbb{C})
                  \\,,
          %p write
          #eq:CanonicalBasisOfsu2C.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi σ
                    %mi i
                  %mspace{:width => "thickmathspace"}
                  %mo ∈
                  %mspace{:width => "thickmathspace"}
                  %mi 𝔰𝔲
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ⊗
                    %mi ℝ
                  %mi ℂ
                  %mo ,
                  %mphantom
                    %mi AAA
                  %mi i
                  %mo ∈
                  %mo{:stretchy => "false"} {
                  %mn 1
                  %mo ,
                  %mn 2
                  %mo ,
                  %mn 3
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"}
                  \\sigma_i
                  \\;\in\;
                  \\mathfrak{su}(2) \otimes_{\mathbb{R}} \mathbb{C}
                  ,
                  \\phantom{AAA}
                  i \in \{1,2,3\}
          %p
            for a choice of
            %a.existingWikiWord{:href => "/nlab/show/linear+basis"} linear basis
            such that the
            %a.existingWikiWord{:href => "/nlab/show/Lie+bracket"} Lie bracket
            takes the form
          #eq:CommutationRelationsu2.maruku-equation
            %span.maruku-eq-number (2)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi σ
                    %mi i
                  %mo ,
                  %msub
                    %mi σ
                    %mi j
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mi i
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi k
                  %msub
                    %mi ϵ
                    %mrow
                      %mi i
                      %mi j
                      %mi k
                  %msub
                    %mi σ
                    %mi k
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  [\sigma_i, \sigma_j]
                  \\;=\;
                  i \underset{k}{\sum} \epsilon_{i j k} \sigma_k
                  \\,.
          %p
            (Here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϵ
                %annotation{:encoding => "application/x-tex"} \epsilon
            is the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Levi-Civita+symbol"} Levi-Civita symbol
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ϵ
                    %mrow
                      %mi σ
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi σ
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                      %mi σ
                      %mo{:stretchy => "false"} (
                      %mn 3
                      %mo{:stretchy => "false"} )
                  %mo ∈
                  %mo{:stretchy => "false"} {
                  %mo ±
                  %mn 1
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \epsilon_{\sigma(1), \sigma(2)\sigma(3)} \in \{\pm 1\}
            is the
            %a.existingWikiWord{:href => "/nlab/show/signature+of+a+permutation"} signature
            of the
            %a.existingWikiWord{:href => "/nlab/show/permutation"} permutation
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo ∈
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mn 3
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sigma \in Sym(3)
          %p Notice that the element
          #eq:TheUnrepresentedR2.maruku-equation
            %span.maruku-eq-number (3)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi i
                  %msub
                    %mi σ
                    %mi i
                  %mo ⋅
                  %msub
                    %mi σ
                    %mi i
                  %mspace{:width => "thickmathspace"}
                  %mo ∈
                  %mspace{:width => "thickmathspace"}
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi 𝔰𝔲
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\underset{i}{\sum}
                  \\sigma_i \cdot \sigma_i
                  \\;\in\;
                  U(\mathfrak{su}(2))
          %p
            is a
            %a.existingWikiWord{:href => "/nlab/show/Casimir+element"} Casimir element
            in the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/universal+enveloping+algebra"} universal enveloping algebra
          %p Let then
          #eq:TheNDimensionalRepresentation.maruku-equation
            %span.maruku-eq-number (4)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi 𝔰𝔲
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %msub
                    %mi Mat
                    %mrow
                      %mi N
                      %mo ×
                      %mi N
                %annotation{:encoding => "application/x-tex"}
                  \\rho
                  \\;\colon\;
                  \\mathfrak{su}(2)
                  \\longrightarrow
                  Mat_{N \times N}
          %p
            denote
            %a.existingWikiWord{:href => "/nlab/show/generalized+the"} the
            %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimensional
            %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex
            %a.existingWikiWord{:href => "/nlab/show/irreducible+representation"} irreducible
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+representation"} Lie algebra representation
            of
            %a.existingWikiWord{:href => "/nlab/show/su%282%29"} su(2)
            (hence of
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔰𝔩
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo ,
                    %mi ℂ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{sl}(2,\mathbb{C})
          %p
            In the discussion of
            %a.existingWikiWord{:href => "/nlab/show/angular+momentum"} angular momentum
            in
            %a.existingWikiWord{:href => "/nlab/show/quantum+mechanics"} quantum mechanics
            the image
          #eq:TheUnnormalizedR2.maruku-equation
            %span.maruku-eq-number (5)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi i
                  %msub
                    %mi ρ
                    %mi i
                  %mo ∘
                  %msub
                    %mi ρ
                    %mi i
                  %mspace{:width => "thickmathspace"}
                  %mo ∈
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi Mat
                    %mrow
                      %mi N
                      %mo ×
                      %mi N
                %annotation{:encoding => "application/x-tex"}
                  \\underset{i}{\sum}
                  \\rho_i \circ \rho_i
                  \\;\in\;
                  Mat_{N \times N}
          %p
            of the
            %a.existingWikiWord{:href => "/nlab/show/Casimir+element"} Casimir element
            %a.maruku-eqref{:href => "#eq:TheUnrepresentedR2"} (3)
            under the representation
            %a.maruku-eqref{:href => "#eq:TheNDimensionalRepresentation"} (4)
            is traditionally denoted
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi J
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} J^2
            %a.existingWikiWord{:href => "/nlab/show/linear+basis"} linear basis
            for the N-dimensional representation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                %annotation{:encoding => "application/x-tex"} \rho
            %a.maruku-eqref{:href => "#eq:TheNDimensionalRepresentation"} (4)
            is then traditionally denoted
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                    %mrow
                      %mo |
                      %mi j
                      %mo ,
                      %mi m
                      %mo ⟩
                    %msubsup
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                      %mrow
                        %mi m
                        %mo =
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi j
                      %mrow
                        %mi m
                        %mo =
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mi j
                  %annotation{:encoding => "application/x-tex"} \big\{\left\vert j, m \right\rangle\big\}_{m = -j}^{m = +j}
          #eq:EigenvaluesOfCasimir.maruku-equation
            %span.maruku-eq-number (6)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi J
                    %mn 2
                  %mrow
                    %mo |
                    %mi j
                    %mo ,
                    %mi m
                    %mo ⟩
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mi j
                  %mo{:stretchy => "false"} (
                  %mi j
                  %mo +
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mphantom
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo −
                  %mtext for
                  %mphantom
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi m
                  %mo ∈
                  %mo{:stretchy => "false"} {
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi j
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi j
                  %mo +
                  %mn 1
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %mi j
                  %mo −
                  %mn 1
                  %mo ,
                  %mi j
                  %mo{:stretchy => "false"} }
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  J^2 \left\vert j,m \right\rangle \;=\; j(j+1)
                  \\phantom{--}
                  \\text{for}
                  \\phantom{-}
                  m \in \{-j, -j+1, \cdots, j-1, j\}
                  \\,,
          %p hence with
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo{:stretchy => "false"} (
                  %mi j
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo =
                  %mspace{:width => "thinmathspace"}
                  %mn 2
                  %mi j
                  %mo +
                  %mn 1
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ⇔
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi j
                  %mo{:stretchy => "false"} (
                  %mi N
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo =
                  %mspace{:width => "thinmathspace"}
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mn 2
                  %mo{:stretchy => "false"} (
                  %mi N
                  %mo −
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  N(j) \,=\, 2 j + 1
                  \\;\;
                  \\Leftrightarrow
                  \\;\;
                  j(N) \,=\, \tfrac{1}{2}(N - 1)
                  \\,.
          %p
            This means that the
            %a.existingWikiWord{:href => "/nlab/show/eigenvalues"} eigenvalues
            of
            %a.maruku-eqref{:href => "#eq:TheUnnormalizedR2"} (5)
            as a function not of the
            %a.existingWikiWord{:href => "/nlab/show/angular+momentum"} angular momentum
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                %annotation{:encoding => "application/x-tex"} j
            but of the
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            of the given
            %a.existingWikiWord{:href => "/nlab/show/irreducible+representation"} irreducible representation
            are:
          #eq:EigenvaluesOfCasimir.maruku-equation
            %span.maruku-eq-number (7)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mi j
                          %mo{:stretchy => "false"} (
                          %mi N
                          %mo{:stretchy => "false"} )
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mi j
                          %mo{:stretchy => "false"} (
                          %mi N
                          %mo{:stretchy => "false"} )
                          %mo +
                          %mn 1
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mtd
                          %mo =
                          %mphantom
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                              %mspace{:width => "thickmathspace"}
                          %mo{:stretchy => "false"} (
                          %mi j
                          %mo{:stretchy => "false"} (
                          %mi N
                          %mo{:stretchy => "false"} )
                          %msup
                            %mo{:stretchy => "false"} )
                            %mn 2
                          %mo +
                          %mi j
                          %mo{:stretchy => "false"} (
                          %mi N
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %mphantom
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                              %mspace{:width => "thickmathspace"}
                          %mstyle{:displaystyle => "false"}
                            %mfrac
                              %mn 1
                              %mn 4
                          %mo{:stretchy => "false"} (
                          %mi N
                          %mo −
                          %mn 1
                          %msup
                            %mo{:stretchy => "false"} )
                            %mn 2
                          %mo +
                          %mstyle{:displaystyle => "false"}
                            %mfrac
                              %mn 1
                              %mn 2
                          %mo{:stretchy => "false"} (
                          %mi N
                          %mo −
                          %mn 1
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
