            under this representation is the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/identity+matrix"} identity matrix
          #eq:RadiusOfFuzzy2Sphere.maruku-equation
            %span.maruku-eq-number (10)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
