            %a.maruku-eqref{:href => "#eq:CommutationRelationsu2"} (2)
            in this representation reads
          #eq:NormalizedCommutationforsu2.maruku-equation
            %span.maruku-eq-number (9)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi X
                    %mi i
                  %mo ,
                  %msub
                    %mi X
                    %mi j
                  %mo{:stretchy => "false"} ]
