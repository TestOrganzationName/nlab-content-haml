              %a{:href => "https://arxiv.org/abs/2309.00576"}> arXiv:2309.00576
              \&amp;rbrack;
          %h3#fuzzy_4sphere Fuzzy 4-sphere
          %p
            The
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/fuzzy+4-sphere"} fuzzy 4-sphere
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Harald+Grosse"}> Harald Grosse
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ctirad+Klimcik"} Ctirad Klimcik
                = succeed "," do
                  %em On Finite 4D Quantum Field Theory in Non-Commutative Geometry
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/9602115"} arXiv:hep-th/9602115
            %li
              %p
