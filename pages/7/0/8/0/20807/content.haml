            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+weight+systems"} Lie algebra weight systems
            on
            %a.existingWikiWord{:href => "/nlab/show/chord+diagrams"} chord diagrams
            computing
            %a.existingWikiWord{:href => "/nlab/show/radii"} radii
            averages of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/fuzzy+spheres"} fuzzy spheres
          %ul
            %li#RamgoolamSpenceThomas04
              %p
                %a.existingWikiWord{:href => "/nlab/show/Sanyaje+Ramgoolam"}> Sanyaje Ramgoolam
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Bill+Spence"} Bill Spence
                = succeed "," do
                  %em
                    Resolving brane collapse with
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn 1
                          %mo{:stretchy => "false"} /
                          %mi N
                        %annotation{:encoding => "application/x-tex"} 1/N
                    corrections in non-Abelian DBI
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/0405256"} arxiv:hep-th/0405256
            %li#McNamaraPapageorgakis05
              %p
                %a.existingWikiWord{:href => "/nlab/show/Simon+McNamara"}> Simon McNamara
                ,
