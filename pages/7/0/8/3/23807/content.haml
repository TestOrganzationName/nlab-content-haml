          %h2#idea Idea
          %p
            In the same vein that
            %a.existingWikiWord{:href => "/nlab/show/commutative+rings"} commutative rings
            are to
            %a.existingWikiWord{:href => "/nlab/show/integral+domains"} integral domains
            and
            %a.existingWikiWord{:href => "/nlab/show/GCD+rings"} GCD rings
            are to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/GCD+domains"} GCD domains
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/field+of+fractions"} field of fractions
          %h2#definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is a subset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo ⊆
                  %mi R
                %annotation{:encoding => "application/x-tex"} S \subseteq R
            with an injection
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo :
                    %mi S
                    %mo ↪
                    %mi R
                  %annotation{:encoding => "application/x-tex"} m:S \hookrightarrow R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mn 1
                    %mi S
                  %mo ∈
                  %mi S
                %annotation{:encoding => "application/x-tex"} 1_S \in S
            and a function
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⋅
                      %mi S
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi S
                    %mo ×
                    %mi S
                    %mo →
                    %mi S
                  %annotation{:encoding => "application/x-tex"} (-)\cdot_S(-):S \times S \to S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                  %mo{:stretchy => "false"} (
                  %msub
                    %mn 1
                    %mi S
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} m(1_S) = 1
            and for all elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ∈
                  %mi S
                %annotation{:encoding => "application/x-tex"} a \in S
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %mi S
                  %annotation{:encoding => "application/x-tex"} b \in S
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi a
                    %msub
                      %mo ⋅
                      %mi S
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} s(a \cdot_S b) = s(a) \cdot s(b)
            %a.existingWikiWord{:href => "/nlab/show/localization+of+a+commutative+ring"} localization
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            away from a multiplicative submonoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is the
            %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial
            commutative ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi S
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} R[S^{-1}]
            with a commutative ring homomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %mo :
                  %mi R
                  %mo →
                  %mi R
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi S
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} h:R \to R[S^{-1}]
            and a function
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo :
                    %mi S
                    %mo →
                    %mi R
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi S
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} (-)^{-1}:S \to R[S^{-1}]
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi S
                  %annotation{:encoding => "application/x-tex"} a \in S
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo{:stretchy => "false"} (
                    %mi m
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %msup
                      %mi a
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} h(m(a)) \cdot a^{-1} = 1
          %p
            The
            %strong ring of fractions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo{:stretchy => "false"} [
                  %mi{:mathvariant => "normal"} Reg
                  %mo{:stretchy => "false"} (
                  %mi R
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} R[\mathrm{Reg}(R)^{-1}]
            is the localization of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            away from the
            %a.existingWikiWord{:href => "/nlab/show/multiplicative+subset+of+regular+elements"} multiplicative subset of regular elements
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} Reg
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{Reg}(R)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mi a
                    %mi b
                %annotation{:encoding => "application/x-tex"} \frac{a}{b}
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ∈
                  %mi R
                %annotation{:encoding => "application/x-tex"} a\in R
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                  %mo ∈
                  %mi{:mathvariant => "normal"} Reg
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} b\in \mathrm{Reg}(R)
            which are by the definition the equivalence classes of pairs
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi R
                  %mo ×
                  %mi{:mathvariant => "normal"} Reg
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (a,b) \in R\times \mathrm{Reg}(R)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo ∼
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (a,b)\sim (c,d)
            iff
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ⋅
                    %mi d
                    %mo =
                    %mi b
                    %mo ⋅
                    %mi c
                  %annotation{:encoding => "application/x-tex"} a \cdot d = b \cdot c
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mi a
                    %mi b
                  %mo +
                  %mfrac
                    %mi c
                    %mi d
                  %mo =
                  %mfrac
                    %mrow
                      %mi a
                      %mo ⋅
                      %mi d
                      %mo +
                      %mi b
                      %mo ⋅
                      %mi c
                    %mrow
                      %mi b
                      %mo ⋅
                      %mi d
                %annotation{:encoding => "application/x-tex"} \frac{a}{b}+\frac{c}{d} = \frac{a \cdot d+b \cdot c}{b \cdot d}
          %p and multiplication by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mi a
                    %mi b
                  %mo ⋅
                  %mfrac
                    %mi c
                    %mi d
                  %mo =
                  %mfrac
                    %mrow
                      %mi a
                      %mo ⋅
                      %mi c
                    %mrow
                      %mi b
                      %mo ⋅
                      %mi d
                %annotation{:encoding => "application/x-tex"} \frac{a}{b} \cdot \frac{c}{d} = \frac{a \cdot c}{b \cdot d}
          %p
            For
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi R
                  %annotation{:encoding => "application/x-tex"} a \in R
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %mi{:mathvariant => "normal"} Reg
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} b \in \mathrm{Reg}(R)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mi{:mathvariant => "normal"} Reg
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} c \in \mathrm{Reg}(R)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo ∈
                    %mi{:mathvariant => "normal"} Reg
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} d \in \mathrm{Reg}(R)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mi a
                    %mi b
                  %mo ÷
                  %mfrac
                    %mi c
                    %mi d
                  %mo =
                  %mfrac
                    %mrow
                      %mi a
                      %mo ⋅
                      %mi d
                    %mrow
                      %mi b
                      %mo ⋅
                      %mi c
                %annotation{:encoding => "application/x-tex"} \frac{a}{b} \div \frac{c}{d} = \frac{a \cdot d}{b \cdot c}
          %h2#examples  Examples
          %ul
            %li
              %p
                The ring of fractions of the
                %a.existingWikiWord{:href => "/nlab/show/integers"} integers
                is the
                %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℚ
                        %mo ≔
                        %mi ℤ
                        %mo{:stretchy => "false"} [
                        %mi{:mathvariant => "normal"} Reg
                        %mo{:stretchy => "false"} (
                        %mi ℤ
                        %msup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} \mathbb{Q} \coloneqq \mathbb{Z}[\mathrm{Reg}(\mathbb{Z})^{-1}]
            %li
              %p
                The ring of fractions of a
                %a.existingWikiWord{:href => "/nlab/show/discrete+integral+domain"} discrete integral domain
                is a
