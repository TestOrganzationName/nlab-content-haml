                  %annotation{:encoding => "application/x-tex"} \mathrm{settrunc}(a, b):\mathrm{isProp}(a =_{A \otimes B} b)
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
