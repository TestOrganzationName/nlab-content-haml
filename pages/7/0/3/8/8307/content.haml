                    %annotation{:encoding => "application/x-tex"} \mathrm{rdist}(a, b_1, b_2):f(a, b_1)+f(a, b_2) =_{A \otimes B} f(a,b_1+b_2)
          %p
            for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ,
