                  %annotation{:encoding => "application/x-tex"} \mathrm{rinv}(a):a + (-a) =_{A \otimes B} 0
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
