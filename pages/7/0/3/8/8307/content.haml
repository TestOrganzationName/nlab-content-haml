                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathrm{ldist}(a_1, a_2, b):f(a_1,b)+f(a_2,b) =_{A \otimes B} f(a_1+a_2,b)
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} rdist
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %msub
                        %mi b
                        %mn 1
                      %mo ,
                      %msub
                        %mi b
                        %mn 2
                      %mo{:stretchy => "false"} )
