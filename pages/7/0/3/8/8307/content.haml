                    %mi a
                    %mn 1
                  %mo ,
                  %msub
                    %mi a
                    %mn 2
                  %mo :
                  %mi A
                %annotation{:encoding => "application/x-tex"} a, a_1, a_2:A
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ,
                    %msub
                      %mi b
                      %mn 1
                    %mo ,
                    %msub
                      %mi b
