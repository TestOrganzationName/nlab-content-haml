                    %mi b
                    %mo :
                    %mi A
                    %mo ⊗
                    %mi B
                  %annotation{:encoding => "application/x-tex"} a, b:A \otimes B
          %p
            and dependent identifications stating that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is a
            %a.existingWikiWord{:href => "/nlab/show/bilinear+map"} bilinear map
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} ldist
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi a
                        %mn 1
                      %mo ,
                      %msub
                        %mi a
                        %mn 2
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi f
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi a
                        %mn 1
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
