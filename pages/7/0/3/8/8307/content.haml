          %h2#idea Idea
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            two
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
            %em tensor product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ⊗
                  %mi B
                %annotation{:encoding => "application/x-tex"} A \otimes B
            is a new abelian group such that a
            %a.existingWikiWord{:href => "/nlab/show/group+homomorphism"} group homomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ⊗
                  %mi B
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} A \otimes B \to C
            is equivalently a
            %a.existingWikiWord{:href => "/nlab/show/bilinear+map"} bilinear map
            out of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
          %p
            Tensor products of
            %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
            were defined by
            %a.existingWikiWord{:href => "/nlab/show/Hassler+Whitney"} Hassler Whitney
            in 1938.
          %h2#Definition Definition
          .num_defn
            %h6#definition_2 Definition
            %p
              Let
              %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
              be the collection of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
              %a.existingWikiWord{:href => "/nlab/show/multicategory"} multicategory
              whose
              %a.existingWikiWord{:href => "/nlab/show/multimorphisms"} multimorphisms
              are the
              %a.existingWikiWord{:href => "/nlab/show/multilinear+maps"} multilinear maps
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mn 1
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %msub
                        %mi A
                        %mi n
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} A_1, \cdots, A_n \to B
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ,
                    %mi B
                    %mo ↦
                    %mi A
                    %mo ⊗
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A, B \mapsto A \otimes B
              in this multicategory is the
              = succeed "." do
                %strong tensor product of abelian groups
          %p Equivalently this means explicitly:
          #ExplicitTensorProduct.num_defn
            %h6#definition_3 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ,
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A, B
              two
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
              %strong tensor product of abelian groups
              is the abelian group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊗
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A \otimes B
              which is the
              %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
              of the
              %a.existingWikiWord{:href => "/nlab/show/free+abelian+group"} free abelian group
              on the
              %a.existingWikiWord{:href => "/nlab/show/product"} product
              of their underlying sets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ×
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A \times B
              by the
              %a.existingWikiWord{:href => "/nlab/show/generators+and+relations"} relations
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi a
                          %mn 1
                        %mo ,
                        %mi b
                        %mo{:stretchy => "false"} )
                        %mo +
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi a
                          %mn 2
                        %mo ,
                        %mi b
                        %mo{:stretchy => "false"} )
                        %mo ∼
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi a
                          %mn 1
                        %mo +
                        %msub
                          %mi a
                          %mn 2
                        %mo ,
                        %mi b
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (a_1,b)+(a_2,b)\sim (a_1+a_2,b)
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo ,
                        %msub
                          %mi b
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mo +
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo ,
                        %msub
                          %mi b
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mo ∼
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo ,
                        %msub
                          %mi b
                          %mn 1
                        %mo +
                        %msub
                          %mi b
                          %mn 2
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (a,b_1)+(a,b_2)\sim (a,b_1+b_2)
            %p
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ,
                    %msub
                      %mi a
                      %mn 1
                    %mo ,
                    %msub
                      %mi a
                      %mn 2
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} a, a_1, a_2 \in A
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo ,
                      %msub
                        %mi b
                        %mn 1
                      %mo ,
                      %msub
                        %mi b
                        %mn 2
                      %mo ∈
                      %mi B
                    %annotation{:encoding => "application/x-tex"} b, b_1, b_2 \in B
          %p
            In words: it is the group whose elements are presented by pairs of elements in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            and such that the group operation for one argument fixed is that of the other group in the other argument.
          .num_remark
            %h6#remark Remark
            %p
              If one generalises to abelian
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/semigroups"} semigroups
              = succeed "." do
                %strong tensor product of abelian semigroups
          .num_remark
            %h6#remark_2 Remark
            %p
              The 0-ary relations
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo ∼
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} (0,b)\sim 0
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ∼
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} (a,0)\sim 0
              follow automatically; one needs them explicitly only if one generalises to
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/abelian+monoids"} abelian monoids
          #TheCanonicalMap.num_remark
            %h6#remark_3 Remark
            %p
              By definition of the
              %a.existingWikiWord{:href => "/nlab/show/free+construction"} free construction
              and the
              %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
              there is a canonical
              %a.existingWikiWord{:href => "/nlab/show/function"} function
              of the underlying sets
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mrow
                        %mi A
                        %mo ,
                        %mi B
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ⊗
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    p_{A,B}
                    \\;\colon\;
                    U(A) \times U(B)
                    \\overset{}{\longrightarrow}
                    U(A \otimes B)
            %p
              (where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Ab
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} U \colon Ab \to Set
              is the
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
            %p
              On elements this sends
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (a,b)
              to the equivalence class that it represents under the above equivalence relations.
          %p
            The following relates the tensor product to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/bilinear+functions"} bilinear functions
          .num_defn
            %h6#definitionproposition Definition/Proposition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/function"} function
              of underlying sets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi A
                    %mo ×
                    %mi B
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} f : A \times B \to C
              is a
              %a.existingWikiWord{:href => "/nlab/show/bilinear+function"} bilinear function
              precisely if it factors by the morphism of
              %a.maruku-ref{:href => "#TheCanonicalMap"}
              through a
              %a.existingWikiWord{:href => "/nlab/show/group+homomorphism"} group homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo :
                    %mi A
                    %mo ⊗
                    %mi B
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} \phi : A \otimes B \to C
              out of the tensor product:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi A
                    %mo ×
                    %mi B
                    %mover
                      %mo →
                      %mo ⊗
                    %mi A
                    %mo ⊗
                    %mi B
                    %mover
                      %mo →
                      %mi ϕ
                    %mi C
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f : A \times B \stackrel{\otimes}{\to}
                    A \otimes B
                    \\stackrel{\phi}{\to}
                    C
                    \\,.
          %h3#as_a_quotient_inductive_type As a quotient inductive type
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            can be expressed as a
            %a.existingWikiWord{:href => "/nlab/show/quotient+inductive+type"} quotient inductive type
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊗
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A \otimes B
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi A
                    %mo ×
                    %mi B
                    %mo →
                    %mi A
                    %mo ⊗
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f:A \times B \to A \otimes B
            %a.existingWikiWord{:href => "/nlab/show/identifications"} identifications
            guaranteeing that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ⊗
                  %mi B
                %annotation{:encoding => "application/x-tex"} A \otimes B
            is an
            %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo :
                    %mi A
                    %mo ⊗
                    %mi B
                  %annotation{:encoding => "application/x-tex"} 0:A \otimes B
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ⊗
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ⊗
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ⊗
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} +:(A \otimes B) \times (A \otimes B) \to (A \otimes B)
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ⊗
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ⊗
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} -:(A \otimes B) \to (A \otimes B)
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} assoc
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
