                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} |
                    %annotation{:encoding => "application/x-tex"} {|f(z_0)|}
                by continuity, and converges to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                    %annotation{:encoding => "application/x-tex"} s
                as well, so
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi z
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} |
                    %annotation{:encoding => "application/x-tex"} {|f(z)|}
                attains an absolute minimum
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                    %annotation{:encoding => "application/x-tex"} s
                at
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi z
                        %mo =
                        %msub
                          %mi z
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} z = z_0
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi z
                          %mn 0
                        %mo{:stretchy => "false"} )
                        %mo ≠
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} f(z_0) \neq 0
            %li
              %p
                The polynomial function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                may be uniquely written in the form
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi f
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi z
                        %mn 0
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mi g
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo −
                      %msub
                        %mi z
                        %mn 0
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi n
                    %annotation{:encoding => "application/x-tex"} f(z) = f(z_0) + g(z)(z - z_0)^n
              %p
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
                is polynomial function and
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi z
                          %mn 0
                        %mo{:stretchy => "false"} )
                        %mo ≠
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} g(z_0) \neq 0
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi f
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi z
                        %mn 0
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mi g
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi z
                        %mn 0
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo −
                      %msub
                        %mi z
                        %mn 0
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi n
                    %annotation{:encoding => "application/x-tex"} F(z) = f(z_0) + g(z_0)(z - z_0)^n
              %p
                and choose
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi δ
                      %mo &gt;
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \delta \gt 0
                small so that
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi z
                        %mo −
                        %msub
                          %mi z
                          %mn 0
                        %mo{:stretchy => "false"} |
                      %mo =
                      %mi δ
                      %mo ⇒
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi g
                        %mo{:stretchy => "false"} (
                        %mi z
                        %mo{:stretchy => "false"} )
                        %mo −
                        %mi g
                        %mo{:stretchy => "false"} (
