                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} |
                      %mo &lt;
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi g
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi z
                          %mn 0
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} |
                      %mo .
                    %annotation{:encoding => "application/x-tex"} {|z - z_0|} = \delta \Rightarrow {|g(z) - g(z_0)|} \lt {|g(z_0)|}.
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
                maps the circle
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo =
                      %mo{:stretchy => "false"} {
                      %mi z
                      %mo :
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi z
                        %mo −
                        %msub
                          %mi z
                          %mn 0
                        %mo{:stretchy => "false"} |
                      %mo =
                      %mi δ
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} C = \{z : {|z - z_0|} = \delta\}
                %em onto
                a circle of radius
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
