          %h2#definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            with
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/finite+limits"} finite limits
            %strong
              %a.existingWikiWord{:href => "/nlab/show/coherent+logic"} coherent
              %a.existingWikiWord{:href => "/nlab/show/hyperdoctrine"} hyperdoctrine
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is a
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo :
                  %msup
                    %mi C
                    %mi op
                  %mo →
                  %mi DistLattice
                %annotation{:encoding => "application/x-tex"}
                  P : C^{op} \to DistLattice
          %p
            from the
            %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            to the category of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/distributive+lattices"} distributive lattices
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} f : A \to B
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P(f) : P(B) \to P(A)
            has a
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∃
                    %mi f
                %annotation{:encoding => "application/x-tex"} \exists_f
            satisfying
          %ol
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Frobenius+reciprocity"}> Frobenius reciprocity
                ;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Beck-Chevalley+condition"}> Beck-Chevalley condition
                \.
          %h2#Properties Properties
          %p
            The assignment (
            %a{:href => "#OverACoherentCategory"}> here
            ) of a coherent hyperdoctrine
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} S(C)
            to a
            %a.existingWikiWord{:href => "/nlab/show/coherent+category"} coherent category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            extends to a
            %a.existingWikiWord{:href => "/nlab/show/2-adjunction"} 2-adjunction
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ⊣
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi CoherentCat
                  %mover
                    %munder
                      %mo ↪
                      %mi S
                    %mover
                      %mo ←
                      %mi A
                  %mi CoherentHyperdoctrine
                %annotation{:encoding => "application/x-tex"}
                  (A \dashv S)
                  \:
                  CoherentCat
                  \\stackrel{\overset{A}{\leftarrow}}{\underset{S}{\hookrightarrow}}
                  CoherentHyperdoctrine
          %p
            with the
            %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            being a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+2-functor"} full and faithful 2-functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CoherentCat
                %annotation{:encoding => "application/x-tex"} CoherentCat
            as a
            %a.existingWikiWord{:href => "/nlab/show/reflective+sub-2-category"} reflective sub-2-category
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CoherentHyperdoctrine
                  %annotation{:encoding => "application/x-tex"} CoherentHyperdoctrine
          %p
            (Here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CoherentCat
                %annotation{:encoding => "application/x-tex"} CoherentCat
            has as
            %a.existingWikiWord{:href => "/nlab/show/2-morphisms"} 2-morphisms
            those
            %a.existingWikiWord{:href => "/nlab/show/natural+transformations"} natural transformations
            that preserve finite products.)
          %p
            This appears as (
            %a{:href => "#Coumans"}> Coumans, prop. 8
            ).
          %p
            Coherent hyperdoctrines are closed under
            %a.existingWikiWord{:href => "/nlab/show/canonical+extension"} canonical extension
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi δ
                    %mo :
                    %mi DistLattice
                    %mo →
                    %mi DistLattice
                  %annotation{:encoding => "application/x-tex"} (-)^\delta : DistLattice \to DistLattice
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo :
                  %msup
                    %mi C
                    %mi op
                  %mo →
                  %mi DistLattic
                %annotation{:encoding => "application/x-tex"} P : C^{op} \to DistLattic
            a coherent hyperdoctrine, so is
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi δ
                    %mo ∘
                    %mi P
                  %annotation{:encoding => "application/x-tex"} (-)^\delta \circ P
          %p
            This appears as (
            %a{:href => "#Coumans"}> Coumans, prop. 9
            ).
