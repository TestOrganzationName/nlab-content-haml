              %semantics
                %mrow
                  %mi P
                  %mo :
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo ,
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} }
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                  %mo :
