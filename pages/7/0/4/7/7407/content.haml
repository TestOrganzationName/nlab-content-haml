          %h3#OverACoherentCategory Over a coherent category
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/coherent+category"} coherent category
            %a.existingWikiWord{:href => "/nlab/show/object"} object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %mi C
                %annotation{:encoding => "application/x-tex"} A \in C
            the
            %a.existingWikiWord{:href => "/nlab/show/poset+of+subobjects"} poset of subobjects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Sub
                    %mi C
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
