                of
                %a.existingWikiWord{:href => "/nlab/show/Poisson+sigma-model"} Poisson sigma-model
                string.
          %p
            %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"}> Edward Witten
            , 1990
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/knot+invariants"} knot invariants
                via
                = succeed "-string/" do
                  %a.existingWikiWord{:href => "/nlab/show/WZW+model"} WZW model
                %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/AdS3-CFT2+and+CS-WZW+correspondence"} holography
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/elliptic+genus"}> elliptic genus
                ,
                %a.existingWikiWord{:href => "/nlab/show/Witten+genus"} Witten genus
                and rigidity via
                %a.existingWikiWord{:href => "/nlab/show/superstring"} superstring
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/partition+functions"} partition functions
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/mirror+symmetry"} mirror symmetry
                via
                = succeed "/" do
                  %a.existingWikiWord{:href => "/nlab/show/A-model"} A-model
                %a.existingWikiWord{:href => "/nlab/show/B-model"} B-model
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/topological+string"} topological string
          %p
