                      %mo =
                      %msup
                        %mi e
                        %mi λ
                    %annotation{:encoding => "application/x-tex"} g_s = e^\lambda
              %p
                (= radius of
                %a.existingWikiWord{:href => "/nlab/show/M-theory"} M-theory
                compactification circle (
                %a{:href => "http://ncatlab.org/nlab/show/M-theory#Witten95"}> Witten 95
                ))
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/coupling+constant"} coupling constant
                of
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/gravity"} gravity
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi κ
                      %mo ∝
                      %msub
                        %mi g
                        %mi s
                      %mo{:stretchy => "false"} (
                      %mi α
