          %p
            (see e.g.
            = succeed ")" do
              %a{:href => "http://arxiv.org/abs/0908.0333"} arXiv:0908.0333
          %p
            see also at
            %em
              %a.existingWikiWord{:href => "/nlab/show/non-perturbative+effect"} non-perturbative effect
            the section
            %em
