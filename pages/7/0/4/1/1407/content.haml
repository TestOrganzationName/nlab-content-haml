                      %msup
                        %mo{:stretchy => "false"} )
                        %mn 6
                      %mo =
                      %msub
                        %mi g
                        %mi s
                      %msubsup
                        %mi l
                        %mi s
                        %mn 12
                    %annotation{:encoding => "application/x-tex"} \kappa \propto g_s (\alpha')^6 = g_s l_s^{12}
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Newton%27s+constant"} Newton's constant
                (before compactification)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
