                      %msub
                        %mi l
                        %mi s
                      %mo =
                      %msqrt
                        %mrow
                          %mi α
                          %mo ′
                    %annotation{:encoding => "application/x-tex"} l_s = \sqrt{\alpha'}
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/string+coupling+constant"} string coupling constant
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
