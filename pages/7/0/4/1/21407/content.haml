                  %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  d \star_4 V^{(n)}
                  \\;=\;
                  0
                  \\,.
          %p
            By the differential recursion relation of
            %a.existingWikiWord{:href => "/nlab/show/Hermite+functions"} Hermite functions
            (see
            = succeed ")" do
              %a{:href => "Hermite+polynomial#eq:DifferentialRecursionRelationForHermiteFunctions"} there
          #eq:DifferentialRecursionRelationOfHermiteFunctions.maruku-equation
