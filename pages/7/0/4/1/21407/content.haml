          %h2#idea Idea
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/Maxwell+equations"} Maxwell equations
            were originally formulated on 4-dimensional
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
            %a.existingWikiWord{:href => "/nlab/show/Faraday+tensor"} Faraday tensor
            is regarded as a
            %a.existingWikiWord{:href => "/nlab/show/differential+2-form"} differential 2-form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            with
            %a.existingWikiWord{:href => "/nlab/show/Hodge+dual"} Hodge dual
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⋆
                  %mi F
                %annotation{:encoding => "application/x-tex"} \star F
            and
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+differentials"} de Rham differentials
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mi e
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi d
                          %mi F
                        %mtd
                          %mo =
                          %mn 0
                      %mtr
                        %mtd
                          %mo ⋆
                          %mi d
                          %mi F
                        %mtd
                          %mo =
                          %mi J
                %annotation{:encoding => "application/x-tex"}
                  R e
                  \\array{
                  d F &amp; = 0
                  \\\
                  \\star d F &amp; = J
                  }
          %p
            they immediately generalize to make sense on
            %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
            of any dimension
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/pseudo-Riemannian+manifold"} pseudo-Riemannian manifold
            = succeed "-Maxwell" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo =
                    %mn 5
                  %annotation{:encoding => "application/x-tex"} D =5
            %a.existingWikiWord{:href => "/nlab/show/D%3D5+Yang-Mills+theory"} D=5 Yang-Mills theory
            with
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/U%281%29"} U(1)
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/gauge+group"} gauge group
            %a.existingWikiWord{:href => "/nlab/show/D%3D5+Einstein-Maxwell+theory"} D=5 Einstein-Maxwell theory
            and/or of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/D%3D5+super+Yang-Mills+theory"} D=5 super Yang-Mills theory
            %a.existingWikiWord{:href => "/nlab/show/Kaluza-Klein+compactification"} Kaluza-Klein compactification
            of
            %a.existingWikiWord{:href => "/nlab/show/massive+Yang-Mills+theory"} massive Yang-Mills theory
            in 4-dimensions.
          %h2#properties Properties
          %div
            %h3#relation_between_5d_maxwell_theory_and_selfdual_3forms_in_6d Relation between 5d Maxwell theory and self-dual 3-forms in 6d
            %p
              Consider 5d- and 6d-dimensional
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              equipped with global
              %a.existingWikiWord{:href => "/nlab/show/orthonormal+basis"} orthonormal
              %a.existingWikiWord{:href => "/nlab/show/coordinate+charts"} coordinate charts
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msup
                        %mi x
                        %mi κ
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{x^\kappa\}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msup
                        %mi x
                        %mi α
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{x^\alpha\}
              %a.existingWikiWord{:href => "/nlab/show/isometry"} isometric
              %a.existingWikiWord{:href => "/nlab/show/embedding+of+smooth+manifolds"} embedding
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mi ℝ
                              %mrow
                                %mn 4
                                %mo ,
                                %mn 1
                          %mtd
                            %mover
                              %mo ↪
                              %mrow
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %msub
                                  %mi ι
                                  %mn 5
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                          %mtd
                            %msup
                              %mi ℝ
                              %mrow
                                %mn 5
                                %mo ,
                                %mn 1
                        %mtr
                          %mtd
                            %mi κ
                            %mo =
                          %mtd
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo ,
                            %mn 2
                            %mo ,
                            %mn 3
                            %mo ,
                            %mn 4
                            %mphantom
                              %mo ,
                        %mtr
                          %mtd
                            %mi α
                            %mo =
                          %mtd
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo ,
                            %mn 2
                            %mo ,
                            %mn 3
                            %mo ,
                            %mn 4
                            %mo ,
                          %mtd
                          %mtd
                            %mn 5
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;
                    \\mathbb{R}^{4,1}
                    \&amp;\overset{\;\;\;\iota_5\;\;\;}{\hookrightarrow}&amp;
                    \\mathbb{R}^{5,1}
                    \\\
                    \\kappa = &amp;   0, 1, 2, 3, 4\phantom{,}
                    \\\
                    \\alpha = &amp; 0, 1, 2, 3, 4, &amp;&amp; 5
                    }
            %p
              With this notation, the
              %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pullback of differential forms
              along this embedding is notationally implicit.
            %p
              Now any
              %a.existingWikiWord{:href => "/nlab/show/differential+3-form"} differential 3-form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} H_3
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 5
                        %mo ,
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{5,1}
              decomposes as
            #eq:5dDecompositionof3Form.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mn 3
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mi F
                      %mo ^
                    %mo ∧
                    %mi d
                    %msup
                      %mi x
                      %mn 5
                    %mo +
                    %mover
                      %mi H
                      %mo ^
                  %annotation{:encoding => "application/x-tex"}
                    H_3
                    \\;=\;
                    \\widehat{F} \wedge d x^{5}
                    +
                    \\widehat{H}
            %p for unique differential forms of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi F
                      %mo ^
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mn 2
                    %msub
                      %mover
                        %mi F
                        %mo{:stretchy => "false"} ^
                      %mrow
                        %msub
                          %mi κ
                          %mn 1
                        %msub
                          %mi κ
                          %mn 2
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi x
                      %mi κ
                    %mo ,
                    %msup
                      %mi x
                      %mn 5
                    %mo{:stretchy => "false"} )
                    %mi d
                    %msup
                      %mi x
                      %mrow
                        %msub
                          %mi κ
                          %mn 1
                    %mo ∧
                    %mi d
                    %msup
                      %mi x
                      %mrow
                        %msub
                          %mi κ
                          %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\widehat F
                    \\;=\;
                    \\tfrac{1}{2}\hat F_{\kappa_1 \kappa_2}(x^\kappa, x^5)
                    d x^{\kappa_1} \wedge d x^{\kappa_2}
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi H
                      %mo ^
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mrow
                          %mn 3
                          %mo !
                    %msub
                      %mover
                        %mi H
                        %mo ^
                      %mrow
                        %msub
                          %mi κ
                          %mn 1
                        %msub
                          %mi κ
                          %mn 2
                        %msub
                          %mi κ
                          %mn 3
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi x
                      %mi κ
                    %mo ,
                    %msup
                      %mi x
                      %mn 5
                    %mo{:stretchy => "false"} )
                    %mi d
                    %msup
                      %mi x
                      %mrow
                        %msub
                          %mi κ
                          %mn 1
                    %mo ∧
                    %mi d
                    %msup
                      %mi x
                      %mrow
                        %msub
                          %mi κ
                          %mn 2
                    %mo ∧
                    %mi d
                    %msup
                      %mi x
                      %mrow
                        %msub
                          %mi κ
                          %mn 3
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\widehat{H}
                    \\;=\;
                    \\tfrac{1}{3!} \widehat{H}_{\kappa_1 \kappa_2 \kappa_3}(x^\kappa, x^5)
                    d x^{\kappa_1} \wedge d x^{\kappa_2} \wedge d x^{\kappa_3}
                    \\,.
            %p
              In the case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} H_3
              has vanishing
              %a.existingWikiWord{:href => "/nlab/show/Lie+derivative"} Lie derivative
              along the
              = succeed "-direction," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi x
                        %mn 5
                    %annotation{:encoding => "application/x-tex"} x^5
            #eq:VanishingLieDerivateiveAlongx5.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℒ
                      %mn 5
                    %msub
                      %mi H
                      %mn 3
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{L}_5 H_3 \;=\; 0
            %p
              then also these components forms do not depend on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mn 5
                  %annotation{:encoding => "application/x-tex"} x^5
              are actualls
              %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pullbacks
              of differential forms on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mrow
                          %mn 4
                          %mo ,
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^{4,1}
            %p
              In terms of this decomposition, the 6d
              %a.existingWikiWord{:href => "/nlab/show/Hodge+dual"} Hodge dual
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} H_3
              is equivalently given by the 5d
              %a.existingWikiWord{:href => "/nlab/show/Hodge+duals"} Hodge duals
              of these components as (best seen by the relation to
              %a.existingWikiWord{:href => "/nlab/show/Hodge+pairing"} Hodge pairing
              according to
              = succeed ")" do
                %a{:href => "Hodge+star+operator#HodgePairing"} this Prop.
            #eq:6dHodgeDualityInTermsOf5d.maruku-equation
              %span.maruku-eq-number (3)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ⋆
                      %mn 6
                    %msub
                      %mi H
                      %mn 3
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mo ⋆
                      %mn 5
                    %mover
                      %mi H
                      %mo ^
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo ∧
                    %mi d
                    %msup
                      %mi x
                      %mn 5
                    %mo −
                    %msub
                      %mo ⋆
                      %mn 5
                    %mover
                      %mi F
                      %mo ^
                  %annotation{:encoding => "application/x-tex"}
                    \\star_6 H_3
                    \\;=\;
                    \\big( \star_5 \widehat{H}\big) \wedge d x^{5}
                    \-
                    \\star_5 \widehat{F}
            %p
              Since the
              %a.existingWikiWord{:href => "/nlab/show/Hodge+star+operator"} Hodge star operator
              squares to unity in the special case that it is applied to differential 3-forms on 6d Minkowski spacetime (by
              = succeed ")" do
                %a{:href => "Hodge+star+operator#HodgeStarFollowedByHodgeStar"} this Prop.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ⋆
                      %mn 6
                    %msub
                      %mo ⋆
                      %mn 6
                    %msub
                      %mi H
                      %mn 3
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo +
                    %msub
                      %mi H
                      %mn 3
                  %annotation{:encoding => "application/x-tex"}
                    \\star_6 \star_6 H_3 \;=\; + H_3
            %p
              we may ask for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} H_3
              to he
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Hodge+duality"} Hodge self-dual
              %a.maruku-eqref{:href => "#eq:6dHodgeDualityInTermsOf5d"} (3)
              this means equivalently that its 5d components are 5d Hodge duals of each other:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi H
                      %mn 3
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mo ⋆
                      %mn 6
                    %msub
                      %mi H
                      %mn 3
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mo ⇔
                      %mrow
                        %msub
                          %mi H
                          %mn 3
                        %mo =
                        %mover
                          %mi F
                          %mo ^
                        %mo ∧
                        %mi d
                        %msup
                          %mi x
                          %mn 5
                        %mo +
                        %mover
                          %mi H
                          %mo ^
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mover
                      %mi H
                      %mo ^
                    %mo =
                    %msub
                      %mo ⋆
                      %mn 5
                    %mover
                      %mi F
                      %mo ^
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\big(
                    H_3
                    \\;=\;
                    \\star_{6} H_3
                    \\big)
                    \\;\;\;
                    \\overset{
                    H_3 = \widehat{F} \wedge d x^5 + \widehat{H}
                    }{
                    \\Leftrightarrow
                    }
                    \\;\;\;
                    \\big(
                    \\widehat{H} = \star_5 \widehat{F}
                    \\big)
                    \\,.
            %p
              It follows that if there is no
              = succeed "-dependence" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi x
                        %mn 5
                    %annotation{:encoding => "application/x-tex"} x^5
              %a.maruku-eqref{:href => "#eq:VanishingLieDerivateiveAlongx5"} (2)
              then the condition that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} H_3
              be a
              %a.existingWikiWord{:href => "/nlab/show/closed+differential+form"} closed
              and
              %a.existingWikiWord{:href => "/nlab/show/self-dual+higher+gauge+theory"} self-dual 3-form
              is equivalent to its 5d components
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi F
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \widehat{F}
              (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mover
                      %mi H
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \widehat{H}
              ) being the (dual)
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/field+strength"} field strength
              %a.existingWikiWord{:href => "/nlab/show/Faraday+tensor"} Faraday tensor
              satisfying the
              %a.existingWikiWord{:href => "/nlab/show/Maxwell+equations"} Maxwell equations
              of
              %a.existingWikiWord{:href => "/nlab/show/D%3D5+Maxwell+theory"} D=5 Maxwell theory
              (without
              %a.existingWikiWord{:href => "/nlab/show/source+fields"} source
              = succeed "):" do
                %a.existingWikiWord{:href => "/nlab/show/conserved+current"} current
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                              %mtd
                                %mi d
                                %msub
                                  %mi H
                                  %mn 3
                                %mo =
                                %mn 0
                            %mtr
                              %mtd
                              %mtd
                                %msub
                                  %mo ⋆
                                  %mn 6
                                %msub
                                  %mi H
                                  %mn 3
                                %mo =
                                %msub
                                  %mi H
                                  %mn 3
                        %mo }
                      %mstyle{:mathcolor => "blue"}
                        %mfrac{:linethickness => "0"}
                          %mrow
                            %mphantom
                              %mi A
                          %mrow
                            %mtext D=6 self-dual 3-form theory
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mo ⇔
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mrow
                            %msub
                              %mi ℒ
                              %mn 5
                            %msub
                              %mi H
                              %mn 3
                            %mo =
                            %mn 0
                        %mrow
                          %mrow
                            %msub
                              %mi H
                              %mn 3
                            %mo =
                            %mover
                              %mi F
                              %mo ^
                            %mo ∧
                            %mi d
                            %msup
                              %mi x
                              %mn 5
                            %mo +
                            %mi ⋯
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mrow
                        %mo {
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                              %mtd
                                %mi d
                                %mover
                                  %mi F
                                  %mo ^
                                %mo =
                                %mn 0
                            %mtr
                              %mtd
                              %mtd
                                %mi d
                                %msub
                                  %mo ⋆
                                  %mn 5
                                %mover
                                  %mi F
                                  %mo ^
                                %mo =
                                %mn 0
                      %mstyle{:mathcolor => "blue"}
                        %mfrac{:linethickness => "0"}
                          %mrow
                            %mphantom
                              %mi A
                          %mrow
                            %mtext D=5 Maxwell theory
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{
                    \\color{blue}
                    {
                    {\phantom{A}}
                    \\atop
                    {\text{D=6 self-dual 3-form theory}}
                    }
                    }{
                    \\left.
                    \\array{
                    \&amp;
                    d H_3 = 0
                    \\\
                    \&amp;
                    \\star_6 H_3 = H_3
                    }
                    \\right\}
                    }
                    \\;\;\;
                    \\overset{
                    {\mathcal{L}_{5} H_3 = 0}
                    \\atop
                    {H_3 = \widehat{F}\wedge d x^5 + \cdots}
                    }{
                    \\Leftrightarrow
                    }
                    \\;\;\;
                    \\underset{
                    \\color{blue}
                    {
                    {\phantom{A}}
                    \\atop
                    \\text{D=5 Maxwell theory}
                    }
                    }{
                    \\left\{
                    \\array{
                    \&amp;
                    d \widehat{F} = 0
                    \\\
                    \&amp;
                    d \star_5 \widehat{F} = 0
                    }
                    \\right.
                    }
            %p
              This may be summarized as saying that the massless part of the
              %a.existingWikiWord{:href => "/nlab/show/Kaluza-Klein+reduction"} Kaluza-Klein reduction
              of
              %a.existingWikiWord{:href => "/nlab/show/self-dual+higher+gauge+theory"} self-dual 3-form theory
              from 6d to 5d is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/D%3D5+Maxwell+theory"} D=5 Maxwell theory
            %p
              Essentially this relation underlies the formulation of the
              %a.existingWikiWord{:href => "/nlab/show/M5-brane"} M5-brane
              via the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Perry-Schwarz+Lagrangian"} Perry-Schwarz Lagrangian
          %p
            %br/
          %h3#RelationBetween5dMaxwellTheoryAndMassiveVectorMesons Relation between 5d Maxwell theory and massive vector mesons in 4d
          %p
            In an abelian version of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/hadron+Kaluza-Klein+theory"} hadron Kaluza-Klein theory
            = succeed "-model," do
              %a.existingWikiWord{:href => "/nlab/show/Skyrmion"} Skyrmion
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/vector+mesons"} vector mesons
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/holographic+QCD"} holographic QCD
            %a.existingWikiWord{:href => "/nlab/show/Kaluza-Klein+reduction"} Kaluza-Klein reduction
            of
            %a.existingWikiWord{:href => "/nlab/show/D%3D5+Maxwell+theory"} D=5 Maxwell theory
            to 4d yields a theory of a tower of massive vector particles which may be interpreted as
            %a.existingWikiWord{:href => "/nlab/show/vector+mesons"} vector mesons
            (
            %a{:href => "#Sutcliffe10"}> Sutcliffe 10, Sec. 3
            ):
          %h4#flat_space_model Flat space model
          %p
            Following
            = succeed "," do
              %a{:href => "#Sutcliffe10"} Sutcliffe 10, Sec. 3
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
          %p
            Consider 4d- and 5d-dimensional
            %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
            equipped with global
            %a.existingWikiWord{:href => "/nlab/show/orthonormal+basis"} orthonormal
            %a.existingWikiWord{:href => "/nlab/show/coordinate+charts"} coordinate charts
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi x
                      %mi μ
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{x^\mu\}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi x
                      %mi κ
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{x^\kappa\}
            %a.existingWikiWord{:href => "/nlab/show/isometry"} isometric
            %a.existingWikiWord{:href => "/nlab/show/embedding+of+smooth+manifolds"} embedding
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mi ℝ
                            %mrow
                              %mn 3
                              %mo ,
                              %mn 1
                        %mtd
                          %mover
                            %mo ↪
                            %mrow
                              %mspace{:width => "thickmathspace"}
                              %mspace{:width => "thickmathspace"}
                              %mspace{:width => "thickmathspace"}
                              %msub
                                %mi ι
                                %mn 5
                              %mspace{:width => "thickmathspace"}
                              %mspace{:width => "thickmathspace"}
                              %mspace{:width => "thickmathspace"}
                        %mtd
                          %msup
                            %mi ℝ
                            %mrow
                              %mn 4
                              %mo ,
                              %mn 1
                      %mtr
                        %mtd
                          %mi μ
                          %mo =
                        %mtd
                          %mn 0
                          %mo ,
                          %mn 1
                          %mo ,
                          %mn 2
                          %mo ,
                          %mn 3
                          %mspace{:width => "thickmathspace"}
                      %mtr
                        %mtd
                          %mi κ
                          %mo =
                        %mtd
                          %mn 0
                          %mo ,
                          %mn 1
                          %mo ,
                          %mn 2
                          %mo ,
                          %mn 3
                          %mo ,
                        %mtd
                        %mtd
                          %mn 4
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;
                  \\mathbb{R}^{3,1}
                  \&amp;\overset{\;\;\;\iota_5\;\;\;}{\hookrightarrow}&amp;
                  \\mathbb{R}^{4,1}
                  \\\
                  \\mu = &amp;   0, 1, 2, 3\;
                  \\\
                  \\kappa = &amp; 0, 1, 2, 3, &amp;&amp; 4
                  }
          %p
            With this notation, the
            %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pullback of differential forms
            along this embedding is notationally implicit.
          %p
            Assuming that the 5d
            %a.existingWikiWord{:href => "/nlab/show/vector+potential"} vector potential
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi A
                    %mo ^
                  %mo ∈
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mrow
                      %mn 4
                      %mo ,
                      %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \widehat A \in \Omega^1(\mathbb{R}^{4,1})
            is
            %a.existingWikiWord{:href => "/nlab/show/square+integrable+function"} square-integrable
            along the
            = succeed "-drection," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mn 4
                  %annotation{:encoding => "application/x-tex"} x^4
            %a.existingWikiWord{:href => "/nlab/show/linear+basis"} linear basis
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi h
                    %mi n
                  %msub
                    %mo{:stretchy => "false"} }
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                %annotation{:encoding => "application/x-tex"} \{h_n\}_{n \in \mathbb{N}}
            of
            %a.existingWikiWord{:href => "/nlab/show/Hermite+functions"} Hermite functions
            as a sequence of
            %a.existingWikiWord{:href => "/nlab/show/vector+potentials"} vector potentials
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi V
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                  %mo ∈
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mrow
                      %mn 4
                      %mo ,
                      %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} V^{(n)} \in \Omega^1(\mathbb{R}^{4,1})
            that do not depend on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi x
                    %mn 4
                %annotation{:encoding => "application/x-tex"} x^4
            anymore.
          #eq:HermiteExpansionOf5dVectorPotential.maruku-equation
            %span.maruku-eq-number (4)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi A
                    %mo ^
