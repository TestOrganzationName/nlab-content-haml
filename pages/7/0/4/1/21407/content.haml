                  V^{(n)}(\{x^\mu\})
          %p
            We assume now (
            %em not
            following
            %a{:href => "#Sutcliffe10"} Sutcliffe 10
            in this) that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi V
                      %mn 4
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} V^{(n)}_4 = 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi V
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} V^{(n)}
            are
            %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pulled back
            from 4d spacetime, and we take these 4d
            %a.existingWikiWord{:href => "/nlab/show/vector+potentials"} vector potentials
            to be in 4d
            %a.existingWikiWord{:href => "/nlab/show/Lorenz+gauge"} Lorenz gauge
          #eq:4dLorenzGauge.maruku-equation
            %span.maruku-eq-number (5)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %msub
                    %mo ⋆
                    %mn 4
                  %msup
                    %mi V
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
