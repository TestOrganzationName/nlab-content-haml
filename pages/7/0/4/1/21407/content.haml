                        %mi n
                        %mn 2
                  %msub
                    %mi h
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi x
                    %mn 4
                  %mo{:stretchy => "false"} )
                  %mo −
                  %msqrt
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                        %mn 2
                  %msub
                    %mi h
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi x
                    %mn 4
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
