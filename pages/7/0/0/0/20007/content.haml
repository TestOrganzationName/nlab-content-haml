          %h2#definition Definition
          %p
            Given two
            %a.existingWikiWord{:href => "/nlab/show/monoidal+categories"} monoidal categories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi V
                    %mn 1
                  %mo ,
                  %msub
                    %mo ⊗
                    %mn 1
                  %mo ,
                  %msub
                    %mi I
                    %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (V_1,\otimes_1, I_1)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi V
                    %mn 2
                  %mo ,
                  %msub
                    %mo ⊗
                    %mn 2
                  %mo ,
                  %msub
                    %mi I
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (V_2, \otimes_2, I_2)
            used for enrichment in
            %a.existingWikiWord{:href => "/nlab/show/enriched+category+theory"} enriched category theory
            (for instance two
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/B%C3%A9nabou+cosmoi"} Bénabou cosmoi
            %a.existingWikiWord{:href => "/nlab/show/lax+monoidal+functor"} lax monoidal functor
            between them
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi V
                    %mn 1
                  %mo ,
                  %msub
                    %mo ⊗
                    %mn 1
                  %mo ,
                  %msub
                    %mi I
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi V
                    %mn 2
                  %mo ,
                  %msub
                    %mo ⊗
                    %mn 2
                  %mo ,
                  %msub
                    %mi I
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  F
                  \\;\colon\;
                  (V_1, \otimes_1, I_1)
                  \\longrightarrow
                  (V_2, \otimes_2, I_2)
          %p
            canonically induces a
            %a.existingWikiWord{:href => "/nlab/show/2-functor"} 2-functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mo *
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi V
                    %mn 1
                  %mi Cat
                  %mo ⟶
                  %msub
                    %mi V
                    %mn 2
                  %mi Cat
                %annotation{:encoding => "application/x-tex"}
                  F_\ast \;\colon\; V_1 Cat \longrightarrow V_2 Cat
          %p
            between
            %a.existingWikiWord{:href => "/nlab/show/categories+of+V-enriched+categories"} categories of V-enriched categories
            sending a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} V_1
            %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            to the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} V_2
            %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F_\ast(\mathcal{C})
            such that
          %ol
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mo *
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F_\ast(\mathcal{C})
                has the same
                %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                as
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/hom-objects"} hom-objects
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mo *
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F_\ast(\mathcal{C})
                are the
                %a.existingWikiWord{:href => "/nlab/show/images"} images
                of the hom-objects of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                under
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mo *
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %mi F
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %annotation{:encoding => "application/x-tex"}
                      F_\ast(\mathcal{C})(x,y)
                      \\;\coloneqq\;
                      F\big(\mathcal{C}(x,y)\big)
            %li
              %p
                the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/composition"} composition
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/unit"} unit
                %a.existingWikiWord{:href => "/nlab/show/associator"} associator
                and
                %a.existingWikiWord{:href => "/nlab/show/unitor"} unitor
                %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mo *
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F_\ast(\mathcal{C})
                are the
                %a.existingWikiWord{:href => "/nlab/show/images"} images
                of those of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                composed with the structure morphisms of the
                = succeed "-" do
                  %a.existingWikiWord{:href => "/nlab/show/lax+monoidal+functor"} lax monoidal
                %a.existingWikiWord{:href => "/nlab/show/structure"} structure
                on
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
          %p
            (
            %a{:href => "#EilenbergKelly65"}> Eilenberg-Kelly 65
            )
          %p
            This operation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mo *
                %annotation{:encoding => "application/x-tex"} F_\ast
            is sometimes called
            %strong change of enriching category
            or
            %strong change of enriching base
            or just
            %strong change of base
            (e.g.
            = succeed "," do
              %a{:href => "#Crutwell14"} Crutwell 14, chapter 4
            = succeed ")." do
              %a{:href => "#Riehl14"} Riehl 14, lemma 3.4.3
            %a.existingWikiWord{:href => "/nlab/show/base+change"} base change
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/slice+categories"} slice categories
          %p
            In the special case that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            has a single object and is hence (if thought of as
            %a.existingWikiWord{:href => "/nlab/show/pointed+object"} pointed
            by that object) equivalently a
            %a.existingWikiWord{:href => "/nlab/show/monoid+object"} monoid object
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} V_1
            %a.existingWikiWord{:href => "/nlab/show/monoids"} monoids
            (
            %a{:href => "monoidal+functor#MonoidsToMonoidsByLaxMonoidal"}> this Prop.
            )
          %h2#generalizations_and_enhancements Generalizations and enhancements
          %ul
            %li
              %p
                The operation of change of enriching category is functorial from
                %a.existingWikiWord{:href => "/nlab/show/MonCat"} MonCat
                to
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/2Cat"} 2Cat
                %a.existingWikiWord{:href => "/nlab/show/monoidal+adjunction"} monoidal adjunction
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi V
                        %mn 1
                      %mo ⇄
                      %msub
                        %mi V
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} V_1\rightleftarrows V_2
                gives rise to a
                %a.existingWikiWord{:href => "/nlab/show/2-adjunction"} 2-adjunction
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi V
                        %mn 1
                      %mi Cat
                      %mo ⇄
                      %msub
                        %mi V
                        %mn 2
                      %mi Cat
                    %annotation{:encoding => "application/x-tex"} V_1 Cat\rightleftarrows V_2 Cat
                (and also for profunctors).
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
                \-enriched categories can be defined more generally when
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
                is a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/multicategory"} multicategory
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo :
                      %msub
                        %mi V
                        %mn 1
                      %mo →
                      %msub
                        %mi V
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} F:V_1\to V_2
                between multicategories induces a change of enrichment 2-functor. Note that a functor of multicategorise between the underlying multicategories of two monoidal categories corresponds to a
                %em lax
                monoidal functor, as in the original version above. The multicategorical version also includes change of enrichment between
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/closed+categories"} closed categories
            %li
              %p
                A different generalization is when
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
                is a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/bicategory"} bicategory
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/bicategory-enriched+categories"} bicategory-enriched categories
            %li
              %p
                When
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi V
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} V_1
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi V
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} V_2
                are cocomplete monoidal categories (or locally cocomplete bicategories), so that the bicategories
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi V
                          %mi i
                      %annotation{:encoding => "application/x-tex"} V_i
                %a.existingWikiWord{:href => "/nlab/show/Prof"} Prof
                of
                = succeed "-categories" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi V
                          %mi i
                      %annotation{:encoding => "application/x-tex"} V_i
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi V
                          %mi i
                      %annotation{:encoding => "application/x-tex"} V_i
                %a.existingWikiWord{:href => "/nlab/show/profunctors"} profunctors
                exist, change of enrichment also induces a
                %a.existingWikiWord{:href => "/nlab/show/lax+functor"} lax functor
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi V
                          %mn 1
                        %mi Prof
                        %mo →
                        %msub
                          %mi V
                          %mn 2
                        %mi Prof
                      %annotation{:encoding => "application/x-tex"} V_1 Prof \to V_2 Prof
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi MonCat
                          %mi cocomplete
                      %annotation{:encoding => "application/x-tex"} MonCat_{cocomplete}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi V
                        %mi i
                      %mi Prof
                    %annotation{:encoding => "application/x-tex"} V_i Prof
                as
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/double+categories"} double categories
                %a.existingWikiWord{:href => "/nlab/show/MonCat"} MonCat
                to
                = succeed "." do
                  %span.newWikiWord
                    DblCat
                    %a{:href => "/nlab/new/DblCat"} ?
            %li
              %p
                Finally, a generalization subsuming all of these is that for any
                %a.existingWikiWord{:href => "/nlab/show/virtual+double+category"} virtual double category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
                we can construct another virtual double category
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                        %mi Prof
                      %annotation{:encoding => "application/x-tex"} V Prof
          %h2#examples Examples
          #Underlying.num_example
            %h6#example Example
            %p
              For any a monoidal category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi V
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} V(I,-): V \to Set
              is lax monoidal, hence induces a 2-functor from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} V Cat
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Cat
                    %annotation{:encoding => "application/x-tex"} Cat
              = succeed "-enriched" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/underlying+ordinary+category"} underlying ordinary category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒞
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}_0
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒞
                        %mn 0
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi V
                      %mo{:stretchy => "false"} (
                      %mi I
                      %mo ,
                      %mi hom
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}_0(x,y) = V(I, hom(x,y))
          #FreeCats.num_example
            %h6#example_2 Example
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              is a
              %a.existingWikiWord{:href => "/nlab/show/cocomplete+category"} cocomplete
              monoidal category, the functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V(I,-)
              above has a
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              that takes a set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              to the
              %a.existingWikiWord{:href => "/nlab/show/copower"} copower
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              copies of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cat
                    %mo →
                    %mi V
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} Cat \to V Cat
              takes an ordinary category to the “free”
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              = succeed "-categories" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              %a.existingWikiWord{:href => "/nlab/show/limits"} limits
              under enriched
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/weighted+limits"} weighted limits
            %p
              By functoriality, the adjunction between these two functors gives rise to a 2-adjunction
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Cat
                      %mo ⇄
                      %mi V
                      %mi Cat
                    %annotation{:encoding => "application/x-tex"} Cat \rightleftarrows V Cat
          #GenUnderlying.num_example
            %h6#example_3 Example
            %p
              More generally, if an adjunction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %msub
                      %mi V
                      %mn 1
                    %mo ⇄
                    %msub
                      %mi V
                      %mn 2
                    %mo :
                    %mi U
                  %annotation{:encoding => "application/x-tex"} F:V_1 \rightleftarrows V_2:U
              can be regarded as a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/free-forgetful+adjunction"} free-forgetful adjunction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mn 1
                    %mo =
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} V_1 = Top
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mn 2
                    %mo =
                    %mi G
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} V_2 = G Top
              for some
              %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological group
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mn 2
                    %mi Cat
                    %mo →
                    %msub
                      %mi V
                      %mn 1
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} V_2 Cat \to V_1 Cat
              takes the “underlying topologically enriched category” of a category enriched in
              = succeed "-spaces" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "-space-enriched" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "-equivariant" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/spectra"} spectra
              has an underlying category enriched in spaces (whose hom-spaces are the 0-spaces of the original hom-spectra), any
              %a.existingWikiWord{:href => "/nlab/show/dg-category"} dg-category
              has an underlying
              %a.existingWikiWord{:href => "/nlab/show/Ab-category"} Ab-category
              (whose morphisms are the degree-0 ones in the original category), and so on.
          #RealSing.num_example
            %h6#example_4 Example
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
              and
              %span.newWikiWord
                total singular complex
                %a{:href => "/nlab/new/total+singular+complex"} ?
              adjunction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Real
                    %mo :
                    %mi SSet
                    %mo ⇄
                    %mi Top
                    %mo :
                    %mi Sing
                  %annotation{:encoding => "application/x-tex"} Real:SSet \rightleftarrows Top : Sing
              between
              %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
              and
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              induces another adjunction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SSet
                    %mi Cat
                    %mo ⇄
                    %mi Top
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} SSet Cat \rightleftarrows Top Cat
              between
              %a.existingWikiWord{:href => "/nlab/show/simplicially+enriched+categories"} simplicially enriched categories
              and
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topologically+enriched+categories"} topologically enriched categories
          #HomotopyCat.num_example
            %h6#example_5 Example
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo =
                  %annotation{:encoding => "application/x-tex"} V=
              %a.existingWikiWord{:href => "/nlab/show/SSet"} SSet
              or
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mo :
                    %mi V
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} \pi_0:V\to Set
              is lax monoidal. The resulting change of enrichment functor takes a
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              to its “naive homotopy category”
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} h C(x,y) = \pi_0(C(x,y))
              obtained by “identifying homotopic morphisms”.
            %p
              Similarly, the
              %a.existingWikiWord{:href => "/nlab/show/fundamental+groupoid"} fundamental groupoid
              functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mn 1
                    %mo :
                    %mi V
                    %mo →
                    %mi Gpd
                  %annotation{:encoding => "application/x-tex"} \Pi_1:V\to Gpd
              is lax monoidal, so any
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%282%2C1%29-category"} (2,1)-category
          #EnrichedHomotopyCat.num_example
            %h6#example_6 Example
            %p
              An enhancement of the last example is that if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              is any
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/monoidal+model+category"} monoidal model category
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ho(V)
              comes with a lax monoidal functor
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi γ
                      %mo :
                      %mi V
                      %mo →
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \gamma : V \to Ho(V)
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              has an underlying
              = succeed "-enriched" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Ho(V)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                      %mi C
                    %annotation{:encoding => "application/x-tex"} h C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mi C
                  %annotation{:encoding => "application/x-tex"} h C
              is the naive homotopy category from the previous example.
          #Tau1.num_example
            %h6#example_7 Example
            %p
              The nerve functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo :
                    %mi Cat
                    %mo →
                    %mi SSet
                  %annotation{:encoding => "application/x-tex"} N:Cat \to SSet
              preserves products and has a left adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \tau_1
              that also preserves products. Thus, we have a change of enrichment adjunction in which any
              %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
              can be regarded as a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/simplicially+enriched+category"} simplicially enriched category
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/quasi-categories"} quasi-categories
          #PolyMorphisms.num_example
            %h6#example_8 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/poly-morphisms"}> poly-morphisms
                )
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo =
                    %mi P
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Set
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} F = P \;\colon\; Set \to Set
              the
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/power+set"} power set
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi P
                      %mo *
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Cat
                    %mo →
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"}
                    P_\ast \;\colon\;
                    Cat \to Cat
              sends plain
              %a.existingWikiWord{:href => "/nlab/show/categories"} categories
              to plain categories. For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              any category, the morphisms of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi poly
                    %mo ≔
                    %mi P
                    %mo *
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^{poly} \coloneqq P\ast(C)
              are called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/poly-morphisms"} poly-morphisms
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              in
              = succeed "." do
                %a{:href => "poly-morphism#Mochizuki12"} Mochizuki 12, section 0
          %h2#references References
          %ul
            %li#EilenbergKelly65
              %p
                %a.existingWikiWord{:href => "/nlab/show/Samuel+Eilenberg"}> Samuel Eilenberg
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Max+Kelly"} Max Kelly
                = succeed "," do
                  %em Closed categories
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/978-3-642-99902-4_22"} doi:10.1007/978-3-642-99902-4_22
            %li#Crutwell14
              %p
                %a.existingWikiWord{:href => "/nlab/show/Geoff+Cruttwell"}> Geoff Cruttwell
                , chapter 4 of:
                = succeed "," do
                  %em Normed spaces and the Change of Base for Enriched Categories
                = succeed ")" do
                  %a{:href => "https://www.reluctantm.com/gcruttw/publications/thesis4.pdf"} pdf
