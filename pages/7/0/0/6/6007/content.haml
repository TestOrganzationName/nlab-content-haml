                          %mi ℕ
                        %annotation{:encoding => "application/x-tex"} N \in \mathbb{N}
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/tubular+neighbourhood"} tubular neighbourhood
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi W
                        %mo ↪
                        %mi Y
                        %mo ×
                        %msup
                          %mi ℝ
                          %mi N
                      %annotation{:encoding => "application/x-tex"} W \hookrightarrow Y \times \mathbb{R}^N
                  of
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
              %li
                %p
                  a differential Thom cocycle, def.
                  = succeed "," do
                    %a.maruku-ref{:href => "#DifferentialThomCocycle"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                      %annotation{:encoding => "application/x-tex"} U
                  on
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi W
                          %mo →
                          %mi X
                        %annotation{:encoding => "application/x-tex"} W \to X
          %p
            This appears as (
            %a{:href => "#HopkinsSinger"}> HopkinsSinger, def. 2.9
            ).
          %h3#FiberIntegration Via differential Thom cocycles
          %p
            Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi H
                    %mi diff
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H^n_{diff}(-)
            for
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/ordinary+differential+cohomology"} ordinary differential cohomology
            %a.existingWikiWord{:href => "/nlab/show/compact+support"} compactly supported
            %a.existingWikiWord{:href => "/nlab/show/cocycles"} cocycles
            along trivial
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
            bundles
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                  %mo ×
                  %msup
                    %mi ℝ
                    %mi N
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y \times \mathbb{R}^N \to Y
            over a
            %a.existingWikiWord{:href => "/nlab/show/compact+space"} compact
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mrow
                      %msup
                        %mi ℝ
                        %mi N
                  %mo :
                  %msubsup
                    %mi H
                    %mrow
                      %mi diff
                      %mo ,
                      %mi cpt
                    %mrow
                      %mi n
                      %mo +
                      %mi N
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo ×
                  %msup
                    %mi ℝ
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msubsup
                    %mi H
                    %mi diff
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\int_{\mathbb{R}^N}
                  \: H^{n+N}_{diff,cpt}(Y \times \mathbb{R}^n)
                  \\to
                  H^n_{diff}(Y)
                  \\,.
          .num_defn
            %h6#definition_4 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \to Y
              be a
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              equipped with differential
              = succeed "-orientation" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} H\mathbb{Z}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              = succeed "." do
                %a.maruku-ref{:href => "#DifferentialOrientation"}
              %strong fiber integration
              of ordinary differential cohomology is the composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mrow
                        %mi X
                        %mo{:stretchy => "false"} /
                        %mi Y
                    %mo :
                    %msubsup
                      %mi H
                      %mi diff
                      %mrow
                        %mi n
                        %mo +
                        %mi k
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo ∪
                        %mi U
                    %msubsup
                      %mi H
                      %mrow
                        %mi diff
                        %mo ,
                        %mi cpt
                      %mrow
                        %mi n
                        %mo +
                        %mi N
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %msup
                      %mi ℝ
                      %mi N
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mo ∫
                          %mrow
                            %msup
                              %mi ℝ
                              %mi N
                    %msubsup
                      %mi H
                      %mi diff
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\int_{X/Y} :
                    H_{diff}^{n+k}(X)
                    \\stackrel{(-)\cup U}{\to}
                    H_{diff, cpt}^{n+N}(X \times \mathbb{R}^N)
                    \\stackrel{\int_{\mathbb{R}^N}}{\to}
                    H_{diff}^n(Y)
                    \\,.
          %p
            This appears as (
            %a{:href => "#HopkinsSinger"}> HopkinsSinger, def. 3.11
            ).
          %h3#ViaDeligneComplex In terms of Deligne cocycles
          %p
            We discuss an explicit formula for fiber integration along
            = succeed "-bundles" do
              %a.existingWikiWord{:href => "/nlab/show/product"} product
            %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
            %a.existingWikiWord{:href => "/nlab/show/fibers"} fibers
            in terms of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Deligne+complex"} Deligne complex
            = succeed ")." do
              %a{:href => "#GomiTerashima00"} Gomi-Terashima 00
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
