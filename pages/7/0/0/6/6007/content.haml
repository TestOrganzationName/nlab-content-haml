                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} [\hat \omega] \in H^{k}_{compact}(V, \mathbb{Z})
              in
              %a.existingWikiWord{:href => "/nlab/show/compact+support"} compactly supported
              %a.existingWikiWord{:href => "/nlab/show/integral+cohomology"} integral cohomology
              is an ordinary
              %a.existingWikiWord{:href => "/nlab/show/Thom+class"} Thom class
