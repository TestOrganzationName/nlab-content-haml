          #DifferentialOrientation.num_defn
            %h6#definition_3 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} p : X \to Y
              be a
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              of
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            %p
              An
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi H
                      %msub
                        %mi ℤ
                        %mi diff
                    %annotation{:encoding => "application/x-tex"} H \mathbb{Z}_{diff}
                \-orientation
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              is
            %ol
              %li
                %p
                  A factorization through an
                  %a.existingWikiWord{:href => "/nlab/show/embedding+of+smooth+manifolds"} embedding of smooth manifolds
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %mo :
                        %mi X
                        %mo ↪
                        %mi Y
                        %mo ×
                        %msup
                          %mi ℝ
                          %mi N
                        %mover
                          %mo →
                          %mrow
                        %mi Y
                      %annotation{:encoding => "application/x-tex"}
                        p : X \hookrightarrow Y \times \mathbb{R}^N \stackrel{}{\to} Y
                %p
                  for some
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi N
