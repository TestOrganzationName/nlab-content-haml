          %h2#in_category_theory In category theory
          .num_defn
            %h6#definition Definition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/regular+cardinal"} regular cardinal
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi κ
                    %annotation{:encoding => "application/x-tex"} \kappa
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f: A\to B
              in a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi κ
                    %annotation{:encoding => "application/x-tex"} \kappa
                \-pure
              (or
              = succeed ")" do
                %strong
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi κ
                      %annotation{:encoding => "application/x-tex"} \kappa
                  \-universally injective
              %a.existingWikiWord{:href => "/nlab/show/commutative+square"} commutative square
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi P
                          %mtd
                            %mover
                              %mo ⟶
                              %mi g
                          %mtd
                            %mi Q
                        %mtr
                          %mtd
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %msup
                                  %mo
                                  %mi u
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                          %mtd
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %msup
                                  %mo
                                  %mi v
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %munder
                              %mo ⟶
                              %mi f
                          %mtd
                            %mi B
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    P
                    \&amp;
                    \\overset{g}
                    {\longrightarrow}
                    \&amp;
                    Q
                    \\\
                    \\mathllap{^u}
                    \\big\downarrow
                    \&amp;&amp;
                    \\big\downarrow
                    \\mathrlap{^v}
                    \\\
                    A
                    \&amp;
                    \\underset{f}
                    {\longrightarrow}
                    \&amp;
                    B
                    }
            %p
              in which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
              are
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi κ
                    %annotation{:encoding => "application/x-tex"} \kappa
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/presentable+objects"} presentable objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo{:lspace => "verythinmathspace"} :
                    %mi P
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} u \colon P\to A
              factors through
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo :
                    %mi Q
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} h: Q\to A
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                      %mo =
                      %mi h
                      %mo ∘
                      %mi g
                    %annotation{:encoding => "application/x-tex"} u = h\circ g
          .num_remark
            %h6#remark Remark
            %p
              Notice that the above definition does not require that also the morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              is factored, hence it does
              %em not
              express a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/lifting+property"} lifting property
          .num_prop
            %h6#proposition Proposition
            %ul
              %li
                %p
                  In a
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi κ
                        %annotation{:encoding => "application/x-tex"} \kappa
                  %a.existingWikiWord{:href => "/nlab/show/accessible+category"} accessible category
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  every
                  = succeed "-pure" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi κ
                        %annotation{:encoding => "application/x-tex"} \kappa
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/pure+subobject"} pure subobject
              %li
                %p
                  In a
                  %a.existingWikiWord{:href => "/nlab/show/locally+presentable+category"}
                    locally
                    = succeed "-presentable" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi κ
                          %annotation{:encoding => "application/x-tex"} \kappa
                  = succeed "-pure" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi κ
                        %annotation{:encoding => "application/x-tex"} \kappa
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/regular+monomorphisms"} regular monomorphisms
              %li
                %p
                  and in fact coincide with the
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi κ
                        %annotation{:encoding => "application/x-tex"} \kappa
                  %a.existingWikiWord{:href => "/nlab/show/directed+colimits"} directed colimits
                  of
                  %a.existingWikiWord{:href => "/nlab/show/split+monomorphisms"} split monomorphisms
                  in the
                  %a.existingWikiWord{:href => "/nlab/show/arrow+category"} arrow category
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi C
                            %mn 2
                          %mo =
                          %mi Arr
                          %mo{:stretchy => "false"} (
                          %mi C
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} C^2 = Arr(C)
              %li
                %p
                  more generally this characterization holds in all
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi κ
                        %annotation{:encoding => "application/x-tex"} \kappa
                  %a.existingWikiWord{:href => "/nlab/show/accessible+categories"} accessible categories
                  admitting
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/pushouts"} pushouts
          %p
            (
            %a{:href => "#AHT96"}> Adámek-Hub-Tholen 1996
            ).
          %h2#in_ring_theory_and_for_schemes In ring theory and for schemes
          %p
            Consider
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/unital+ring"} unital
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative
            %a.existingWikiWord{:href => "/nlab/show/rings"} rings
            and their
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/modules"} modules
          %p
          #PureMorphismOfRings.num_defn
            %h6 Definition
            %p
              Given such a ring
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi M
                    %mo →
                    %mi M
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} f \colon M\to M'
              of left
              = succeed "-modules" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %em pure
              if
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+modules"} tensoring
              the
              %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exact sequence
              of left
              = succeed "-modules" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mi Ker
                    %mi f
                    %mo ⟶
                    %mi M
                    %mover
                      %mo ⟶
                      %mi f
                    %mi M
                    %mo ′
                    %mo ⟶
                    %mi Coker
                    %mi f
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    0
                    \\to
                    Ker f
                    \\longrightarrow
                    M
                    \\overset{f}
                    {\longrightarrow}
                    M'
                    \\longrightarrow
                    Coker f
                    \\to
                    0
            %p
              with any right
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              (from the left) yields a
              %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exact sequence
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
          %p
          .num_remark
            %h6 Remark
            %p
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck"} Grothendieck
              has proved that
              %a.existingWikiWord{:href => "/nlab/show/faithfully+flat+morphisms"} faithfully flat morphisms
              of commutative
              %a.existingWikiWord{:href => "/nlab/show/schemes"} schemes
              are of
              %a.existingWikiWord{:href => "/nlab/show/effective+descent"} effective descent
              for the categories of
              %a.existingWikiWord{:href => "/nlab/show/quasicoherent+module"} quasicoherent
              = succeed "-modules." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒪
                    %annotation{:encoding => "application/x-tex"} \mathcal{O}
              %a{:href => "#JoyalTierney84"} Joyal &amp; Tierney (1984)
              have then proved (unpublished) that the
              %a.existingWikiWord{:href => "/nlab/show/effective+descent+morphisms"} effective descent morphisms
              for modules are precisely the pure morphisms of rings (or dually of affine schemes) accotding to Def
              = succeed "." do
                %a.maruku-ref{:href => "#PureMorphismOfRings"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Galois+theory"} Galois theory
              %a{:href => "#JanelidzeTholen04"} Janelidze &amp; Tholen (2004)
              have reproved this theorem as a
              %a.existingWikiWord{:href => "/nlab/show/corollary"} corollary
              of a result for
              %a.existingWikiWord{:href => "/nlab/show/noncommutative+rings"} noncommutative rings
              obtained using Beck’s
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/comonadicity+theorem"} comonadicity theorem
          %h2#related_concepts Related concepts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/pure+subobject"} pure subobject
          %h2#references References
          %h4#general_references General references
          %ul
            %li
              The
              = succeed "," do
                %a{:href => "https://stacks.math.columbia.edu"} Stacks Project
              = succeed "," do
                %a{:href => "https://stacks.math.columbia.edu/tag/01S2"} tag/01S2
              %a{:href => "https://stacks.math.columbia.edu/tag/08WE"} tag/08WE
          %h4#descent_along_pure_morphisms Descent along pure morphisms
          %p The following paper was the first with the result on that pure morhisms are of the effective descent but the proof has been omitted:
          %ul
            %li
              Jean-Pierre Olivier,
              = succeed "," do
                %em Descente par morphismes purs
              %strong 271
              (1970) A821–A823
          %p The result is proved (within a larger context)
          %ul
            %li#JoyalTierney84
              %a.existingWikiWord{:href => "/nlab/show/Andr%C3%A9+Joyal"}> André Joyal
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Myles+Tierney"} Myles Tierney
              = succeed "," do
                %em An extension of the Galois theory of Grothendieck
              %strong 309
              (1984) vol. 51, pages vii+71
          %p Clean proofs are by Mesablishvili and by Janelidze,
          %ul
            %li
              %p
                Bachuki Mesablishvili,
                = succeed "," do
                  %em Pure morphisms of commutative rings are effective descent morphisms for modules – a new proof
                = succeed "," do
                  %strong 7
                %a{:href => "http://www.tac.mta.ca/tac/volumes/7/n3/7-03abs.html"} tac
            %li
              %p
                Bachuki Mesablishvili,
                = succeed "," do
                  %em Pure morphisms are effective for modules
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/1206.3439"} arXiv
                = succeed "." do
                  %a{:href => "https://doi.org/10.1007/s10485-012-9283-6"} doi
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/T.+Brzezi%C5%84ski"}> T. Brzeziński
                , R. Wisbauer,
                = succeed "," do
                  %em Corings and comodules
                = succeed "," do
                  %strong 309
                %a{:href => "http://maths.swan.ac.uk/staff/tb/corinerr.pdf"} errata pdf
            %li#JanelidzeTholen04
          %p
            %a.existingWikiWord{:href => "/nlab/show/George+Janelidze"}> George Janelidze
            ,
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Walter+Tholen"} Walter Tholen
            = succeed "," do
              %em Facets of descent III: monadic descent for rings and algebras
            %strong 12
            5-6 (2004) 461-477 &amp;lbrack;
            %a{:href => "http://www.ams.org/mathscinet-getitem?mr=2107397"}> MR2005i:13019
            ,
            = succeed "&rbrack;" do
              %a{:href => "http://dx.doi.org/10.1023/B:APCS.0000049312.36783.0a"} doi
          %p Much attention on the descent along pure morphism is in a recent survey
          %ul
            %li
              Yves André, Luisa Fiorot,
              = succeed "," do
                %em On the canonical, fpqc, and finite topologies on affine schemes. The state of the art
              %a{:href => "https://arxiv.org/abs/1912.04957"} arXiv:1912.04957
          %h4#ziegler_spectrum_and_connections_to_model_theory Ziegler spectrum and connections to model theory
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/Ziegler+spectrum"} Ziegler spectrum
            of indecomposable pure injectives has been introduced in
          %ul
            %li
              M. Ziegler,
              = succeed "," do
                %em Model theory of modules
          %p A textbook account is in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Mike+Prest"}> Mike Prest
              ,
              = succeed "," do
                %em Purity, spectra and localisation
              = succeed "," do
                %strong 121
              %a{:href => "http://www.cambridge.org/gb/knowledge/isbn/item2327409/?site_locale=en_GB"} page
          %p
            The relationship between the
            %a.existingWikiWord{:href => "/nlab/show/Ziegler+spectrum"} Ziegler spectrum
            of (the category of modules over) a ring and the Ziegler spectrum of its derived category is studied in
          %ul
            %li
              G. Garkusha, M. Prest,
              = succeed "," do
                %em Triangulated categories and the Ziegler spectrum
              %a{:href => "https://doi.org/10.1007/s10468-005-8147-2"} doi
          %p Other articles:
          %ul
            %li
              %p
                M. Prest, P. Rothmaler, M. Ziegler,
                = succeed "," do
                  %em Absolutely pure and flat modules and “indiscrete” rings
                = succeed ":2" do
                  %strong 174
                %a{:href => "https://doi.org/10.1006/jabr.1995.1131"} doi
            %li
              %p
                Christian U. Jensen, Helmut Lenzing,
                = succeed "," do
                  %em Model theoretic algebra: with particular emphasis on fields, rings, modules
                = succeed "," do
                  %strong 2
            %li
              %p
                I. Herzog,
                = succeed "," do
                  %em The Ziegler spectrum of a locally coherent Grothendieck category
                = succeed ":3" do
                  %strong 74
                %a{:href => "https://doi.org/10.1112/S002461159700018X"} doi
          %h4#other_categoey_theoretic_articles Other categoey theoretic articles
          %ul
            %li
              %p
                Ivo Herzog,
                = succeed "," do
                  %em Pure-injective envelopes
                %a{:href => "http://lima.osu.edu/people/iherzog/env.pdf"} pdf
            %li#AHT96
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ji%C5%99%C3%AD+Ad%C3%A1mek"}> Jiří Adámek
                , H. Hub,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Walter+Tholen"} Walter Tholen
                = succeed "," do
                  %em On pure morphisms in accessible categories
                = succeed "," do
                  %strong 107
                %a{:href => "http://dx.doi.org/10.1016/0022-4049(95)00037-2"} doi
            %li
              %p
                Michel Hébert,
                = succeed "," do
                  %em Purity and injectivity in accessible categories
                %a{:href => "http://dx.doi.org/10.1016/S0022-4049(97)00073-X"} doi
            %li
              %p
                W.W. Crawley-Boevey,
                = succeed "," do
                  %em Locally finitely presented additive categories
                = succeed "(5)(1994)," do
                  %strong 22
            %li
              %p
                Rosanna Laking,
                = succeed "," do
                  %em Purity in compactly generated derivators and t-structures with Grothendieck hearts
                %a{:href => "https://10.1007/s00209-019-02411-9"} doi
                (2019).
