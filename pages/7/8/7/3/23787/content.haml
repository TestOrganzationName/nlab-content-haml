          %h2#definition Definition
          %p
            For a
            %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %strong sequence algebra
            is the
            %a.existingWikiWord{:href => "/nlab/show/commutative+algebra"}
              commutative
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
