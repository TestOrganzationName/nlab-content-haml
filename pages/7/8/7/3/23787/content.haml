            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %strong infinite product operator
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi ℕ
                  %mo →
                  %mi R
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi ℕ
                  %mo →
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Pi:(\mathbb{N} \to R) \to (\mathbb{N} \to R)
          %p is inductively defined as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                  %mi x
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mi x
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Pi x(0) \coloneqq x(0)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                  %mi x
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo +
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mi Π
                  %mi x
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo{:stretchy => "false"} )
                  %mo ⋅
                  %mi x
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo +
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Pi x(i + 1) \coloneqq \Pi x(i) \cdot x(i + 1)
          %p
            for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} i \in \mathbb{N}
          %p
            For any such sequence
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi ℕ
                    %mo →
                    %mi R
                  %annotation{:encoding => "application/x-tex"} x:\mathbb{N} \to R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                  %mi x
                %annotation{:encoding => "application/x-tex"} \Pi x
            is called an
            = succeed "." do
              %strong
                %a.existingWikiWord{:href => "/nlab/show/infinite+product"} infinite product
          %h3#discrete_convolution Discrete convolution
          %p
            Given a commutative ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            and sequence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi ℕ
                  %mo →
                  %mi R
                %annotation{:encoding => "application/x-tex"} x:\mathbb{N} \to R
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo :
                    %mi ℕ
                    %mo →
                    %mi R
                  %annotation{:encoding => "application/x-tex"} y:\mathbb{N} \to R
            %strong discrete convolution
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo *
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi ℕ
                  %mo →
                  %mi R
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mo{:stretchy => "false"} (
                  %mi ℕ
                  %mo →
                  %mi R
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi ℕ
                  %mo →
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (-)*(-):(\mathbb{N} \to R) \times (\mathbb{N} \to R) \to (\mathbb{N} \to R)
          %p is defined as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo *
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi n
                      %mo :
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mi i
                      %mo{:stretchy => "false"} ]
                  %mi x
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo{:stretchy => "false"} )
                  %mi y
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo −
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (x*y)(i) \coloneqq \sum_{n:[0,i]} x(i) y(i - n)
          %p
            for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} i \in \mathbb{N}
          %p
            Given a commutative ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            and sequence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi ℕ
                  %mo →
                  %mi R
                %annotation{:encoding => "application/x-tex"} x:\mathbb{N} \to R
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo :
                    %mi ℕ
                    %mo →
                    %mi R
                  %annotation{:encoding => "application/x-tex"} y:\mathbb{N} \to R
            %strong Cauchy product
            of the two series
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                  %mi x
                  %mo ⋅
                  %mi Σ
                  %mi x
                %annotation{:encoding => "application/x-tex"} \Sigma x \cdot \Sigma x
            is the discrete convolution of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                  %mi x
                  %mo ⋅
                  %mi Σ
                  %mi y
                  %mo ≔
                  %mi x
                  %mo *
                  %mi y
                %annotation{:encoding => "application/x-tex"} \Sigma x \cdot \Sigma y \coloneqq x * y
          %h3#sequential_derivative Sequential derivative
          %p
            Given a commutative ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            and a sequence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi ℕ
                  %mo →
                  %mi R
                %annotation{:encoding => "application/x-tex"} x:\mathbb{N} \to R
            of terms in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %strong sequential derivative
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒟
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi ℕ
                  %mo →
                  %mi R
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi ℕ
                  %mo →
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{D}:(\mathbb{N} \to R) \to (\mathbb{N} \to R)
          %p is defined as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒟
                  %mi x
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo +
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mi x
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo +
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{D} x(i) \coloneqq (i + 1) x(i + 1)
          %p
            for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} i \in \mathbb{N}
          %p
            The sequential derivative is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
            %a.existingWikiWord{:href => "/nlab/show/Leibniz+rule"} Leibniz rule
            is satisfied for the Cauchy product of sequences. As a result, every sequence algebra is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/differential+algebra"} differential algebra
          %h3#right_shift_operators Right shift operators
          %p
            Given a commutative ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            and a sequence
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi ℕ
                    %mo →
                    %mi R
                  %annotation{:encoding => "application/x-tex"} x:\mathbb{N} \to R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            is the
            %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
            of the left shift operator at
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi y
                  %mo :
                  %mi ℕ
                  %mo →
                  %mi R
                  %mo{:stretchy => "false"} |
                  %mi T
                  %mi y
                  %mo =
                  %mi x
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{y:\mathbb{N} \to R \vert T y = x\}
          %p A right shift operator is an element of the above set.
          %p
            Every sequence in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            has a right shift operator
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi T
                    %mi s
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi ℕ
                  %mo →
                  %mi R
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi ℕ
                  %mo →
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} T^{-1}_s:(\mathbb{N} \to R) \to (\mathbb{N} \to R)
            for every term
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo ∈
                    %mi R
                  %annotation{:encoding => "application/x-tex"} r \in R
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi T
                    %mi r
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mi x
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi r
                %annotation{:encoding => "application/x-tex"} T^{-1}_r x(0) = r
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi T
                    %mi r
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mi x
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo +
                  %mi i
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mi x
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} T^{-1}_r x(i + i) \coloneqq x(i)
          %p
            for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} i \in \mathbb{N}
          %h3#sequential_antiderivatives Sequential antiderivatives
          %p
            Given a commutative ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            and a sequence
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi ℕ
                    %mo →
                    %mi R
                  %annotation{:encoding => "application/x-tex"} x:\mathbb{N} \to R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            is the
            %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
            of the sequential derivative at
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi y
                  %mo :
                  %mi ℕ
                  %mo →
                  %mi R
                  %mo{:stretchy => "false"} |
                  %mi 𝒟
                  %mi y
                  %mo =
                  %mi x
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{y:\mathbb{N} \to R \vert \mathcal{D} y = x\}
          %p
            A
            %strong sequential antiderivative
            is a element of the above set.
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is a commutative
            = succeed "-algebra," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Q}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            has an antiderivative operator
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi 𝒟
                    %mi r
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi ℕ
                  %mo →
                  %mi R
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi ℕ
                  %mo →
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{D}^{-1}_r:(\mathbb{N} \to R) \to (\mathbb{N} \to R)
            for every term
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo ∈
                    %mi R
                  %annotation{:encoding => "application/x-tex"} r \in R
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi 𝒟
                    %mi r
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mi x
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi r
                %annotation{:encoding => "application/x-tex"} \mathcal{D}^{-1}_r x(0) = r
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi 𝒟
                    %mi r
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mi x
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo +
                  %mi i
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mfrac
                    %mn 1
                    %mi i
                  %mi x
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{D}^{-1}_r x(i + i) \coloneqq \frac{1}{i} x(i)
          %p
            for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} i \in \mathbb{N}
          %h2#sequence_functions Sequence functions
          %p
            Given a commutative ring
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %strong sequence function
            is a function
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi R
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi ℕ
                    %mo →
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f:R \to (\mathbb{N} \to R)
          %h3#functional_shift_operator Functional shift operator
          %p
            Given a commutative ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            and a sequence function
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi R
                    %mo →
