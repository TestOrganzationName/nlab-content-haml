                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℕ
                    %mo →
                    %mi R
                  %annotation{:encoding => "application/x-tex"} \mathbb{N} \to R
            %a.existingWikiWord{:href => "/nlab/show/injection"} injection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo{:lspace => "verythinmathspace"} :
                  %mi R
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi ℕ
                  %mo →
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} c \colon R \to (\mathbb{N} \to R)
            which sends each
            %a.existingWikiWord{:href => "/nlab/show/element"} element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                %annotation{:encoding => "application/x-tex"} r
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            to a
            %a.existingWikiWord{:href => "/nlab/show/constant+function"} constant function
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo{:stretchy => "false"} (
                    %mi r
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} c(r)
            %a.existingWikiWord{:href => "/nlab/show/commutative+algebra"} commutative algebra
            operations are pointwise defined as:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo{:stretchy => "false"} (
                  %mi r
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mi r
                %annotation{:encoding => "application/x-tex"} c(r)(n) \coloneqq r
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0(n) \coloneqq 0
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo +
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mi x
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mi y
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (x + y)(n) \coloneqq x(n) + y(n)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi x
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (-x)(n) \coloneqq -x(n)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi r
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mi r
                  %mi x
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (r x)(n) \coloneqq r x(n)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo ≔
