                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mo +
                  %mo{:stretchy => "false"} )
