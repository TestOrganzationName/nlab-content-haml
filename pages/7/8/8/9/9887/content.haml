            of
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mo +
                  %mo ⟶
                  %mi B
                  %mi U
                  %mo ×
                  %mi ℤ
                  %mo ≃
                  %msup
                    %mi Ω
                    %mn ∞
                  %mi K
                  %mi U
