                %annotation{:encoding => "application/x-tex"} [E]- n \mapsto ([E] - rk(E)) + ( rk(E) - n )
            (
            %a{:href => "topological+K-theory#KGrupDirectSummandReducedKGroup"}> this prop
            ) it follows that
          %ol
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi i
                        %mo{:stretchy => "false"} ˜
                    %annotation{:encoding => "application/x-tex"} \tilde i
                takes the canonical line bundle
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒪
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathcal{O}(1)
                on
                %a.existingWikiWord{:href => "/nlab/show/BU%28n%29"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
