            %a.existingWikiWord{:href => "/nlab/show/compact+topological+spaces"} compact topological spaces
            K-theory splits as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
