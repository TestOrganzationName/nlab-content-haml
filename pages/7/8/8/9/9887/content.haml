            %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
            of the canonical
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒪
