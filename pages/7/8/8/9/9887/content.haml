            via
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi E
                  %mo{:stretchy => "false"} ]
                  %mo −
                  %mi n
                  %mo ↦
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} [
                  %mi E
                  %mo{:stretchy => "false"} ]
                  %mo −
                  %mi rk
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mo{:stretchy => "false"} (
