          #WeylRelations.num_example
            %h6#example_2 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Weyl+relations"}> Weyl relations
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
              a
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              with
              %a.existingWikiWord{:href => "/nlab/show/Green+hyperbolic+differential+equation"} Green hyperbolic
              %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
              and with
              %a.existingWikiWord{:href => "/nlab/show/Wightman+propagator"} Wightman propagator
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Δ
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \Delta_H
            %p Then for
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 1
                    %mo ,
                    %msub
                      %mi A
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi LinObs
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi mc
                    %mo ↪
                    %mi PolyObs
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi mc
                  %annotation{:encoding => "application/x-tex"}
                    A_1, A_2
                    \\;\in\;
                    LinObs(E,\mathbf{L})_{mc}
                    \\hookrightarrow
                    PolyObs(E,\mathbf{L})_{mc}
            %p
              two
              %a.existingWikiWord{:href => "/nlab/show/linear+observables"} linear
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/microcausal+observables"} microcausal observables
              = succeed ")" do
                %a.maruku-ref{:href => "#MoyalStarProductOnMicrocausal"}
              %a.existingWikiWord{:href => "/nlab/show/exponentials"} exponentials
              exhibits the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Weyl+relations"} Weyl relations
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi e
                      %mrow
                        %msub
                          %mi A
                          %mn 1
                    %msub
                      %mo ⋆
                      %mi H
                    %msup
                      %mi e
                      %mrow
                        %msub
                          %mi A
                          %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi e
                      %mrow
                        %msub
                          %mi A
                          %mn 1
                        %mo +
                        %msub
                          %mi A
                          %mn 2
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi e
                      %mrow
                        %mo{:stretchy => "false"} ⟨
                        %msub
                          %mi A
                          %mn 1
                        %msub
                          %mi A
                          %mn 2
                        %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"}
                    e^{A_1}
                    \\star_H
                    e^{A_2}
                    \\;=\;
                    e^{A_1 + A_2} \; e^{\langle A_1 A_2\rangle}
            %p
              where on the right we have the
              %a.existingWikiWord{:href => "/nlab/show/exponential"} exponential
              %a.existingWikiWord{:href => "/nlab/show/Wightman+2-point+function"} Wightman 2-point function
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:StarProductOfTwoLinearObservables"} (1)
