                                  %msub
                                    %mi a
                                    %mn 2
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi x
                                %mn 2
                              %mo{:stretchy => "false"} )
                              %mo )
                            %mspace{:width => "thickmathspace"}
                            %mi mod
