                    \\,
                    (\alpha_2)_{a_2}(x_2)
                    \\, dvol_\Sigma(x_1)
                    \\, dvol_\Sigma(x_2)
                    \\\
                    \&amp; \coloneqq
                    \\tfrac{1}{2}
                    i \hbar \int \int
                    (\alpha_1)_{a_1}(x_1) \Delta_H^{a_1 a_2}(x_1,x_2) (\alpha_2)_{a_2}(x_2)
                    \\,dvol_\Sigma(x_1)
                    \\,dvol_\Sigma(x_2)
