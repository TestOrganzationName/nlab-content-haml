                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    A_1 \star_H A_2
                    \-
                    A_2 \star_H A_1
                    \&amp; =
                    i \hbar
                    \\left(
                    \\int
                    (\alpha_1)_{a_1}(x_1)
                    \\Delta^{a_1 a_2}(x_1, x_2)
                    (\alpha_2)_{a_2}(x_2)
                    \\right)
