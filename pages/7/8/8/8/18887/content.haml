              of their pointwise product with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mn 2
                    %mi i
                    %mi ℏ
                  %annotation{:encoding => "application/x-tex"} \tfrac{1}{2} i \hbar
              times the evaluation
