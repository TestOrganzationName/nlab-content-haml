                    \\,.
            %p
              The right hand side is the
              = succeed "-expression" do
                %a.existingWikiWord{:href => "/nlab/show/integral+kernel"} integral kernel
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Poisson-Peierls+bracket"} Poisson-Peierls bracket
          .num_example
            %h6#example Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Hadamard+vacuum+state"} Hadamard vacuum state
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/2-point+function"} 2-point function
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi i
                    %mo ∈
                    %mi LinObs
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi mc
                    %mo ↪
                    %mi PolyObs
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi mc
                  %annotation{:encoding => "application/x-tex"}
                    A_i \in LinObs(E,\mathbf{L})_{mc} \hookrightarrow PolyObs(E,\mathbf{L})_{mc}
            %p
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} i \in \{1,2\}
              be two
              %a.existingWikiWord{:href => "/nlab/show/linear+observable"} linear
              %a.existingWikiWord{:href => "/nlab/show/microcausal+observables"} microcausal observables
              represented by
              %a.existingWikiWord{:href => "/nlab/show/distributions"} distributions
