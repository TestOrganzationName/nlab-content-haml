                  %msub
                    %mover
                      %mi ℳ
                      %mo ˜
                    %mi η
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ⟩
                  %mo .
                %annotation{:encoding => "application/x-tex"}
