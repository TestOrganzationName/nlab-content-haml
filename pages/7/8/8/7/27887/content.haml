                  \\coloneqq\langle c_1(\mathcal{M}_\eta)^{\frac{dim\widetilde\mathcal{M}_\eta}{2}},[\widetilde\mathcal{M}_\eta]\rangle.
          %h2#related_entries Related entries
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+moduli+space"} Yang-Mills moduli space
              (instanton moduli space)
          %h2#references References
          %ul
            %li#Donaldson96
              %p
                %a.existingWikiWord{:href => "/nlab/show/Simon+Donaldson"}> Simon Donaldson
                ,
                %em The Seiberg-Witten equations and 4-manifold topology
                (1996),
                %em
                  Bulletin of the American Mathematical Society,
                  %em 33
                  (1): 45–70, &amp;lbrack;
