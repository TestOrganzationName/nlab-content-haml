            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/fiber+bundle"} fiber bundle
            %a.existingWikiWord{:href => "/nlab/show/Seiberg-Witten+equations"} Seiberg-Witten equations
            are considered with a perturbation. For this, the self-dual Betti number is important:
          %ul
            %li
              %p
                If
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi b
                          %mo +
                        %mo{:stretchy => "false"} (
                        %mi M
                        %mo{:stretchy => "false"} )
                        %mo ≥
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} b_+(M)\geq 1
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                      %mo ∈
                      %msubsup
                        %mi Ω
                        %mo +
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %mi M
                      %mo{:stretchy => "false"} )
                      %mo ∖
                      %mi Π
                      %mo ≠
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} \eta\in\Omega_+^2(M)\setminus\Pi\neq\emptyset
                forces solutions of the
                %a.existingWikiWord{:href => "/nlab/show/perturbed+Seiberg-Witten+equations"} perturbed Seiberg-Witten equations
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ψ
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \psi=0
                to fulfill
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi F
                          %mi A
                          %mo +
                        %mo =
                        %mi η
                      %annotation{:encoding => "application/x-tex"} F_A^+=\eta
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi η
                        %mo ∉
                        %mi Π
                      %annotation{:encoding => "application/x-tex"} \eta\notin\Pi
                %a.existingWikiWord{:href => "/nlab/show/moduli+spaces"} moduli spaces
                avoid all singularities in this case and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mover
                          %mi ℳ
                          %mo ˜
                        %mi η
                      %mo →
                      %msub
                        %mi ℳ
                        %mi η
                    %annotation{:encoding => "application/x-tex"} \widetilde\mathcal{M}_\eta\rightarrow\mathcal{M}_\eta
                becomes a
                %a.existingWikiWord{:href => "/nlab/show/principal+U%281%29-bundle"} principal U(1)-subbundle
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mover
                          %mi ℬ
                          %mo ˜
                        %mo *
                      %mo →
                      %msup
                        %mi ℬ
                        %mo *
                    %annotation{:encoding => "application/x-tex"} \widetilde\mathcal{B}^*\rightarrow\mathcal{B}^*
                with first
                %a.existingWikiWord{:href => "/nlab/show/Chern+class"} Chern class
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi c
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %msub
                          %mover
                            %mi ℳ
                            %mo ˜
                          %mi η
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %msup
                          %mi H
                          %mn 2
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi ℳ
                          %mi η
                        %mo ,
                        %mi ℤ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} c_1(\widetilde\mathcal{M}_\eta)\in H^2(\mathcal{M}_\eta,\mathbb{Z})
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Seiberg-Witten+invariants"} Seiberg-Witten invariants
            %li
              %p
                If
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
