                        %mo{:stretchy => "false"} (
                        %mi M
                        %mo{:stretchy => "false"} )
                        %mo ≥
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} b_+(M)\geq 2
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi η
                        %mn 1
                      %mo ,
                      %msub
                        %mi η
                        %mn 2
                      %mo ∈
                      %msubsup
                        %mi Ω
                        %mo +
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %mi M
                      %mo{:stretchy => "false"} )
                      %mo ∖
                      %mi Π
                      %mo ≠
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} \eta_1,\eta_2\in\Omega_+^2(M)\setminus\Pi\neq\emptyset
                can furthermore be connected by a path
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi γ
                        %mo{:lspace => "verythinmathspace"} :
