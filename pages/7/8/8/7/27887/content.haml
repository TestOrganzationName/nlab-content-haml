                        %mo ∖
                        %mi Π
                      %annotation{:encoding => "application/x-tex"} \gamma\colon[0,1]\rightarrow\Omega_+^2(M)\setminus\Pi
                %a.existingWikiWord{:href => "/nlab/show/bordism"} bordism
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mover
                            %mi ℳ
                            %mo ˜
                          %mrow
                            %msub
                              %mi η
                              %mn 1
                        %mo →
                        %msub
                          %mover
                            %mi ℳ
                            %mo ˜
                          %mrow
                            %msub
                              %mi η
                              %mn 2
                      %annotation{:encoding => "application/x-tex"} \widetilde\mathcal{M}_{\eta_1}\rightarrow\widetilde\mathcal{M}_{\eta_2}
                %a.existingWikiWord{:href => "/nlab/show/bordism"} bordism
                class. (
                %a{:href => "#Moore10"}> Moore 2010, p. 100
                ) (If
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi b
                          %mo +
                        %mo{:stretchy => "false"} (
                        %mi M
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} b_+(M)=1
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi Ω
                          %mo +
                          %mn 2
                        %mo{:stretchy => "false"} (
                        %mi M
                        %mo{:stretchy => "false"} )
                        %mo ∖
                        %mi Π
                      %annotation{:encoding => "application/x-tex"} \Omega_+^2(M)\setminus\Pi
                = succeed ".)" do
                  %a.existingWikiWord{:href => "/nlab/show/bordism+classes"} bordism classes
          %p
            For the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Seiberg-Witten+invariant"} Seiberg-Witten invariant
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Chern+number"} Chern number
            %a.existingWikiWord{:href => "/nlab/show/cup+products"} cup products
            of the
            %a.existingWikiWord{:href => "/nlab/show/Chern+class"} Chern class
            with itself is evaluated with the
            %a.existingWikiWord{:href => "/nlab/show/fundamental+class"} fundamental class
            of the
            %a.existingWikiWord{:href => "/nlab/show/moduli+space"} moduli space
            in the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Kronecker+pairing"} Kronecker pairing
            %a.existingWikiWord{:href => "/nlab/show/Chern+class"} Chern class
            has even degree, the
            %a.existingWikiWord{:href => "/nlab/show/moduli+space"} moduli space
            must have even dimension for this to work and it furthermore has to be known precisely for the amount of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cup+products"} cup products
            %a.existingWikiWord{:href => "/nlab/show/index"} index
            of the
            %a.existingWikiWord{:href => "/nlab/show/Dirac+operator"} Dirac operator
            and then applying the
            %a.existingWikiWord{:href => "/nlab/show/Atiyah-Singer+index+theorem"} Atiyah-Singer index theorem
            yields formulas containing the
            %a.existingWikiWord{:href => "/nlab/show/Euler+characteristic"} Euler characteristic
            and the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/signature"} signature
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            be
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/simply+connected"} simply connected
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ind
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi D
                    %mi A
                    %mo +
                  %mo{:stretchy => "false"} )
                  %mo &gt;
                  %mn 0
                %annotation{:encoding => "application/x-tex"} ind(D_A^+)\gt 0
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi b
                    %mo +
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} b_+(M)=0
            or
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi b
                      %mo +
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo{:stretchy => "false"} )
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} b_+(M)\gt 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℳ
                    %mi η
                %annotation{:encoding => "application/x-tex"} \mathcal{M}_\eta
            is an
            %a.existingWikiWord{:href => "/nlab/show/oriented"} oriented
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            with dimension: (
            %a{:href => "#GompfStipsicz99"}> Gompf &amp; Stipsicz 99, Thrm. 2.4.24
            ,
            = succeed "," do
              %a{:href => "#Nicolaescu00"} Nicolaescu 2000, Lem. 2.2.10
            = succeed "," do
              %a{:href => "#KronheimerMrowka07"} Kronheimer &amp; Mrowka 2007, Thrm 1.4.4.
            = succeed "," do
              %a{:href => "#Moore10"} Moore 2010, Transversality Theorem 2 on p. 91
            = succeed ")" do
              %a{:href => "#Naber11"} Naber 11, p. 394
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi dim
                  %msub
                    %mi ℳ
                    %mi η
                  %mo =
                  %mn 2
                  %mi ind
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi D
                    %mi A
                    %mo +
                  %mo{:stretchy => "false"} )
                  %mo −
                  %msub
                    %mi b
                    %mo +
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo{:stretchy => "false"} )
                  %mo −
                  %mn 1
                  %mo =
                  %mfrac
                    %mn 1
                    %mn 4
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi c
                    %mn 1
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi 𝔰
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} [
                  %mi M
                  %mo{:stretchy => "false"} ]
                  %mo −
                  %mn 2
                  %mi χ
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo{:stretchy => "false"} )
                  %mo −
                  %mn 3
                  %mi σ
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  dim\mathcal{M}_\eta
                  \=2 ind(D_A^+)
                  \-b_+(M)
                  \-1
                  \=\frac{1}{4}(c_1^2(\mathfrak{s})[M]-2\chi(M)-3\sigma(M)).
          %p
            While the first expression is obviously always an integer, it is more difficult to see for the second expression. But as shown in the basics,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi c
                    %mn 1
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi 𝔰
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} [
                  %mi M
                  %mo{:stretchy => "false"} ]
                  %mo −
                  %mi σ
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} c_1^2(\mathfrak{s})[M]-\sigma(M)
            is always even, which already makes the term in the brackets even as well.
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            be
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/simply+connected"} simply connected
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi b
                      %mo +
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo{:stretchy => "false"} )
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} b_+(M)\gt 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mover
                      %mi ℳ
                      %mo ˜
                    %mi η
                %annotation{:encoding => "application/x-tex"} \widetilde\mathcal{M}_\eta
            is a
            %a.existingWikiWord{:href => "/nlab/show/compact"} compact
            (
            %a{:href => "#Donaldson96"}> Donaldson 1996, Eq. (7)
            ,
            = succeed ")" do
              %a{:href => "#Moore10"} Moore 2010, Compactness Theorem on p. 83
            %a.existingWikiWord{:href => "/nlab/show/oriented"} oriented
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            with dimension: (
            %a{:href => "#Moore10"}> Moore 2010, Transversality Theorem 1 on p. 86
            )
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi dim
                  %msub
                    %mover
                      %mi ℳ
                      %mo ˜
                    %mi η
                  %mo =
                  %mn 2
                  %mi ind
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi D
                    %mi A
                    %mo +
                  %mo{:stretchy => "false"} )
                  %mo −
                  %msub
                    %mi b
                    %mo +
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mfrac
                    %mn 1
                    %mn 4
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi c
                    %mn 1
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi 𝔰
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} [
                  %mi M
                  %mo{:stretchy => "false"} ]
                  %mo −
                  %mn 2
                  %mi χ
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo{:stretchy => "false"} )
                  %mo −
                  %mn 3
                  %mi σ
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mn 1
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  dim\widetilde\mathcal{M}_\eta
                  \=2 ind(D_A^+)
                  \-b_+(M)
                  \=\frac{1}{4}(c_1^2(\mathfrak{s})[M]-2\chi(M)-3\sigma(M))+1.
          %p
            (Some literature uses the convention
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi L
                    %mn 2
                  %mo =
                  %mi det
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi W
                    %mo ±
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} L^2=\det(W^\pm)
            since it is indeed the square of a line bundle, which makes the above formula not include a factor in front of the
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/Chern+class"} Chern class
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi b
                    %mo +
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} b_+(M)
            even,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi dim
                  %msub
                    %mi ℳ
                    %mi η
                %annotation{:encoding => "application/x-tex"} dim\mathcal{M}_\eta
            is also even and the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Seiberg-Witten+invariants"} Seiberg-Witten invariants
            %a.existingWikiWord{:href => "/nlab/show/Riemannian+metric"} Riemannian metric
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            and the perturbation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                %annotation{:encoding => "application/x-tex"} \eta
            %a{:href => "#KronheimerMrowka07"} Kronheimer &amp; Mrowka 2007, Thrm 1.5.2.
            as argued above for the latter, can then be defined as: (
            %a{:href => "#Donaldson96"}> Donaldson 1996, Eq. (6)
            ,
            = succeed "," do
              %a{:href => "#GompfStipcisz99"} Gompf &amp; Stipcisz 99, Def. 2.4.2
            = succeed "," do
              %a{:href => "#Nicolaescu00"} Nicolaescu 2000, p. 113
            = succeed ")" do
              %a{:href => "#KronheimerMrowka07"} Kronheimer &amp; Mrowka 2007, Def. 1.5.3. &amp; 1.5.4.
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SW
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %mi 𝔰
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mo{:stretchy => "false"} ⟨
                  %msub
                    %mi c
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi ℳ
                    %mi η
                  %msup
                    %mo{:stretchy => "false"} )
                    %mfrac
                      %mrow
                        %mi dim
                        %msub
                          %mover
