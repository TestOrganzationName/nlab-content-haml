                    %mi Δ
                    %mi η
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \Delta\eta=0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi b
                    %mo −
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi dim
                  %msubsup
                    %mi ℋ
                    %mo −
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} b_-(M)=dim\mathcal{H}_-^2(M)
            be the
            = succeed "," do
              %em anti self-dual Betti number
            %a.existingWikiWord{:href => "/nlab/show/Betti+number"} Betti number
            and
            %a.existingWikiWord{:href => "/nlab/show/signature"} signature
            can be expressed as:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi b
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi b
                    %mo +
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo{:stretchy => "false"} )
                  %mo +
                  %msub
                    %mi b
                    %mo −
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo{:stretchy => "false"} )
                  %mo ;
                %annotation{:encoding => "application/x-tex"}
                  b_2(M)
                  \=b_+(M)
                  +b_-(M);
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi b
                    %mo +
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo{:stretchy => "false"} )
                  %mo −
                  %msub
                    %mi b
                    %mo −
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\sigma(M)
                  \=b_+(M)
                  \-b_-(M).
          %p
            Both formulas, which are later used to calculate the dimension of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/moduli+space"} moduli space
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi b
                    %mo +
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mfrac
                    %mn 1
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi b
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mi σ
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ;
                %annotation{:encoding => "application/x-tex"}
                  b_+(M)
                  \=\frac{1}{2}(b_2(M)+\sigma(M));
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi b
                    %mo −
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mfrac
                    %mn 1
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi b
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo{:stretchy => "false"} )
                  %mo −
                  %mi σ
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  b_-(M)
                  \=\frac{1}{2}(b_2(M)-\sigma(M)).
          %h2#configuration_space Configuration space
          %p
            It is helpful to first consider the space of all possible solutions. Since the space of connections on the complex
            %a.existingWikiWord{:href => "/nlab/show/line+bundle"} line bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            is an affine vector space, it is helpful to chose a single such connection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi A
                %annotation{:encoding => "application/x-tex"} d_A
            and express every other as being shifted from it by a form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ia
                  %mo ∈
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %mi 𝔲
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} ia\in\Omega^1(M,\mathfrak{u}(1))
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ∈
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} a\in\Omega^1(M)
            using
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔲
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mi i
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathfrak{u}(1)\cong i\mathbb{R}
            %em configuration space
            and
            %em reduced configuration space
            be: (
            %a{:href => "#Moore10"}> Moore 2010, p. 77-79
            )
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                  %mo ≔
                  %mo{:stretchy => "false"} {
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi d
                    %mi A
                  %mo −
                  %mi ia
                  %mo ,
                  %mi ψ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} |
                  %mi a
                  %mo ∈
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi ψ
                  %mo ∈
                  %msup
                    %mi Γ
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi W
                    %mo +
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} }
                  %mo ;
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{A}
                  \\coloneqq\{(d_A-ia,\psi)|a\in\Omega^1(M),\psi\in\Gamma^\infty(W^+)\};
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝒜
                    %mo *
                  %mo ≔
                  %mo{:stretchy => "false"} {
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi d
                    %mi A
                  %mo −
                  %mi ia
                  %mo ,
                  %mi ψ
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi 𝒜
                  %mo{:stretchy => "false"} |
                  %mi ψ
                  %mo ≠
                  %mn 0
                  %mo{:stretchy => "false"} }
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{A}^*
                  \\coloneqq\{(d_A-ia,\psi)\in\mathcal{A}|\psi\neq 0\}.
          %p
            Since the reduced configuration space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝒜
                    %mo *
                %annotation{:encoding => "application/x-tex"} \mathcal{A}^*
            is an infinite dimensional vector space without a single point and hence
            %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalent"} homotopy equivalent
            to the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/infinite-dimensional+sphere"} infinite-dimensional sphere
          %p
            Although the definition of the reduced configuration space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝒜
                    %mo *
                %annotation{:encoding => "application/x-tex"} \mathcal{A}^*
            is mainly motivated by the action of the
            %a.existingWikiWord{:href => "/nlab/show/gauge+group"} gauge group
            below, its excluded cases are already important in the
            %a.existingWikiWord{:href => "/nlab/show/Seiberg-Witten+equations"} Seiberg-Witten equations
            themselves, which then reduced to the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/self-dual+Yang-Mills+equations"} self-dual Yang-Mills equations
          %h2#gauge_group Gauge group
          %p
            Smooth maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo{:lspace => "verythinmathspace"} :
                  %mi M
                  %mo →
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} g\colon M\rightarrow U(1)
            act on the elements of the configuration space by: (
            %a{:href => "#Perutz02"}> Perutz 2002, p. 6
            ,
            = succeed "," do
              %a{:href => "#Moore10"} Moore 2010, p. 77-79
            = succeed ")" do
              %a{:href => "#Naber11"} Naber 11, Eq. (A.4.15)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo ⋅
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi d
                    %mi A
                  %mo −
                  %mi ia
                  %mo ,
                  %mi ψ
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi d
                    %mi A
                  %mo −
                  %mi ia
                  %mo +
                  %mi g
                  %mi d
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi g
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi g
                  %mi ψ
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  g\cdot(d_A-ia,\psi)
                  \=(d_A-ia+g d(g^{-1}),g\psi).
          %p
            Hence the
            %em gauge group
            can be taken as: (
            %a{:href => "#Perutz02"}> Perutz 2002, p. 6
            ,
            = succeed "," do
              %a{:href => "#Moore10"} Moore 2010, p. 77-79
            = succeed ")" do
              %a{:href => "#Naber11"} Naber 11, Lemma A.4.1
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒢
                  %mo ≔
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{G}
                  \\coloneqq C^\infty(M,U(1)).
          %p
            Using that the first
            %a.existingWikiWord{:href => "/nlab/show/unitary+group"} unitary group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} U(1)
            is the
            %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+space"} Eilenberg-MacLane space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K(\mathbb{Z},1)
            %a.existingWikiWord{:href => "/nlab/show/Brown+representability+theorem"} classifies
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/singular+cohomology"} singular cohomology
            %a.existingWikiWord{:href => "/nlab/show/universal+coefficient+theorem"} universal coefficient theorem
            and the
            %a.existingWikiWord{:href => "/nlab/show/Hurewicz+theorem"} Hurewicz theorem
            yields:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi M
                  %mo ,
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %mo{:stretchy => "false"} [
                  %mi M
                  %mo ,
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi ℤ
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %msup
                    %mi H
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} Hom
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi H
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} Hom
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi M
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi{:mathvariant => "normal"} ab
                  %mo ,
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  [M,U(1)]
                  \=[M,K(\mathbb{Z},1]
                  \=H^1(M,\mathbb{Z})
                  \\cong\Hom(H_1(M,\mathbb{Z}),\mathbb{Z})
                  \=\Hom(\pi_1(M)^\mathrm{ab},\mathbb{Z}).
          %p
            Hence for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            %a.existingWikiWord{:href => "/nlab/show/simply+connected"} simply connected
            or more generally if its
            %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} fundamental group
            is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/perfect+group"} perfect
            %a.existingWikiWord{:href => "/nlab/show/nullhomotopic"} nullhomotopic
            and therefore has a global
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/logarithm"} logarithm
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo{:lspace => "verythinmathspace"} :
                  %mi M
                  %mo →
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} g\colon M\rightarrow U(1)
            there exists a smooth map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                  %mo{:lspace => "verythinmathspace"} :
                  %mi M
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} u\colon M\rightarrow\mathbb{R}
            with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo =
                    %msup
                      %mi e
                      %mi iu
                  %annotation{:encoding => "application/x-tex"} g=e^{iu}
            = succeed ")" do
              %a{:href => "#Moore10"} Moore 2010, p. 77-79
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi e
                    %mi iu
                  %mo ⋅
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi d
                    %mi A
                  %mo −
                  %mi ia
                  %mo ,
                  %mi ψ
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi d
                    %mi A
                  %mo −
                  %mi i
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo +
                  %mi d
                  %mi u
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msup
                    %mi e
                    %mi iu
                  %mi ψ
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  e^{iu}\cdot(d_A-ia,\psi)
                  \=(d_A-i(a+d u),e^{iu}\psi).
          %p
            For a base point
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 0
                    %mo ∈
                    %mi M
                  %annotation{:encoding => "application/x-tex"} x_0\in M
            %a.existingWikiWord{:href => "/nlab/show/gauge+group"} gauge group
            can be separated as a product using the
            = succeed ":" do
              %em based gauge group
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒢
                    %mn 0
                  %mo ≔
                  %mo{:stretchy => "false"} {
                  %mi g
                  %mo ∈
                  %mi 𝒢
                  %mo{:stretchy => "false"} |
                  %mi g
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi x
                    %mn 0
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 1
                  %mo{:stretchy => "false"} }
                  %mo ;
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{G}_0
                  \\coloneqq\{g\in\mathcal{G}|g(x_0)=1\};
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒢
                  %mo =
                  %msub
                    %mi 𝒢
                    %mn 0
                  %mo ×
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{G}
                  \=\mathcal{G}_0\times U(1).
          %p
            As the product shows, the gauge group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒢
                %annotation{:encoding => "application/x-tex"} \mathcal{G}
            is not contractible. But as the argument above shows, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/simply+connected"} simply connected
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒢
                    %mn 0
                %annotation{:encoding => "application/x-tex"} \mathcal{G}_0
            is contractible.
          %h2#moduli_space Moduli space
          %p
            Since both the
            %a.existingWikiWord{:href => "/nlab/show/gauge+group"} gauge group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒢
                %annotation{:encoding => "application/x-tex"} \mathcal{G}
            and its
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒢
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}_0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathcal{A}
            and its subspace, the reduced configuration space
            = succeed "," do
