        #revision
          %p
            This entry describes classes of examples of
            = succeed "-valued" do
              %a.existingWikiWord{:href => "/nlab/show/A-%E2%88%9E+category"} A-∞ category
            %a.existingWikiWord{:href => "/nlab/show/FQFTs"} FQFTs
            defined on a version of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/symplectic+category"} symplectic category
          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#overview"} Overview
              %li
                %a{:href => "#lagrangian_correspondences"} Lagrangian correspondences
              %li
                %a{:href => "#references"} References
          %h2#overview Overview
          %p
            Let
            %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_1.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo .
                  %mi ω
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X.\omega)
            be a
            %a.existingWikiWord{:href => "/nlab/show/compact+space"} compact
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/symplectic+manifold"} symplectic manifold
            %a.existingWikiWord{:href => "/nlab/show/Fukaya+category"} Fukaya category
            %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_2.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Fuk
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Fuk(X)
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+submanifold"} Lagrangian submanifold
            = succeed "." do
              %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_3.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Fuk
                      %mo #
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Fuk^#(X)
          %p
            Write
            %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_4.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mo −
                %annotation{:encoding => "application/x-tex"} X^-
            for the symplectiv manifold
            = succeed "." do
              %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_5.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,-\omega)
          %p
            Now if
            %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_6.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mi j
                  %mo ,
                  %msub
                    %mi ω
                    %mi j
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X_j, \omega_j)
            for
            %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_7.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                  %mo =
                  %mn 0
                  %mo ,
                  %mn 1
                %annotation{:encoding => "application/x-tex"} j = 0,1
            are two Lagrangian submanifolds and
            %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_8.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mn 01
                  %mo ⊂
                  %msubsup
                    %mi X
                    %mn 0
                    %mo −
                  %mo ×
                  %msub
                    %mi X
                    %mn 1
                %annotation{:encoding => "application/x-tex"} L_{01} \subset  X^-_0 \times X_1
            a Lagrangian correspondence then we get an
            %a.existingWikiWord{:href => "/nlab/show/A-%E2%88%9E+category"} A-∞ functor
            %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_9.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi L
                    %mn 01
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msup
                    %mi Fuk
                    %mo #
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 0
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mi Fuk
                    %mo #
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \phi(L_{01}) : Fuk^#(X_0) \to Fuk^#(X_1)
          .num_theorem
            %h6#theorem Theorem
            %p
              %strong (Wehrheim, Woodward)
            %p
              For
              %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_10.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn 01
                    %mo ⊂
                    %msubsup
                      %mi X
                      %mn 0
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ×
                    %msub
                      %mi X
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} L_{01} \subset X^{-}_0 \times X_1
              and
              %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_11.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn 12
                    %mo ⊂
                    %msubsup
                      %mi X
                      %mn 1
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ×
                    %msub
                      %mi X
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} L_{12} \subset X^{-}_1 \times X_2
              Lagrangian submanifolds, assuming monotonicity and Maslov conditions we have an
              = succeed "-homotopy" do
                %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_12.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} A_\infty
            .maruku-equation
              %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_13.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi L
                      %mn 01
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %mi Φ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi L
                      %mn 12
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Φ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi L
                      %mn 01
                    %mo ∘
                    %msub
                      %mi L
                      %mn 12
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\Phi(L_{01}) \circ \Phi(L_{12}) \simeq \Phi(L_{01} \circ L_{12})
                    \\,,
            %p where on the right we have a natural notion of composition of Lagrangian submanifolds.
          %p
            (
            %a{:href => "WehrheimWoodward07"}> Wehrheim-Woodward 07, section 3.2
            )
          %p
            This is the symplectic version of
            = succeed "." do
              %span.newWikiWord
                Mukai functors
                %a{:href => "/nlab/new/Mukai+functors"} ?
          .num_example
            %h6#example Example
            %p
              For
              %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_14.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} X_0
              and
              %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_15.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} X_1
              a compact
              %a.existingWikiWord{:href => "/nlab/show/Riemann+surfaces"} Riemann surfaces
              and
              %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_16.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi M
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} M(X_0), M(X_1)
            %p
              their
              %a.existingWikiWord{:href => "/nlab/show/moduli+spaces"} moduli spaces
              of fixed determinant rank
              = succeed "-bundles," do
                %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_17.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_18.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Y
                      %mn 01
                  %annotation{:encoding => "application/x-tex"} Y_{01}
              a
              %a.existingWikiWord{:href => "/nlab/show/cobordism"} cobordism
              (compact, oriented) from
              %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_19.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} X_0
              to
              %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_20.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} X_1
              then consider
            .maruku-equation
              %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_21.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Y
                      %mn 01
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %mi Image
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Y
                      %mn 01
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mi restriction
                    %mi M
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 0
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo −
                    %mo ×
                    %mi M
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    L(Y_{01}) := Image(
                    M(Y_{01}) \stackrel{restriction}{\to} M(X_0)^- \times M(X_1)
                    )
            %p
              If
              %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_22.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Y
                      %mn 01
                  %annotation{:encoding => "application/x-tex"} Y_{01}
              is
              %em elementary
              in that there exists a
              %a.existingWikiWord{:href => "/nlab/show/Morse+function"} Morse function
              %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_23.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} Y \to \mathbb{R}
              with
              %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_24.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≤
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \leq 1
              critical points then
              %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_25.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Y
                      %mn 01
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} L(Y_{01})
              is a Lagrangian correspondence.
          .num_cor
            %h6#corollary Corollary
            %p The assignment
            .maruku-equation
              %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_26.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Y
                      %mn 01
                    %mo ↦
                    %mi Φ
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Y
                      %mn 01
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Y_{01} \mapsto \Phi(L(Y_{01}))
            %p
              defines a 2+1-dimensional
              %a.existingWikiWord{:href => "/nlab/show/FQFT"} FQFT
              for connected cobordisms with values in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/A-%E2%88%9E+categories"} A-∞ categories
          %p
            This is supposed to be the 2+1-dimensional part of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Donaldson+theory"} Donaldson theory
          %p Other theories that fit into this framework:
          %ol
            %li
              %p
                symplectic
                %span.newWikiWord
                  Khovanov theory
                  %a{:href => "/nlab/new/Khovanov+theory"} ?
                (Seidel-Smith and Rezazodegab)
            %li
              %p
                %span.newWikiWord
                  Heegard-Floer theory
                  %a{:href => "/nlab/new/Heegard-Floer+theory"} ?
              %p
                %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_27.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                a surface
                %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_28.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ↦
                    %annotation{:encoding => "application/x-tex"} \mapsto
                %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_29.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Fuk
                        %mo #
                      %mi sym
                      %mi X
                    %annotation{:encoding => "application/x-tex"} Fuk^# sym X
              %p
                elementary cobordisms
                %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_30.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ↦
                    %annotation{:encoding => "application/x-tex"} \mapsto
                = succeed "vanishing" do
                  %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_31.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Φ
                        %mo{:stretchy => "false"} (
                      %annotation{:encoding => "application/x-tex"} \Phi(
                %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_32.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} )
          %h2#lagrangian_correspondences Lagrangian correspondences
          %p
            Write
            %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_33.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mo −
                  %mi j
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mi j
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msub
                    %mi ω
                    %mi j
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X^-j = (X_j , -\omega_j)
            for a
            %a.existingWikiWord{:href => "/nlab/show/symplectic+manifold"} symplectic manifold
            with its symplectic form reversed.
          .num_defn
            %h6#definition Definition
            %p
              For
              %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_34.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi j
                    %mo ,
                    %msub
                      %mi ω
                      %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X_j, \omega_j)
              two
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/symplectic+manifold"} symplectic manifold
              %strong
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+correspondence"} Lagrangian correspondence
              is a Lagrangian submanifold of
              = succeed "," do
                %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_35.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi X
                        %mn 0
                        %mo −
                      %mo ×
                      %msub
                        %mi X
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} X^-_0 \times X_1
            .maruku-equation
              %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_36.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ι
                    %mo :
                    %msub
                      %mi L
                      %mrow
                        %mn 0
                        %mo ,
                        %mn 1
                    %mo ↪
                    %msubsup
                      %mi X
                      %mn 0
                      %mo −
                    %mo ×
                    %msub
                      %mi X
                      %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\iota : L_{0,1} \hookrightarrow X^-_0 \times X_1
            %p
              with
              %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_37.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi dim
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi L
                      %mrow
                        %mn 0
                        %mo ,
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mfrac
                      %mn 1
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi dim
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi dim
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} dim(L_{0,1}) = \frac{1}{2}(dim(x_0) + dim(X_1))
            %p and
            .maruku-equation
              %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_38.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ι
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msubsup
                      %mi π
                      %mn 0
                      %mo *
                    %msub
                      %mi ω
                      %mn 0
                    %mo +
                    %msubsup
                      %mi π
                      %mn 1
                      %mo *
                    %msub
                      %mi ω
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\iota^*(-\pi_0^* \omega_0 + \pi_1^* \omega_1) = 0
                    \\,,
            %p
              where
              %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_39.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \pi_i
              are the two projections out of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/product"} product
            %p
              The
              %strong composition
              of two Lagrangian submanifolds is
            .maruku-equation
              %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_40.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn 01
                    %mo ∘
                    %msub
                      %mi L
                      %mn 12
                    %mo :
                    %mo =
                    %msub
                      %mi π
                      %mn 02
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi L
                      %mn 01
                    %msub
                      %mo ×
                      %mrow
                        %msub
                          %mi X
                          %mn 1
                    %msub
                      %mi L
                      %mn 12
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    L_{01} \circ L_{12} :=
                    \\pi_{02}(L_{01} \times_{X_1} L_{12})
            %p
              which is a Lagrangian correspondence in
              %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_41.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi X
                      %mn 0
                      %mo −
                    %mo ×
                    %msub
                      %mi X
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} X^-_0 \times X_2
              if everything is suitably smoothly embedded by
              = succeed "." do
                %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_42.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 02
                    %annotation{:encoding => "application/x-tex"} \pi_{02}
          .num_example
            %h6#example_2 Example
            %p
              For
              %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_43.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo :
                    %msub
                      %mi X
                      %mn 0
                    %mo →
                    %msub
                      %mi X
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \phi : X_0 \to X_1
              a
              %a.existingWikiWord{:href => "/nlab/show/symplectomorphism"} symplectomorphism
              we have
            %p
              %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_44.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi graph
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %msubsup
                      %mi X
                      %mn 0
                      %mo −
                    %mo ×
                    %msub
                      %mi X
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} graph(\phi) \subset X_0^- \times X_1
              is a Lagrangian correspondence and composition of syplectomorphisms corresponds to composition of Lagrangian correspondences.
          .num_example
            %h6#example_3 Example
            %p
              Let
              %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_45.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
              %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_46.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo =
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G= U(n)
              the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/unitary+group"} unitary group
              %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_47.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} P \to X
              a
              = succeed "-" do
                %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_48.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
              and
              %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_49.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} D \to X
              a
              = succeed "-bundle" do
                %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_50.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U(1)
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connection
            %p
              Then there is the
              %a.existingWikiWord{:href => "/nlab/show/moduli+space"} moduli space
              %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_51.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi M
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo ,
                    %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} M(X) = M(P,D)
              of connections on
              %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_52.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              with central curvature and given determinant.
            %p
              For example if
              %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_53.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              has
              %a.existingWikiWord{:href => "/nlab/show/genus"} genus
              %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_54.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              then
            .maruku-equation
              %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_55.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi A
                      %mi g
                    %mo ,
                    %msub
                      %mi B
                      %mi g
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msup
                      %mi G
                      %mrow
                        %mn 2
                        %mi g
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"}
                    M(X) = \{ (A,B, \cdots, A_g, B_g) \in G^{2g}\}
            %p
              such that
              %math#mathml_8f31c19657fd05c878b51b15ccb6cc78b6d4bdbe_56.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
