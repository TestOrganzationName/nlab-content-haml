                  %annotation{:encoding => "application/x-tex"} -\mathbf{L}' + \mathbf{L}'_{BRST}
              (
              %a{:href => "A+first+idea+of+quantum+field+theory#GaugeFixingLagrangianDensity"}> this def.
              ) on a graded BV-BRST
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo ≔
                    %msup
                      %mi T
                      %mo *
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi Σ
                        %mo ,
                        %mi inf
                    %mo{:stretchy => "false"} (
                    %mi E
                    %msub
                      %mo ×
                      %mi Σ
                    %mi 𝒢
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %msub
                      %mo ×
                      %mi Σ
                    %mi A
                    %msub
                      %mo ×
                      %mi Σ
                    %mi A
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E_{\text{BV-BRST}} \coloneqq T^\ast[-1]_{\Sigma,inf}(E \times_\Sigma \mathcal{G}[1] \times_{\Sigma} A \times_\Sigma A[-1])
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/BV-operator"} BV-operator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi BV
                  %annotation{:encoding => "application/x-tex"} \Delta_{BV}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ForGaugeFixedFreeLagrangianFieldTheoryBVOperator"}
              %a.existingWikiWord{:href => "/nlab/show/antibracket"} antibracket
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{-,-\}
              (
              %a{:href => "A+first+idea+of+quantum+field+theory#ComplexBVBRSTGlobal"}> this def.
              ) satisfy for all
              %a.existingWikiWord{:href => "/nlab/show/polynomial+observables"} polynomial observables
              (
              %a{:href => "A+first+idea+of+quantum+field+theory#PolynomialObservables"}> this def.
              )
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 1
                    %mo ,
                    %msub
                      %mi A
                      %mn 2
                    %mo ∈
                    %mi PolyObs
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi ℏ
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} A_1, A_2 \in PolyObs(E_{\text{BV-BRST}})[ [\hbar] ]
              the relation
            #eq:GlobalAntibracketInteractingWithBVOperator.maruku-equation
              %span.maruku-eq-number (5)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
