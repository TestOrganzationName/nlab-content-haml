                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{-S',\mathcal{T}^{-1}(A)\}
              on the right vanishes
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒯
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mrow
                      %mo {
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi S
                      %mo ′
                      %mo ,
                      %mi A
                      %mo }
                  %annotation{:encoding => "application/x-tex"} \mathcal{T}^{-1}\left\{ -S', A\right\}
              on the left, since the latter is the image under the linear map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒯
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathcal{T}^{-1}
              of an observable that vanishes on-shell.
            %p
              To sort this out, notice that the isomorphism
              %a.maruku-eqref{:href => "#eq:OnShellObservablesAsQuotientOfOffShellObservablesRecalled"} (9)
              tells us that the observables that vanish when passing from off-shell to on-shell observables are precisely those in the ideal generated by the image of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi S
                      %mo ′
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{-S',(-)\}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒯
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathcal{T}^{-1}
              is an isomorphism on (regular off-shell observables), it need not (and in general does not) preserve this ideal! Hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒯
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi S
                    %mo ′
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{T}^{-1}(\{-S',A\})
              need not (and in general is not) an element of that ideal, and this is why it remains when passing to the algebra of on-shell observables and thus makes its crucial appearance in the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Schwinger-Dyson+equation"} Schwinger-Dyson equation
          %h4#quantum_master_equation Quantum master equation
          %p
            Passing from
            %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free field theory
            to
            %a.existingWikiWord{:href => "/nlab/show/perturbative+quantum+field+theory"} perturbative
            %a.existingWikiWord{:href => "/nlab/show/quantization"} quantization
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/interacting+field+theory"} interacting field theory
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/classical+master+equation"} classical master equation
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/BV-differential"} BV-differential
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/quantum+master+equation"} quantum master equation
            = succeed "." do
              %a{:href => "quantum+master+equation#QuantumMasterEquation"} this prop.
          %h2#references References
          %p The concept originates with
          %ul
            %li#BatalinVilkovisky81
              %a.existingWikiWord{:href => "/nlab/show/Igor+Batalin"}> Igor Batalin
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Grigori+Vilkovisky"} Grigori Vilkovisky
              = succeed "," do
                %em Gauge Algebra and Quantization
              = succeed ")" do
                %a{:href => "https://doi.org/10.1016/0370-2693(81)90205-7"} doi:10.1016/0370-2693(81)90205-7
          %p Traditional review includes
          %ul
            %li#HenneauxTeitelboim92
              %a.existingWikiWord{:href => "/nlab/show/Marc+Henneaux"}> Marc Henneaux
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Claudio+Teitelboim"} Claudio Teitelboim
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Quantization+of+Gauge+Systems"} Quantization of Gauge Systems
          %p
            The understanding of the BV-operator in the rigorous formulation of
            %a.existingWikiWord{:href => "/nlab/show/relativistic+field+theory"} relativistic
            %a.existingWikiWord{:href => "/nlab/show/perturbative+quantum+field+theory"} perturbative quantum field theory
            via
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/causal+perturbation+theory"} causal perturbation theory
            %a.existingWikiWord{:href => "/nlab/show/perturbative+AQFT"} perturbative AQFT
            is due to
          %ul
            %li#FredenhagenRejzner11b
              %p
                %a.existingWikiWord{:href => "/nlab/show/Klaus+Fredenhagen"}> Klaus Fredenhagen
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Katarzyna+Rejzner"} Katarzyna Rejzner
                = succeed "," do
                  %em Batalin-Vilkovisky formalism in perturbative algebraic quantum field theory
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/1110.5232"} arXiv:1110.5232
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1007/s00220-012-1601-1"} doi:10.1007/s00220-012-1601-1
            %li#Rejzner11
              %p
                %a.existingWikiWord{:href => "/nlab/show/Katarzyna+Rejzner"}> Katarzyna Rejzner
                , section 5.1.2 of
                %em Batalin-Vilkovisky formalism in locally covariant field theory
                (
                %a{:href => "https://arxiv.org/abs/1111.5130"}> arXiv:1111.5130
                )
          %p surveyed in
          %ul
            %li#Rejzner16
              %a.existingWikiWord{:href => "/nlab/show/Katarzyna+Rejzner"}> Katarzyna Rejzner
              , section 7.3 of
              = succeed "," do
                %em
