                      %mi A
                      %mn 1
                    %mo ⋅
                    %msub
                      %mi A
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi deg
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi A
                          %mn 2
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi Δ
                      %mi BV
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %msub
                      %mi A
                      %mn 2
                    %mo −
                    %msub
                      %mi A
                      %mn 1
                    %mo ⋅
                    %msub
                      %mi Δ
                      %mi BV
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\{A_1, A_2\}
                    \\;=\;
                    (-1)^{deg(A_2)}
                    \\,
                    \\Delta_{BV}(A_1 \cdot A_2)
                    \-
                    (-1)^{deg(A_2)}
                    \\,
                    \\Delta_{BV}(A_1) \cdot A_2
                    \-
                    A_1 \cdot \Delta_{BV}(A_2)
            %p
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (-) \cdot (-)
              the pointwise product of observables (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#Observable"}
            %p
              Moreover, it commutes on
              %a.existingWikiWord{:href => "/nlab/show/regular+polynomial+observables"} regular polynomial observables
              with the
              %a.existingWikiWord{:href => "/nlab/show/time-ordered+product"} time-ordering operator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒯
                  %annotation{:encoding => "application/x-tex"} \mathcal{T}
              (
              %a{:href => "time-ordered+product#IsomorphismOnRegularPolynomialObservablesTimeOrderedandPointwise"}> this prop.
              )
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi BV
                    %mo ∘
                    %mi 𝒯
                    %mo =
                    %mi 𝒯
                    %mo ∘
                    %msub
                      %mi Δ
                      %mi BV
                    %mphantom
                      %mi AAA
                    %mtext on
                    %mspace{:width => "thinmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mi PolyObs
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi reg
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi ℏ
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\Delta_{BV} \circ \mathcal{T}
                    \=
                    \\mathcal{T} \circ \Delta_{BV}
                    \\phantom{AAA}
                    \\text{on}
                    \\,\,
                    PolyObs(E_{\text{BV-BRST}})_{reg}[ [\hbar] ]
            %p
              and hence satisfies the analogue of relation
              %a.maruku-eqref{:href => "#eq:GlobalAntibracketInteractingWithBVOperator"} (5)
              also for the time-ordered antibracket
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mo{:stretchy => "false"} }
                      %mi 𝒯
                  %annotation{:encoding => "application/x-tex"} \{-,-\}_{\mathcal{T}}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#AntibracketTimeOrdered"}
              %a.existingWikiWord{:href => "/nlab/show/time-ordered+product"} time-ordered product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ⋆
                      %mi F
                  %annotation{:encoding => "application/x-tex"} \star_F
              on regular polynomial observables
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi A
                      %mn 1
                    %mo ,
                    %msub
                      %mi A
                      %mn 2
                    %msub
                      %mo{:stretchy => "false"} }
                      %mi 𝒯
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi deg
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi A
                          %mn 2
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi Δ
                      %mi BV
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mn 1
                    %msub
                      %mo ⋆
                      %mi F
                    %msub
                      %mi A
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi deg
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi A
                          %mn 2
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi Δ
                      %mi BV
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⋆
                      %mi F
                    %msub
                      %mi A
                      %mn 2
                    %mo −
                    %msub
                      %mi A
                      %mn 1
                    %msub
                      %mo ⋆
                      %mi F
                    %msub
                      %mi Δ
                      %mi BV
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\{A_1, A_2\}_{\mathcal{T}}
                    \\;=\;
                    (-1)^{deg(A_2)}
                    \\,
                    \\Delta_{BV}(A_1 \star_F A_2)
                    \-
                    (-1)^{deg(A_2)}
                    \\Delta_{BV}(A_1) \star_F A_2
                    \-
                    A_1 \star_F \Delta_{BV}(A_2)
                    \\,.
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "antibracket#HenneauxTeitelboim92"} Henneaux-Teitelboim 92, (15.105d)
          .proof
            %h6#proof_3 Proof
            %p
              With prop.
              %a.maruku-ref{:href => "#ComponentsBVOperator"}
              the first statement is a graded version of the analogous relation for an ordinary
              %a.existingWikiWord{:href => "/nlab/show/Laplace+operator"} Laplace operator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo ≔
                    %msup
                      %mi g
                      %mrow
                        %mi a
                        %mi b
                    %msub
                      %mo ∂
                      %mi a
                    %msub
                      %mo ∂
                      %mi b
                  %annotation{:encoding => "application/x-tex"} \Delta \coloneqq g^{a b} \partial_a \partial_b
              acting on
              %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
              on
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ,
                    %mi g
                  %annotation{:encoding => "application/x-tex"} f,g
              satisfies
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ⋅
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mo ∇
                    %mi f
                    %mo ,
                    %mo ∇
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mi Δ
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mi g
                    %mo −
                    %mi f
                    %mi Δ
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\Delta(f \cdot g)
                    \\;=\;
                    (\nabla f, \nabla g) - \Delta(f) g - f \Delta(g)
                    \\,,
            %p
              by the
              %a.existingWikiWord{:href => "/nlab/show/product+law"} product law
              for
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/differentiation"} differentiation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                    %mi f
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi g
                      %mrow
                        %mi a
                        %mi b
                    %msub
                      %mo ∂
                      %mi b
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \nabla f \coloneqq (g^{a b} \partial_b f)
              is the
              %a.existingWikiWord{:href => "/nlab/show/gradient"} gradient
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo ,
                    %mi w
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msub
                      %mi g
                      %mrow
                        %mi a
                        %mi b
                    %msup
                      %mi v
                      %mi a
                    %mi w
                    %mi b
                  %annotation{:encoding => "application/x-tex"} (v,w) \coloneqq g_{a b} v^a w b
              the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/inner+product"} inner product
            %p
              That the BV-operator commutes with the time-ordering operator is clear from the fact that both of these are given by
              %a.existingWikiWord{:href => "/nlab/show/partial+derivative"} partial
              %a.existingWikiWord{:href => "/nlab/show/functional+derivatives"} functional derivatives
              with
              %em
                %a.existingWikiWord{:href => "/nlab/show/constant+function"} constant
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
          #TimeOrderedExponentialBVOperator.num_example
            %h6#example Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/BV-operator"} BV-operator
                on
                %a.existingWikiWord{:href => "/nlab/show/time-ordered+product"} time-ordered
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/exponentials"} exponentials
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
              be a
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              (
              %a{:href => "A+first+idea+of+quantum+field+theory#FreeFieldTheory"}> this def.
              ) with
              %a.existingWikiWord{:href => "/nlab/show/gauge+fixing"} gauge fixed
              BV-BRST
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo ′
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %msub
                      %mo ′
                      %mi BRST
                  %annotation{:encoding => "application/x-tex"} -\mathbf{L}' + \mathbf{L}'_{BRST}
              (
              %a{:href => "A+first+idea+of+quantum+field+theory#GaugeFixingLagrangianDensity"}> this def.
              ) on a graded BV-BRST
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mtext BV-BRST
                      %mo ≔
                      %msup
                        %mi T
                        %mo *
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mrow
                          %mi Σ
                          %mo ,
                          %mi inf
                      %mo{:stretchy => "false"} (
                      %mi E
                      %msub
                        %mo ×
                        %mi Σ
                      %mi 𝒢
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %msub
                        %mo ×
                        %mi Σ
                      %mi A
                      %msub
                        %mo ×
                        %mi Σ
                      %mi A
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} E_{\text{BV-BRST}} \coloneqq T^\ast[-1]_{\Sigma,inf}(E \times_\Sigma \mathcal{G}[1] \times_{\Sigma} A \times_\Sigma A[-1])
            %p
              Let moreover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ∈
                    %mi PolyObs
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi reg
                        %mo ,
                        %mi deg
                        %mo =
                        %mn 0
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi ℏ
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} V \in PolyObs(E_{\text{BV-BRST}})_{reg, deg = 0}[ [\hbar] ]
              be a
              %a.existingWikiWord{:href => "/nlab/show/regular+polynomial+observable"} regular polynomial observable
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#PolynomialObservables"}
              %a.existingWikiWord{:href => "/nlab/show/BV-operator"} BV-operator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi BV
                  %annotation{:encoding => "application/x-tex"} \Delta_{BV}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ForGaugeFixedFreeLagrangianFieldTheoryBVOperator"}
              %a.existingWikiWord{:href => "/nlab/show/time-ordered+product"} time-ordered
              %a.existingWikiWord{:href => "/nlab/show/exponential"} exponential
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi exp
                      %mi 𝒯
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \exp_{\mathcal{T}}(V)
              (
              %a{:href => "time-ordered+product#RegularObservablesExponentialTimeOrdered"}> this example
              ) is the
              %a.existingWikiWord{:href => "/nlab/show/time-ordered+product"} time-ordered product
              of the time-ordered exponential with the sum of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi BV
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Delta_{BV}(V)
              and the global
              %a.existingWikiWord{:href => "/nlab/show/time-ordered+product"} time-ordered
              %a.existingWikiWord{:href => "/nlab/show/antibracket"} antibracket
