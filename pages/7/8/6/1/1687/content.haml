          %h2#definition Definition
          %h3#general General
          %p
            In full generality, we have the following definition of
            %em gerbe
            \.
          #GeneralDef.num_defn
            %h6#definition_2 Definition
            %p
              Given an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒳
                    %annotation{:encoding => "application/x-tex"} \mathcal{X}
              %strong gerbe
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒳
                  %annotation{:encoding => "application/x-tex"} \mathcal{X}
              is an
              %a.existingWikiWord{:href => "/nlab/show/object"} object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                    %mo ∈
                    %mi 𝒳
                  %annotation{:encoding => "application/x-tex"} \mathcal{G} \in \mathcal{X}
              that is
            %ol
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/1-truncated"} 1-truncated
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/1-connective"} 1-connective
                  (=
                  = succeed ")." do
                    %a.existingWikiWord{:href => "/nlab/show/connected"} connected
          %p
            The first condition says that a gerbe is an object in the
            %a.existingWikiWord{:href => "/nlab/show/%282%2C1%29-topos"} (2,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi τ
                    %mrow
                      %mo ≤
                      %mn 1
                  %mi 𝒳
                  %mo ↪
                  %mi 𝒳
                %annotation{:encoding => "application/x-tex"} \tau_{\leq 1 } \mathcal{X} \hookrightarrow \mathcal{X}
            inside
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒳
                  %annotation{:encoding => "application/x-tex"} \mathcal{X}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            any
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-site"} (∞,1)-site
            of definition for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒳
                  %annotation{:encoding => "application/x-tex"} \mathcal{X}
            %a.existingWikiWord{:href => "/nlab/show/%282%2C1%29-sheaf"} (2,1)-sheaf
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                    %mo ∈
                    %msub
                      %mi Sh
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{G} \in Sh_{(2,1)}(C)
            %a.existingWikiWord{:href => "/nlab/show/stack"} stack
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %p
            The second condition says that a gerbe is a stack that
            %em locally
            looks like the
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            of a
            %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
            of
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/group"} group
          %ul
            %li
              %p
                the morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒢
                      %mo →
                      %mo *
                    %annotation{:encoding => "application/x-tex"} \mathcal{G} \to *
                to the
                %a.existingWikiWord{:href => "/nlab/show/terminal+object+in+an+%28%E2%88%9E%2C1%29-category"} terminal object
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒳
                    %annotation{:encoding => "application/x-tex"} \mathcal{X}
                is an
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/effective+epimorphism+in+an+%28%E2%88%9E%2C1%29-category"} effective epimorphism)
            %li
              %p
                the 0th
                %a.existingWikiWord{:href => "/nlab/show/categorical+homotopy+groups+in+an+%28%E2%88%9E%2C1%29-topos"} categorical homotopy
                group
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 0
                      %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} \pi_0 \mathcal{G}
                is isomorphic to the terminal object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                    %annotation{:encoding => "application/x-tex"} *
                as objects in the
                %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi τ
                          %mrow
                            %mo ≤
                            %mn 0
                        %mi 𝒳
                        %mo =
                        %msub
                          %mi Sh
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \tau_{\leq 0} \mathcal{X} = Sh_{(1,1)}(C)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 0
                      %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} \pi_0 \mathcal{G}
                is the
                %a.existingWikiWord{:href => "/nlab/show/sheafification"} sheafification
                of the presheaf of connected components of the groupoids that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒢
                      %mo :
                      %msup
                        %mi C
                        %mi op
                      %mo →
                      %mi Grpd
                      %mo ↪
                      %mn ∞
                      %mi Grpd
                    %annotation{:encoding => "application/x-tex"} \mathcal{G} : C^{op} \to Grpd \hookrightarrow \infty Grpd
                assigns to each object in the site.
          %p
            Traditionally this is phrased before sheafification as saying that a gerbe is a stack that is
            %em locally
            non-empty and
            %em locally
            connected . This is the traditional definition, due to
            = succeed "." do
              %a{:href => "#Giraud"} Giraud
          %p
            Also traditionally gerbes are considered in the
            %a.existingWikiWord{:href => "/nlab/show/little+topos"} little (2,1)-toposes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi τ
                    %mrow
                      %mo ≤
                      %mn 1
                  %mi 𝒳
                %annotation{:encoding => "application/x-tex"} \tau_{\leq 1} \mathcal{X}
            of a
            %a.existingWikiWord{:href => "/nlab/show/topological+manifold"} topological manifold
            or
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            or a
            %a.existingWikiWord{:href => "/nlab/show/topological+stack"} topological stack
            or
            %a.existingWikiWord{:href => "/nlab/show/differentiable+stack"} differentiable stack
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %em
              gerbe over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            \.
          %p
            More precisely, we may associate to any
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                  %mi C
                  %mo :
                  %mo =
                %annotation{:encoding => "application/x-tex"} X \in C :=
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                  %mi C
                  %mo :
                  %mo =
                %annotation{:encoding => "application/x-tex"} X \in C :=
            %a.existingWikiWord{:href => "/nlab/show/Diff"} Diff
            the corresponding
            %a.existingWikiWord{:href => "/nlab/show/big+site"} big site
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} /
                  %mi X
                %annotation{:encoding => "application/x-tex"} C/X
            and form the
            %a.existingWikiWord{:href => "/nlab/show/%282%2C1%29-topos"} (2,1)-topos
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi leq
                    %mi 𝒳
                    %mo :
                    %mo =
                    %msub
                      %mi Sh
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tau_{leq} \mathcal{X} := Sh_{(2,1)}(C/X)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            Equivalent to this is the
            %a.existingWikiWord{:href => "/nlab/show/over-%28%E2%88%9E%2C1%29-topos"} over-(2,1)-topos
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mrow
                        %mo ≤
                        %mn 1
                    %mi ℋ
                    %mo{:stretchy => "false"} /
                    %mi j
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tau_{\leq 1} \mathcal{H}/j(X)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi τ
                    %mrow
                      %mo ≤
                      %mn 1
                  %mi ℋ
                  %mo :
                  %mo =
                  %msub
                    %mi Sh
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \tau_{\leq 1}\mathcal{H} := Sh_{(2,1)}(C)
            is the
            %a.existingWikiWord{:href => "/nlab/show/big+topos"} big
            %a.existingWikiWord{:href => "/nlab/show/%282%2C1%29-topos"} (2,1)-topos
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            (and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                %annotation{:encoding => "application/x-tex"} j
            denotes its
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Yoneda+embedding"} (2,1)-Yoneda embedding
          %p
            Since this
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℋ
                %annotation{:encoding => "application/x-tex"} \mathcal{H}
            is a
            %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
            we may think of its objects a general
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/topological+%E2%88%9E-groupoid"} continuous ∞-groupoid
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+groupoid"} smooth ∞-groupoid
            %a{:href => "#Giraud"} Giraud
            gerbes, or related structures equivalent to them, are described this way in terms of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/topological+groupoid"} topological groupoid
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/Lie+groupoid"} Lie groupoid
            %em
              %a.existingWikiWord{:href => "/nlab/show/bundle+gerbe"} bundle gerbe
            \.
          %h3#gerbes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            \-Gerbes
          %p
            We discuss gerbes that have a “strucure group”
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            akin to a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            %em
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              \-gerbes
            are
            %a.existingWikiWord{:href => "/nlab/show/equivalence+in+an+%28%E2%88%9E%2C1%29-category"} equivalent
            to
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi AUT
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} AUT(G)
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/principal+2-bundle"} principal 2-bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi AUT
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} AUT(G)
            the
            %a.existingWikiWord{:href => "/nlab/show/automorphism+2-group"} automorphism 2-group
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          #RelationToEMObjects.num_remark
            %h6#remark Remark
            %p
              The definition
              %a.maruku-ref{:href => "#GeneralDef"}
              of
              %em gerbe
              is almost verbatim that of
              %em
                %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+object"} Eilenberg-MacLane object
              in degree 1. The only difference is that the latter is required to have not only the homotopy sheaf
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 0
                      %mo =
                      %mo *
                    %annotation{:encoding => "application/x-tex"} \pi_0 = *
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                      %mo →
                      %mi P
                    %annotation{:encoding => "application/x-tex"} * \to P
            %p
              First consider this locally. A gerbe (as any
              %a.existingWikiWord{:href => "/nlab/show/1-connected"} 1-connected
              object) necessarily has
              %em local
              sections:
            %p for
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi x
                      %mo *
                    %mo ⊣
                    %msub
                      %mi x
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mn ∞
                    %mi Grpd
                    %mover
                      %munder
                        %mo →
                        %mrow
                          %msub
                            %mi x
                            %mo *
                      %mover
                        %mo ←
                        %mrow
                          %msup
                            %mi x
                            %mo *
                    %mi 𝒳
                  %annotation{:encoding => "application/x-tex"}
                    (x^* \dashv x_*) :  \infty Grpd
                    \\stackrel{\overset{x^*}{\leftarrow}}{\underset{x_*}{\to}}
                    \\mathcal{X}
            %p
              any
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/point+of+a+topos"} topos point
              %a.existingWikiWord{:href => "/nlab/show/stalk"} stalk
              functor
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi x
                        %mo *
                    %annotation{:encoding => "application/x-tex"} x^*
              %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
              is
              %a.existingWikiWord{:href => "/nlab/show/left+exact+functor"} left exact
              and hence preserves
              %a.existingWikiWord{:href => "/nlab/show/categorical+homotopy+groups+in+an+%28%E2%88%9E%2C1%29-topos"} homotopy sheaves
              and
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %msup
                      %mi x
                      %mo *
                    %mi P
                    %mo ≃
                    %msup
                      %mi x
                      %mo *
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi x
                      %mo *
                    %mo *
                    %mo ≃
                    %mo *
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_1 x^* P \simeq x^* \pi_1(P) \simeq x^* * \simeq *
            %p
              as are all the degree-
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              homotopy sheaves for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo &gt;
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} p \gt 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mo *
                    %mi P
                  %annotation{:encoding => "application/x-tex"} x^* P
              is a
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
              with a single object: the
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              groupoid of a
              %a.existingWikiWord{:href => "/nlab/show/group"} group
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi G
                        %mi x
                    %annotation{:encoding => "application/x-tex"} G_x
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mo *
                    %mi P
                    %mo ≃
                    %mi B
                    %msub
                      %mi G
                      %mi x
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    x^* P \simeq B G_x
                    \\,.
            %p
              More generally, by the discussion at
              %a.existingWikiWord{:href => "/nlab/show/looping+and+delooping"} looping and delooping
              we have in an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalence of (∞,1)-categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Ω
                    %mo ⊣
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mn ∞
                    %mi Gpr
                    %mo{:stretchy => "false"} (
                    %mi 𝒳
                    %mo{:stretchy => "false"} )
                    %mover
                      %munder
                        %mo →
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                      %mover
                        %mo ←
                        %mi Ω
                    %msub
                      %mi 𝒳
                      %mrow
                        %mi pt
                        %mo ,
                        %mo ≥
                        %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    (\Omega \dashv \mathbf{B})
                    \:
                    \\infty Gpr(\mathcal{X})
                    \\stackrel{\overset{\Omega}{\leftarrow}}{\underset{\mathbf{B}}{\to}}
                    \\mathcal{X}_{pt, \geq 1}
            %p
              between the
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
              objects in the ambient
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒳
                  %annotation{:encoding => "application/x-tex"} \mathcal{X}
              and the
              %a.existingWikiWord{:href => "/nlab/show/pointed+object"} pointed
              %a.existingWikiWord{:href => "/nlab/show/connected"} connected
              objects.
            %p
              It follows that for a gerbe
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              that admits a global section
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo →
                    %mi P
                  %annotation{:encoding => "application/x-tex"} * \to P
              the above relation holds not only
              = succeed "-wise," do
                %a.existingWikiWord{:href => "/nlab/show/stalk"} stalk
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              of its own first
              %a.existingWikiWord{:href => "/nlab/show/categorical+homotopy+groups+in+an+%28%E2%88%9E%2C1%29-topos"} sheaf of homotopy groups
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ≃
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    P \simeq \mathbf{B} \pi_1(P)
                    \\,.
          %p
            The following definition characterizes gerbes that are
            %em locally
            of the form of remark
            = succeed "." do
              %a.maruku-ref{:href => "#RelationToEMObjects"}
          #GGerbe.num_defn
            %h6#definition_3 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ∈
                    %mi Grp
                    %mo{:stretchy => "false"} (
                    %mi 𝒳
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G \in Grp(\mathcal{X})
              be a group object. A gerbe
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ∈
                    %mi 𝒳
                  %annotation{:encoding => "application/x-tex"} P \in \mathcal{X}
              is a
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                \-gerbe
              if there exists an
              %a.existingWikiWord{:href => "/nlab/show/effective+epimorphism"} effective epimorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo →
                    %mo *
                  %annotation{:encoding => "application/x-tex"} U \to *
              and an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+in+an+%28%E2%88%9E%2C1%29-category"} equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %msub
                      %mo{:stretchy => "false"} |
                      %mi U
                    %mo ≃
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mo{:stretchy => "false"} (
                    %mi G
                    %msub
                      %mo{:stretchy => "false"} |
                      %mi U
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    P|_U \simeq \mathbf{B}(G|_U)
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %msub
                      %mo{:stretchy => "false"} |
                      %mi U
                    %mo :
                    %mo =
                    %mi P
                    %mo ×
                    %mi U
                  %annotation{:encoding => "application/x-tex"} P|_U := P \times U
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %msub
                        %mo{:stretchy => "false"} |
                        %mi U
                      %mo :
                      %mo =
                      %mi G
                      %mo ×
                      %mi U
                    %annotation{:encoding => "application/x-tex"} G|_U := G \times U
          .num_remark
            %h6#remark_2 Remark
            %p
              In a typical application one considers gerbes over some
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒳
                        %mo =
                        %msub
                          %mi Sh
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mn ∞
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mi Op
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathcal{X} = Sh_{(\infty,1)}(Op(X))
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-sheaves"} (∞,1)-category of (∞,1)-sheaves
                  on the
                  %a.existingWikiWord{:href => "/nlab/show/category+of+open+subsets"} category of open subsets
                  of
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒳
                      %annotation{:encoding => "application/x-tex"} \mathcal{X}
                  %em is
                  the space
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
                  = succeed "-topos," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn ∞
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (\infty,1)
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                          %mo :
                          %mo =
                          %mo *
                          %mo ∈
                          %mi 𝒳
                        %annotation{:encoding => "application/x-tex"} X := * \in \mathcal{X}
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/group+object"} group object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                        %mo ∈
                        %mi 𝒳
                      %annotation{:encoding => "application/x-tex"} G \in \mathcal{X}
                  is
                  %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
                  of
                  = succeed "s" do
                    %a.existingWikiWord{:href => "/nlab/show/group"} group
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
              %li
                %p
                  an
                  %a.existingWikiWord{:href => "/nlab/show/effective+epimorphism"} effective epimorphism
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi U
                          %mo →
                          %mo *
                        %annotation{:encoding => "application/x-tex"} U \to *
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo →
                        %mo *
                      %annotation{:encoding => "application/x-tex"} U \to *
                  is obtained from any
                  %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi U
                          %mi i
                        %mo →
                        %mi X
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{U_i \to X\}
                  by setting
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi U
                          %mo :
                          %mo =
                          %msub
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                            %mi i
                          %msub
                            %mi U
                            %mi i
                        %annotation{:encoding => "application/x-tex"} U := \coprod_i U_i
              %li
                %p
                  with such a choice of effective epimorphism,
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                        %msub
                          %mo{:stretchy => "false"} |
                          %mi U
                        %mo =
                        %msub
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                          %mi i
                        %mi G
                        %msub
                          %mo{:stretchy => "false"} |
                          %mrow
                            %msub
                              %mi U
                              %mi i
                      %annotation{:encoding => "application/x-tex"} G|_U = \coprod_i G|_{U_i}
                  is simply the restriction of the sheaf of groups
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                  to each
                  %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
                  that is a member of the cover;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %msub
                          %mi G
                          %mi U
                        %mo ∈
                        %mi 𝒳
                        %mo{:stretchy => "false"} /
                        %mi U
                      %annotation{:encoding => "application/x-tex"} \mathbf{B}G_{U} \in \mathcal{X}/U
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/stack"} stack
                  of
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi G
                            %mi U
                        %annotation{:encoding => "application/x-tex"} G_{U}
                  = succeed "s" do
                    %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi U
                        %annotation{:encoding => "application/x-tex"} U
          %h2#properties Properties
          %h3#equivalence_of_gerbes_to_2bundles
            Equivalence of
            = succeed "-gerbes" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "-2-bundles" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi AUT
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} AUT(G)
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒳
                %annotation{:encoding => "application/x-tex"} \mathcal{X}
            be any ambient
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo ∈
                  %mi Grp
                  %mo{:stretchy => "false"} (
                  %mi 𝒳
                  %mo{:stretchy => "false"} )
                  %mo ⊂
                  %mn ∞
                  %mi Grpd
                  %mo{:stretchy => "false"} (
                  %mi 𝒳
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G \in Grp(\mathcal{X}) \subset \infty Grpd(\mathcal{X})
            be a
            %a.existingWikiWord{:href => "/nlab/show/group+object"} group object
            (a
            %a.existingWikiWord{:href => "/nlab/show/0-truncated"} 0-truncated
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
          %p Write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mi Gerbe
                  %mo ⊂
                  %mi 𝒳
                %annotation{:encoding => "application/x-tex"}
                  G Gerbe \subset \mathcal{X}
          %p
            for the
            %a.existingWikiWord{:href => "/nlab/show/core"} core
            of the full
            %a.existingWikiWord{:href => "/nlab/show/sub-%28%E2%88%9E%2C1%29-category"} sub-(∞,1)-category
            on
            = succeed "-gerbes" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒳
                  %annotation{:encoding => "application/x-tex"} \mathcal{X}
          %p Write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi AUT
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %msub
                    %mi Aut
                    %mrow
                      %msub
                        %mi 𝒳
                        %mo *
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mn 2
                  %mi Grp
                  %mo{:stretchy => "false"} (
                  %mi 𝒳
                  %mo{:stretchy => "false"} )
                  %mo ⊂
                  %mn ∞
                  %mi Grp
                  %mo{:stretchy => "false"} (
                  %mi 𝒳
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  AUT(G) :=
                  Aut_{\mathcal{X}_{*}}(\mathbf{B}G)
                  \\in
                  2 Grp(\mathcal{X}) \subset \infty Grp(\mathcal{X})
          %p
            for the
            %a.existingWikiWord{:href => "/nlab/show/2-group"} 2-group
            object called the
            %a.existingWikiWord{:href => "/nlab/show/automorphism+2-group"} automorphism 2-group
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          #ClassificationOfGGerbes.num_prop
            %h6#proposition Proposition
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              \-gerbes in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒳
                  %annotation{:encoding => "application/x-tex"} \mathcal{X}
              are classified by first
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi AUT
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} AUT(G)
              %a.existingWikiWord{:href => "/nlab/show/nonabelian+cohomology"} nonabelian cohomology
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mi G
                    %mi Gerbe
                    %mo ≃
                    %msub
                      %mi π
                      %mn 0
                    %mi 𝒳
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi AUT
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo :
                    %msubsup
                      %mi H
                      %mi 𝒳
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi AUT
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_0 G Gerbe \simeq \pi_0 \mathcal{X}(*, \mathbf{B} AUT(G))
                    \=:
                    H_{\mathcal{X}}^1(X,AUT(G))
                    \\,.
          %p
            In the general perspective of
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos+theory"} (∞,1)-topos theory
            this appears as (
            %a{:href => "#JardineLuo"}> Jardine &amp; Luo, theorem 23
            ).
          .num_cor
            %h6#corollary Corollary
            %p
              Since
              %a.existingWikiWord{:href => "/nlab/show/nonabelian+cohomology"} nonabelian cohomology
              with coefficients in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi AUT
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} AUT(G)
              also classified
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi AUT
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} AUT(G)
              %a.existingWikiWord{:href => "/nlab/show/principal+2-bundles"} principal 2-bundles
              it follows that also
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mi G
                    %mi Gerbe
                    %mo ≃
                    %mi AUT
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mn 2
                    %mi Bund
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_0 G Gerbe \simeq AUT(G) 2Bund(*)
                    \\,.
            %p
              Notice that under this equivalence a
              = succeed "-gerbe" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi AUT
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} AUT(G)
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/principal+2-bundle"} principal 2-bundle
              = succeed "-factor." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Aut
                      %mo{:stretchy => "false"} (
                      %mi H
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Aut(H)
              = succeed "-gerbe" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mo{:stretchy => "false"} (
                    %mi G
                    %msub
                      %mo{:stretchy => "false"} |
                      %mi U
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi G
                    %msub
                      %mo{:stretchy => "false"} |
                      %mi U
                    %mover
                      %mo →
                      %mo →
                    %mo *
                    %msub
                      %mo{:stretchy => "false"} |
                      %mi U
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{B}(G|_U)
                    \=
                    G|_U \stackrel{\to}{\to} *|_U
            %p
              an
              = succeed "-principal" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi AUT
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} AUT(G)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi AUT
                    %mo{:stretchy => "false"} (
                    %mi G
                    %msub
                      %mo{:stretchy => "false"} |
                      %mi U
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi Aut
                    %mo{:stretchy => "false"} (
                    %mi G
                    %msub
                      %mo{:stretchy => "false"} |
                      %mi U
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi G
                    %mover
                      %munder
                        %mo →
                        %mrow
                          %msub
                            %mi p
                            %mn 1
                      %mover
                        %mo →
                        %mrow
                          %mi Ad
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi p
                            %mn 2
                          %mo{:stretchy => "false"} )
                          %mo ⋅
                          %msub
                            %mi p
                            %mn 1
                    %mi Aut
                    %mo{:stretchy => "false"} (
                    %mi G
                    %msub
                      %mo{:stretchy => "false"} |
                      %mi U
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    AUT(G|_U)
                    \=
                    Aut(G|_U) \times G
                    \\stackrel{\overset{Ad(p_2) \cdot p_1}{\to}}{\underset{p_1}{\to}}
                    Aut(G|_U)
                    \\,.
            %p
              Instead, under the above equivalence a gerbe is identified with the
              %a.existingWikiWord{:href => "/nlab/show/associated+%E2%88%9E-bundle"} associated ∞-bundle
              with fibers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G
              that is associated via the canonical
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi AUT
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi Aut
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} AUT(G) = Aut(\mathbf{B}G)
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}G
          %h3#banded_gerbes Banded gerbes
          %p
            For
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ∈
                    %mi Grp
                    %mo{:stretchy => "false"} (
                    %mi 𝒢
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G \in Grp(\mathcal{G})
            %a.existingWikiWord{:href => "/nlab/show/automorphism+2-group"} automorphism 2-group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi AUT
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} AUT(G)
            has a canonical morphism to its
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/0-truncated"} 0-truncation
            %a.existingWikiWord{:href => "/nlab/show/outer+automorphism"} outer automorphism
            group object of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo →
                  %mi AUT
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi π
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi Aut
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo :
                  %mi Out
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\to AUT(G) \to \pi_0(Aut(G)) =:  Out(G)
                  \\,.
          %p
            Therefore every
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi AUT
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} AUT(G)
            %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
            has an underlying
            = succeed "-cocycle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Out
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Out(G)
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Out
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Out(G)
            = succeed "):" do
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒳
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi AUT
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi 𝒳
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi Out
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{X}(* , \mathbf{B}AUT(G))
                  \\to
                  \\mathcal{X}(* , \mathbf{B}Out(G))
                  \\,.
          %p
            By prop.
            %a.maruku-ref{:href => "#ClassificationOfGGerbes"}
            this an assignment of
            = succeed "-cohomology" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Out
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Out(G)
            = succeed "-gerbes:" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Band
                  %mo :
                  %msub
                    %mi π
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mi Gerbe
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msubsup
                    %mi H
                    %mi 𝒳
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi Out
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Band : \pi_0 ( G Gerbe ) \to H_{\mathcal{X}}^1(X,Out(G))
                  \\,.
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo ∈
                  %mi G
                  %mi Gerbe
                %annotation{:encoding => "application/x-tex"} P \in G Gerbe
            one says that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Band
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Band(P)
            is its
            = succeed "." do
              %strong band
          %p
            Sometimes in applications one considers not just the restriction from all gerbes to
            = succeed "-gerbes" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "-banded" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            = succeed "-gerbes" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ∈
                    %msubsup
                      %mi H
                      %mi 𝒳
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Out
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K \in H_{\mathcal{X}}^1(X,Out(G))
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %msub
                    %mi Gerbe
                    %mi K
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G Gerbe_K(X)
            of
            = succeed "-banded" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted
            = succeed "-cohomology" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 2
                    %mi Z
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}^2 Z(G)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            (where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Z
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Z(G)
