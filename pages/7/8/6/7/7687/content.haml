                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
            %ol
              %li
                %p
                  %math#mathml_21364f8986cac2aa35921024845687ea6cc6b9e0_3.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/Cartier+dual"} Cartier dual
                  of a constant group.
              %li
                %p
                  %math#mathml_21364f8986cac2aa35921024845687ea6cc6b9e0_4.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                  is an affine
                  = succeed "-group" do
                    %math#mathml_21364f8986cac2aa35921024845687ea6cc6b9e0_5.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                        %annotation{:encoding => "application/x-tex"} k
                  = succeed "-ring" do
                    %math#mathml_21364f8986cac2aa35921024845687ea6cc6b9e0_6.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                        %annotation{:encoding => "application/x-tex"} k
                  %math#mathml_21364f8986cac2aa35921024845687ea6cc6b9e0_7.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi O
                        %mo{:stretchy => "false"} (
