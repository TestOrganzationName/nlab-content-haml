                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} p\neq 0)
                  %math#mathml_21364f8986cac2aa35921024845687ea6cc6b9e0_22.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
