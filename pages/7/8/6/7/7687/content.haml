          .num_theorem
            %h6#theorem Theorem
            %p
              Let
              %math#mathml_21364f8986cac2aa35921024845687ea6cc6b9e0_11.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
