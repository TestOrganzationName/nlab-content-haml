                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \hat D(G)
                  is an
                  %span.newWikiWord
                    étale
                    %a{:href => "/nlab/new/%C3%A9tale+group+scheme"} ?
                  = succeed "-formal" do
                    %math#mathml_21364f8986cac2aa35921024845687ea6cc6b9e0_19.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                        %annotation{:encoding => "application/x-tex"} k
              %li
                %p
                  %math#mathml_21364f8986cac2aa35921024845687ea6cc6b9e0_20.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Gr
                          %mi k
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo ,
                        %msub
                          %mi α
                          %mi k
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} Gr_k(G,\alpha_k)=0
              %li
                %p
                  (If
                  = succeed "," do
                    %math#mathml_21364f8986cac2aa35921024845687ea6cc6b9e0_21.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi p
