                          %mi k
                        %msub
                          %mi k
                          %mi s
                      %annotation{:encoding => "application/x-tex"} G\otimes_k k_s
                  is diagonalizable.
              %li
                %p
                  %math#mathml_21364f8986cac2aa35921024845687ea6cc6b9e0_14.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                        %msub
                          %mo ⊗
                          %mi k
                        %mi K
                      %annotation{:encoding => "application/x-tex"} G\otimes_k K
                  is diagonalizable for a field
                  = succeed "." do
                    %math#mathml_21364f8986cac2aa35921024845687ea6cc6b9e0_15.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi K
                          %mo ∈
                          %msub
                            %mi M
                            %mi k
                        %annotation{:encoding => "application/x-tex"} K\in M_k
              %li
                %p
                  %math#mathml_21364f8986cac2aa35921024845687ea6cc6b9e0_16.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/Cartier+duality"} Cartier dual
                  of an étale
                  = succeed "-group." do
                    %math#mathml_21364f8986cac2aa35921024845687ea6cc6b9e0_17.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                        %annotation{:encoding => "application/x-tex"} k
              %li
                %p
                  %math#mathml_21364f8986cac2aa35921024845687ea6cc6b9e0_18.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
