                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
            %ol
              %li
                %p
                  %math#mathml_21364f8986cac2aa35921024845687ea6cc6b9e0_13.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
