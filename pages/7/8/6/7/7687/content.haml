          .num_remark
            %h6#remark Remark
            %p
              Let
              %math#mathml_21364f8986cac2aa35921024845687ea6cc6b9e0_1.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
