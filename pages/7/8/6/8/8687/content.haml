          .num_prop
            %h6 Proposition
            %p
              If the unital comonoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              admits an object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              of primitive elements, the
              %a.existingWikiWord{:href => "/nlab/show/commutative+rig"} commutative rig
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo{:stretchy => "false"} [
                    %mi I
                    %mo ,
                    %mi I
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}[I,I]
              verifies
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mo ≠
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 2 \neq 1
              = succeed "[A,B]" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %a.existingWikiWord{:href => "/nlab/show/multiplicatively+cancellative+modules"} multiplicatively cancellative modules
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                      %mo{:stretchy => "false"} [
                      %mi I
                      %mo ,
                      %mi I
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}[I,I]
