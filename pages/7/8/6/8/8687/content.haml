                  %mi x
                %annotation{:encoding => "application/x-tex"} \sigma(x) = -x
            for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi L
                  %annotation{:encoding => "application/x-tex"} x \in L
          %p The following proposition is entirely straightfoward:
          .num_prop
            %h6#proposition Proposition
            %p
              The functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo :
                    %mi LieAlg
                    %mo →
                    %mi BiAlg
                  %annotation{:encoding => "application/x-tex"} U: LieAlg \to BiAlg
              is
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              to the functor
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mo :
                      %mi BiAlg
                      %mo →
                      %mi LieAlg
                    %annotation{:encoding => "application/x-tex"} P: BiAlg \to LieAlg
          %p
            This result is essentially tautologous and holds for any commutative ring of arbitrary characteristic. (This despite the fact that the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} U(L)
            as defined above is not as well-behaved in nonzero characteristic as one might like; e.g. the
            %a.existingWikiWord{:href => "/nlab/show/PBW+theorem"} PBW theorem
            fails.) More information on this adjunction may require more restrictive hypotheses:
          .num_prop
            %h6#proposition_2 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo =
                    %mi k
                  %annotation{:encoding => "application/x-tex"} R = k
              a
              %a.existingWikiWord{:href => "/nlab/show/field"} field
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/characteristic+zero"} characteristic zero
              %a.existingWikiWord{:href => "/nlab/show/adjunction+unit"} unit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo →
                    %mi P
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} L \to P U(L)
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
          %p
            An immediate consequence is that for such ground fields
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo :
                  %mi LieAlg
                  %mo →
                  %mi BiAlg
                %annotation{:encoding => "application/x-tex"} U: LieAlg \to BiAlg
            is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            lands in the full subcategory of cocommutative Hopf algebras, which is exactly the category of
            %a.existingWikiWord{:href => "/nlab/show/group+objects"} group objects
            in the
            %a.existingWikiWord{:href => "/nlab/show/cartesian+monoidal+category"} cartesian monoidal category
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cocommutative+coalgebras"} cocommutative coalgebras
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/Milnor-Moore+theorem"} Milnor-Moore theorem
            gives further information: for Hopf algebras over a field of characteristic zero, the counit
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi H
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi H
                %annotation{:encoding => "application/x-tex"} U P(H) \to H
            is a monomorphism, and an isomorphism in case
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            satisfies a suitable conilpotency condition.
          %p (More needs to be added.)
