                    %mi R
                  %mi C
                  %mo ,
                  %mi ϵ
                  %mo :
                  %mi C
                  %mo →
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (C, \Delta: C \to C \otimes_R C, \epsilon: C \to R)
            equipped with a coalgebra map
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo :
                    %mi R
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} u: R \to C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi C
                %annotation{:encoding => "application/x-tex"} u(1) \in C
            by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
          %h3#primitive_element_in_a_coalgebra Primitive element in a coalgebra
          %p
            An element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            in a
            %a.existingWikiWord{:href => "/nlab/show/coalgebra"} coalgebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is
            %strong primitive
            if
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
                    %mo ⊗
                    %mi x
                    %mo +
                    %mi x
                    %mo ⊗
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \Delta(x) = 1\otimes x + x\otimes 1
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \epsilon(x) = 0
          %p
            This notion generalizes straightforwardly to unital
            %a.existingWikiWord{:href => "/nlab/show/corings"} corings
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            and even more generally to any
            %a.existingWikiWord{:href => "/nlab/show/comonoid+object"} unital comonoid object
            in a
            %a.existingWikiWord{:href => "/nlab/show/CMon-enriched+monoidal+category"} CMon-enriched monoidal category
            (see below).
          %h3#primitive_element_in_a_comodule Primitive element in a comodule
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            be a
            %a.existingWikiWord{:href => "/nlab/show/comodule"} comodule
            over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ψ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi N
                    %mo ⟶
                    %mi C
                    %msub
                      %mo ⊗
                      %mi R
                    %mi N
                  %annotation{:encoding => "application/x-tex"} \Psi \colon N \longrightarrow C \otimes_R N
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ∈
                  %mi N
                %annotation{:encoding => "application/x-tex"} n \in N
            is called a
            %strong primitive element
            or
            %strong
              %a.existingWikiWord{:href => "/nlab/show/coinvariant"} coinvariant
            if
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ψ
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
                    %mo ⊗
                    %mi n
                  %annotation{:encoding => "application/x-tex"} \Psi(n) = 1 \otimes n
          %p
            The
            = succeed "-module" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi prim
                  %mo{:stretchy => "false"} (
                  %mi N
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} prim(N)
            of primitive elements of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            is
            %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} naturally
            to
          %ol
            %li
              %p
                the module of comodule homomorphisms out of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
                into
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                    %annotation{:encoding => "application/x-tex"} N
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi prim
                      %mo{:stretchy => "false"} (
                      %mi N
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %msub
                        %mi Hom
                        %mi C
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo ,
                      %mi N
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      prim(N) \simeq Hom_{C}(R,N)
                      \\,.
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/cotensor+product"} cotensor product
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                    %annotation{:encoding => "application/x-tex"} N
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi prim
                      %mo{:stretchy => "false"} (
                      %mi N
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mi R
                      %msub
                        %mo □
                        %mi R
                      %mi N
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      prim(N) \simeq R \Box_R N
                      \\,.
          %h3#object_of_primitive_elements_of_a_unital_comonoid_in_a_enriched_monoidal_category
            Object of primitive elements of a unital comonoid in a
            = succeed "-enriched" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CMon
                  %annotation{:encoding => "application/x-tex"} CMon
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mi Δ
                  %mo ,
                  %mi ϵ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (C,\Delta,\epsilon)
            be a
            %a.existingWikiWord{:href => "/nlab/show/comonoid+object"} unital comonoid object
            in a
            %a.existingWikiWord{:href => "/nlab/show/CMon-enriched+monoidal+category"} CMon-enriched monoidal category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
