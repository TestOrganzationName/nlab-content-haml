            %p We thus have that:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo =
                    %mi i
                    %mo ;
                    %mi Δ
                    %mo ;
                    %mn 1
                    %mo ⊗
                    %mi ϵ
                    %mo =
                    %mi i
                    %mo ;
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ⊗
                    %mi η
                    %mo +
                    %mi η
                    %mo ⊗
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ;
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ⊗
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} i = i;\Delta;1 \otimes \epsilon = i;(1 \otimes \eta + \eta \otimes 1);(1 \otimes \epsilon)
            %p and:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ;
                    %mi ϵ
                    %mo =
                    %mi i
                    %mo ;
                    %mi Δ
                    %mo ;
                    %mn 1
                    %mo ⊗
                    %mi ϵ
                    %mo ;
                    %mi ϵ
                    %mo =
                    %mi i
                    %mo ;
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ⊗
                    %mi η
                    %mo +
                    %mi η
                    %mo ⊗
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ;
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ⊗
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                    %mo ;
                    %mi ϵ
                  %annotation{:encoding => "application/x-tex"}
                    i;\epsilon = i;\Delta;1 \otimes \epsilon;\epsilon = i;(1 \otimes \eta + \eta \otimes 1);(1 \otimes \epsilon);\epsilon
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo =
                    %mi i
                    %mo ;
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ⊗
                    %mi η
                    %mo{:stretchy => "false"} )
                    %mo ;
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ⊗
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                    %mo ;
                    %mi ϵ
                    %mo +
                    %mi i
                    %mo ;
                    %mo{:stretchy => "false"} (
                    %mi η
                    %mo ⊗
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ;
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ⊗
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                    %mo ;
                    %mi ϵ
                  %annotation{:encoding => "application/x-tex"}
                    \= i;(1 \otimes \eta);(1 \otimes \epsilon);\epsilon + i;(\eta \otimes 1);(1 \otimes \epsilon);\epsilon
            %p
              We then have:
              %img{:src => "/nlab/files/primitive.png"}/
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo{:stretchy => "false"} [
                    %mi P
                    %mo ,
                    %mi I
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}[P,I]
              being a multiplicatively cancellative
              = succeed "-module," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                      %mo{:stretchy => "false"} [
                      %mi I
                      %mo ,
                      %mi I
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}[I,I]
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ;
                      %mi ϵ
                      %mo ≠
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} i;\epsilon \neq 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo =
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 1 = 2
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo{:stretchy => "false"} [
                    %mi I
                    %mo ,
                    %mi I
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}[I,I]
              which is false, therefore
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ;
                      %mi ϵ
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} i;\epsilon = 0
          %h2#properties Properties
          %h3#primitives_in_a_hopf_algebra Primitives in a Hopf algebra
          %p
            A straightforward calculation shows that the module of primitive elements in a
            %a.existingWikiWord{:href => "/nlab/show/Hopf+algebra"} Hopf algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            (or even in a
            %a.existingWikiWord{:href => "/nlab/show/bialgebra"} bialgebra
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            (whose bracket is the algebra
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/commutator"} commutator
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo :
                  %mi HopfAlg
                  %mo →
                  %mi LieAlg
                %annotation{:encoding => "application/x-tex"} P: HopfAlg \to LieAlg
          %p
            (and of course we have more generally a functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo :
                  %mi BiAlg
                  %mo →
                  %mi LieAlg
                %annotation{:encoding => "application/x-tex"} P: BiAlg \to LieAlg
            which is an extension along the full inclusion
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi HopfAlg
                    %mo →
                    %mi BiAlg
                  %annotation{:encoding => "application/x-tex"} HopfAlg \to BiAlg
          %p
            For a Lie algebra
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} U(L)
            be its
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/universal+enveloping+algebra"} universal enveloping algebra
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mi I
                %annotation{:encoding => "application/x-tex"} U(L) = T(L)/I
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            is the two-sided ideal generated by elements of the form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mi y
                  %mo −
                  %mi y
                  %mi x
                  %mo −
                  %mo{:stretchy => "false"} [
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} x y - y x - [x, y]
            where
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ,
                    %mi y
                    %mo ∈
                    %mi L
                  %annotation{:encoding => "application/x-tex"} x, y \in L
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi δ
                  %mo :
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \delta: U(L) \to U(L) \otimes U(L)
            is uniquely determined by the rule
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi δ
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 1
                  %mo ⊗
                  %mi x
                  %mo +
                  %mi x
                  %mo ⊗
                  %mn 1
                %annotation{:encoding => "application/x-tex"} \delta(x) = 1 \otimes x + x \otimes 1
            for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi L
                  %annotation{:encoding => "application/x-tex"} x \in L
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi L
                %annotation{:encoding => "application/x-tex"} x \in L
            is primitive, the counit
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϵ
                  %mo :
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi R
                %annotation{:encoding => "application/x-tex"} \epsilon: U(L) \to R
            is forced to be the algebra map such
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϵ
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} \epsilon(x) = 0
            for all
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi L
                  %annotation{:encoding => "application/x-tex"} x \in L
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
