          #MayerVietorisSequenceInGeneralizedCohomology.num_prop
            %h6#proposition_24 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Mayer-Vietoris+sequence"}> Mayer-Vietoris sequence
                )
            %p
              Given
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mo •
                  %annotation{:encoding => "application/x-tex"} E^\bullet
              an unreduced cohomology theory, def.
              = succeed "." do
                %a.maruku-ref{:href => "#GeneralizedCohomologyTheory"}
              %a.existingWikiWord{:href => "/nlab/show/interior"} interior
              of two spaces as
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo =
                      %mi Int
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo ∪
                      %mi Int
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} X = Int(A) \cup Int(B)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ⊂
                    %mi A
                    %mo ∩
                    %mi B
                  %annotation{:encoding => "application/x-tex"} C \subset A \cap B
              there is a
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence"} long exact sequence
              of cohomology groups of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo →
                    %msup
                      %mi E
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ∩
                    %mi B
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mover
                        %mi δ
                        %mo{:stretchy => "false"} ¯
                    %msup
                      %mi E
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mi E
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo ⊕
                    %msup
                      %mi E
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mi E
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ∩
                    %mi B
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ⋯
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots
                    \\to
                    E^{n-1}(A \cap B , C)
                    \\overset{\bar \delta}{\longrightarrow}
                    E^n(X,C)
                    \\longrightarrow
                    E^n(A,C) \oplus E^n(B,C)
                    \\longrightarrow
                    E^n(A \cap B, C)
                    \\to
                    \\cdots
                    \\,.
          %p
            e.g. (
            %a{:href => "#Switzer75"}> Switzer 75, theorem 7.19
            ,
            = succeed ")" do
              %a{:href => "#AguilarGitlerPrieto02"} Aguilar-Gitler-Prieto 02, theorem 12.1.22
          %h3#RelationBetweenReducedAndUnreduced The relation
          #FromUnreducedToReducedCohomology.num_defn
            %h6#definition_40 Definition
            %p
              %strong (unreduced to reduced cohomology)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mo •
                  %annotation{:encoding => "application/x-tex"} E^\bullet
              be an unreduced cohomology theory, def.
              = succeed "." do
                %a.maruku-ref{:href => "#GeneralizedCohomologyTheory"}
              %a.maruku-ref{:href => "#ReducedGeneralizedCohomology"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mo •
                    %mo ,
                    %mi σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\tilde E^\bullet, \sigma)
              as follows.
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo{:lspace => "verythinmathspace"} :
                    %mo *
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \colon \ast \to X
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/pointed+topological+space"} pointed topological space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde E^\bullet(X,x) \coloneqq E^\bullet(X,\{x\})
                    \\,.
            %p
              This is clearly
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/functor"} functorial
              %a.existingWikiWord{:href => "/nlab/show/suspension+isomorphism"} suspension isomorphism
              to be the composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi E
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mi X
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msup
                          %mi E
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo{:stretchy => "false"} )
                    %msup
                      %mi E
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msup
                          %mover
                            %mi δ
                            %mo{:stretchy => "false"} ¯
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\sigma
                    \\;\colon\;
                    \\tilde E^{\bullet+1}(\Sigma X)
                    \=
                    E^{\bullet+1}(\Sigma X, \{x\})
                    \\overset{E^\bullet(p)}{\longrightarrow}
                    E^{\bullet+1}(Cone(X),X)
                    \\overset{\bar \delta^{-1}}{\longrightarrow}
                    E^\bullet(X,\{x\})
                    \=
                    \\tilde E^{\bullet}(X)
            %p
              of the isomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E^\bullet(p)
              from example
              %a.maruku-ref{:href => "#GeneralizedCohomologyOnHomotopyQuotientMaps"}
              and the
              %a.existingWikiWord{:href => "/nlab/show/inverse"} inverse
              of the isomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi δ
