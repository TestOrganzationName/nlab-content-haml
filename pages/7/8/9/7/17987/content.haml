                        %annotation{:encoding => "application/x-tex"} i
                  %strong face map
                  on
                  = succeed "-simplices;" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
              %li
                %p
                  for each
                  %a.existingWikiWord{:href => "/nlab/show/surjective+map"} surjective map
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi σ
                          %mi i
                        %mo :
                        %mover
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                          %mo ¯
                        %mo →
                        %mover
                          %mi n
                          %mo{:stretchy => "false"} ¯
                      %annotation{:encoding => "application/x-tex"} \sigma_i : \overline{n+1} \to \bar n
                  of
                  %a.existingWikiWord{:href => "/nlab/show/totally+ordered+sets"} totally ordered sets
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/function"} function
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi σ
                          %mi i
                        %mo :
                        %msub
                          %mi S
                          %mi n
                        %mo →
                        %msub
                          %mi S
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} \sigma_i : S_{n} \to S_{n+1}
                  – the
                  = succeed "th" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi i
                        %annotation{:encoding => "application/x-tex"} i
                  %strong degeneracy map
                  on
                  = succeed "-simplices;" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
            %p
              such that these functions satisfy the
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+identities"} simplicial identities
          #SimplicialIdentities.num_defn
            %h6#definition_16 Definition
            %p
              The
              %strong simplicial identities
              satisfied by face and degeneracy maps as above are (whenever these maps are composable as indicated):
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi d
                          %mi i
                        %mo ∘
                        %msub
                          %mi d
                          %mi j
                        %mo =
                        %msub
                          %mi d
                          %mrow
                            %mi j
                            %mo −
                            %mn 1
                        %mo ∘
                        %msub
                          %mi d
                          %mi i
                      %annotation{:encoding => "application/x-tex"} d_i \circ d_j  = d_{j-1} \circ d_i
                  if
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi i
                          %mo &lt;
                          %mi j
                        %annotation{:encoding => "application/x-tex"} i \lt j
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi s
                          %mi i
                        %mo ∘
                        %msub
                          %mi s
                          %mi j
                        %mo =
                        %msub
                          %mi s
                          %mi j
                        %mo ∘
                        %msub
                          %mi s
                          %mrow
                            %mi i
                            %mo −
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} s_i \circ s_j  = s_j \circ s_{i-1}
                  if
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi i
                          %mo &gt;
                          %mi j
                        %annotation{:encoding => "application/x-tex"} i \gt j
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi d
                          %mi i
                        %mo ∘
                        %msub
                          %mi s
                          %mi j
                        %mo =
                        %mrow
                          %mo {
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                  %msub
                                    %mi s
                                    %mrow
                                      %mi j
                                      %mo −
                                      %mn 1
                                  %mo ∘
                                  %msub
                                    %mi d
                                    %mi i
                                %mtd
                                  %mi if
                                  %mspace{:width => "thickmathspace"}
                                  %mi i
                                  %mo &lt;
                                  %mi j
                              %mtr
                                %mtd
                                  %mi id
                                %mtd
                                  %mi if
                                  %mspace{:width => "thickmathspace"}
                                  %mi i
                                  %mo =
                                  %mi j
                                  %mspace{:width => "thickmathspace"}
                                  %mi or
                                  %mspace{:width => "thickmathspace"}
                                  %mi i
                                  %mo =
                                  %mi j
                                  %mo +
                                  %mn 1
                              %mtr
                                %mtd
                                  %msub
                                    %mi s
                                    %mi j
                                  %mo ∘
                                  %msub
                                    %mi d
                                    %mrow
                                      %mi i
                                      %mo −
                                      %mn 1
                                %mtd
                                  %mi if
                                  %mi i
                                  %mo &gt;
                                  %mi j
                                  %mo +
                                  %mn 1
                      %annotation{:encoding => "application/x-tex"} d_i \circ s_j =  \left\{ \array{ s_{j-1} \circ d_i &amp;  if \;  i \lt j \\ id &amp; if  \;  i = j \; or \; i = j+1 \\ s_j \circ d_{i-1} &amp;  if i \gt j+1 } \right.
          %p
            It is straightforward to check by explicit inspection that the evident injection and restriction maps between the sets of
            %a.existingWikiWord{:href => "/nlab/show/singular+simplices"} singular simplices
            make
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Sing
                  %mi X
                  %msub
                    %mo{:stretchy => "false"} )
                    %mo •
                %annotation{:encoding => "application/x-tex"} (Sing X)_\bullet
            into a simplicial set. We now briefly indicate a systematic way to see this using basic
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Sing
                  %mi X
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi n
                %annotation{:encoding => "application/x-tex"} (Sing X)_n
            in prop.
            %a.maruku-ref{:href => "#FreeAbelianGroup"}
            below.
          .num_defn
            %h6#definition_17 Definition
            %p
              The
              %strong
                %a.existingWikiWord{:href => "/nlab/show/simplex+category"} simplex category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                  %annotation{:encoding => "application/x-tex"} \Delta
              is the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              of
              %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
              on the free categories of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mo ≔
                            %mo{:stretchy => "false"} {
                            %mn 0
                            %mo{:stretchy => "false"} }
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mn 1
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mo ≔
                            %mo{:stretchy => "false"} {
                            %mn 0
                            %mo →
                            %mn 1
                            %mo{:stretchy => "false"} }
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mn 2
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mo ≔
                            %mo{:stretchy => "false"} {
                            %mn 0
                            %mo →
                            %mn 1
                            %mo →
                            %mn 2
                            %mo{:stretchy => "false"} }
                        %mtr
                          %mtd
                            %mi ⋮
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    [0] &amp; \coloneqq \{0\}
                    \\\
                    [1] &amp; \coloneqq \{0 \to 1\}
                    \\\
                    [2] &amp; \coloneqq \{0 \to 1 \to 2\}
                    \\\
                    \\vdots
                    \\end{aligned}
                    \\,.
          .num_remark
            %h6#remark_3 Remark
            %p
              This is called the “simplex category” because we are to think of the object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [n]
              as being the “
              %a.existingWikiWord{:href => "/nlab/show/spine"}> spine
              ” of the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/simplex"} simplex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} n = 2
              we think of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mn 1
                    %mo →
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 0 \to 1 \to 2
              as the “spine” of the triangle. This becomes clear if we don’t just draw the morphisms that
              %em generate
              the category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [n]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} n = 2
              we have_
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 2
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mn 1
                          %mtr
                            %mtd
                            %mtd
                              %mo ↗
                            %mtd
                            %mtd
                              %mo ↘
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                            %mtd
                              %mo →
                            %mtd
                            %mtd
                              %mn 2
                      %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [2]
                    \=
                    \\left\{
                    \\array{
                    \&amp;&amp; 1
                    \\\
                    \&amp; \nearrow &amp;&amp; \searrow
                    \\\
                    0 &amp;&amp;\to&amp;&amp; 2
                    }
                    \\right\}
                    \\,.
          .num_prop
            %h6#proposition_5 Proposition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo :
                    %msup
                      %mi Δ
                      %mi op
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"}
                    S : \Delta^{op} \to Set
            %p
              from the
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
              of the
              %a.existingWikiWord{:href => "/nlab/show/simplex+category"} simplex category
              to the category
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              of sets is canonically identified with a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
              = succeed "." do
                %a.maruku-ref{:href => "#SimplicialSet"}
          .proof
            %h6#proof_3 Proof
            %p
              One checks by inspection that the simplicial identities characterize precisely the behaviour of the morphisms in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Δ
                      %mi op
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Delta^{op}([n],[n+1])
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Δ
                        %mi op
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo ,
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Delta^{op}([n],[n-1])
          %p This makes the following evident:
          #StandardCosimplicialTopologicalSpace.num_example
            %h6#example_7 Example
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/topological+simplices"} topological simplices
              from def.
              %a.maruku-ref{:href => "#TopologicalSimplex"}
              arrange into a
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/cosimplicial+object"} cosimplicial object
                  in
                  %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Δ
                      %mo •
                    %mo :
                    %mi Δ
                    %mo →
                    %mi Top
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Delta^\bullet : \Delta \to Top
                    \\,.
          %p
            With this now the structure of a simplicial set on the singular simplices
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Sing
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                  %annotation{:encoding => "application/x-tex"} (Sing X)_\bullet
            = succeed "," do
              %a.maruku-ref{:href => "#SingularSimplex"}
            %em
              %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            with respect to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Δ
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \Delta^\bullet
          #SingularSimplicialComplex.num_defn
            %h6#definition_18 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              its
              %strong
                %a.existingWikiWord{:href => "/nlab/show/singular+simplicial+complex"} simplicial set of singular simplicies
              (often called the
              = succeed ")" do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/singular+simplicial+complex"} singular simplicial complex
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Sing
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                    %mo :
                    %msup
                      %mi Δ
                      %mi op
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"}
                    (Sing X)_\bullet : \Delta^{op} \to Set
            %p
              is given by composition of the functor from example
              %a.maruku-ref{:href => "#StandardCosimplicialTopologicalSpace"}
              with the
              %a.existingWikiWord{:href => "/nlab/show/hom+functor"} hom functor
              of
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Sing
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo ↦
                    %msub
                      %mi Hom
                      %mi Top
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mi n
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (Sing X) : [n] \mapsto Hom_{Top}( \Delta^n , X )
                    \\,.
          .num_remark
            %h6#remark_aside Remark (aside)
            %p
              It turns out that
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
              of the topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is entirely captured by its singular simplicial complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sing
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Sing X
              (this is the content of the
              = succeed ")." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+hypothesis"}> homotopy hypothesis
                  \-theorem
          %p
            Now we
            %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelianize
            the singular simplicial complex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Sing
                  %mi X
                  %msub
                    %mo{:stretchy => "false"} )
                    %mo •
                %annotation{:encoding => "application/x-tex"} (Sing X)_\bullet
            in order to make it
            %em simpler
            and hence more tractable.
          #FormalLinearCombination.num_defn
            %h6#definition_19 Definition
            %p
              A
              %strong formal linear combination
              of elements of a
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} S \in
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              is a
              %a.existingWikiWord{:href => "/nlab/show/function"} function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo :
                    %mi S
                    %mo →
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"}
                    a : S \to \mathbb{Z}
            %p
              such that only finitely many of the values
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mi s
                    %mo ∈
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} a_s \in \mathbb{Z}
              are non-zero.
            %p
              Identifying an element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo ∈
                    %mi S
                  %annotation{:encoding => "application/x-tex"} s \in S
              with the function
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo →
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} S \to \mathbb{Z}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                  %annotation{:encoding => "application/x-tex"} s
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ∈
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} 1 \in \mathbb{Z}
              and all other elements to 0, this is written as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi s
                        %mo ∈
                        %mi S
                    %msub
                      %mi a
                      %mi s
                    %mo ⋅
                    %mi s
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    a = \sum_{s \in S} a_s \cdot s
                    \\,.
            %p
              In this expression one calls
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mi s
                    %mo ∈
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} a_s \in \mathbb{Z}
              the
              %a.existingWikiWord{:href => "/nlab/show/coefficient"} coefficient
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                  %annotation{:encoding => "application/x-tex"} s
              in the formal linear combination.
          #GroupOfFormalLinearCombinations.num_defn
            %h6#remark_4 Remark
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} S \in
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              %strong group of formal linear combinations
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mi S
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}[S]
              is the
              %a.existingWikiWord{:href => "/nlab/show/group"} group
              whose underlying
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              is that of formal linear combinations, def.
              = succeed "," do
                %a.maruku-ref{:href => "#FormalLinearCombination"}
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi s
                        %mo ∈
                        %mi S
                    %msub
                      %mi a
                      %mi s
                    %mo ⋅
                    %mi s
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mo{:stretchy => "false"} (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi s
                        %mo ∈
                        %mi S
                    %msub
                      %mi b
                      %mi s
                    %mo ⋅
                    %mi s
                    %mo{:stretchy => "false"} )
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi s
                        %mo ∈
                        %mi S
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mi s
                    %mo +
                    %msub
                      %mi b
                      %mi s
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mi s
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\sum_{s \in S} a_s \cdot s)
                    +
                    (\sum_{s \in S} b_s \cdot s)
                    \=
                    \\sum_{s \in S} (a_s + b_s) \cdot s
                    \\,.
          %p For the present purpose the following statement may be regarded as just introducing different terminology for the group of formal linear combinations:
          #FreeAbelianGroup.num_prop
            %h6#proposition_6 Proposition
            %p
              The group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mi S
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}[S]
              is the
              %strong
                %a.existingWikiWord{:href => "/nlab/show/free+abelian+group"} free abelian group
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
          .num_defn
            %h6#definition_20 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mo •
                  %annotation{:encoding => "application/x-tex"} S_\bullet
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
              = succeed "," do
                %a.maruku-ref{:href => "#SimplicialSet"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi S
                      %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}[S_n]
              is called the group of (simplicial)
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                \-chains
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
          .num_defn
            %h6#definition_21 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              = succeed "-chain" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/singular+simplicial+complex"} singular simplicial complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sing
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Sing X
              is called a
              %strong
                singular
                = succeed "-chain" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          %p
            This construction makes the sets of simplices into abelian groups. But this allows to
            %em formally add
            the different face maps in the simplicial set to one single boundary map:
          #TheAlternatingFaceMapDifferential.num_defn
            %h6#definition_22 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
              %strong alternating face map differential
              in degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              is the linear map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                    %mo :
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi S
                      %mi n
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi S
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\partial : \mathbb{Z}[S_n] \to \mathbb{Z}[S_{n-1}]
            %p
              defined on
              %a.existingWikiWord{:href => "/nlab/show/basis"} basis
              elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo ∈
                    %msub
                      %mi S
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \sigma \in S_n
              to be the alternating sum of the simplicial face maps:
            #eq:AlternatingFaceMapDifferential.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                    %mi σ
                    %mo ≔
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi k
                        %mo =
                        %mn 0
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi k
                    %msub
                      %mi d
                      %mi k
                    %mi σ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\partial \sigma \coloneqq \sum_{k = 0}^n (-1)^k d_k \sigma
                    \\,.
          .num_prop
            %h6#proposition_7 Proposition
            %p
              The simplicial identity, def.
              %a.maruku-ref{:href => "#SimplicialIdentities"}
              part (1), implies that the alternating sum boundary map of def.
              %a.maruku-ref{:href => "#TheAlternatingFaceMapDifferential"}
              squares to 0:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                    %mo ∘
                    %mo ∂
                    %mo =
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\partial \circ \partial = 0
                    \\,.
          .proof
            %h6#proof_4 Proof
            %p
              By linearity, it is sufficient to check this on a basis element
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                      %mo ∈
                      %msub
                        %mi S
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \sigma \in S_n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo ∂
                            %mo ∂
                            %mi σ
                          %mtd
                            %mo =
                            %mo ∂
                            %mrow
                              %mo (
                              %munderover
                                %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                                %mrow
                                  %mi j
                                  %mo =
                                  %mn 0
                                %mi n
                              %mo{:stretchy => "false"} (
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                              %msup
                                %mo{:stretchy => "false"} )
                                %mi j
                              %msub
                                %mi d
                                %mi j
                              %mi σ
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %munderover
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi j
                                %mo =
                                %mn 0
                              %mi n
                            %munderover
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi i
                                %mo =
                                %mn 0
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi i
                                %mo +
                                %mi j
                            %msub
                              %mi d
                              %mi i
                            %msub
                              %mi d
                              %mi j
                            %mi σ
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mn 0
                                %mo ≤
                                %mi i
                                %mo &lt;
                                %mi j
                                %mo ≤
                                %mi n
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi i
                                %mo +
                                %mi j
                            %msub
                              %mi d
                              %mi i
                            %msub
                              %mi d
                              %mi j
                            %mi σ
                            %mo +
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mn 0
                                %mo ≤
                                %mi j
                                %mo ≤
                                %mi i
                                %mo &lt;
                                %mi n
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi i
                                %mo +
                                %mi j
                            %msub
                              %mi d
                              %mi i
                            %msub
                              %mi d
                              %mi j
                            %mi σ
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mn 0
                                %mo ≤
                                %mi i
                                %mo &lt;
                                %mi j
                                %mo ≤
                                %mi n
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi i
                                %mo +
                                %mi j
                            %msub
                              %mi d
                              %mrow
                                %mi j
                                %mo −
                                %mn 1
                            %msub
                              %mi d
                              %mi i
                            %mi σ
                            %mo +
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mn 0
                                %mo ≤
                                %mi j
                                %mo ≤
                                %mi i
                                %mo &lt;
                                %mi n
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi i
                                %mo +
                                %mi j
                            %msub
                              %mi d
                              %mi i
                            %msub
                              %mi d
                              %mi j
                            %mi σ
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mn 0
                                %mo ≤
                                %mi i
                                %mo ≤
                                %mi j
                                %mo &lt;
                                %mi n
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi i
                                %mo +
                                %mi j
                            %msub
                              %mi d
                              %mi j
                            %msub
                              %mi d
                              %mi i
                            %mi σ
                            %mo +
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mn 0
                                %mo ≤
                                %mi j
                                %mo ≤
                                %mi i
                                %mo &lt;
                                %mi n
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi i
                                %mo +
                                %mi j
                            %msub
                              %mi d
                              %mi i
                            %msub
                              %mi d
                              %mi j
                            %mi σ
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\partial \partial \sigma
                    \&amp; =
                    \\partial \left(
                    \\sum_{j = 0}^n (-1)^j d_j \sigma
                    \\right)
                    \\\
                    \&amp; =
                    \\sum_{j=0}^n \sum_{i = 0}^{n-1} (-1)^{i+j} d_i d_j \sigma
                    \\\
                    \&amp; =
                    \\sum_{0 \leq i \lt j \leq n} (-1)^{i+j} d_i d_j \sigma
                    +
                    \\sum_{0 \leq j \leq i \lt n} (-1)^{i + j} d_i d_j \sigma
                    \\\
                    \&amp; =
                    \\sum_{0 \leq i \lt j \leq n} (-1)^{i+j} d_{j-1} d_i \sigma
                    +
                    \\sum_{0 \leq j \leq i \lt n} (-1)^{i + j} d_i d_j \sigma
                    \\\
                    \&amp; =
                    \-
                    \\sum_{0 \leq i \leq j \lt n} (-1)^{i+j} d_{j} d_i \sigma
                    +
                    \\sum_{0 \leq j \leq i \lt n} (-1)^{i + j} d_i d_j \sigma
                    \\\
                    \&amp; = 0
                    \\end{aligned}
                    \\,.
            %p Here
            %ol
              %li
                %p
                  the first equality is
                  = succeed ";" do
                    %a.maruku-eqref{:href => "#eq:AlternatingFaceMapDifferential"} (1)
              %li
                %p
                  the second is
                  %a.maruku-eqref{:href => "#eq:AlternatingFaceMapDifferential"} (1)
                  together with the linearity of
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi d
                        %annotation{:encoding => "application/x-tex"} d
              %li
                %p the third is obtained by decomposing the sum into two summands;
              %li
                %p
                  the fourth finally uses the simplicial identity def.
                  %a.maruku-ref{:href => "#SimplicialIdentities"}
                  (1) in the first summand;
              %li
                %p
                  the fifth relabels the summation index
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi j
                      %annotation{:encoding => "application/x-tex"} j
                  by
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi j
                          %mo +
                          %mn 1
                        %annotation{:encoding => "application/x-tex"} j +1
              %li
                %p the last one observes that the resulting two summands are negatives of each other.
          #BasicExamplesOfChainBoundaries.num_example
            %h6#example_8 Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a topological space. Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi σ
                      %mn 1
                    %mo :
                    %msup
                      %mi Δ
                      %mn 1
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \sigma^1 : \Delta^1 \to X
              be a singular 1-simplex, regarded as a 1-chain
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi σ
                      %mn 1
                    %mo ∈
                    %msub
                      %mi C
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\sigma^1 \in C_1(X)
                    \\,.
            %p
              Then its
              %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                    %mi σ
                    %mo ∈
                    %msub
                      %mi H
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \partial \sigma \in H_0(X)
              is
            .maruku-equation
