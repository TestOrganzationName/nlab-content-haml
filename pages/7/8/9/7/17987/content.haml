                            %mi n
                            %mo −
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} d_i : S_{n} \to S_{n-1}
                  – the
                  = succeed "th" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
