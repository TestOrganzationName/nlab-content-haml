              be a reduced cohomology theory, def.
              = succeed "." do
                %a.maruku-ref{:href => "#ReducedGeneralizedCohomology"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi E
                        %mo •
