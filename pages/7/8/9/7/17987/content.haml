                              %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\Delta^1
                    \\\
                    \\downarrow^{\mathrlap{(id,\delta_0)}} &amp; \searrow^{\mathrlap{f}}
