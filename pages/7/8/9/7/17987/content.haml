              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                th
                %a.existingWikiWord{:href => "/nlab/show/homotopy+group"} homotopy group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_n(X,x)
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              at
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              is the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/group"} group
            %ul
              %li
                %p
                  whose elements are left-homotopy
                  %a.existingWikiWord{:href => "/nlab/show/equivalence+classes"} equivalence classes
                  of maps
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mi n
                        %mo →
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi x
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} S^n \to (X,x)
                  in
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi Top
                            %mrow
                              %mo *
                              %mo{:stretchy => "false"} /
                        %annotation{:encoding => "application/x-tex"} Top^{*/}
              %li
                %p
                  composition is given by gluing at the base point (
                  %a.existingWikiWord{:href => "/nlab/show/wedge+sum"}> wedge sum
                  ) of representatives.
            %p
              The 0th homotopy group is taken to be the set of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
          .num_example
            %h6#example_6 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n = 1
              this reproduces the definition of the fundamental group of def.
              = succeed "." do
                %a.maruku-ref{:href => "#TheFundamentalGroup"}
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            of topological spaces is all controled by the following notion. The
            %a.existingWikiWord{:href => "/nlab/show/abelianization"} abelianization
            of this notion, the notion of
            %em
              %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
            discussed in def.
            %a.maruku-ref{:href => "#QuasiIsos"}
            below is central to homological algebra.
          #WeakHomotopyEquivalence.num_defn
            %h6#definition_13 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi Y
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} X, Y \in
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              two
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f : X \to Y
              between them is called a
              %strong
                %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
              if
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  induces an
                  %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
                  of
                  %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi π
                          %mn 0
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mo{:lspace => "verythinmathspace"} :
                        %msub
                          %mi π
                          %mn 0
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo →
                          %mo ≃
                        %msub
                          %mi π
                          %mn 0
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\pi_0(f) \colon \pi_0(X) \stackrel{\simeq}{\to} \pi_0(Y)
                %p
                  in
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              %li
                %p
                  for all
                  %a.existingWikiWord{:href => "/nlab/show/points"} points
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi X
                      %annotation{:encoding => "application/x-tex"} x \in X
                  and for all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo ≤
                        %mi n
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} (1 \leq n) \in \mathbb{N}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  induces an isomorphism on
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi π
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo ,
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo{:lspace => "verythinmathspace"} :
                        %msub
                          %mi π
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo →
                          %mo ≃
                        %msub
                          %mi π
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo ,
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\pi_n(f,x) \colon \pi_n(X,x) \stackrel{\simeq}{\to} \pi_n(Y,f(x))
                %p
                  in
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/Grp"} Grp
          %p
            What is called
            %em
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            is effectively the study of topological spaces not up to
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            (here:
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
            %a.existingWikiWord{:href => "/nlab/show/chain+complexes"} chain complexes
            not up to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
          #ReflexiveAndTransitiveButNotSymmetric.num_prop
            %h6#proposition_4 Proposition
            %p
              The existence of a weak homotopy equivalence from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              is a
              %a.existingWikiWord{:href => "/nlab/show/reflexive+relation"} reflexive
              and
              %a.existingWikiWord{:href => "/nlab/show/transitive+relation"} transitive relation
              on
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/symmetric+relation"} symmetric relation
          .proof
            %h6#proof_2 Proof
            %p
              Reflexivity and transitivity are trivially checked. A counterexample to symmetry is the weak homotopy equivalence between the stanard
              %a.existingWikiWord{:href => "/nlab/show/circle"} circle
              and the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/pseudocircle"} pseudocircle
          %p
            But we can consider the genuine equivalence relation
            %em generated
            by weak homotopy equivalence:
          .num_defn
            %h6#definition_14 Definition
            %p
              We say two spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              have the same
              %strong
                (weak)
                %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
              if they are equivalent under the
              %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
              %em generated
              by weak homotopy equivalence.
          .num_remark
            %h6#remark_2 Remark
            %p
              Equivalently this means that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              have the same (weak) homotopy type if there exists a
              %a.existingWikiWord{:href => "/nlab/show/zigzag"} zigzag
              of weak homotopy equivalences
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ←
                    %mo →
                    %mo ←
                    %mi …
                    %mo →
                    %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    X \leftarrow \to\leftarrow \dots \to Y
                    \\,.
          %p
            One can understand the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
            of a topological space just in terms of its
            %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
            and how they
            %a.existingWikiWord{:href => "/nlab/show/action"} act
            on each other. (This data is called a
            %a.existingWikiWord{:href => "/nlab/show/Postnikov+tower"} Postnikov tower
            of
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/homotopy+groups+of+spheres"} homotopy groups of spheres
          %h3#SimplicialHomology Simplicial and singular homology
          %p
            This section discusses how the “abelianization” of a topological space by
            %em
              %a.existingWikiWord{:href => "/nlab/show/singular+chains"} singular chains
            gives rise to the notion of
            %em
              %a.existingWikiWord{:href => "/nlab/show/chain+complexes"} chain complexes
            and their
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/homology"} homology
          %p
            Above in def.
            %a.maruku-ref{:href => "#SingularSimplex"}
            we saw that to a
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is associated a sequence of sets
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Sing
                  %mi X
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi n
                  %mo ≔
                  %msub
                    %mi Hom
                    %mi Top
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Δ
                    %mi n
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  (Sing X)_n \coloneqq Hom_{Top}(\Delta^n, X)
          %p
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/singular+simplices"} singular simplices
            = succeed "-simplices" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Δ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \Delta^n
            from def.
            %a.maruku-ref{:href => "#TopologicalSimplex"}
            sit inside each other by the face inclusions of def.
            %a.maruku-ref{:href => "#FaceInclusionInBarycentricCoords"}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi δ
                    %mi k
                  %mo :
                  %msup
                    %mi Δ
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mo →
                  %msup
                    %mi Δ
                    %mi n
                %annotation{:encoding => "application/x-tex"}
                  \\delta_k : \Delta^{n-1} \to \Delta^{n}
          %p
            and project onto each other by the degeneracy maps, def.
            %a.maruku-ref{:href => "#DegeneracyProjectionsInBarycentricCoords"}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi σ
                    %mi k
                  %mo :
                  %msup
                    %mi Δ
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo →
                  %msup
                    %mi Δ
                    %mi n
                %annotation{:encoding => "application/x-tex"}
                  \\sigma_k : \Delta^{n+1} \to \Delta^n
          %p we dually have functions
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi k
                  %mo ≔
                  %msub
                    %mi Hom
                    %mi Top
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi δ
                    %mi k
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi Sing
                  %mi X
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi n
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi Sing
                  %mi X
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                %annotation{:encoding => "application/x-tex"}
                  d_k \coloneqq Hom_{Top}(\delta_k, X) : (Sing X)_n \to (Sing X)_{n-1}
          %p
            that send each singular
            = succeed "-simplex" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-face" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi s
                    %mi k
                  %mo ≔
                  %msub
                    %mi Hom
                    %mi Top
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi σ
