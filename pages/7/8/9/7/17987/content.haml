          #ComplexOfChainsOnASimplicialSet.num_defn
            %h6#definition_23 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
            %ol
              %li
                %p
                  of
                  %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
                  of chains
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi C
                            %mi n
                          %mo{:stretchy => "false"} (
                          %mi S
                          %mo{:stretchy => "false"} )
                          %mo ≔
                          %mi ℤ
                          %mo{:stretchy => "false"} [
                          %msub
                            %mi S
                            %mi n
                          %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"} C_n(S) \coloneqq \mathbb{Z}[S_n]
                  = succeed ";" do
                    %a.maruku-ref{:href => "#FreeAbelianGroup"}
              %li
                %p
                  and boundary homomorphisms
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mo ∂
                            %mi n
                          %mo :
                          %msub
                            %mi C
                            %mrow
                              %mi n
                              %mo +
                              %mn 1
                          %mo{:stretchy => "false"} (
                          %mi S
                          %mo{:stretchy => "false"} )
                          %mo →
                          %msub
                            %mi C
                            %mi n
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \partial_n : C_{n+1}(S) \to C_n(X)
                  %a.maruku-ref{:href => "#TheAlternatingFaceMapDifferential"}
            %p
              (for all
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %strong
                %a.existingWikiWord{:href => "/nlab/show/alternating+face+map+complex"} alternating face map chain complex
              of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mi ⋯
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mo ∂
                          %mn 2
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi S
                      %mn 2
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mo ∂
                          %mn 1
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi S
                      %mn 1
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mo ∂
                          %mn 0
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi S
                      %mn 0
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    C_\bullet(S)
                    \=
                    [
                    \\cdots
                    \\stackrel{\partial_2}{\to}
                    \\mathbb{Z}[S_2]
                    \\stackrel{\partial_1}{\to}
                    \\mathbb{Z}[S_1]
                    \\stackrel{\partial_0}{\to}
                    \\mathbb{Z}[S_0]
                    ]
                    \\,.
            %p
              Specifically for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo =
                    %mi Sing
                    %mi X
                  %annotation{:encoding => "application/x-tex"} S = Sing X
              we call this the
              %strong
                %a.existingWikiWord{:href => "/nlab/show/singular+chain+complex"} singular chain complex
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          %p This motivates the general definition:
          #ChainComplexes.num_defn
            %h6#definition_24 Definition
            %p
              A
              %em
                %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
                of
                %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mo •
                  %annotation{:encoding => "application/x-tex"} C_\bullet
              is a collection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi C
                      %mi n
                    %mo ∈
                    %mi Ab
                    %msub
                      %mo{:stretchy => "false"} }
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \{C_n \in Ab\}_{n}
              of abelian groups together with group homomorphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mo ∂
                      %mi n
                    %mo :
                    %msub
                      %mi C
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo →
                    %msub
                      %mi C
                      %mi n
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{\partial_n : C_{n+1} \to C_n\}
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∂
                      %mo ∘
                      %mo ∂
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \partial \circ \partial = 0
          %p
            We turn to this definition in more detail in the
            = succeed "." do
              %a{:href => "#CategoriesOfChainComplexes"} next section
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi Sing
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C_\bullet(Sing X)
            remembers the
            %a.existingWikiWord{:href => "/nlab/show/abelianization"} abelianized
            %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} fundamental group
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/chain+homology"} chain homology
          .num_defn
            %h6#definition_25 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C_\bullet(S)
              a chain complex as in def.
              = succeed "," do
                %a.maruku-ref{:href => "#ComplexOfChainsOnASimplicialSet"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              we say
            %ul
              %li
                %p
                  an
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                  %a.existingWikiWord{:href => "/nlab/show/chain"} chain
                  of the form
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ∂
                        %mi σ
                        %mo ∈
                        %mi C
                        %mo{:stretchy => "false"} (
                        %mi S
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi n
                      %annotation{:encoding => "application/x-tex"} \partial \sigma \in C(S)_n
                  is an
                  = succeed ";" do
                    %strong
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %mi n
                          %annotation{:encoding => "application/x-tex"} n
                      \-
                      %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/chain"} chain
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi σ
                        %mo ∈
                        %msub
                          %mi C
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi S
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \sigma \in C_n(S)
                  is an
                  %strong
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                    \-
                    %a.existingWikiWord{:href => "/nlab/show/cycle"} cycle
                  if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ∂
                        %mi σ
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} \partial \sigma = 0
                %p (every 0-chain is a 0-cycle).
            %p
              By linearity of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                  %annotation{:encoding => "application/x-tex"} \partial
              the boundaries and cycles form abelian sub-groups of the group of chains, and we write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi B
                      %mi n
                    %mo ≔
                    %mi im
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo ∂
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %msub
                      %mi C
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    B_n \coloneqq im(\partial_n) \subset C_n(S)
            %p
              for the group of
              = succeed "-boundaries," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Z
                      %mi n
                    %mo ≔
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo ∂
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %msub
                      %mi C
                      %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Z_n \coloneqq ker(\partial_n) \subset C_(S)
            %p
              for the group of
              = succeed "-cycles." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
          .num_remark
            %h6#remark_5 Remark
            %p
              This means that a
              %a.existingWikiWord{:href => "/nlab/show/singular+chain"} singular chain
              is a
              %a.existingWikiWord{:href => "/nlab/show/cycle"} cycle
              if the formal linear combination of the oriented
              %a.existingWikiWord{:href => "/nlab/show/boundaries"} boundaries
              of all its constituent
              %a.existingWikiWord{:href => "/nlab/show/singular+simplices"} singular simplices
              sums to 0.
          .num_remark
            %h6#remark_6 Remark
            %p
              More generally, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              any unital
              %a.existingWikiWord{:href => "/nlab/show/ring"} ring
              one can form the degreewise
              %a.existingWikiWord{:href => "/nlab/show/free+module"} free module
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mi Sing
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} R[Sing X]
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %em
                singular homology with coefficients in
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi H
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi R
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} H_n(X,R)
          #SingularHomology.num_defn
            %h6#definition_26 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C_\bullet(S)
              a chain complex as in def.
              %a.maruku-ref{:href => "#ComplexOfChainsOnASimplicialSet"}
              and for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %strong
                degree-
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                %a.existingWikiWord{:href => "/nlab/show/chain+homology"} chain homology
                group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi Ab
                  %annotation{:encoding => "application/x-tex"} H_n(C(S)) \in Ab
              is the
              %a.existingWikiWord{:href => "/nlab/show/quotient+group"} quotient group
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mfrac
                      %mrow
                        %mi ker
                        %mo{:stretchy => "false"} (
                        %msub
                          %mo ∂
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                        %mo{:stretchy => "false"} )
                      %mrow
                        %mi im
                        %mo{:stretchy => "false"} (
                        %msub
                          %mo ∂
                          %mi n
                        %mo{:stretchy => "false"} )
                    %mo =
                    %mfrac
                      %mrow
                        %msub
                          %mi Z
                          %mi n
                      %mrow
                        %msub
                          %mi B
                          %mi n
                  %annotation{:encoding => "application/x-tex"}
                    H_n(C(S)) \coloneqq \frac{ker(\partial_{n-1})}{im(\partial_n)}
                    \=
                    \\frac{Z_n}{B_n}
            %p
              of the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/cycles"} cycles
              by the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/boundaries"} boundaries
              – where for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} n = 0
              we declare that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∂
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ≔
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \partial_{-1} \coloneqq 0
              and hence
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Z
                        %mn 0
                      %mo ≔
                      %msub
                        %mi C
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} Z_0 \coloneqq C_0
            %p
              Specifically, the
              %a.existingWikiWord{:href => "/nlab/show/chain+homology"} chain homology
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi Sing
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C_\bullet(Sing X)
              is called the
              %strong
                %a.existingWikiWord{:href => "/nlab/show/singular+homology"} singular homology
              of the
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          %p
            One usually writes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H_n(X, \mathbb{Z})
            or just
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H_n(X)
            for the singular homology of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            in degree
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          .num_remark
            %h6#remark_7 Remark
            %p
              So
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi H
                        %mn 0
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi C
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi C
                        %mn 0
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mi im
                      %mo{:stretchy => "false"} (
                      %msub
                        %mo ∂
                        %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} H_0(C_\bullet(S)) = C_0(S)/im(\partial_0)
          .num_example
            %h6#example_9 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              we have that the degree-0 singular homology
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    H_0(X) \simeq \mathbb{Z}[\pi_0(X)]
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/free+abelian+group"} free abelian group
              on the set of
              %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          #FundamentalClass.num_example
            %h6#example_10 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected
              %a.existingWikiWord{:href => "/nlab/show/orientation"} orientable
              %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
              of
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi ℤ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H_n(X) \simeq \mathbb{Z}
                    \\,.
            %p
              The precise choice of this
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              is a choice of
              %a.existingWikiWord{:href => "/nlab/show/orientation"} orientation
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ∈
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} 1 \in \mathbb{Z}
              under this identification is called the
              %strong
                %a.existingWikiWord{:href => "/nlab/show/fundamental+class"} fundamental class
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    [X] \in H_n(X)
            %p
              of the manifold
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          #PushforwardOfChains.num_defn
            %h6#definition_27 Definition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/continuous+map"} continuous map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f : X \to Y
              between
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              = succeed "-simplex" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo :
                    %msup
                      %mi Δ
                      %mi n
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \sigma : \Delta^n \to X
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is sent to a singular
              = succeed "-simplex" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo *
                    %mi σ
                    %mo :
                    %msup
                      %mi Δ
                      %mi n
                    %mover
                      %mo →
                      %mi σ
                    %mi X
                    %mover
                      %mo →
                      %mi f
                    %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    f_* \sigma : \Delta^n \stackrel{\sigma}{\to} X \stackrel{f}{\to} Y
            %p
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
              %strong push-forward
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
              along
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mo *
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo :
                    %msub
                      %mi C
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi C
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (f_*)_n : C_n(X) \to C_n(Y)
                    \\,.
          #PushForwardChainMap.num_prop
            %h6#proposition_8 Proposition
            %p These push-forward maps make all diagrams of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi C
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi f
                                  %mo *
                                %msub
                                  %mo{:stretchy => "false"} )
                                  %mrow
                                    %mi n
                                    %mo +
                                    %mn 1
                          %mtd
                            %msub
                              %mi C
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msubsup
                                    %mo ∂
                                    %mi n
                                    %mi X
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msubsup
                                    %mo ∂
                                    %mi n
                                    %mi Y
                        %mtr
                          %mtd
                            %msub
                              %mi C
                              %mi n
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi f
                                  %mo *
                                %msub
                                  %mo{:stretchy => "false"} )
                                  %mi n
                          %mtd
                            %msub
                              %mi C
                              %mi n
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    C_{n+1}(X) &amp;\stackrel{(f_*)_{n+1}}{\to}&amp; C_{n+1}(Y)
                    \\\
                    \\downarrow^{\mathrlap{\partial^X_n}} &amp;&amp; \downarrow^{\mathrlap{\partial^Y_n}}
                    \\\
                    C_n(X) &amp;\stackrel{(f_*)_n}{\to}&amp; C_n(Y)
                    }
            %p commute.
          .proof
            %h6#proof_5 Proof
            %p
              It is in fact evident that push-forward yields a functor of
              %a.existingWikiWord{:href => "/nlab/show/singular+simplicial+complexes"} singular simplicial complexes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo *
                    %mo :
                    %mi Sing
                    %mi X
                    %mo →
                    %mi Sing
                    %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f_* : Sing X \to Sing Y
                    \\,.
            %p
              From this the statement follows since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mo :
                    %mi sSet
                    %mo →
                    %mi sAb
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}[-] : sSet \to sAb
              is a functor.
          %p
            Therefore we have an “abelianized analog” of the notion of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
          .num_defn
            %h6#definition_28 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mo •
                    %mo ,
                    %msub
                      %mi D
                      %mo •
                  %annotation{:encoding => "application/x-tex"} C_\bullet, D_\bullet
              two
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/chain+complexes"} chain complexes
              = succeed "," do
                %a.maruku-ref{:href => "#ChainComplexes"}
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              between them – called a
              %strong
                %a.existingWikiWord{:href => "/nlab/show/chain+map"} chain map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo •
                    %mo :
                    %msub
                      %mi C
                      %mo •
                    %mo →
                    %msub
                      %mi D
                      %mo •
                  %annotation{:encoding => "application/x-tex"} f_\bullet : C_\bullet \to D_\bullet
              – is for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              a homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi n
                    %mo :
                    %msub
                      %mi C
                      %mi n
                    %mo →
                    %msub
                      %mi D
                      %mi n
                  %annotation{:encoding => "application/x-tex"} f_n : C_n \to D_n
              of abelian groups, such that
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mi n
                      %mo ∘
                      %msubsup
                        %mo ∂
                        %mi n
                        %mi C
                      %mo =
                      %msubsup
                        %mo ∂
                        %mi n
                        %mi D
                      %mo ∘
                      %msub
                        %mi f
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} f_n \circ \partial^C_n = \partial^D_n \circ f_{n+1}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ⋮
                          %mtd
                          %mtd
                            %mi ⋮
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msubsup
                                    %mo ∂
                                    %mrow
                                      %mi n
                                      %mo +
                                      %mn 1
                                    %mi C
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msubsup
                                    %mo ∂
                                    %mrow
                                      %mi n
                                      %mo +
                                      %mn 1
                                    %mi D
                        %mtr
                          %mtd
                            %msub
                              %mi C
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi f
                                  %mrow
                                    %mi n
                                    %mo +
                                    %mn 1
                          %mtd
                            %msub
                              %mi D
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msubsup
                                    %mo ∂
                                    %mi n
                                    %mi C
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msubsup
                                    %mo ∂
                                    %mi n
                                    %mi D
                        %mtr
                          %mtd
                            %msub
                              %mi C
                              %mi n
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi f
                                  %mi n
                          %mtd
                            %msub
                              %mi D
                              %mi n
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msubsup
                                    %mo ∂
                                    %mrow
                                      %mi n
                                      %mo −
                                      %mn 1
                                    %mi C
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msubsup
                                    %mo ∂
                                    %mrow
                                      %mi n
                                      %mo −
                                      %mn 1
                                    %mi D
                        %mtr
                          %mtd
                            %mi ⋮
                          %mtd
                          %mtd
                            %mi ⋮
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\vdots &amp;&amp; \vdots
                    \\\
                    \\downarrow^{\mathrlap{\partial^C_{n+1}}}
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{\partial^D_{n+1}}}
                    \\\
                    C_{n+1} &amp;\stackrel{f_{n+1}}{\to}&amp; D_{n+1}
                    \\\
                    \\downarrow^{\mathrlap{\partial^C_n}}
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{\partial^D_n}}
                    \\\
                    C_{n} &amp;\stackrel{f_{n}}{\to}&amp; D_{n}
                    \\\
                    \\downarrow^{\mathrlap{\partial^C_{n-1}}}
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{\partial^D_{n-1}}}
                    \\\
                    \\vdots &amp;&amp; \vdots
                    }
                    \\,.
          %p
            Composition of such chain maps is given by degreewise composition of their components. Clearly, chain complexes with chain maps between them hence form a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            – the
            %em
              %a.existingWikiWord{:href => "/nlab/show/category+of+chain+complexes"} category of chain complexes
            in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Ch
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi Ab
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi Cat
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Ch_\bullet(Ab))
                  \\in
                  Cat
                  \\,.
          %p Accordingly we have:
          #SingularHomologyAsAFunctor.num_prop
            %h6#proposition_9 Proposition
            %p
              Sending a topological space to its singular chain complex
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi C
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C_\bullet(X)
              = succeed "," do
                %a.maruku-ref{:href => "#ComplexOfChainsOnASimplicialSet"}
              = succeed "," do
                %a.maruku-ref{:href => "#PushForwardChainMap"}
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi Top
                    %mo →
                    %msub
                      %mi Ch
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi Ab
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    C_\bullet(-) : Top \to Ch_\bullet(Ab)
            %p
              from the category
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              of topological spaces and continuous maps, to the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/category+of+chain+complexes"} category of chain complexes
            %p
              In particular for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              singular homology extends to a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi Top
                    %mo →
                    %mi Ab
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H_n(-) : Top \to Ab
                    \\,.
          %p
            We close this section by stating the basic properties of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/singular+homology"} singular homology
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+topology"} algebraic topology
          .num_prop
            %h6#proposition_10 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f : X \to Y
              is a
              %a.existingWikiWord{:href => "/nlab/show/continuous+map"} continuous map
              between
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              which is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
              = succeed "," do
                %a.maruku-ref{:href => "#WeakHomotopyEquivalence"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    H_n(f) : H_n(X) \to H_n(Y)
            %p
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
          %p
            (A proof (via
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/CW+approximations"} CW approximations
            = succeed "))." do
              %a{:href => "#Hatcher"} Hatcher, prop. 4.21
          %p We therefore also have an “abelian analog” of weak homotopy equivalences:
          .num_defn
            %h6#definition_29 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mo •
                    %mo ,
                    %msub
                      %mi D
                      %mo •
                  %annotation{:encoding => "application/x-tex"} C_\bullet, D_\bullet
              two
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/chain+complexes"} chain complexes
              %a.existingWikiWord{:href => "/nlab/show/chain+map"} chain map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo •
                    %mo :
                    %msub
                      %mi C
                      %mo •
                    %mo →
                    %msub
                      %mi D
                      %mo •
                  %annotation{:encoding => "application/x-tex"} f_\bullet : C_\bullet \to D_\bullet
              is called a
              %strong
                %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
              if it induces
              %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
              on all
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/homology+groups"} homology groups
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi n
                    %mo :
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≃
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi D
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f_n : H_n(C) \stackrel{\simeq}{\to} H_n(D)
                    \\,.
          %p
            In summary:
            = succeed "." do
              %strong
                chain homology sends
                %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalences"} weak homotopy equivalences
                to
                %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphisms"} quasi-isomorphisms
          %p
            In particular we have the analog of prop.
            = succeed ":" do
              %a.maruku-ref{:href => "#ReflexiveAndTransitiveButNotSymmetric"}
          #ReflexiveAndTransitiveButNotSymmetric.num_prop
            %h6#proposition_11 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/relation"} relation
              “There exists a
              %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mo •
                  %annotation{:encoding => "application/x-tex"} C_\bullet
              to
              = succeed ".\u201D" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi D
                        %mo •
                    %annotation{:encoding => "application/x-tex"} D_\bullet
              %a.existingWikiWord{:href => "/nlab/show/reflexive+relation"} reflexive
              and
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/transitive+relation"} transitive relation
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/symmetric+relation"} symmetric relation
          .proof
            %h6#proof_6 Proof
            %p
              Reflexivity and transitivity are evident. An explicit counter-example showing the non-symmetry is the
              %a.existingWikiWord{:href => "/nlab/show/chain+map"} chain map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ⋯
                          %mtd
                            %mo →
                          %mtd
                            %mn 0
                          %mtd
                            %mo →
                          %mtd
                            %mi ℤ
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mo ⋅
                                %mn 2
                          %mtd
                            %mi ℤ
                          %mtd
                            %mo →
                          %mtd
                            %mn 0
                          %mtd
                            %mo →
                          %mtd
                            %mi ⋯
                        %mtr
                          %mtd
                            %mi ⋯
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mi ⋯
                        %mtr
                          %mtd
                            %mi ⋯
                          %mtd
                            %mo →
                          %mtd
                            %mn 0
                          %mtd
                            %mo →
                          %mtd
                            %mn 0
                          %mtd
                            %mo →
                          %mtd
                            %mi ℤ
                            %mo{:stretchy => "false"} /
                            %mn 2
                            %mi ℤ
                          %mtd
                            %mo →
                          %mtd
                            %mn 0
                          %mtd
                            %mo →
                          %mtd
                            %mi ⋯
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\cdots &amp;\to&amp; 0 &amp;\to&amp; \mathbb{Z} &amp;\stackrel{\cdot 2}{\to}&amp; \mathbb{Z} &amp;\to&amp; 0 &amp;\to&amp; \cdots
                    \\\
                    \\cdots &amp;&amp; \downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow &amp;&amp; \cdots
                    \\\
                    \\cdots &amp;\to&amp; 0 &amp;\to&amp; 0 &amp;\to&amp; \mathbb{Z}/2\mathbb{Z} &amp;\to&amp; 0 &amp;\to&amp; \cdots
                    }
            %p
              from the chain complex concentrated on the morphism of multiplication by 2 on integers, to the chain complex concentrated on the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cyclic+group+of+order+2"} cyclic group of order 2
            %p
              This clearly induces an isomorphism on all homology groups. But there is not even a non-zero chain map in the other direction, since there is no non-zero group homomorphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mn 2
                      %mi ℤ
                      %mo →
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2\mathbb{Z} \to \mathbb{Z}
          %p
            Accordingly, as for
            %a.existingWikiWord{:href => "/nlab/show/homotopy+types"} homotopy types
            of topological spaces, in
            %a.existingWikiWord{:href => "/nlab/show/homological+algebra"} homological algebra
            one regards two
            %a.existingWikiWord{:href => "/nlab/show/chain+complexes"} chain complexes
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mo •
                  %annotation{:encoding => "application/x-tex"} C_\bullet
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi D
                    %mo •
                %annotation{:encoding => "application/x-tex"} D_\bullet
            as essentially equivalent – “of the same weak homology type” – if there is a
            %a.existingWikiWord{:href => "/nlab/show/zigzag"} zigzag
            of quasi-isomorphisms
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mo •
                  %mo ←
                  %mo →
                  %mo ←
                  %mi ⋯
                  %mo →
                  %msub
                    %mi D
                    %mo •
                %annotation{:encoding => "application/x-tex"}
                  C_\bullet \leftarrow \to \leftarrow \cdots \to D_\bullet
          %p
            between them. This is made precise by the central notion of the
            %em
              %a.existingWikiWord{:href => "/nlab/show/derived+category"} derived category
            of chain complexes. We turn to this below in section
            = succeed "." do
              %em
                %a{:href => "#DerivedCategoriesAndDerivedFunctors"} Derived categories and derived functors
          %p
            But quasi-isomorphisms are a little
            %em coarser
            than weak homotopy equivalences. The singular chain functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C_\bullet(-)
            forgets some of the information in the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+types"} homotopy types
            of topological spaces. The following series of statements characterizes to some extent what exactly is lost when passing to singular homology, and which information is in fact retained.
          %p First we need a comparison map:
          #HurewiczHomomorphism.num_defn
            %h6#definition_30 Definition
            %p
              %strong (Hurewicz homomorphism)
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,x)
              a
              %a.existingWikiWord{:href => "/nlab/show/pointed+object"} pointed
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %strong Hurewicz homomorphism
              is the
              %a.existingWikiWord{:href => "/nlab/show/function"} function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                    %mo :
                    %msub
                      %mi π
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Phi : \pi_k(X,x) \to H_k(X)
            %p
              from the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %a.existingWikiWord{:href => "/nlab/show/homotopy+group"} homotopy group
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,x)
              to the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %a.existingWikiWord{:href => "/nlab/show/singular+homology"} singular homology
              group defined by sending
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo :
                    %msup
                      %mi S
                      %mi k
                    %mo →
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo ∼
                    %mo ↦
                    %msub
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi S
                      %mi k
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\Phi : (f : S^k \to X)_{\sim} \mapsto f_*[S_k]
            %p
              a representative singular
              = succeed "-sphere" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              to the push-forward along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              of the
              %a.existingWikiWord{:href => "/nlab/show/fundamental+class"} fundamental class
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi S
                        %mi k
                      %mo{:stretchy => "false"} ]
                      %mo ∈
                      %msub
                        %mi H
                        %mi k
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi S
                        %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} [S_k] \in H_k(S^k)
              = succeed "." do
                %a.maruku-ref{:href => "#FundamentalClass"}
          .num_prop
            %h6#proposition_12 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              the Hurewicz homomorphism in degree 0 exhibits an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              between the
              %a.existingWikiWord{:href => "/nlab/show/free+abelian+group"} free abelian group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}[\pi_0(X)]
              on the set of path
              %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and the degree-0 singular homlogy:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                    %mo ≃
                    %msub
                      %mi H
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{Z}[\pi_0(X)]
                    \\simeq
                    H_0(X)
                    \\,.
          %p
            Since a
            %a.existingWikiWord{:href => "/nlab/show/homotopy+group"} homotopy group
            in positive degree depends on the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
            of the
            %a.existingWikiWord{:href => "/nlab/show/connected+component"} connected component
            of the base point, while the singular homology does not depend on a basepoint, it is interesting to compare these groups only for the case that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is connected.
          .num_prop
            %h6#proposition_13 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              %a.existingWikiWord{:href => "/nlab/show/path-connected+topological+space"} path-connected topological space
              the
              %a.existingWikiWord{:href => "/nlab/show/Hurewicz+homomorphism"} Hurewicz homomorphism
              in degree 1
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                    %mo :
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Phi : \pi_1(X,x) \to H_1(X)
            %p
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/surjection"} surjective
              %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
              is the
              %a.existingWikiWord{:href => "/nlab/show/commutator+subgroup"} commutator subgroup
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi_1(X,x)
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              from the
              %a.existingWikiWord{:href => "/nlab/show/abelianization"} abelianization
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi x
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi ab
                      %mo ≔
                      %msub
                        %mi π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi π
                        %mn 1
                      %mo ,
                      %msub
                        %mi π
                        %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \pi_1(X,x)^{ab} \coloneqq \pi_1(X,x)/[\pi_1,\pi_1]
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi ab
                    %mover
                      %mo →
                      %mo ≃
                    %msub
                      %mi H
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_1(X,x)^{ab}
                    \\stackrel{\simeq}{\to}
                    H_1(X)
                    \\,.
          %p
            For higher connected
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            we have the
          .num_theorem
            %h6#theorem Theorem
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
              %a.existingWikiWord{:href => "/nlab/show/n-connected+object+in+an+%28infinity%2C1%29-topos"} (n-1)-connected
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} n \geq 2
              then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                    %mo :
                    %msub
                      %mi π
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Phi : \pi_n(X,x) \to H_n(X)
            %p
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
          %p
            This is known as the
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Hurewicz+theorem"} Hurewicz theorem
          %h3#references References
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Allen+Hatcher"}> Allen Hatcher
              , section 2.1 of
              %em
                %a{:href => "https://www.math.cornell.edu/~hatcher/AT/ATpage.html"} Algebraic topology
          %h2#vector_bundles
            %strong Vector bundles
          %h3#idea_3 Idea
          %p
            For understanding some
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            may be “continuously distributed over”
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{-1, 1\}
            may be continuously distributed over the
            %a.existingWikiWord{:href => "/nlab/show/circle"} circle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mn 1
                %annotation{:encoding => "application/x-tex"} S^1
            in two inequivalent ways: Either the two points come back to themselves as we move around the circle, or they switch position. This switch is a reflection of the fact that in the circle there are non-contractible loops, in constrast for instance to the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/2-sphere"} 2-sphere
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{-1,1\}
            into the
            %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
            and repeat the construction, then as the line traces around the circle it sweeps out one of two different topological spaces over the circle: either the
            %a.existingWikiWord{:href => "/nlab/show/cylinder"} cylinder
            (if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %mn 1
                %annotation{:encoding => "application/x-tex"} +1
            comes back to itself) or the
            %em
              %a.existingWikiWord{:href => "/nlab/show/M%C3%B6bius+strip"} Möbius strip
            (if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %mn 1
                %annotation{:encoding => "application/x-tex"} +1
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                %annotation{:encoding => "application/x-tex"} -1
            change position as one goes around the circle).
          %p
            The image of this situation looks like a “
            %a.existingWikiWord{:href => "/nlab/show/bundle"}> bundle
            ” of “
            %a.existingWikiWord{:href => "/nlab/show/fibers"}> fibers
            ” over the circle. Generally, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %em
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              \-
              %a.existingWikiWord{:href => "/nlab/show/fiber+bundle"} fiber bundle
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is another space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            with a
            %a.existingWikiWord{:href => "/nlab/show/projection"} projection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo{:lspace => "verythinmathspace"} :
                  %mi E
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} p \colon E \to X
            that shrinks the fibers away, which all look like
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            in a controlled way.
          %p
            For the purpose of
            %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"} topological K-theory
            we are interested in
            %a.existingWikiWord{:href => "/nlab/show/fibers"} fibers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            which are
            %a.existingWikiWord{:href => "/nlab/show/vector+spaces"} vector spaces
            and such that their re-identification as we move around in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is by
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/linear+maps"} linear maps
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/vector+bundles"} vector bundles
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/linear+algebra"} linear algebra
          %h3#fiber_bundles Fiber bundles
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/fiber+bundle"} fiber bundle
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/covering+space"} covering space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/associated+bundle"} associated bundle
          %h3#the_tensor_category_of_vector_bundles The tensor category of vector bundles
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/tensor+category"} tensor category
          %p
            %a.existingWikiWord{:href => "/nlab/show/category+of+vector+bundles"} category of vector bundles
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/direct+sum+of+vector+bundles"} direct sum of vector bundles
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+vector+bundles"} tensor product of vector bundles
            %li
              %p
