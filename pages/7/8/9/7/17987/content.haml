                %annotation{:encoding => "application/x-tex"} Top_{CW}^{\hookrightarrow}
            for the category of such pairs (the
            %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
            of the
            %a.existingWikiWord{:href => "/nlab/show/arrow+category"} arrow category
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Top
                    %mi CW
                %annotation{:encoding => "application/x-tex"} Top_{CW}
            on the inclusions). We identify
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Top
                    %mi CW
                  %mo ↪
                  %msubsup
                    %mi Top
                    %mi CW
                    %mo ↪
                %annotation{:encoding => "application/x-tex"} Top_{CW} \hookrightarrow Top_{CW}^{\hookrightarrow}
            by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ∅
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \mapsto (X,\emptyset)
          #GeneralizedCohomologyTheory.num_defn
            %h6#definition_39 Definition
            %p
              A
              %em
                %a.existingWikiWord{:href => "/nlab/show/cohomology+theory"} cohomology theory
              (unreduced,
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/relative+cohomology"} relative
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mo •
                    %mo :
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Top
                      %mi CW
                      %mo ↪
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo →
                    %msup
                      %mi Ab
                      %mi ℤ
                  %annotation{:encoding => "application/x-tex"}
                    E^\bullet : (Top_{CW}^{\hookrightarrow})^{op} \to Ab^{\mathbb{Z}}
            %p
              to the category of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/graded+abelian+groups"} graded abelian groups
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
              of degree +1, to be called the
              = succeed "," do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/connecting+homomorphism"} connecting homomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi A
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi ∅
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi E
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\delta_{(X,A)}
                    \\;\colon\;
                    E^\bullet(A, \emptyset) \to E^{\bullet + 1}(X, A)
                    \\,.
            %p such that:
            %ol
              %li
                %p
                  %strong (homotopy invariance)
                  For
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo{:lspace => "verythinmathspace"} :
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi X
                          %mn 1
                        %mo ,
                        %msub
                          %mi A
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi X
                          %mn 2
                        %mo ,
                        %msub
                          %mi A
                          %mn 2
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} f \colon (X_1,A_1) \to (X_2,A_2)
                  a
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
                  of pairs, then
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi E
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %msup
                          %mi E
                          %mo •
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi X
                          %mn 2
                        %mo ,
                        %msub
                          %mi A
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo ⟶
                          %mo ≃
                        %msup
                          %mi E
                          %mo •
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi X
                          %mn 1
                        %mo ,
                        %msub
                          %mi A
                          %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        E^\bullet(f)
                        \\;\colon\;
                        E^\bullet(X_2,A_2) \stackrel{\simeq}{\longrightarrow} E^\bullet(X_1,A_1)
                %p
                  is an
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              %li#ExactnessUnreduced
                %p
                  %strong (exactness)
                  For
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ↪
                        %mi X
                      %annotation{:encoding => "application/x-tex"} A \hookrightarrow X
                  the induced sequence
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ⋯
                        %mo →
                        %msup
                          %mi E
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi A
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %msup
                          %mi E
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %msup
                          %mi E
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo ⟶
                          %mi δ
                        %msup
                          %mi E
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi A
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi ⋯
                      %annotation{:encoding => "application/x-tex"}
                        \\cdots
                        \\to
                        E^n(X, A)
                        \\longrightarrow
                        E^n(X)
                        \\longrightarrow
                        E^n(A)
                        \\stackrel{\delta}{\longrightarrow}
                        E^{n+1}(X, A)
                        \\to
                        \\cdots
                %p
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence"} long exact sequence
                  of
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
              %li#excision
                %p
                  %strong
                    (
                    %a.existingWikiWord{:href => "/nlab/show/excision"}> excision
                    )
                  For
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo ↪
                        %mi A
                        %mo ↪
                        %mi X
                      %annotation{:encoding => "application/x-tex"} U \hookrightarrow A \hookrightarrow X
                  such that
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mover
                            %mi U
                            %mo ¯
                          %mo ⊂
                          %mi Int
                          %mo{:stretchy => "false"} (
                          %mi A
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \overline{U} \subset Int(A)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                        %mo{:lspace => "verythinmathspace"} :
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo −
                        %mi U
                        %mo ,
                        %mi A
                        %mo −
                        %mi U
                        %mo{:stretchy => "false"} )
                        %mo ↪
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi A
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} i \colon (X-U, A-U) \hookrightarrow (X, A)
                  induces an isomorphism
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi E
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %msup
                          %mi E
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi A
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo ⟶
                          %mo ≃
                        %msup
                          %mi E
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo −
                        %mi U
                        %mo ,
                        %mi A
                        %mo −
                        %mi U
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        E^\bullet(i)
                        \\;\colon\;
                        E^n(X, A)
                        \\overset{\simeq}{\longrightarrow}
                        E^n(X-U, A-U)
            %p
              We say
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mo •
                  %annotation{:encoding => "application/x-tex"} E^\bullet
              is
              %strong additive
              if it takes
              %a.existingWikiWord{:href => "/nlab/show/coproducts"} coproducts
              to
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/products"} products
            %ul
              %li
                %p
                  %strong (additivity)
                  If
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi A
                        %mo{:stretchy => "false"} )
                        %mo =
                        %msub
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                          %mi i
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi X
                          %mi i
                        %mo ,
                        %msub
                          %mi A
                          %mi i
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (X, A) = \coprod_i (X_i, A_i)
                  is a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi E
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi A
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo ⟶
                          %mo ≃
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                          %mi i
                        %msup
                          %mi E
                          %mi n
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi X
                          %mi i
                        %mo ,
                        %msub
                          %mi A
                          %mi i
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        E^n(X, A) \overset{\simeq}{\longrightarrow} \prod_i E^n(X_i, A_i)
                %p
                  is an
                  %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
                  from the value on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi A
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (X,A)
                  to the
                  %a.existingWikiWord{:href => "/nlab/show/product"} product
                  of values on the summands.
            %p
              We say
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mo •
                  %annotation{:encoding => "application/x-tex"} E^\bullet
              is
              %strong ordinary
              if its value on the point is concentrated in degree 0
            %ul
              %li
                %strong> (Dimension)
                \:
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi E
                          %mrow
                            %mo •
                            %mo ≠
                            %mn 0
                        %mo{:stretchy => "false"} (
                        %mo *
                        %mo ,
                        %mi ∅
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} E^{\bullet \neq 0}(\ast,\emptyset) = 0
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of unreduced cohomology theories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi E
                      %mo •
                    %mo ⟶
                    %msup
                      %mi F
                      %mo •
                  %annotation{:encoding => "application/x-tex"}
                    \\eta \;\colon\; E^\bullet \longrightarrow F^\bullet
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
              of the underlying functors that is compatible with the connecting homomorphisms, hence such that all these
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/commuting+square"} squares commute
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi E
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo ,
                            %mi ∅
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi η
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %mi A
                                    %mo ,
                                    %mi ∅
                                    %mo{:stretchy => "false"} )
                          %mtd
                            %msup
                              %mi F
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo ,
                            %mi ∅
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi δ
                                    %mi E
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi δ
                                    %mi F
                        %mtr
                          %mtd
                            %msup
                              %mi E
                              %mrow
                                %mo •
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi η
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %mi X
                                    %mo ,
                                    %mi A
                                    %mo{:stretchy => "false"} )
                          %mtd
                            %msup
                              %mi F
                              %mrow
                                %mo •
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    E^\bullet(A,\emptyset) &amp;\overset{\eta_{(A,\emptyset)}}{\longrightarrow}&amp; F^\bullet(A,\emptyset)
                    \\\
                    {}^{\mathllap{\delta_E}}\downarrow &amp;&amp; \downarrow^{\mathrlap{\delta_F}}
                    \\\
                    E^{\bullet +1}(X,A)
                    \&amp;\overset{\eta_{(X,A)}}{\longrightarrow}&amp;
                    F^{\bullet +1}(X,A)
                    }
                    \\,.
          %p
            e.g. (
            %a{:href => "#AguilarGitlerPrieto02"}> AGP 02, def. 12.1.1
            ).
          #AlternativeFormulationOfExcisionAxiom.num_defn
            %h6#lemma Lemma
            %p
              The excision axiom in def.
              %a.maruku-ref{:href => "#GeneralizedCohomologyTheory"}
              is equivalent to the following statement:
            %p
              For all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ,
                    %mi B
                    %mo ↪
                    %mi X
                  %annotation{:encoding => "application/x-tex"} A,B \hookrightarrow X
              with
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo =
                      %mi Int
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo ∪
                      %mi Int
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} X = Int(A) \cup Int(B)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi A
                    %mo ∩
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    i \colon (A, A \cap B) \longrightarrow (X,B)
            %p induces an isomorphism,
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi i
                      %mo *
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi A
                    %mo ∩
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    i^\ast
                    \\;\colon\;
                    E^\bullet(X, B)
                    \\overset{\simeq}{\longrightarrow}
                    E^\bullet(A, A \cap B)
          %p
            (e.g
            = succeed ")" do
              %a{:href => "#Switzer75"} Switzer 75, 7.2
          .proof
            %h6#proof_13 Proof
            %p
              In one direction, suppose that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mo •
                  %annotation{:encoding => "application/x-tex"} E^\bullet
              satisfies the original excision axiom. Given
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ,
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A,B
              with
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo =
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} Int
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo ∪
                      %mi Int
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} X = \Int(A) \cup Int(B)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ≔
                    %mi X
                    %mo −
                    %mi A
                  %annotation{:encoding => "application/x-tex"} U \coloneqq X-A
              and observe that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mover
                              %mi U
                              %mo ¯
                          %mtd
                            %mo =
                            %mover
                              %mrow
                                %mi X
                                %mo −
                                %mi A
                              %mo ¯
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi X
                            %mo −
                            %mi Int
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ⊂
                            %mi Int
                            %mo{:stretchy => "false"} (
                            %mi B
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\overline{U}
                    \&amp; = \overline{X-A}
                    \\\ &amp; = X- Int(A)
                    \\\ &amp; \subset Int(B)
                    \\end{aligned}
            %p and that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo −
                    %mi U
                    %mo ,
                    %mi B
                    %mo −
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi A
                    %mo ∩
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (X-U, B-U) = (A, A \cap B)
                    \\,.
            %p
              Hence the excision axiom implies
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi E
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi B
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo ⟶
                        %mo ≃
                      %msup
                        %mi E
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mi A
                      %mo ∩
                      %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} E^\bullet(X, B) \overset{\simeq}{\longrightarrow} E^\bullet(A, A \cap B)
            %p
              Conversely, suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mo •
                  %annotation{:encoding => "application/x-tex"} E^\bullet
              satisfies the alternative condition. Given
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ↪
                    %mi A
                    %mo ↪
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U \hookrightarrow A \hookrightarrow X
              with
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi U
                        %mo ¯
                      %mo ⊂
                      %mi Int
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \overline{U} \subset Int(A)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi Int
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo −
                            %mi U
                            %mo{:stretchy => "false"} )
                            %mo ∪
                            %mi Int
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo −
                            %mover
                              %mi U
                              %mo ¯
                            %mo{:stretchy => "false"} )
                            %mo ∩
                            %mo{:lspace => "0em", :rspace => "thinmathspace"} Int
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ⊃
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo −
                            %mi Int
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo ∩
                            %mi Int
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    Int(X-U) \cup Int(A)
                    \&amp; = (X - \overline{U}) \cap \Int(A)
                    \\\ &amp; \supset (X - Int(A)) \cap Int(A)
                    \\\ &amp; = X
                    \\end{aligned}
            %p and that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo −
                    %mi U
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo −
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo ∩
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo −
                    %mi U
                    %mo ,
                    %mi A
                    %mo −
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (X-U, (X-U) \cap A) = (X-U, A - U)
                    \\,.
            %p Hence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo −
                    %mi U
                    %mo ,
                    %mi A
                    %mo −
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo −
                    %mi U
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo −
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo ∩
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E^\bullet(X-U,A-U)
                    \\simeq
                    E^\bullet(X-U, (X-U)\cap A)
                    \\simeq
                    E^\bullet(X,A)
                    \\,.
          %p
            The following lemma shows that the dependence in pairs of spaces in a generalized cohomology theory is really a stand-in for evaluation on
            %a.existingWikiWord{:href => "/nlab/show/homotopy+cofibers"} homotopy cofibers
            of inclusions.
          #EvaluationOfCohomologyTheoryOnGoodPairIsEvaluationOnQuotient.num_lemma
            %h6#lemma_2 Lemma
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mo •
                  %annotation{:encoding => "application/x-tex"} E^\bullet
              be an cohomology theory, def.
              = succeed "," do
                %a.maruku-ref{:href => "#GeneralizedCohomologyTheory"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ↪
                      %mi X
                    %annotation{:encoding => "application/x-tex"} A \hookrightarrow X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ∪
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    E^\bullet(X,A)
                    \\stackrel{\simeq}{\longrightarrow}
                    E^\bullet(X \cup Cone(A), \ast)
            %p
              between the value of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mo •
                  %annotation{:encoding => "application/x-tex"} E^\bullet
              on the pair
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,A)
              and its value on the
              %a.existingWikiWord{:href => "/nlab/show/mapping+cone"} mapping cone
              of the inclusion, relative to a basepoint.
            %p
              If moreover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ↪
                    %mi X
                  %annotation{:encoding => "application/x-tex"} A \hookrightarrow X
              is (the
              %a.existingWikiWord{:href => "/nlab/show/retract"} retract
              of) a
              %a.existingWikiWord{:href => "/nlab/show/relative+cell+complex"} relative cell complex
              inclusion, then also the morphism in cohomology induced from the
              %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
              map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi A
                    %mo ,
                    %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p \;\colon\; (X,A)\longrightarrow (X/A, \ast)
              is an
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi A
                    %mo ,
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E^\bullet(p)
                    \\;\colon\;
                    E^\bullet(X/A,\ast)
                    \\longrightarrow
                    E^\bullet(X,A)
                    \\,.
          %p
            (e.g
            = succeed ")" do
              %a{:href => "#AguilarGitlerPrieto02"} AGP 02, corollary 12.1.10
          .proof
            %h6#proof_14 Proof
            %p
              Consider
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ≔
                      %mo{:stretchy => "false"} (
                      %mi Cone
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo −
                      %mi A
                      %mo ×
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                      %mo ↪
                      %mi Cone
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U \coloneqq (Cone(A)-A \times \{0\}) \hookrightarrow Cone(A)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              minus the base
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ∪
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mi U
                    %mo ,
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    ( X\cup Cone(A)-U, Cone(A)-U) \simeq (X,A)
            %p and hence the first isomorphism in the statement is given by the excision axiom followed by homotopy invariance (along the contraction of the cone to the point).
            %p
              Next consider the quotient of the
              %a.existingWikiWord{:href => "/nlab/show/mapping+cone"} mapping cone
              of the inclusion:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ∪
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi A
                    %mo ,
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    ( X\cup Cone(A), Cone(A) ) \longrightarrow (X/A,\ast)
                    \\,.
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ↪
                    %mi X
                  %annotation{:encoding => "application/x-tex"} A \hookrightarrow X
              is a cofibration, then this is a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
              since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cone(A)
              is contractible and since by the dual
              %a.existingWikiWord{:href => "/nlab/show/factorization+lemma"} factorization lemma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∪
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi A
                  %annotation{:encoding => "application/x-tex"} X \cup Cone(A)\to X/A
              is a weak homotopy equivalence, hence a homotopy equivalence on CW-complexes.
            %p Hence now we get a composite isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi A
                    %mo ,
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ∪
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E^\bullet(X/A,\ast)
                    \\overset{\simeq}{\longrightarrow}
                    E^\bullet( X\cup Cone(A), Cone(A) )
                    \\overset{\simeq}{\longrightarrow}
                    E^\bullet(X,A)
                    \\,.
          #GeneralizedCohomologyOnHomotopyQuotientMaps.num_example
            %h6#example_13 Example
            %p
              As an important special case of : Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,x)
              be a
              %a.existingWikiWord{:href => "/nlab/show/pointed+topological+space"} pointed
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mi X
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p\colon (Cone(X), X) \to (\Sigma X,\{x\})
              the quotient map from the reduced cone on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              to the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/reduced+suspension"} reduced suspension
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mi X
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    E^\bullet(p)
                    \\;\colon\;
                    E^\bullet(Cone(X),X)
                    \\overset{\simeq}{\longrightarrow}
                    E^\bullet(\Sigma X, \{x\})
            %p is an isomorphism.
          #ExactSequenceOfATriple.num_prop
            %h6#proposition_23 Proposition
            %p
              %strong (exact sequence of a triple)
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mo •
                  %annotation{:encoding => "application/x-tex"} E^\bullet
              an unreduced generalized cohomology theory, def.
              = succeed "," do
                %a.maruku-ref{:href => "#GeneralizedCohomologyTheory"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Z
                    %mo ↪
                    %mi Y
                    %mo ↪
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    Z \hookrightarrow Y \hookrightarrow X
            %p
              induces a
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence"} long exact sequence
              of cohomology groups of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo →
                    %msup
                      %mi E
                      %mrow
                        %mi q
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi Z
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mover
                        %mi δ
                        %mo{:stretchy => "false"} ¯
                    %msup
                      %mi E
                      %mi q
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                    %msup
                      %mi E
                      %mi q
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Z
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                    %msup
                      %mi E
                      %mi q
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi Z
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ⋯
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots
                    \\to
                    E^{q-1}(Y,Z)
                    \\stackrel{\bar \delta}{\longrightarrow}
                    E^q(X,Y)
                    \\stackrel{}{\longrightarrow}
                    E^q(X,Z)
                    \\stackrel{}{\longrightarrow}
                    E^q(Y,Z)
                    \\to
                    \\cdots
            %p where
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi δ
                      %mo{:stretchy => "false"} ¯
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi E
                      %mrow
                        %mi q
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi Z
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mi E
                      %mrow
                        %mi q
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mi δ
                    %msup
                      %mi E
                      %mi q
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\bar \delta
                    \\;\colon \;
                    E^{q-1}(Y,Z)
                    \\longrightarrow
                    E^{q-1}(Y)
                    \\stackrel{\delta}{\longrightarrow}
                    E^{q}(X,Y)
                    \\,.
          .proof
            %h6#proof_15 Proof
            %p
              Apply the
              %a.existingWikiWord{:href => "/nlab/show/braid+lemma"} braid lemma
              to the interlocking long exact sequences of the three pairs
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,Y)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi Z
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,Z)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo ,
                      %mi Z
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (Y,Z)
              %a{:href => "braid+lemma#ExactSequenceForTripleInGeneralizedHomology"} here
              for details.
            %p
              The dual braid diagram for
              %a.existingWikiWord{:href => "/nlab/show/generalized+homology"} generalized homology
              is this:
            %p
              %img{:src => "http://ncatlab.org/nlab/files/BraidDiagramForHomologyOnTripled.jpg", :width => "500"}/
            %p
              (graphics from
              = succeed ")" do
                %a{:href => "http://math.stackexchange.com/a/1180681/58526"} this Maths.SE comment
          .num_remark
            %h6#remark_8 Remark
            %p
              The exact sequence of a triple in prop.
              %a.maruku-ref{:href => "#ExactSequenceOfATriple"}
              is what gives rise to the
              %a.existingWikiWord{:href => "/nlab/show/Cartan-Eilenberg+spectral+sequence"} Cartan-Eilenberg spectral sequence
              for
              = succeed "-cohomology" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          #ExtractingSuspensionIsomorphismFromUnreducedCohomology.num_example
            %h6#example_14 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,x)
              a
              %a.existingWikiWord{:href => "/nlab/show/pointed+topological+space"} pointed topological space
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi I
                      %mo +
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Cone(X) = (X \wedge (I_+))/X
              its reduced
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cone"} cone
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} {
                      %mi x
                      %mo{:stretchy => "false"} }
                      %mo ,
                      %mi X
                      %mo ,
                      %mi Cone
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\{x\}, X, Cone(X))
              = succeed "," do
                %a.maruku-ref{:href => "#ExactSequenceOfATriple"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo ≃
                    %msup
                      %mi E
                      %mi q
                    %mo{:stretchy => "false"} (
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mi E
                      %mi q
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mover
                        %mi δ
                        %mo{:stretchy => "false"} ¯
                    %msup
                      %mi E
                      %mrow
                        %mi q
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mi E
                      %mrow
                        %mi q
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    0
                    \\simeq
                    E^q(Cone(X), \{x\})
                    \\longrightarrow
                    E^q(X,\{x\})
                    \\overset{\bar \delta}{\longrightarrow}
                    E^{q+1}(Cone(X),X)
                    \\longrightarrow
                    E^{q+1}(Cone(X), \{x\})
                    \\simeq 0
            %p
              exhibits the
              %a.existingWikiWord{:href => "/nlab/show/connecting+homomorphism"} connecting homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi δ
                      %mo{:stretchy => "false"} ¯
                  %annotation{:encoding => "application/x-tex"} \bar \delta
              here as an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
