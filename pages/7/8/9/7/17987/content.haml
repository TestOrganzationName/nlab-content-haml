                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n, k \in \mathbb{N}
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
