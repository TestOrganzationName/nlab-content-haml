                    \\\
                    \\uparrow^{\mathrlap{(id,\delta_1)}} &amp; \nearrow_{\mathrlap{g}}
                    \\\
                    \\Delta^1
                    }
            %p
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
