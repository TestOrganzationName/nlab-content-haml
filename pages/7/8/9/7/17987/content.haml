            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Gr
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℂ
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mo ≔
