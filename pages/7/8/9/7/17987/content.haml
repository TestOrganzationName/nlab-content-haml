          #SimplicialSet.num_defn
            %h6#definition_15 Definition
            %p
              A
              %strong
                %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ∈
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} S \in sSet
              is
            %ul
              %li
                %p
                  for each
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
                  a
                  %a.existingWikiWord{:href => "/nlab/show/set"} set
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi S
                          %mi n
                        %mo ∈
                        %mi Set
                      %annotation{:encoding => "application/x-tex"} S_n \in Set
                  – the
                  = succeed ";" do
                    %strong
                      set of
                      = succeed "-" do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi n
                            %annotation{:encoding => "application/x-tex"} n
                      %a.existingWikiWord{:href => "/nlab/show/simplices"} simplices
              %li
                %p
                  for each
                  %a.existingWikiWord{:href => "/nlab/show/injective+map"} injective map
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi δ
                          %mi i
                        %mo :
                        %mover
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                          %mo ¯
                        %mo →
                        %mover
                          %mi n
                          %mo ¯
                      %annotation{:encoding => "application/x-tex"} \delta_i : \overline{n-1} \to \overline{n}
                  of
                  %a.existingWikiWord{:href => "/nlab/show/totally+ordered+sets"} totally ordered sets
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi n
                          %mo{:stretchy => "false"} ¯
                        %mo ≔
                        %mo{:stretchy => "false"} {
                        %mn 0
                        %mo &lt;
                        %mn 1
                        %mo &lt;
                        %mi ⋯
                        %mo &lt;
                        %mi n
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \bar n \coloneqq \{ 0 \lt 1 \lt \cdots \lt n \}
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/function"} function
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi d
                          %mi i
                        %mo :
                        %msub
                          %mi S
                          %mi n
                        %mo →
                        %msub
                          %mi S
