                  %mrow
                    %mover
                      %mi δ
                      %mo{:stretchy => "false"} ¯
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi E
                      %mi q
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
