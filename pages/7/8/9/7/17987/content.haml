                                  %mo ,
                                  %msub
                                    %mi δ
                                    %mn 1
                                  %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ↑
                          %mtd
                            %msub
                              %mo ↗
                              %mpadded{:width => "0"}
                                %mi g
                        %mtr
                          %mtd
                            %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X
                    \\\
                    {}^{\mathllap{(id,\delta_0)}}\downarrow &amp; \searrow^{\mathrlap{f}}
                    \\\
                    X \times \Delta^1 &amp;\stackrel{\eta}{\to}&amp; Y
                    \\\
                    {}^{\mathllap{(id,\delta_1)}}\uparrow &amp; \nearrow_{\mathrlap{g}}
                    \\\
                    X
                    }
                    \\,.
          .num_remark
            %h6#remark Remark
            %p
              In words this says that a homotopy between two continuous functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              is a continuous 1-parameter deformation of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
