                    %annotation{:encoding => "application/x-tex"} n \leq k
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %strong
                real
                %a.existingWikiWord{:href => "/nlab/show/Grassmannian"} Grassmannian
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^k
              is the
              %a.existingWikiWord{:href => "/nlab/show/coset"} coset
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Gr
                      %mi n
                    %mo{:stretchy => "false"} (
