                      %mo ⟶
                      %mo ≃
                    %msup
                      %mi E
                      %mrow
                        %mi q
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\bar \delta
                    \\;\colon\;
                    E^q(X,\{x\})
                    \\overset{\simeq}{\longrightarrow}
                    E^{q+1}(Cone(X),X)
                    \\,.
            %p
              This is the
              %em
                %a.existingWikiWord{:href => "/nlab/show/suspension+isomorphism"} suspension isomorphism
              extracted from the unreduced cohomology theory, see def.
