                  %annotation{:encoding => "application/x-tex"} f \colon X \to B O(n)
              eastblishes a
              %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi B
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
