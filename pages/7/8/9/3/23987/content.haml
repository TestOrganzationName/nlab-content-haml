                            %mn 4
                        %annotation{:encoding => "application/x-tex"} \mathbb{Z}_4
                  %a.existingWikiWord{:href => "/nlab/show/time-reversal+symmetry"} time-reversal symmetric
                  %a.existingWikiWord{:href => "/nlab/show/topological+superconductor"} topological superconductor
                  with 3d boundary topological order &amp;lbrack;
