                %a{:href => "https://nyu.zoom.us/rec/share/eCYVcE8H1awJQBiz_KO8tFKiSzg6z7fuNOezzMRtwMmDhBfvYggd6gsQzpMCHdhz.P2-aYYVnZnxYJbR-"} Zm
              %p
