              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/univalence+axiom"} univalence axiom
              = succeed "\u201D" do
                %a.existingWikiWord{:href => "/nlab/show/cubical+type+theory"} cubical TT
              = succeed "\u201D." do
