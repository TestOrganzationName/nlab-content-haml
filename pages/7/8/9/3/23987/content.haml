              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/quantum+programming+language"} quantum
              %a.existingWikiWord{:href => "/nlab/show/programming+language"} programming
              and
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/software+verification"} certification languages
              %a.existingWikiWord{:href => "/nlab/show/modal+types"} modal types
              and
              %a.existingWikiWord{:href => "/nlab/show/monadic+effects"} monadic effects
              (in
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/modal+homotopy+type+theory"} modal extensions of HoTT
            %p
