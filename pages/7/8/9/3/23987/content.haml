                  of
                  %a.existingWikiWord{:href => "/nlab/show/reduced+suspension"} suspensions
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi H
                        %mi ℤ
                        %mo{:stretchy => "false"} /
                        %mi p
