                %a{:href => "https://cdnapisec.kaltura.com/html5/html5lib/v2.73.2/mwEmbedFrame.php/p/1674401/uiconf_id/23435151/entry_id/1_13g33vg2?wid=_1674401&iframeembed=true&playerId=kaltura_player&entry_id=1_13g33vg2"} kt
              %p
