                %a{:href => "https://nyu.zoom.us/rec/share/cvJN1WxKAy90-TU2xGGgI_qpr29cXwYnViJK2f7sicBsvZoOfAxYS1oHAURPgtbn.r4soFI_hw6c9Wtok"} Zm
