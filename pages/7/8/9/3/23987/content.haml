                  %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
                  on
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/loop+space"} loop space
                  %a.existingWikiWord{:href => "/nlab/show/Matthias+Ludewig"} Matthias Ludewig
