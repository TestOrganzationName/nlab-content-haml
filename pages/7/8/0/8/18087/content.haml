          #Frechetspace.num_defn
            %h6#definition_6 Definition
            %p If
            %ol
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo ,
                      %mrow
                        %mo{:stretchy => "false"} ‖
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
