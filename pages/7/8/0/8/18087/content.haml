          %p
            Thus an F-norm is precisely an F-seminorm whose induced pseudometric is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/metric"} metric
            %a.existingWikiWord{:href => "/nlab/show/G-norms"} G-norms
            and
            %a.existingWikiWord{:href => "/nlab/show/norms"} norms
            with G-seminorms in
            %a.maruku-ref{:href => "#Gseminorm"}
            and seminorms in
            %a.maruku-ref{:href => "#seminorm"}
            above.)
          #Fspace.num_defn
            %h6#definition_5 Definition
            %p If
            %ol
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ‖
                    %annotation{:encoding => "application/x-tex"} \|{-}\|
                is an F-norm and
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
                converges under the metric on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
                whenever
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
                is a
                %a.existingWikiWord{:href => "/nlab/show/net"} net
                of vectors and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi lim
                        %mrow
                          %mi i
                          %mo ,
                          %mi j
                      %mrow
                        %mo{:stretchy => "false"} ‖
