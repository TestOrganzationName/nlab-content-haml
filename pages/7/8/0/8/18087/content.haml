                    %mi i
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi x
                      %mi i
                    %msup
                      %mo{:stretchy => "false"} |
                      %mi p
                %annotation{:encoding => "application/x-tex"} {\|x\|_p} = \sum_i {|x_i|^p}
          %p
            (so without the
            = succeed "th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
