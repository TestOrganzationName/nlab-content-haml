                  %a.existingWikiWord{:href => "/nlab/show/Fr%C3%A9chet+space"} Fréchet space
          %p
            Finally,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
