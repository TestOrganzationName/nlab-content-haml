                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            is given by an
            %a.existingWikiWord{:href => "/nlab/show/absolute+value"} absolute value
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} |{-}|
          #seminorm.num_defn
            %h6#definition_3 Definition
            %p If
            %ol
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} ‖
                        %mi x
                        %mo +
                        %mi y
                        %mo{:stretchy => "false"} ‖
                      %mo ≤
                      %mrow
                        %mo{:stretchy => "false"} ‖
                        %mi x
                        %mo{:stretchy => "false"} ‖
                      %mo +
                      %mrow
                        %mo{:stretchy => "false"} ‖
                        %mi y
                        %mo{:stretchy => "false"} ‖
                    %annotation{:encoding => "application/x-tex"} {\|x + y\|} \leq {\|x\|} + {\|y\|}
                for each vector
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
                and vector
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                    %annotation{:encoding => "application/x-tex"} y
                and
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
