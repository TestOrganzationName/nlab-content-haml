            is a
            %a.existingWikiWord{:href => "/nlab/show/short+map"} short map
            under this pseudometric and so certainly
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/continuous+map"} continuous
          #Fseminorm.num_defn
            %h6#definition_2 Definition
            %p If
            %ol
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
