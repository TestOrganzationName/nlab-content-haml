                        %mi ι
                        %mphantom
                          %mi AA
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}_S
                    \\overset{\phantom{AA}\iota\phantom{AA}}{\hookrightarrow}
                    \\mathcal{C}
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              of
              = succeed "-local" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
          #LocalizationAtACollectionOfMorphisms.num_defn
            %h6#definition_5 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflection
                onto
                %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/local+objects"} local objects
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              and set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %msub
                      %mi Mor
                      %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} S \subset Mor_{\mathcal{C}}
              be a sub-
              %a.existingWikiWord{:href => "/nlab/show/class"} class
              of its
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              %em
                reflection onto local
                = succeed "-objects" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
              (often called “localization at the collection
              = succeed "\u201D)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              to the
              = succeed "-inclusion" do
                %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %a.existingWikiWord{:href => "/nlab/show/local+objects"} local objects
              = succeed ":" do
                %a.maruku-eqref{:href => "#eq:FullSubcategoryOfSLocalObjects"} (2)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mi S
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ↪
                        %mi ι
                      %mover
                        %mo ⟵
                        %mrow
                          %mphantom
                            %mi AA
                          %mi L
                          %mphantom
                            %mi AA
                    %mi 𝒞
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}_S
                    \\underoverset
                    {\underset{\iota}{\hookrightarrow}}
                    {\overset{\phantom{AA}L\phantom{AA}}{\longleftarrow}}
                    {\bot}
                    \\mathcal{C}
                    \\,.
          %h2#properties Properties
          #ReflectiveSubcategoriesAreLocalizations.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/reflective+subcategories"} reflective subcategories
                are
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/localizations"} localizations
            %p
              Every
              = succeed "-inclusion" do
                %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective subcategory
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mi L
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ↪
                        %mrow
                          %mphantom
                            %mi AA
                          %mi ι
                          %mphantom
                            %mi AA
                      %mover
                        %mo ⟵
                        %mrow
                          %mphantom
                            %mi AA
                          %mi L
                          %mphantom
                            %mi AA
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}_{L}
                    \\underoverset
                    {\underset{\phantom{AA}\iota \phantom{AA}}{\hookrightarrow}}
                    {\overset{ \phantom{AA} L \phantom{AA} }{\longleftarrow}}
                    {\bot}
                    \\mathcal{C}
            %p
              is
              %a.existingWikiWord{:href => "/nlab/show/generalized+the"} the
              %a.existingWikiWord{:href => "/nlab/show/reflective+localization"} reflective localization
              at the class
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo ≔
                    %msup
                      %mi L
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Isos
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} W \coloneqq L^{-1}(Isos)
              of morphisms that are sent to isomorphisms by the reflector
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                    %annotation{:encoding => "application/x-tex"} L
          .proof
            %h6#proof Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒞
                    %mo →
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} F \;\colon\; \mathcal{C} \to \mathcal{D}
              be a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              which inverts morphisms that are inverted by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                    %annotation{:encoding => "application/x-tex"} L
            %p
              First we need to show that it factors through
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                    %annotation{:encoding => "application/x-tex"} L
              %a.existingWikiWord{:href => "/nlab/show/whiskering"} whiskering
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi η
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(\eta)
              of the
              %a.existingWikiWord{:href => "/nlab/show/adjunction+unit"} adjunction unit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
              with
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi 𝒞
                          %mtd
                          %mtd
                            %mover
                              %mo ⟶
                              %mi F
                          %mtd
                          %mtd
                            %mi 𝒟
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi L
                            %mo ↘
                          %mtd
                            %mo ⇓
                          %mtd
                            %msub
                              %mo ↗
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi D
                                  %mi F
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi 𝒞
                              %mi L
                    %mphantom
                      %mi AA
                    %mo ≔
                    %mphantom
                      %mi AA
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi 𝒞
                          %mtd
                          %mtd
                            %mover
                              %mo ⟶
                              %mi id
                          %mtd
                          %mtd
                            %mi 𝒞
                          %mtd
                            %mover
                              %mo ⟶
                              %mi F
                          %mtd
                            %mi 𝒟
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi L
                            %mo ↘
                          %mtd
                            %msup
                              %mo ⇓
                              %mi η
                          %mtd
                            %msub
                              %mo ↗
                              %mpadded{:width => "0"}
                                %mi ι
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi 𝒞
                              %mi L
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathcal{C}
                    \&amp;&amp; \overset{F}{\longrightarrow} &amp;&amp;
                    \\mathcal{D}
                    \\\
                    \&amp; {}_{\mathllap{L}}\searrow &amp;\Downarrow&amp; \nearrow_{\mathrlap{D F}}
                    \\\
                    \&amp;&amp; \mathcal{C}_L
                    }
                    \\phantom{AA} \coloneqq \phantom{AA}
                    \\array{
                    \\mathcal{C}
                    \&amp;&amp; \overset{id}{\longrightarrow} &amp;&amp;
                    \\mathcal{C}
                    \&amp; \overset{F}{\longrightarrow}&amp;
                    \\mathcal{D}
                    \\\
                    \&amp; {}_{\mathllap{L}}\searrow &amp;\Downarrow^{\eta}&amp; \nearrow_{\mathrlap{\iota}}
                    \\\
                    \&amp;&amp; \mathcal{C}_L
                    }
            %p
              By
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/idempotent+monad"} idempotency
              %a.existingWikiWord{:href => "/nlab/show/adjunction+unit"} adjunction unit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
              are inverted by
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                    %annotation{:encoding => "application/x-tex"} L
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi η
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(\eta)
              is indeed a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
            %p
              It remains to show that this factorization is unique up to unique natural isomorphism. So consider any other factorization
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mo ′
                    %mi F
                  %annotation{:encoding => "application/x-tex"} D^' F
              via a natural isomorphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                    %annotation{:encoding => "application/x-tex"} \rho
              %a.existingWikiWord{:href => "/nlab/show/adjunction+counit"} adjunction counit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi 𝒞
                          %mtd
                          %mtd
                            %mover
                              %mo ⟶
                              %mi F
                          %mtd
                          %mtd
                            %mi 𝒟
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi ι
                            %mo ↗
                          %mtd
                            %msup
                              %mrow
                              %mi ϵ
                            %mo ⇓
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi L
                            %mo ↘
                          %mtd
                            %msup
                              %mo ⇓
                              %mi ρ
                          %mtd
                            %msub
                              %mo ↗
                              %mpadded{:width => "0"}
                                %mrow
                                  %msup
                                    %mi D
                                    %mo ′
                                  %mi F
                        %mtr
                          %mtd
                            %msub
                              %mi 𝒞
                              %mi L
                          %mtd
                          %mtd
                            %munder
                              %mo ⟶
                              %mi id
                          %mtd
                          %mtd
                            %msub
                              %mi 𝒞
                              %mi L
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp;
                    \\mathcal{C} &amp;&amp; \overset{F}{\longrightarrow} &amp;&amp;  \mathcal{D}
                    \\\
                    \&amp;
                    {}^{\mathllap{\iota}}\nearrow
                    \&amp;
                    {}^{\epsilon}\Downarrow
                    \&amp; {}_{\mathllap{L}}\searrow
                    \&amp;\Downarrow^{\rho}&amp; \nearrow_{\mathrlap{D^' F}}
                    \\\
                    \\mathcal{C}_L
                    \&amp;&amp;
                    \\underset{ id }{\longrightarrow}
                    \&amp;&amp;
                    \\mathcal{C}_L
                    }
            %p
              exhibits a natural isomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo ⋅
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \epsilon \cdot \rho
              between
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %mi F
                      %mo ≃
                      %msup
                        %mi D
                        %mo ′
                      %mi F
                    %annotation{:encoding => "application/x-tex"} D F \simeq D^' F
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi η
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(\eta)
              according to
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:CompatibleNaturalIsoForLocalization"} (1)
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/triangle+identity"} triangle identity
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi 𝒞
                          %mtd
                          %mtd
                            %mover
                              %mo ⟶
                              %mi id
                          %mtd
                          %mtd
                            %mi 𝒞
                          %mtd
                          %mtd
                            %mover
                              %mo ⟶
                              %mi F
                          %mtd
                          %mtd
                            %mi 𝒟
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi id
                            %mo ↘
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi η
                            %mo ⇓
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi ι
                            %mo ↗
                          %mtd
                            %msup
                              %mrow
                              %mi ϵ
                            %mo ⇓
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi L
                            %mo ↘
                          %mtd
                            %msup
                              %mo ⇓
                              %mi ρ
                          %mtd
                            %msub
                              %mo ↗
                              %mpadded{:width => "0"}
                                %mrow
                                  %msup
                                    %mi D
                                    %mo ′
                                  %mi F
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi 𝒞
                              %mi L
                          %mtd
                          %mtd
                            %munder
                              %mo ⟶
                              %mi id
                          %mtd
                          %mtd
                            %msub
                              %mi 𝒞
                              %mi L
                    %mphantom
                      %mi AAAA
                    %mo =
                    %mphantom
                      %mi AAAA
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi 𝒞
                          %mtd
                          %mtd
                            %mover
                              %mo ⟶
                              %mi F
                          %mtd
                          %mtd
                            %mi 𝒟
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                            %msup
                              %mo ⇓
                              %mi ρ
                          %mtd
                            %mo ↙
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi 𝒞
                              %mi L
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathcal{C}
                    \&amp;&amp;
                    \\overset{id}{\longrightarrow}
                    \&amp;&amp;
                    \\mathcal{C} &amp;&amp; \overset{F}{\longrightarrow} &amp;&amp;  \mathcal{D}
                    \\\
                    \&amp;
                    {}_{\mathllap{id}}\searrow
                    \&amp;
                    {}^{\mathllap{\eta}}\Downarrow
                    \&amp;
                    {}^{\mathllap{\iota}}\nearrow
                    \&amp;
                    {}^{\epsilon}\Downarrow
                    \&amp; {}_{\mathllap{L}}\searrow
                    \&amp;\Downarrow^{\rho}&amp; \nearrow_{\mathrlap{D^' F}}
                    \\\
                    \&amp;&amp;
                    \\mathcal{C}_L
                    \&amp;&amp;
                    \\underset{ id }{\longrightarrow}
                    \&amp;&amp;
                    \\mathcal{C}_L
                    }
                    \\phantom{AAAA}
                    \=
                    \\phantom{AAAA}
                    \\array{
                    \\mathcal{C} &amp;&amp; \overset{F}{\longrightarrow} &amp;&amp;  \mathcal{D}
                    \\\
                    \&amp; \searrow &amp;\Downarrow^\rho&amp; \swarrow
                    \\\
                    \&amp;&amp; \mathcal{C}_L
                    }
            %p
              Finally, since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/essentially+surjective+functor"} essentially surjective functor
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/idempotent+monad"} idempotency
          #ReflectiveLocalizationGivenByLocalObjects.num_prop
            %h6#proposition_2 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/reflective+localization"} reflective localization
                %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflects
                onto
                %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/local+objects"} local objects
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo ⊂
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} W \subset \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/category+with+weak+equivalences"} category with weak equivalences
              (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#CategoryWithWeakEquivalences"}
              %a.existingWikiWord{:href => "/nlab/show/reflective+localization"} reflective localization
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LocalizationOfACategory"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi W
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ↪
                        %mrow
                          %mphantom
                            %mi AA
                          %mi ι
                          %mphantom
                            %mi AA
                      %mover
                        %mo ⟵
                        %mrow
                          %mphantom
                            %mi AA
                          %mi L
                          %mphantom
                            %mi AA
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}[W^{-1}]
                    \\underoverset
                    {\underset{\phantom{AA} \iota \phantom{AA}}{\hookrightarrow}}
                    {\overset{ \phantom{AA} L \phantom{AA} }{\longleftarrow}}
                    {\bot}
                    \\mathcal{C}
            %p
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi W
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo ↪
                      %mi ι
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}[W^{-1}] \overset{\iota}{\hookrightarrow} \mathcal{C}
              is
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalently
              the inclusion of the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              on the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
              %a.existingWikiWord{:href => "/nlab/show/local+objects"} local objects
              (Def.
              = succeed ")," do
                %a.maruku-ref{:href => "#LocalObjects"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              is equivalently reflection onto the
              = succeed "-local" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
              = succeed "." do
                %a.maruku-ref{:href => "#LocalizationAtACollectionOfMorphisms"}
          .proof
            %h6#proof_2 Proof
            %p We need to show that
            %ol
              %li
                %p
                  every
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ∈
                        %mi 𝒞
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi W
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} ]
                        %mover
                          %mo ↪
                          %mi ι
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} X \in \mathcal{C}[W^{-1}] \overset{\iota}{\hookrightarrow} \mathcal{C}
                  is
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi W
                        %annotation{:encoding => "application/x-tex"} W
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/local+object"} local
              %li
                %p
                  every
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                        %mo ∈
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} Y \in \mathcal{C}
                  is
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi W
                        %annotation{:encoding => "application/x-tex"} W
                  %a.existingWikiWord{:href => "/nlab/show/local+object"} local
                  precisely if it is
                  %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
                  to an object in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                          %mo{:stretchy => "false"} [
                          %msup
                            %mi W
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mo{:stretchy => "false"} ]
                          %mover
                            %mo ↪
                            %mi ι
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}[W^{-1}] \overset{\iota}{\hookrightarrow} \mathcal{C}
            %p
              The first statement follows directly with the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjunction isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi w
                    %mo ,
                    %mi ι
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi Hom
                      %mrow
                        %mi 𝒞
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi W
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi w
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{\mathcal{C}}(w, \iota(X))
                    \\simeq
                    Hom_{\mathcal{C}[W^{-1}]}(L(w), X)
            %p
              and the fact that the
              %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
              takes
              %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
              to
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/bijections"} bijections
            %p
              For the second statement, consider the case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              is
              = succeed "-local." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              is also local with respect to the class
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi W
                      %mi sat
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi L
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Isos
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    W_{sat} \;\coloneqq\; L^{-1}(Isos)
            %p
              of
              %em all
              morphisms that are inverted by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              (the “
              %a.existingWikiWord{:href => "/nlab/show/saturated+class+of+morphisms"}> saturated class of morphisms
              ”): For consider the
              %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi Hom
                          %mi 𝒞
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mi Y
                        %mo{:stretchy => "false"} )
                    %msup
                      %mi Set
                      %mi op
                  %annotation{:encoding => "application/x-tex"} \mathcal{C} \overset{Hom_{\mathcal{C}}(-,Y)}{\longrightarrow} Set^{op}
              to the
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite
              of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/category+of+sets"} category of sets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              this takes elements in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
              to isomorphisms. Hence, by the defining
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              of the
              = succeed "-functor" do
                %a.existingWikiWord{:href => "/nlab/show/localization"} localization
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                    %annotation{:encoding => "application/x-tex"} L
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                    %annotation{:encoding => "application/x-tex"} L
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
            %p
              Since by
              %a.existingWikiWord{:href => "/nlab/show/idempotent+monad"} idempotency
              the
              %a.existingWikiWord{:href => "/nlab/show/adjunction+unit"} adjunction unit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} \eta_Y
              is in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi W
                        %mi sat
                    %annotation{:encoding => "application/x-tex"} W_{sat}
              %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi η
                      %mi Y
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi ι
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{\mathcal{C}}( \eta_Y, Y )
                    \\;\colon\;
                    Hom_{\mathcal{C}}( \iota L(Y), Y )
                    \\overset{\simeq}{\longrightarrow}
                    Hom_{\mathcal{C}}(Y, Y)
                    \\,.
            %p
              In particular the
              %a.existingWikiWord{:href => "/nlab/show/identity+morphism"} identity morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi id
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} id_Y
              has a
              %a.existingWikiWord{:href => "/nlab/show/preimage"} preimage
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi η
                      %mi Y
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \eta_Y^{-1}
              under this function, hence a
              %a.existingWikiWord{:href => "/nlab/show/left+inverse"} left inverse
              to
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                    %annotation{:encoding => "application/x-tex"} \eta
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi η
                      %mi Y
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ∘
                    %msub
                      %mi η
                      %mi Y
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi id
                      %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\eta_Y^{-1} \circ \eta_Y \;=\; id_Y
                    \\,.
            %p
              But by
              %a.existingWikiWord{:href => "/nlab/show/2-out-of-3"} 2-out-of-3
              this implies that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi η
                        %mi Y
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo ∈
                      %msub
                        %mi W
                        %mi sat
                    %annotation{:encoding => "application/x-tex"} \eta_Y^{-1} \in W_{sat}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ι
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \iota L(Y)
              is
              = succeed "-local," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi W
                        %mi sat
                    %annotation{:encoding => "application/x-tex"} W_{sat}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi η
                      %mi Y
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ,
                    %mi ι
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi ι
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi ι
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi ι
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{\mathcal{C}}( \eta^{-1}_Y, \iota L(Y) )
                    \\;\colon\;
                    Hom_{\mathcal{C}}( Y, \iota L(Y) )
                    \\overset{\simeq}{\longrightarrow}
                    Hom_{\mathcal{C}}( \iota L(Y) , \iota L(Y))
                    \\,,
            %p
              to deduce that also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi η
                      %mi Y
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \eta_Y^{-1}
              has a
              %a.existingWikiWord{:href => "/nlab/show/left+inverse"} left inverse
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi η
                        %mi Y
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo ∘
                      %msubsup
                        %mi η
                        %mi Y
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} (\eta_Y^{-1})^{-1} \circ \eta_Y^{-1}
              %a.existingWikiWord{:href => "/nlab/show/left+inverse"} left inverse
              that itself has a
              %a.existingWikiWord{:href => "/nlab/show/left+inverse"} left inverse
              is in fact an
              %a.existingWikiWord{:href => "/nlab/show/inverse+morphisms"} inverse morphisms
              (
              %a{:href => "retract#LeftInverseWithLeftInverseIsLeftInverse"}> this Lemma
              ), this means that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi η
                      %mi Y
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \eta^{-1}_Y
              is an
              %a.existingWikiWord{:href => "/nlab/show/inverse+morphism"} inverse morphism
              to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi η
                        %mi Y
                    %annotation{:encoding => "application/x-tex"} \eta_Y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi Y
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Y
                    %mo →
                    %mi ι
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \eta_Y \;\colon\; Y \to \iota L (Y)
              is an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              and hence that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              is isomorphic to an object in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi W
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} ]
                      %mover
                        %mo ↪
                        %mi ι
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}[W^{-1}] \overset{\iota}{\hookrightarrow} \mathcal{C}
            %p
              Conversely, if there is an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              to a morphism in the image of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ι
                  %annotation{:encoding => "application/x-tex"} \iota
              hence, by the first item, to a
              = succeed "-local" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              is
              = succeed "-local," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
              %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
              takes
              %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
              to
              %a.existingWikiWord{:href => "/nlab/show/bijections"} bijections
              and since bijections satisfy
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/2-out-of-3"} 2-out-of-3
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %ul
            %li
              For a left exact reflective localization, the class of morphisms that is inverted forms a left-
              %a.existingWikiWord{:href => "/nlab/show/multiplicative+system"}> multiplicative system
              \. For the moment see at
              %em
                %a.existingWikiWord{:href => "/nlab/show/geometric+embedding"} geometric embedding
              for details on this.
          #ReflectionOntoLocalObjectsIsLocalizationWithRespectToLeftAdjoints.num_prop
            %h6#proposition_3 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflection
                onto
                %a.existingWikiWord{:href => "/nlab/show/local+objects"} local objects
                in
                %a.existingWikiWord{:href => "/nlab/show/localization"} localization
                with respect to
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/left+adjoints"} left adjoints
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %msub
                      %mi Mor
                      %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} S \subset Mor_{\mathcal{C}}
              be a
              %a.existingWikiWord{:href => "/nlab/show/class"} class
              of
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflection
              onto the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %a.existingWikiWord{:href => "/nlab/show/local+objects"} local objects
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LocalizationAtACollectionOfMorphisms"}
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              of a
              %a.existingWikiWord{:href => "/nlab/show/localization+of+categories"} localization of categories
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LocalizationOfACategory"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              functors inverting
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
          .proof
            %h6#proof_3 Proof
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mi S
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ↪
                        %mrow
                          %mphantom
                            %mi AA
                          %mi ι
                          %mphantom
                            %mi AA
                      %mover
                        %mo ⟵
                        %mrow
                          %mphantom
                            %mi AA
                          %mi L
                          %mphantom
                            %mi AA
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}_S
                    \\underoverset
                    {\underset{ \phantom{AA}\iota\phantom{AA} }{\hookrightarrow}}
                    {\overset{\phantom{AA}L\phantom{AA}}{\longleftarrow}}
                    {\bot}
                    \\mathcal{C}
            %p
              for the
              = succeed "-inclusion" do
                %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective subcategory
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/local+objects"} local objects
            %p
              Say that a
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is an
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
                \-
                %a.existingWikiWord{:href => "/nlab/show/local+morphism"} local morphism
              if for every
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %a.existingWikiWord{:href => "/nlab/show/local+object"} local object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} A \in \mathcal{C}
              the
              %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              yields a
              %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Hom
                        %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Hom_{\mathcal{C}}(f,A)
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
              for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒞
                        %mi S
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}_S
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %a.existingWikiWord{:href => "/nlab/show/local+morphisms"} local morphisms
              are precisely the morphisms that are taken to isomorphisms by the reflector
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                    %annotation{:encoding => "application/x-tex"} L
            %p Now let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo ⊣
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒞
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ⟵
                        %mi G
                      %mover
                        %mo ⟶
                        %mrow
                          %mphantom
                            %mi AA
                          %mi F
                          %mphantom
                            %mi AA
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"}
                    (F \dashv G)
                    \\;\colon\;
                    \\mathcal{C}
                    \\underoverset
                    {\underset{G}{\longleftarrow}}
                    {\overset{ \phantom{AA} F \phantom{AA} }{\longrightarrow}}
                    {\bot}
                    \\mathcal{D}
            %p
              be a pair of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              inverts the morphisms in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              takes values in
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/local+objects"} local objects
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
              for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒟
                    %annotation{:encoding => "application/x-tex"} \mathcal{D}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              inverts all
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/local+morphisms"} local morphisms
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                    %annotation{:encoding => "application/x-tex"} L
            %p
              Thus the essentially unique factorization of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              through
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              now follows by Prop.
              = succeed "." do
                %a.maruku-ref{:href => "#ReflectiveSubcategoriesAreLocalizations"}
