                  %mi y
                  %mo{:stretchy => "false"} ]
                  %mo ≤
                  %mi c
                  %mo{:stretchy => "false"} }
                  %mo .
                %annotation{:encoding => "application/x-tex"} \pi(c) = \bigvee \{y \in Q: [y] \leq c\}.
          #inverse.num_lemma
            %h6#lemma_2 Lemma
            %p
              Given a regular epi
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mo :
                    %mi Q
                    %mo →
                    %mover
                      %mi Q
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} [-]: Q \to \tilde{Q}
              in the category of quantales, with right adjoint
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi π
                      %mo :
                      %mover
                        %mi Q
                        %mo{:stretchy => "false"} ˜
                      %mo →
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} \pi: \tilde{Q} \to Q
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              is prime in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi Q
                        %mo{:stretchy => "false"} ˜
                    %annotation{:encoding => "application/x-tex"} \tilde{Q}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi(c)
              is prime in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} Q
          .proof
            %h6#proof_5 Proof
            %p
              For elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ,
                    %mi b
                    %mo ∈
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} a, b \in Q
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi a
                            %mi b
                            %mo ≤
                            %mi π
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mi iff
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mi a
                            %mi b
                            %mo{:stretchy => "false"} ]
                            %mo ≤
                            %mi c
                          %mtd
                            %mi since
                            %mspace{:width => "thickmathspace"}
                            %mo{:stretchy => "false"} [
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} ]
                            %mo ⊣
                            %mi π
                        %mtr
                          %mtd
                          %mtd
                            %mi iff
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mi a
                            %mo{:stretchy => "false"} ]
                            %mo ⋅
                            %mo{:stretchy => "false"} [
                            %mi b
                            %mo{:stretchy => "false"} ]
                            %mo ≤
                            %mi c
                          %mtd
                            %mi since
                            %mspace{:width => "thickmathspace"}
                            %mo{:stretchy => "false"} [
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} ]
                            %mspace{:width => "thickmathspace"}
                            %mi is
                            %mspace{:width => "thickmathspace"}
                            %mi{:mathvariant => "normal"} a
                            %mspace{:width => "thickmathspace"}
                            %mi quantale
                            %mspace{:width => "thickmathspace"}
                            %mi map
                        %mtr
                          %mtd
                          %mtd
                            %mi iff
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} [
                            %mi a
                            %mo{:stretchy => "false"} ]
                            %mo ≤
                            %mi c
                            %mo{:stretchy => "false"} )
                            %mo ∨
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} [
                            %mi b
                            %mo{:stretchy => "false"} ]
                            %mo ≤
                            %mi c
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mi since
                            %mspace{:width => "thickmathspace"}
                            %mi c
                            %mspace{:width => "thickmathspace"}
                            %mi is
                            %mspace{:width => "thickmathspace"}
                            %mi prime
                        %mtr
                          %mtd
                          %mtd
                            %mi iff
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi a
                            %mo ≤
                            %mi π
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo ∨
                            %mo{:stretchy => "false"} (
                            %mi b
                            %mo ≤
                            %mi π
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mi since
                            %mspace{:width => "thickmathspace"}
                            %mo{:stretchy => "false"} [
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} ]
                            %mo ⊣
                            %mi π
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    a b \leq \pi(c) &amp; iff &amp; [a b] \leq c &amp; since \; [-] \dashv \pi \\
                    \&amp; iff &amp; [a] \cdot [b] \leq c &amp; since \; [-]\; is\; \mathrm{a}\; quantale\; map \\
                    \&amp; iff &amp; ([a] \leq c) \vee ([b] \leq c) &amp; since \; c \; is\; prime \\
                    \&amp; iff &amp; (a \leq \pi(c)) \vee (b \leq \pi(c)) &amp; since \; [-] \dashv \pi
                    }
            %p which completes the proof.
          %p
            The proof of Theorem
            %a.maruku-ref{:href => "#quantale"}
            is immediate:
          .proof
            %h6#proof_6 Proof
            %p
              Given that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
              is a nontrivial compact affine quantale,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi Q
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde{Q}
              is a nontrivial compact frame by Proposition
              = succeed "." do
                %a.maruku-ref{:href => "#quot"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi Q
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde{Q}
              has a prime element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              by Banaschewski’s lemma, whence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
              has a prime element by Lemma
              = succeed "." do
                %a.maruku-ref{:href => "#inverse"}
          .num_cor
            %h6#corollary Corollary
            %p
              %strong (PIT for rings)
              Every unital ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              has a prime ideal under ZF + (UF).
          .num_remark
            %h6#remark_2 Remark
            %p
              See also
              = succeed "." do
                %a{:href => "#BH"} Banaschewski-Harting
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Idl
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Idl(R)
              formed by the composition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mi π
                    %mo ∘
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mo :
                    %mi Idl
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Idl
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} k = \pi \circ [-]: Idl(R) \to Idl(R)
              has the following properties:
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi k
                        %mo{:stretchy => "false"} (
                        %mi I
                        %mo ∩
                        %mi J
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi k
                        %mo{:stretchy => "false"} (
                        %mi I
                        %mi J
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi k
                        %mo{:stretchy => "false"} (
                        %mi I
                        %mo{:stretchy => "false"} )
                        %mo ∩
                        %mi k
                        %mo{:stretchy => "false"} (
                        %mi J
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} k(I \cap J) = k(I J) = k(I) \cap k(J)
                  ,
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                        %mo{:stretchy => "false"} (
                        %mi J
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} k(J) = 1
                  implies
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi J
                          %mo =
                          %mn 1
                        %annotation{:encoding => "application/x-tex"} J = 1
            %p
              These properties are all that is needed to verify that the fixed points of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              (corresponding to the quotient
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mrow
                          %mi Idl
                          %mo{:stretchy => "false"} (
                          %mi R
                          %mo{:stretchy => "false"} )
                        %mo ˜
                    %annotation{:encoding => "application/x-tex"} \widetilde{Idl(R)}
              %a.existingWikiWord{:href => "/nlab/show/radical"} radical
              of an ideal has these properties, as do other radicals considered in noncommutative ring theory (Levitski radical, Brown-McCoy radical).
          %p
            In fact the same methods show that we can strengthen Theorem
            %a.maruku-ref{:href => "#quantale"}
            to get what we really mean by a PIT:
          #pit.num_cor
            %h6#corollary_2 Corollary
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
              be a nontrivial compact affine quantale, and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} i \in Q
              be any
              %em proper
              element, i.e., assume
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ¬
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo =
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \neg (i = 1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∈
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} p \in Q
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ≤
                      %mi p
                    %annotation{:encoding => "application/x-tex"} i \leq p
          .proof
            %h6#proof_7 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mi π
                    %mo ∘
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mo :
                    %mi Q
                    %mo →
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} k = \pi \circ [-]: Q \to Q
              be the
              %a{:href => "/nlab/show/quantale#quantale_congruences_and_nuclei"} nucleus
              corresponding to the congruence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≡
                  %annotation{:encoding => "application/x-tex"} \equiv
              (i.e., the regular epi
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ]
                      %mo :
                      %mi Q
                      %mo →
                      %mover
                        %mi Q
                        %mo{:stretchy => "false"} ˜
                    %annotation{:encoding => "application/x-tex"} [-]: Q \to \tilde{Q}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ≠
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} i \neq 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} )
                    %mo ≠
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} k(i) \neq 1
              (i.e.,
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ¬
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo ≡
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \neg (i \equiv 1)
              = succeed "." do
                %a.maruku-ref{:href => "#quot"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi Q
                      %mo{:stretchy => "false"} ˜
                    %mo =
                    %mi Fix
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tilde{Q} = Fix(k)
              and the upwards-closed set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ↓
                    %mi Fix
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} k(i) \downarrow Fix(k)
              are both nontrivial compact affine frames, and there is a prime element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} ↓
                      %mi Fix
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} k(i) \downarrow Fix(k)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
              defined as the composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mover
                      %mo →
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} ]
                    %mi Fix
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %mi k
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo{:stretchy => "false"} )
                        %mo ∨
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi k
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ↓
                    %mi Fix
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Q \stackrel{[-]}{\to} Fix(k) \stackrel{k(i) \vee -}{\to} k(i) \downarrow Fix(k)
            %p
              (here using the fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} )
                    %mo ∨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %annotation{:encoding => "application/x-tex"} k(i) \vee -
              preserves finite meets, since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Fix
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Fix(k)
              is a distributive lattice). The right adjoint of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
              is the inclusion
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                      %mo :
                      %mi k
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} ↓
                      %mi Fix
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo{:stretchy => "false"} )
                      %mo ↪
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} \rho: k(i) \downarrow Fix(k) \hookrightarrow Q
              %a.maruku-ref{:href => "#inverse"}
              that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo =
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p = \rho(p)
              is a prime of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo{:stretchy => "false"} )
                      %mo ≤
                      %mi p
                    %annotation{:encoding => "application/x-tex"} k(i) \leq p
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ≤
                      %mi k
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} i \leq k(i)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ≤
                      %mi p
                    %annotation{:encoding => "application/x-tex"} i \leq p
          %h3#generalized_prime_ideal_theorems Generalized prime ideal theorems
          %p
            Now we consider more general settings in which we can speak of (two-sided) ideals and prime ideals, and to which we can apply Theorem
            = succeed "." do
              %a.maruku-ref{:href => "#quantale"}
          %p
            For example, let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                %annotation{:encoding => "application/x-tex"} \mathbf{C}
            be a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/complete+category"} complete
            %a.existingWikiWord{:href => "/nlab/show/cocomplete+category"} cocomplete
            %a.existingWikiWord{:href => "/nlab/show/biclosed+monoidal+category"} biclosed monoidal category
            (e.g., a
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/cosmos"} cosmos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is a
            %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
            object in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbf{C}
            %a.existingWikiWord{:href => "/nlab/show/ideal+in+a+monoid"} ideals
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Idl
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Idl(A)
            will inherit good properties from
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbf{C}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                %annotation{:encoding => "application/x-tex"} \mathbf{C}
            is regular and well-powered, then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Idl
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Idl(A)
            forms a quantale under multiplication of ideals, as discussed
            = succeed "." do
              %a{:href => "/nlab/show/ideal+in+a+monoid#ideals_forming_a_quantale"} here
          %p
            If we further assume that the monoidal unit
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                %annotation{:encoding => "application/x-tex"} \mathbf{C}
            is
            %a.existingWikiWord{:href => "/nlab/show/compact+object"} compact
            (i.e., finitely presented), then the top element of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Idl
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Idl(A)
            generated by the monoid unit
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                  %mo :
                  %mi I
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} e: I \to A
            will be a compact element. Then, defining a prime ideal in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            as usual to be a prime element in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Idl
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Idl(A)
            = succeed "." do
              %a.maruku-ref{:href => "#quantale"}
          %p Here is a sample result along these lines:
          #gpit.num_theorem
            %h6#theorem_4 Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/commutative+theory"} commutative Lawvere theory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Set
                      %mi T
                  %annotation{:encoding => "application/x-tex"} Set^T
              is a well-powered regular cosmos in which the monoidal unit is compact. Consequently, for every monoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Set
                      %mi T
                  %annotation{:encoding => "application/x-tex"} Set^T
              and every proper ideal
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mo ↪
                      %mi A
                    %annotation{:encoding => "application/x-tex"} I \hookrightarrow A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              containing
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              (by applying Corollary
              %a.maruku-ref{:href => "#pit"}
              to
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Idl
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Idl(A)
          .num_cor
            %h6#corollary_3 Corollary
            %p
              %strong (PIT for rigs)
              Every proper ideal in a
              %a.existingWikiWord{:href => "/nlab/show/rig"} rig
              is contained in a prime ideal.
          .proof
            %h6#proof_8 Proof
            %p
              Take
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              to be the theory of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/commutative+monoids"} commutative monoids
              = succeed "." do
                %a.maruku-ref{:href => "#gpit"}
