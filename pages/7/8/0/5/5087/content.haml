          %h2#definition Definition
          #EquivalentDefinitions.num_defn
            %h6#definition_2 Definition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
              between
              %a.existingWikiWord{:href => "/nlab/show/toposes"} toposes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi f
                      %mo *
                    %mo ⊣
                    %msub
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi ℰ
                    %mo →
                    %mi ℱ
                  %annotation{:encoding => "application/x-tex"} (f^* \dashv f_*) : \mathcal{E} \to \mathcal{F}
              is
              %strong surjective
              or a
              %strong geometric surjection
              if it satisfies the following equivalent criteria:
            %ul
              %li
                %p
                  its
                  %a.existingWikiWord{:href => "/nlab/show/inverse+image+functor"} inverse image functor
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi f
                          %mo *
                      %annotation{:encoding => "application/x-tex"} f^*
                  is
                  %a.existingWikiWord{:href => "/nlab/show/faithful+functor"} faithful
                  (in contrast to the
                  %a.existingWikiWord{:href => "/nlab/show/direct+image"} direct image
                  being
                  %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+functor"} full and faithful
                  as for a
                  = succeed ");" do
                    %a.existingWikiWord{:href => "/nlab/show/geometric+embedding"} geometric embedding
              %li
                %p
                  its
                  %a.existingWikiWord{:href => "/nlab/show/inverse+image+functor"} inverse image functor
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi f
                          %mo *
                      %annotation{:encoding => "application/x-tex"} f^*
                  is
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/conservative+functor"} conservative
              %li
                %p
                  the components
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo →
                        %msub
                          %mi f
                          %mo *
                        %msup
                          %mi f
                          %mo *
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X \to f_* f^* X
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} adjunction unit
                  are
                  = succeed "s," do
                    %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                          %mo ∈
                          %mi ℱ
                        %annotation{:encoding => "application/x-tex"} X \in \mathcal{F}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi f
                          %mo *
                      %annotation{:encoding => "application/x-tex"} f^*
                  induces a injective homomorphism of
                  %a.existingWikiWord{:href => "/nlab/show/subobject"} subobject
                  = succeed "s" do
                    %a.existingWikiWord{:href => "/nlab/show/lattice"} lattice
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Sub
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo ↪
                        %mi Sub
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi f
                          %mo *
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        Sub(X) \hookrightarrow Sub(f^* X)
                %p
                  for all
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                          %mo ∈
                          %mi ℱ
                        %annotation{:encoding => "application/x-tex"} X \in \mathcal{F}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi f
                          %mo *
                      %annotation{:encoding => "application/x-tex"} f^*
                  reflects the order on
                  = succeed "s;" do
                    %a.existingWikiWord{:href => "/nlab/show/subobject"} subobject
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi f
                          %mo *
                        %mo ⊣
                        %msub
                          %mi f
                          %mo *
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (f^* \dashv f_*)
                  is a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/comonadic+adjunction"} comonadic adjunction
          %p
            The equivalence of these condition appears for instance as
            = succeed "." do
              %a{:href => "#MacLaneMoerdijk"} MacLaneMoerdijk, VII 4. lemma 3 and prop. 4
          .proof
            %h6#proof Proof
            %p We discuss the equivalence of these conditions:
            %p
              The equivalence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi f
                      %mo *
                    %mspace{:width => "thickmathspace"}
                    %mi faithful
                    %mo{:stretchy => "false"} )
                    %mo ⇔
                    %mo{:stretchy => "false"} (
                    %mi Id
                    %mo →
                    %msup
                      %mi f
                      %mo *
                    %msub
                      %mi f
                      %mo *
                    %mspace{:width => "thickmathspace"}
                    %mi is
                    %mspace{:width => "thickmathspace"}
                    %mi mono
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (f^* \; faithful) \Leftrightarrow (Id \to f^* f_* \;is \; mono)
              is a general property of
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
              (see there).
            %p
              The implication
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi f
                      %mo *
                    %mi faithful
                    %mo{:stretchy => "false"} )
                    %mo ⇒
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi f
                      %mo *
                    %mi induces
                    %mspace{:width => "thickmathspace"}
                    %mi injection
                    %mspace{:width => "thickmathspace"}
                    %mi on
                    %mspace{:width => "thickmathspace"}
                    %mi subobjects
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (f^* faithful) \Rightarrow (f^* induces\;injection\;on\;subobjects)
              works as follows:
            %p
              first of all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^*
              does indeed preserves subobjects: since it respects
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
            %p
              To see that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^*
              induces an injective function on subobjects let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ↪
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U \hookrightarrow X
              be a subobject with characteristic morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi char
                    %mi U
                    %mo :
                    %mi X
                    %mo →
                    %mi Ω
                  %annotation{:encoding => "application/x-tex"} char U : X \to \Omega
              and consider the image
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi f
                              %mo *
                            %mi U
                          %mtd
                            %mo →
                          %mtd
                            %msup
                              %mi f
                              %mo *
                            %mo *
                            %mo ≃
                            %mo *
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msup
                              %mi f
                              %mo *
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msup
                                  %mi f
                                  %mo *
                                %mi char
                                %mi U
                          %mtd
                            %msup
                              %mi f
                              %mo *
                            %mi Ω
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    f^* U &amp;\to&amp; f^* * \simeq *
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    f^* X &amp;\stackrel{f^* char U}{\to}&amp; f^* \Omega
                    }
                    \\,.
            %p
              of the pullback diagram that exhibits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              as a subobject. Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^*
              preserves pullbacks, this is still a pullback diagram.
            %p
              If now
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ≤
                    %mover
                      %mi U
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} U \leq \tilde U
              but
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi U
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f^* (U) = f^*(\tilde U)
              then both corresponding pullback diagrams are sent by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^*
              to the same such diagram. By faithfulness this implies that also
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mover
                              %mi U
                              %mo{:stretchy => "false"} ˜
                          %mtd
                            %mo →
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi char
                                %mi U
                          %mtd
                            %mi Ω
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\tilde U &amp;\to&amp; *
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    X &amp;\stackrel{char U}{\to}&amp; \Omega
                    }
            %p
              commutes, and hence that also
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi U
                        %mo{:stretchy => "false"} ˜
                      %mo ⊂
                      %mi U
                    %annotation{:encoding => "application/x-tex"} \tilde U \subset U
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi U
                        %mo{:stretchy => "false"} ˜
                      %mo ≃
                      %mi U
                    %annotation{:encoding => "application/x-tex"} \tilde U \simeq U
            %p
              Next we consider the implication (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^*
              induces injection on subobjects)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⇒
                  %annotation{:encoding => "application/x-tex"} \Rightarrow
              (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^*
              is conservative).
            %p
              Assume
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mover
                      %mo →
                      %mi ϕ
                    %mi X
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f^* (X \stackrel{\phi}{\to} X')
              is an isomorphism. We have to show that then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              is an isomorphism. Consider the
              %a.existingWikiWord{:href => "/nlab/show/image"} image
              factorization
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo →
                      %mi im
                      %mo{:stretchy => "false"} (
                      %mi ϕ
                      %mo{:stretchy => "false"} )
                      %mo ↪
                      %mi X
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} X \to im(\phi) \hookrightarrow X'
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^*
              preserves pushouts and pullbacks, it preserves epis and monos and so takes this to the image factorization
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mi X
                    %mo →
                    %msup
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi im
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≃
                    %msup
                      %mi f
                      %mo *
                    %mi X
                    %mo ′
                  %annotation{:encoding => "application/x-tex"}
                    f^* X \to f^* (im \phi) \stackrel{\simeq}{\to} f^* X'
            %p
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mo *
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"} f^* \phi
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} f^* \phi
              is assumed to be an iso. By the assumption that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^*
              is injective on subobjects it follows that also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi im
                    %mi ϕ
                    %mo ≃
                    %mi X
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} im \phi \simeq X'
              and thus that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              is an epimorphism.
            %p
              It remains to show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              is also a monomorphism. For that it is sufficient to show that in the pullback square
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                            %msub
                              %mo ×
                              %mrow
                                %mi X
                                %mo ′
                            %mi X
                          %mtd
                            %mo →
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi ϕ
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mi ϕ
                          %mtd
                            %mi X
                            %mo ′
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X \times_{X'} X &amp;\to&amp; X
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{\phi}}
                    \\\
                    X &amp;\stackrel{\phi}{\to}&amp; X'
                    }
            %p
              we have
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %msub
                        %mo ×
                        %mrow
                          %mi X
                          %mo ′
                      %mi X
                      %mo ≃
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X \times_{X'} X \simeq X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo :
                    %mi X
                    %mo →
                    %mi X
                    %msub
                      %mo ×
                      %mrow
                        %mi X
                        %mo ′
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \Delta : X \to X \times_{X'} X
              for the
              %a.existingWikiWord{:href => "/nlab/show/diagonal"} diagonal
              and let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi im
                    %msub
                      %mi Δ
                      %mi ϕ
                    %mo →
                    %mi X
                    %msub
                      %mo ×
                      %mrow
                        %mi X
                        %mo ′
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    X \to im \Delta_\phi \to X \times_{X'} X
            %p
              be its
              %a.existingWikiWord{:href => "/nlab/show/image"} image
              factorization. Doing the same for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mo *
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"} f^* \phi
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^*
              preserves the pullback, we get
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mi im
                    %msub
                      %mi Δ
                      %mi ϕ
                    %mo ≃
                    %msup
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %msub
                      %mo ×
                      %mrow
                        %mi X
                        %mo ′
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f^* im \Delta_\phi \simeq f^* (X \times_{X'} X)
                    \\,.
            %p
              Now using again the assumption that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^*
              is injective on subobjects, this implies
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi im
                    %msub
                      %mi Δ
                      %mi ϕ
                    %mo =
                    %mi X
                    %msub
                      %mo ×
                      %mrow
                        %mi X
                        %mo ′
                    %mi X
                  %annotation{:encoding => "application/x-tex"} im \Delta_\phi = X \times_{X'} X
              and hence that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              is a monomorphism.
            %p (…)
            %p
              The statement about the comonadic adjunction we discuss below as prop.
              = succeed "." do
                %a.maruku-ref{:href => "#Comonadicity"}
          %h2#properties Properties
          %h3#surjectionembedding_factorization Surjection/embedding factorization
          #CofreeAlgebraFunctorIsSurjective.num_prop
            %h6#observation Observation
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo :
                    %mi ℰ
                    %mo →
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} T : \mathcal{E} \to \mathcal{E}
              a
              %a.existingWikiWord{:href => "/nlab/show/left+exact+functor"} left exact
              %a.existingWikiWord{:href => "/nlab/show/comonad"} comonad
              the cofree algebra functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi ℰ
                    %mo →
                    %mi T
                    %mi CoAlg
                    %mo{:stretchy => "false"} (
                    %mi ℰ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    F : \mathcal{E} \to T CoAlg(\mathcal{E})
            %p
              to the
              %a.existingWikiWord{:href => "/nlab/show/topos+of+coalgebras"} topos of coalgebras
              is a geometric surjection.
          .proof
            %h6#proof_2 Proof
            %p
              By the discussion at
              %a.existingWikiWord{:href => "/nlab/show/topos+of+coalgebras"} topos of coalgebras
              the
              %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
              is the
              %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
              to the underlying
              = succeed "-objects." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/faithful+functor"} faithful functor
          #Comonadicity.num_prop
            %h6#proposition Proposition
            %p
              Up to
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence
          %p
            This appears for instance as (
            %a{:href => "#MacLaneMoerdijk"}> MacLaneMoerdijk, VII 4., prop 4
            ).
          .proof
            %h6#proof_3 Proof
            %p
              With observation
              %a.maruku-ref{:href => "#CofreeAlgebraFunctorIsSurjective"}
              we only need to show that if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi ℰ
                    %mo →
                    %mi ℱ
                  %annotation{:encoding => "application/x-tex"} f : \mathcal{E} \to \mathcal{F}
              is surjective, then there is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ℰ
                          %mtd
                            %mover
                              %mo →
                              %mi f
                          %mtd
                            %mi ℱ
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi F
                            %mo ↘
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ≃
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi T
                            %mi CoAlg
                            %mo{:stretchy => "false"} (
                            %mi ℰ
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathcal{E} &amp;\stackrel{f}{\to}&amp; \mathcal{F}
                    \\\
                    \&amp; {}_{\mathllap{F}}\searrow &amp; \downarrow^{\mathrlap{\simeq}}
                    \\\
                    \&amp;&amp; T CoAlg(\mathcal{E})
                    }
                    \\,.
            %p
              For this, take
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo :
                      %mo =
                      %msup
                        %mi f
                        %mo *
                      %msub
                        %mi f
                        %mo *
                    %annotation{:encoding => "application/x-tex"} T := f^* f_*
              %a.existingWikiWord{:href => "/nlab/show/left+exact+functor"} left exact functor
              by definition of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              and using the equivalent definition of def.
              %a.maruku-ref{:href => "#EquivalentDefinitions"}
              we have that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^*
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/conservative+functor"} conservative functor
              %a.existingWikiWord{:href => "/nlab/show/monadicity+theorem"} monadicity theorem
              are met, so so
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^*
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/monadic+functor"} comonadic functor
          %p
            For more on this see
            %em
              %a.existingWikiWord{:href => "/nlab/show/geometric+surjection%2Fembedding+factorization"} geometric surjection/embedding factorization
            \. Also at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/monadic+descent"} monadic descent
          %h2#examples Examples
          %p
            Trivially, any
            %a.existingWikiWord{:href => "/nlab/show/connected+geometric+morphism"} connected geometric morphism
            is surjective.
          .num_prop
            %h6#proposition_2 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f : X \to Y
              a
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              between
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological spaces
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi f
                      %mo *
                    %mo ⊣
                    %msub
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (f^* \dashv f_*) : Sh(X) \to Sh(Y)
              the corresponding geometric morphism of
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf toposes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is surjective then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi f
                      %mo *
                    %mo ⊣
                    %msub
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (f^* \dashv f_*)
              is a surjective geometric morphism, conversely, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi f
                      %mo *
                    %mo ⊣
                    %msub
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (f^* \dashv f_*)
              is a surjective geometric morphism and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              a
              = succeed "-space" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} T_1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is surjective.
          %p
            For a proof see e.g
            = succeed "," do
              %a{:href => "#MacLaneMoerdijk"} MacLane-Moerdijk
            %a.existingWikiWord{:href => "/nlab/show/geometric+embedding"} geometric embeddings
            but there
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mn 0
                %annotation{:encoding => "application/x-tex"} T_0
            suffices as a
            %a.existingWikiWord{:href => "/nlab/show/separation+axiom"} separation requirement
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
