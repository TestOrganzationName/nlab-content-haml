          %h2#definition Definition
          %p
            The
            %strong string group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi String
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} String(n)
            is defined to be, as a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological group
            %a.existingWikiWord{:href => "/nlab/show/Whitehead+tower"} 3-connected cover
            of the
            %a.existingWikiWord{:href => "/nlab/show/Spin+group"} Spin group
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spin(n)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
          %p
            Notice that for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} n\ge3
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spin
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Spin(n)
            itself is the
            %a.existingWikiWord{:href => "/nlab/show/Whitehead+tower"} simply connected cover
            of the
            %a.existingWikiWord{:href => "/nlab/show/special+orthogonal+group"} special orthogonal group
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SO
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SO(n)
            %a.existingWikiWord{:href => "/nlab/show/orthogonal+group"} orthogonal group
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} O(n)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi String
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} String(n)
            is one element in the
            %a.existingWikiWord{:href => "/nlab/show/Whitehead+tower"} Whitehead tower
            of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{O}(n)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ⋯
                  %mo →
                  %mi Fivebrane
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi String
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Spin
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi SO
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi{:mathvariant => "normal"} O
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\cdots \to Fivebrane(n) \to String(n) \to Spin(n) \to SO(n) \to \mathrm{O}(n)
                  \\,.
          %p
            The next higher connected group is called the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Fivebrane+group"} Fivebrane group
          %p
            The
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+group"} homotopy group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} O(n)
            are for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo ∈
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
            and for sufficiently large
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mi π
                            %mrow
                              %mn 8
                              %mi k
                              %mo +
                              %mn 0
                          %mo{:stretchy => "false"} (
                          %mi O
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo =
                          %msub
                            %mi ℤ
                            %mn 2
                      %mtr
                        %mtd
                          %msub
                            %mi π
                            %mrow
                              %mn 8
                              %mi k
                              %mo +
                              %mn 1
                          %mo{:stretchy => "false"} (
                          %mi O
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo =
                          %msub
                            %mi ℤ
                            %mn 2
                      %mtr
                        %mtd
                          %msub
                            %mi π
                            %mrow
                              %mn 8
                              %mi k
                              %mo +
                              %mn 2
                          %mo{:stretchy => "false"} (
                          %mi O
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo =
                          %mn 0
                      %mtr
                        %mtd
                          %msub
                            %mi π
                            %mrow
                              %mn 8
                              %mi k
                              %mo +
                              %mn 3
                          %mo{:stretchy => "false"} (
                          %mi O
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo =
                          %mi ℤ
                      %mtr
                        %mtd
                          %msub
                            %mi π
                            %mrow
                              %mn 8
                              %mi k
                              %mo +
                              %mn 4
                          %mo{:stretchy => "false"} (
                          %mi O
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo =
                          %mn 0
                      %mtr
                        %mtd
                          %msub
                            %mi π
                            %mrow
                              %mn 8
                              %mi k
                              %mo +
                              %mn 5
                          %mo{:stretchy => "false"} (
                          %mi O
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo =
                          %mn 0
                      %mtr
                        %mtd
                          %msub
                            %mi π
                            %mrow
                              %mn 8
                              %mi k
                              %mo +
                              %mn 6
                          %mo{:stretchy => "false"} (
                          %mi O
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo =
                          %mn 0
                      %mtr
                        %mtd
                          %msub
                            %mi π
                            %mrow
                              %mn 8
                              %mi k
                              %mo +
                              %mn 7
                          %mo{:stretchy => "false"} (
                          %mi O
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo =
                          %mi ℤ
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\pi_{8k+0}(O) &amp; = \mathbb{Z}_2
                  \\\
                  \\pi_{8k+1}(O) &amp; = \mathbb{Z}_2
                  \\\
                  \\pi_{8k+2}(O) &amp; = 0
                  \\\
                  \\pi_{8k+3}(O) &amp; = \mathbb{Z}
                  \\\
                  \\pi_{8k+4}(O) &amp; = 0
                  \\\
                  \\pi_{8k+5}(O) &amp; = 0
                  \\\
                  \\pi_{8k+6}(O) &amp; = 0
                  \\\
                  \\pi_{8k+7}(O) &amp; = \mathbb{Z}
                  }
                  \\,.
          %p
            By
            %a.existingWikiWord{:href => "/nlab/show/Whitehead+tower"} co-killing
            these groups step by step one gets
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi cokill
                          %mo ~
                          %mi this
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mi to
                          %mo ~
                          %mi get
                      %mtr
                        %mtd
                      %mtr
                        %mtd
                          %msub
                            %mi π
                            %mn 0
                          %mo{:stretchy => "false"} (
                          %mi O
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo =
                          %msub
                            %mi ℤ
                            %mn 2
                        %mtd
                        %mtd
                        %mtd
                          %mi SO
                      %mtr
                        %mtd
                          %msub
                            %mi π
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %mi O
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo =
                          %msub
                            %mi ℤ
                            %mn 2
                        %mtd
                        %mtd
                        %mtd
                          %mi Spin
                      %mtr
                        %mtd
                          %msub
                            %mi π
                            %mn 2
                          %mo{:stretchy => "false"} (
                          %mi O
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo =
                          %mn 0
                      %mtr
                        %mtd
                          %msub
                            %mi π
                            %mn 3
                          %mo{:stretchy => "false"} (
                          %mi O
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo =
                          %mi ℤ
                        %mtd
                        %mtd
                        %mtd
                          %mi String
                      %mtr
                        %mtd
                          %msub
                            %mi π
                            %mn 4
                          %mo{:stretchy => "false"} (
                          %mi O
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo =
                          %mn 0
                      %mtr
                        %mtd
                          %msub
                            %mi π
                            %mn 5
                          %mo{:stretchy => "false"} (
                          %mi O
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo =
                          %mn 0
                      %mtr
                        %mtd
                          %msub
                            %mi π
                            %mn 6
                          %mo{:stretchy => "false"} (
                          %mi O
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo =
                          %mn 0
                      %mtr
                        %mtd
                          %msub
                            %mi π
                            %mn 7
                          %mo{:stretchy => "false"} (
                          %mi O
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo =
                          %mi ℤ
                        %mtd
                        %mtd
                        %mtd
                          %mi Fivebrane
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  cokill~this &amp;&amp;&amp;&amp; to~get
                  \\\
                  \\\
                  \\pi_{0}(O) &amp; = \mathbb{Z}_2 &amp;&amp;&amp; SO
                  \\\
                  \\pi_{1}(O) &amp; = \mathbb{Z}_2 &amp;&amp;&amp; Spin
                  \\\
                  \\pi_{2}(O) &amp; = 0
                  \\\
                  \\pi_{3}(O) &amp; = \mathbb{Z} &amp;&amp;&amp; String
                  \\\
                  \\pi_{4}(O) &amp; = 0
                  \\\
                  \\pi_{5}(O) &amp; = 0
                  \\\
                  \\pi_{6}(O) &amp; = 0
                  \\\
                  \\pi_{7}(O) &amp; = \mathbb{Z} &amp;&amp;&amp; Fivebrane
                  }
                  \\,.
          %h2#definition_by_cokilling_of_
            Definition by co-killing of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 3
                %annotation{:encoding => "application/x-tex"} \pi_3
          %p More in detail this means the following.
          %p
            First notice that since by construction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mi i
                  %mo{:stretchy => "false"} (
                  %mi ℬ
                  %mi Spin
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} \pi_i(\mathcal{B}Spin(n)) = 0
            for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo ≤
                    %mi i
                    %mo ≤
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} 0 \leq i \leq 3
            %a.existingWikiWord{:href => "/nlab/show/Hurewicz+theorem"} Hurewicz theorem
            we have for the degree 4
            %a.existingWikiWord{:href => "/nlab/show/integral+cohomology"} integral cohomology
            group of the
            %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mi Spin
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B Spin(n)
            that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mn 4
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mi Spin
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi π
                    %mn 4
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mi Spin
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi ℤ
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  H^4(B Spin(n)) \simeq \pi_4(B Spin(n))
                  \\simeq
                  \\mathbb{Z}
                  \\,.
          %p
            The generator of this group is called the
            %strong fractional first Pontryagin class
            and denoted
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mn 1
                    %mn 2
                  %msub
                    %mi p
                    %mn 1
                  %mo :
                  %mi B
                  %mi Spin
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mi B
                    %mn 4
                  %mi ℤ
                  %mo ≃
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi ℤ
                  %mo ,
                  %mn 4
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\frac{1}{2}p_1 : B Spin(n) \to B^4 \mathbb{Z} \simeq K(\mathbb{Z},4)
          %p
            because the ordinary first
            %a.existingWikiWord{:href => "/nlab/show/Pontryagin+class"} Pontryagin class
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi p
                    %mn 1
                  %mo :
                  %mi ℬ
                  %mi SO
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi ℤ
                  %mo ,
                  %mn 4
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} p_1 : \mathcal{B} SO(n) \to K(\mathbb{Z},4)
            fits into a diagram
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi B
                          %mi Spin
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mfrac
                                %mn 1
                                %mn 2
                              %msub
                                %mi p
                                %mn 1
                        %mtd
                          %msup
                            %mi B
                            %mn 4
                          %mi ℤ
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mrow
                              %mo ⋅
                              %mn 2
                      %mtr
                        %mtd
                          %mi B
                          %mi SO
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mi p
                                %mn 1
                        %mtd
                          %msup
                            %mi B
                            %mn 4
                          %mi ℤ
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  B Spin(n) &amp;\stackrel{\frac{1}{2} p_1}{\to}&amp;
                  B^4 \mathbb{Z}
                  \\\
                  \\downarrow &amp;&amp; \downarrow^{\cdot 2}
                  \\\
                  B SO(n) &amp;\stackrel{p_1}{\to}&amp;
                  B^4 \mathbb{Z}
                  }
                  \\,,
          %p
            where the right vertical morphism comes from multiplication by 2 in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
          %p
            This says that
            %em after being pulled back
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℬ
                  %mi Spin
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{B} Spin(n)
            the first
            %a.existingWikiWord{:href => "/nlab/show/Pontryagin+class"} Pontryagin class
            is 2 times the generator of the degree 4
            %a.existingWikiWord{:href => "/nlab/show/integral+cohomology"} integral cohomology
            group of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℬ
                  %mi Spin
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{B}Spin(n)
            and hence that generator is called one half of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} p_1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mn 1
                    %mn 2
                  %msub
                    %mi p
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \frac{1}{2}p_1
            (by slight abuse of notation).
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            of the String-group as a
            %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological group
            is the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
            of this fractional Pontyagin class, i.e. the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi B
                          %mi String
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mo *
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi B
                          %mi Spin
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %msup
                            %mi ℬ
                            %mn 4
                          %mi ℤ
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  B String(n) &amp;\to&amp; {*}
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  B Spin(n) &amp;\to&amp; \mathcal{B}^4 \mathbb{Z}
                  }
          %p
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
          %p
            In other words:
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mi String
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B String(n)
            is the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(1)
            %a.existingWikiWord{:href => "/nlab/show/gerbe"} gerbe
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi B
                    %mn 2
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B^2 U(1)
            %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mi Spin
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B Spin(n)
            whose class is
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mn 1
                      %mn 2
                    %msub
                      %mi p
                      %mn 1
                    %mo ∈
                    %msup
                      %mi H
                      %mn 4
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mn 4
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \frac{1}{2}p_1 \in H^4(B Spin(n), 4)
          %h2#models Models
          %h3#as_a_topological_group As a topological group
          %p There is a model due to Stolz and Teichner in ‘What is an elliptic object?’…
          %h3#as_a_smooth_2group As a smooth 2-group
          %p
            While
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spin
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Spin(n)
            is not just a
            %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological group
            but a (finite dimensional)
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi String
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} String(n)
            cannot have the structure of a finite dimensional
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            %a.existingWikiWord{:href => "/nlab/show/homotopy+group"} homotopy group
            is nontrivial for every (finite dimensional) Lie group, while for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 3
                  %mo{:stretchy => "false"} (
                  %mi String
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} \pi_3(String(n)) = 0
            by the very definition of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi String
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} String(n)
          %p
            However, one can define an
            %em infinite-dimensional
            Lie group with the correct properties to be a model of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi String
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} String(n)
            (
            %a{:href => "#NikolausSachseWockel"}> Nikolaus-Sachse-Wockel 2013
            ).
          %p
            There are also smooth models of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi String
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} String(n)
            in the form of
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/2-group"} 2-group
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/string+2-group"} string 2-group
          %h2#role_in_string_theory Role in string theory
          %p
            The reason for the name is that in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/string+theory"} string theory
          %p
            See
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/String+structure"} String structure
          %p
            If one considers passing to the (free)
            %a.existingWikiWord{:href => "/nlab/show/loop+space"} loop space
            of spacetime and then doing
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quantum+mechanics"} quantum mechanics
          %h2#generalization_to_other_groups Generalization to other groups
          %p
            One may consider the universal 3-connected cover of any general
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/compact+space"} compact
            %a.existingWikiWord{:href => "/nlab/show/simple+Lie+group"} simple
            and
            %a.existingWikiWord{:href => "/nlab/show/simply+connected+space"} simply connected
            %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo =
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G = Spin(n)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi String
                      %mi G
                  %annotation{:encoding => "application/x-tex"} String_G
          %p
            Of these the case
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo =
                %annotation{:encoding => "application/x-tex"} G =
            %a.existingWikiWord{:href => "/nlab/show/E8"} E8
            is the other one relevant in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/string+theory"} string theory
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Green-Schwarz+mechanism"} Green-Schwarz mechanism
          %h2#related_concepts Related concepts
          %p
