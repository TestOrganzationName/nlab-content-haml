              be a covering space. Consider the
              %a.existingWikiWord{:href => "/nlab/show/fiber+product"} fiber product
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %msub
                      %mo ×
                      %mi X
                    %mi E
                    %mo ≔
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi e
                      %mn 1
                    %mo ,
                    %msub
                      %mi e
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi E
                    %mo ×
                    %mi E
