                %em Type Theory, Homotopy Theory and Univalent Foundations
                (2013)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                    %annotation{:encoding => "application/x-tex"} [
                %a{:href => "https://doi.org/10.1007/978-3-319-21284-5_15"} doi:10.1007/978-3-319-21284-5_15
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
