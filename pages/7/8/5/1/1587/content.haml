                    %annotation{:encoding => "application/x-tex"} U'_{p(e)}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %msub
                      %mo ×
                      %mi X
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ∩
                    %mo{:stretchy => "false"} (
                    %mi U
                    %msub
                      %mo ′
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} (
                        %mi e
                        %mo{:stretchy => "false"} )
                    %mo ×
                    %mi U
                    %msub
                      %mo ′
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} (
                        %mi e
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi Δ
