            %p
              is an open neighbourhood of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (e,e)
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %msub
                        %mo ×
                        %mi X
