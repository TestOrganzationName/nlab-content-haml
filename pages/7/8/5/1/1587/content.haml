                    %msub
                      %mi e
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"}
                    E \times_X E \coloneqq \{ (e_1, e_2) \in E \times E \;\vert\; p(e_1) = p(e_2) \}
            %p
              hence (by the discussion at
              = succeed ")" do
                %a{:href => "Top#UniversalConstructions"} Top - Univeral constructions
              %a.existingWikiWord{:href => "/nlab/show/topological+subspace"} topological subspace
              of the
              %a.existingWikiWord{:href => "/nlab/show/product+space"} product space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mo ×
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E \times E
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/fiber+product"} fiber product
