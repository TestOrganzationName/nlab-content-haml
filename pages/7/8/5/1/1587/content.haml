            %p
              It follows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} (
                        %mi e
                        %mo{:stretchy => "false"} )
                    %mo ×
                    %mo{:stretchy => "false"} {
                    %mi e
                    %mo{:stretchy => "false"} }
                    %mo ≅
                    %mi U
                    %msub
                      %mo ′
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} (
                        %mi e
                        %mo{:stretchy => "false"} )
