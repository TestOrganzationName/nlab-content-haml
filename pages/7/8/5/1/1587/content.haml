                                %mo{:stretchy => "false"} )
                            %mo ×
                            %mi Disc
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi p
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
