            %p is a union of open sets, and hence itself open.
          #CoveringSpaceFiberwiseDiagonalOpenAndClosed.num_lemma
            %h6#lemma Lemma
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/fiber+product"} fiber-wise
                %a.existingWikiWord{:href => "/nlab/show/diagonal"} diagonal
                of covering space is
                %a.existingWikiWord{:href => "/nlab/show/open+subset"} open
                and
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/closed+subset"} closed
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
