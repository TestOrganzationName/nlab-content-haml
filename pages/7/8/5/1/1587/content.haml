                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi pr
                                    %mn 2
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    E &amp;&amp; \overset{\simeq}{\longrightarrow} &amp;&amp; X \times Disc(S)
                    \\\
                    \&amp; {}_{\mathllap{p}}\searrow &amp;&amp; \swarrow_{\mathrlap{pr_2}}
                    \\\
                    \&amp;&amp; X
                    }
            %p
              is called a
              %em trivialization
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mover
                        %mo →
                        %mi p
                      %mi X
                    %annotation{:encoding => "application/x-tex"} E \overset{p}{\to} X
            %p
              It is in this sense that every covering space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is, by definition, locally trivializable.
          #nSphereCoveringOverRealProjectiveSpace.num_example
            %h6#example_5 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/n-sphere"} n-sphere
                covering over
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/real+projective+space"} real projective space
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              the canonical projection
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                    %mo ⟶
                    %mi ℝ
                    %msup
                      %mi P
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    S^n \longrightarrow \mathbb{R}P^n
            %p
              from the
              %a.existingWikiWord{:href => "/nlab/show/n-sphere"} n-sphere
              to the
              %a.existingWikiWord{:href => "/nlab/show/real+projective+space"} real projective space
              of
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              is a covering space projection. See
              = succeed "." do
                %a{:href => "real+projective+space#nSphereAsCoveringSpaceOverRealProjectiveSpace"} this prop.
          %h3#HomotopyFibs Universal covering space in terms of homotopy fibers
          %p
            We want to describe here how the universal covering space of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
            of the canonical morphism
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %msub
                      %mi Π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \to \Pi_1(X)
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi_1(X)
            %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            classified by this
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
          %p
            We place ourselves in the context of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/topological+%E2%88%9E-groupoid"} topological ∞-groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            as well as its
            %a.existingWikiWord{:href => "/schreiber/show/path+%E2%88%9E-groupoid"} path ∞-groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Pi(X)
            and its truncation to the
            %a.existingWikiWord{:href => "/nlab/show/fundamental+groupoid"} fundamental groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Pi_1(X)
            as objects in there.
          %p
            The canonical morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X \to \Pi(X)
            hence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %msub
                    %mi Π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X \to \Pi_1(X)
            given by the inclusion of contant paths may be regarded as a
            %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
            for a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi(X)
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
            = succeed "-principal" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi_1(X)
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi_0(X)
            be the set of connected components of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "-groupoid," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/section"} section
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi_0(X) \to \Pi(X)
            of the projection
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi(X) \to \pi_0(X)
          %p
            Then the
            = succeed "-principal" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi(X)
            = succeed "-bundle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X \to \Pi(X)
            is its
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
            %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi UCov
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %msub
                            %mi π
                            %mn 0
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %mo →
                        %mtd
                          %mi Π
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  UCov(X) &amp;\to&amp; \pi_0(X)
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  X &amp;\to&amp; \Pi(X)
                  }
                  \\,.
          %p
            We think of this topological
            = succeed "-groupoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi UCov
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} UCov(X)
            as the
            %strong
              universal covering
              = succeed "-groupoid" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/decategorification"} decategorification
            gives the ordinary universal covering space:
          %p
            for this we compute the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mi UCov
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mo *
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi x
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %mo →
                        %mtd
                          %msub
                            %mi Π
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  UCov_1(X) &amp;\to&amp; {*}
                  \\\
                  \\downarrow &amp;&amp; \downarrow^{\mathrlap{x}}
                  \\\
                  X &amp;\to&amp; \Pi_1(X)
                  }
                  \\,,
          %p
            where we assume
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to be connected with chosen basepoint
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            just to shorten the exposition a little. By the laws of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
            %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
            of a weakly equivalent diagram, where the point
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                %annotation{:encoding => "application/x-tex"} *
            is resolved to the
            %a.existingWikiWord{:href => "/nlab/show/generalized+universal+bundle"} universal
            = succeed "-principal" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi_1(X)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi E
                    %mi x
                  %msub
                    %mi Π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi T
                    %mi x
                  %msub
                    %mi Π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{E}_x \Pi_1(X) = T_x \Pi_1(X)
                  \\,.
          %blockquote
            %p
              (More in detail, what we do behind the scenes is this: we regard the diagram as a diagram in the
              %em global
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
              on
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi E
                      %mi x
                    %msub
                      %mi Π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{E}_x \Pi_1(X)
              achieves. Then the ordinary pullback in the category of simplicial presheaves is the homotopy pullback in
              = succeed "-prestacks." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              = succeed "-stackification," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              = succeed "-stacks" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
          %p
            The topological groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi E
                    %mi x
                  %msub
                    %mi Π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{E}_x \Pi_1(X)
            has as objects homotopy classes rel endpoints of paths in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            starting at
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            and as morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi κ
                  %mo :
                  %mi γ
                  %mo →
                  %mi γ
                  %mo ′
                %annotation{:encoding => "application/x-tex"} \kappa : \gamma \to \gamma'
            it has commuting triangles
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi x
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi γ
                          %mo ↙
                        %mtd
                        %mtd
                          %msup
                            %mo ↘
                            %mpadded{:width => "0"}
                              %mrow
                                %mi γ
                                %mo ′
                      %mtr
                        %mtd
                          %mi y
                        %mtd
                        %mtd
                          %mover
                            %mo →
                            %mi κ
                        %mtd
                        %mtd
                          %mi y
                          %mo ′
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; x
                  \\\
                  \&amp;{}^{\mathllap{\gamma}}\swarrow &amp;&amp; \searrow^{\mathrlap{\gamma'}}
                  \\\
                  y &amp;&amp;\stackrel{\kappa}{\to}&amp;&amp; y'
                  }
          %p
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi_1(X)
            %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi E
                            %mi x
                          %msub
                            %mi Π
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mo *
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi x
                      %mtr
                        %mtd
                          %msub
                            %mi Π
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %mi X
                          %msup
                            %mo{:stretchy => "false"} )
                            %mi I
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mi d
                                %mn 0
                        %mtd
                          %msub
                            %mi Π
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\mathbf{E}_x \Pi_1(X) &amp;\to&amp; {*}
                  \\\
                  \\downarrow &amp;&amp; \downarrow^{\mathrlap{x}}
                  \\\
                  \\Pi_1(X)^I &amp;\stackrel{d_0}{\to}&amp; \Pi_1(X)
                  }
          %p
            in simplicial presheaves on
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Mor
                  %mo{:stretchy => "false"} (
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi E
                    %mi x
                  %msub
                    %mi Π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Mor(\mathbf{E}_x \Pi_1(X))
            are those where the endpoint evaluation produces an open set in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p Now it is immediate to read off the homotopy pullback as the ordinary pullback
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mi UCov
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi E
                            %mi x
                          %msub
                            %mi Π
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %mo →
                        %mtd
                          %msub
                            %mi Π
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thinmathspace"}
                          %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  UCov_1(X) &amp;\to&amp; \mathbf{E}_x \Pi_1(X)
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  X &amp;\to&amp; \Pi_1(X)
                  \\,.
                  }
          %p
            Since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is categorically discrete, this simply produces the space of objects of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi E
                    %mi x
                  %msub
                    %mi Π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{E}_x \Pi_1(X)
            over the points of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            starting at
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            with the projection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi UCov
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} UCov_1(X) \to X
            being endpoint evaluation.
          %p
            This indeed is then the usual construction of the universal covering space in terms of paths, as described for instance in (
            %a{:href => "#Dahlke"}> Dahlke
            )
