                    %mo{:stretchy => "false"} (
                    %msub
                      %mi e
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi p
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi e
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p(e_1) = p(e_2)
              has an open neighbourhood in this complement.
            %p
              As before, there is an open neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U \subset X
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi e
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi p
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi e
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p(e_1) = p(e_2)
              over which the cover trivializes, and hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ×
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi e
                      %mn 1
                    %mo{:stretchy => "false"} }
                    %mo ,
                    %mi U
                    %mo ×
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi e
                      %mn 2
                    %mo{:stretchy => "false"} }
                    %mo ⊂
                    %mi U
                    %mo ×
                    %mi Disc
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi p
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi e
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mi E
                  %annotation{:encoding => "application/x-tex"} U \times \{e_1\}, U \times \{e_2\} \subset U \times Disc(p^{-1}(p(e_1))) \cong E
              are open neighbourhoods of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi e
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} e_1
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi e
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} e_2
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi e
                        %mn 1
                      %mo ≠
                      %msub
                        %mi e
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} e_1 \neq e_2
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %msub
                      %mo ×
                      %mi X
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ∩
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi e
                      %mn 1
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi e
                      %mn 2
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mo{:stretchy => "false"} (
                    %mi E
                    %msub
                      %mo ×
                      %mi X
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ∖
                    %mi Δ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (E \times_X E) \cap ( (U \times \{e_1\}) \times (U \times \{e_2\}) )
                    \\subset
                    (E \times_X E) \setminus \Delta(E)
            %p is an open subset of the complement of the diagonal in the fiber product.
          %h3#relation_to_etale_spaces Relation to etale spaces
          %p
            Every covering space (even in the more general sense not requiring any connectedness axiom) is an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/etale+space"} etale space
          %ul
            %li
              %p
                for a covering space the inverse image of some open set in the base
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
                needs to be, by the definition, a disjoint union of homeomorphic open sets in
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi e
                    %annotation{:encoding => "application/x-tex"} e
                in the same stalk required in the definition of étalé space may differ, hence the intersection of their projections does not need to be an open set, if there are infinitely many points in the stalk.
            %li
              %p
                even if the stalks of the etale space are finite, it need not be locally trivial. For instance the disjoint union
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                        %mi i
                      %mi Ui
                    %annotation{:encoding => "application/x-tex"} \coprod_i Ui
                of a collection of open subsets of a space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                with the obvious projection
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                        %mi i
                      %msub
                        %mi U
                        %mi i
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} (\coprod_i U_i) \to X
                is etale, but does not have a typical fiber: the fiber over a given point has cardinality the number of open sets
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi i
                    %annotation{:encoding => "application/x-tex"} U_i
                that contain this particular point.
          %h3#LiftingProperties Lifting properties
          %p
            We discuss
            %a.existingWikiWord{:href => "/nlab/show/left+lifting+properties"} left lifting properties
            satisfied by covering spaces.
          %ol
            %li
              %p
                %a{:href => "#CoveringSpacePathLifting"}> path-lifting property
                ,
            %li
              %p
                %a{:href => "#HomotopyLiftingPropertyOfCoveringSpaces"}> homotopy-lifting propery
                ,
            %li
              %p
                the
                = succeed "." do
                  %a{:href => "#TheTheoremLifting"} lifting theorem
          #LiftsOverConnectedSpaceIntoCoveringSpaceAreUniqueRelativePoint.num_lemma
            %h6#lemma_2 Lemma
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/lifts"} lifts
                out of
                %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected space
                into
                %a.existingWikiWord{:href => "/nlab/show/covering+spaces"} covering spaces
                are unique relative to any point)
            %p Let
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                        %mover
                          %mo →
                          %mi p
                        %mi X
                      %annotation{:encoding => "application/x-tex"} E \overset{p}{\to} X
                  be a covering space,
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} Y
                  a
                  %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected topological space
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi Y
                        %mo ⟶
                        %mi X
                      %annotation{:encoding => "application/x-tex"} f \;\colon\; Y \longrightarrow X
                  a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mover
                            %mi f
                            %mo{:stretchy => "false"} ^
                          %mn 1
                        %mo ,
                        %msub
                          %mover
                            %mi f
                            %mo{:stretchy => "false"} ^
                          %mn 2
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi Y
                        %mo ⟶
                        %mi E
                      %annotation{:encoding => "application/x-tex"} \hat f_1, \hat f_2 \;\colon\; Y \longrightarrow E
                  two
                  %a.existingWikiWord{:href => "/nlab/show/lifts"} lifts
                  of
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                        %annotation{:encoding => "application/x-tex"} f
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} diagram commutes
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %mi E
                            %mtr
                              %mtd
                              %mtd
                                %msup
                                  %mrow
                                  %mpadded{:lspace => "-100%width", :width => "0"}
                                    %mrow
                                      %msub
                                        %mover
                                          %mi f
                                          %mo{:stretchy => "false"} ^
                                        %mi i
                                %mo ↗
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↓
                                  %mpadded{:width => "0"}
                                    %mi p
                            %mtr
                              %mtd
                                %mi Y
                              %mtd
                                %munder
                                  %mo ⟶
                                  %mi f
                              %mtd
                                %mi X
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        \&amp;&amp; E
                        \\\
                        \&amp; {}^{\mathllap{\hat f_i}}\nearrow &amp; \downarrow^{\mathrlap{p}}
                        \\\
                        Y &amp;\underset{f}{\longrightarrow}&amp; X
                        }
                %p
                  for
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi i
                          %mo ∈
                          %mo{:stretchy => "false"} {
                          %mn 1
                          %mo ,
                          %mn 2
                          %mo{:stretchy => "false"} }
                        %annotation{:encoding => "application/x-tex"} i \in \{1,2\}
            %p
              If there exists
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ∈
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} y \in Y
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ^
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ^
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \hat f_1(y) = \hat f_2(y)
              then the two lifts already agree everywhere:
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mover
                          %mi f
                          %mo{:stretchy => "false"} ^
                        %mn 1
                      %mo =
                      %msub
                        %mover
                          %mi f
                          %mo{:stretchy => "false"} ^
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \hat f_1 = \hat f_2
          .proof
            %h6#proof_3 Proof
            %p
              By the
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              of the
              %a.existingWikiWord{:href => "/nlab/show/fiber+product"} fiber product
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %msub
                      %mo ×
                      %mi X
                    %mi E
                    %mo ≔
                    %mrow
                      %mo {
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi e
                        %mn 1
                      %mo ,
                      %msub
                        %mi e
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi E
                      %mo ×
                      %mi E
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thickmathspace"}
                      %mi p
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi e
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi p
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi e
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo }
                    %mo ⊂
                    %mi E
                    %mo ×
                    %mi E
                  %annotation{:encoding => "application/x-tex"}
                    E \times_X E \coloneqq \left\{ (e_1, e_2) \in E \times E \;\vert\; p(e_1) = p(e_2) \right\} \subset E \times E
            %p the two lifts determine a single continuous function of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ^
                      %mn 1
                    %mo ,
                    %msub
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ^
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Y
                    %mo ⟶
                    %mi E
                    %msub
                      %mo ×
                      %mi X
                    %mi E
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\hat f_1, \hat f_2)
                    \\;\colon\;
                    Y \longrightarrow E \times_X E
                    \\,.
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mrow
                      %mo {
                      %mo{:stretchy => "false"} (
                      %mi e
                      %mo ,
                      %mi e
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi E
                      %msub
                        %mo ×
                        %mi X
                      %mi E
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thickmathspace"}
                      %mi e
                      %mo ∈
                      %mi E
                      %mo }
                  %annotation{:encoding => "application/x-tex"}
                    \\Delta(E)  \coloneqq \left\{ (e,e) \in E \times_X E \;\vert\; e \in E  \right\}
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/diagonal"} diagonal
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              in the fiber product. By lemma
              %a.maruku-ref{:href => "#CoveringSpaceFiberwiseDiagonalOpenAndClosed"}
              this is an open subset and a closed subset of the fiber product space. Hence by continuity of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ^
                      %mn 1
                    %mo ,
                    %msub
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ^
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\hat f_1, \hat f_2)
              also its pre-image
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ^
                      %mn 1
                    %mo ,
                    %msub
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ^
                      %mn 2
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Δ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    (\hat f_1, \hat f_2)^{-1}(\Delta(E)) \subset Y
            %p
              is both closed and open, hence also its
              %a.existingWikiWord{:href => "/nlab/show/complement"} complement
              is open in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
            %p
              Moreover, the assumption that the functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ^
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \hat f_1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ^
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \hat f_2
              agree in at least one point means that the above pre-image is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/inhabited+set"} non-empty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              is
              %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected
              implies that this pre-image coincides with all of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
          #CoveringSpacePathLifting.num_lemma
            %h6#lemma_3 Lemma
            %p
              %strong (path lifting property)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %mi E
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} p \colon E \to X
              be any
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/covering+space"} covering space
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi γ
                        %mo{:lspace => "verythinmathspace"} :
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} ]
                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} \gamma \colon [0,1] \to X
                  a
                  %a.existingWikiWord{:href => "/nlab/show/path"} path
                  in
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mover
                            %mi x
                            %mo{:stretchy => "false"} ^
                          %mn 0
                        %mo ∈
                        %mi E
                      %annotation{:encoding => "application/x-tex"} \hat x_0 \in E
                  be a lift of its starting point, hence such that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} (
                        %msub
                          %mover
                            %mi x
                            %mo{:stretchy => "false"} ^
                          %mn 0
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi γ
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} p(\hat x_0) = \gamma(0)
            %p
              then there exists a unique path
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi γ
                      %mo{:stretchy => "false"} ^
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi E
                  %annotation{:encoding => "application/x-tex"} \hat \gamma \colon [0,1] \to E
              such that
            %ol
              %li
                %p
                  it is a lift of the original path:
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi p
                          %mo ∘
                          %mover
                            %mi γ
                            %mo{:stretchy => "false"} ^
                          %mo =
                          %mi γ
                        %annotation{:encoding => "application/x-tex"} p \circ \hat \gamma = \gamma
              %li
                %p
                  it starts at the given lifted point:
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mover
                            %mi γ
                            %mo{:stretchy => "false"} ^
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo{:stretchy => "false"} )
                          %mo =
                          %msub
                            %mover
                              %mi x
                              %mo{:stretchy => "false"} ^
                            %mn 0
                        %annotation{:encoding => "application/x-tex"} \hat \gamma(0) = \hat x_0
            %p
              In other words, every
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
              in
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} {
                            %mn 0
                            %mo{:stretchy => "false"} }
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mover
                                    %mi x
                                    %mo{:stretchy => "false"} ^
                                  %mn 0
                          %mtd
                            %mi E
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi p
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %munder
                              %mo ⟶
                              %mi γ
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\{0\} &amp;\overset{\hat x_0}{\longrightarrow}&amp; E
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{p}}
                    \\\
                    [0,1] &amp;\underset{\gamma}{\longrightarrow}&amp; X
                    }
            %p
              has a unique
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/lift"} lift
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} {
                            %mn 0
                            %mo{:stretchy => "false"} }
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mover
                                    %mi x
                                    %mo{:stretchy => "false"} ^
                                  %mn 0
                          %mtd
                            %mi E
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mover
                                  %mi γ
                                  %mo{:stretchy => "false"} ^
                            %mo ↗
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi p
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %munder
                              %mo ⟶
                              %mi γ
                          %mtd
                            %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\{0\} &amp;\overset{\hat x_0}{\longrightarrow}&amp; E
                    \\\
                    \\downarrow
                    \&amp;{}^{\mathllap{\hat \gamma}}\nearrow&amp;
                    \\downarrow^{\mathrlap{p}}
                    \\\
                    [0,1] &amp;\underset{\gamma}{\longrightarrow}&amp; X
                    }
                    \\,.
          .proof
            %h6#proof_4 Proof
            %p
              First consider the case that the covering space is trival, hence of the
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
              form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi pr
                      %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ×
                    %mi Disc
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    pr_1 \;\colon\;  X \times Disc(S) \longrightarrow X
                    \\,.
            %p
              By the
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              of the
              %a.existingWikiWord{:href => "/nlab/show/product+topological+spaces"} product topological spaces
              in this case a lift
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi γ
                      %mo{:stretchy => "false"} ^
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi X
                    %mo ×
                    %mi Disc
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \hat \gamma \colon [0,1] \to X \times Disc(S)
              is equivalently a
              %a.existingWikiWord{:href => "/nlab/show/pair"} pair
              of continuous functions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi pr
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi γ
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi X
                    %mphantom
                      %mi AAAA
                    %msub
                      %mi pr
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi γ
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi Disc
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    pr_1(\hat \gamma) \colon [0,1] \to X  \phantom{AAAA} pr_2(\hat \gamma) \colon [0,1] \to Disc(S)
                    \\,,
            %p
              Now the lifting condition explicitly fixes
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi pr
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mover
                        %mi γ
                        %mo{:stretchy => "false"} ^
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi γ
                    %annotation{:encoding => "application/x-tex"} pr_1(\hat \gamma) = \gamma
              %a.existingWikiWord{:href => "/nlab/show/discrete+topological+space"} discrete topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Disc(S)
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/locally+constant+function"} locally constant
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [0,1]
              is a
              %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected topological space
              this means that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi pr
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi γ
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} pr_2(\hat \gamma)
              is in fact a
              %a.existingWikiWord{:href => "/nlab/show/constant+function"} constant function
              (
              %a{:href => "connected+space#LocallyConstantFunctionsOnConnectedSpaces"}> this example
              ), hence uniquely fixed to be
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi pr
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %mover
                        %mi γ
                        %mo{:stretchy => "false"} ^
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mover
                          %mi x
                          %mo{:stretchy => "false"} ^
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} pr_2(\hat \gamma) = \hat x_0
            %p This shows the statement for the case of trivial covering spaces.
            %p
              Now consider any covering space
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo{:lspace => "verythinmathspace"} :
                      %mi E
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} p \colon E \to X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              a
              %a.existingWikiWord{:href => "/nlab/show/open+neighbourhood"} open neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U_x \subset X
              such that the restriction of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                  %annotation{:encoding => "application/x-tex"} U_x
              becomes a trivial covering space:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi p
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi U
                      %mi x
                    %mo ×
                    %mi Disc
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi p
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    p^{-1}(U_x) \simeq U_x \times Disc(p^{-1}(x))
                    \\,.
            %p Consider such a choice
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi x
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi x
                        %mo ∈
                        %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\{U_x \subset X\}_{x \in X}
                    \\,.
            %p
              This is an
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/pre-images"} pre-images
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo {
                        %msup
                          %mi γ
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi U
                          %mi x
                        %mo{:stretchy => "false"} )
                        %mo ⊂
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} ]
                        %mo }
                      %mrow
                        %mi x
                        %mo ∈
                        %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{
                    \\gamma^{-1}(U_x)
                    \\subset
                    [0,1]
                    \\right\}_{x \in X}
            %p
              constitute an open cover of the
              %a.existingWikiWord{:href => "/nlab/show/topological+interval"} topological interval
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [0,1]
            %p
              Now the
              %a.existingWikiWord{:href => "/nlab/show/closed+interval"} closed interval
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact topological space
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
            %p
              This means that we find a
              %a.existingWikiWord{:href => "/nlab/show/finite+number"} finite number
              of points
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi t
                      %mn 0
                    %mo &lt;
                    %msub
                      %mi t
                      %mn 1
                    %mo &lt;
                    %mi ⋯
                    %msub
                      %mo &lt;
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    t_0 \lt t_1 \lt \cdots \lt_{n+1} \in [0,1]
            %p
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi t
                      %mn 0
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} t_0 = 0
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi t
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} t_{n+1} = 1
              such that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo &lt;
                    %mi j
                    %mo ≤
                    %mi n
                  %annotation{:encoding => "application/x-tex"} 0 \lt j \leq n
              there is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mi j
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x_j \in X
              such that the corresponding path segment
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi t
                      %mi j
                    %mo ,
                    %msub
                      %mi t
                      %mrow
                        %mi j
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\gamma([t_j, t_{j+1}]) \subset X
            %p
              is contained in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mrow
                        %msub
                          %mi x
                          %mi j
                  %annotation{:encoding => "application/x-tex"} U_{x_j}
              from above.
            %p
              Now assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi γ
                      %mo{:stretchy => "false"} ^
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %msub
                          %mi t
                          %mi j
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \hat \gamma\vert_{[0,t_j]}
              has been found. Then by the triviality of the covering space over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mrow
                        %msub
                          %mi x
                          %mi j
                  %annotation{:encoding => "application/x-tex"} U_{x_j}
              and the first argument above, there is a unique lift of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi t
                          %mi j
                        %mo ,
                        %msub
                          %mi t
                          %mrow
                            %mi j
                            %mo +
                            %mn 1
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \gamma\vert_{[t_j, t_{j+1}]}
              to a continuous function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi γ
                      %mo{:stretchy => "false"} ^
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi t
                          %mi j
                        %mo ,
                        %msub
                          %mi t
                          %mrow
                            %mi j
                            %mo +
                            %mn 1
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \hat \gamma|_{[t_j,t_{j+1}]}
              with starting point
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi γ
                        %mo{:stretchy => "false"} ^
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi t
                        %mi j
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \hat \gamma(t_j)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %msub
                      %mi t
                      %mrow
                        %mi j
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [0,t_{j+1}]
              is the
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %msub
                      %mi t
                      %mi j
                    %mo{:stretchy => "false"} ]
                    %munder
                      %mo ⊔
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi t
                          %mi j
                        %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi t
                      %mi j
                    %mo ,
                    %msub
                      %mi t
                      %mrow
                        %mi j
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [0,t_j] \underset{\{t_j\}}{\sqcup} [t_j,t_{j+1}]
              (
              %a{:href => "Top#TopologicalnSphereIsPushoutOfBoundaryOfnBallInclusionAlongItself"}> this example
              ), it follows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi γ
                      %mo{:stretchy => "false"} ^
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %msub
                          %mi t
                          %mi j
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \hat \gamma|_{[0,t_j]}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi γ
                      %mo{:stretchy => "false"} ^
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi t
                          %mi j
                        %mo ,
                        %msub
                          %mi t
                          %mrow
                            %mi j
                            %mo +
                            %mn 1
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \hat \gamma\vert_{[t_j,t_{j+1}]}
              uniquely glue to a continuous function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi γ
                      %mo{:stretchy => "false"} ^
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %msub
                          %mi t
                          %mrow
                            %mi j
                            %mo +
                            %mn 1
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \hat \gamma\vert_{[0,t_{j+1}]}
              which lifts
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi γ
                      %msub
                        %mo{:stretchy => "false"} |
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mn 0
                          %mo ,
                          %msub
                            %mi t
                            %mrow
                              %mi j
                              %mo +
                              %mn 1
                          %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \gamma\vert_{[0,t_{j+1}]}
            %p
              By
              %a.existingWikiWord{:href => "/nlab/show/induction"} induction
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                    %annotation{:encoding => "application/x-tex"} j
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi γ
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} \hat \gamma
            %p
              Conversely, given any lift,
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi γ
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} \hat \gamma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi γ
                      %mo{:stretchy => "false"} ^
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi t
                          %mi j
                        %mo ,
                        %msub
                          %mi t
                          %mrow
                            %mi j
                            %mo +
                            %mn 1
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \hat \gamma\vert_{[t_j, t_{j+1}]}
              are uniquely fixed by the above inductive argument. Therefore also the total lift is unique. Altrnatively, uniqueness of the lifts is a special case of lemma
              = succeed "." do
                %a.maruku-ref{:href => "#LiftsOverConnectedSpaceIntoCoveringSpaceAreUniqueRelativePoint"}
          #HomotopyLiftingPropertyOfCoveringSpaces.num_prop
            %h6#proposition_2 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/homotopy+lifting+property"} homotopy lifting property
                of
                %a.existingWikiWord{:href => "/nlab/show/covering+spaces"} covering spaces
                against
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/locally+connected+topological+spaces"} locally connected spaces
            %p Let
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                        %mover
                          %mo →
                          %mi p
                        %mi X
                      %annotation{:encoding => "application/x-tex"} E \overset{p}{\to} X
                  be a covering space;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} Y
                  a topological space.
            %p
              Then every
              %a.existingWikiWord{:href => "/nlab/show/lifting+problem"} lifting problem
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Y
                          %mtd
                            %mover
                              %mo ⟶
                              %mover
                                %mi f
                                %mo{:stretchy => "false"} ^
                          %mtd
                            %mi E
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi id
                                    %mi y
                                  %mo ,
                                  %msub
                                    %mi const
                                    %mn 0
                                  %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi p
                        %mtr
                          %mtd
                            %mi Y
                            %mo ×
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %munder
                              %mo ⟶
                              %mi η
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Y &amp;\overset{\hat f}{\longrightarrow}&amp; E
                    \\\
                    {}^{\mathllap{ (id_y, const_0)}}\downarrow &amp;&amp; \downarrow^{\mathrlap{p}}
                    \\\
                    Y \times [0,1] &amp;\underset{\eta}{\longrightarrow}&amp; X
                    }
            %p
              has a unique
              %a.existingWikiWord{:href => "/nlab/show/lift"} lift
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Y
                          %mtd
                            %mover
                              %mo ⟶
                              %mover
                                %mi f
                                %mo{:stretchy => "false"} ^
                          %mtd
                            %mi E
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi id
                                    %mi y
                                  %mo ,
                                  %msub
                                    %mi const
                                    %mn 0
                                  %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mover
                                  %mi η
                                  %mo{:stretchy => "false"} ^
                            %mo ↗
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi p
                        %mtr
                          %mtd
                            %mi Y
                            %mo ×
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %munder
                              %mo ⟶
                              %mi η
                          %mtd
                            %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Y &amp;\overset{\hat f}{\longrightarrow}&amp; E
                    \\\
                    {}^{\mathllap{ (id_y, const_0)}}\downarrow
                    \&amp;{}^{\mathllap{\hat \eta}}\nearrow&amp;
                    \\downarrow^{\mathrlap{p}}
                    \\\
                    Y \times [0,1] &amp;\underset{\eta}{\longrightarrow}&amp; X
                    }
                    \\,.
          .proof
            %h6#proof_5 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{U_i \subset X\}_{i \in I}
              be an open cover over which the covering space trivializes. Then the pre-images
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi η
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi Y
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{\eta^{-1}(U_i) \subset Y \times [0,1]\}_{i \in I}
              is an open cover of the product space. By nature of the
              %a.existingWikiWord{:href => "/nlab/show/product+space"} product space topology
              and the
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+topology"} Euclidean topology
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [0,1]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi η
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \eta^{-1}(U_i)
              is a union of Cartesian products
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi j
                    %mo ×
                    %msub
                      %mi I
                      %mi j
                  %annotation{:encoding => "application/x-tex"} V_j \times I_j
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi i
                    %mo ⊂
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} V_i \subset Y
              an open subset of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi I
                      %mi i
                    %mo ⊂
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} I_i \subset [0,1]
              an interval. Hence there is an open cover of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi V
                      %mi j
                    %mo ×
                    %msub
                      %mi I
                      %mi j
                    %mo ⊂
                    %mi Y
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi j
                        %mo ∈
                        %mi J
                  %annotation{:encoding => "application/x-tex"}
                    \\{
                    V_j \times I_j \subset Y \times [0,1]
                    \\}_{j \in J}
            %p
              with the property that for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
              there exists
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} i \in I
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi V
                        %mi j
                      %mo ×
                      %msub
                        %mi I
                        %mi j
                      %mo{:stretchy => "false"} )
                      %mo ⊂
                      %msub
                        %mi U
                        %mi i
                    %annotation{:encoding => "application/x-tex"} \eta(V_j \times I_j) \subset U_i
            %p
              Now by the fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [0,1]
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ∈
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} y \in Y
              there exists a finite set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mi y
                    %mo ⊂
                    %mi J
                  %annotation{:encoding => "application/x-tex"} K_y \subset J
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi V
                      %mi k
                    %mo ×
                    %msub
                      %mi I
                      %mi k
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi k
                        %mo ∈
                        %msub
                          %mi K
                          %mi y
                        %mo ⊂
                        %mi K
                  %annotation{:encoding => "application/x-tex"}
                    \\{ V_k \times I_k \}_{k \in K_y \subset K}
            %p
              still restricts to a cover of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mi y
                      %mo{:stretchy => "false"} }
                      %mo ×
                      %mo{:stretchy => "false"} [
                      %mi I
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \{y\} \times [I]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              is finite, the intersection
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi y
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo ∩
                      %mrow
                        %mi k
                        %mo ∈
                        %msub
                          %mi K
                          %mi y
                  %annotation{:encoding => "application/x-tex"}
                    V_y \;\coloneqq\; \underset{k \in K_y}{\cap}
            %p is still open, and so also
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi V
                      %mi y
                    %mo ×
                    %msub
                      %mi I
                      %mi k
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi k
                        %mo ∈
                        %msub
                          %mi K
                          %mi y
                  %annotation{:encoding => "application/x-tex"}
                    \\{ V_y \times I_k \}_{k \in K_y}
            %p
              still restricts to a cover of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mi y
                      %mo{:stretchy => "false"} }
                      %mo ×
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \{y\} \times [0,1]
            %p
              This means that the same argument as for the path lifting in lemma
              %a.maruku-ref{:href => "#CoveringSpacePathLifting"}
              provides a unique lift
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mi η
                        %msub
                          %mo{:stretchy => "false"} |
                          %mrow
                            %msub
                              %mi V
                              %mi y
                            %mo ×
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} ]
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \widehat{\eta\vert_{V_y \times [0,1]}}
              for each
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo ∈
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} y \in Y
            %p
              Moreover, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi y
                      %mn 1
                    %mo ,
                    %msub
                      %mi y
                      %mn 2
                    %mo ∈
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} y_1, y_2 \in Y
              two points, these lifts clearly have to agree on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi V
                        %mrow
                          %msub
                            %mi y
                            %mn 1
                      %mo ∩
                      %msub
                        %mi V
                        %mrow
                          %msub
                            %mi y
                            %mn 2
                    %annotation{:encoding => "application/x-tex"} V_{y_1} \cap V_{y_2}
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi V
                      %mi y
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ⊂
                    %mi Y
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi y
                        %mo ∈
                        %mi Y
                  %annotation{:encoding => "application/x-tex"} \{V_y \times [0,1] \subset Y \times [0,1]\}_{y \in Y}
              is an open cover, means that there is a unique function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi η
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat \eta
              that restricts to all these local lifts (
              %a{:href => "Top#ClosedSubspacesGluing"}> this prop
              ). This is the required lift.
          #CoveringSpacesAreSerreFibrationsButNotInGeneralHurewiczFibrations.num_remark
            %h6#remark_7 Remark
            %p
              %strong
                (covering spaces are
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Hurewicz+fibrations"} Hurewicz fibrations
            %p
              Continuous functions with the
              %a.existingWikiWord{:href => "/nlab/show/right+lifting+property"} right lifting property
              against functions of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mover
                      %mo ⟶
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi id
                        %mo ,
                        %msub
                          %mi const
                          %mn 0
                        %mo{:stretchy => "false"} )
                    %mi Y
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} Y \overset{(id,const_0)}{\longrightarrow} Y \times [0,1]
              are called
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Hurewicz+fibrations"} Hurewicz fibrations
            %p
              Hence prop.
              %a.maruku-ref{:href => "#HomotopyLiftingPropertyOfCoveringSpaces"}
              says that covering projections are in particular Hurewicz fibrations.
          #CoveringSpacesHomotopyLifting.num_example
            %h6#example Example
            %p
              %strong (lift homotopy of paths for given lifts of paths)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %mi E
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} p \colon E \to X
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/covering+space"} covering space
              %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
              relative the starting point between two
              %a.existingWikiWord{:href => "/nlab/show/paths"} paths
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi γ
                      %mn 1
                    %mo ⇒
                    %msub
                      %mi γ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\eta \;\colon\; \gamma_1 \Rightarrow \gamma_2
            %p
              there is for every lift
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi γ
                        %mo{:stretchy => "false"} ^
                      %mn 1
                    %mo ,
                    %msub
                      %mover
                        %mi γ
                        %mo{:stretchy => "false"} ^
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \hat \gamma_1, \hat \gamma_2
              of these two paths to paths in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              with the same starting point a unique homotopy
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi η
                      %mo{:stretchy => "false"} ^
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mover
                        %mi γ
                        %mo{:stretchy => "false"} ^
                      %mn 1
                    %mo ⇒
                    %msub
                      %mover
                        %mi γ
                        %mo{:stretchy => "false"} ^
                      %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\hat \eta \;\colon\; \hat \gamma_1 \Rightarrow \hat \gamma_2
            %p between the lifted paths that lifts the given homotopy:
            %p
              For
              %a.existingWikiWord{:href => "/nlab/show/commuting+squares"} commuting squares
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} ]
                            %mo ×
                            %mo{:stretchy => "false"} {
                            %mn 0
                            %mo{:stretchy => "false"} }
                            %mo{:stretchy => "false"} )
                            %mo ∪
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} {
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} }
                            %mo ×
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi γ
                                  %mn 1
                                %mo ,
                                %msub
                                  %mi γ
                                  %mn 2
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi E
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mover
                                  %mi η
                                  %mo{:stretchy => "false"} ^
                            %mo ↗
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi p
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} ]
                            %mo ×
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %munder
                              %mo ⟶
                              %mi η
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    ([0,1] \times \{0\}) \cup (\{0,1\} \times [0,1])
                    \&amp;\overset{(\gamma_1, \gamma_2)}{\longrightarrow}&amp;
                    E
                    \\\
                    {}^{\mathllap{}}\downarrow
                    \&amp;{}^{\mathllap{\hat \eta}}\nearrow&amp;
                    \\downarrow^{\mathrlap{p}}
                    \\\
                    [0,1] \times [0,1] &amp;\underset{\eta}{\longrightarrow}&amp; X
                    }
            %p
              there is a unique diagonal
              %a.existingWikiWord{:href => "/nlab/show/lift"} lift
              in the lower diagram, as shown.
            %p
              Moreover if the homotopy
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
              also fixes the endpoint, then so does the lifted homotopy
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi η
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} \hat \eta
          .proof
            %h6#proof_6 Proof
            %p
              There are horizontal
              %a.existingWikiWord{:href => "/nlab/show/homeomorphisms"} homeomorphisms
              such that the following diagram commutes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mover
                              %mo ⟶
                              %mo ≃
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} ]
                            %mo ×
                            %mo{:stretchy => "false"} {
                            %mn 0
                            %mo{:stretchy => "false"} }
                            %mo{:stretchy => "false"} )
                            %mo ∩
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} {
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} }
                            %mo ×
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} ]
                            %mo ×
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %munder
                              %mo ⟶
                              %mo ≃
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} ]
                            %mo ×
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    [0,1]
                    \&amp;\overset{\simeq}{\longrightarrow}&amp;
                    ([0,1] \times \{0\}) \cap ( \{0,1\} \times [0,1] )
                    \\\
                    \\downarrow
                    \&amp;&amp;
                    \\downarrow
                    \\\
                    [0,1] \times [0,1] &amp;\underset{\simeq}{\longrightarrow}&amp; [0,1] \times [0,1]
                    }
                    \\,.
            %p
              With this the statement follows from
              = succeed "." do
                %a.maruku-ref{:href => "#HomotopyLiftingPropertyOfCoveringSpaces"}
          #IfFundamentalGroupsIncludeThenfLoopsLiftToLoops.num_example
            %h6#example_2 Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mi p
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,e) \overset{p}{\longrightarrow} (X,x)
              be a
              %a.existingWikiWord{:href => "/nlab/show/pointed+topological+space"} pointed
              %a.existingWikiWord{:href => "/nlab/show/covering+space"} covering space
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \colon (Y,y) \longrightarrow (X,x)
              be a point-preserving
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              such that the image of the
              %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} fundamental group
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Y,y)
              is contained within the image of the fundamental group of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,e)
              in that of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,x)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %msub
                      %mi p
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mphantom
                      %mi AA
                    %mo ⊂
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f_\ast(\pi_1(Y,y)) \subset p_\ast(\pi_1(E,e))
                    \\phantom{AA}
                    \\subset
                    \\pi_1(X,x)
                    \\,.
            %p
              Then for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℓ
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} \ell_Y
              a
              %a.existingWikiWord{:href => "/nlab/show/path"} path
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Y,y)
              that happens to be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/loop"} loop
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∘
                    %mi ℓ
                  %annotation{:encoding => "application/x-tex"} f \circ \ell
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,x)
              to a path
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mi f
                        %mo ∘
                        %msub
                          %mi ℓ
                          %mi Y
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \widehat{f\circ \ell_Y}
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,e)
              is also a loop there.
          .proof
            %h6#proof_7 Proof
            %p
              By assumption, there is a loop
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℓ
                      %mi E
                  %annotation{:encoding => "application/x-tex"} \ell_E
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,e)
              and a homotopy fixing the endpoints of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi X
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi p
                    %mo ∘
                    %msub
                      %mi ℓ
                      %mi E
                    %mo ⇒
                    %mi f
                    %mo ∘
                    %msub
                      %mi ℓ
                      %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\eta_{X} \;\colon\; p \circ \ell_E \Rightarrow f\circ \ell_Y
                    \\,.
            %p
              Then by the homotopy lifting property as in example
              = succeed "," do
                %a.maruku-ref{:href => "#CoveringSpacesHomotopyLifting"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,e)
              fixing the starting point, of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi E
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi ℓ
                      %mi E
                    %mo ⇒
                    %mover
                      %mrow
                        %mi f
                        %mo ∘
                        %msub
                          %mi ℓ
                          %mi Y
                      %mo ^
                  %annotation{:encoding => "application/x-tex"}
                    \\eta_{E} \;\colon\; \ell_E \Rightarrow \widehat{f \circ \ell_Y}
            %p
              and lifting the homotopy
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi η
                        %mi X
                    %annotation{:encoding => "application/x-tex"} \eta_X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \eta_X
              in addition fixes the endpoint, the uniqueness of the path lifting (lemma
              = succeed ")" do
                %a.maruku-ref{:href => "#CoveringSpacePathLifting"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi E
                  %annotation{:encoding => "application/x-tex"} \eta_{E}
              fixes the endpoint. Therefore
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi E
                  %annotation{:encoding => "application/x-tex"} \eta_E
              is in fact a homotopy between loops, and so
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mi f
                        %mo ∘
                        %msub
                          %mi ℓ
                          %mi Y
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \widehat{f \circ \ell_Y}
              is indeed a loop.
          #TheTheoremLifting.num_prop
            %h6#proposition_3 Proposition
            %p
              %strong (lifting theorem)
            %p Let
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %mo{:lspace => "verythinmathspace"} :
                        %mi E
                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} p \colon E \to X
                  be a
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/covering+space"} covering space
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi e
                        %mo ∈
                        %mi E
                      %annotation{:encoding => "application/x-tex"} e \in E
                  a point, with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ≔
                        %mi p
                        %mo{:stretchy => "false"} (
                        %mi e
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} x \coloneqq p(e)
                  denoting its image,
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} Y
                  be a
                  %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected
                  and
                  %a.existingWikiWord{:href => "/nlab/show/locally+path-connected+topological+space"} locally path-connected
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi y
                        %mo ∈
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} y \in Y
                  a point
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo{:lspace => "verythinmathspace"} :
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi x
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} f \colon (Y,y) \longrightarrow (X,x)
                  a
                  %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
                  such that
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi y
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi x
                        %annotation{:encoding => "application/x-tex"} f(y) = x
            %p Then the following are equivalent:
            %ol
              %li
                %p
                  There exists a unique lift
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi f
                          %mo{:stretchy => "false"} ^
                      %annotation{:encoding => "application/x-tex"} \hat f
                  in the diagram
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %mo{:stretchy => "false"} (
                                %mi E
                                %mo ,
                                %mi e
                                %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                              %mtd
                                %msup
                                  %mrow
                                  %mpadded{:lspace => "-100%width", :width => "0"}
                                    %mover
                                      %mi f
                                      %mo{:stretchy => "false"} ^
                                %mo ↗
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↓
                                  %mpadded{:width => "0"}
                                    %mi p
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} (
                                %mi Y
                                %mo ,
                                %mi y
                                %mo{:stretchy => "false"} )
                              %mtd
                                %munder
                                  %mo ⟶
                                  %mi f
                              %mtd
                                %mo{:stretchy => "false"} (
                                %mi X
                                %mo ,
                                %mi x
                                %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        \&amp;&amp; (E,e)
                        \\\
                        \&amp; {}^{\mathllap{\hat f}}\nearrow &amp; \downarrow^{\mathrlap{p}}
                        \\\
                        (Y,y) &amp;\underset{f}{\longrightarrow}&amp; (X,x)
                        }
                %p
                  of
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/pointed+topological+spaces"} pointed topological spaces
              %li
                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/image"} image
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} fundamental group
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} Y
                  under
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  in that of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  is contained in the image of the fundamental group of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
                  under
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi p
                        %annotation{:encoding => "application/x-tex"} p
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi f
                          %mo *
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi π
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo ⊂
                        %msub
                          %mi p
                          %mo *
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi π
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo ,
                        %mi e
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                      %annotation{:encoding => "application/x-tex"}
                        f_\ast(\pi_1(Y,y)) \subset p_\ast( \pi_1(E,e) )
                        \\,
            %p
              Moreover, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              is path-connected, then the lift in the first item is unique.
          .proof
            %h6#proof_8 Proof
            %p
              The implication
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⇒
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} 1) \Rightarrow 2)
              is immediate. We need to show that the second statement already implies the first.
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              is connected and locally path-connected, it is also a
              %a.existingWikiWord{:href => "/nlab/show/path-connected+topological+space"} path-connected topological space
              (
              %a{:href => "locally+path-connected+space#ForLocallyPathConnectedTheConnectedComponentsCoincideWithThePathConnectedComponents"}> this prop.
              ). Hence for every point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ′
                    %mo ∈
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} y' \in Y
              there exists a
              %a.existingWikiWord{:href => "/nlab/show/path"} path
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                  %annotation{:encoding => "application/x-tex"} \gamma
              connecting
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} y'
              and hence a path
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∘
                    %mi γ
                  %annotation{:encoding => "application/x-tex"} f \circ \gamma
              connecting
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo ′
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f(y')
              = succeed ")" do
                %a.maruku-ref{:href => "#CoveringSpacePathLifting"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} {
                            %mn 0
                            %mo{:stretchy => "false"} }
                          %mtd
                            %mover
                              %mo ⟶
                              %mi e
                          %mtd
                            %mi E
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mover
                                  %mrow
                                    %mi f
                                    %mo ∘
                                    %mi γ
                                  %mo ^
                            %mo ↗
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi p
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %mi f
                                %mo ∘
                                %mi γ
                          %mtd
                            %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\{0\} &amp;\overset{e}{\longrightarrow}&amp; E
                    \\\
                    \\downarrow &amp;{}^{\mathllap{\widehat{f \circ \gamma}}}\nearrow&amp; \downarrow^{\mathrlap{p}}
                    \\\
                    [0,1]
                    \&amp;\underset{f \circ \gamma}{\longrightarrow}&amp;
                    X
                    }
                    \\,.
            %p Therefore
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mover
                      %mrow
                        %mi f
                        %mo ∘
                        %mi γ
                      %mo ^
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\hat f(y') \coloneqq \widehat{f \circ \gamma}(1)
            %p
              is a lift of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo ′
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f(y')
            %p
              We claim now that this pointwise construction is independent of the choice
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi γ
                    %annotation{:encoding => "application/x-tex"} \gamma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} y'
              it is indeed continuous. This will prove the claim.
            %p
              Now by the path lifting lemma
              %a.maruku-ref{:href => "#CoveringSpacePathLifting"}
              the lift
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} f
                        %mo ∘
                        %mi γ
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \widehat{\f \circ \gamma}
              is unique given
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ∘
                      %mi γ
                    %annotation{:encoding => "application/x-tex"} f \circ \gamma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \hat f(y')
              depends at most on the choice of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi γ
                    %annotation{:encoding => "application/x-tex"} \gamma
            %p
              Hence let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo ′
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} \gamma' \colon [0,1] \to Y
              be another path in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              that connects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} y'
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mrow
                          %mi f
                          %mo ∘
                          %mi γ
                          %mo ′
                        %mo ^
                      %mo =
                      %mover
                        %mrow
                          %mi f
                          %mo ∘
                          %mi γ
                        %mo ^
                    %annotation{:encoding => "application/x-tex"} \widehat{f \circ \gamma'} = \widehat{f \circ \gamma}
            %p
              First observe that if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \gamma'
              is related to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                  %annotation{:encoding => "application/x-tex"} \gamma
              by a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∘
                    %mi γ
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} f \circ \gamma'
              is related to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∘
                    %mi γ
                  %annotation{:encoding => "application/x-tex"} f \circ \gamma
              by a homotopy, then this is the statement of the homotopy lifting property as in example
              = succeed "." do
                %a.maruku-ref{:href => "#CoveringSpacesHomotopyLifting"}
            %p
              Next write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi γ
                      %mo{:stretchy => "false"} ¯
                    %mo ′
                    %mo ⋅
                    %mi γ
                  %annotation{:encoding => "application/x-tex"} \bar\gamma'\cdot \gamma
              for the
              %a.existingWikiWord{:href => "/nlab/show/path+concatenation"} path concatenation
              of the path
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                  %annotation{:encoding => "application/x-tex"} \gamma
              with the
              %a.existingWikiWord{:href => "/nlab/show/reverse+path"} reverse path
              of the path
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi γ
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} \gamma'
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∘
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi γ
                      %mo{:stretchy => "false"} ¯
                    %mo ′
                    %mo ⋅
                    %mi γ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \circ (\bar\gamma'\cdot \gamma)
              is a loop in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %msub
                      %mi p
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f_\ast(\pi_1(Y,y)) \subset p_\ast(\pi_1(E,e))
              implies (example
              = succeed ")" do
                %a.maruku-ref{:href => "#IfFundamentalGroupsIncludeThenfLoopsLiftToLoops"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mi f
                        %mo ∘
                        %mo{:stretchy => "false"} (
                        %mover
                          %mi γ
                          %mo{:stretchy => "false"} ¯
                        %mo ′
                        %mo ⋅
                        %mi γ
                        %mo{:stretchy => "false"} )
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \widehat{f \circ (\bar \gamma' \cdot \gamma)}
              which lifts this loop to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is itself a loop in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
            %p By uniqueness of path lifting, this means that the lift of
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∘
                    %mo{:stretchy => "false"} (
                    %mi γ
                    %mo ′
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi γ
                      %mo{:stretchy => "false"} ¯
                    %mo ′
                    %mo ⋅
                    %mi γ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ∘
                    %mi γ
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ∘
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi γ
                      %mo{:stretchy => "false"} ¯
                    %mo ′
                    %mo ⋅
                    %mi γ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    f \circ ( \gamma' \cdot (\bar\gamma' \cdot \gamma) )
                    \=
                    (f \circ \gamma') \cdot (f \circ (\bar \gamma' \cdot \gamma) )
            %p
              coincides at
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} 1 \in [0,1]
              with that of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∘
                    %mi γ
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} f \circ \gamma'
              at 1. But
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo ′
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi γ
                      %mo{:stretchy => "false"} ¯
                    %mo ′
                    %mo ⋅
                    %mi γ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \gamma' \cdot (\bar \gamma' \cdot \gamma)
              is homotopic (via reparameterization) to just
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi γ
                    %annotation{:encoding => "application/x-tex"} \gamma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∘
                    %mi γ
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} f \circ \gamma'
              indeed coincides with that of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ∘
                      %mi γ
                    %annotation{:encoding => "application/x-tex"} f \circ \gamma
            %p
              This shows that the above prescription for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat f
              is well defined.
            %p
              It only remains to show that the function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat f
              obtained this way is continuous.
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ′
                    %mo ∈
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} y' \in Y
              be a point and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi W
                      %mrow
                        %mover
                          %mi f
                          %mo{:stretchy => "false"} ^
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo ′
                        %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi E
                  %annotation{:encoding => "application/x-tex"} W_{\hat f(y')} \subset E
              an open neighbourhood of its image in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mrow
                        %mi y
                        %mo ′
                    %mo ⊂
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} V_{y'} \subset Y
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ^
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi V
                        %mi y
                      %mo{:stretchy => "false"} )
                      %mo ⊂
                      %msub
                        %mi W
                        %mrow
                          %mover
                            %mi f
                            %mo{:stretchy => "false"} ^
                          %mo{:stretchy => "false"} (
                          %mi y
                          %mo ′
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \hat f(V_y) \subset W_{\hat f(y')}
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo ′
                        %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U_{f(y')} \subset X
              be an open neighbourhood over which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              trivializes. Then the restriction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi p
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo ′
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ∩
                    %msub
                      %mi W
                      %mrow
                        %mover
                          %mi f
                          %mo{:stretchy => "false"} ^
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo ′
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ⊂
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi U
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo ′
                        %mo{:stretchy => "false"} )
                    %mo ×
                    %mi Disc
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi p
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    p^{-1}(U_{f(y')}) \cap W_{\hat f(y')}
                    \\;\subset\;
                    U_{f(y')} \times Disc(p^{-1}(f(y')))
            %p is an open subset of the product space. Consider its further restriction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %msub
                        %mi U
                        %mrow
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi y
                          %mo ′
                          %mo{:stretchy => "false"} )
                      %mo ×
                      %mo{:stretchy => "false"} {
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ^
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo ′
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} }
                      %mo )
                    %mo ∩
                    %mrow
                      %mo (
                      %msup
                        %mi p
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi U
                        %mrow
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi y
                          %mo ′
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ∩
                      %msub
                        %mi W
                        %mrow
                          %mover
                            %mi f
                            %mo{:stretchy => "false"} ^
                          %mo{:stretchy => "false"} (
                          %mi y
                          %mo ′
                          %mo{:stretchy => "false"} )
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\left( U_{f(y')} \times \{\hat f(y')\} \right)
                    \\cap
                    \\left(
                    p^{-1}(U_{f(y')}) \cap W_{\hat f(y')}
                    \\right)
            %p
              to the
              %a.existingWikiWord{:href => "/nlab/show/leaf"} leaf
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo ′
                        %mo{:stretchy => "false"} )
                    %mo ×
                    %mo{:stretchy => "false"} {
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                    %mspace{:width => "thickmathspace"}
                    %mo ⊂
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi U
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo ′
                        %mo{:stretchy => "false"} )
                    %mo ×
                    %msup
                      %mi p
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    U_{f(y')} \times \{\hat f(y')\} \;\subset\; U_{f(y')} \times p^{-1}(f(y'))
            %p
              which is itself an open subset. Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              is an
              %a.existingWikiWord{:href => "/nlab/show/open+map"} open map
              (
              %a{:href => "covering+space#CoveringProjectionsAreOpenMaps"}> this prop.
              ), the subset
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mrow
                      %mo (
                      %mrow
                        %mo (
                        %msub
                          %mi U
                          %mrow
                            %mi f
                            %mo{:stretchy => "false"} (
                            %mi y
                            %mo ′
                            %mo{:stretchy => "false"} )
                        %mo ×
                        %mo{:stretchy => "false"} {
                        %mover
                          %mi f
                          %mo{:stretchy => "false"} ^
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo ′
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} }
                        %mo )
                      %mo ∩
                      %mrow
                        %mo (
                        %msup
                          %mi p
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi U
                          %mrow
                            %mi f
                            %mo{:stretchy => "false"} (
                            %mi y
                            %mo ′
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo ∩
                        %msub
                          %mi W
                          %mrow
                            %mover
                              %mi f
                              %mo{:stretchy => "false"} ^
                            %mo{:stretchy => "false"} (
                            %mi y
                            %mo ′
                            %mo{:stretchy => "false"} )
                        %mo )
                      %mo )
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    p\left(
                    \\left(
                    U_{f(y')} \times \{\hat f(y')\}
                    \\right)
                    \\cap
                    \\left(
                    p^{-1}(U_{f(y')}) \cap W_{\hat f(y')}
                    \\right)
                    \\right)
                    \\subset X
            %p is open, hence so is its pre-image
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mrow
                      %mo (
                      %mi p
                      %mrow
                        %mo (
                        %mrow
                          %mo (
                          %msub
                            %mi U
                            %mrow
                              %mi f
                              %mo{:stretchy => "false"} (
                              %mi y
                              %mo ′
                              %mo{:stretchy => "false"} )
                          %mo ×
                          %mo{:stretchy => "false"} {
                          %mover
                            %mi f
                            %mo{:stretchy => "false"} ^
                          %mo{:stretchy => "false"} (
                          %mi y
                          %mo ′
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} }
                          %mo )
                        %mo ∩
                        %mrow
                          %mo (
                          %msup
                            %mi p
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi U
                            %mrow
                              %mi f
                              %mo{:stretchy => "false"} (
                              %mi y
                              %mo ′
                              %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo ∩
                          %msub
                            %mi W
                            %mrow
                              %mover
                                %mi f
                                %mo{:stretchy => "false"} ^
                              %mo{:stretchy => "false"} (
                              %mi y
                              %mo ′
                              %mo{:stretchy => "false"} )
                          %mo )
                        %mo )
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo ⊂
                    %mspace{:width => "thickmathspace"}
                    %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f^{-1}
                    \\left(
                    p
                    \\left(
                    \\left(
                    U_{f(y')} \times \{\hat f(y')\}
                    \\right)
                    \\cap
                    \\left(
                    p^{-1}(U_{f(y')}) \cap W_{\hat f(y')}
                    \\right)
                    \\right)
                    \\right)
                    \\;\subset\;
                    Y
                    \\,.
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              is assumed to be
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/locally+path-connected+topological+space"} locally path-connected
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mrow
                        %mi y
                        %mo ′
                    %mo ⊂
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mrow
                      %mo (
                      %mi p
                      %mrow
                        %mo (
                        %mrow
                          %mo (
                          %msub
                            %mi U
                            %mrow
                              %mi f
                              %mo{:stretchy => "false"} (
                              %mi y
                              %mo ′
                              %mo{:stretchy => "false"} )
                          %mo ×
                          %mo{:stretchy => "false"} {
                          %mover
                            %mi f
                            %mo{:stretchy => "false"} ^
                          %mo{:stretchy => "false"} (
                          %mi y
                          %mo ′
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} }
                          %mo )
                        %mo ∩
                        %mrow
                          %mo (
                          %msup
                            %mi p
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi U
                            %mrow
                              %mi f
                              %mo{:stretchy => "false"} (
                              %mi y
                              %mo ′
                              %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo ∩
                          %msub
                            %mi W
                            %mrow
                              %mover
                                %mi f
                                %mo{:stretchy => "false"} ^
                              %mo{:stretchy => "false"} (
                              %mi y
                              %mo ′
                              %mo{:stretchy => "false"} )
                          %mo )
                        %mo )
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    V_{y'}
                    \\subset
                    f^{-1}\left(p\left(
                    \\left(U_{f(y')} \times \{\hat f(y')\}\right)
                    \\cap
                    \\left(
                    p^{-1}(U_{f(y')}) \cap W_{\hat f(y')}
                    \\right)
                    \\right)
                    \\right)
                    \\,.
            %p
              By the uniqueness of pah lifting, the image of that under
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat f
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mover
                              %mi f
                              %mo{:stretchy => "false"} ^
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi V
                              %mrow
                                %msub
                                  %mi y
                                  %mo ′
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mi f
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi V
                              %mrow
                                %mi y
                                %mo ′
                            %mo{:stretchy => "false"} )
                            %mo ×
                            %mo{:stretchy => "false"} {
                            %mover
                              %mi f
                              %mo{:stretchy => "false"} ^
                            %mo{:stretchy => "false"} (
                            %mi y
                            %mo ′
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} }
                        %mtr
                          %mtd
                          %mtd
                            %mo ⊂
                            %mi p
                            %mrow
                              %mo (
                              %mrow
                                %mo (
                                %msub
                                  %mi U
                                  %mrow
                                    %mi f
                                    %mo{:stretchy => "false"} (
                                    %mi y
                                    %mo ′
                                    %mo{:stretchy => "false"} )
                                %mo ×
                                %mo{:stretchy => "false"} {
                                %mover
                                  %mi f
                                  %mo{:stretchy => "false"} ^
                                %mo{:stretchy => "false"} (
                                %mi y
                                %mo ′
                                %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} }
                                %mo )
                              %mo ∩
                              %mrow
                                %mo (
                                %msup
                                  %mi p
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mn 1
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi U
                                  %mrow
                                    %mi f
                                    %mo{:stretchy => "false"} (
                                    %mi y
                                    %mo ′
                                    %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} )
                                %mo ∩
                                %msub
                                  %mi W
                                  %mrow
                                    %mover
                                      %mi f
                                      %mo{:stretchy => "false"} ^
                                    %mo{:stretchy => "false"} (
                                    %mi y
                                    %mo ′
                                    %mo{:stretchy => "false"} )
                                %mo )
                              %mo )
                            %mo ×
                            %mo{:stretchy => "false"} {
                            %mover
                              %mi f
                              %mo{:stretchy => "false"} ^
                            %mo{:stretchy => "false"} (
                            %mi y
                            %mo ′
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} }
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mrow
                              %mo (
                              %msub
                                %mi U
                                %mrow
                                  %mi f
                                  %mo{:stretchy => "false"} (
                                  %mi y
                                  %mo ′
                                  %mo{:stretchy => "false"} )
                              %mo ×
                              %mo{:stretchy => "false"} {
                              %mover
                                %mi f
                                %mo{:stretchy => "false"} ^
                              %mo{:stretchy => "false"} (
                              %mi y
                              %mo ′
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} }
                              %mo )
                            %mo ∩
                            %mrow
                              %mo (
                              %msup
                                %mi p
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mn 1
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi U
                                %mrow
                                  %mi f
                                  %mo{:stretchy => "false"} (
                                  %mi y
                                  %mo ′
                                  %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                              %mo ∩
                              %msub
                                %mi W
                                %mrow
                                  %mover
                                    %mi f
                                    %mo{:stretchy => "false"} ^
                                  %mo{:stretchy => "false"} (
                                  %mi y
                                  %mo ′
                                  %mo{:stretchy => "false"} )
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo ⊂
                            %msub
                              %mi W
                              %mrow
                                %mover
                                  %mi f
                                  %mo{:stretchy => "false"} ^
                                %mo{:stretchy => "false"} (
                                %mi y
                                %mo ′
                                %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\hat f(V_{y_'})
                    \&amp; =
                    f(V_{y'}) \times \{\hat f(y')\}
                    \\\
                    \&amp; \subset
                    p\left(
                    \\left(U_{f(y')} \times \{\hat f(y')\}\right)
                    \\cap
                    \\left(
                    p^{-1}(U_{f(y')}) \cap W_{\hat f(y')}
                    \\right)
                    \\right) \times \{\hat f(y')\}
                    \\\
                    \&amp; \simeq
                    \\left( U_{f(y')} \times \{\hat f(y')\} \right)
                    \\cap
                    \\left(
                    p^{-1}(U_{f(y')}) \cap W_{\hat f(y')}
                    \\right)
                    \\\
                    \&amp; \subset W_{\hat f(y')}
                    \\end{aligned}
                    \\,.
            %p
              This shows that the lifted function is continuous. Finally that this continuous lift is unique is the statement of lemma
              = succeed "." do
                %a.maruku-ref{:href => "#LiftsOverConnectedSpaceIntoCoveringSpaceAreUniqueRelativePoint"}
          %h3#monodromy Monodromy
          #CoveringSpaceMonodromy.num_defn
            %h6#definition_2 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/monodromy"} monodromy
                of a covering space)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
                      %mi p
                    %mi X
                  %annotation{:encoding => "application/x-tex"} E \overset{p}{\to} X
              a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/covering+space"} covering space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi_1(X)
              for the
              %a.existingWikiWord{:href => "/nlab/show/fundamental+groupoid"} fundamental groupoid
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p
              Define a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Fib
                      %mi E
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi Set
                  %annotation{:encoding => "application/x-tex"}
                    Fib_E
                    \\;\colon\;
                    \\Pi_1(X)
                    \\longrightarrow
                    Set
            %p
              to the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              of
              %a.existingWikiWord{:href => "/nlab/show/sets"} sets
              as follows:
            %ol
              %li
                %p
                  to a point
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi X
                      %annotation{:encoding => "application/x-tex"} x \in X
                  assign the
                  %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi p
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mo{:stretchy => "false"} (
                          %mo{:stretchy => "false"} {
                          %mi x
                          %mo{:stretchy => "false"} }
                          %mo{:stretchy => "false"} )
                          %mo ∈
                          %mi Set
                        %annotation{:encoding => "application/x-tex"} p^{-1}(\{x\}) \in Set
              %li
                %p
                  to the
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+class"} homotopy class
                  of a
                  %a.existingWikiWord{:href => "/nlab/show/path"} path
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi γ
                      %annotation{:encoding => "application/x-tex"} \gamma
                  connecting
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ≔
                        %mi γ
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} x \coloneqq \gamma(0)
                  with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi y
                        %mo ≔
                        %mi γ
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} y \coloneqq \gamma(1)
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  assign the function
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi p
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} {
                        %mi x
                        %mo{:stretchy => "false"} }
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %msup
                          %mi p
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} {
                        %mi y
                        %mo{:stretchy => "false"} }
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} p^{-1}(\{x\}) \longrightarrow p^{-1}(\{y\})
                  which takes
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi x
                          %mo{:stretchy => "false"} ^
                        %mo ∈
                        %msup
                          %mi p
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} {
                        %mi x
                        %mo{:stretchy => "false"} }
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \hat x \in p^{-1}(\{x\})
                  to the endpoint of a path
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi γ
                          %mo{:stretchy => "false"} ^
                      %annotation{:encoding => "application/x-tex"} \hat \gamma
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
                  which lifts
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi γ
                      %annotation{:encoding => "application/x-tex"} \gamma
                  through
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
                  with starting point
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi γ
                          %mo{:stretchy => "false"} ^
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mover
                          %mi x
                          %mo{:stretchy => "false"} ^
                      %annotation{:encoding => "application/x-tex"} \hat \gamma(0) = \hat x
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %msup
                                  %mi p
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mn 1
                                %mo{:stretchy => "false"} (
                                %mi x
                                %mo{:stretchy => "false"} )
                              %mtd
                                %mover
                                  %mo ⟶
                                  %mrow
                              %mtd
                                %msup
                                  %mi p
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mn 1
                                %mo{:stretchy => "false"} (
                                %mi y
                                %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} (
                                %mover
                                  %mi x
                                  %mo{:stretchy => "false"} ^
                                %mo =
                                %mover
                                  %mi γ
                                  %mo{:stretchy => "false"} ^
                                %mo{:stretchy => "false"} (
                                %mn 0
                                %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} )
                              %mtd
                                %mo ↦
                              %mtd
                                %mover
                                  %mi γ
                                  %mo{:stretchy => "false"} ^
                                %mo{:stretchy => "false"} (
                                %mn 1
                                %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        p^{-1}(x) &amp;\overset{}{\longrightarrow}&amp; p^{-1}(y)
                        \\\
                        (\hat x = \hat \gamma(0)) &amp;\mapsto&amp; \hat \gamma(1)
                        }
                        \\,.
            %p
              This construction is well defined for a given representative
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                  %annotation{:encoding => "application/x-tex"} \gamma
              due to the unique path-lifting property of covering spaces (
              %a{:href => "covering+space#CoveringSpacePathLifting"}> this lemma
              ) and it is independent of the choice of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                  %annotation{:encoding => "application/x-tex"} \gamma
              in the given homotopy class of paths due to the homotopy-lifting property (
              %a{:href => "covering+space#CoveringSpacesHomotopyLifting"}> this lemma
              ). Similarly, these two lifting properties give that this construction respects composition in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi_1(X)
              and hence is indeed a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/functor"} functor
          .num_prop
            %h6#proposition_4 Proposition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              between two
              %a.existingWikiWord{:href => "/nlab/show/covering+spaces"} covering spaces
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mi i
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi p
                            %mi i
                      %mi X
                    %annotation{:encoding => "application/x-tex"} E_i \overset{p_i}{\to} X
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi E
                      %mn 1
                    %mo →
                    %msub
                      %mi E
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} f \colon E_1 \to E_2
              which respects
              %a.existingWikiWord{:href => "/nlab/show/fibers"} fibers
              in that the
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi E
                              %mn 1
                          %mtd
                          %mtd
                            %mover
                              %mo ⟶
                              %mi f
                          %mtd
                          %mtd
                            %msub
                              %mi E
                              %mn 2
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi p
                                    %mn 1
                            %mo ↘
                          %mtd
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi p
                                    %mn 2
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    E_1 &amp;&amp; \overset{f}{\longrightarrow} &amp;&amp; E_2
                    \\\
                    \&amp; {}_{\mathllap{p_1}}\searrow &amp;&amp; \swarrow_{\mathrlap{p_2}}
                    \\\
                    \&amp;&amp; X
                    }
            %p
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"}> commutes
              , then the component functions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mi x
                        %mo{:stretchy => "false"} }
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi p
                      %mn 1
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msubsup
                      %mi p
                      %mn 2
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    f\vert_{\{x\}} \;\colon\; p_1^{-1}(\{x\}) \longrightarrow p_2^{-1}(\{x\})
            %p
              are compatible with the monodromy
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Fib
                      %mi E
                  %annotation{:encoding => "application/x-tex"} Fib_{E}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CoveringSpaceMonodromy"}
              %a.existingWikiWord{:href => "/nlab/show/path"} path
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                  %annotation{:encoding => "application/x-tex"} \gamma
              between points
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
              from def.
              %a.maruku-ref{:href => "#CoveringSpaceMonodromy"}
              in that the following
              %a.existingWikiWord{:href => "/nlab/show/diagrams"} diagrams
              of
              %a.existingWikiWord{:href => "/nlab/show/sets"} sets
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commute
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msubsup
                              %mi p
                              %mn 1
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mi f
                                %msub
                                  %mo{:stretchy => "false"} |
                                  %mrow
                                    %mo{:stretchy => "false"} {
                                    %mi x
                                    %mo{:stretchy => "false"} }
                          %mtd
                            %msubsup
                              %mi p
                              %mn 2
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi Fib
                                    %mrow
                                      %msub
                                        %mi E
                                        %mn 1
                                  %mo{:stretchy => "false"} (
                                  %mo{:stretchy => "false"} [
                                  %mi γ
                                  %mo{:stretchy => "false"} ]
                                  %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi Fib
                                    %mrow
                                      %msub
                                        %mi E
                                        %mn 2
                                  %mo{:stretchy => "false"} (
                                  %mo{:stretchy => "false"} [
                                  %mi γ
                                  %mo{:stretchy => "false"} ]
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msubsup
                              %mi p
                              %mn 1
                              %mrow
