                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %p
            Below, we let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo :
                  %msup
                    %mi Set
                    %mrow
                      %msup
                        %mi Δ
                        %mi op
                  %mo →
                  %mi Space
                %annotation{:encoding => "application/x-tex"} R: Set^{\Delta^{op}} \to Space
            denote the geometric realization when considered as landing in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Space
                  %annotation{:encoding => "application/x-tex"} Space
          %h3#GeometricRealizationIsLeftExact Theorem: Geometric realization is left exact
          %p
            We continue to assume
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Space
                %annotation{:encoding => "application/x-tex"} Space
            is any
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/convenient+category+of+topological+spaces"} convenient category of topological spaces
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo :
                  %msup
                    %mi Set
                    %mrow
                      %msup
                        %mi Δ
                        %mi op
                  %mo →
                  %mi Space
                %annotation{:encoding => "application/x-tex"} R: Set^{\Delta^{op}} \to Space
          %p
            is a left
            %a.existingWikiWord{:href => "/nlab/show/exact+functor"} exact functor
            in that it preserves
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/finite+limits"} finite limits
          %p It is important that we use some such “convenience” assumption, because for example
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} |
                  %mo :
                  %msup
                    %mi Set
                    %mrow
                      %msup
                        %mi Δ
                        %mi op
                  %mo →
                  %mi Top
                  %mo ,
                %annotation{:encoding => "application/x-tex"} {|(-)|}: Set^{\Delta^{op}} \to Top,
          %p
            valued in general
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo{:lspace => "verythinmathspace"} :
                  %mi Haus
                  %mo →
                  %mi CGHaus
                %annotation{:encoding => "application/x-tex"} k \colon Haus \to CGHaus
            to
            %a.existingWikiWord{:href => "/nlab/show/Hausdorff+space"} Hausdorff
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/compactly+generated+topological+spaces"} compactly generated topological spaces
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Space
                    %mo =
                    %mi CGHaus
                  %annotation{:encoding => "application/x-tex"} Space = CGHaus
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi X
                      %mo ×
                      %mi Y
                      %mo{:stretchy => "false"} |
                    %mo ≅
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi X
                      %mo{:stretchy => "false"} |
                    %msub
                      %mo ×
                      %mi k
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi Y
                      %mo{:stretchy => "false"} |
                    %mo ≔
                    %mi k
                    %mo{:stretchy => "false"} (
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi X
                      %mo{:stretchy => "false"} |
                    %mo ×
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi Y
                      %mo{:stretchy => "false"} |
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} {|X \times Y|} \cong {|X|} \times_k {|Y|} \coloneqq k({|X|} \times {|Y|})
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CGHaus
                  %annotation{:encoding => "application/x-tex"} CGHaus
          %p
            We reiterate that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            denotes the geometric realization functor considered as valued in a convenient category of spaces, whereas
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} {|(-)|}
            is geometric realization viewed as taking values in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} Top
          #leftexact.num_theorem
            %h6#theorem Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo =
                    %mi hom
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi Space
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} U = \hom(1, -): Space \to Set
              be the underlying-set functor. Then the composite
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mi R
                    %mo :
                    %msup
                      %mi Set
                      %mrow
                        %msup
                          %mi Δ
                          %mi op
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} U R: Set^{\Delta^{op}} \to Set
              is left exact.
          .proof
            %h6#proof Proof
            %p
              As described at the nLab article on triangulation
              = succeed "," do
                %a{:href => "triangulation#StandardAffineSimplexFunctor"} here
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mover
                      %mo →
                      %mi σ
                    %mi Space
                    %mover
                      %mo →
                      %mi U
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} \Delta \stackrel{\sigma}{\to} Space \stackrel{U}{\to} Set
            %p can be described as the functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo ≅
                    %msup
                      %mi FinInt
                      %mi op
                    %mo ↪
                    %msup
                      %mi Int
                      %mi op
                    %mover
                      %mo →
                      %mrow
                        %mi Int
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mi I
                        %mo{:stretchy => "false"} )
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} \Delta \cong FinInt^{op} \hookrightarrow Int^{op} \stackrel{Int(-, I)}{\to} Set
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Int
                  %annotation{:encoding => "application/x-tex"} Int
              is the category of intervals (linearly ordered sets with distinct top and bottom). Because every interval, in particular
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
              %a.existingWikiWord{:href => "/nlab/show/filtered+colimit"} filtered colimit
              of finite intervals, and because finite intervals are finitely presentable intervals, it follows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mi σ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Δ
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} U \sigma \colon \Delta \to Set
              is a
              %a.existingWikiWord{:href => "/nlab/show/flat+functor"} flat functor
              (a
              %a.existingWikiWord{:href => "/nlab/show/filtered+colimit"} filtered colimit
              of representables). But on general grounds,
              %a.existingWikiWord{:href => "/nlab/show/copower"} tensoring
              with a flat functor is left exact, which in this case means
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mi R
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mo ⊗
                      %mi Δ
                    %mi U
                    %mi σ
                    %mo :
                    %msup
                      %mi Set
                      %mrow
                        %msup
                          %mi Δ
                          %mi op
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} U R = - \otimes_\Delta U \sigma: Set^{\Delta^{op}} \to Set
            %p is left exact.
          %p
            Obviously the preceding proof is not sensitive to whether we use
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Space
                %annotation{:encoding => "application/x-tex"} Space
            or
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} Top
          %h4#geometric_realization_preserves_equalizers Geometric realization preserves equalizers
          #mono.num_lemma
            %h6#lemma Lemma
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} i: X \to Y
              is a
              %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
              of simplicial sets, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} R(i): R(X) \to R(Y)
              is a
              %a.existingWikiWord{:href => "/nlab/show/closed+subspace"} closed subspace
              inclusion, in fact a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/relative+CW-complex"} relative CW-complex
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo =
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} X = \emptyset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} R(Y)
              is a
              = succeed "-complex." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi CW
                    %annotation{:encoding => "application/x-tex"} CW
          .proof
            %h6#proof_2 Proof
            %p
              Any monomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} i \colon X \to Y
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Set
                      %mrow
                        %msup
                          %mi Δ
                          %mi op
                  %annotation{:encoding => "application/x-tex"} Set^{\Delta^{op}}
              can be seen as the result of iteratively adjoining nondegenerate
              = succeed "-simplices." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo =
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo ↪
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ↪
                      %mi …
                      %mi Y
                      %mo =
                      %msub
                        %mi colim
                        %mi i
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} X = F(0) \hookrightarrow F(1) \hookrightarrow \ldots Y = colim_i F(i)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi κ
                    %mo →
                    %msup
                      %mi Set
                      %mrow
                        %msup
                          %mi Δ
                          %mi op
                  %annotation{:encoding => "application/x-tex"} F: \kappa \to Set^{\Delta^{op}}
              is a functor from some ordinal
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo ≤
                    %mn 1
                    %mo ≤
                    %mi …
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \kappa = \{0 \leq 1\leq \ldots\}
              (as
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/preorder"} preorder
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi α
                    %mo ≤
                    %mi α
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi α
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi α
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(\alpha \leq \alpha + 1): F(\alpha) \to F(\alpha + 1)
              fits into a pushout diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo ∂
                            %mi Δ
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo ,
                            %mi n
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi α
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi j
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi Δ
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo ,
                            %mi n
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi α
                            %mo +
                            %mn 1
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\partial \Delta(-, n) &amp; \to &amp; F(\alpha) \\
                    \\mathllap{j} \downarrow &amp; &amp; \downarrow \\
                    \\Delta(-, n) &amp; \to &amp; F(\alpha+1)
                    }
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
              is the inclusion. Now
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} R(j)
              is identifiable as the inclusion
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                      %mo →
                      %msup
                        %mi D
                        %mi n
                    %annotation{:encoding => "application/x-tex"} S^{n-1} \to D^n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              preserves pushouts (which are calculated as they are in
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Top
                    %annotation{:encoding => "application/x-tex"} Top
              %a{:href => "/nlab/show/subspace+topology#pushout"} this lemma
              that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi α
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi R
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi α
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} R F(\alpha) \to R F(\alpha+1)
              is a closed subspace inclusion and evidently a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/relative+CW-complex"} relative CW-complex
              = succeed "," do
                %a{:href => "/nlab/show/subspace+topology#transfinite"} another lemma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \to Y
              is also a closed inclusion and indeed a relative CW-complex.
          .num_cor
            %h6#corollary Corollary
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo :
                    %msup
                      %mi Set
                      %mrow
                        %msup
                          %mi Δ
                          %mi op
                    %mo →
                    %mi Space
                  %annotation{:encoding => "application/x-tex"} R: Set^{\Delta^{op}} \to Space
              preserves
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/equalizers"} equalizers
          .proof
            %h6#proof_3 Proof
            %p
              The equalizer of a pair of maps in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} Top
              is computed as the equalizer on the level of underlying sets, equipped with the subspace topology. So if
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
                      %mi i
                    %mi X
                    %mover
                      %munder
                        %mo ⟶
                        %mi g
                      %mover
                        %mo ⟶
                        %mi f
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} E \stackrel{i}{\to} X \stackrel{\overset{f}{\longrightarrow}}{\underset{g}{\longrightarrow}} Y
            %p
              is an equalizer diagram in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Set
                        %mrow
                          %msup
                            %mi Δ
                            %mi op
                    %annotation{:encoding => "application/x-tex"} Set^{\Delta^{op}}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi i
