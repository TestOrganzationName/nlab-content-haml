          %h2#definition Definition
          %p
            Fix some
            %a.existingWikiWord{:href => "/nlab/show/scheme"} scheme
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
          .un_defn
            %h6#definition_2 Definition
            %p
              the
              %strong fppf-site
              (over
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %a.existingWikiWord{:href => "/nlab/show/site"} site
            %ul
              %li
                %p
                  whose underlying category is the category
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Aff
                        %mo{:stretchy => "false"} /
                        %mi S
                      %annotation{:encoding => "application/x-tex"} Aff/S
                  of
                  = succeed "s" do
                    %a.existingWikiWord{:href => "/nlab/show/affine+scheme"} affine scheme
                  %a.existingWikiWord{:href => "/nlab/show/over+category"} over
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi S
                        %annotation{:encoding => "application/x-tex"} S
              %li
                %p
                  whose
                  %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
                  has as
                  %a.existingWikiWord{:href => "/nlab/show/covering"} covering
                  families
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mi f
                        %mo :
                        %msub
                          %mi U
                          %mi i
                        %mo →
                        %mi X
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{f : U_i \to X\}
                  those families of morphisms that are such that
                %ul
                  %li
                    %p
                      each
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi f
                              %mi i
                          %annotation{:encoding => "application/x-tex"} f_i
                      is a
                      = succeed ";" do
                        %a.existingWikiWord{:href => "/nlab/show/flat+morphism"} flat morphism
                  %li
                    %p
                      each
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi f
                              %mi i
                          %annotation{:encoding => "application/x-tex"} f_i
                      is
                      = succeed ";" do
                        %a.existingWikiWord{:href => "/nlab/show/locally+of+finite+presentation"} locally of finite presentation
                  %li
                    %p
                      we have that
                      = succeed "." do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi X
                              %mo =
                              %msub
                                %mo ∪
                                %mi i
                              %msub
                                %mi f
                                %mi i
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi U
                                %mi i
                              %mo{:stretchy => "false"} )
                            %annotation{:encoding => "application/x-tex"} X = \cup_i f_i(U_i)
          %p
            This appears as (
            %a{:href => "#deJong"}> de Jong, def. 27.7.1, def 27.7.6, lemma 27.7.11
            ).
          .un_remark
            %h6#remark Remark
            %p
              The abbreviation “fppf” is for
              %em fidèlement plat de présentation finie
              \: faithfully flat and of finite presentation.
            %p
              But notice that it is common practice, as in the above definition, to require only
              %em local
              finite presentability.
