          %title
          %p
            Nathanael Arkor is a postdoc researching
            %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/type+theory"} type theory
            %em
              %a{:href => "https://github.com/varkor"} varkor
            he is the author of the diagram editor
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/quiver+%28editor%29"} quiver
          %ul
            %li
              %p
                %a{:href => "https://arkor.co/"} personal page
            %li
              %p
                %a{:href => "https://taltech.ee/en/contacts/high-assurance-software-laboratory/nathanael-amariah-arkor"} institute page
          %h2#selected_writings Selected writings
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/monads"} monads
            and
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/higher-order+algebraic+theories"} higher-order algebraic theories
          %ul
            %li#Arkor22Thesis
              %a.existingWikiWord{:href => "/nlab/show/Nathanael+Arkor"}> Nathanael Arkor
              ,
              = succeed "," do
                %em Monadic and Higher-Order Structure
              = succeed "," do
                %a{:href => "https://doi.org/10.17863/CAM.86347"} doi:10.17863/CAM.86347
              = succeed "," do
                %a{:href => "https://www.repository.cam.ac.uk/bitstreams/666be4fb-957b-4c2e-83fc-8124621f0c43/download"} pdf
              = succeed "&rbrack;" do
                %a.existingWikiWord{:href => "/nlab/files/Arkor-MonadicAndHigherStructure.pdf", :title => "pdf"} pdf
          %p
            On
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/simple+type+theory"} simple type theory
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Nathanael+Arkor"}> Nathanael Arkor
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Marcelo+Fiore"} Marcelo Fiore
              = succeed "," do
                %em Algebraic models of simple type theories: a polynomial approach
              = succeed "," do
                %a{:href => "https://doi.org/10.1145/3373718.3394771"} doi:10.1145/3373718.3394771
              = succeed "&rbrack;" do
                %a{:href => "https://arxiv.org/abs/2006.16949"} arXiv:2006.16949
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/formal+category+theory"} formal theory
            of
            %a.existingWikiWord{:href => "/nlab/show/relative+monads"} relative monads
            via
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/virtual+equipments"} virtual equipments
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Nathanael+Arkor"}> Nathanael Arkor
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Dylan+McDermott"} Dylan McDermott
                = succeed "," do
                  %em The formal theory of relative monads
                = succeed "&rbrack." do
                  %a{:href => "https://arxiv.org/abs/2302.14014"} arXiv:2302.14014
            %li#AM23b
              %p
                %a.existingWikiWord{:href => "/nlab/show/Nathanael+Arkor"}> Nathanael Arkor
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Dylan+McDermott"} Dylan McDermott
                = succeed "," do
                  %em Relative monadicity
                %a{:href => "https://doi.org/10.1016/j.jalgebra.2024.08.040"} DOI
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2305.10405"}> arXiv:2305.10405
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Nathanael+Arkor"}> Nathanael Arkor
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Dylan+McDermott"} Dylan McDermott
                %em The nerve theorem for relative monads
                (2025), Theory and Applications of Categories, &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2404.01281"}> arXiv:2404.01281
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Nathanael+Arkor"}> Nathanael Arkor
                ,
                = succeed "," do
                  %em Relative monads and their many guises
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Category+Theory+Octoberfest"} Category Theory Octoberfest
                %a{:href => "https://richardblute.ca/octoberfest-2022/"} 2022
                \&amp;lbrack;slides:
                %a{:href => "https://richardblute.files.wordpress.com/2022/10/arkor-ofest.pdf"}> pdf
                , video:
                %a{:href => "https://richardblute.files.wordpress.com/2022/10/arkor-ofest-1.mp4"}> mp4
                \&amp;rbrack;
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/higher-order+logic"} higher-order
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+theories"} algebraic theories
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Nathanael+Arkor"}> Nathanael Arkor
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Dylan+McDermott"} Dylan McDermott
                %em Higher-order algebraic theories
                (
                %a{:href => "https://arkor.co/files/Higher-order%20algebraic%20theories.pdf"}> pdf
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Nathanael+Arkor"} Nathanael Arkor
                and
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Dylan+McDermott"} Dylan McDermott
                = succeed "," do
                  %em Abstract Clones for Abstract Syntax
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/2105.00969"} arXiv
          %p
            On the
            %a.existingWikiWord{:href => "/nlab/show/adjoint+functor+theorem"} adjoint functor theorem
            in the context of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/lax-idempotent+2-monads"} lax-idempotent 2-monads
          %ul
            %li#ALL23
              %a.existingWikiWord{:href => "/nlab/show/Nathanael+Arkor"}> Nathanael Arkor
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ivan+Di+Liberti"} Ivan Di Liberti
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Fosco+Loregian"} Fosco Loregian
              = succeed "," do
                %em Adjoint functor theorems for lax-idempotent pseudomonads
              = succeed "&rbrack;" do
                %a{:href => "https://arxiv.org/abs/2306.10389"} arXiv:2306.10389
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/bicategories"} bicategories
            of
            %a.existingWikiWord{:href => "/nlab/show/pseudoalgebras"} pseudoalgebras
            for
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/relative+pseudomonads"} relative pseudomonads
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Nathanael+Arkor"}> Nathanael Arkor
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Philip+Saville"} Philip Saville
              = succeed "," do
                %em Bicategories of algebras for relative pseudomonads
              %a{:href => "https://arxiv.org/abs/2501.12510"} arXiv:2501.12510
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/enhanced+2-category"} two-dimensional
            %a.existingWikiWord{:href => "/nlab/show/limit+sketches"} limit sketches
            and
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/double+categories"} double categories
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Nathanael+Arkor"}> Nathanael Arkor
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/John+Bourke"} John Bourke
              = succeed "," do
                %span.newWikiWord
                  Joanna Ko
                  %a{:href => "/nlab/new/Joanna+Ko"} ?
              = succeed "," do
                %em Enhanced 2-categorical structures, two-dimensional limit sketches and the symmetry of internalisation
              %a{:href => "https://arxiv.org/abs/2412.07475"} arXiv:2412.07475
              (2024).
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/exponentiable+object"} exponentiable
            %a.existingWikiWord{:href => "/nlab/show/virtual+double+categories"} virtual double categories
            and
            %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representability
            for
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/double+categories"} double categories
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Nathanael+Arkor"}> Nathanael Arkor
              ,
              = succeed "," do
                %em Exponentiable virtual double categories and presheaves for double categories
              %a{:href => "https://arxiv.org/abs/2508.11611"} arXiv:2508.11611
              (2025).
          %p
            On a generalisation of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Fox%27s+theorem"} Fox's theorem
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Nathanael+Arkor"}> Nathanael Arkor
              ,
              %em Magmal characterisations of cocartesian categories
              \&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/2508.11615"}> arXiv:2508.11615
              \&amp;rbrack;
          %h2#related_entries Related entries
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/formal+category+theory"} formal category theory
            %li
              %a.existingWikiWord{:href => "/nlab/show/relative+monad"} relative monad
            %li
              %a.existingWikiWord{:href => "/nlab/show/relative+adjunction"} relative adjunction
            %li
              %a.existingWikiWord{:href => "/nlab/show/algebraic+theory"} algebraic theory
