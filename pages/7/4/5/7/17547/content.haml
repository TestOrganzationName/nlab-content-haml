          %h2#idea Idea
          %p
            %em Milnor’s theorem
            describes the dual mod-
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            %a.existingWikiWord{:href => "/nlab/show/Steenrod+algebra"} Steenrod algebra
            in terms of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/generators+and+relations"} generators and relations
          %h2#statement Statement
          %p
            In the following, we use for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo =
                  %mn 2
                %annotation{:encoding => "application/x-tex"} p = 2
            the notation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi P
                    %mi n
                  %mo ≔
                  %msup
                    %mi Sq
                    %mrow
                      %mn 2
                      %mi n
                %annotation{:encoding => "application/x-tex"}
                  P^n \coloneqq Sq^{2n}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi β
                  %mo ≔
                  %msup
                    %mi Sq
                    %mn 1
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\beta \coloneqq Sq^1
                  \\,.
          %p
            This serves to unify the expressions for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo =
                  %mn 2
                %annotation{:encoding => "application/x-tex"} p = 2
            and for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo &gt;
                  %mn 2
                %annotation{:encoding => "application/x-tex"} p \gt 2
            in the following. Notice that for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi P
                        %mi n
                    %annotation{:encoding => "application/x-tex"} P^n
                has even degree
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi deg
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi P
                          %mi n
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 2
                        %mi n
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo −
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} deg(P^n) = 2n(p-1)
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi β
                    %annotation{:encoding => "application/x-tex"} \beta
                has odd degree
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi deg
                        %mo{:stretchy => "false"} (
                        %mi β
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} deg(\beta) = 1
          #MilnorTheoremOnDualSteenrodAlgebra.num_theorem
            %h6#theorem Theorem
            %p
              %strong (Milnor’s theorem)
            %p
              The dual mod
              = succeed "-Steenrod" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi 𝒜
                      %mrow
                        %msub
                          %mi 𝔽
                          %mi p
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}^\ast_{\mathbb{F}_p}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#DualSteenrodAlgebraForHPf"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
              %a.existingWikiWord{:href => "/nlab/show/graded+commutative+algebra"} graded commutative algebra
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi 𝒜
                      %mrow
                        %msub
                          %mi 𝔽
                          %mi p
                      %mo *
                    %mo ≃
                    %msub
                      %mi Sym
                      %mrow
                        %msub
                          %mi 𝔽
                          %mi p
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ξ
                      %mn 1
                    %mo ,
                    %msub
                      %mi ξ
                      %mn 2
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi τ
                      %mn 0
                    %mo ,
                    %msub
                      %mi τ
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{A}^\ast_{\mathbb{F}_p}
                    \\simeq
                    Sym_{\mathbb{F}_p}(\xi_1, \xi_2, \cdots, \;\tau_0, \tau_1, \cdots)
            %p on generators:
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ξ
                          %mi n
                      %annotation{:encoding => "application/x-tex"} \xi_n
                  being the linear dual to
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi P
                            %mrow
                              %msup
                                %mi p
                                %mrow
                                  %mi n
                                  %mo −
                                  %mn 1
                          %msup
                            %mi P
                            %mrow
                              %msup
                                %mi p
                                %mrow
                                  %mi n
                                  %mo −
                                  %mn 2
                          %mi ⋯
                          %msup
                            %mi P
                            %mi p
                          %msup
                            %mi P
                            %mn 1
                        %annotation{:encoding => "application/x-tex"} P^{p^{n-1}} P^{p^{n-2}} \cdots P^p P^1
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi τ
                          %mi n
                      %annotation{:encoding => "application/x-tex"} \tau_n
                  being linear dual to
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi P
                            %mrow
                              %msup
                                %mi p
                                %mrow
                                  %mi n
                                  %mo −
                                  %mn 1
                          %msup
                            %mi P
                            %mrow
                              %msup
                                %mi p
                                %mrow
                                  %mi n
                                  %mo −
                                  %mn 2
                          %mi ⋯
                          %msup
                            %mi P
                            %mi p
                          %msup
                            %mi P
                            %mn 1
                          %mi β
                        %annotation{:encoding => "application/x-tex"} P^{p^{n-1}} P^{p^{n-2}} \cdots P^p P^1\beta
            %p
              Moreover, the coproduct on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi 𝒜
                      %mrow
                        %msub
                          %mi 𝔽
                          %mi p
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}^\ast_{\mathbb{F}_p}
              is given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ψ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ξ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo =
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi k
                        %mo =
                        %mn 0
                      %mi n
                    %msubsup
                      %mi ξ
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                      %mrow
                        %msup
                          %mi p
                          %mi k
                    %mo ⊗
                    %msub
                      %mi ξ
                      %mi k
                  %annotation{:encoding => "application/x-tex"}
                    \\Psi(\xi_n)
                    \=
                    \\underoverset{k = 0}{n}{\sum} \xi_{n-k}^{p^k} \otimes \xi_k
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ψ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi τ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi τ
                      %mi n
                    %mo ⊗
                    %mn 1
                    %mo +
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi k
                        %mo =
                        %mn 0
                      %mi n
                    %msubsup
                      %mi ξ
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                      %mrow
                        %msup
                          %mi p
                          %mi k
                    %msubsup
                      %mi ξ
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                      %mrow
                        %msup
                          %mi p
                          %mi k
                    %mo ⊗
                    %msub
                      %mi τ
                      %mi k
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\Psi(\tau_n)
                    \=
                    \\tau_n \otimes 1
                    +
                    \\underoverset{k=0}{n}{\sum}
                    \\xi_{n-k}^{p^k} \xi_{n-k}^{p^k}\otimes \tau_k
                    \\,,
            %p
              where we set
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ξ
                        %mn 0
                      %mo ≔
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} \xi_0 \coloneqq 1
          %p
            This is due to (
            %a{:href => "#Milnor58"}> Milnor 58
            ). See for instance (
            %a{:href => "#Kochman96"}> Kochman 96, theorem 2.5.1
            )
          %h2#references References
          %ul
            %li#Milnor58
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+Milnor"}> John Milnor
                ,
                = succeed "," do
                  %em The Steenrod algebra and its dual
            %li#Kochman96
              %p
                %a.existingWikiWord{:href => "/nlab/show/Stanley+Kochman"}> Stanley Kochman
                , section 2.5 of
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Bordism%2C+Stable+Homotopy+and+Adams+Spectral+Sequences"} Bordism, Stable Homotopy and Adams Spectral Sequences
