                            %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mi k
                            %msub
                              %mo ∫
                              %mrow
                                %mo ∂
                                %mi Σ
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi ϕ
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
