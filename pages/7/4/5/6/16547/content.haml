          %p
            is the
            %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            for an
            %a.existingWikiWord{:href => "/nlab/show/electron"} electron
            or other electrically charged
            %a.existingWikiWord{:href => "/nlab/show/particle"} particle
            in the
            %a.existingWikiWord{:href => "/nlab/show/background+gauge+field"} background gauge field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
