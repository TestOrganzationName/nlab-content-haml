                  %mi X
                  %mo →
                  %msup
                    %mi Ω
                    %mn 1
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\nabla = A \colon X \to \Omega^1
                  \\,,
          %p
            the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/electromagnetic+potential"} electromagnetic potential
          %p
            Let then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                  %mo =
                  %msup
                    %mi S
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \Sigma = S^1
            be the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/circle"} circle
            %a.existingWikiWord{:href => "/nlab/show/transgression"} transgression
            of the electromagnetic potential to the
            %a.existingWikiWord{:href => "/nlab/show/loop+space"} loop space
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi S
                    %mn 1
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi S
                    %mn 1
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mover
                    %mo →
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi S
                        %mn 1
